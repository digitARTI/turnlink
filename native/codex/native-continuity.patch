+/// Submission operation
+/// Identity minted by the native transport host, never deserialized from RPC input.
+#[derive(Clone)]
+pub struct ContinuityOwner {
+    id: uuid::Uuid,
+    alive: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+
+impl ContinuityOwner {
+    pub fn new() -> Self {
+        Self {
+            id: uuid::Uuid::new_v4(),
+            alive: std::sync::Arc::new(std::sync::atomic::AtomicBool::new(true)),
+        }
+    }
+    pub fn close(&self) {
+        self.alive
+            .store(false, std::sync::atomic::Ordering::Release);
+    }
+    pub fn is_open(&self) -> bool {
+        self.alive.load(std::sync::atomic::Ordering::Acquire)
+    }
+}
+
+impl PartialEq for ContinuityOwner {
+    fn eq(&self, other: &Self) -> bool {
+        self.id == other.id && std::sync::Arc::ptr_eq(&self.alive, &other.alive)
+    }
+}
+impl Eq for ContinuityOwner {}
+
+impl Default for ContinuityOwner {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl fmt::Debug for ContinuityOwner {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ContinuityOwner([native host identity])")
+    }
+}
