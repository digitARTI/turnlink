+async fn continuity_submission(sess: &Session, submission_id: String, op: Op) {
+    match op {
+        Op::ContinuityAcquire { owner, reply } => {
+            let _ = reply.send(sess.continuity_acquire(owner).await);
+        }
+        Op::ContinuityCommit {
+            owner,
+            reservation,
+            transition_id,
+            cwd,
+            reply,
+        } => {
+            let result =
+                Box::pin(sess.continuity_commit(&owner, &reservation, transition_id, cwd)).await;
+            let snapshot = if result.is_ok() {
+                Some(sess.thread_settings_snapshot().await)
+            } else {
+                None
+            };
+            // Completion follows native flush; event delivery must not hold its caller's lock.
+            let _ = reply.send(result);
+            if let Some(snapshot) = snapshot {
+                thread_settings::emit_applied(sess, submission_id, snapshot).await;
+            }
+        }
+        Op::ContinuityRelease {
+            owner,
+            reservation,
+            reply,
+        } => {
+            let _ = reply.send(sess.continuity_release(&owner, &reservation).await);
+        }
+        Op::ContinuityDisconnect { owner } => {
+            owner.close();
+            sess.continuity_invalidate(Some(&owner)).await;
+        }
+        _ => unreachable!("only native continuity operations reach this dispatcher"),
+    }
+}
