+//! Native queue acceptance tests. Host identities never arrive in JSON parameters.
+use super::Submission;
+use super::handlers::submission_loop;
+use super::tests::make_session_and_context;
+use codex_protocol::protocol::{
+    ContinuityOwner, ContinuityReservation, Op, ThreadSettingsOverrides,
+};
+use std::sync::Arc;
+use tokio::sync::oneshot;
+
+async fn queue() -> (
+    async_channel::Sender<Submission>,
+    tokio::task::JoinHandle<()>,
+    Arc<super::session::Session>,
+) {
+    let (mut session, context) = make_session_and_context().await;
+    super::tests::attach_thread_persistence(&mut session).await;
+    let session = Arc::new(session);
+    let (tx, rx) = async_channel::bounded(16);
+    let runner = tokio::spawn(submission_loop(Arc::clone(&session), context.config, rx));
+    (tx, runner, session)
+}
+
+async fn submit(tx: &async_channel::Sender<Submission>, op: Op) {
+    tx.send(Submission {
+        id: uuid::Uuid::new_v4().to_string(),
+        op,
+        turn_extension_init: None,
+        trace: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+        residency_guard: None,
+        message_delivery: None,
+    })
+    .await
+    .expect("queue native operation");
+}
+
+async fn acquire(
+    tx: &async_channel::Sender<Submission>,
+    owner: &ContinuityOwner,
+) -> codex_protocol::error::Result<ContinuityReservation> {
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        tx,
+        Op::ContinuityAcquire {
+            owner: owner.clone(),
+            reply,
+        },
+    )
+    .await;
+    accepted.await.expect("native acquire reply")
+}
+
+#[tokio::test]
+async fn continuity_queue_reservation_refuses_other_host_and_ordinary_mutations() {
+    let (tx, runner, _) = queue().await;
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner)
+        .await
+        .expect("acquire idle native thread");
+    assert!(acquire(&tx, &ContinuityOwner::new()).await.is_err());
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ThreadSettings {
+            thread_settings: ThreadSettingsOverrides::default(),
+            reply: Some(reply),
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("ordinary settings reply").is_err());
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner: ContinuityOwner::new(),
+            reservation: held.clone(),
+            reply,
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("foreign release reply").is_err());
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner: owner.clone(),
+            reservation: held,
+            reply,
+        },
+    )
+    .await;
+    accepted
+        .await
+        .expect("release reply")
+        .expect("exact native owner releases before any mutation");
+    assert!(acquire(&tx, &owner).await.is_ok());
+    runner.abort();
+}
+
+#[tokio::test]
+async fn continuity_queue_stale_generation_and_disconnect_never_reauthorize() {
+    let (tx, runner, _) = queue().await;
+    let owner = ContinuityOwner::new();
+    let old = acquire(&tx, &owner).await.expect("first acquire");
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner: owner.clone(),
+            reservation: old.clone(),
+            reply,
+        },
+    )
+    .await;
+    accepted.await.expect("release reply").expect("release");
+    let fresh = acquire(&tx, &owner).await.expect("second acquire");
+    assert_ne!(old.generation, fresh.generation);
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner: owner.clone(),
+            reservation: old,
+            reply,
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("old release reply").is_err());
+    submit(
+        &tx,
+        Op::ContinuityDisconnect {
+            owner: owner.clone(),
+        },
+    )
+    .await;
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner: owner.clone(),
+            reservation: fresh,
+            reply,
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("disconnected release reply").is_err());
+    assert!(acquire(&tx, &owner).await.is_err());
+    runner.abort();
+}
+
+#[tokio::test]
+async fn continuity_queue_human_interrupt_stays_immediate_and_invalidates_reservation() {
+    let (tx, runner, _) = queue().await;
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.expect("acquire");
+    submit(&tx, Op::Interrupt).await;
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner,
+            reservation: held,
+            reply,
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("interrupted release reply").is_err());
+    runner.abort();
+}
+
+#[tokio::test]
+async fn continuity_queue_closed_host_cannot_acquire_even_if_its_request_was_queued() {
+    let (tx, runner, _) = queue().await;
+    let owner = ContinuityOwner::new();
+    owner.close();
+    assert!(acquire(&tx, &owner).await.is_err());
+    assert!(acquire(&tx, &ContinuityOwner::new()).await.is_ok());
+    runner.abort();
+}
+
+#[tokio::test]
+async fn continuity_queue_commit_publishes_exact_cwd_and_retries_only_its_durable_receipt() {
+    let (tx, runner, session) = queue().await;
+    let before = session.thread_settings_snapshot().await;
+    let destination = tempfile::tempdir().expect("private destination");
+    let cwd = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        std::fs::canonicalize(destination.path()).expect("canonical destination"),
+    )
+    .expect("absolute destination");
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.expect("native owner");
+    let transition_id = uuid::Uuid::new_v4();
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityCommit {
+            owner: owner.clone(),
+            reservation: held.clone(),
+            transition_id,
+            cwd: cwd.clone(),
+            reply,
+        },
+    )
+    .await;
+    let receipt = accepted
+        .await
+        .expect("completed commit reply")
+        .expect("native persisted commit");
+    let persisted: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(session.continuity_receipt_path().await)
+            .expect("durable native receipt file"),
+    )
+    .expect("native receipt JSON");
+    assert_eq!(persisted["phase"], "committed");
+    assert_eq!(
+        persisted["receipt"]["transition_id"],
+        transition_id.to_string()
+    );
+    assert_eq!(receipt.cwd, cwd);
+    assert!(receipt.reservation.revision > held.revision);
+    let after = session.thread_settings_snapshot().await;
+    assert_eq!(after.cwd, cwd);
+    assert_eq!(after.approval_policy, before.approval_policy);
+    assert_eq!(after.permission_profile, before.permission_profile);
+    assert_eq!(after.approvals_reviewer, before.approvals_reviewer);
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityCommit {
+            owner: owner.clone(),
+            reservation: held.clone(),
+            transition_id,
+            cwd: cwd.clone(),
+            reply,
+        },
+    )
+    .await;
+    assert_eq!(
+        accepted
+            .await
+            .expect("retry reply")
+            .expect("exact persisted retry"),
+        receipt
+    );
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityCommit {
+            owner: owner.clone(),
+            reservation: held,
+            transition_id,
+            cwd: before.cwd,
+            reply,
+        },
+    )
+    .await;
+    assert!(accepted.await.expect("changed retry reply").is_err());
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityRelease {
+            owner,
+            reservation: receipt.reservation,
+            reply,
+        },
+    )
+    .await;
+    accepted
+        .await
+        .expect("release reply")
+        .expect("release exact completed native generation");
+    runner.abort();
+}
+
+#[tokio::test]
+async fn continuity_queue_completed_transition_id_cannot_be_reused_after_release() {
+    let (tx, runner, session) = queue().await;
+    let owner = ContinuityOwner::new();
+    let transition_id = uuid::Uuid::new_v4();
+    let first = tempfile::tempdir().expect("first destination");
+    let second = tempfile::tempdir().expect("second destination");
+    let destination = |directory: &tempfile::TempDir| {
+        codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+            std::fs::canonicalize(directory.path()).expect("canonical destination"),
+        )
+        .expect("absolute destination")
+    };
+    let first_cwd = destination(&first);
+    for (index, cwd) in [first_cwd.clone(), destination(&second)]
+        .into_iter()
+        .enumerate()
+    {
+        let held = acquire(&tx, &owner)
+            .await
+            .expect("fresh native reservation");
+        let (reply, accepted) = oneshot::channel();
+        submit(
+            &tx,
+            Op::ContinuityCommit {
+                owner: owner.clone(),
+                reservation: held.clone(),
+                transition_id,
+                cwd,
+                reply,
+            },
+        )
+        .await;
+        let result = accepted.await.expect("commit reply");
+        let release = if index == 0 {
+            result.expect("first transition completes").reservation
+        } else {
+            assert!(
+                result.is_err(),
+                "a completed transition ID must not publish another destination"
+            );
+            assert_eq!(session.thread_settings_snapshot().await.cwd, first_cwd);
+            held
+        };
+        let (reply, accepted) = oneshot::channel();
+        submit(
+            &tx,
+            Op::ContinuityRelease {
+                owner: owner.clone(),
+                reservation: release,
+                reply,
+            },
+        )
+        .await;
+        accepted
+            .await
+            .expect("release reply")
+            .expect("release exact unchanged reservation");
+    }
+    runner.abort();
+}
