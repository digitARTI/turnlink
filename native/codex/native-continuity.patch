+    invalid: bool,
+    journal: Journal,
+    _admission: OwnedRwLockWriteGuard<()>,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Journal {
+    schema: u32,
+    thread_id: String,
+    phase: String,
+    reservation: ContinuityReservation,
+    source_cwd: AbsolutePathBuf,
+    transition_id: Option<uuid::Uuid>,
+    cwd: Option<AbsolutePathBuf>,
+    receipt: Option<ContinuityCommitReceipt>,
+    history: Vec<ContinuityCommitReceipt>,
+}
+
+pub(crate) fn refused() -> CodexErr {
+    CodexErr::InvalidRequest("native continuity reservation unavailable or uncertain".into())
+}
+
+pub(crate) fn constrained() -> crate::config::ConstraintError {
+    crate::config::ConstraintError::InvalidValue {
+        field_name: "native_continuity",
+        candidate: "competing mutation".into(),
+        allowed: "unreserved native thread".into(),
+        requirement_source: codex_config::RequirementSource::Unknown,
+    }
+}
+
+impl ContinuityState {
+    pub(crate) fn invalidate(&mut self) {
+        if let Some(held) = self.held.as_mut() {
+            held.invalid = true;
+        }
+        self.revision = self.revision.saturating_add(1);
+    }
+
+    pub(crate) fn check(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let held = self.held.as_ref().ok_or_else(refused)?;
+        if !owner.is_open()
+            || held.invalid
+            || &held.owner != owner
+            || &held.reservation != reservation
+            || self.revision != reservation.revision
+            || self.revision == u64::MAX
+        {
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn published(&mut self, revision: u64) {
+        if let Some(held) = self.held.as_mut() {
+            held.reservation.revision = revision;
+        }
+    }
+}
+
+fn read_journal(path: &Path, thread_id: &str) -> CodexResult<Option<Journal>> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(refused()),
+    };
+    if !metadata.is_file() || metadata.len() > MAX_JOURNAL_BYTES {
+        return Err(refused());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.mode() & 0o077 != 0
+            || metadata.nlink() != 1
+            || metadata.uid() != unsafe { libc::geteuid() }
+        {
+            return Err(refused());
+        }
+    }
+    let mut options = fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    let mut bytes = Vec::new();
+    options
+        .open(path)
+        .map_err(|_| refused())?
+        .take(MAX_JOURNAL_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| refused())?;
+    if bytes.len() as u64 > MAX_JOURNAL_BYTES {
+        return Err(refused());
+    }
+    let journal: Journal = serde_json::from_slice(&bytes).map_err(|_| refused())?;
+    if journal.schema != 1
+        || journal.thread_id != thread_id
+        || journal.history.len() > MAX_RECEIPTS
+        || ![
+            "acquired",
+            "submitting",
+            "committed",
+            "released",
+            "uncertain",
+        ]
+        .contains(&journal.phase.as_str())
+    {
+        return Err(refused());
+    }
+    Ok(Some(journal))
+}
+
+fn write_journal(path: &Path, journal: &Journal) -> CodexResult<()> {
+    let parent = path.parent().ok_or_else(refused)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{DirBuilderExt, MetadataExt};
+        let mut builder = fs::DirBuilder::new();
+        builder.mode(0o700);
+        match builder.create(parent) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(_) => return Err(refused()),
+        }
+        let metadata = fs::symlink_metadata(parent).map_err(|_| refused())?;
+        if !metadata.is_dir()
+            || metadata.mode() & 0o077 != 0
+            || metadata.uid() != unsafe { libc::geteuid() }
+        {
+            return Err(refused());
+        }
+    }
+    // Native Windows ACL and durable-directory acceptance is a separate stage.
+    #[cfg(not(unix))]
+    {
+        return Err(refused());
+    }
+    let bytes = serde_json::to_vec(journal).map_err(|_| refused())?;
+    if bytes.len() as u64 > MAX_JOURNAL_BYTES || journal.history.len() > MAX_RECEIPTS {
+        return Err(refused());
+    }
+    let mut temporary = tempfile::Builder::new()
+        .prefix(".continuity-")
+        .tempfile_in(parent)
+        .map_err(|_| refused())?;
+    temporary.write_all(&bytes).map_err(|_| refused())?;
+    temporary.as_file().sync_all().map_err(|_| refused())?;
+    temporary.persist(path).map_err(|_| refused())?;
+    File::open(parent)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| refused())?;
+    Ok(())
+}
+
+impl Session {
+    pub(crate) fn continuity_mutation(&self) -> CodexResult<OwnedRwLockReadGuard<()>> {
+        self.continuity_admission
+            .clone()
+            .try_read_owned()
+            .map_err(|_| refused())
+    }
+
+    pub(crate) async fn continuity_receipt_path(&self) -> PathBuf {
+        self.get_config()
+            .await
+            .codex_home
+            .join("native-continuity")
+            .join(format!("{}.json", self.thread_id))
+            .to_path_buf()
+    }
+
+    pub(crate) async fn continuity_restore(&self) -> CodexResult<()> {
+        let Some(journal) = read_journal(
+            &self.continuity_receipt_path().await,
+            &self.thread_id.to_string(),
+        )?
+        else {
+            return Ok(());
+        };
+        let mut state = self.state.lock().await;
+        state.continuity.revision = state.continuity.revision.max(journal.reservation.revision);
+        if journal.phase != "released" {
+            let admission = self
+                .continuity_admission
+                .clone()
+                .try_write_owned()
+                .map_err(|_| refused())?;
+            let owner = ContinuityOwner::new();
+            owner.close();
+            state.continuity.held = Some(Held {
+                owner,
+                reservation: journal.reservation.clone(),
+                original: None,
+                invalid: true,
+                journal,
+                _admission: admission,
+            });
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn continuity_acquire(
+        &self,
+        owner: ContinuityOwner,
+    ) -> CodexResult<ContinuityReservation> {
+        if !owner.is_open() {
+            return Err(refused());
+        }
+        let admission = self
+            .continuity_admission
+            .clone()
+            .try_write_owned()
+            .map_err(|_| refused())?;
+        let path = self.continuity_receipt_path().await;
+        let previous = read_journal(&path, &self.thread_id.to_string())?;
+        if previous
+            .as_ref()
+            .is_some_and(|journal| journal.phase != "released")
+        {
+            return Err(refused());
+        }
+        let active = self.active_turn.lock().await;
+        if active.is_some()
+            || self.conversation.running_state().await.is_some()
+            || *self.services.elicitations.subscribe().borrow()
+            || !self.list_background_terminals().await.is_empty()
+            || self.input_queue.has_pending_mailbox_items().await
+        {
+            return Err(refused());
+        }
+        let mut state = self.state.lock().await;
+        if !owner.is_open()
+            || state.shutting_down
+            || state.continuity.held.is_some()
+            || state.continuity.revision == u64::MAX
+        {
+            return Err(refused());
+        }
+        let reservation = ContinuityReservation {
+            generation: uuid::Uuid::new_v4(),
+            revision: state.continuity.revision,
+        };
+        let journal = Journal {
+            schema: 1,
+            thread_id: self.thread_id.to_string(),
+            phase: "acquired".into(),
+            reservation: reservation.clone(),
+            source_cwd: state.session_configuration.legacy_fallback_cwd.clone(),
+            transition_id: None,
+            cwd: None,
+            receipt: None,
+            history: previous.map_or_else(Vec::new, |journal| journal.history),
+        };
+        state.continuity.held = Some(Held {
+            owner: owner.clone(),
+            reservation: reservation.clone(),
+            original: None,
+            invalid: false,
+            journal: journal.clone(),
+            _admission: admission,
+        });
+        if write_journal(&path, &journal).is_err() || !owner.is_open() {
+            state.continuity.invalidate();
+            return Err(refused());
+        }
+        Ok(reservation)
+    }
+
+    pub(crate) async fn continuity_release(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let path = self.continuity_receipt_path().await;
+        let mut state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        let mut journal = held.journal.clone();
+        if let Some(receipt) = &journal.receipt {
+            journal.history.push(receipt.clone());
+        }
+        journal.phase = "released".into();
+        journal.reservation = reservation.clone();
+        if write_journal(&path, &journal).is_err() {
+            held.invalid = true;
+            return Err(refused());
+        }
+        state.continuity.held = None;
+        Ok(())
+    }
+
+    pub(crate) async fn continuity_commit(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        transition_id: uuid::Uuid,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityCommitReceipt> {
+        let path = self.continuity_receipt_path().await;
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let canonical = fs::canonicalize(cwd.as_path()).map_err(|_| refused())?;
+        if canonical != cwd.as_path() || !canonical.is_dir() {
+            return Err(refused());
+        }
+        let (updates, mut journal) = {
+            let mut state = self.state.lock().await;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if !owner.is_open() || &held.owner != owner || held.invalid {
+                return Err(refused());
+            }
+            if let Some(receipt) = &held.journal.receipt {
+                return if held.original.as_ref() == Some(reservation)
+                    && receipt.transition_id == transition_id
+                    && receipt.cwd == cwd
+                {
+                    Ok(receipt.clone())
+                } else {
+                    Err(refused())
+                };
+            }
+            state.continuity.check(owner, reservation)?;
+            if held
+                .journal
+                .history
+                .iter()
+                .any(|receipt| receipt.transition_id == transition_id)
+            {
+                return Err(refused());
+            }
+            let current = &state.session_configuration;
+            if current.environments.len() != 1
+                || current.environments[0].environment_id != codex_exec_server::LOCAL_ENVIRONMENT_ID
+                || current.environments[0].config != EnvironmentConfigState::FromThread
+            {
+                return Err(refused());
+            }
+            let mut environments = current.environments.clone();
+            let source_uri = PathUri::from_abs_path(&current.legacy_fallback_cwd);
+            let destination_uri = PathUri::from_abs_path(&cwd);
+            environments[0].cwd = destination_uri.clone();
+            for root in &mut environments[0].workspace_roots {
+                if *root == source_uri {
+                    *root = destination_uri.clone();
+                }
+            }
+            let updates = SessionSettingsUpdate {
+                environments: Some(TurnEnvironmentSelections::new(cwd.clone(), environments)),
+                ..Default::default()
+            };
+            let candidate = self
+                .apply_session_settings(current, &updates)
+                .map_err(|_| refused())?;
+            if candidate.permission_profile() != current.permission_profile() {
+                return Err(refused());
+            }
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.history.len() >= MAX_RECEIPTS {
+                return Err(refused());
+            }
+            held.original = Some(reservation.clone());
+            held.journal.phase = "submitting".into();
+            held.journal.transition_id = Some(transition_id);
+            held.journal.cwd = Some(cwd.clone());
+            if write_journal(&path, &held.journal).is_err() {
+                held.invalid = true;
+                return Err(refused());
+            }
+            (updates, held.journal.clone())
+        };
+        let effect = async {
+            let commit = self
+                .update_settings_if_authorized(updates, |_, _| true, Some((owner, reservation)))
+                .await
+                .map_err(|_| refused())?
+                .ok_or_else(refused)?;
+            let live = self.live_thread().ok_or_else(refused)?;
+            live.append_items(&[codex_history::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                    codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                        thread_id: Some(self.thread_id),
+                        thread_settings: commit.snapshot,
+                    },
+                ),
+            )])
+            .await
+            .map_err(|_| refused())?;
+            live.flush().await.map_err(|_| refused())?;
+            let mut state = self.state.lock().await;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.invalid || !owner.is_open() {
+                return Err(refused());
+            }
+            let receipt = ContinuityCommitReceipt {
+                transition_id,
+                reservation: held.reservation.clone(),
+                source_cwd: journal.source_cwd.clone(),
+                cwd,
+            };
+            journal.phase = "committed".into();
+            journal.reservation = receipt.reservation.clone();
+            journal.receipt = Some(receipt.clone());
+            write_journal(&path, &journal)?;
+            held.journal = journal.clone();
+            Ok(receipt)
+        }
+        .await;
+        if effect.is_err() {
+            let mut state = self.state.lock().await;
+            state.continuity.invalidate();
+            if let Some(held) = state.continuity.held.as_mut() {
+                held.journal.phase = "uncertain".into();
+                let _ = write_journal(&path, &held.journal);
+            }
+        }
+        effect
+    }
+
+    pub(crate) async fn continuity_invalidate(&self, owner: Option<&ContinuityOwner>) {
+        let path = self.continuity_receipt_path().await;
+        let mut state = self.state.lock().await;
+        if let Some(held) = state.continuity.held.as_mut()
+            && owner.is_none_or(|owner| owner == &held.owner)
+        {
+            held.invalid = true;
+            held.journal.phase = "uncertain".into();
+            let _ = write_journal(&path, &held.journal);
+        }
+    }
+}
