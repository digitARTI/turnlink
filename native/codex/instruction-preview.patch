+/// Apply the exact native startup mutation to a caller-owned configuration.
+/// The caller must obtain authenticated model and auth inputs before calling.
+pub(crate) fn resolve_native_startup_token_budget(
+    config: &mut Arc<Config>,
+    history: &InitialHistory,
+    auth: Option<&CodexAuth>,
+    model_info: &ModelInfo,
+) -> CodexResult<()> {
+    // Forked subagents keep their parent's activation with the copied history.
+    let inherits_token_budget = matches!(history, InitialHistory::Forked(_))
+        && config.token_budget_startup_config.is_some();
+    if !inherits_token_budget {
+        Arc::make_mut(config)
+            .prepare_token_budget_for_startup()
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        token_budget::apply_experimental_context(Arc::make_mut(config), auth, model_info)?;
+        token_budget::apply_model_defaults(Arc::make_mut(config), model_info);
+    }
+    Arc::make_mut(config).bind_native_token_budget_startup();
+    Ok(())
+}
+
+/// Shared startup resolution; this does not perform model or provider IO.
+fn native_resolved_collaboration_mode(
+    history: &InitialHistory,
+    config: &Config,
+    model: &str,
+) -> CollaborationMode {
+    let persisted_collaboration_mode = match history {
+        InitialHistory::Resumed(resumed) => resumed
+            .history
+            .iter()
+            .rev()
+            .find_map(|item| match item {
+                RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+                    if event.thread_id == Some(resumed.conversation_id) =>
+                {
+                    Some(&event.thread_settings.collaboration_mode)
+                }
+                _ => None,
+            })
+            .or_else(|| {
+                resumed
+                    .history
+                    .iter()
+                    .rev()
+                    .find_map(|item| match item {
+                        RolloutItem::TurnContext(context) => {
+                            Some(context.collaboration_mode.as_ref())
+                        }
+                        _ => None,
+                    })
+                    .flatten()
+            }),
+        InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_) => None,
+    };
+    let collaboration_mode = CollaborationMode {
+        mode: ModeKind::Default,
+        settings: Settings {
+            model: model.to_owned(),
+            reasoning_effort: config.model_reasoning_effort.clone(),
+            developer_instructions: None,
+        },
+    };
+    let collaboration_mode = persisted_collaboration_mode.map_or(collaboration_mode, |saved| {
+        saved.with_updates(
+            Some(model.to_owned()),
+            Some(config.model_reasoning_effort.clone()),
+            /*developer_instructions*/ None,
+        )
+    });
+    collaboration_mode
+}
