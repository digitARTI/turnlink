+        assert_eq!(data.native_attachment_revision(), Some(1));
+        assert!(!data.insert_if(9_u32, |_| false));
+        assert_eq!(data.native_attachment_revision(), Some(1));
+        data.insert(7_u32);
+        assert_eq!(data.native_attachment_revision(), Some(2));
