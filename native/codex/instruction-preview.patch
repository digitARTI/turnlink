+#[tokio::test]
+async fn continuity_reservation_prevents_startup_prewarm() {
+    let (session, _) = make_session_and_context().await;
+    let session = Arc::new(session);
+    let admission = session.continuity_admission.clone().write_owned().await;
+    session
+        .schedule_startup_prewarm(super::startup_prewarm::PrewarmInput::Base)
+        .await;
