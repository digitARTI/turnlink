+            "reservation":{"generation":id,"revision":1},"receipt":resource}});
+        let mut bytes = serde_json::to_vec(&request).unwrap();
+        bytes.push(b'\n');
+        assert!(matches!(
+            frame(&mut &bytes[..]).await.unwrap().unwrap().operation,
+            Operation::CleanupProvider { .. }
+        ));
+        let mut forged = request;
+        forged["operation"]["receipt"]["owner"] = json!("forged");
+        let mut bytes = serde_json::to_vec(&forged).unwrap();
+        bytes.push(b'\n');
+        assert!(frame(&mut &bytes[..]).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn native_control_accepts_only_private_local_descriptors_and_sets_close_on_exec() {
+        assert!(inherited_stream(0).is_err());
+        let file = tempfile::tempfile().unwrap();
+        assert!(inherited_stream(file.as_raw_fd()).is_err());
+        let (datagram, _peer) = std::os::unix::net::UnixDatagram::pair().unwrap();
+        assert!(inherited_stream(datagram.as_raw_fd()).is_err());
+        let (host, native) = std::os::unix::net::UnixStream::pair().unwrap();
+        // SAFETY: this synthetic descriptor is owned and live for the test.
+        let flags = unsafe { libc::fcntl(native.as_raw_fd(), libc::F_GETFD) };
+        assert_eq!(
+            unsafe { libc::fcntl(native.as_raw_fd(), libc::F_SETFD, flags & !libc::FD_CLOEXEC) },
+            0
+        );
+
+        let captured = inherited_stream(native.as_raw_fd()).unwrap();
+        assert!(captured.peer_addr().is_ok());
+        // SAFETY: the borrowed descriptor remains live in native for this call.
+        assert_ne!(
+            unsafe { libc::fcntl(native.as_raw_fd(), libc::F_GETFD) } & libc::FD_CLOEXEC,
+            0
+        );
+        drop(host);
+    }
+}
