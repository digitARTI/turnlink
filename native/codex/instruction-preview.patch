+        let mut deletion = Box::pin(adapter.delete_session(
+            "https://mcp.example/mcp".into(),
+            "session".into(),
+            None,
+            Default::default(),
+        ));
+        let response = tokio::select! {
+            result = &mut deletion => panic!("DELETE completed before response: {result:?}"),
+            response = requests.recv() => response.unwrap(),
