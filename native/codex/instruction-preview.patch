+#[tokio::test]
+async fn native_request_exclusion_fences_old_and_new_prepared_calls_before_preparation() {
+    use std::sync::atomic::AtomicUsize;
+    let owner = Arc::new(codex_rmcp_client::NativeMcpActivity::default());
+    let old =
+        test_step_with_native_owner("old", AppToolApproval::Approve, false, Some(owner.clone()))
+            .await;
+    let new =
+        test_step_with_native_owner("new", AppToolApproval::Approve, false, Some(owner.clone()))
+            .await;
+    let retained = old.step.prepare_call(SERVER_NAME, TOOL_NAME).unwrap();
+    let current = new.step.prepare_call(SERVER_NAME, TOOL_NAME).unwrap();
+    drop(old.step);
+    let exclusion = owner.try_exclude().unwrap();
+    let calls = AtomicUsize::new(0);
+    for prepared in [&retained, &current] {
+        let result = prepared
+            .call_with_preparation(None, || async {
+                calls.fetch_add(1, Ordering::SeqCst);
+                anyhow::bail!("fixture irreversible preparation reached")
+            })
+            .await;
+        assert!(result.is_err());
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    drop(exclusion);
+    assert!(
+        retained
+            .call_with_preparation(None, || async {
+                calls.fetch_add(1, Ordering::SeqCst);
+                anyhow::bail!("fixture irreversible preparation reached")
+            })
+            .await
+            .is_err()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(
+        owner.try_exclude().is_err(),
+        "failed preparation is not cleanup evidence"
+    );
+}
