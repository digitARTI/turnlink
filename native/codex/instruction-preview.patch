+    pub(crate) async fn continuity_is_restored_quarantine(&self) -> bool {
+        self.state
+            .lock()
+            .await
+            .continuity
+            .held
+            .as_ref()
+            .is_some_and(|held| {
+                held.invalid
+                    && !held.owner.is_open()
+                    && held.original.is_none()
+                    && held.source_mcp_observation.is_none()
+                    && held._mcp_requests.is_none()
+                    && held._model_sessions.is_some()
+            })
+    }
