+    pub(crate) async fn preview_host_instructions(&self) -> CodexResult<HostInstructionsPreview> {
+        let unavailable =
+            || CodexErr::InvalidRequest("native host instruction preparation unavailable".into());
+        let (native, user, thread) = {
+            let state = self.state.lock().await;
+            let source = &state.instructions;
+            if source.thread_provider.is_some() || source.project_snapshot.is_some() {
+                return Err(unavailable());
+            }
+            if let Some(thread) = &source.thread {
+                validate_thread_instruction_size(thread.text.len())?;
+            }
+            let native = match (&source.user_provider, &source.native_user_provider) {
+                (Some(execution), Some(native)) => {
+                    let bound: Arc<dyn UserInstructionsProvider> = native.clone();
+                    if !Arc::ptr_eq(execution, &bound) {
+                        return Err(unavailable());
+                    }
+                    Some(Arc::clone(native))
+                }
+                (None, None) => None,
+                _ => return Err(unavailable()),
+            };
+            // A native provider may have a very large cached fallback. Read its
+            // bounded source directly instead of cloning that applied cache.
+            let user = if native.is_none() {
+                source.user.clone()
+            } else {
+                None
+            };
+            (native, user, source.thread.clone())
+        };
+        let user = if let Some(native) = native {
+            normalize_instructions(native.preview_user_instructions().await?)
+        } else {
+            user
+        };
+        Ok(HostInstructionsPreview { user, thread })
+    }
