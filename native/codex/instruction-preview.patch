+    assert!(inspect_checkpoint_history(root.path(), id, &owner, &reservation, &grant, &composite, &rollout_hash, &journal_hash).await.is_err());
+    fs::write(&config_path, config_bytes).unwrap();
+    owner.close();
+    assert!(inspect_checkpoint_history(root.path(), id, &owner, &reservation, &grant, &composite, &rollout_hash, &journal_hash).await.is_err());
+}
