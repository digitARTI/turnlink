diff --git a/codex-rs/model-provider/src/provider_preparation.rs b/codex-rs/model-provider/src/provider_preparation.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/model-provider/src/provider_preparation.rs
@@ -0,0 +1,2366 @@
+//! Native provider selection and explicit construction. Read-only preparation
+//! never calls the factory or starts credential/model work. Construction is a
+//! separate native effect with ordinary process-shared resource semantics.
+use super::*;
+use codex_login::NativeAuthCacheObservation;
+use sha2::{Digest, Sha256};
+use std::any::Any;
+use std::collections::HashMap;
+
+fn native_tool_catalog_busy() -> CodexErr {
+    std::io::Error::new(std::io::ErrorKind::WouldBlock, "native tool model catalog is busy").into()
+}
+
+// Private comparison evidence only: never serialize it or expose the input
+// names or digests as a credential/readiness receipt. This detects observed
+// drift, not changes restored between reads or undeclared SDK inputs.
+#[derive(PartialEq, Eq)]
+struct NativeProviderEnvironment(Vec<[u8; 32]>);
+
+fn observe_environment_with(
+    names: &[String],
+    mut read: impl FnMut(&str) -> Result<String, std::env::VarError>,
+) -> Result<NativeProviderEnvironment, CodexErr> {
+    if names.len() > 256 {
+        return Err(unavailable());
+    }
+    let mut total = 0usize;
+    let mut observed = Vec::with_capacity(names.len());
+    for name in names {
+        if name.is_empty() || name.len() > 4096 || name.contains(['=', '\0']) {
+            return Err(unavailable());
+        }
+        let mut hash = Sha256::new();
+        match read(name) {
+            Ok(value) => {
+                total = total.checked_add(value.len()).ok_or_else(unavailable)?;
+                if total > 1024 * 1024 {
+                    return Err(unavailable());
+                }
+                hash.update([1]);
+                hash.update(value.as_bytes());
+            }
+            Err(std::env::VarError::NotPresent) => hash.update([0]),
+            Err(std::env::VarError::NotUnicode(_)) => hash.update([2]),
+        }
+        observed.push(hash.finalize().into());
+    }
+    Ok(NativeProviderEnvironment(observed))
+}
+
+fn observe_environment(names: &[String]) -> Result<NativeProviderEnvironment, CodexErr> {
+    observe_environment_with(names, |name| std::env::var(name))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeProviderFamily {
+    Configured,
+    GoogleCloud,
+    AmazonBedrock,
+}
+
+/// Declared work to establish/bind explicitly. These flags prove no readiness.
+#[derive(Debug)]
+pub struct NativeProviderResources {
+    family: NativeProviderFamily,
+    command_auth: bool,
+    gateway_oauth: bool,
+    aws_credentials: bool,
+    environment_inputs: Vec<String>,
+}
+impl NativeProviderResources {
+    pub fn family(&self) -> NativeProviderFamily {
+        self.family
+    }
+    pub fn command_auth(&self) -> bool {
+        self.command_auth
+    }
+    pub fn gateway_oauth(&self) -> bool {
+        self.gateway_oauth
+    }
+    pub fn aws_credentials(&self) -> bool {
+        self.aws_credentials
+    }
+    /// Names only. Values, process mutation exclusion and external SDK/keychain
+    /// credential sources are not observed or certified by this declaration.
+    pub fn environment_inputs(&self) -> &[String] {
+        &self.environment_inputs
+    }
+}
+
+/// Bound actual native source and effective destination definition, not a grant.
+/// No executable provider is constructed and no source scope is retagged ready.
+pub struct NativeProviderPreparation {
+    source: SharedModelProvider,
+    source_definition: ModelProviderInfo,
+    auth: Option<NativeAuthCacheObservation>,
+    base_auth: Option<NativeAuthCacheObservation>,
+    selected_id: String,
+    destination_definition: ModelProviderInfo,
+    resources: NativeProviderResources,
+    environment: NativeProviderEnvironment,
+}
+impl fmt::Debug for NativeProviderPreparation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("NativeProviderPreparation")
+            .finish_non_exhaustive()
+    }
+}
+fn unavailable() -> CodexErr {
+    CodexErr::InvalidRequest("native selected provider preparation unavailable".into())
+}
+
+// Concrete native access only: unknown trait methods (including info/auth_manager)
+// are never called to discover whether a host can supply preparation evidence.
+fn native_source(
+    provider: &SharedModelProvider,
+) -> Result<(&ModelProviderInfo, Option<Arc<AuthManager>>), CodexErr> {
+    let concrete: &dyn Any = provider.as_ref();
+    if let Some(native) = concrete.downcast_ref::<ConfiguredModelProvider>() {
+        Ok((&native.info, native.auth_manager.clone()))
+    } else if let Some(native) = concrete.downcast_ref::<GcpModelProvider>() {
+        Ok(native.preparation_fields())
+    } else if let Some(native) = concrete.downcast_ref::<AmazonBedrockModelProvider>() {
+        Ok(native.preparation_fields())
+    } else {
+        Err(unavailable())
+    }
+}
+
+fn native_base_auth(provider: &SharedModelProvider) -> Result<Option<Arc<AuthManager>>, CodexErr> {
+    let concrete: &dyn Any = provider.as_ref();
+    if let Some(native) = concrete.downcast_ref::<ConfiguredModelProvider>() {
+        Ok(native.base_auth_manager.clone())
+    } else if let Some(native) = concrete.downcast_ref::<GcpModelProvider>() {
+        Ok(native.base_auth_manager.clone())
+    } else if let Some(native) = concrete.downcast_ref::<AmazonBedrockModelProvider>() {
+        Ok(native.base_auth_manager.clone())
+    } else {
+        Err(unavailable())
+    }
+}
+
+/// Native immutable definition only; no callback/auth/source observation occurs.
+pub fn native_provider_configuration(
+    provider: &SharedModelProvider,
+) -> Result<ModelProviderInfo, CodexErr> {
+    Ok(native_source(provider)?.0.clone())
+}
+fn family(info: &ModelProviderInfo) -> NativeProviderFamily {
+    if info.is_amazon_bedrock() {
+        NativeProviderFamily::AmazonBedrock
+    } else if info.is_gcp() {
+        NativeProviderFamily::GoogleCloud
+    } else {
+        NativeProviderFamily::Configured
+    }
+}
+fn resources(info: &ModelProviderInfo) -> NativeProviderResources {
+    let mut names: Vec<String> = info
+        .env_key
+        .iter()
+        .cloned()
+        .chain(
+            info.env_http_headers
+                .iter()
+                .flat_map(|headers| headers.values().cloned()),
+        )
+        .collect();
+    if info.is_gcp() {
+        names.extend([
+            "GOOGLE_CLOUD_PROJECT".into(),
+            "GOOGLE_CLOUD_LOCATION".into(),
+        ]);
+    }
+    if info.is_amazon_bedrock() {
+        // Native Bedrock auth selection reads these directly, including when a
+        // provider has no explicit env_key. AWS SDK configuration and helper
+        // inputs have additional sources and are not covered by this list.
+        names.extend([
+            "AWS_BEARER_TOKEN_BEDROCK".into(),
+            "AWS_ACCESS_KEY_ID".into(),
+            "AWS_SECRET_ACCESS_KEY".into(),
+            "AWS_REGION".into(),
+            "AWS_DEFAULT_REGION".into(),
+        ]);
+    }
+    names.sort();
+    names.dedup();
+    NativeProviderResources {
+        family: family(info),
+        command_auth: info.has_command_auth(),
+        gateway_oauth: info.gateway_oauth.is_some(),
+        aws_credentials: info.is_amazon_bedrock() || info.aws.is_some(),
+        environment_inputs: names,
+    }
+}
+
+/// Resolve the actual selected key, independently of a destination default.
+/// Caller supplies native-constructed maps/requirement, not JSON capabilities.
+pub fn prepare_native_provider(
+    source: &SharedModelProvider,
+    selected_id: &str,
+    source_definition: &ModelProviderInfo,
+    destination_definitions: &HashMap<String, ModelProviderInfo>,
+    required_destination_id: Option<&str>,
+) -> Result<NativeProviderPreparation, CodexErr> {
+    if selected_id.is_empty()
+        || required_destination_id.is_some_and(|required| required != selected_id)
+    {
+        return Err(unavailable());
+    }
+    let (actual, auth_manager) = native_source(source)?;
+    if actual != source_definition {
+        return Err(unavailable());
+    }
+    let destination_definition = destination_definitions
+        .get(selected_id)
+        .ok_or_else(unavailable)?;
+    destination_definition
+        .validate()
+        .map_err(|_| unavailable())?;
+    let auth = auth_manager
+        .as_ref()
+        .map(|manager| manager.native_cached_observation())
+        .transpose()?;
+    let base_manager = native_base_auth(source)?;
+    let base_auth = base_manager
+        .as_ref()
+        .map(|manager| manager.native_cached_observation())
+        .transpose()?;
+    for (observed, manager) in [(&auth, &auth_manager), (&base_auth, &base_manager)] {
+        match (observed, manager) {
+            (Some(observed), Some(manager)) if observed.is_current(manager) => {}
+            (None, None) => {}
+            _ => return Err(unavailable()),
+        }
+    }
+    let resources = resources(destination_definition);
+    let environment = observe_environment(resources.environment_inputs())?;
+    Ok(NativeProviderPreparation {
+        source: Arc::clone(source),
+        source_definition: actual.clone(),
+        auth,
+        base_auth,
+        selected_id: selected_id.to_owned(),
+        destination_definition: destination_definition.clone(),
+        resources,
+        environment,
+    })
+}
+impl NativeProviderPreparation {
+    /// A narrow anonymous configured-provider recipe. It contains no bearer,
+    /// header, environment, cloud or command authentication inputs. This is a
+    /// policy component, not provider readiness or authorization. Callers must
+    /// retain and revalidate this exact preparation around its use.
+    pub fn native_anonymous_recipe(&self) -> Option<serde_json::Value> {
+        if self.auth.is_some() || self.base_auth.is_some() || self.resources.family != NativeProviderFamily::Configured
+            || !self.resources.environment_inputs.is_empty() { return None; }
+        portable_anonymous_definition(&self.source_definition)?;
+        let definition = portable_anonymous_definition(&self.destination_definition)?;
+        Some(serde_json::json!({"version": 1, "family": "configured_anonymous", "selectedId": self.selected_id, "definition": definition}))
+    }
+    /// Reject a missing declared env-key before starting destination effects.
+    /// This is only a local presence check: it does not authenticate against a
+    /// provider, resolve command/cloud credentials, or certify readiness.
+    pub fn observe_declared_environment_credential(&self) -> Result<Option<bool>, CodexErr> {
+        if self.resources.family != NativeProviderFamily::Configured
+            || self.destination_definition.env_key.is_none()
+        {
+            return Ok(None);
+        }
+        if observe_environment(self.resources.environment_inputs())? != self.environment {
+            return Err(unavailable());
+        }
+        // Use the ordinary provider's exact empty/whitespace handling, while
+        // discarding both the value and any error that could name the variable.
+        let present = self.destination_definition.api_key().is_ok_and(|value| value.is_some());
+        if observe_environment(self.resources.environment_inputs())? != self.environment {
+            return Err(unavailable());
+        }
+        Ok(Some(present))
+    }
+
+    pub fn selected_id(&self) -> &str {
+        &self.selected_id
+    }
+    pub fn destination_definition(&self) -> &ModelProviderInfo {
+        &self.destination_definition
+    }
+    pub fn resources(&self) -> &NativeProviderResources {
+        &self.resources
+    }
+    pub fn revalidate(
+        &self,
+        source: &SharedModelProvider,
+        destination_definitions: &HashMap<String, ModelProviderInfo>,
+        required_destination_id: Option<&str>,
+    ) -> Result<bool, CodexErr> {
+        if !Arc::ptr_eq(source, &self.source) {
+            return Ok(false);
+        }
+        let fresh = prepare_native_provider(
+            source,
+            &self.selected_id,
+            &self.source_definition,
+            destination_definitions,
+            required_destination_id,
+        )?;
+        Ok(fresh.auth == self.auth
+            && fresh.base_auth == self.base_auth
+            && fresh.destination_definition == self.destination_definition
+            && fresh.environment == self.environment)
+    }
+}
+
+fn portable_anonymous_definition(info: &ModelProviderInfo) -> Option<serde_json::Value> {
+    // Exhaustive destructuring makes new provider fields a compile-time review
+    // requirement rather than silently omitting them from the recipe.
+    let ModelProviderInfo { name: _, base_url, model_catalog_url, env_key, env_key_instructions,
+        experimental_bearer_token, auth, gateway_oauth, aws, project_id, location, wire_api: _, capabilities: _,
+        query_params, http_headers, env_http_headers, request_max_retries: _, stream_max_retries: _,
+        stream_idle_timeout_ms: _, websocket_connect_timeout_ms: _, requires_openai_auth,
+        supports_websockets: _, supports_standalone_web_search: _, include_internal_metadata } = info;
+    if family(info) != NativeProviderFamily::Configured || model_catalog_url.is_some() || env_key.is_some()
+        || env_key_instructions.is_some() || experimental_bearer_token.is_some() || auth.is_some()
+        || gateway_oauth.is_some() || aws.is_some() || project_id.is_some() || location.is_some()
+        || query_params.is_some() || http_headers.is_some() || env_http_headers.is_some()
+        || *requires_openai_auth || *include_internal_metadata { return None; }
+    let url = url::Url::parse(base_url.as_deref()?).ok()?;
+    if !matches!(url.scheme(), "http" | "https") || url.host_str().is_none() || !url.username().is_empty()
+        || url.password().is_some() || url.query().is_some() || url.fragment().is_some()
+        || !matches!(url.path(), "" | "/" | "/v1" | "/v1/") { return None; }
+    serde_json::to_value(info).ok()
+}
+
+/// Owned result of an explicit native factory effect. This is neither an
+/// authorization token nor credential/tool readiness. The trusted host must
+/// authorize resource establishment before calling `construct_destination`.
+/// Dropping this object releases its owned provider handles; native process-wide
+/// shared-state caches retain their ordinary factory lifetime semantics.
+pub struct NativeConstructedProvider {
+    preparation: NativeProviderPreparation,
+    provider: SharedModelProvider,
+    auth: Option<NativeAuthCacheObservation>,
+    exposed: std::sync::atomic::AtomicBool,
+    handle_exposed: std::sync::atomic::AtomicBool,
+    completed_catalog_reconcilable: bool,
+    model_context: Option<Box<NativeProviderModelContext>>,
+}
+
+/// A retained provider and model manager awaiting the host's publication
+/// transaction. No live handle is exposed until `publish`.
+/// This owner is not itself an authorization or a crash-recovery protocol.
+pub struct NativeProviderPublication {
+    owner: Arc<tokio::sync::Mutex<NativeConstructedProvider>>,
+}
+
+/// Exact factory owners transferred together. Installing them still requires
+/// the session's publication barrier, durable intent, and old-owner cleanup.
+pub struct NativePublishedProvider {
+    pub provider: SharedModelProvider,
+    pub models_manager: SharedModelsManager,
+    // Preserve the original preparation and used-resource evidence while the
+    // session retains the published pair. Dropping this wrapper is not proof
+    // that published handles or their effects have been reconciled.
+    _owner: Arc<tokio::sync::Mutex<NativeConstructedProvider>>,
+}
+
+impl fmt::Debug for NativeProviderPublication {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("NativeProviderPublication")
+            .finish_non_exhaustive()
+    }
+}
+
+// Only the closed configured-provider path with an explicit catalog endpoint,
+// API-key or cached ChatGPT credentials and no external auth callback is
+// eligible for the completed-catalog owner-release protocol. This is not
+// credential readiness. The same observation must survive the entire request;
+// an auth refresh invalidates it even if credentials later look equal.
+fn catalog_cleanup_auth(
+    provider: &SharedModelProvider,
+) -> Result<Option<NativeAuthCacheObservation>, CodexErr> {
+    let concrete: &dyn Any = provider.as_ref();
+    let configured = concrete
+        .downcast_ref::<ConfiguredModelProvider>()
+        .ok_or_else(unavailable)?;
+    let info = &configured.info;
+    let has_provider_key = info.env_key.is_some() || info.experimental_bearer_token.is_some();
+    if info.model_catalog_url.is_none()
+        || (!has_provider_key && !info.requires_openai_auth)
+        || info.auth.is_some()
+        || info.gateway_oauth.is_some()
+        || info.aws.is_some()
+    {
+        return Err(unavailable());
+    }
+    match &configured.auth_manager {
+        Some(manager) => {
+            if manager.has_external_auth() {
+                return Err(unavailable());
+            }
+            let observed = manager.native_cached_observation()?;
+            if manager.has_external_auth()
+                || !observed.is_current(manager)
+                || observed
+                    .auth()
+                    .is_some_and(|auth| !auth.is_api_key_auth() && !auth.is_chatgpt_auth())
+                || (!has_provider_key && observed.auth().is_none())
+            {
+                return Err(unavailable());
+            }
+            Ok(Some(observed))
+        }
+        None if has_provider_key => Ok(None),
+        None => Err(unavailable()),
+    }
+}
+
+fn catalog_cleanup_auth_current(
+    provider: &SharedModelProvider,
+    observed: &Option<NativeAuthCacheObservation>,
+) -> bool {
+    catalog_cleanup_auth(provider).is_ok_and(|current| match (observed, current) {
+        (Some(expected), Some(actual)) => *expected == actual,
+        (None, None) => true,
+        _ => false,
+    })
+}
