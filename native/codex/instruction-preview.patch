+    /// Retire only an unconsumed, exact movement binding after the host has
+    /// freshly authorized cancellation. This performs no external operation.
+    #[allow(dead_code)]
+    pub(crate) async fn continuity_cancel_destination_grant(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        retained: &codex_protocol::protocol::ContinuityStepPreparationReceipt,
+        cancellation_id: uuid::Uuid,
+    ) -> CodexResult<DestinationGrantCancellation> {
+        let path = self.continuity_receipt_path().await;
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let mut state = self.state.lock().await;
+        state
+            .continuity
+            .check_owner_and_source(owner, reservation)?;
+        let current_cwd = state.session_configuration.legacy_fallback_cwd.clone();
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        if let Some(cancelled) = &held.journal.destination_cancellation {
+            return if cancelled.cancellation_id == cancellation_id
+                && &cancelled.grant == grant
+                && cancelled.step_id == retained.step_id
+                && held
+                    .journal
+                    .step
+                    .as_ref()
+                    .is_some_and(|step| step.receipt.as_ref() == Some(retained))
+            {
+                Ok(cancelled.clone())
+            } else {
+                Err(refused())
+            };
+        }
+        let approved = held.approved.as_ref().ok_or_else(refused)?;
+        if held.invalid
+            || held.journal.phase != "provider_constructed"
+            || &approved.grant != grant
+            || current_cwd != grant.from
+            || !destination_grant_matches(&held.journal, grant)
+            || !held
+                .journal
+                .step
+                .as_ref()
+                .is_some_and(|step| step.receipt.as_ref() == Some(retained))
+        {
+            return Err(refused());
+        }
+        approved.source.validate()?;
+        let cancellation = DestinationGrantCancellation {
+            cancellation_id,
+            grant: grant.clone(),
+            step_id: retained.step_id,
+        };
+        let mut journal = held.journal.clone();
+        journal.host_grant = None;
+        journal.destination_cancellation = Some(cancellation.clone());
+        if !destination_grant_matches(&journal, grant) {
+            return Err(refused());
+        }
+        if write_journal(&path, &journal).is_err() || !owner.is_open() {
+            held.invalidate();
+            return Err(refused());
+        }
+        held.journal = journal;
+        held.approved = None;
+        Ok(cancellation)
+    }
