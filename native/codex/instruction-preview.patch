+impl NativeConstraintBinding {
+    /// Captured policy is owned immutable data from a closed native constructor.
+    /// This does not approve values or replace installed-enforcer identity checks.
+    pub fn has_closed_callback_state(&self) -> bool {
+        self.closed_state
+    }
+
+    pub fn matches<T: Send + Sync + 'static>(&self, candidate: &Constrained<T>) -> bool {
+        (self.matches)(candidate)
+    }
