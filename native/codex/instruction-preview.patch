+//! Process-local native file-cache actors and their actual blocking workers.
+//! This excludes compatible cache API calls, not external processes/raw file
+//! writers, other cache implementations, credentials, HTTP or execution authority.
+use crate::cache::ModelsCacheError;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, MutexGuard, OnceLock, Weak};
+
+const MAX_ACTORS: usize = 4096;
+#[derive(Debug)]
+pub(crate) struct NativeFileCacheActor {
+    path: PathBuf,
+}
+#[derive(Default)]
+struct Registry {
+    revision: Arc<()>,
+    actors: Vec<Weak<NativeFileCacheActor>>,
+    active: usize,
+    uncertain: bool,
+    held: Option<Arc<()>>,
+}
+fn registry() -> &'static Mutex<Registry> {
+    static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
+    REGISTRY.get_or_init(Default::default)
+}
+fn unavailable() -> ModelsCacheError {
+    ModelsCacheError::new("native file-cache I/O unavailable")
+}
+pub(crate) fn register(path: PathBuf) -> Result<Arc<NativeFileCacheActor>, ModelsCacheError> {
+    let mut state = registry().lock().map_err(|_| unavailable())?;
+    state.actors.retain(|actor| actor.strong_count() != 0);
+    if state.actors.len() >= MAX_ACTORS {
+        return Err(unavailable());
+    }
+    let actor = Arc::new(NativeFileCacheActor { path });
+    state.actors.push(Arc::downgrade(&actor));
+    // New actors cannot execute during a hold, and invalidate its prior census.
+    state.revision = Arc::new(());
+    Ok(actor)
+}
+
+/// Exclusive process-local cut over the built-in file-cache API and its actual
+/// blocking workers. Paths describe actors, not canonical filesystem identities.
+/// The caller must separately establish storage compatibility and authorize its
+/// operation; this is not a persistence, global quiescence or readiness receipt.
+#[must_use = "retain the guard until the native cache cut is no longer needed"]
+pub struct NativeFileCacheHold {
+    lease: Arc<()>,
+    revision: Arc<()>,
+    actors: Vec<Arc<NativeFileCacheActor>>,
+}
+impl std::fmt::Debug for NativeFileCacheHold {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeFileCacheHold")
+            .finish_non_exhaustive()
+    }
+}
+/// Keeps census validation and a caller's synchronous publication in the same
+/// critical section. The guard borrows its exact hold and is not Send: release
+/// it before awaiting or doing persistence, cache construction or cache I/O.
+/// It covers this registry only, not Session authority or other resource domains.
+#[must_use = "retain this guard through the synchronous publication"]
+pub struct NativeFileCachePublicationGuard<'a> {
+    _registry: MutexGuard<'a, Registry>,
+    _hold: &'a NativeFileCacheHold,
+}
+impl std::fmt::Debug for NativeFileCachePublicationGuard<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeFileCachePublicationGuard")
+            .finish_non_exhaustive()
+    }
+}
+impl NativeFileCacheHold {
+    pub fn actor_paths(&self) -> impl Iterator<Item = &Path> {
+        self.actors.iter().map(|actor| actor.path.as_path())
+    }
+    pub fn is_current(&self) -> bool {
+        let Ok(state) = registry().try_lock() else {
+            return false;
+        };
+        self.matches(&state)
+    }
+    fn matches(&self, state: &Registry) -> bool {
+        state.active == 0
+            && !state.uncertain
+            && Arc::ptr_eq(&state.revision, &self.revision)
+            && state
+                .held
+                .as_ref()
+                .is_some_and(|lease| Arc::ptr_eq(lease, &self.lease))
+    }
+    /// Nonblocking entry. Unlike `is_current`, this keeps registration/revision
+    /// changes excluded until the returned guard leaves the publication scope.
+    pub fn lock_for_publication(
+        &self,
+    ) -> Result<NativeFileCachePublicationGuard<'_>, ModelsCacheError> {
+        let state = registry().try_lock().map_err(|_| unavailable())?;
+        if !self.matches(&state) {
+            return Err(unavailable());
+        }
+        Ok(NativeFileCachePublicationGuard {
+            _registry: state,
+            _hold: self,
+        })
+    }
+}
+impl Drop for NativeFileCacheHold {
+    fn drop(&mut self) {
+        let Ok(mut state) = registry().lock() else {
+            return;
+        };
+        if state
+            .held
+            .as_ref()
+            .is_some_and(|lease| Arc::ptr_eq(lease, &self.lease))
+        {
+            state.held = None;
+            state.revision = Arc::new(());
+        }
+    }
+}
+/// Refuses while actual workers remain queued/running, after an unobserved
+/// worker termination, or while another owner holds the cut. No waits or I/O.
+pub fn hold_native_file_cache_io() -> Result<NativeFileCacheHold, ModelsCacheError> {
+    let mut state = registry().try_lock().map_err(|_| unavailable())?;
+    if state.active != 0 || state.uncertain || state.held.is_some() {
+        return Err(unavailable());
+    }
+    state.actors.retain(|actor| actor.strong_count() != 0);
+    let actors = state.actors.iter().filter_map(Weak::upgrade).collect();
+    let lease = Arc::new(());
+    state.held = Some(lease.clone());
+    state.revision = Arc::new(());
+    Ok(NativeFileCacheHold {
+        lease,
+        revision: state.revision.clone(),
+        actors,
+    })
+}
+struct Permit {
+    // Keep an orphaned actor visible after its cache/caller has been dropped.
+    _actor: Arc<NativeFileCacheActor>,
+    completed: bool,
+}
+impl Permit {
+    fn enter(actor: Arc<NativeFileCacheActor>) -> Result<Self, ModelsCacheError> {
+        let mut state = registry().lock().map_err(|_| unavailable())?;
+        if state.held.is_some() || state.uncertain {
+            return Err(unavailable());
+        }
+        state.active = state.active.checked_add(1).ok_or_else(unavailable)?;
+        state.revision = Arc::new(());
+        Ok(Self {
+            _actor: actor,
+            completed: false,
+        })
+    }
+}
+impl Drop for Permit {
+    fn drop(&mut self) {
+        let Ok(mut state) = registry().lock() else {
+            return;
+        };
+        if state.active == 0 {
+            state.uncertain = true;
+        } else {
+            state.active -= 1;
+        }
+        state.uncertain |= !self.completed;
+        state.revision = Arc::new(());
+    }
+}
+/// The permit enters before submission and lives IN the blocking closure. A
+/// dropped/aborted outer future cannot relabel queued filesystem work as idle.
+/// Only this module's closed native cache paths call this helper in production.
+pub(crate) async fn execute<T: Send + 'static>(
+    actor: &Result<Arc<NativeFileCacheActor>, ModelsCacheError>,
+    job: impl FnOnce() -> Result<T, ModelsCacheError> + Send + 'static,
+) -> Result<T, ModelsCacheError> {
+    let permit = Permit::enter(actor.as_ref().map_err(Clone::clone)?.clone())?;
+    tokio::task::spawn_blocking(move || {
+        let mut permit = permit;
+        let result = job();
+        // std file operations have returned and dropped their handles, including
+        // on ordinary I/O errors. Panic/cancellation before entry stays uncertain.
+        permit.completed = true;
+        result
+    })
+    .await
+    .map_err(|_| unavailable())?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cache::{FileModelsCache, ModelsCache, ModelsCacheEntry};
+    use chrono::Utc;
+    use std::time::Duration;
+
+    #[test]
+    fn native_file_cache_cut_runs_isolated_physical_worker_and_alias_regressions() {
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "native_file_io::tests::native_file_cache_cut_child",
+                "--ignored",
+                "--nocapture",
+            ])
+            .env("TURNLINK_NATIVE_CACHE_IO_CHILD", "1")
+            .env_remove("RUST_MIN_STACK")
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "child failed: {}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(String::from_utf8_lossy(&output.stdout).contains("1 passed; 0 failed"));
+    }
+
+    #[test]
+    #[ignore = "process-global native cache cut is exercised by isolated parent"]
+    fn native_file_cache_cut_child() {
+        assert_eq!(
+            std::env::var("TURNLINK_NATIVE_CACHE_IO_CHILD").unwrap(),
+            "1"
+        );
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .max_blocking_threads(1)
+            .build()
+            .unwrap();
+        runtime.block_on(async {
+            let home = tempfile::tempdir().unwrap();
+            let path = home.path().join("orphan.json");
+            let cache = Arc::new(FileModelsCache::new(path.clone(), Duration::from_secs(60)));
+            let weak_cache = Arc::downgrade(&cache);
+            let entry = ModelsCacheEntry {
+                fetched_at: Utc::now(),
+                etag: Some("etag".into()),
+                client_version: Some("v".into()),
+                identity: Some("owner".into()),
+                models: vec![],
+            };
+            let (started, started_rx) = tokio::sync::oneshot::channel();
+            let (release, release_rx) = std::sync::mpsc::channel();
+            let blocker = tokio::task::spawn_blocking(move || {
+                started.send(()).unwrap();
+                release_rx.recv().unwrap();
+            });
+            started_rx.await.unwrap();
+            let caller_cache = cache.clone();
+            let caller_entry = entry.clone();
+            let caller = tokio::spawn(async move { caller_cache.store(&caller_entry).await });
+            tokio::time::timeout(Duration::from_secs(5), async {
+                while registry().lock().unwrap().active == 0 {
+                    tokio::task::yield_now().await;
+                }
+            })
+            .await
+            .unwrap();
+            assert!(
+                !path.exists(),
+                "real write is queued behind the occupied blocking worker"
+            );
+            drop(cache);
+            caller.abort();
+            assert!(caller.await.unwrap_err().is_cancelled());
+            assert!(weak_cache.upgrade().is_none(), "cache and caller are gone");
+            assert!(
+                hold_native_file_cache_io().is_err(),
+                "orphaned queued I/O is still actual work"
+            );
+            assert_eq!(registry().lock().unwrap().active, 1);
+            release.send(()).unwrap();
+            blocker.await.unwrap();
+            tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    let finished = {
+                        let state = registry().lock().unwrap();
+                        state.active == 0
+                            && state.actors.iter().all(|actor| actor.strong_count() == 0)
+                    };
+                    if finished {
+                        break;
+                    }
+                    tokio::task::yield_now().await;
+                }
+            })
+            .await
+            .unwrap();
+            let stored: ModelsCacheEntry =
+                serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+            assert_eq!(
+                stored, entry,
+                "actual queued worker completed after caller cancellation"
+            );
+            let finished = hold_native_file_cache_io().unwrap();
+            assert!(finished.is_current());
+            assert_eq!(
+                finished.actor_paths().count(),
+                0,
+                "orphan actor retired only after its worker finished"
+            );
+            drop(finished);
+
+            let cache = Arc::new(FileModelsCache::new(
+                home.path().join("first.json"),
+                Duration::from_secs(60),
+            ));
+            let alias = cache.clone();
+            let independent =
+                FileModelsCache::new(home.path().join("first.json"), Duration::from_secs(60));
+            let held = hold_native_file_cache_io().unwrap();
+            assert!(held.is_current());
+            {
+                let _publication = held.lock_for_publication().unwrap();
+                assert!(
+                    registry().try_lock().is_err(),
+                    "registration cannot change the census during publication"
+                );
+                assert!(
+                    held.lock_for_publication().is_err(),
+                    "nested publication refuses without waiting"
+                );
+                assert!(hold_native_file_cache_io().is_err());
+            }
+            assert!(
+                held.is_current(),
+                "publication guard release retains the actual I/O fence"
+            );
+            let foreign = NativeFileCacheHold {
+                lease: Arc::new(()),
+                revision: held.revision.clone(),
+                actors: vec![],
+            };
+            assert!(
+                foreign.lock_for_publication().is_err(),
+                "matching revision alone cannot adopt another lease"
+            );
+            drop(foreign);
+            assert!(held.is_current());
+            assert_eq!(
+                held.actor_paths().count(),
+                2,
+                "independent factories for the same file are both enumerated"
+            );
+            assert!(
+                held.actor_paths()
+                    .all(|path| path == home.path().join("first.json"))
+            );
+            assert!(independent.store(&entry).await.is_err());
+            assert!(alias.store(&entry).await.is_err());
+            assert!(alias.load("v").await.is_err());
+            assert!(alias.refresh_ttl("v", "owner", "etag").await.is_err());
+            assert!(!home.path().join("first.json").exists());
+            let originator = cache
+                .for_originator(crate::ModelCatalogOriginator::Work)
+                .unwrap();
+            assert!(!held.is_current());
+            assert!(
+                held.lock_for_publication().is_err(),
+                "a late actor cannot be retagged into the old census"
+            );
+            assert!(originator.store(&entry).await.is_err());
+            let next =
+                FileModelsCache::new(home.path().join("second.json"), Duration::from_secs(60));
+            assert!(
+                !held.is_current(),
+                "late registration invalidates the census even before I/O"
+            );
+            assert!(next.store(&entry).await.is_err());
+            assert!(!home.path().join("second.json").exists());
+            assert!(
+                hold_native_file_cache_io().is_err(),
+                "invalidating a hold does not release its fence"
+            );
+            drop(held);
+            next.store(&entry).await.unwrap();
+            assert_eq!(next.load("v").await.unwrap(), Some(entry.clone()));
+            drop(alias);
+            drop(cache);
+            drop(next);
+            drop(independent);
+            drop(originator);
+            let held = hold_native_file_cache_io().unwrap();
+            assert!(held.is_current());
+            assert_eq!(held.actor_paths().count(), 0);
+            drop(held);
+
+            let not_directory = home.path().join("not-directory");
+            std::fs::write(&not_directory, b"file").unwrap();
+            let failed =
+                FileModelsCache::new(not_directory.join("cache.json"), Duration::from_secs(60));
+            assert!(failed.store(&entry).await.is_err());
+            let held = hold_native_file_cache_io().unwrap();
+            assert!(
+                held.is_current(),
+                "ordinary I/O errors still end actual worker lifetime"
+            );
+            drop(held);
+
+            let actor = register(home.path().join("panic.json"));
+            let result = execute::<()>(&actor, || panic!("isolated native worker panic")).await;
+            assert!(result.is_err());
+            assert_eq!(registry().lock().unwrap().active, 0);
+            assert!(
+                hold_native_file_cache_io().is_err(),
+                "panic cannot mint a clean cut from zero counters"
+            );
+        });
+    }
+}
