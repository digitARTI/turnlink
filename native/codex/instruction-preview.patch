+/// Assemble a narrow anonymous guest candidate with the same constructor used
+/// by ordinary startup, without creating a Session. The caller must obtain the
+/// resolved inputs from the authenticated checkpoint and separately bind and
+/// revalidate the complete Config, snapshot, filesystem and guest lease.
+#[allow(dead_code)]
+fn assemble_native_quarantined_session(input: ResolvedSessionConfiguration) -> CodexResult<NativeQuarantinedSessionCandidate> {
+    let refused = |stage: &str| CodexErr::InvalidRequest(format!("native quarantined session inputs unsupported: {stage}"));
+    let config = &input.config;
+    let mut overrides = config.native_invocation_overrides().map_err(|_| refused("invocation"))?.clone();
+    // These paths are native runtime locations and require separate build and
+    // store binding; no other invocation override is in this class.
+    overrides.cwd = None;
+    overrides.codex_self_exe = None;
+    overrides.codex_linux_sandbox_exe = None;
+    if overrides != crate::config::ConfigOverrides::default() { return Err(refused("overrides")); }
+    if config.config_layer_stack.requirements_toml() != &codex_config::ConfigRequirementsToml::default()
+        || config.config_layer_stack.cloud_config_binding().is_some() { return Err(refused("requirements")); }
+    if config.application_network_policy != codex_http_client::NetworkPolicy::default()
+        || config.application_auth_route_config.is_some() { return Err(refused("network or auth route")); }
+    if !input.turn_extension_init.native_is_empty() || !input.dynamic_tools.is_empty()
+        || !input.disabled_plugin_ids.is_empty() || input.metrics_service_name.is_some()
+        || input.trusted_guardian_reviewer || input.user_shell_override.is_some()
+        || input.parent_thread_id.is_some() || input.forked_from_thread_id.is_some()
+        || input.thread_source.is_some()
+        || !matches!(&input.session_source, SessionSource::Exec | SessionSource::VSCode)
+        || input.environments.iter().any(|environment| !matches!(&environment.config, codex_protocol::protocol::EnvironmentConfigState::FromThread)
+            || environment.selected_capability_roots != Default::default())
+    { return Err(refused("session")); }
+    // The loader always installs packaged defaults. Accept only the exact
+    // compiled defaults and a narrowly scoped user layer; arbitrary packaged,
+    // managed, project or session-flag overrides remain unsupported.
+    let packaged: toml::Value = toml::from_str(include_str!("../../../config/defaults.toml"))
+        .map_err(|_| refused("packaged defaults"))?;
+    let executable = std::env::current_exe().map_err(|_| refused("packaged defaults"))?;
+    let mut packaged_count = 0;
+    for layer in config.config_layer_stack.layers_low_to_high() {
+        let table = layer.config.as_table().ok_or_else(|| refused("config"))?;
+        match &layer.name {
+            codex_config::ConfigLayerSource::PackagedDefaults { file } => {
+                packaged_count += 1;
+                if file.as_path() != executable.as_path() || layer.config != packaged { return Err(refused("packaged defaults")); }
+            }
+            codex_config::ConfigLayerSource::User { profile: None, .. } => {
+                if table.keys().any(|key| !matches!(key.as_str(), "model" | "model_provider" | "model_providers" | "instructions")) {
+                    return Err(refused("config keys"));
+                }
+                if let Some(providers) = table.get("model_providers") {
+                    let providers = providers.as_table().ok_or_else(|| refused("provider keys"))?;
+                    if providers.len() != 1 { return Err(refused("provider keys")); }
+                    let definition = providers.get(&config.model_provider_id).and_then(toml::Value::as_table)
+                        .ok_or_else(|| refused("provider keys"))?;
+                    if definition.keys().any(|key| !matches!(key.as_str(), "name" | "base_url" | "wire_api")) {
+                        return Err(refused("provider keys"));
+                    }
+                }
+            }
+            codex_config::ConfigLayerSource::System { .. } if table.is_empty() => {}
+            _ => return Err(refused("config source")),
+        }
+    }
+    if packaged_count != 1 { return Err(refused("packaged defaults")); }
+    let model = config.model.clone().filter(|model| !model.trim().is_empty()).ok_or_else(|| refused("model"))?;
+    if config.base_instructions.as_ref() != Some(&input.base_instructions)
+        || input.collaboration_mode != (CollaborationMode { mode: ModeKind::Default, settings: Settings {
+            model, reasoning_effort: config.model_reasoning_effort.clone(), developer_instructions: None,
+        } }) { return Err(refused("model or instructions")); }
+    let enforcers = crate::config::NativeConfigConstraintBindings::capture(config);
+    let rule_recipes = enforcers.native_recipes(config).ok_or_else(|| refused("enforcers"))?;
+    let provider = codex_model_provider::prepare_native_provider(&input.provider, &config.model_provider_id,
+        &config.model_provider, &config.model_providers, config.config_layer_stack.required_model_provider())?;
+    let provider_recipe = provider.native_anonymous_recipe().ok_or_else(|| refused("provider"))?;
+    let configuration = assemble_session_configuration(input)?;
+    if !configuration.native_matches_closed_session(&configuration)
+        || !provider.revalidate(&configuration.provider, &configuration.original_config_do_not_use.model_providers,
+            configuration.original_config_do_not_use.config_layer_stack.required_model_provider())?
+    { return Err(refused("revalidation")); }
+    Ok(NativeQuarantinedSessionCandidate { configuration, provider, enforcers, rule_recipes, provider_recipe })
+}
