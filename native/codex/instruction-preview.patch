+#[cfg(unix)]
+#[tokio::test]
+async fn continuity_model_socket_restore_child() {
+    let Some(marker) = std::env::var_os("TURNLINK_TEST_MODEL_RESTORE_MARKER") else {
+        return;
+    };
+    let marker: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(marker).unwrap()).unwrap();
+    let path = std::path::PathBuf::from(marker["journal"].as_str().unwrap());
+    let bytes = std::fs::read(&path).unwrap();
+    let journal: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+    let reservation: ContinuityReservation =
+        serde_json::from_value(journal["reservation"].clone()).unwrap();
+    let publication_id =
+        uuid::Uuid::parse_str(journal["publication"]["operation_id"].as_str().unwrap()).unwrap();
+    let shutdown_id = uuid::Uuid::parse_str(marker["shutdown_id"].as_str().unwrap()).unwrap();
+    let (mut session, _) = make_session_and_context().await;
+    session.thread_id =
+        codex_protocol::ThreadId::from_string(journal["thread_id"].as_str().unwrap()).unwrap();
+    let mut config = (*session.get_config().await).clone();
+    config.codex_home = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        path.parent().unwrap().parent().unwrap().to_path_buf(),
+    )
+    .unwrap();
+    session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .original_config_do_not_use = Arc::new(config);
+    session.continuity_restore().await.unwrap();
+    assert!(session.continuity_is_restored_quarantine().await);
+    assert!(session.continuity_mutation().is_err());
+    assert!(
+        session
+            .services
+            .mcp_runtime
+            .load_full()
+            .begin_native_event_request()
+            .is_err()
+    );
+    assert!(
+        session
+            .services
+            .model_client
+            .load_full()
+            .prewarm_auth()
+            .await
+            .is_err()
+    );
+    let successor = ContinuityOwner::new();
+    assert!(session.continuity_acquire(successor.clone()).await.is_err());
+    assert!(
+        session
+            .continuity_release(&successor, &reservation)
+            .await
+            .is_err()
+    );
+    assert!(
+        session
+            .continuity_shutdown_published_source_model(
+                &successor,
+                &reservation,
+                publication_id,
+                shutdown_id,
+            )
+            .await
+            .is_err()
+    );
+    assert_eq!(std::fs::read(path).unwrap(), bytes);
+}
