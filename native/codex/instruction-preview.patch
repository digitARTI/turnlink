+++ b/codex-rs/core/src/config/native_invocation.rs
@@ -0,0 +1,127 @@
+use super::Config;
+use super::ConfigOverrides;
+use std::fmt;
+use std::io;
+use std::sync::Arc;
+
+/// Native constructor provenance, separate from effective configuration values.
+/// Default represents a configuration without captured invocation inputs.
+#[doc(hidden)]
+#[derive(Clone, Default)]
+pub struct NativeConfigInvocation {
+    overrides: Option<Arc<ConfigOverrides>>,
+    resolved_cwd: Option<codex_utils_absolute_path::AbsolutePathBuf>,
+    constraints: Option<Arc<super::native_constraints::NativeConfigConstraintBindings>>,
+    token_budget_startup: Option<Arc<super::token_budget_startup::NativeTokenBudgetStartup>>,
+}
+
+impl NativeConfigInvocation {
+    pub(super) fn capture(overrides: &ConfigOverrides) -> Self {
+        Self {
+            overrides: Some(Arc::new(overrides.clone())),
+            resolved_cwd: None,
+            constraints: None,
+            token_budget_startup: None,
+        }
+    }
+
+    pub(super) fn bind_token_budget_startup(
+        &mut self,
+        binding: Option<super::token_budget_startup::NativeTokenBudgetStartup>,
+    ) {
+        self.token_budget_startup = binding.map(Arc::new);
+    }
+
+    pub(super) fn token_budget_startup_binding(
+        &self,
+    ) -> Option<&super::token_budget_startup::NativeTokenBudgetStartup> {
+        self.token_budget_startup.as_deref()
+    }
+
+    pub(super) fn bind_constraints(
+        &mut self,
+        bindings: super::native_constraints::NativeConfigConstraintBindings,
+    ) {
+        self.constraints = Some(Arc::new(bindings));
+    }
+
+    pub(super) fn bind_cwd(mut self, cwd: &codex_utils_absolute_path::AbsolutePathBuf) -> Self {
+        self.resolved_cwd = Some(cwd.clone());
+        self
+    }
+}
+
+impl fmt::Debug for NativeConfigInvocation {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("NativeConfigInvocation")
+            .field("captured", &self.overrides.is_some())
+            .finish()
+    }
+}
+
+// Config equality describes effective runtime values, just as layer-stack
+// equality excludes private loader provenance. Native continuity must bind the
+// actual captured input identity separately; semantic equality is not proof of
+// invocation provenance.
+impl PartialEq for NativeConfigInvocation {
+    fn eq(&self, _other: &Self) -> bool {
+        true
+    }
+}
+
+impl Config {
+    /// Apply the native host's process-dispatch inputs at their owning boundary.
+    /// This preserves constructor provenance, not executable identity or authority.
+    /// A Config without captured invocation inputs remains unsupported.
+    #[doc(hidden)]
+    pub fn apply_native_runtime_paths(
+        &mut self,
+        codex_self_exe: Option<std::path::PathBuf>,
+        codex_linux_sandbox_exe: Option<std::path::PathBuf>,
+    ) {
+        self.codex_self_exe = codex_self_exe;
+        self.codex_linux_sandbox_exe = codex_linux_sandbox_exe;
+        if let Some(original) = self.native_invocation.overrides.as_ref() {
+            let mut overrides = (**original).clone();
+            overrides.codex_self_exe = self.codex_self_exe.clone();
+            overrides.codex_linux_sandbox_exe = self.codex_linux_sandbox_exe.clone();
+            self.native_invocation.overrides = Some(Arc::new(overrides));
+        }
+    }
+
+    pub(crate) fn native_enforcer_states_are_closed(&self) -> bool {
+        self.native_invocation
+            .constraints
+            .as_ref()
+            .is_some_and(|binding| binding.has_closed_callback_state(self))
+    }
+
+    pub(crate) fn native_invocation_overrides(&self) -> io::Result<&ConfigOverrides> {
+        if self.native_invocation.resolved_cwd.as_ref() != Some(&self.cwd) {
+            tracing::debug!("native preparation constructor cwd lineage refused");
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "native constructor cwd provenance is unavailable or changed",
+            ));
+        }
+        if !self
+            .native_invocation
+            .constraints
+            .as_ref()
+            .is_some_and(|bindings| bindings.matches(self))
+        {
+            tracing::debug!("native preparation constructor enforcer lineage refused");
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "native constructor enforcer bindings are unavailable or changed",
+            ));
+        }
+        self.native_invocation.overrides.as_deref().ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::Unsupported,
+                "native constructor invocation inputs are unavailable",
+            )
+        })
+    }
+}
diff --git a/codex-rs/core/src/config/native_preparation_fs.rs b/codex-rs/core/src/config/native_preparation_fs.rs
new file mode 100644
index 0000000..2da8805
--- /dev/null
+++ b/codex-rs/core/src/config/native_preparation_fs.rs
@@ -0,0 +1,547 @@
+//! Bounded read-only input capture for detached native configuration construction.
+//! Directory enumeration requires the strict bounded native transport.
+//! This does not capture environment/provider authority or grant destination execution.
+use codex_file_system::*;
+use codex_utils_path_uri::PathUri;
+use futures::StreamExt;
+use std::collections::{HashSet, VecDeque};
+use std::io;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+
+const MAX_BYTES: usize = 1_048_576;
+const MAX_OPERATIONS: usize = 256;
+
+#[derive(Clone, Debug, PartialEq)]
+enum Observation {
+    File(PathUri, Option<Vec<u8>>),
+    Metadata(PathUri, GetMetadataOptions, Option<FileMetadata>),
+    Canonical(PathUri, Option<PathUri>),
+    Directory(PathUri, Option<Vec<ReadDirectoryEntry>>),
+}
+
+struct Capture {
+    valid: bool,
+    remaining: usize,
+    operations: usize,
+    entries: usize,
+    walk_active: usize,
+    sealed: bool,
+    observations: Vec<Observation>,
+}
+
+impl Default for Capture {
+    fn default() -> Self {
+        Self {
+            valid: true,
+            remaining: MAX_BYTES,
+            operations: MAX_OPERATIONS,
+            entries: MAX_BOUNDED_DIRECTORY_ENTRIES,
+            walk_active: 0,
+            sealed: false,
+            observations: Vec::new(),
+        }
+    }
+}
+
+fn refused() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::Unsupported,
+        "native preparation filesystem input unavailable, changed or over budget",
+    )
+}
+
+impl Capture {
+    fn begin(
+        &mut self,
+        path: &PathUri,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<()> {
+        if !self.valid || self.sealed || sandbox.is_some() || self.operations == 0 {
+            self.valid = false;
+            return Err(refused());
+        }
+        // Leave invalid across the await: cancellation or a swallowed I/O error
+        // cannot yield a complete capture. Operations serialize on the mutex.
+        self.valid = false;
+        self.operations -= 1;
+        self.charge(path.to_string().len())
+    }
+
+    fn charge(&mut self, bytes: usize) -> io::Result<()> {
+        self.remaining = self.remaining.checked_sub(bytes).ok_or_else(refused)?;
+        Ok(())
+    }
+
+    fn record(&mut self, observation: Observation) -> io::Result<()> {
+        let same_input = |prior: &&Observation| match (prior, &observation) {
+            (Observation::File(a, _), Observation::File(b, _)) => a == b,
+            (Observation::Metadata(a, x, _), Observation::Metadata(b, y, _)) => a == b && x == y,
+            (Observation::Canonical(a, _), Observation::Canonical(b, _)) => a == b,
+            (Observation::Directory(a, _), Observation::Directory(b, _)) => a == b,
+            _ => false,
+        };
+        if let Some(prior) = self.observations.iter().find(same_input) {
+            if prior != &observation {
+                return Err(refused());
+            }
+        } else {
+            self.observations.push(observation);
+        }
+        self.valid = true;
+        Ok(())
+    }
+}
+
+/// Only native Rust callers can construct this transport. No writes, unbounded
+/// directory reads or sandbox-context substitutions reach the delegate. Walks
+/// use only the strict bounded directory and captured metadata operations.
+pub(crate) struct NativePreparationFileSystem<'a> {
+    source: PreparationSource<'a>,
+    capture: Mutex<Capture>,
+    walk_serial: Mutex<()>,
+}
+
+enum PreparationSource<'a> {
+    Borrowed(&'a dyn ExecutorFileSystem),
+    Owned(Arc<dyn ExecutorFileSystem>),
+}
+
+/// Complete observed inputs, not a filesystem-wide or atomic snapshot.
+pub(crate) struct NativePreparationInputs {
+    observations: Vec<Observation>,
+}
+
+impl<'a> NativePreparationFileSystem<'a> {
+    fn source(&self) -> &dyn ExecutorFileSystem {
+        match &self.source {
+            PreparationSource::Borrowed(value) => *value,
+            PreparationSource::Owned(value) => value.as_ref(),
+        }
+    }
+    pub(crate) fn new(source: &'a dyn ExecutorFileSystem) -> Self {
+        Self {
+            source: PreparationSource::Borrowed(source),
+            capture: Mutex::new(Capture::default()),
+            walk_serial: Mutex::new(()),
+        }
+    }
+
+    pub(crate) fn finish(self) -> io::Result<NativePreparationInputs> {
+        let capture = self.capture.into_inner();
+        if !capture.valid || capture.walk_active != 0 || capture.sealed {
+            return Err(refused());
+        }
+        Ok(NativePreparationInputs {
+            observations: capture.observations,
+        })
+    }
+
+    /// Seal an owned shared capture after all detached discovery completes.
+    /// Further reads through that wrapper are refused. The resulting snapshot
+    /// is preparation evidence and is not usable as a live turn filesystem.
+    pub(crate) async fn seal(&self) -> io::Result<NativePreparationInputs> {
+        let mut capture = self.capture.lock().await;
+        if !matches!(&self.source, PreparationSource::Owned(_))
+            || !capture.valid
+            || capture.walk_active != 0
+            || capture.sealed
+        {
+            capture.valid = false;
+            return Err(refused());
+        }
+        capture.sealed = true;
+        Ok(NativePreparationInputs {
+            observations: capture.observations.clone(),
+        })
+    }
+
+    async fn deny<T>(&self) -> io::Result<T> {
+        self.capture.lock().await.valid = false;
+        Err(refused())
+    }
+}
+
+impl NativePreparationFileSystem<'static> {
+    pub(crate) fn new_shared(source: Arc<dyn ExecutorFileSystem>) -> Arc<Self> {
+        Arc::new(Self {
+            source: PreparationSource::Owned(source),
+            capture: Mutex::new(Capture::default()),
+            walk_serial: Mutex::new(()),
+        })
+    }
+}
+
+impl NativePreparationInputs {
+    /// Re-read every captured input using the same bounds. Callers must also
+    /// revalidate ownership, strict trust, session settings and host authority.
+    pub(crate) async fn revalidate(&self, source: &dyn ExecutorFileSystem) -> io::Result<bool> {
+        let fresh = NativePreparationFileSystem::new(source);
+        for observation in &self.observations {
+            match observation {
+                Observation::File(path, _) => {
+                    let _ = fresh.read_file(path, Default::default(), None).await;
+                }
+                Observation::Metadata(path, options, _) => {
+                    let _ = fresh.get_metadata(path, *options, None).await;
+                }
+                Observation::Canonical(path, _) => {
+                    let _ = fresh.canonicalize(path, None).await;
+                }
+                Observation::Directory(path, _) => {
+                    let _ = fresh.read_directory(path, None).await;
+                }
+            }
+        }
+        Ok(fresh.finish()?.observations == self.observations)
+    }
+}
+
+impl ExecutorFileSystem for NativePreparationFileSystem<'_> {
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        Box::pin(async move {
+            let mut capture = self.capture.lock().await;
+            capture.begin(path, sandbox)?;
+            // Streaming follows native symlinks; a no-follow request cannot be
+            // silently weakened to that operation.
+            if !options.follow_symlinks {
+                return Err(refused());
+            }
+            let mut stream = match self.source().read_file_stream(path, None).await {
+                Ok(stream) => stream,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    capture.record(Observation::File(path.clone(), None))?;
+                    return Err(error);
+                }
+                Err(error) => return Err(error),
+            };
+            let mut bytes = Vec::new();
+            let mut chunks = 0;
+            while let Some(chunk) = stream.next().await {
+                let chunk = chunk?;
+                chunks += 1;
+                if chunk.is_empty() || chunk.len() > FILE_READ_CHUNK_SIZE || chunks > MAX_OPERATIONS
+                {
+                    return Err(refused());
+                }
+                // Charge actual chunks, never trust an earlier metadata size.
+                capture.charge(chunk.len())?;
+                bytes.extend_from_slice(&chunk);
+            }
+            capture.record(Observation::File(path.clone(), Some(bytes.clone())))?;
+            Ok(bytes)
+        })
+    }
+
+    fn read_file_stream<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> {
+        Box::pin(async move {
+            // Collect through EOF before giving a consumer its first byte.
+            let bytes = self.read_file(path, Default::default(), sandbox).await?;
+            Ok(FileSystemReadStream::new(futures::stream::iter(
+                bytes
+                    .chunks(FILE_READ_CHUNK_SIZE)
+                    .map(|chunk| Ok(bytes::Bytes::copy_from_slice(chunk)))
+                    .collect::<Vec<_>>(),
+            )))
+        })
+    }
+
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        Box::pin(async move {
+            let mut capture = self.capture.lock().await;
+            capture.begin(path, sandbox)?;
+            let result = self.source().canonicalize(path, None).await;
+            match &result {
+                Ok(value) => {
+                    capture.charge(value.to_string().len())?;
+                    capture.record(Observation::Canonical(path.clone(), Some(value.clone())))?;
+                }
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    capture.record(Observation::Canonical(path.clone(), None))?
+                }
+                Err(_) => return result,
+            }
+            result
+        })
+    }
+
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            let mut capture = self.capture.lock().await;
+            capture.begin(path, sandbox)?;
+            let result = self.source().get_metadata(path, options, None).await;
+            match &result {
+                Ok(value) => capture.record(Observation::Metadata(
+                    path.clone(),
+                    options,
+                    Some(value.clone()),
+                ))?,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    capture.record(Observation::Metadata(path.clone(), options, None))?
+                }
+                Err(_) => return result,
+            }
+            result
+        })
+    }
+
+    fn read_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        Box::pin(async move {
+            let mut capture = self.capture.lock().await;
+            capture.begin(path, sandbox)?;
+            let limits = DirectoryReadLimits {
+                max_entries: capture.entries,
+                max_bytes: capture.remaining,
+            };
+            limits.validate()?;
+            let mut entries = match self
+                .source()
+                .read_directory_bounded(path, limits, None)
+                .await
+            {
+                Ok(entries) => entries,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    capture.record(Observation::Directory(path.clone(), None))?;
+                    return Err(error);
+                }
+                Err(error) => return Err(error),
+            };
+            if entries.len() > limits.max_entries {
+                return Err(refused());
+            }
+            // Independently verify the returned shape even for an opted-in host.
+            for entry in &entries {
+                let mut components = std::path::Path::new(&entry.file_name).components();
+                if !matches!(components.next(), Some(std::path::Component::Normal(_)))
+                    || components.next().is_some()
+                    || entry.file_name == "."
+                    || entry.file_name == ".."
+                    || entry.file_name.chars().any(std::path::is_separator)
+                    || entry.file_name.as_bytes().contains(&0)
+                    || (entry.is_file && entry.is_directory)
+                {
+                    return Err(refused());
+                }
+                capture.charge(DIRECTORY_ENTRY_OVERHEAD_BYTES)?;
+                capture.charge(entry.file_name.len())?;
+            }
+            capture.entries -= entries.len();
+            entries.sort_by(|a, b| a.file_name.cmp(&b.file_name));
+            if entries
+                .windows(2)
+                .any(|pair| pair[0].file_name == pair[1].file_name)
+            {
+                return Err(refused());
+            }
+            capture.record(Observation::Directory(path.clone(), Some(entries.clone())))?;
+            Ok(entries)
+        })
+    }
+    fn read_directory_bounded<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _limits: DirectoryReadLimits,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        // Native discovery enters through read_directory above. Refuse nested
+        // capability probes explicitly so a swallowed default error cannot
+        // leave an apparently complete capture.
+        Box::pin(self.deny())
+    }
+
+    fn walk<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: WalkOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, WalkOutcome> {
+        Box::pin(async move {
+            if sandbox.is_some()
+                || options.max_directories == 0
+                || options.max_entries == 0
+                || options.max_depth > MAX_WALK_DEPTH
+                || options.max_directories > MAX_WALK_DIRECTORIES
+                || options.max_entries > MAX_WALK_ENTRIES
+            {
+                return self.deny().await;
+            }
+            {
+                let mut capture = self.capture.lock().await;
+                if !capture.valid || capture.sealed {
+                    capture.valid = false;
+                    return Err(refused());
+                }
+                capture.walk_active = match capture.walk_active.checked_add(1) {
+                    Some(value) => value,
+                    None => {
+                        capture.valid = false;
+                        return Err(refused());
+                    }
+                };
+            }
+            // Serialize walks while keeping a cancellation marker for every
+            // queued or running walk. A dropped future cannot yield a complete
+            // snapshot, even if it was waiting for another walk.
+            let _walk_guard = self.walk_serial.lock().await;
+            let result = async {
+                // Root absence is an observed input. Errors after a directory has
+                // been enumerated are uncertainty, never an empty successful walk.
+                let root = self
+                    .get_metadata(path, GetMetadataOptions::default(), None)
+                    .await?;
+                if !root.is_directory || (root.is_symlink && !options.follow_directory_symlinks) {
+                    return Ok(WalkOutcome::default());
+                }
+                let identity = if options.follow_directory_symlinks {
+                    match self.canonicalize(path, None).await {
+                        Ok(value) => value,
+                        Err(_) => return self.deny().await,
+                    }
+                } else {
+                    path.clone()
+                };
+                let mut visited = HashSet::from([identity]);
+                let mut queue = VecDeque::from([(path.clone(), 0usize)]);
+                let mut directories = 1usize;
+                let mut examined = 0usize;
+                let mut outcome = WalkOutcome::default();
+                while let Some((directory, depth)) = queue.pop_front() {
+                    let entries = match self.read_directory(&directory, None).await {
+                        Ok(value) => value,
+                        Err(_) => return self.deny().await,
+                    };
+                    examined = match examined.checked_add(entries.len()) {
+                        Some(value) if value <= options.max_entries => value,
+                        _ => return self.deny().await,
+                    };
+                    for entry in entries {
+                        let child = match directory.join(&entry.file_name) {
+                            Ok(value) => value,
+                            Err(_) => return self.deny().await,
+                        };
+                        let metadata = match self
+                            .get_metadata(&child, GetMetadataOptions::default(), None)
+                            .await
+                        {
+                            Ok(value) => value,
+                            Err(_) => return self.deny().await,
+                        };
+                        if metadata.is_directory != entry.is_directory
+                            || metadata.is_file != entry.is_file
+                        {
+                            return self.deny().await;
+                        }
+                        if metadata.is_symlink
+                            && (!options.follow_directory_symlinks || !metadata.is_directory)
+                        {
+                            continue;
+                        }
+                        let kind = if metadata.is_directory {
+                            WalkEntryKind::Directory
+                        } else if metadata.is_file {
+                            WalkEntryKind::File
+                        } else {
+                            continue;
+                        };
+                        outcome.entries.push(WalkEntry {
+                            path: child.clone(),
+                            kind,
+                        });
+                        if kind == WalkEntryKind::Directory
+                            && depth < options.max_depth
+                            && !(options.prune_hidden_directories
+                                && entry.file_name.starts_with('.'))
+                        {
+                            let identity = if options.follow_directory_symlinks {
+                                match self.canonicalize(&child, None).await {
+                                    Ok(value) => value,
+                                    Err(_) => return self.deny().await,
+                                }
+                            } else {
+                                child.clone()
+                            };
+                            if visited.insert(identity) {
+                                directories += 1;
+                                if directories > options.max_directories {
+                                    return self.deny().await;
+                                }
+                                queue.push_back((child, depth + 1));
+                            }
+                        }
+                    }
+                }
+                Ok(outcome)
+            }
+            .await;
+            self.capture.lock().await.walk_active -= 1;
+            result
+        })
+    }
+    fn write_file<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _contents: Vec<u8>,
+        _options: WriteFileOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(self.deny())
+    }
+    fn write_file_stream<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _contents: futures::stream::BoxStream<'a, FileSystemResult<bytes::Bytes>>,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, u64> {
+        Box::pin(self.deny())
+    }
+    fn create_directory<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: CreateDirectoryOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(self.deny())
+    }
+    fn remove<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: RemoveOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(self.deny())
+    }
+    fn copy<'a>(
+        &'a self,
+        _source: &'a PathUri,
+        _destination: &'a PathUri,
+        _options: CopyOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        Box::pin(self.deny())
+    }
+}
