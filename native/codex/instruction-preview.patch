+    /// Read only the durable outcome of a legacy settings commit restored into
+    /// quarantine. This neither releases the reservation nor proves receiver,
+    /// remote-resource, or complete destination reconciliation.
+    pub(crate) async fn continuity_observe_restored_commit(
+        &self,
+        owner: &ContinuityOwner,
+        transition_id: uuid::Uuid,
+    ) -> CodexResult<Option<ContinuityCommitReceipt>> {
+        if !owner.is_open() {
+            return Err(refused());
+        }
+        let path = self.continuity_receipt_path().await;
+        let state = self.state.lock().await;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let journal = &held.journal;
+        if !held.invalid
+            || held.owner.is_open()
+            || held.original.is_some()
+            || journal.schema != 1
+            || journal.host_grant.is_some()
+            || journal.destination_cancellation.is_some()
+            || journal.provider_grant.is_some()
+            || journal.provider_receipt.is_some()
+            || journal.provider_cleanup_id.is_some()
+            || journal.provider_cleanup_receipt.is_some()
+            || journal.mcp_plan.is_some()
+            || journal.mcp_grant.is_some()
+            || journal.mcp_receipt.is_some()
+            || journal.mcp_shutdown_id.is_some()
+            || journal.mcp_shutdown_status.is_some()
+            || journal.mcp_quiescence.is_some()
+            || journal.step.is_some()
+            || journal.reservation != held.reservation
+            || journal
+                .history
+                .iter()
+                .any(|receipt| receipt.transition_id == transition_id)
+            || journal.transition_id != Some(transition_id)
+            || journal.cwd.is_none()
+        {
+            return Err(refused());
+        }
+        let persisted = read_journal(&path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if serde_json::to_vec(&persisted).map_err(|_| refused())?
+            != serde_json::to_vec(journal).map_err(|_| refused())?
+            || !owner.is_open()
+        {
+            return Err(refused());
+        }
+        match (journal.phase.as_str(), &journal.receipt) {
+            ("submitting" | "uncertain", None) => Ok(None),
+            ("committed", Some(receipt))
+                if receipt.transition_id == transition_id
+                    && receipt.reservation == journal.reservation
+                    && Some(&receipt.cwd) == journal.cwd.as_ref()
+                    && receipt.source_cwd == journal.source_cwd
+                    && state.session_configuration.legacy_fallback_cwd == receipt.cwd =>
+            {
+                Ok(Some(receipt.clone()))
+            }
+            _ => Err(refused()),
+        }
+    }
