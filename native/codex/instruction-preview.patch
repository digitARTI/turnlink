+    }
+    #[test]
+    fn native_auth_observation_debug_is_redacted() {
+        let manager =
+            AuthManager::from_auth_for_testing(CodexAuth::from_api_key("private-fixture-key"));
+        let debug = format!("{:?}", manager.native_cached_observation().unwrap());
+        assert_eq!(debug, "NativeAuthCacheObservation { .. }");
+    }
+
+    struct MutableSource {
+        changed: std::sync::atomic::AtomicBool,
+        calls: std::sync::atomic::AtomicUsize,
+    }
+    impl ExternalAuth for MutableSource {
+        fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+            use std::sync::atomic::Ordering;
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            let key = if self.changed.load(Ordering::SeqCst) {
+                "fixture-b"
+            } else {
+                "fixture-a"
+            };
+            Box::pin(async move { Ok(CodexAuth::from_api_key(key)) })
+        }
+        fn refresh(
+            &self,
+            _context: ExternalAuthRefreshContext,
+        ) -> ExternalAuthFuture<'_, CodexAuth> {
+            panic!("observation must not refresh")
+        }
+    }
+    #[tokio::test]
+    async fn native_auth_observation_does_not_claim_unpublished_callback_freshness() {
+        use std::sync::atomic::Ordering;
+        let manager = AuthManager::from_optional_auth_for_testing(None);
+        let source = Arc::new(MutableSource {
+            changed: std::sync::atomic::AtomicBool::new(false),
+            calls: std::sync::atomic::AtomicUsize::new(0),
+        });
+        manager.set_external_auth(source.clone()).await.unwrap();
+        let observed = manager.native_cached_observation().unwrap();
+        source.changed.store(true, Ordering::SeqCst);
+        assert!(
+            observed.is_current(&manager),
+            "applied cache observations cannot discover hidden callback changes"
+        );
+        assert_eq!(source.calls.load(Ordering::SeqCst), 1);
+        assert_eq!(observed.auth().unwrap().api_key(), Some("fixture-a"));
+        manager.reload().await;
+        assert!(!observed.is_current(&manager));
+        assert_eq!(source.calls.load(Ordering::SeqCst), 2);
+    }
+
+    #[test]
+    fn native_auth_observation_refuses_forced_workspace_aba() {
+        let manager = AuthManager::from_optional_auth_for_testing(None);
+        let observed = manager.native_cached_observation().unwrap();
+        manager.set_forced_chatgpt_workspace_id(Some(vec!["workspace-a".into()]));
+        manager.set_forced_chatgpt_workspace_id(None);
+        assert!(!observed.is_current(&manager));
+        assert!(manager.native_cached_observation().is_ok());
+    }
+}
