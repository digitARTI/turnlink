+                        }
+                        2 => {
+                            let _guard = auth.state.auth_dot_json.lock().unwrap();
+                            panic!("owned fixture poison");
+                        }
+                        _ => {
+                            let _guard = auth.state.native_revision.lock().unwrap();
+                            panic!("owned fixture poison");
+                        }
+                    }
+                }))
