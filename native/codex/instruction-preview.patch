+#[tokio::test]
+async fn native_instruction_preparation_uses_the_execution_provider_instance() {
+    let home = tempdir().expect("private home");
+    let mut config = test_config().await;
+    config.codex_home = home.path().abs();
+    std::fs::write(home.path().join("AGENTS.md"), "applied global instructions")
+        .expect("write instructions");
+    let provider = Arc::new(codex_home::CodexHomeUserInstructionsProvider::new(
+        config.codex_home.clone(),
+    ));
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(EnvironmentManager::default_for_tests()),
+    )
+    .with_native_user_instructions(Arc::clone(&provider));
+    let inputs = manager
+        .state
+        .instructions_for_spawn(&SessionSource::Exec, None, None, None)
+        .await;
+    let execution = inputs.user_provider.as_ref().expect("execution provider");
+    let bound: Arc<dyn codex_extension_api::UserInstructionsProvider> = provider.clone();
+    assert!(
+        Arc::ptr_eq(execution, &bound),
+        "execution must use the exact native instance"
+    );
+    assert_eq!(
+        execution
+            .load_user_instructions()
+            .await
+            .instructions
+            .expect("applied")
+            .text,
+        "applied global instructions"
+    );
+    std::fs::write(
+        home.path().join("AGENTS.md"),
+        "fresh preparation instructions",
+    )
+    .expect("change instructions");
+    let reader = crate::agents_md_manager::AgentsMdManager::new(inputs);
+    let preview = reader
+        .preview_host_instructions()
+        .await
+        .expect("native host preview");
+    let global = preview.user.expect("native global instructions");
+    assert_eq!(global.text, "fresh preparation instructions");
+    assert_eq!(global.source, Some(config.codex_home.join("AGENTS.md")));
+    assert!(preview.thread.is_none());
+    assert!(
+        reader.get_loaded().await.is_none(),
+        "host preparation must not publish an applied project cache"
+    );
+}
