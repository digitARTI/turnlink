+mod native_auth_model_preparation_cases {
+    use super::*;
+    use codex_login::{
+        AuthManager, CodexAuth, ExternalAuth, ExternalAuthFuture, ExternalAuthRefreshContext,
+    };
+    use codex_models_manager::ModelsManagerConfig;
+    use codex_models_manager::manager::{SharedModelsManager, StaticModelsManager};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct FixedAuth {
+        key: &'static str,
+        calls: Arc<AtomicUsize>,
+    }
+    impl ExternalAuth for FixedAuth {
+        fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            Box::pin(async { Ok(CodexAuth::from_api_key(self.key)) })
+        }
+        fn refresh(
+            &self,
+            _context: ExternalAuthRefreshContext,
+        ) -> ExternalAuthFuture<'_, CodexAuth> {
+            panic!("preparation must not refresh auth")
+        }
+    }
+    fn manager(auth: Arc<AuthManager>, is_static: bool) -> SharedModelsManager {
+        if is_static {
+            Arc::new(StaticModelsManager::new(
+                Some(auth),
+                codex_models_manager::bundled_models_response().unwrap(),
+            ))
+        } else {
+            let provider = codex_model_provider_info::ModelProviderInfo::create_openai_provider(
+                Some("http://127.0.0.1:1/v1".into()),
+            );
+            codex_model_provider::create_model_provider(provider, Some(auth))
+                .models_manager_without_cache(None)
+        }
+    }
+    #[tokio::test]
+    async fn native_auth_model_preparation_rejects_cached_credential_aba() {
+        for is_static in [false, true] {
+            let auth =
+                AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+            let manager = manager(Arc::clone(&auth), is_static);
+            let config = ModelsManagerConfig::default();
+            let prepared =
+                codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).unwrap();
+            let calls = Arc::new(AtomicUsize::new(0));
+            for key in ["native-fixture-b", "native-fixture-a"] {
+                auth.set_external_auth(Arc::new(FixedAuth {
+                    key,
+                    calls: Arc::clone(&calls),
+                }))
+                .await
+                .unwrap();
+            }
+            assert!(
+                !prepared.revalidate(&manager, &config).unwrap(),
+                "cached credential ABA must invalidate model preparation"
+            );
+            let fresh =
+                codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).unwrap();
+            assert_eq!(fresh.model_info(), prepared.model_info());
+            assert!(fresh.revalidate(&manager, &config).unwrap());
+            assert_eq!(calls.load(Ordering::SeqCst), 2);
+        }
+    }
+    #[tokio::test]
+    async fn native_auth_model_preparation_rejects_same_credential_source_replacement() {
+        for is_static in [false, true] {
+            let auth =
+                AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+            let manager = manager(Arc::clone(&auth), is_static);
+            let config = ModelsManagerConfig::default();
+            let prepared =
+                codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).unwrap();
+            let calls = Arc::new(AtomicUsize::new(0));
+            auth.set_external_auth(Arc::new(FixedAuth {
+                key: "native-fixture-a",
+                calls: Arc::clone(&calls),
+            }))
+            .await
+            .unwrap();
+            assert!(
+                !prepared.revalidate(&manager, &config).unwrap(),
+                "same credential replacement source must invalidate preparation"
+            );
+            assert_eq!(calls.load(Ordering::SeqCst), 1);
+        }
+    }
+
+    struct PendingAuth {
+        pending: Arc<std::sync::atomic::AtomicBool>,
+        started: Arc<tokio::sync::Notify>,
+        release: Arc<tokio::sync::Notify>,
+    }
+    impl ExternalAuth for PendingAuth {
+        fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+            Box::pin(async {
+                if self.pending.load(Ordering::SeqCst) {
+                    self.started.notify_one();
+                    self.release.notified().await;
+                }
+                Ok(CodexAuth::from_api_key("native-fixture-a"))
+            })
+        }
+        fn refresh(
+            &self,
+            _context: ExternalAuthRefreshContext,
+        ) -> ExternalAuthFuture<'_, CodexAuth> {
+            panic!("preparation must not refresh auth")
+        }
+    }
+    #[tokio::test]
+    async fn native_auth_model_preparation_refuses_pending_source_and_cancelled_installation() {
+        let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+        let managers = [
+            manager(Arc::clone(&auth), false),
+            manager(Arc::clone(&auth), true),
+        ];
+        let config = ModelsManagerConfig::default();
+        let prepared: Vec<_> = managers
+            .iter()
+            .map(|manager| {
+                codex_model_provider::prepare_model_metadata(manager, "gpt-5.5", &config).unwrap()
+            })
+            .collect();
+        let started = Arc::new(tokio::sync::Notify::new());
+        let source = Arc::new(PendingAuth {
+            pending: Arc::new(std::sync::atomic::AtomicBool::new(true)),
+            started: Arc::clone(&started),
+            release: Arc::new(tokio::sync::Notify::new()),
+        });
+        let setter = tokio::spawn({
+            let auth = Arc::clone(&auth);
+            async move { auth.set_external_auth(source).await }
+        });
+        started.notified().await;
+        for manager in &managers {
+            assert!(
+                codex_model_provider::prepare_model_metadata(manager, "gpt-5.5", &config).is_err()
+            );
+        }
+        setter.abort();
+        assert!(setter.await.unwrap_err().is_cancelled());
+        for (manager, old) in managers.iter().zip(prepared) {
+            assert!(!old.revalidate(manager, &config).unwrap());
+            let fresh =
+                codex_model_provider::prepare_model_metadata(manager, "gpt-5.5", &config).unwrap();
+            assert_eq!(fresh.model_info(), old.model_info());
+            assert!(fresh.revalidate(manager, &config).unwrap());
+        }
+    }
+
+    #[tokio::test]
+    async fn native_auth_model_preparation_refuses_pending_reload_and_cancellation() {
+        let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+        let started = Arc::new(tokio::sync::Notify::new());
+        let pending = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        auth.set_external_auth(Arc::new(PendingAuth {
+            pending: Arc::clone(&pending),
+            started: Arc::clone(&started),
+            release: Arc::new(tokio::sync::Notify::new()),
+        }))
+        .await
+        .unwrap();
+        let manager = manager(Arc::clone(&auth), false);
+        let config = ModelsManagerConfig::default();
+        let old =
+            codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).unwrap();
+        pending.store(true, Ordering::SeqCst);
+        let reader = tokio::spawn({
+            let auth = Arc::clone(&auth);
+            async move { auth.reload().await }
+        });
+        started.notified().await;
+        assert!(
+            codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).is_err()
+        );
+        reader.abort();
+        assert!(reader.await.unwrap_err().is_cancelled());
+        assert!(!old.revalidate(&manager, &config).unwrap());
+        let fresh =
+            codex_model_provider::prepare_model_metadata(&manager, "gpt-5.5", &config).unwrap();
+        assert_eq!(fresh.model_info(), old.model_info());
+        assert!(fresh.revalidate(&manager, &config).unwrap());
+    }
+
+    #[tokio::test]
+    async fn native_auth_model_preparation_binds_distinct_manager_and_endpoint_sources() {
+        use codex_models_manager::manager::OpenAiModelsManager;
+        for change_endpoint in [true, false] {
+            let endpoint_auth =
+                AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+            let manager_auth =
+                AuthManager::from_auth_for_testing(CodexAuth::from_api_key("native-fixture-a"));
+            let base = manager(Arc::clone(&endpoint_auth), false);
+            let concrete: &dyn std::any::Any = base.as_ref();
