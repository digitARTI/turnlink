+/// Refuse a cold public resume of a checkpoint-bound quarantine before the
+/// session constructor can start provider/plugin prewarm or other work.
+pub(crate) fn checkpoint_public_resume_blocked(home: &Path, thread_id: codex_protocol::ThreadId) -> CodexResult<bool> {
+    let path = home.join("native-continuity").join(format!("{thread_id}.json"));
