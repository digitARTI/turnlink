+#[cfg(unix)]
+#[tokio::test]
+#[ignore = "isolated child invoked by durable completion parent"]
+async fn continuity_provider_recovery_durable_completion_child() {
+    assert_eq!(
+        std::env::var("TURNLINK_NATIVE_CLEANUP_FSIZE_CHILD").unwrap(),
+        "1"
+    );
+    let (_root, tx, runner, session, cwd) = destination_assembly_fixture().boxed().await;
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.unwrap();
+    let plan = session
+        .continuity_plan_provider(&owner, &held, cwd)
+        .await
+        .unwrap();
+    let grant = provider_grant(plan.clone());
+    let resource = session
+        .continuity_construct_provider(&owner, &held, grant.clone())
+        .await
+        .unwrap();
+    let cleanup_id = uuid::Uuid::new_v4();
+    let path = session.continuity_receipt_path().await;
+    let mut pending: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    pending["phase"] = "provider_cleanup_pending".into();
+    pending["provider_cleanup_id"] = cleanup_id.to_string().into();
+    let limit = serde_json::to_vec(&pending).unwrap().len() as libc::rlim_t + 8;
+    struct Restore {
+        old: libc::rlimit,
+        signal: libc::sighandler_t,
+    }
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            unsafe {
+                libc::setrlimit(libc::RLIMIT_FSIZE, &self.old);
+                libc::signal(libc::SIGXFSZ, self.signal);
+            }
+        }
+    }
+    let mut old = libc::rlimit {
+        rlim_cur: 0,
+        rlim_max: 0,
+    };
+    assert_eq!(unsafe { libc::getrlimit(libc::RLIMIT_FSIZE, &mut old) }, 0);
+    assert!(old.rlim_cur > limit);
+    let signal = unsafe { libc::signal(libc::SIGXFSZ, libc::SIG_IGN) };
+    assert_ne!(signal, libc::SIG_ERR);
+    let restore = Restore { old, signal };
+    let restricted = libc::rlimit {
+        rlim_cur: limit,
+        rlim_max: restore.old.rlim_max,
+    };
+    assert_eq!(
+        unsafe { libc::setrlimit(libc::RLIMIT_FSIZE, &restricted) },
+        0
+    );
+    let failed = session
+        .continuity_cleanup_provider(&owner, &held, cleanup_id, resource.clone())
+        .await;
+    drop(restore);
+    assert!(failed.is_err());
+    assert!(
+        session
+            .state
+            .lock()
+            .await
+            .continuity
+            .provider_resource_for_test()
+            .is_none(),
+        "actual object disposal preceded failed completion write"
+    );
+    assert!(
+        session.continuity_mutation().is_err(),
+        "failure retains admission exclusion"
+    );
+    let observed = session
+        .continuity_observe_provider(&owner, &held, &plan, grant.id, Some(cleanup_id))
+        .await
+        .unwrap();
+    assert_eq!(observed.status, "cleanup_pending");
+    assert!(observed.cleanup.is_none());
+    assert!(
+        session
+            .continuity_cleanup_provider(&owner, &held, uuid::Uuid::new_v4(), resource.clone())
+            .await
+            .is_err()
+    );
+    let receipt = session
+        .continuity_cleanup_provider(&owner, &held, cleanup_id, resource.clone())
+        .await
+        .unwrap();
+    assert_eq!(receipt.cleanup_id, cleanup_id);
+    assert_eq!(receipt.resource, resource);
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&std::fs::read(path).unwrap()).unwrap()["phase"],
+        "released"
+    );
+    assert!(session.continuity_mutation().is_ok());
+    // A second real file-limit failure occurs after local provider/context
+    // ownership exists but before the catalog worker can be registered.
+    let held = acquire(&tx, &owner).await.unwrap();
+    let cwd = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        std::fs::canonicalize(_root.path().join("destination")).unwrap(),
+    )
+    .unwrap();
+    let plan = session
+        .continuity_plan_provider_effects(&owner, &held, cwd, true, true)
+        .await
+        .unwrap();
+    let grant = provider_grant(plan.clone());
+    let path = session.continuity_receipt_path().await;
+    let mut pending: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    pending["phase"] = "provider_pending".into();
+    pending["transition_id"] = grant.id.to_string().into();
+    pending["cwd"] = serde_json::to_value(&grant.to).unwrap();
+    pending["provider_grant"] = serde_json::to_value(&grant).unwrap();
+    pending["provider_receipt"] = serde_json::json!({
+        "transitionID": grant.id, "planID": plan.id, "reservation": held,
+        "resourceID": uuid::Uuid::new_v4(), "processGeneration": plan.process_generation,
+        "kind": "provider_catalog", "phase": "pending"
+    });
+    let limit = serde_json::to_vec(&pending).unwrap().len() as libc::rlim_t;
+    let mut old = libc::rlimit {
+        rlim_cur: 0,
+        rlim_max: 0,
+    };
+    assert_eq!(unsafe { libc::getrlimit(libc::RLIMIT_FSIZE, &mut old) }, 0);
+    let signal = unsafe { libc::signal(libc::SIGXFSZ, libc::SIG_IGN) };
+    assert_ne!(signal, libc::SIG_ERR);
+    let restore = Restore { old, signal };
+    let restricted = libc::rlimit {
+        rlim_cur: limit,
+        rlim_max: restore.old.rlim_max,
+    };
+    assert_eq!(
+        unsafe { libc::setrlimit(libc::RLIMIT_FSIZE, &restricted) },
+        0
+    );
+    let failed = session
+        .continuity_construct_provider(&owner, &held, grant.clone())
+        .await;
+    drop(restore);
+    assert!(failed.is_err());
+    let observed = session
+        .continuity_observe_provider(&owner, &held, &plan, grant.id, None)
+        .await
+        .unwrap();
+    assert_eq!(
+        observed.status, "owned",
+        "factory completed before catalog-pending write failed"
+    );
+    assert_eq!(observed.resource.phase, "retained");
+    assert!(session.continuity_mutation().is_err());
+    session
+        .continuity_cleanup_provider(&owner, &held, uuid::Uuid::new_v4(), observed.resource)
+        .await
+        .expect("no catalog worker/effects started; exact unused owner can be released");
+    assert!(session.continuity_mutation().is_ok());
+    runner.abort();
+}
