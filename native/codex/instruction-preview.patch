+//! Native metadata observations without model, auth, cache or endpoint refresh.
+use crate::models_endpoint::OpenAiModelsEndpoint;
+use codex_login::AuthManager;
+use codex_login::NativeAuthCacheObservation;
+use codex_models_manager::ModelsManagerConfig;
+use codex_models_manager::manager::{
+    ModelCatalogPreparation, ModelsManager, OpenAiModelsManager, SharedModelsManager,
+    StaticModelsManager,
+};
+use codex_protocol::error::{CodexErr, Result as CoreResult};
+use codex_protocol::openai_models::ModelInfo;
+use std::any::Any;
+use std::sync::Arc;
+
+#[derive(PartialEq)]
+enum NativeObservation {
+    Static,
+    OpenAi {
+        catalog: ModelCatalogPreparation,
+        auth: Option<NativeAuthCacheObservation>,
+    },
+}
+
+/// Exact current manager/config binding. This is data, not execution authority.
+pub struct ModelMetadataPreparation {
+    manager: SharedModelsManager,
+    model: String,
+    config: ModelsManagerConfig,
+    model_info: ModelInfo,
+    observation: NativeObservation,
+    manager_auth: Option<NativeAuthCacheObservation>,
+}
+
+impl ModelMetadataPreparation {
+    pub fn model_info(&self) -> &ModelInfo {
+        &self.model_info
+    }
+
+    pub fn revalidate(
+        &self,
+        manager: &SharedModelsManager,
+        config: &ModelsManagerConfig,
+    ) -> CoreResult<bool> {
+        if !Arc::ptr_eq(manager, &self.manager) || config != &self.config {
+            return Ok(false);
+        }
+        let fresh = prepare_model_metadata(manager, &self.model, config)?;
+        Ok(fresh.model_info == self.model_info
+            && fresh.observation == self.observation
+            && fresh.manager_auth == self.manager_auth)
+    }
+}
+
+fn unavailable() -> CodexErr {
+    CodexErr::InvalidRequest("native model metadata preparation unavailable".into())
+}
+
+fn observe_auth(manager: Option<&AuthManager>) -> CoreResult<Option<NativeAuthCacheObservation>> {
+    Ok(manager
+        .map(AuthManager::native_cached_observation)
+        .transpose()?)
+}
+fn auth_is_current(
+    observed: &Option<NativeAuthCacheObservation>,
+    manager: Option<&AuthManager>,
+) -> bool {
+    match (observed, manager) {
+        (Some(observed), Some(manager)) => observed.is_current(manager),
+        (None, None) => true,
+        _ => false,
+    }
+}
+
+/// Safe concrete type inspection never invokes a manager/endpoint discovery
+/// callback. Originator and provider routing remain those of the actual manager.
+pub fn prepare_model_metadata(
+    manager: &SharedModelsManager,
+    model: &str,
+    config: &ModelsManagerConfig,
+) -> CoreResult<ModelMetadataPreparation> {
+    let concrete: &dyn Any = manager.as_ref();
+    let (model_info, observation, manager_auth) =
+        if let Some(native) = concrete.downcast_ref::<StaticModelsManager>() {
+            let auth = observe_auth(ModelsManager::auth_manager(native))?;
+            let model_info = native.preview_model_info(model, config);
+            if !auth_is_current(&auth, ModelsManager::auth_manager(native)) {
+                return Err(unavailable());
+            }
+            (model_info, NativeObservation::Static, auth)
+        } else if let Some(native) = concrete.downcast_ref::<OpenAiModelsManager>() {
+            let endpoint = native.preparation_endpoint();
+            let concrete: &dyn Any = endpoint.as_ref();
+            let endpoint = concrete
+                .downcast_ref::<OpenAiModelsEndpoint>()
+                .ok_or_else(unavailable)?;
+            let manager_auth = observe_auth(ModelsManager::auth_manager(native))?;
+            let endpoint_auth = observe_auth(endpoint.preparation_auth_manager())?;
+            let mode = manager_auth
+                .as_ref()
+                .and_then(NativeAuthCacheObservation::auth_mode);
+            let policy = endpoint.preparation_policy(mode, endpoint_auth.as_ref())?;
+            let snapshot = native
+                .preview_model_info(model, config, &policy)
+                .map_err(|_| {
+                    std::io::Error::new(
+                        std::io::ErrorKind::WouldBlock,
+                        "native model catalog is busy",
+                    )
+                })?;
+            if !auth_is_current(&manager_auth, ModelsManager::auth_manager(native))
+                || !auth_is_current(&endpoint_auth, endpoint.preparation_auth_manager())
+                || endpoint.preparation_policy(mode, endpoint_auth.as_ref())? != policy
+            {
+                return Err(unavailable());
+            }
+            (
+                snapshot.model_info().clone(),
+                NativeObservation::OpenAi {
+                    catalog: snapshot,
+                    auth: endpoint_auth,
+                },
+                manager_auth,
+            )
+        } else {
+            return Err(unavailable());
+        };
+    Ok(ModelMetadataPreparation {
+        manager: Arc::clone(manager),
+        model: model.to_owned(),
+        config: config.clone(),
+        model_info,
+        observation,
+        manager_auth,
+    })
+}
