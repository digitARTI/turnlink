+/// Session grants and their monotonic observation share one lock. Exhaustion
+/// disables native observations without changing ordinary grant behavior.
+#[derive(Debug)]
+pub(crate) struct SessionPermissionGrants {
+    values: HashMap<String, AdditionalPermissionProfile>,
+    revision: Option<u64>,
+}
+
+impl Default for SessionPermissionGrants {
+    fn default() -> Self {
+        Self {
+            values: HashMap::new(),
+            revision: Some(0),
+        }
+    }
+}
+
+impl SessionPermissionGrants {
+    pub(crate) fn get(&self, environment_id: &str) -> Option<&AdditionalPermissionProfile> {
+        self.values.get(environment_id)
+    }
+
+    pub(crate) fn observation(
+        &self,
+    ) -> Option<(u64, HashMap<String, AdditionalPermissionProfile>)> {
+        self.revision
+            .map(|revision| (revision, self.values.clone()))
+    }
+
+    pub(crate) fn from_snapshot(values: HashMap<String, AdditionalPermissionProfile>) -> Self {
+        Self {
+            values,
+            revision: Some(0),
+        }
+    }
+
+    fn replace(
+        &mut self,
+        environment_id: String,
+        permissions: Option<AdditionalPermissionProfile>,
+    ) {
+        match permissions {
+            Some(value) => {
+                self.values.insert(environment_id, value);
+            }
+            None => {
+                self.values.remove(&environment_id);
+            }
+        }
+        self.revision = self.revision.and_then(|value| value.checked_add(1));
+    }
+
+    #[cfg(any(test, debug_assertions))]
+    pub(crate) fn replace_for_test(
+        &mut self,
+        environment_id: String,
+        permissions: Option<AdditionalPermissionProfile>,
+    ) {
+        self.replace(environment_id, permissions);
+    }
