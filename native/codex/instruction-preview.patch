+        let step = ExtensionData::new("step");
+        thread.insert(ThreadOriginator("fixture".into()));
+        assert!(
+            preview_tools::<()>(contributor, &session, &thread, &step)
+                .unwrap()
+                .is_err()
+        );
+        let config = SkillsExtensionConfig {
+            include_instructions: true,
+            max_context_tokens: None,
+            bundled_skills_enabled: false,
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        };
+        thread.insert(SkillsThreadState::new(config.clone(), false, None));
+        assert!(
+            preview_tools::<()>(contributor, &session, &thread, &step)
+                .unwrap()
+                .is_err()
+        );
+        step.insert(SkillsStepState {
+            discovery_v2,
+            tools_enabled: true,
+            catalog: SkillStepCatalog::new(
+                None,
+                SkillCatalog::default(),
+                discovery_v2,
+                SkillCatalogAliases::default(),
+            ),
+            host_catalog: None,
+            cloud_status: CatalogStatus::Disabled,
+            config: config.clone(),
+        });
+        let before = thread.get::<SkillsThreadState>().unwrap();
+        let step_before = step.get::<SkillsStepState>().unwrap();
+        assert!(thread.get::<ActiveSkillTurnMetrics>().is_none());
+        let prepared = preview_tools::<()>(contributor, &session, &thread, &step)
+            .unwrap()
+            .unwrap();
+        assert!(thread.get::<ActiveSkillTurnMetrics>().is_none());
+        assert_eq!(prepared.len(), if discovery_v2 { 3 } else { 2 });
+        assert!(prepared.iter().all(|tool| tool.supports_parallel));
+        let target_mcp = Arc::new(McpResourceClient::new(Arc::new(
+            codex_mcp::McpRuntime::empty(false),
+        )));
+        assert!(native_detach_skill_step(&thread, &step, target_mcp));
+        let detached: Vec<_> = contributor
+            .tools_for_step(&session, &thread, &step)
+            .iter()
+            .map(|tool| PreparedExtensionTool::capture(tool.as_ref()))
+            .collect();
+        assert!(prepared == detached);
+        assert!(thread.get::<ActiveSkillTurnMetrics>().is_none());
+        step.remove::<NativeDetachedSkillStep>();
+        let ordinary: Vec<_> = contributor
+            .tools_for_step(&session, &thread, &step)
+            .iter()
+            .map(|tool| PreparedExtensionTool::capture(tool.as_ref()))
+            .collect();
+        assert!(prepared == ordinary);
+        assert!(crate::native_skill_tool_shapes(true, discovery_v2) == ordinary);
+        assert!(crate::native_skill_tool_shapes(false, discovery_v2).is_empty());
+        assert!(
+            thread.get::<ActiveSkillTurnMetrics>().is_some(),
+            "fixture detects the ordinary publication"
+        );
+        assert!(Arc::ptr_eq(
+            &before,
+            &thread.get::<SkillsThreadState>().unwrap()
+        ));
+        assert!(Arc::ptr_eq(
+            &step_before,
+            &step.get::<SkillsStepState>().unwrap()
+        ));
+        let disabled_step = ExtensionData::new("disabled-step");
+        disabled_step.insert(SkillsStepState {
+            discovery_v2,
+            tools_enabled: false,
+            catalog: SkillStepCatalog::new(
+                None,
+                SkillCatalog::default(),
+                discovery_v2,
+                SkillCatalogAliases::default(),
+            ),
+            host_catalog: None,
+            cloud_status: CatalogStatus::Disabled,
+            config,
+        });
+        assert!(
+            contributor
+                .tools_for_step(&session, &thread, &disabled_step)
+                .is_empty()
+        );
+        assert!(
+            preview_tools::<()>(contributor, &session, &thread, &disabled_step)
+                .unwrap()
+                .unwrap()
+                .is_empty()
+        );
+    }
