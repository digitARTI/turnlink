+#[cfg(all(debug_assertions, unix))]
+fn arm_checkpoint_pin(owner: ContinuityOwner, pin: Arc<std::sync::Mutex<Option<tokio::sync::OwnedMutexGuard<()>>>>, revoked: tokio::sync::watch::Sender<bool>) {
+    let mut stopped = revoked.subscribe();
+    tokio::spawn(async move {
+        let deadline = tokio::time::sleep(std::time::Duration::from_secs(30));
+        tokio::pin!(deadline);
+        let mut poll = tokio::time::interval(std::time::Duration::from_millis(20));
+        loop {
+            tokio::select! {
+                _ = &mut deadline => break,
+                _ = stopped.changed() => return,
+                _ = poll.tick() => if !owner.is_open() { break; },
+            }
+        }
+        revoked.send_replace(true);
+        pin.lock().unwrap_or_else(std::sync::PoisonError::into_inner).take();
+    });
+}
