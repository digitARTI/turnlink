+    /// The current source connection map is metadata, not a cleanup proof.
+    pub(crate) async fn continuity_observe_source_mcp_inventory(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<serde_json::Value> {
+        let state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let source = held.source_mcp_observation.as_ref().ok_or_else(refused)?;
+        if !held.source_mcp_slot.native_is_current(source) {
+            return Err(refused());
+        }
+        let inventory = source.runtime().native_inventory(Arc::clone(
+            held._mcp_requests.as_ref().ok_or_else(refused)?,
+        )).ok_or_else(refused)?;
+        let entries = inventory.entries().ok_or_else(refused)?;
+        if entries.len() > 64 || entries.iter().any(|entry| entry.name.is_empty() || entry.name.len() > 128) {
+            return Err(refused());
+        }
+        let entries = entries.iter().map(|entry| serde_json::json!({
+            "name": entry.name,
+            "owner": entry.owner,
+            "processId": entry.process_id,
+            "transport": match entry.transport {
+                codex_mcp::NativeMcpInventoryTransport::Stdio => "stdio",
+                codex_mcp::NativeMcpInventoryTransport::Http => "http",
+                codex_mcp::NativeMcpInventoryTransport::Unknown => "unknown",
+            },
+        })).collect::<Vec<_>>();
+        let event_stream = inventory.event_stream_present().ok_or_else(refused)?;
+        if !inventory.is_current() || !held.source_mcp_slot.native_is_current(source) || !owner.is_open() {
+            return Err(refused());
+        }
+        Ok(serde_json::json!({"entries": entries, "eventStreamPresent": event_stream}))
+    }
