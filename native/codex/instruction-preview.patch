+/// Observes applied native tool metadata without preparation callbacks or I/O.
+/// Unknown concrete contributors are not invoked. This is not destination freshness.
+pub fn preview_tools(
+    contributor: &dyn codex_extension_api::ToolContributor,
+    session_store: &ExtensionData,
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+) -> codex_extension_api::NativeToolPreparation {
+    let native = (contributor as &dyn std::any::Any).downcast_ref::<ImageGenerationExtension>()?;
+    let _ = (native, session_store, step_store);
+    let Some(config) = thread_store.get::<ImageGenerationExtensionConfig>() else {
+        return Some(Err(
+            "native image-generation configuration is not initialized",
+        ));
+    };
+    if !config.available {
+        return Some(Ok(Vec::new()));
+    }
+    let spec = crate::tool::imagegen_tool_spec();
+    Some(Ok(vec![codex_extension_api::PreparedExtensionTool {
+        name: codex_tools::ToolName::namespaced(
+            crate::IMAGE_GEN_NAMESPACE,
+            crate::IMAGEGEN_TOOL_NAME,
+        ),
+        search_info: codex_tools::ToolSearchInfo::from_tool_spec(spec.clone(), None),
+        spec,
+        exposure: codex_tools::ToolExposure::Direct,
+        supports_parallel: false,
+    }]))
+}
