+                .is_empty()
+        );
+        assert_eq!(extension.tools(&session, &thread).len(), 1);
+
+        config.web_search_mode.set(WebSearchMode::Live).unwrap();
+        let target = NativeTargetToolContext {
+            config: Arc::new(config),
+            provider: Arc::clone(&target_provider),
+        };
+        let tool = super::native_target_tool(&target, &session, &thread).unwrap();
+        assert!(Arc::ptr_eq(&tool.provider, &target_provider));
+        assert_eq!(
+            tool.settings.external_web_access,
+            Some(ExternalWebAccess::Boolean(true))
+        );
+    }
+    #[test]
+    fn native_contributor_preparation_preserves_web_metadata_and_refuses_missing_state() {
+        use codex_extension_api::PreparedExtensionTool;
+        let mut builder = ExtensionRegistryBuilder::<Config>::new();
+        install(
+            &mut builder,
+            AuthManager::from_auth_for_testing(CodexAuth::from_api_key("dummy")),
+        );
+        let registry = builder.build();
+        let contributor = registry.tool_contributors()[0].as_ref();
+        let session = ExtensionData::new("session");
+        let thread = ExtensionData::new("thread");
+        let step = ExtensionData::new("step");
+        assert!(
+            super::preview_tools(contributor, &session, &thread, &step)
+                .unwrap()
+                .is_err()
+        );
+        for available in [false, true] {
+            thread.insert(WebSearchExtensionConfig {
+                available,
+                http_client_factory: HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+                provider: ModelProviderInfo::create_openai_provider(None),
+                settings: Default::default(),
+            });
+            let before = thread.get::<WebSearchExtensionConfig>().unwrap();
+            let prepared = super::preview_tools(contributor, &session, &thread, &step)
+                .unwrap()
+                .unwrap();
+            assert_eq!(prepared.len(), usize::from(available));
+            if available {
+                assert_eq!(prepared[0].name, ToolName::namespaced("web", "run"));
+                assert!(prepared[0].supports_parallel);
+            }
+            let ordinary: Vec<_> = contributor
+                .tools(&session, &thread)
+                .iter()
+                .map(|tool| PreparedExtensionTool::capture(tool.as_ref()))
+                .collect();
