+//! Native queue acceptance tests. Host identities never arrive in JSON parameters.
+use super::Submission;
+use super::handlers::submission_loop;
+use super::tests::make_session_and_context;
+use codex_protocol::protocol::{
+    ContinuityOwner, ContinuityReservation, Op, ThreadSettingsOverrides,
+};
+use futures::FutureExt;
+use std::sync::Arc;
+use tokio::sync::oneshot;
+
+#[tokio::test]
+async fn read_only_contention_retry_is_bounded_and_never_retries_changed_state() {
+    use super::continuity::retry_busy_observation;
+    use codex_protocol::error::CodexErr;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let calls = AtomicUsize::new(0);
+    let result = retry_busy_observation(|| async {
+        if calls.fetch_add(1, Ordering::SeqCst) < 2 {
+            return Err(CodexErr::from(std::io::Error::from(
+                std::io::ErrorKind::WouldBlock,
+            )));
+        }
+        Ok(42)
+    })
+    .await
+    .unwrap();
+    assert_eq!(result, 42);
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+    calls.store(0, Ordering::SeqCst);
+    assert!(
+        retry_busy_observation(|| async {
+            calls.fetch_add(1, Ordering::SeqCst);
+            Err::<(), _>(CodexErr::from(std::io::Error::from(
+                std::io::ErrorKind::WouldBlock,
+            )))
+        })
+        .await
+        .is_err()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+    calls.store(0, Ordering::SeqCst);
+    assert!(
+        retry_busy_observation(|| async {
+            calls.fetch_add(1, Ordering::SeqCst);
+            Err::<(), _>(CodexErr::InvalidRequest("changed".into()))
+        })
+        .await
+        .is_err()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
+
+async fn queue() -> (
+    async_channel::Sender<Submission>,
+    tokio::task::JoinHandle<()>,
+    Arc<super::session::Session>,
+) {
+    queue_with_skill_policy(None).await
+}
