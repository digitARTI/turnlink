+        }
+        Ok(cancellation.clone())
+    }
+
+    pub(crate) async fn continuity_release(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let path = self.continuity_receipt_path().await;
+        let mut state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        if held.approved.is_some()
+            || held.journal.host_grant.is_some()
+            || held.journal.provider_grant.is_some()
+            || held.mcp_plan.is_some()
+        {
+            return Err(refused());
+        }
+        // A cancelled commit may have left a durable submitting intent. Its
+        // effect is not known, even when no receipt exists; releasing here would
+        // erase the only recovery identity and reopen ordinary session work.
+        let releasable = match (
+            held.journal.phase.as_str(),
+            &held.original,
+            held.journal.transition_id,
+            &held.journal.cwd,
+            &held.journal.receipt,
+        ) {
+            ("acquired", None, None, None, None) => true,
+            ("committed", Some(original), Some(id), Some(cwd), Some(receipt)) => {
+                original.generation == reservation.generation
+                    && receipt.reservation == *reservation
+                    && receipt.transition_id == id
+                    && receipt.cwd == *cwd
+                    && receipt.source_cwd == held.journal.source_cwd
+                    && held.journal.reservation == *reservation
+            }
+            _ => false,
+        };
+        if !releasable {
+            return Err(refused());
+        }
+        let mut journal = held.journal.clone();
+        if let Some(receipt) = &journal.receipt {
+            journal.history.push(receipt.clone());
+        }
+        journal.phase = "released".into();
+        journal.reservation = reservation.clone();
+        if write_journal(&path, &journal).is_err() {
+            held.invalidate();
+            return Err(refused());
+        }
+        state.continuity.held = None;
+        Ok(())
+    }
+
+    /// Observe a completed effect-free abandonment on the same live owner.
+    /// A reservation supplied by the caller is only a lookup key; the native
+    /// owner and the persisted released journal must still match.
+    pub(crate) async fn continuity_observe_abandoned_preparation(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let path = self.continuity_receipt_path().await;
+        let state = self.state.lock().await;
+        let done = state
+            .continuity
+            .abandoned_preparation
+            .as_ref()
+            .ok_or_else(refused)?;
+        if !owner.is_open()
+            || done.owner != *owner
+            || done.reservation != *reservation
+            || state.continuity.held.is_some()
+        {
+            return Err(refused());
+        }
+        let journal = read_journal(&path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if journal.phase != "released" || journal.reservation != *reservation {
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    /// Abandon only an effect-free preparation. This does not release an MCP
+    /// owner, provider resource, approved movement, or uncertain operation.
+    /// Retained plans are data-only; no plan that reached an effect is removed.
+    pub(crate) async fn continuity_abandon_preparation(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let path = self.continuity_receipt_path().await;
+        let mut state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        if held.journal.phase != "acquired"
+            || held.approved.is_some()
+            || held.mcp_startup.is_some()
+            || held.provider_resource.is_some()
+            || held.provider_configuration.is_some()
+            || held.provider_cleanup_source.is_some()
+            || held.mcp_quiescence_exclusion.is_some()
+            || held.journal.host_grant.is_some()
+            || held.journal.provider_grant.is_some()
+            || held.journal.provider_receipt.is_some()
+            || held.journal.provider_cleanup_id.is_some()
+            || held.journal.provider_cleanup_receipt.is_some()
+            || match (&held.mcp_plan, &held.journal.mcp_plan) {
+                (Some(plan), Some(disclosure)) => &plan.disclosure != disclosure,
+                (None, None) => false,
+                _ => true,
+            }
+            || held.journal.mcp_grant.is_some()
+            || held.journal.mcp_receipt.is_some()
+            || held.journal.mcp_shutdown_id.is_some()
+            || held.journal.mcp_shutdown_status.is_some()
+            || held.journal.mcp_quiescence.is_some()
+            || held.journal.transition_id.is_some()
+            || held.journal.cwd.is_some()
+            || held.journal.receipt.is_some()
+        {
+            return Err(refused());
+        }
+        let mut journal = held.journal.clone();
+        journal.phase = "released".into();
+        // Schema 2 records an unstarted MCP plan. A released journal has no
+        // retained plan and must be readable by the normal acquisition path.
+        journal.schema = 1;
+        journal.mcp_plan = None;
+        if write_journal(&path, &journal).is_err() || !owner.is_open() {
+            held.invalidate();
+            return Err(refused());
+        }
+        state.continuity.abandoned_preparation = Some(CompletedPreparationAbandonment {
+            owner: owner.clone(),
+            reservation: reservation.clone(),
+        });
+        state.continuity.held = None;
+        Ok(())
+    }
+
+    fn continuity_settings_candidate(
+        &self,
+        current: &SessionConfiguration,
+        cwd: &AbsolutePathBuf,
+    ) -> CodexResult<(SessionSettingsUpdate, SessionConfiguration)> {
+        if current.environments.len() != 1
+            || current.environments[0].environment_id != codex_exec_server::LOCAL_ENVIRONMENT_ID
+            || current.environments[0].config != EnvironmentConfigState::FromThread
+        {
+            return Err(refused());
+        }
+        let mut environments = current.environments.clone();
+        let source_uri = PathUri::from_abs_path(&current.legacy_fallback_cwd);
+        let destination_uri = PathUri::from_abs_path(cwd);
+        environments[0].cwd = destination_uri.clone();
+        for root in &mut environments[0].workspace_roots {
+            if *root == source_uri {
+                *root = destination_uri.clone();
+            }
+        }
+        let updates = SessionSettingsUpdate {
+            environments: Some(TurnEnvironmentSelections::new(cwd.clone(), environments)),
+            ..Default::default()
+        };
+        let candidate = self
+            .apply_session_settings(current, &updates)
+            .map_err(|_| refused())?;
+        if candidate.permission_profile() != current.permission_profile() {
+            return Err(refused());
+        }
+        Ok((updates, candidate))
+    }
+
+    /// Captures inputs against the native reservation; does not publish settings,
+    /// execute hooks, poll startup, load models/tools, or certify destination trust.
+    pub(super) async fn continuity_candidate_inputs(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityCandidateInputs> {
+        let (current, source_environments) = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            if state
+                .continuity
+                .held
+                .as_ref()
+                .is_none_or(|held| held.journal.phase != "acquired")
+            {
+                return Err(refused());
+            }
+            (
+                state.session_configuration.clone(),
+                self.services
+                    .turn_environments
+                    .configured_snapshot_for_preparation()?,
+            )
+        };
+        let (updates, configuration) = self.continuity_settings_candidate(&current, &cwd)?;
+        let source = source_environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        if source.config_origin != EnvironmentConfigOrigin::Thread
+            || source
+                .config_origin
+                .into_input_selection(source.selection.clone())
+                != current.environments[0]
+            || source.config()
+                != &super::ThreadEnvironmentDefaults::new(
+                    current.inferred_environment_config(),
+                    current.windows_sandbox_type,
+                )
+                .for_selection(&source.selection)
+        {
+            return Err(refused());
+        }
+        let source_directory = DirectoryIdentity::capture(&current.legacy_fallback_cwd, false)?;
+        let destination_directory = DirectoryIdentity::capture(&cwd, true)?;
+        let mut destination = source.clone();
+        destination.selection = updates
+            .environments
+            .as_ref()
+            .ok_or_else(refused)?
+            .environments[0]
+            .clone();
+        destination.selection.config = EnvironmentConfigState::Ready(
+            super::ThreadEnvironmentDefaults::new(
+                configuration.inferred_environment_config(),
+                configuration.windows_sandbox_type,
+            )
+            .for_selection(&destination.selection),
+        );
+        // Source cwd snapshots cannot become destination evidence by relabeling.
+        destination.shell_snapshot = futures::future::ready(None).boxed().shared();
+        destination.shell_snapshot_cache = Arc::default();
+        let inputs = ContinuityCandidateInputs {
+            thread_id: self.thread_id,
+            owner: owner.clone(),
+            reservation: reservation.clone(),
+            source_config: current.original_config_do_not_use.clone(),
+            source_configuration: current.clone(),
+            source_environments,
+            source_directory,
+            destination_directory,
+            configuration,
+            environments: TurnEnvironmentSnapshot {
+                environments: vec![TurnEnvironmentState::Ready(destination)],
+            },
+        };
+        self.continuity_validate_candidate_inputs(owner, &inputs)
+            .await?;
+        Ok(inputs)
+    }
+
+    /// An observation only; publication still requires a native CAS and complete
+    /// freshly validated authority/resource/receiver evidence.
+    pub(super) async fn continuity_validate_candidate_inputs(
+        &self,
+        owner: &ContinuityOwner,
+        inputs: &ContinuityCandidateInputs,
+    ) -> CodexResult<()> {
+        let check = |state: &crate::state::SessionState| {
+            if self.thread_id != inputs.thread_id || owner != &inputs.owner {
+                return Err(refused());
+            }
+            state.continuity.check(owner, &inputs.reservation)?;
+            if state
+                .continuity
+                .held
+                .as_ref()
+                .is_none_or(|held| !held.permits_candidate_revalidation())
+                || !Arc::ptr_eq(
+                    &state.session_configuration.original_config_do_not_use,
+                    &inputs.source_config,
+                )
+                || !same_preparation_bindings(
+                    &inputs.source_environments,
+                    &self
+                        .services
+                        .turn_environments
+                        .configured_snapshot_for_preparation()?,
+                )
+            {
+                return Err(refused());
+            }
+            Ok(())
+        };
+        {
+            let state = self.state.lock().await;
+            check(&state)?;
+        }
+        inputs.source_directory.validate()?;
+        inputs.destination_directory.validate()?;
+        let state = self.state.lock().await;
+        check(&state)
+    }
+
+    pub(super) async fn continuity_prepare_configuration(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityConfigurationPreparation> {
+        let inputs = self
+            .continuity_candidate_inputs(owner, reservation, cwd.clone())
+            .await?;
+        tracing::debug!("native provider candidate inputs captured");
+        if inputs.source_configuration.legacy_fallback_cwd != inputs.source_config.cwd
+            || inputs.source_configuration.codex_home != inputs.source_config.codex_home
+        {
+            tracing::debug!("native provider source cwd or home differs from constructor");
+            return Err(refused());
+        }
+        let environment = inputs
+            .environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        let filesystem = environment.environment.get_filesystem();
+        let destination = crate::config::Config::prepare_native_destination(
+            filesystem.as_ref(),
+            inputs.source_config.clone(),
+            cwd,
+        )
+        .await?;
+        tracing::debug!("native provider destination Config constructed");
+        let prepared = ContinuityConfigurationPreparation {
+            inputs,
+            destination,
+        };
+        self.continuity_validate_configuration_preparation(owner, &prepared)
+            .await?;
+        Ok(prepared)
+    }
+
+    pub(super) async fn continuity_validate_configuration_preparation(
+        &self,
+        owner: &ContinuityOwner,
+        prepared: &ContinuityConfigurationPreparation,
+    ) -> CodexResult<()> {
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await?;
+        let check_runtime = |current: &SessionConfiguration| {
+            let source = &prepared.inputs.source_configuration;
+            if !Arc::ptr_eq(&current.provider, &source.provider)
+                || current.step_settings != source.step_settings
+                || !current
+                    .turn_extension_init
+                    .native_has_same_attachments(&source.turn_extension_init)
+                || current.user_shell_override != source.user_shell_override
+                || !current
+                    .step_settings
+                    .approval_policy
+                    .has_same_enforcers(&source.step_settings.approval_policy)
+                || current.model_info_overrides != source.model_info_overrides
+                || current.permission_profile_state != source.permission_profile_state
+                || !current
+                    .permission_profile_state
+                    .has_same_enforcers(&source.permission_profile_state)
+                || current.environments != source.environments
+                || current.legacy_fallback_cwd != source.legacy_fallback_cwd
+                || current.runtime_workspace_roots != source.runtime_workspace_roots
+                || current.developer_instructions != source.developer_instructions
+                || current.base_instructions != source.base_instructions
+                || current.allow_login_shell != source.allow_login_shell
+                || current.shell_environment_policy != source.shell_environment_policy
+                || current.windows_sandbox_level != source.windows_sandbox_level
+                || current.windows_sandbox_type != source.windows_sandbox_type
+                || current.use_legacy_landlock != source.use_legacy_landlock
+                || current.codex_home != source.codex_home
+                || current.disabled_plugin_ids != source.disabled_plugin_ids
+                || current.originator != source.originator
+                || current.dynamic_tools != source.dynamic_tools
+            {
+                return Err(refused());
+            }
+            Ok(())
+        };
+        {
+            let state = self.state.lock().await;
+            check_runtime(&state.session_configuration)?;
+        }
+        let environment = prepared
+            .inputs
+            .environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        let filesystem = environment.environment.get_filesystem();
+        if !prepared
+            .destination
+            .revalidate(filesystem.as_ref(), &prepared.inputs.source_config)
+            .await?
+        {
+            return Err(refused());
+        }
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await?;
+        let state = self.state.lock().await;
+        state
+            .continuity
+            .check(owner, &prepared.inputs.reservation)?;
+        check_runtime(&state.session_configuration)
+    }
+
+    pub(super) fn continuity_prepare_provider<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> futures::future::BoxFuture<'a, CodexResult<Box<ContinuityProviderPreparation>>> {
+        async move {
+            let configuration = self
+                .continuity_prepare_configuration(owner, reservation, cwd)
+                .boxed()
+                .await?;
+            tracing::debug!("native provider destination configuration revalidated");
+            let runtime = configuration.runtime_configuration();
+            let source = &configuration.inputs.source_config;
+            let selected_id = &source.model_provider_id;
+            let source_definition = source
+                .model_providers
+                .get(selected_id)
+                .ok_or_else(refused)?;
+            let provider = codex_model_provider::prepare_native_provider(
+                &runtime.provider,
+                selected_id,
+                source_definition,
+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )?;
+            let prepared = Box::new(ContinuityProviderPreparation {
+                configuration,
+                provider,
+            });
+            self.continuity_validate_provider_preparation(owner, &prepared)
+                .await?;
+            Ok(prepared)
+        }
+        .boxed()
+    }
+
+    pub(super) fn continuity_validate_provider_preparation<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        prepared: &'a ContinuityProviderPreparation,
+    ) -> futures::future::BoxFuture<'a, CodexResult<()>> {
+        async move {
+            self.continuity_validate_configuration_preparation(owner, &prepared.configuration)
+                .boxed()
+                .await?;
+            if !prepared.provider.revalidate(
+                &prepared.configuration.runtime_configuration().provider,
+                &prepared.configuration.config().model_providers,
+                prepared
+                    .configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )? {
+                return Err(refused());
+            }
+            // Recheck the native owner after filesystem/auth observations.
+            self.continuity_validate_candidate_inputs(owner, &prepared.configuration.inputs)
+                .await
+        }
+        .boxed()
+    }
