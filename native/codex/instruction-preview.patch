+        environments: &TurnEnvironmentSnapshot,
+    ) -> CodexResult<NativeInstructionPreparation> {
+        let mut prepared = self.capture_native_instruction_source()?;
+        prepared.loaded = self.preview(config, environments).await?;
+        if !prepared.is_current(self) {
+            return Err(native_instruction_unavailable());
+        }
+        Ok(prepared)
+    }
+    pub(crate) fn validate_native_instruction_source(
+        &self,
+        prepared: &NativeInstructionPreparation,
+    ) -> CodexResult<()> {
+        if prepared.is_current(self) {
+            Ok(())
+        } else {
+            Err(native_instruction_unavailable())
+        }
+    }
+    pub(crate) async fn revalidate_native_instructions(
+        &self,
+        config: &Config,
+        environments: &TurnEnvironmentSnapshot,
+        prepared: &NativeInstructionPreparation,
+    ) -> CodexResult<()> {
+        if !prepared.is_current(self) {
+            return Err(native_instruction_unavailable());
+        }
+        let fresh = self
+            .prepare_native_instructions(config, environments)
+            .await?;
+        if fresh.loaded != prepared.loaded || !prepared.is_current(self) {
+            return Err(native_instruction_unavailable());
+        }
+        Ok(())
+    }
