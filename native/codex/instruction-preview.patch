+        from: source.clone(), to: destination, configuration_digest: "a".repeat(64), authority_digest: "b".repeat(64),
+        checkpoint_config_sha256: Some(format!("{:x}", Sha256::digest(config_bytes))), status: "prepared".into(), prepared_at: 1 };
+    let journal = Journal { schema: 1, thread_id: id.to_string(), phase: "grant_bound".into(),
+        reservation: reservation.clone(), source_cwd: source, transition_id: Some(grant.id), cwd: None,
+        receipt: None, history: Vec::new(), host_grant: Some(grant.clone()), destination_cancellation: None,
