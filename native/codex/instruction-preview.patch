+#[tokio::test]
+async fn contributor_preparation_binds_actual_registry_without_live_callbacks() {
+    use codex_extension_api::PreparedExtensionTool;
+    use codex_extension_api::PreparedToolContributor;
+    use codex_extension_api::ToolContributor;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    struct Contributor(Arc<AtomicUsize>);
+    impl ToolContributor for Contributor {
+        fn tools(
+            &self,
+            _: &codex_extension_api::ExtensionData,
+            _: &codex_extension_api::ExtensionData,
+        ) -> Vec<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            vec![Arc::new(DeferredExtensionTool)]
+        }
+    }
+    let calls = Arc::new(AtomicUsize::new(0));
+    let contributor: Arc<dyn ToolContributor> = Arc::new(Contributor(calls.clone()));
+    let other: Arc<dyn ToolContributor> = Arc::new(Contributor(calls.clone()));
+    let (mut session, turn) = make_session_and_context().await;
+    let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+    registry.tool_contributor(contributor.clone());
+    session.services.extensions = Arc::new(registry.build());
