+        root.path().join("destination/.codex/config.toml"),
+        "project_doc_max_bytes=3\n",
+    )
+    .unwrap();
+    assert!(
+        session
+            .continuity_validate_provider_preparation(&owner, &prepared)
+            .await
+            .is_err()
+    );
+    owner.close();
+    assert!(
+        session
+            .continuity_validate_provider_preparation(&owner, &prepared)
+            .await
+            .is_err()
+    );
+    runner.abort();
+}
