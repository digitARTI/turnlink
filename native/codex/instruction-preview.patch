+#[tokio::test]
+async fn native_preparation_fs_rejects_late_error_before_exposing_prefix() {
+    let mut source = StreamSource::bytes("valid prefix");
+    source.chunks.push(Err(io::ErrorKind::PermissionDenied));
+    let fs = NativePreparationFileSystem::new(&source);
+    assert!(fs.read_file_stream(&virtual_path(), None).await.is_err());
+    assert!(fs.finish().is_err());
+}
