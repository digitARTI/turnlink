+#[tokio::test]
+async fn continuity_interrupted_commit_intent_cannot_be_replayed_or_replaced() {
+    let (_root, tx, runner, session, cwd) = destination_assembly_fixture().await;
+    let owner = ContinuityOwner::new();
+    let reservation = acquire(&tx, &owner).await.unwrap();
+    let before = session.thread_settings_snapshot().await;
+    let transition_id = uuid::Uuid::new_v4();
+    let path = session.continuity_receipt_path().await;
+    let ready = super::continuity::pause_commit_after_intent_for_test(transition_id);
+    let running_session = Arc::clone(&session);
+    let running_owner = owner.clone();
+    let running_reservation = reservation.clone();
+    let running_cwd = cwd.clone();
+    let task = tokio::spawn(async move {
+        running_session
+            .continuity_commit(
+                &running_owner,
+                &running_reservation,
+                transition_id,
+                running_cwd,
+            )
+            .await
+    });
+    tokio::time::timeout(std::time::Duration::from_secs(10), ready.notified())
+        .await
+        .expect("commit must persist its intent before cancellation");
+    let intent = std::fs::read(&path).unwrap();
+    let journal: serde_json::Value = serde_json::from_slice(&intent).unwrap();
+    assert_eq!(journal["phase"], "submitting");
+    assert_eq!(journal["transition_id"], transition_id.to_string());
+    assert!(
+        session
+            .continuity_release(&owner, &reservation)
+            .await
+            .is_err()
+    );
+    assert_eq!(std::fs::read(&path).unwrap(), intent);
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert!(
+        session
+            .continuity_release(&owner, &reservation)
+            .await
+            .is_err()
+    );
+    assert_eq!(std::fs::read(&path).unwrap(), intent);
+    assert!(session.continuity_mutation().is_err());
+    for retry_id in [transition_id, uuid::Uuid::new_v4()] {
+        assert!(
+            session
+                .continuity_commit(&owner, &reservation, retry_id, cwd.clone())
+                .await
+                .is_err()
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), intent);
+        assert_eq!(session.thread_settings_snapshot().await, before);
+    }
+    // Exercise the actual restore logic after discarding the former in-memory
+    // owner; an unresolved intent stays quarantined and is never replayed.
+    session.continuity_forget_owner_for_test().await;
+    session.continuity_restore().await.unwrap();
+    let successor = ContinuityOwner::new();
+    assert!(
+        session
+            .continuity_observe_restored_commit(&successor, transition_id)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    assert!(
+        session
+            .continuity_observe_restored_commit(&successor, uuid::Uuid::new_v4())
+            .await
+            .is_err()
+    );
+    assert!(session.continuity_mutation().is_err());
+    assert_eq!(std::fs::read(&path).unwrap(), intent);
+    runner.abort();
+}
