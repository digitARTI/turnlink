+async fn queue_with_fixtures(
+    skill_policy: Option<Arc<std::sync::atomic::AtomicBool>>,
+    hosted_plugin: bool,
+    unknown_turn_input: bool,
+) -> (
+    async_channel::Sender<Submission>,
+    tokio::task::JoinHandle<()>,
+    Arc<super::session::Session>,
+) {
+    let (mut session, context) = make_session_and_context().await;
+    if skill_policy.is_some() || hosted_plugin || unknown_turn_input {
+        let mut builder = codex_extension_api::ExtensionRegistryBuilder::new();
+        fn collect_skill_tools(
+            registry: &codex_extension_api::ExtensionRegistry<crate::config::Config>,
+            session: &codex_extension_api::ExtensionData,
+            thread: &codex_extension_api::ExtensionData,
+            step: &codex_extension_api::ExtensionData,
+        ) -> codex_extension_api::NativeToolCollectionResult {
+            registry.tool_contributors().iter().enumerate().map(|(index, contributor)| {
+                let tools = codex_skills_extension::preview_tools::<crate::config::Config>(
+                    contributor.as_ref(), session, thread, step,
+                ).ok_or(codex_extension_api::NativeToolCollectionError::UnknownContributor { index })?
+                    .map_err(|reason| codex_extension_api::NativeToolCollectionError::IncompleteContributor { index, reason })?;
+                Ok(codex_extension_api::PreparedToolContributor::new(contributor.clone(), tools))
+            }).collect()
+        }
+        builder.native_tool_preparation_collector(collect_skill_tools);
+        builder.native_tool_contributor_classifier(|contributor| {
+            codex_skills_extension::native_is_skill_tool_contributor::<crate::config::Config>(
+                contributor,
+            )
+        });
+        builder.native_prompt_contributor_classifier(|contributor| {
+            codex_skills_extension::native_is_skill_prompt_contributor::<crate::config::Config>(
+                contributor,
+            )
+        });
+        builder.native_turn_input_contributor_classifier(|contributor| {
+            codex_skills_extension::native_is_skill_turn_input_contributor::<crate::config::Config>(
+                contributor,
+            )
+        });
+        if unknown_turn_input {
+            builder.turn_input_contributor(Arc::new(UnknownTurnInputFixture));
+        }
+        if hosted_plugin {
+            builder.mcp_server_contributor(Arc::new(HostedPluginFixture));
+        }
+        if let Some(skill_policy) = skill_policy {
+            let witness_policy = Arc::clone(&skill_policy);
+            codex_skills_extension::install_with_providers_metrics_and_native_witness(
+                &mut builder,
+                codex_skills_extension::SkillProviders::new(),
+                None,
+                move |_: &crate::config::Config| codex_skills_extension::SkillsExtensionConfig {
+                    include_instructions: true,
+                    max_context_tokens: None,
+                    bundled_skills_enabled: false,
+                    cloud_skill_enabled: skill_policy.load(std::sync::atomic::Ordering::SeqCst),
+                    shadow_selection_enabled: false,
+                },
+                // This fixture mutates the flag only through the observed
+                // source policy path, never during the retained target step.
+                move || {
+                    let expected = witness_policy.load(std::sync::atomic::Ordering::SeqCst);
+                    let current = Arc::clone(&witness_policy);
+                    Some(Box::new(move || {
+                        current.load(std::sync::atomic::Ordering::SeqCst) == expected
+                    }))
+                },
+            );
+        }
+        let registry = Arc::new(builder.build());
+        if hosted_plugin {
+            session.services.mcp_manager = Arc::new(crate::mcp::McpManager::new_with_extensions(
+                Arc::clone(&session.services.plugins_manager),
+                Arc::clone(&registry),
+                session.services.mcp_manager.codex_apps_tools_cache(),
+            ));
+        }
+        for contributor in registry.config_contributors() {
+            contributor.on_config_changed(
+                &session.services.session_extension_data,
+                &session.services.thread_extension_data,
+                &context.config,
+                &context.config,
+            );
+        }
+        session.services.extensions = registry;
+    }
+    super::tests::attach_thread_persistence(&mut session).await;
+    let session = Arc::new(session);
+    let (tx, rx) = async_channel::bounded(16);
+    let runner = tokio::spawn(submission_loop(Arc::clone(&session), context.config, rx));
+    (tx, runner, session)
+}
