+async fn continuity_retained_destination_refuses_a_borrowed_target_provider() {
+    let (_root, tx, runner, session, cwd) = destination_assembly_fixture().await;
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.unwrap();
+    let id = session
