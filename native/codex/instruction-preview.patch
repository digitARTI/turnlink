diff --git a/codex-rs/app-server/src/native_continuity_control.rs b/codex-rs/app-server/src/native_continuity_control.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/native_continuity_control.rs
@@ -0,0 +1,738 @@
+//! Private inherited host channel, separate from editor/model JSON-RPC.
+//! Provider construction/unpublished-owner cleanup is separate from movement.
+//! No placement commit or generic release is exposed.
+use crate::message_processor::{ConnectionSessionState, MessageProcessor};
+use crate::transport::ConnectionId;
+use codex_protocol::protocol::{ContinuityHostGrant, ContinuityReservation};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::io;
+use std::os::fd::{FromRawFd, OwnedFd};
+use std::sync::Arc;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::UnixStream;
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+const MAX_FRAME: usize = 16 * 1024;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Request {
+    pub(crate) id: u64,
+    pub(crate) operation: Operation,
+}
+#[derive(Deserialize)]
+#[serde(tag = "method", rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) enum Operation {
+    #[cfg(debug_assertions)]
+    WatchCheckpointSnapshot {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        grant: ContinuityHostGrant,
+        digest: String,
+    },
+    #[cfg(debug_assertions)]
+    InspectCheckpointJournal {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        grant: ContinuityHostGrant,
+    },
+    #[cfg(debug_assertions)]
+    InspectCheckpointCandidate {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        grant: ContinuityHostGrant,
+        digest: String,
+        #[serde(rename = "rolloutSha256")]
+        rollout_sha256: String,
+        #[serde(rename = "journalSha256")]
+        journal_sha256: String,
+    },
+    #[cfg(debug_assertions)]
+    RevalidateCheckpointCandidate {
+        #[serde(rename = "candidateId")]
+        candidate_id: uuid::Uuid,
+        reservation: ContinuityReservation,
+        grant: ContinuityHostGrant,
+    },
+    Acquire {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+    },
+    ObserveRestoredCommit {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        #[serde(rename = "transitionID")]
+        transition_id: uuid::Uuid,
+    },
+    ObserveRestoredAbandonment {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+    },
+    ObserveRestoredProviderCleanup {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        #[serde(rename = "cleanupID")]
+        cleanup_id: uuid::Uuid,
+    },
+    ObserveRestoredUnstartedProvider {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        #[serde(rename = "mcpReceipt")]
+        mcp_receipt: codex_protocol::protocol::ContinuityMcpReceipt,
+    },
+    PreflightProviderCredential {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        to: codex_utils_absolute_path::AbsolutePathBuf,
+    },
+    ObserveSourceMcpInventory {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+    },
+    #[cfg(debug_assertions)]
+    ExportCheckpointChunk {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        reservation: ContinuityReservation,
+        grant: ContinuityHostGrant,
+        kind: String,
+        offset: usize,
