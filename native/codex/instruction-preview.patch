+fn persistence_revision_fences_intervening_acquisitions_and_saturation() {
+    assert!(persistence_revision_unchanged(4, 5));
+    assert!(!persistence_revision_unchanged(4, 6));
+    assert!(!persistence_revision_unchanged(u64::MAX - 1, u64::MAX));
+    assert!(!persistence_revision_unchanged(u64::MAX, u64::MAX));
+}
