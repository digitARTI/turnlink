+impl NativeQuarantinedSessionCandidate {
+    /// Recheck retained native components only. This does not cover source
+    /// files, checkpoint identity, a guest lease or execution authority.
+    #[allow(dead_code)]
+    fn native_components_current(&self) -> bool {
+        let config = &self.configuration.original_config_do_not_use;
+        self.configuration.native_matches_closed_session(&self.configuration)
+            && self.enforcers.native_recipes(config).as_ref() == Some(&self.rule_recipes)
+            && self.provider.native_anonymous_recipe().as_ref() == Some(&self.provider_recipe)
+            && self.provider.revalidate(&self.configuration.provider, &config.model_providers,
+                config.config_layer_stack.required_model_provider()).unwrap_or(false)
+    }
+
+    /// Check a narrow decoded checkpoint against this retained native value.
+    /// The caller must separately authenticate the journal and exact rollout
+    /// bytes, retain the owner/lease, and cover filesystem and guest authority.
+    #[allow(dead_code)]
+    fn matches_checkpoint_metadata(
+        &self,
+        history: &InitialHistory,
+        thread_id: ThreadId,
+        reservation: &codex_protocol::protocol::ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        owner: &codex_protocol::protocol::ContinuityOwner,
+    ) -> bool {
+        if !owner.is_open() || !self.native_components_current()
+            || grant.agent_id != format!("codex:{thread_id}") || grant.status != "prepared"
+            || grant.checkpoint_config_sha256.is_none() || grant.from == grant.to
+            || self.configuration.legacy_fallback_cwd != grant.to
+            || !self.configuration.environments.is_empty()
+            || self.configuration.runtime_workspace_roots.as_slice() != [grant.to.clone()]
+        { return false; }
+        let InitialHistory::Resumed(resumed) = history else { return false; };
+        let Some(model) = self.configuration.original_config_do_not_use.model.as_deref() else { return false; };
+        if self.configuration.step_settings.collaboration_mode
+            != native_resolved_collaboration_mode(history, &self.configuration.original_config_do_not_use, model)
+        { return false; }
+        if resumed.conversation_id != thread_id || resumed.history.len() > 8192
+            || !matches!(resumed.history.first(), Some(RolloutItem::SessionMeta(_))) { return false; }
+        if history.get_multi_agent_version().is_some() { return false; }
+        let mut meta_count = 0; let mut marker_count = 0;
+        for item in resumed.history.iter() {
+            match item {
+                RolloutItem::SessionMeta(line) => {
+                    meta_count += 1;
+                    let meta = &line.meta;
+                    let codex_protocol::protocol::SessionMeta { creator_user_id: _, creator_account_id: _, session_id: _, id: _,
+                        forked_from_id: _, attached_thread: _, forked_from_ordinal_exclusive: _, parent_thread_id: _, timestamp: _, cwd: _,
+                        runtime_workspace_roots: _, originator: _, cli_version: _, source: _, thread_source: _, agent_nickname: _,
+                        agent_role: _, agent_path: _, model_provider: _, base_instructions: _, dynamic_tools: _, selected_capability_roots: _,
+                        memory_mode: _, history_mode: _, history_base: _, subagent_history_start_ordinal: _, multi_agent_version: _, context_window: _ } = meta;
+                    if meta.id != thread_id || meta.session_id != codex_protocol::SessionId::from(thread_id)
+                        || meta.cwd.as_path() != grant.from.as_path() || meta.source != self.configuration.session_source
+                        || meta.originator != self.configuration.originator || meta.history_mode != self.configuration.history_mode
+                        || meta.model_provider.as_deref() != Some(self.configuration.original_config_do_not_use.model_provider_id.as_str())
+                        || meta.base_instructions.as_ref().map(|value| value.text.as_str()) != Some(self.configuration.base_instructions.as_str())
+                        || meta.runtime_workspace_roots.as_ref().is_none_or(|roots| roots.as_slice() != [grant.from.to_path_buf()])
+                        || meta.creator_user_id.is_some() || meta.creator_account_id.is_some() || meta.forked_from_id.is_some()
+                        || meta.attached_thread || meta.forked_from_ordinal_exclusive.is_some() || meta.parent_thread_id.is_some()
+                        || meta.thread_source.is_some() || meta.agent_nickname.is_some() || meta.agent_role.is_some() || meta.agent_path.is_some()
+                        || meta.dynamic_tools.as_ref().is_some_and(|tools| !tools.is_empty()) || !meta.selected_capability_roots.is_empty()
+                        || meta.memory_mode.is_some() || meta.history_base.is_some() || meta.subagent_history_start_ordinal.is_some()
+                        || meta.multi_agent_version.is_some() || meta.context_window.is_some()
+                    { return false; }
+                }
+                RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) => {
+                    if event.continuity_operation_id.as_deref() != Some(reservation.generation.to_string().as_str()) {
+                        if event.continuity_operation_id.is_some() || marker_count != 0 || event.thread_id != Some(thread_id) { return false; }
+                        continue;
+                    }
+                    marker_count += 1;
+                    let mut expected = self.configuration.thread_settings_snapshot(&self.configuration.environments);
+                    expected.cwd = grant.from.clone();
+                    expected.runtime_workspace_roots = Some(vec![grant.from.clone()]);
+                    if event.thread_id != Some(thread_id)
+                        || event.thread_settings != expected { return false; }
+                }
+                // Prior turn settings are superseded by the exact trailing
+                // reservation snapshot; later settings are not represented.
+                RolloutItem::TurnContext(_) if marker_count == 0 => {}
+                RolloutItem::ResponseItem(_) | RolloutItem::WorldState(_) | RolloutItem::TokenUsageRecord(_)
+                | RolloutItem::EventMsg(EventMsg::TurnStarted(_) | EventMsg::TurnComplete(_) | EventMsg::TokenCount(_)
+                    | EventMsg::ItemCompleted(_)) if marker_count == 0 => {}
+                // This is metadata matching only. Remote effects and all other
+                // rollout records remain unsupported and never authorize release.
+                _ => return false,
+            }
+        }
+        meta_count == 1 && marker_count == 1 && owner.is_open() && self.native_components_current()
+    }
+}
