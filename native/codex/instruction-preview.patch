+/// Capture private skill caches before invoking any destination-step effects.
+/// Lock contention and missing source state fail closed.
+pub fn native_detach_skill_step(
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+    mcp_resources: Arc<McpResourceClient>,
+) -> bool {
+    let Some(source) = thread_store.native_try_get::<SkillsThreadState>() else {
+        return false;
+    };
+    let Some(detached) = source.native_detached() else {
+        return false;
+    };
+    if !thread_store
+        .native_try_get::<SkillsThreadState>()
+        .is_some_and(|current| Arc::ptr_eq(&source, &current))
+    {
+        return false;
+    }
+    step_store.insert(NativeDetachedSkillStep {
+        state: Arc::new(detached),
+        mcp_resources,
+        projection_witness: None,
+        diagnostics: Arc::new(NativeSkillDiagnostics::default()),
+        pending_shadow: Arc::new(std::sync::Mutex::new(None)),
+        input_gate: Arc::new(std::sync::atomic::AtomicU8::new(INPUT_IDLE)),
+    });
+    true
