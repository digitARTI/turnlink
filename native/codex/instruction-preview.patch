+    fs::set_permissions(&file, fs::Permissions::from_mode(0o600)).unwrap();
+    assert_eq!(checkpoint_single_rollout(root.path(), id).unwrap(), file);
+    assert_eq!(checkpoint_read_private_file(&file, 10).unwrap(), b"hello");
+    assert!(checkpoint_read_private_file(&file, 4).is_err());
+    fs::write(day.join("extra"), b"x").unwrap();
+    assert!(checkpoint_single_rollout(root.path(), id).is_err());
+    fs::remove_file(day.join("extra")).unwrap();
+    fs::remove_file(&file).unwrap();
+    symlink("/etc/passwd", &file).unwrap();
+    assert!(checkpoint_read_private_file(&file, 4096).is_err());
+}
