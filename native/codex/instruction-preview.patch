+#[tokio::test]
+async fn native_policy_observation_rechecks_epoch_after_async_filesystem_reads() -> io::Result<()> {
+    use codex_http_client::DestinationPolicy;
+    let fixture = Fixture::new()?;
+    let controller = codex_http_client::NetworkPolicyController::default();
+    let policy = controller.policy();
+    let revision = policy.revision();
+    assert!(controller.publish(revision, DestinationPolicy::Unrestricted));
+    let mut source = fixture.load(&fixture.source, Default::default()).await?;
+    source.application_network_policy = policy;
+    let source = Arc::new(source);
+    let filesystem = PolicyChangingFilesystem {
+        controller,
+        revision,
+        armed: std::sync::atomic::AtomicBool::new(false),
+    };
+    let prepared = Config::prepare_native_destination(
+        &filesystem,
+        source.clone(),
+        fixture.destination.clone(),
+    )
+    .await?;
+    assert!(prepared.revalidate(&filesystem, &source).await?);
+    filesystem
+        .armed
+        .store(true, std::sync::atomic::Ordering::SeqCst);
+    assert!(
+        !prepared.revalidate(&filesystem, &source).await?,
+        "epoch changed after the initial check during actual local file reads"
+    );
+    assert!(
+        !filesystem.armed.load(std::sync::atomic::Ordering::SeqCst),
+        "race must reach the actual asynchronous read boundary"
+    );
+    assert!(
+        !prepared.revalidate(&filesystem, &source).await?,
+        "a later read cannot retag the old policy epoch"
+    );
+    filesystem
+        .armed
+        .store(true, std::sync::atomic::Ordering::SeqCst);
+    assert!(
+        Config::prepare_native_destination(&filesystem, source, fixture.destination.clone())
+            .await
+            .is_err(),
+        "initial preparation must also refuse a policy epoch changed during reads"
+    );
+    Ok(())
+}
