+impl BoundHostGrant {
+    fn validate_binding(
+        &self,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        journal: &Journal,
+        current_cwd: &AbsolutePathBuf,
+    ) -> CodexResult<()> {
+        let legacy = journal.phase == "grant_bound" && journal.transition_id == Some(grant.id);
+        let destination =
+            journal.phase == "provider_constructed" && destination_grant_matches(journal, grant);
+        if &self.grant != grant
+            || (!legacy && !destination)
+            || journal.host_grant.as_ref() != Some(grant)
+            || journal.cwd.as_ref() != Some(&grant.to)
+            || journal.source_cwd != grant.from
+            || current_cwd != &grant.from
+        {
+            return Err(refused());
+        }
+        self.source.validate()?;
+        self.destination.validate()
+    }
+}
