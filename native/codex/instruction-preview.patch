+/// The exact already-ready environment reports and the root selection shared
+/// with normal step creation. This does not observe discovered inventories.
+struct NativeTargetCapabilityRoots {
+    reports: Vec<Option<std::sync::Weak<codex_exec_server::EnvironmentReadyInfo>>>,
+    roots: Vec<codex_protocol::capabilities::SelectedCapabilityRoot>,
+}
+
+fn same_target_ready_reports(
+    expected: &[Option<std::sync::Weak<codex_exec_server::EnvironmentReadyInfo>>],
+    actual: &[Option<Arc<codex_exec_server::EnvironmentReadyInfo>>],
+) -> bool {
+    expected.len() == actual.len()
+        && expected
+            .iter()
+            .zip(actual)
+            .all(|(expected, actual)| match (expected, actual) {
+                (None, None) => true,
+                (Some(expected), Some(actual)) => expected
+                    .upgrade()
+                    .is_some_and(|old| Arc::ptr_eq(&old, actual)),
+                _ => false,
+            })
+}
+
+#[cfg(test)]
+#[test]
+fn native_target_ready_report_observation_rejects_equal_republication() {
+    let original = Arc::new(codex_exec_server::EnvironmentReadyInfo::default());
+    let replacement = Arc::new(codex_exec_server::EnvironmentReadyInfo::default());
+    let expected = [Some(Arc::downgrade(&original)), None];
+    assert!(same_target_ready_reports(
+        &expected,
+        &[Some(Arc::clone(&original)), None]
+    ));
+    assert!(!same_target_ready_reports(
+        &expected,
+        &[Some(replacement), None]
+    ));
+    assert!(!same_target_ready_reports(&expected, &[None, None]));
+    drop(original);
+    assert!(!same_target_ready_reports(
+        &expected,
+        &[Some(Arc::new(Default::default())), None]
+    ));
+}
+
+impl NativeTargetCapabilityRoots {
+    fn capture(environments: &TurnEnvironmentSnapshot) -> CodexResult<Self> {
+        let ready = environments
+            .completed_for_preparation()
+            .map_err(|_| refused())?;
+        if !same_preparation_bindings(environments, &ready) {
+            return Err(refused());
+        }
+        let reports = ready
+            .turn_environments()
+            .map(|environment| {
+                environment
+                    .environment
+                    .last_ready_info()
+                    .as_ref()
+                    .map(Arc::downgrade)
+            })
+            .collect();
+        let captured = ready.captured_environments();
+        let roots = Session::selected_capability_roots_for_step(&ready, &captured);
+        let result = Self { reports, roots };
+        if !result.is_current(environments) {
+            return Err(refused());
+        }
+        Ok(result)
+    }
+
+    fn is_current(&self, environments: &TurnEnvironmentSnapshot) -> bool {
+        let Ok(ready) = environments.completed_for_preparation() else {
+            return false;
+        };
+        if !same_preparation_bindings(environments, &ready) {
+            return false;
+        }
+        let reports_match = || {
+            let current = ready
+                .turn_environments()
+                .map(|environment| environment.environment.last_ready_info())
+                .collect::<Vec<_>>();
+            same_target_ready_reports(&self.reports, &current)
+        };
+        if !reports_match() {
+            return false;
+        }
+        let captured = ready.captured_environments();
+        self.roots == Session::selected_capability_roots_for_step(&ready, &captured)
+            && reports_match()
+    }
+}
