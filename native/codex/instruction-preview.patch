+//! Full detached native Config construction. This does not publish execution
+//! authority, refresh provider/MDM state, or replace live session overrides.
+use super::native_preparation_fs::{NativePreparationFileSystem, NativePreparationInputs};
+use super::*;
+use codex_config::loader::ProjectConfigurationPreview;
+use std::ffi::OsString;
+use std::io;
+use std::sync::Arc;
+
+fn refused() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::Unsupported,
+        "native destination configuration inputs unavailable, stale or unsupported",
+    )
+}
+
+/// Exact current constructor environment values, never caller-supplied JSON.
+/// Snapshot consistency/revalidation is observational, not process-wide exclusion.
+#[derive(Clone, PartialEq)]
+struct Environment {
+    path: Option<OsString>,
+    tmpdir: Option<OsString>,
+    sqlite_home: Option<OsString>,
+    home: Option<PathBuf>,
+    cwd: PathBuf,
+}
+impl Environment {
+    fn capture() -> io::Result<Self> {
+        let cwd = std::env::current_dir()?;
+        let home = AbsolutePathBufGuard::home_directory()
+            .map(|home| AbsolutePathBuf::resolve_path_against_base(home, &cwd).to_path_buf());
+        Ok(Self {
+            path: std::env::var_os("PATH"),
+            tmpdir: std::env::var_os("TMPDIR"),
+            sqlite_home: std::env::var_os(codex_state::SQLITE_HOME_ENV),
+            home,
+            cwd,
+        })
+    }
+    fn with_home<T>(&self, operation: impl FnOnce() -> T) -> T {
+        if let Some(home) = &self.home {
+            AbsolutePathBufGuard::with_home_directory(home, operation)
+        } else {
+            operation()
+        }
+    }
+    fn overrides(&self, source: &Config, cwd: &AbsolutePathBuf) -> io::Result<ConfigOverrides> {
+        let mut overrides = source.native_invocation_overrides()?.clone();
+        overrides.cwd = Some(cwd.to_path_buf());
+        // Use native resolution, with the retained home, before the async
+        // constructor. Relative additive roots follow destination cwd as normal.
+        overrides.additional_writable_roots = self.with_home(|| {
+            overrides
+                .additional_writable_roots
+                .iter()
+                .map(|root| {
+                    AbsolutePathBuf::resolve_path_against_base(root, cwd.as_path()).to_path_buf()
+                })
+                .collect()
+        });
+        Ok(overrides)
+    }
+}
+
+pub(super) struct ConstructionContext {
+    cwd: AbsolutePathBuf,
+    repo_root: Option<AbsolutePathBuf>,
+    project: ProjectConfig,
+    environment: Environment,
+}
+impl ConstructionContext {
+    fn new(
+        cwd: &AbsolutePathBuf,
+        project: &ProjectConfigurationPreview,
+        environment: &Environment,
+    ) -> Self {
+        Self {
+            cwd: cwd.clone(),
+            repo_root: project.repo_root().cloned(),
+            project: project.active_project().clone(),
+            environment: environment.clone(),
+        }
+    }
+    pub(super) fn active_project(
+        &self,
+        cfg: &ConfigToml,
+        cwd: &AbsolutePathBuf,
+    ) -> io::Result<ProjectConfig> {
+        let project = cfg
+            .get_active_project(
+                cwd.as_path(),
+                self.repo_root.as_ref().map(AbsolutePathBuf::as_path),
+            )
+            .unwrap_or(ProjectConfig { trust_level: None });
+        if cwd != &self.cwd || project != self.project {
+            return Err(refused());
+        }
+        Ok(project)
+    }
+    pub(super) fn home_uri(&self) -> Option<PathUri> {
+        self.environment
+            .home
+            .as_ref()
+            .and_then(|home| PathUri::from_host_native_path(home).ok())
+    }
+    pub(super) fn path_env(&self) -> Option<&OsString> {
+        self.environment.path.as_ref()
+    }
+    pub(super) fn sqlite_home(&self, cwd: &AbsolutePathBuf) -> Option<AbsolutePathBuf> {
+        let value = self.environment.sqlite_home.as_ref()?.to_str()?.trim();
+        if value.is_empty() {
+            return None;
+        }
+        Some(
+            self.environment
+                .with_home(|| AbsolutePathBuf::resolve_path_against_base(value, cwd.as_path())),
+        )
+    }
+    pub(super) fn tmpdir(&self) -> Vec<PathUri> {
+        self.environment.with_home(|| {
+            self.environment
+                .tmpdir
+                .as_ref()
+                .filter(|value| !value.is_empty())
+                .map(|value| {
+                    AbsolutePathBuf::resolve_path_against_base(
+                        PathBuf::from(value),
+                        &self.environment.cwd,
+                    )
+                })
+                .map(PathUri::from)
+                .into_iter()
+                .collect()
+        })
+    }
+}
+
+/// Complete Config value from the shared native constructor. It is detached:
+/// session overrides/provider readiness/resource/receiver authority are separate.
+pub(crate) struct NativeDestinationConfiguration {
+    source: Arc<Config>,
+    configuration: Config,
+    source_project: ProjectConfigurationPreview,
+    destination_project: ProjectConfigurationPreview,
+    inputs: NativePreparationInputs,
+    environment: Environment,
+    application_policy: codex_http_client::NativeNetworkPolicyObservation,
+}
+impl NativeDestinationConfiguration {
+    pub(crate) fn config(&self) -> &Config {
+        &self.configuration
+    }
+
+    pub(crate) async fn revalidate(
+        &self,
+        fs: &dyn ExecutorFileSystem,
+        source: &Arc<Config>,
+    ) -> io::Result<bool> {
+        if !Arc::ptr_eq(source, &self.source)
+            || source.native_invocation_overrides().is_err()
+            || self.configuration.native_invocation_overrides().is_err()
+            || !self
+                .application_policy
+                .is_current(&source.application_network_policy)
+            || !self
+                .application_policy
+                .is_current(&self.configuration.application_network_policy)
+            || Environment::capture()? != self.environment
+        {
+            return Ok(false);
+        }
+        if !Box::pin(self.source_project.revalidate(fs)).await?
+            || !Box::pin(self.destination_project.revalidate(fs)).await?
+            || !self.inputs.revalidate(fs).await?
+        {
+            return Ok(false);
+        }
+        Ok(Environment::capture()? == self.environment
+            && self
+                .application_policy
+                .is_current(&source.application_network_policy)
+            && self
+                .application_policy
+                .is_current(&self.configuration.application_network_policy))
+    }
+}
+
+// These two fields are explicitly owned by the native app-server after loading.
+// Preserve their data from the actual immutable source Arc, never a caller hash.
+// Other post-constructor changes refuse through the complete source comparison.
+fn retain_native_host_fields(target: &mut Config, source: &Config) -> io::Result<()> {
+    target.retain_native_token_budget_startup(source)?;
+    target.application_network_policy = source.application_network_policy.clone();
+    target.application_auth_route_config = source.application_auth_route_config.clone();
+    Ok(())
+}
+
+impl Config {
+    pub(crate) async fn prepare_native_destination(
+        fs: &dyn ExecutorFileSystem,
+        source: Arc<Config>,
+        cwd: AbsolutePathBuf,
+    ) -> io::Result<NativeDestinationConfiguration> {
+        // Keep full project/config preparation off the native default test stack.
+        Box::pin(Self::prepare_native_destination_inner(fs, source, cwd)).await
+    }
+
+    async fn prepare_native_destination_inner(
+        fs: &dyn ExecutorFileSystem,
+        source: Arc<Config>,
+        cwd: AbsolutePathBuf,
+    ) -> io::Result<NativeDestinationConfiguration> {
+        source.native_invocation_overrides()?;
+        tracing::debug!("native preparation constructor lineage accepted");
+        let application_policy = source
+            .application_network_policy
+            .native_observation()
+            .map_err(|error| io::Error::new(io::ErrorKind::WouldBlock, error))?;
+        let environment = Environment::capture()?;
+        let capture = NativePreparationFileSystem::new(fs);
+        let source_project = Box::pin(codex_config::loader::preview_project_configuration(
+            &capture,
+            source.codex_home.as_path(),
+            &source.config_layer_stack,
+            &source.cwd,
+        ))
+        .await?;
+        // Reconstruct actual source semantics first: unknown host edits, stale
+        // project layers or unreproducible input choices must not be discarded.
+        tracing::debug!("native preparation source project observed");
+        let source_context = ConstructionContext::new(&source.cwd, &source_project, &environment);
+        let mut baseline = Box::pin(Self::construct_config(
+            &capture,
+            deserialize_config_toml_with_base(
+                source_project.stack().effective_config(),
+                source.codex_home.as_path(),
+            )?,
+            environment.overrides(&source, &source.cwd)?,
+            source.codex_home.clone(),
+            source_project.stack().clone(),
+            Some(&source_context),
+        ))
+        .await?;
+        retain_native_host_fields(&mut baseline, &source)?;
+        if baseline != *source {
+            tracing::debug!("native preparation source reconstruction mismatch");
+            return Err(refused());
+        }
+        tracing::debug!("native preparation source reconstructed");
+        let destination_project = Box::pin(codex_config::loader::preview_project_configuration(
+            &capture,
+            source.codex_home.as_path(),
+            &source.config_layer_stack,
+            &cwd,
+        ))
+        .await?;
+        let context = ConstructionContext::new(&cwd, &destination_project, &environment);
+        let mut configuration = Box::pin(Self::construct_config(
+            &capture,
+            deserialize_config_toml_with_base(
+                destination_project.stack().effective_config(),
+                source.codex_home.as_path(),
+            )?,
+            environment.overrides(&source, &cwd)?,
+            source.codex_home.clone(),
+            destination_project.stack().clone(),
+            Some(&context),
+        ))
+        .await?;
+        retain_native_host_fields(&mut configuration, &source)?;
+        if Environment::capture()? != environment {
+            return Err(refused());
+        }
+        let prepared = NativeDestinationConfiguration {
+            source: source.clone(),
+            configuration,
+            source_project,
+            destination_project,
+            inputs: capture.finish()?,
+            environment,
+            application_policy,
+        };
+        if !prepared.revalidate(fs, &source).await? {
+            return Err(refused());
+        }
+        Ok(prepared)
+    }
+}
