+/// Inspect an imported journal without constructing a Session or starting its
+/// plugins, hooks, provider, or MCP runtime. This is evidence of the durable
+/// quarantine only; it is not a resolved policy or permission to execute.
+#[cfg(debug_assertions)]
+pub(crate) fn inspect_checkpoint_journal(
+    home: &Path,
+    thread_id: codex_protocol::ThreadId,
+    owner: &ContinuityOwner,
+    reservation: &ContinuityReservation,
+    grant: &codex_protocol::protocol::ContinuityHostGrant,
+) -> CodexResult<serde_json::Value> {
+    if !owner.is_open() { return Err(refused()); }
+    let path = home.join("native-continuity").join(format!("{thread_id}.json"));
+    let journal = read_journal(&path, &thread_id.to_string())?.ok_or_else(refused)?;
+    if journal.phase != "grant_bound" || journal.reservation != *reservation
+        || journal.host_grant.as_ref() != Some(grant) || grant.checkpoint_config_sha256.is_none()
+        || !owner.is_open() { return Err(refused()); }
+    Ok(serde_json::json!({"version": 1, "threadId": thread_id.to_string(),
+        "reservation": reservation, "transitionId": grant.id,
+        "status": "quarantined_unverified", "releaseAllowed": false}))
+}
