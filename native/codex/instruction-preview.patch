+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput
+        );
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn bounded_directory_keeps_symlink_semantics_and_refuses_broken_entries() -> io::Result<()>
+    {
+        let temp = tempfile::tempdir()?;
+        std::fs::write(temp.path().join("file"), "contents")?;
+        std::fs::create_dir(temp.path().join("dir"))?;
+        std::os::unix::fs::symlink("file", temp.path().join("file-link"))?;
+        std::os::unix::fs::symlink("dir", temp.path().join("dir-link"))?;
+        let path = PathUri::from_host_native_path(temp.path())?;
+        let bounded = LOCAL_FS
+            .read_directory_bounded(&path, limits(), None)
+            .await?;
+        assert!(
+            bounded
