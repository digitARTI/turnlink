+    build_tool_router_with_caches(
+        session,
+        turn_context,
+        model_info,
+        environments,
+        mcp,
+        apps_enabled,
+        tool_suggest_candidates,
+        extension_tool_executors(session, step_store),
+        ToolRouterCaches {
+            mcp: &mcp_cache,
+            definitions: &definitions,
+            search: &search,
+        },
+    )
+}
+
+struct ToolRouterCaches<'a> {
+    mcp: &'a McpHandlerCache,
+    definitions: &'a SharedMcpDefinitions,
+    search: &'a ToolSearchHandlerCache,
+}
+
+/// Detached assembly from captured native inputs. It neither starts discovery
+/// nor invokes extension callbacks. Unsupported contributors refuse instead of
+/// silently disappearing from the inventory. This is not execution readiness.
+pub(crate) fn preview_tool_router(
+    session: &Session,
+    turn_context: &TurnContext,
+    model_info: &ModelInfo,
+    environments: &TurnEnvironmentSnapshot,
+    mcp: &Arc<codex_mcp::McpBinding>,
+    apps_enabled: bool,
+    tool_suggest_candidates: Option<&crate::tools::router::ToolSuggestCandidates>,
+) -> CodexResult<crate::tools::router::ToolRouterPreparation> {
+    preview_tool_router_with_contributors(
+        session,
+        turn_context,
+        model_info,
+        environments,
+        mcp,
+        apps_enabled,
+        tool_suggest_candidates,
+        &[],
+    )
+}
+
+/// Reads actual scopes through the trusted native host's closed collector and
+/// shares detached assembly. Applied metadata is not destination freshness.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn preview_tool_router_with_native_scopes(
+    session: &Session,
+    turn_context: &TurnContext,
+    model_info: &ModelInfo,
+    environments: &TurnEnvironmentSnapshot,
+    mcp: &Arc<codex_mcp::McpBinding>,
+    apps_enabled: bool,
+    step_store: &ExtensionData,
+    tool_suggest_candidates: Option<&crate::tools::router::ToolSuggestCandidates>,
+) -> CodexResult<crate::tools::router::ToolRouterPreparation> {
+    require_ready_tool_environments(environments)?;
+    let contributors = session
+        .services
+        .extensions
+        .prepare_native_tools(
+            &session.services.session_extension_data,
+            &session.services.thread_extension_data,
+            step_store,
+        )
+        .map_err(|error| {
+            codex_protocol::error::CodexErr::InvalidRequest(format!(
+                "native tool preparation refused: {error}"
+            ))
+        })?;
+    preview_tool_router_with_contributors(
+        session,
+        turn_context,
+        model_info,
+        environments,
+        mcp,
+        apps_enabled,
+        tool_suggest_candidates,
+        &contributors,
+    )
+}
+
+fn require_ready_tool_environments(environments: &TurnEnvironmentSnapshot) -> CodexResult<()> {
+    if environments.environments.is_empty()
+        || environments.environments.iter().any(|environment| {
+            !matches!(
+                environment,
+                crate::environment_selection::TurnEnvironmentState::Ready(_)
+            )
+        })
+    {
+        return Err(codex_protocol::error::CodexErr::InvalidRequest(
+            "native tool preparation requires ready environments".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Uses declarations collected by the native host from known concrete native
+/// contributors. Binding is checked before assembly; callbacks are never used.
+/// This observes applied scopes, not complete destination authority.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn preview_tool_router_with_contributors(
+    session: &Session,
+    turn_context: &TurnContext,
+    model_info: &ModelInfo,
+    environments: &TurnEnvironmentSnapshot,
+    mcp: &Arc<codex_mcp::McpBinding>,
+    apps_enabled: bool,
+    tool_suggest_candidates: Option<&crate::tools::router::ToolSuggestCandidates>,
+    contributors: &[codex_extension_api::PreparedToolContributor],
+) -> CodexResult<crate::tools::router::ToolRouterPreparation> {
+    require_ready_tool_environments(environments)?;
+    let registered = session.services.extensions.tool_contributors();
+    if registered.len() != contributors.len()
+        || registered
+            .iter()
+            .zip(contributors)
+            .any(|(actual, prepared)| !prepared.matches(actual))
+    {
+        return Err(codex_protocol::error::CodexErr::InvalidRequest(
+            "native tool preparation requires ready environments and matching native contributors"
+                .into(),
+        ));
+    }
+    let mcp_cache = McpHandlerCache::default();
+    let definitions = SharedMcpDefinitions::default();
+    let search = ToolSearchHandlerCache::default();
+    let router = build_tool_router_with_caches(
+        session,
+        turn_context,
+        model_info,
+        environments,
+        mcp,
+        apps_enabled,
+        tool_suggest_candidates,
+        contributors
+            .iter()
+            .flat_map(|contributor| contributor.tools())
+            .map(|tool| {
+                Arc::new(PreparedExtensionExecutor(tool.clone()))
+                    as Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>
+            }),
+        ToolRouterCaches {
+            mcp: &mcp_cache,
+            definitions: &definitions,
+            search: &search,
+        },
+    )?;
+    Ok(router.preparation_snapshot())
+}
+
+/// Private adapter used only inside detached assembly. It cannot dispatch.
+struct PreparedExtensionExecutor(codex_extension_api::PreparedExtensionTool);
+
+impl<'call> ToolExecutor<ExtensionToolCall<'call>> for PreparedExtensionExecutor {
+    fn tool_name(&self) -> codex_tools::ToolName {
+        self.0.name.clone()
+    }
+    fn spec(&self) -> codex_tools::ToolSpec {
+        self.0.spec.clone()
+    }
+    fn exposure(&self) -> codex_tools::ToolExposure {
+        self.0.exposure
+    }
+    fn search_info(&self) -> Option<codex_tools::ToolSearchInfo> {
+        self.0.search_info.clone()
+    }
+    fn supports_parallel_tool_calls(&self) -> bool {
+        self.0.supports_parallel
+    }
+    fn handle<'a>(&'a self, _call: ExtensionToolCall<'call>) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        'call: 'a,
+    {
+        Box::pin(async {
+            Err(codex_tools::FunctionCallError::Fatal(
+                "prepared tool metadata cannot execute".into(),
+            ))
+        })
+    }
+}
