+    assert_eq!(plan.model_context.as_ref().unwrap().model, "gpt-5.5");
+    let mut wrong = provider_grant(plan.clone());
+    wrong.provider_plan.kind = "provider_factory".into();
+    wrong.provider_plan.model_context = None;
+    assert!(
+        session
+            .continuity_construct_provider(&owner, &held, wrong)
+            .await
+            .is_err()
+    );
+    let receipt = session
+        .continuity_construct_provider(&owner, &held, provider_grant(plan))
+        .await
+        .unwrap();
+    assert_eq!(receipt.kind, "provider_context");
+    {
+        let state = session.state.lock().await;
+        let resource = state.continuity.provider_resource_for_test().unwrap();
+        assert_eq!(resource.model_context_info().unwrap().slug, "gpt-5.5");
+        assert_eq!(
+            resource.model_context_info().unwrap().context_window,
+            Some(123456)
+        );
+    }
+    assert_eq!(session.thread_settings_snapshot().await, before);
+    let borrowed = {
+        let state = session.state.lock().await;
+        state
+            .continuity
+            .provider_resource_handle_for_test()
+            .unwrap()
+    };
+    let cleanup_id = uuid::Uuid::new_v4();
+    assert!(
+        session
+            .continuity_cleanup_provider(&owner, &held, cleanup_id, receipt.clone())
+            .await
+            .is_err()
+    );
+    // Refusal precedes the durable intent, so the same cleanup can succeed
+    // once the in-flight reader releases its retained owner.
+    drop(borrowed);
+    let cleanup = session
+        .continuity_cleanup_provider(&owner, &held, cleanup_id, receipt.clone())
+        .await
+        .unwrap();
+    assert_eq!(cleanup.kind, "provider_context");
+    assert_eq!(cleanup.resource, receipt);
+    assert!(session.continuity_mutation().is_ok());
+    assert_eq!(session.thread_settings_snapshot().await, before);
+    runner.abort();
+}
