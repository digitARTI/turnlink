+        fn encode(state: &NativeConstraintRecipeState<codex_protocol::models::PermissionProfileSnapshot>, depth: usize) -> Option<serde_json::Value> {
+            if depth > 16 { return None; }
+            match state {
+                NativeConstraintRecipeState::Any => Some(serde_json::json!({"version": 1, "rule": "allow_any"})),
+                NativeConstraintRecipeState::PermissionProfile(base) => Some(serde_json::json!({"version": 1, "rule": "permission_profile", "base": base.as_ref()})),
+                NativeConstraintRecipeState::Intersection(left, right) => Some(serde_json::json!({"version": 1, "rule": "intersection", "parts": [encode(left, depth + 1)?, encode(right, depth + 1)?]})),
+                NativeConstraintRecipeState::Only(_) | NativeConstraintRecipeState::Unsupported => None,
