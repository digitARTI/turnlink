+    struct Known;
+    impl codex_extension_api::ToolContributor for Known {
+        fn tools(
+            &self,
+            _: &ExtensionData,
+            _: &ExtensionData,
+        ) -> Vec<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>> {
+            panic!("native preparation must not invoke contributor callbacks")
