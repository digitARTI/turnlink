+            || held.publication_source_model_closed != Some(closed)
+            || !held.target_step.as_ref().is_some_and(|current| Arc::ptr_eq(current, &target))
+            || !held.publication_mcp.as_ref().is_some_and(|current| Arc::ptr_eq(current, &destination))
+            || !held.mcp_binding.as_ref().is_some_and(|current| Arc::ptr_eq(current, &target._target.inputs.mcp))
+            || !held.publication_source_models.as_ref().is_some_and(|prior| Arc::ptr_eq(prior.client(), &client))
+            || !held._model_sessions.as_ref().is_some_and(|current| Arc::ptr_eq(current, &exclusion) && exclusion.owns(&client))
+            || !Arc::ptr_eq(&self.services.mcp_runtime.load_full(), destination.destination())
