+/// Already-applied local discovery only. This is not a reservation or a proof
+/// that files described by a cached inventory have not changed.
+enum NativeTargetDiscovery {
+    Disabled,
+    V2Local,
+    V1 {
+        cache: Arc<codex_exec_server::ExecutorCapabilityDiscoveryCache>,
+        observation: codex_exec_server::NativeLocalDiscoveryObservation,
+    },
+}
+
+impl NativeTargetDiscovery {
+    fn capture(
+        session: &Session,
+        config: &crate::config::Config,
+        environments: &TurnEnvironmentSnapshot,
+        roots: &NativeTargetCapabilityRoots,
+    ) -> CodexResult<Self> {
+        if environments
+            .turn_environments()
+            .any(|environment| environment.environment.is_remote())
+        {
+            return Err(refused());
+        }
+        if config
+            .features
+            .enabled(codex_features::Feature::ExecutorCapabilityDiscoveryV2)
+        {
+            return Ok(Self::V2Local);
+        }
+        let Some((restricted, sandbox_contexts)) =
+            Session::v1_discovery_scope_for_step(config, environments)
+        else {
+            return Ok(Self::Disabled);
+        };
+        let captured = environments.captured_environments();
+        let mut selected =
+            codex_exec_server::ResolvedSelectedCapabilityRoot::native_resolve_captured_local(
+                &roots.roots,
+                &captured,
+            )
+            .ok_or_else(refused)?;
+        if restricted {
+            selected.retain(|root| {
+                let codex_protocol::capabilities::CapabilityRootLocation::Environment {
+                    environment_id,
+                    ..
+                } = &root.selected_root().location;
+                sandbox_contexts.contains_key(environment_id)
+            });
+        }
+        let cache = session
+            .services
+            .thread_extension_data
+            .native_try_get::<codex_exec_server::ExecutorCapabilityDiscoveryCache>()
+            .ok_or_else(refused)?;
+        let observation = cache
+            .native_observe_local(&selected, &sandbox_contexts)
+            .ok_or_else(refused)?;
+        Ok(Self::V1 { cache, observation })
+    }
+
+    fn matches_applied_discovery(
+        &self,
+        applied_v1: Option<&codex_exec_server::ExecutorCapabilityDiscoverySnapshot>,
+        applied_v2: Option<&[codex_exec_server::ExecutorCapabilityDiscoveryV2Snapshot]>,
+    ) -> bool {
+        match self {
+            Self::Disabled => applied_v1.is_none() && applied_v2.is_none(),
+            Self::V2Local => applied_v1.is_none() && applied_v2.is_some_and(|v| v.is_empty()),
+            Self::V1 { observation, .. } => {
+                let Some(applied) = applied_v1.filter(|_| applied_v2.is_none()) else {
+                    return false;
+                };
+                let observed = observation.snapshot();
+                observed.sandbox_contexts() == applied.sandbox_contexts()
+                    && observed.roots().len() == applied.roots().len()
+                    && observed.roots().iter().zip(applied.roots()).all(|(a, b)| {
+                        a.selected_root == b.selected_root
+                            && match (&a.result, &b.result) {
+                                (Ok(a), Ok(b)) => Arc::ptr_eq(a, b),
+                                (Err(a), Err(b)) => a == b,
+                                _ => false,
+                            }
+                    })
+            }
+        }
+    }
+
+    fn is_current(
+        &self,
+        session: &Session,
+        config: &crate::config::Config,
+        environments: &TurnEnvironmentSnapshot,
+    ) -> bool {
+        if environments
+            .turn_environments()
+            .any(|environment| environment.environment.is_remote())
+        {
+            return false;
+        }
+        let v2 = config
+            .features
+            .enabled(codex_features::Feature::ExecutorCapabilityDiscoveryV2);
+        let scope = Session::v1_discovery_scope_for_step(config, environments);
+        match self {
+            Self::Disabled => !v2 && scope.is_none(),
+            Self::V2Local => v2,
+            Self::V1 { cache, observation } => {
+                !v2 && scope.as_ref().is_some_and(|(_, sandbox)| {
+                    observation.snapshot().sandbox_contexts() == sandbox
+                }) && session
+                    .services
+                    .thread_extension_data
+                    .native_try_get::<codex_exec_server::ExecutorCapabilityDiscoveryCache>()
+                    .is_some_and(|current| Arc::ptr_eq(&current, cache))
+                    && observation.is_current(cache)
+            }
+        }
+    }
+}
