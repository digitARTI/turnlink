+async fn target_tool_inputs_with_target_scope_mutation(
+    skill_policy: Option<Arc<std::sync::atomic::AtomicBool>>,
+    require_v1: bool,
+    hosted_plugin: bool,
+    prepare_actual_step: bool,
+    shutdown_first: bool,
+    target_scope: Option<bool>,
+    unknown_turn_input: bool,
+    panic_step: bool,
+    bind_movement: bool,
+    install_pair: bool,
+    install_mcp: bool,
+    stage_resources: u8,
+) {
+    let (_root, tx, runner, session, cwd) = destination_assembly_fixture_with_fixtures(
+        skill_policy.clone(),
+        hosted_plugin,
+        unknown_turn_input,
+    )
+    .boxed()
+    .await;
+    let mut real_socket_peer = if (8..=10).contains(&stage_resources) || stage_resources == 12 {
+        use futures::StreamExt;
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let (accepted, ready) = oneshot::channel();
+        let peer = tokio::spawn(async move {
+            let (socket, _) = listener.accept().await.unwrap();
+            let mut config = tokio_tungstenite::tungstenite::protocol::WebSocketConfig::default();
+            config.extensions.permessage_deflate = Some(tokio_tungstenite::tungstenite::extensions::compression::deflate::DeflateConfig::default());
+            let mut socket = tokio_tungstenite::accept_async_with_config(socket, Some(config))
+                .await
+                .unwrap();
+            accepted.send(()).unwrap();
+            tokio::time::timeout(std::time::Duration::from_secs(60), socket.next())
+                .await
+                .unwrap()
+        });
+        session
+            .services
+            .model_client
+            .load_full()
+            .native_cache_loopback_socket_for_test(format!("http://{address}/v1"))
+            .await
+            .unwrap();
+        ready.await.unwrap();
+        Some(peer)
+    } else {
+        None
+    };
+    if require_v1 {
+        let project_config = cwd.as_path().join(".codex/config.toml");
+        let mut config = std::fs::read_to_string(&project_config).unwrap();
+        config.push_str("\n[features]\nexecutor_capability_discovery = true\nexecutor_capability_discovery_v2 = false\n");
+        std::fs::write(project_config, config).unwrap();
+    }
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.unwrap();
+    let candidate = session
