+#[cfg(test)]
+mod native_instruction_binding_tests {
+    use super::*;
+
+    #[test]
+    fn native_instruction_binding_refuses_nested_pending_cancelled_and_exhausted_changes() {
+        let manager = AgentsMdManager::new(SessionInstructions::default());
+        let old = manager.capture_native_instruction_source().unwrap();
+        let first = manager.begin_native_instruction_change();
+        let second = manager.begin_native_instruction_change();
+        assert!(manager.capture_native_instruction_source().is_err());
+        drop(first);
+        assert!(manager.capture_native_instruction_source().is_err());
+        drop(second);
+        assert!(manager.validate_native_instruction_source(&old).is_err());
+        let fresh = manager.capture_native_instruction_source().unwrap();
+        manager.validate_native_instruction_source(&fresh).unwrap();
+        assert!(manager.validate_native_instruction_source(&old).is_err());
+        manager.native_changes.lock().unwrap().pending = Some(usize::MAX);
+        drop(manager.begin_native_instruction_change());
+        assert!(manager.capture_native_instruction_source().is_err());
+    }
+    #[test]
+    fn native_instruction_binding_refuses_foreign_owner_and_busy_lock_without_waiting() {
+        let manager = AgentsMdManager::new(SessionInstructions::default());
+        let foreign = AgentsMdManager::new(SessionInstructions::default());
+        let old = manager.capture_native_instruction_source().unwrap();
+        assert!(foreign.validate_native_instruction_source(&old).is_err());
+        let busy = manager.native_changes.lock().unwrap();
+        assert!(manager.capture_native_instruction_source().is_err());
+        assert!(manager.validate_native_instruction_source(&old).is_err());
+        drop(busy);
+        manager.validate_native_instruction_source(&old).unwrap();
+    }
+    #[tokio::test]
+    async fn native_instruction_binding_poison_refuses_without_breaking_applied_cache_reads() {
+        let manager = AgentsMdManager::new(SessionInstructions::default());
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let _held = manager.native_changes.lock().unwrap();
+                panic!("owned fixture poison");
+            }))
+            .is_err()
+        );
+        assert!(manager.capture_native_instruction_source().is_err());
+        drop(manager.begin_native_instruction_change());
+        assert!(manager.capture_native_instruction_source().is_err());
+        assert!(manager.get_loaded().await.is_none());
+    }
+}
