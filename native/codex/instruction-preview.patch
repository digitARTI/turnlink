+async fn continuity_acquisition_retires_only_completed_prewarm() {
+    use super::startup_prewarm::SessionStartupPrewarmHandle;
+    use codex_protocol::protocol::ContinuityAcquisition;
+    let (tx, runner, session) = queue().await;
+    let owner = ContinuityOwner::new();
+    let client = session.services.model_client.load_full();
+    let (release, wait) = oneshot::channel::<()>();
+    let task = tokio::spawn(async move {
+        let model_session = client.new_session();
+        let _ = wait.await;
+        Ok(model_session)
+    });
+    session
+        .set_session_startup_prewarm(SessionStartupPrewarmHandle::new(
+            task,
+            std::time::Instant::now(),
+            std::time::Duration::from_secs(30),
+        ))
+        .await;
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        &tx,
+        Op::ContinuityAcquire {
+            owner: owner.clone(),
+            reply,
+        },
+    )
+    .await;
+    assert!(matches!(
+        accepted.await.unwrap().unwrap(),
+        ContinuityAcquisition::RefusedBeforeAcquisition
+    ));
+    assert!(session.state.lock().await.startup_prewarm.is_some());
+    assert!(!session.continuity_receipt_path().await.exists());
+    release.send(()).unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            if session
+                .state
+                .lock()
+                .await
+                .startup_prewarm
+                .as_ref()
+                .unwrap()
+                .is_finished()
+            {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    acquire(&tx, &owner)
+        .await
+        .expect("acquire after completed prewarm retired");
+    assert!(session.state.lock().await.startup_prewarm.is_none());
+    runner.abort();
