diff --git a/codex-rs/native-tool-preparation/src/lib.rs b/codex-rs/native-tool-preparation/src/lib.rs
new file mode 100644
index 0000000..b90599c
--- /dev/null
+++ b/codex-rs/native-tool-preparation/src/lib.rs
@@ -0,0 +1,140 @@
+//! Closed native host collection, kept above Core's extension dependency boundary.
+
+#[cfg(test)]
+mod tests;
+
+use codex_core::config::Config;
+use codex_extension_api::ExtensionData;
+use codex_extension_api::ExtensionRegistry;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::NativeToolCollectionError;
+use codex_extension_api::NativeToolCollectionResult;
+use codex_extension_api::PreparedToolContributor;
+
+/// Registers the closed standard-native collector. It observes already applied
+/// scopes; no destination readiness, freshness or execution grant is implied.
+pub fn install(registry: &mut ExtensionRegistryBuilder<Config>) {
+    registry.native_tool_preparation_collector(collect);
+    registry.native_tool_contributor_classifier(is_known);
+    registry.native_prompt_contributor_classifier(is_known_prompt);
+    registry.native_turn_input_contributor_classifier(is_known_turn_input);
+}
+
+fn is_known_turn_input(contributor: &dyn codex_extension_api::TurnInputContributor) -> bool {
+    codex_skills_extension::native_is_skill_turn_input_contributor::<Config>(contributor)
+}
+
+fn is_known_prompt(contributor: &dyn codex_extension_api::ContextContributor) -> bool {
+    codex_git_attribution::native_is_prompt_contributor(contributor)
+        || codex_history_notes_extension::native_is_prompt_contributor(contributor)
+        || codex_memories_extension::native_is_prompt_contributor(contributor)
+        || codex_skills_extension::native_is_skill_prompt_contributor::<Config>(contributor)
+}
+
+// The owning-crate helpers downcast before inspecting these empty scopes.
+// Unknown trait implementations are never called, and no initialized backend
+// or host configuration callback is available to the recognized helpers here.
+fn is_known(contributor: &dyn codex_extension_api::ToolContributor) -> bool {
+    let session = ExtensionData::new("native-classifier-session");
+    let thread = ExtensionData::new("native-classifier-thread");
+    let step = ExtensionData::new("native-classifier-step");
+    codex_multi_env_copy_file::preview_tools(contributor, &session, &thread, &step).is_some()
+        || codex_git_attribution::preview_tools(contributor).is_some()
+        || codex_agent_message_board_extension::preview_tools::<Config>(
+            contributor,
+            &session,
+            &thread,
+            &step,
+        )
+        .is_some()
+        || codex_goal_extension::preview_tools::<Config>(contributor, &session, &thread, &step)
+            .is_some()
+        || codex_history_notes_extension::preview_tools(contributor, &session, &thread, &step)
+            .is_some()
+        || codex_memories_extension::preview_tools(contributor, &session, &thread, &step).is_some()
+        || codex_web_search_extension::preview_tools(contributor, &session, &thread, &step)
+            .is_some()
+        || codex_image_generation_extension::preview_tools(contributor, &session, &thread, &step)
+            .is_some()
+        || codex_skills_extension::preview_tools::<Config>(contributor, &session, &thread, &step)
+            .is_some()
+}
+
+fn collect(
+    registry: &ExtensionRegistry<Config>,
+    session_store: &ExtensionData,
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+) -> NativeToolCollectionResult {
+    let mut observations = Vec::with_capacity(registry.tool_contributors().len());
+    for (index, contributor) in registry.tool_contributors().iter().enumerate() {
+        let contributor_ref = contributor.as_ref();
+        let tools = codex_multi_env_copy_file::preview_tools(
+            contributor_ref,
+            session_store,
+            thread_store,
+            step_store,
+        )
+        .or_else(|| codex_git_attribution::preview_tools(contributor_ref))
+        .or_else(|| {
+            codex_agent_message_board_extension::preview_tools::<Config>(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_goal_extension::preview_tools::<Config>(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_history_notes_extension::preview_tools(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_memories_extension::preview_tools(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_web_search_extension::preview_tools(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_image_generation_extension::preview_tools(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .or_else(|| {
+            codex_skills_extension::preview_tools::<Config>(
+                contributor_ref,
+                session_store,
+                thread_store,
+                step_store,
+            )
+        })
+        .ok_or(NativeToolCollectionError::UnknownContributor { index })?
+        .map_err(|reason| NativeToolCollectionError::IncompleteContributor { index, reason })?;
+        observations.push(PreparedToolContributor::new(contributor.clone(), tools));
+    }
+    Ok(observations)
+}
