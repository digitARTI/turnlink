+    assert!(inspect_checkpoint_history(root.path(), id, &owner, &reservation, &grant, &"0".repeat(64), &rollout_hash, &journal_hash).await.is_err());
+    assert!(inspect_checkpoint_history(root.path(), id, &owner, &reservation, &grant, &composite, &"0".repeat(64), &journal_hash).await.is_err());
+    assert!(inspect_checkpoint_history(root.path(), id, &owner, &reservation, &grant, &composite, &rollout_hash, &"0".repeat(64)).await.is_err());
