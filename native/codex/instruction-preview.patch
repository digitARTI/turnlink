+fn spawn_realtime_owned<F>(
+    admission: tokio::sync::OwnedRwLockReadGuard<()>,
+    work: F,
+) -> JoinHandle<()>
+where
+    F: std::future::Future<Output = ()> + Send + 'static,
+{
+    tokio::spawn(async move {
+        let _admission = admission;
+        work.await;
+    })
