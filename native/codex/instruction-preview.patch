+#[cfg(all(debug_assertions, unix))]
+fn checkpoint_decode_history(bytes: &[u8], thread_id: codex_protocol::ThreadId, path: PathBuf) -> CodexResult<codex_history::InitialHistory> {
+    if bytes.last() != Some(&b'\n') { return Err(refused()); }
+    let text = std::str::from_utf8(bytes).map_err(|_| refused())?;
+    let mut items = Vec::new();
+    for line in text.lines() {
+        if line.trim().is_empty() || items.len() >= 8192 { return Err(refused()); }
+        let value = serde_json::from_str(line).map_err(|_| refused())?;
+        let decoded = codex_rollout::decode_rollout_line(value).map_err(|_| refused())?;
+        items.push(decoded.item);
+    }
+    if !matches!(items.first(), Some(codex_history::RolloutItem::SessionMeta(meta)) if meta.meta.id == thread_id) { return Err(refused()); }
+    Ok(codex_history::InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: thread_id, history: Arc::new(items), history_revision: None, rollout_path: Some(path),
+    }))
+}
