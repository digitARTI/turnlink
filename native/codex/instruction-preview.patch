+        let (config, thread_id, reservation, grant, digest, rollout_sha256, journal_sha256) = {
+            let candidates = self.state.checkpoint_candidates.lock().map_err(|_| refused())?;
+            let slot = candidates.get(&id).ok_or_else(refused)?;
+            if &slot.owner != owner || &slot.reservation != expected_reservation || &slot.grant != expected_grant
+                || !owner.is_open() { return Err(refused()); }
+            (Arc::clone(&slot.config), slot.thread_id, slot.reservation.clone(), slot.grant.clone(),
+                slot.digest.clone(), slot.rollout_sha256.clone(), slot.journal_sha256.clone())
+        };
+        if self.state.auth_manager.auth_cached().is_some() { return Err(refused()); }
+        let layer_matches = crate::session::continuity::checkpoint_config_layer_matches(config.codex_home.as_ref(), &config, &grant).unwrap_or(false);
+        let inspected = crate::session::continuity::inspect_checkpoint_history(
+            config.codex_home.as_ref(), thread_id, owner, &reservation, &grant,
+            &digest, &rollout_sha256, &journal_sha256).await;
+        let model = config.model.as_deref().ok_or_else(refused)?;
+        let model_info = self.state.models_manager.get_model_info(model, &config.to_models_manager_config()).await;
