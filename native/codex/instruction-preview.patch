+        .await
+        .unwrap();
+    let plan = session
+        .continuity_plan_provider(&owner, &held, cwd)
+        .await
+        .unwrap();
+    session
+        .continuity_construct_provider(&owner, &held, provider_grant(plan))
+        .await
+        .unwrap();
+    session
+        .continuity_validate_retained_destination(&owner, &held, id)
+        .await
+        .unwrap();
+    let resource = {
+        let state = session.state.lock().await;
+        state
+            .continuity
+            .provider_resource_handle_for_test()
+            .unwrap()
+    };
+    let borrower = resource.lock().await;
+    let refused = tokio::time::timeout(
+        std::time::Duration::from_secs(1),
+        session.continuity_validate_retained_destination(&owner, &held, id),
+    )
+    .await
+    .expect("candidate validation must not wait for a target borrower");
+    assert!(
+        matches!(refused.unwrap_err().details(), codex_protocol::error::CodexErrorDetails::Io(value)
+        if value.kind() == std::io::ErrorKind::WouldBlock)
+    );
+    drop(borrower);
+    session
+        .continuity_validate_retained_destination(&owner, &held, id)
+        .await
+        .unwrap();
+    // The retry is read-only and rechecks the retained owner after the same
+    // live borrower releases the provider; no provider effect is dispatched.
+    let borrower = Arc::clone(&resource).lock_owned().await;
+    let release = tokio::spawn(async move {
+        tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        drop(borrower);
+    });
+    super::continuity::retry_busy_observation(|| {
+        session.continuity_validate_retained_destination(&owner, &held, id)
+    })
+    .await
+    .unwrap();
+    release.await.unwrap();
+    assert!(session.continuity_release(&owner, &held).await.is_err());
+    let borrower = Arc::clone(&resource).lock_owned().await;
+    let revoked_owner = owner.clone();
+    let revoke = tokio::spawn(async move {
+        tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        revoked_owner.close();
+        drop(borrower);
+    });
+    assert!(
+        super::continuity::retry_busy_observation(|| {
+            session.continuity_validate_retained_destination(&owner, &held, id)
+        })
+        .await
+        .is_err()
+    );
+    revoke.await.unwrap();
+    runner.abort();
+}
