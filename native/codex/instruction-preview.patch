+async fn acquire(
+    tx: &async_channel::Sender<Submission>,
+    owner: &ContinuityOwner,
+) -> codex_protocol::error::Result<ContinuityReservation> {
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        tx,
+        Op::ContinuityAcquire {
+            owner: owner.clone(),
+            reply,
+        },
+    )
+    .await;
+    match accepted.await.expect("native acquire reply")? {
+        codex_protocol::protocol::ContinuityAcquisition::Acquired(reservation) => Ok(reservation),
+        codex_protocol::protocol::ContinuityAcquisition::RefusedBeforeAcquisition => {
+            Err(super::continuity::refused())
+        }
+    }
+}
