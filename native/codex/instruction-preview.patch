+/// Preparation consumes full raw streams before applying native effective-prefix
+/// semantics. Its aggregate cap refuses oversized or uncertain observations.
+enum InstructionReadPolicy {
+    Execution,
+    Preparation { remaining_raw_bytes: usize },
+}
+
+impl InstructionReadPolicy {
+    fn preparation() -> Self {
+        Self::Preparation {
+            remaining_raw_bytes: 1_048_576,
+        }
+    }
+
+    fn is_preparation(&self) -> bool {
+        matches!(self, Self::Preparation { .. })
+    }
+
+    async fn read_file(
+        &mut self,
+        fs: &dyn ExecutorFileSystem,
+        path: &PathUri,
+        sandbox: Option<&FileSystemSandboxContext>,
+    ) -> io::Result<Vec<u8>> {
+        let Self::Preparation {
+            remaining_raw_bytes,
+        } = self
+        else {
+            return fs
+                .read_file(path, ReadFileOptions::default(), sandbox)
+                .await;
+        };
+        let mut stream = fs.read_file_stream(path, sandbox).await?;
+        let mut data = Vec::new();
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk?;
+            if chunk.len() > *remaining_raw_bytes {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "repository instruction preparation exceeds aggregate raw-byte budget",
+                ));
+            }
+            *remaining_raw_bytes -= chunk.len();
+            data.extend_from_slice(&chunk);
+        }
+        Ok(data)
+    }
+}
