+        codex_mcp::McpRuntime::empty(false),
+    )));
+    let target_mcp = Arc::new(McpResourceClient::new(Arc::new(
+        codex_mcp::McpRuntime::empty(false),
+    )));
+    session.insert(SkillsSessionState {
+        mcp_resources: Some(Arc::clone(&source_mcp)),
+        extension_metrics: None,
+    });
+    assert!(native_detach_skill_step(
+        &thread,
+        &step,
+        Arc::clone(&target_mcp)
+    ));
+    assert!(!native_detached_skill_step_ready(&step));
+    assert_eq!(
+        native_project_detached_skill_step(
+            registry.tool_contributors()[0].as_ref(),
+            &(),
+            false,
+            &thread,
+            &step
+        ),
+        Some(false)
+    );
+    let detached = step.get::<NativeDetachedSkillStep>().unwrap();
+    let policy = native_observe_detached_skill_policy(&step).unwrap();
+    assert!(!policy.is_current(&step));
+    let selected = crate::tools::skill_tool_thread_state(&thread, &step).unwrap();
+    assert!(Arc::ptr_eq(&selected, &detached.state));
+    assert!(!Arc::ptr_eq(&selected, &source));
+    assert!(Arc::ptr_eq(
+        &step_mcp_resources(&session, &step).unwrap(),
+        &target_mcp
+    ));
+    let plugins = SelectedPluginSnapshot::default();
+    let input = StepPreparationInput {
+        turn_id: "destination",
+        ready_selected_capability_roots: &[],
+        executor_capability_discovery: None,
+        executor_capability_discovery_v2: None,
+        selected_plugins: &plugins,
+        session_store: &session,
+        thread_store: &thread,
+        turn_store: &turn,
+        step_store: &step,
+    };
+    registry.tool_contributors()[0]
+        .prepare_for_step(input)
+        .await;
+    assert!(step.get::<SkillsStepState>().is_some());
+    assert!(native_detached_skill_step_ready(&step));
+    assert!(policy.is_current(&step));
+    let original = detached.state.config();
+    let mut changed = original.clone();
+    changed.include_instructions = !changed.include_instructions;
+    detached.state.set_config(changed);
+    assert!(!policy.is_current(&step));
+    assert!(!native_detached_skill_step_ready(&step));
+    detached.state.set_config(original);
+    assert!(!policy.is_current(&step));
+    assert!(!native_detached_skill_step_ready(&step));
+    assert!(source.native_executor_cache_is_empty());
+
+    let ordinary = ExtensionData::new("ordinary");
+    assert!(Arc::ptr_eq(
+        &step_mcp_resources(&session, &ordinary).unwrap(),
+        &source_mcp
+    ));
+    assert!(Arc::ptr_eq(
+        &crate::tools::skill_tool_thread_state(&thread, &ordinary).unwrap(),
+        &source
+    ));
+    registry.tool_contributors()[0]
+        .prepare_for_step(StepPreparationInput {
+            step_store: &ordinary,
+            ..input
+        })
+        .await;
+    assert!(!source.native_executor_cache_is_empty());
