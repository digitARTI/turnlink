+/// Run only after the host has journaled and authorized contributor effects.
+/// The host must provide a side-effect-free witness for external inputs.
+pub fn native_project_detached_skill_step<C: Send + Sync + 'static>(
+    contributor: &dyn ToolContributor,
+    target_config: &C,
+    target_has_local_environment: bool,
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+) -> Option<bool> {
+    let Some(extension) = (contributor as &dyn std::any::Any).downcast_ref::<SkillsExtension<C>>()
+    else {
+        return None;
+    };
+    let Some(source) = thread_store.native_try_get::<SkillsThreadState>() else {
+        return None;
+    };
+    let Some(existing) = step_store.native_try_get::<NativeDetachedSkillStep>() else {
+        return None;
+    };
+    let witness = extension.native_projection_witness.as_ref()?()?;
+    if !witness() {
+        return None;
+    }
+    let config = (extension.config_from_host)(target_config);
+    let available = extension.providers.has_cloud_provider() && !target_has_local_environment;
+    let cloud_enabled = config.cloud_skill_enabled && available;
+    let Some(detached) = source.native_detached_for_target(config, available) else {
+        return None;
+    };
+    if !witness()
+        || !thread_store
+            .native_try_get::<SkillsThreadState>()
+            .is_some_and(|current| Arc::ptr_eq(&source, &current))
+        || !step_store
+            .native_try_get::<NativeDetachedSkillStep>()
+            .is_some_and(|current| Arc::ptr_eq(&existing, &current))
+    {
+        return None;
+    }
+    step_store.insert(NativeDetachedSkillStep {
+        state: Arc::new(detached),
+        mcp_resources: Arc::clone(&existing.mcp_resources),
+        projection_witness: Some(witness),
+        diagnostics: Arc::clone(&existing.diagnostics),
+        pending_shadow: Arc::clone(&existing.pending_shadow),
+        input_gate: Arc::clone(&existing.input_gate),
+    });
+    Some(cloud_enabled)
+}
