+    /// Read-only early refusal for a declared environment key. No auth helper,
+    /// provider request or destination resource is started by this operation.
+    pub(crate) async fn continuity_preflight_provider_credential(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<&'static str> {
+        let retained = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            state.continuity.held.as_ref().ok_or_else(refused)?.provider_plan.clone()
+        };
+        if let Some(retained) = retained {
+            if retained.disclosure.to != cwd { return Err(refused()); }
+            let observed = retained.preparation.provider.observe_declared_environment_credential();
+            let valid = self.continuity_validate_provider_preparation(owner, &retained.preparation).await.is_ok();
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            if !state.continuity.held.as_ref().and_then(|held| held.provider_plan.as_ref())
+                .is_some_and(|current| Arc::ptr_eq(current, &retained)) { return Err(refused()); }
+            return match (valid, observed) {
+                (true, Ok(Some(true))) => Ok("present"),
+                (true, Ok(Some(false))) => Ok("missing"),
+                (true, Ok(None)) => Ok("not_declared"),
+                _ => Ok("changed"),
+            };
+        }
+        let prepared = self.continuity_prepare_provider(owner, reservation, cwd).await?;
+        let status = match prepared.provider.observe_declared_environment_credential()? {
+            Some(true) => "present",
+            Some(false) => "missing",
+            None => "not_declared",
+        };
+        self.continuity_validate_provider_preparation(owner, &prepared).await?;
+        Ok(status)
+    }
