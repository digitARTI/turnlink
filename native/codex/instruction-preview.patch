+    pub(crate) async fn continuity_restore(&self) -> CodexResult<()> {
+        let Some(journal) = read_journal(
+            &self.continuity_receipt_path().await,
+            &self.thread_id.to_string(),
+        )?
+        else {
+            // A reservation or completed publication writes a thread-owned
+            // marker. Losing its journal must not silently turn a quarantined
+            // resume into a normal one. This cannot establish absence of
+            // historical effects from before reservation markers existed.
+            if let Some(rollout_path) = self.current_rollout_path().await.map_err(|_| refused())? {
+                match fs::metadata(&rollout_path) {
+                    Ok(metadata) if metadata.is_file() => {
+                        let (items, _, errors) = crate::rollout::RolloutRecorder::load_rollout_items(&rollout_path)
+                            .await.map_err(|_| refused())?;
+                        if errors != 0 || items.into_iter().any(|item| {
+                            matches!(item,
+                                codex_history::RolloutItem::EventMsg(
+                                    codex_protocol::protocol::EventMsg::ThreadSettingsApplied(event)
+                                ) if event.continuity_operation_id.is_some()
+                                    && event.thread_id.is_none_or(|id| id == self.thread_id)
+                            )
+                        }) {
+                            return Err(refused());
+                        }
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                    _ => return Err(refused()),
+                }
+            }
+            return Ok(());
+        };
+        let mut state = self.state.lock().await;
+        state.continuity.revision = state.continuity.revision.max(journal.reservation.revision);
+        if journal.phase != "released" {
+            self.services
+                .mcp_runtime
+                .load_full()
+                .quarantine_native_requests();
+            let admission = self
+                .continuity_admission
+                .clone()
+                .try_write_owned()
+                .map_err(|_| refused())?;
+            // A restored owner has no proof about old effects. Fence the new
+            // process's model client as well as ordinary session mutations.
+            let models = self
+                .services
+                .models_manager
+                .native_observe()
+                .ok_or_else(refused)?;
+            let model_sessions = models.try_exclude_client_sessions().ok_or_else(refused)?;
+            if !self.services.models_manager.native_is_current(&models) {
+                return Err(refused());
+            }
+            let owner = ContinuityOwner::new();
+            owner.close();
+            state.continuity.held = Some(Held {
+                owner,
+                reservation: journal.reservation.clone(),
+                original: None,
+                invalid: true,
+                journal,
+                approved: None,
+                #[cfg(all(debug_assertions, unix))]
+                checkpoint_snapshot: None,
+                destination_candidate: None,
+                provider_plan: None,
+                mcp_plan: None,
+                mcp_startup: None,
+                mcp_binding: None,
+                mcp_plugins: None,
+                mcp_skills: None,
+                mcp_quiescence_exclusion: None,
+                provider_resource: None,
+                provider_configuration: None,
+                provider_cleanup_source: None,
+                target_step: None,
+                publication_source_models: None,
+                publication_mcp: None,
+                publication_source_shutdown: None,
+                publication_source_configuration: None,
+                step_preparing: Arc::new(std::sync::atomic::AtomicBool::new(false)),
+                source_mcp_slot: Arc::clone(&self.services.mcp_runtime),
+                source_mcp_observation: None,
+                source_models_slot: Arc::clone(&self.services.models_manager),
+                source_models_observation: None,
+                _admission: admission,
+                _mcp_requests: None,
+                _model_sessions: Some(Arc::new(model_sessions)),
+                publication_source_model_closed: None,
+            });
+        }
+        Ok(())
+    }
