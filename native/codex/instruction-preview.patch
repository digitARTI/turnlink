+    #[cfg(windows)]
+    options.custom_flags(0x0020_0000); // FILE_FLAG_OPEN_REPARSE_POINT
+    #[cfg(not(any(unix, windows)))]
+    return Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "native memory capture unavailable",
+    ));
+    let mut file = match options.open(path.as_path()).await {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            return Ok(NativeMemorySnapshot::Missing);
+        }
+        Err(error) => return Err(error),
+    };
+    let before = native_memory_file_identity(&file, &file.metadata().await?)?;
+    let mut bytes = Vec::new();
+    let mut bounded = (&mut file).take(LIMIT + 1);
+    bounded.read_to_end(&mut bytes).await?;
+    if bytes.len() as u64 > LIMIT {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "memory summary exceeds native capture limit",
+        ));
+    }
+    let after = native_memory_file_identity(&file, &file.metadata().await?)?;
+    if before != after || after.len != bytes.len() as u64 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "memory summary changed during capture",
+        ));
+    }
+    std::str::from_utf8(&bytes).map_err(|_| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "memory summary is not UTF-8",
+        )
+    })?;
+    Ok(NativeMemorySnapshot::File {
+        bytes,
+        identity: after,
+    })
+}
+
+fn snapshot_memory_prompt(
+    config: &MemoriesExtensionConfig,
+    snapshot: &NativeMemorySnapshot,
+) -> Vec<PromptFragment> {
+    match snapshot {
+        NativeMemorySnapshot::File { bytes, .. } => std::str::from_utf8(bytes)
+            .ok()
+            .and_then(|text| render_memory_summary(&config.codex_home, config.version, text))
+            .map(|instructions| memory_fragments(instructions, config.version))
+            .unwrap_or_default(),
+        NativeMemorySnapshot::Disabled | NativeMemorySnapshot::Missing => Vec::new(),
+    }
+}
