+    /// Transfer the request activity across final transport shutdown. Dropping
+    /// the returned permit without completion keeps cancellation uncertain.
+    #[doc(hidden)]
+    pub fn into_completion_activity(self) -> Option<crate::NativeMcpActivityPermit> {
+        self.native_activity
+    }
+
+    pub async fn cancel(self, reason: Option<String>) {
+        let Self {
+            handle,
+            notifications,
+            native_activity,
+        } = self;
+        drop(notifications);
+        // A cancellation notification is not a server termination receipt.
+        let _ = handle.cancel(reason).await;
+        drop(native_activity);
+    }
 }
 
