+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )
+            .map_err(|_| refused())?;
+        let config = &target.inputs.config;
+        let title_request = config.ephemeral
+            && matches!(
+                target.inputs.candidate.preparation.runtime_configuration().thread_source.as_ref(),
+                Some(codex_protocol::protocol::ThreadSource::Feature(feature)) if feature == "thread_title"
+            );
+        let client = target.source_model_client.client.native_destination_client(
+            Arc::clone(&owner.provider),
+            config,
+            Session::build_model_client_beta_features_header(config),
+            config
+                .features
+                .enabled(codex_features::Feature::ReasoningEffortOverride)
+                && !title_request,
