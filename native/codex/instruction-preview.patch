@@ -0,0 +1,98 @@
+//! Experimental per-attempt MCP journal; absence never proves a complete inventory.
+//! This same-UID fixture is not an authenticated owner or a receiver-release proof.
+#[cfg(all(debug_assertions, unix))]
+pub(crate) fn record(tool: &str) -> anyhow::Result<()> {
+    use anyhow::{Context, bail};
+    use sha2::{Digest, Sha256};
+    use std::ffi::CString;
+    use std::fs::File;
+    use std::io::Write;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    if std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_OWNER_FD").is_some() {
+        return record_owner_fd(tool);
+    }
+    let path = std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_JOURNAL");
+    let scope = std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_SCOPE");
+    if path.is_none() && scope.is_none() { return Ok(()); }
+    let path = path.context("missing MCP journal path")?;
+    let scope = scope.context("missing MCP scope")?.into_string().map_err(|_| anyhow::anyhow!("invalid MCP scope"))?;
+    if scope.len() != 64 || !scope.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { bail!("invalid MCP scope"); }
+    let path = std::path::Path::new(&path);
+    if !path.is_absolute() { bail!("invalid MCP journal path"); }
+    let cpath = CString::new(path.as_os_str().as_bytes())?;
+    let fd = unsafe { libc::open(cpath.as_ptr(), libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC) };
+    if fd < 0 { bail!("MCP journal unavailable"); }
+    let directory = unsafe { File::from_raw_fd(fd) };
+    let mut stat: libc::stat = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstat(fd, &mut stat) } != 0 || stat.st_uid != unsafe { libc::geteuid() } || stat.st_mode & 0o077 != 0 { bail!("MCP journal unavailable"); }
+    let hash = format!("{:x}", Sha256::digest(tool.as_bytes()));
+    for slot in 0..1024 {
+        let filename = CString::new(format!("attempt-{slot:04}"))?;
+        let filefd = unsafe { libc::openat(directory.as_raw_fd(), filename.as_ptr(), libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC, 0o600) };
+        if filefd < 0 {
+            if std::io::Error::last_os_error().kind() == std::io::ErrorKind::AlreadyExists { continue; }
+            bail!("MCP journal unavailable");
+        }
+        let mut file = unsafe { File::from_raw_fd(filefd) };
+        let body = serde_json::json!({"version": 1, "scope": scope, "attempt": slot, "toolSha256": hash, "status": "uncertain"});
+        file.write_all(body.to_string().as_bytes())?;
+        file.sync_all()?; directory.sync_all()?;
+        return Ok(());
+    }
+    bail!("MCP journal capacity exceeded")
+}
+
+// Review-only inherited channel. A successful ACK means the owner synced the
+// attempt before dispatch; it does not prove coverage or remote completion.
+#[cfg(all(debug_assertions, unix))]
+fn record_owner_fd(tool: &str) -> anyhow::Result<()> {
+    use anyhow::{Context, bail};
+    use sha2::{Digest, Sha256};
+    use std::io::{Read, Write};
+    use std::os::fd::FromRawFd;
+    use std::os::unix::net::UnixStream;
+    use std::sync::{Mutex, OnceLock};
+    use std::time::Duration;
+    struct Channel { stream: UnixStream, scope: String, sequence: u64, failed: bool }
+    static CHANNEL: OnceLock<Mutex<Option<Channel>>> = OnceLock::new();
+    let channel = CHANNEL.get_or_init(|| {
+        let create = || -> anyhow::Result<Channel> {
+            if std::env::var("TURNLINK_EXPERIMENTAL_MCP_OWNER_FD")? != "4" { bail!("invalid owner fd"); }
+            let scope = std::env::var("TURNLINK_EXPERIMENTAL_MCP_SCOPE")?;
+            if scope.len() != 64 || !scope.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { bail!("invalid scope"); }
+            let stream = unsafe { UnixStream::from_raw_fd(4) };
+            stream.peer_addr()?;
+            stream.set_read_timeout(Some(Duration::from_secs(5)))?;
+            stream.set_write_timeout(Some(Duration::from_secs(5)))?;
+            Ok(Channel { stream, scope, sequence: 1, failed: false })
+        };
+        Mutex::new(create().ok())
+    });
+    let mut lock = channel.lock().map_err(|_| anyhow::anyhow!("owner unavailable"))?;
+    let channel = lock.as_mut().context("owner unavailable")?;
+    if channel.failed { bail!("owner unavailable"); }
+    let result = (|| -> anyhow::Result<()> {
+        let request = serde_json::json!({"version":1,"scope":channel.scope,"sequence":channel.sequence,"toolSha256":format!("{:x}", Sha256::digest(tool.as_bytes()))});
+        channel.stream.write_all(request.to_string().as_bytes())?;
+        channel.stream.write_all(b"\n")?;
+        let mut line = Vec::new();
+        loop { let mut byte = [0]; channel.stream.read_exact(&mut byte)?; if byte[0] == b'\n' { break; } line.push(byte[0]); if line.len() > 1024 { bail!("invalid owner reply"); } }
+        let reply: serde_json::Value = serde_json::from_slice(&line)?;
+        if reply != serde_json::json!({"version":1,"scope":channel.scope,"sequence":channel.sequence,"status":"recorded"}) { bail!("invalid owner reply"); }
+        channel.sequence = channel.sequence.checked_add(1).context("sequence exhausted")?;
+        Ok(())
+    })();
+    if result.is_err() { channel.failed = true; }
+    result
+}
+
+#[cfg(not(all(debug_assertions, unix)))]
+pub(crate) fn record(_tool: &str) -> anyhow::Result<()> {
+    if std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_OWNER_FD").is_some() ||
+        std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_JOURNAL").is_some() ||
+        std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_SCOPE").is_some() {
+        anyhow::bail!("experimental MCP journal unavailable in this build");
+    }
+    Ok(())
+}
