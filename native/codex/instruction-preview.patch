+        "sleep 2".to_string(),
+        None,
+    )
+    .await;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            if matches!(
+                rx.recv().await.expect("event").msg,
+                EventMsg::ExecCommandBegin(_)
+            ) {
+                break;
+            }
+        }
+    })
+    .await
+    .expect("shell starts");
