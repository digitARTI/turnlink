+    #[cfg(all(debug_assertions, unix))]
+    pub(crate) async fn continuity_export_checkpoint_chunk(
+        &self, owner: &ContinuityOwner, reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        kind: &str, offset: usize, expected_digest: Option<&str>,
+    ) -> CodexResult<serde_json::Value> {
+        let result = self.continuity_export_checkpoint_chunk_inner(owner, reservation, grant, kind, offset, expected_digest).await;
+        if result.is_err() {
+            let snapshot_held = {
+                let state = self.state.lock().await;
+                state.continuity.held.as_ref().is_some_and(|held| &held.owner == owner && held.checkpoint_snapshot.is_some())
+            };
+            if snapshot_held { self.continuity_invalidate(Some(owner)).await; }
+        }
+        result
+    }
+
+    #[cfg(all(debug_assertions, unix))]
+    async fn continuity_export_checkpoint_chunk_inner(
+        &self, owner: &ContinuityOwner, reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        kind: &str, offset: usize, expected_digest: Option<&str>,
+    ) -> CodexResult<serde_json::Value> {
+        use base64::Engine;
+        use sha2::{Digest, Sha256};
+        use std::io::Read;
+        use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+        const MAX_ROLLOUT: u64 = 4 * 1024 * 1024;
+        const CHUNK: usize = 6 * 1024;
+        if !matches!(kind, "rollout" | "journal") || offset > MAX_ROLLOUT as usize { return Err(refused()); }
+        if expected_digest.is_none() && offset != 0 { return Err(refused()); }
+        let journal_path = self.continuity_receipt_path().await;
+        // A queued writer may hold the settings permit while blocked behind
+        // our retained writer pin. Revalidation must not wait on that permit.
+        let pinned = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            state.continuity.held.as_ref().ok_or_else(refused)?.checkpoint_snapshot.is_some()
+        };
+        let _settings = if pinned { None } else { Some(super::thread_settings::acquire_persistence_lock(self).await) };
+        let journal = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            if !self.pending_code_mode_message_recordings().is_empty() { return Err(refused()); }
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if held.journal.phase != "grant_bound" || held.journal.host_grant.as_ref() != Some(grant) || held.approved.is_none() { return Err(refused()); }
+            serde_json::to_vec(&held.journal).map_err(|_| refused())?
+        };
+        if journal.len() > 64 * 1024 { return Err(refused()); }
+        let live_thread = self.live_thread().ok_or_else(refused)?;
+        let already_pinned = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            state.continuity.held.as_ref().ok_or_else(refused)?.checkpoint_snapshot.is_some()
+        };
+        let writer = if already_pinned { None } else {
+            live_thread.flush().await.map_err(|_| refused())?;
+            Some(tokio::time::timeout(std::time::Duration::from_secs(3), live_thread.pin_local_writer())
+                .await.map_err(|_| refused())?.map_err(|_| refused())?)
+        };
+        let path = self.current_rollout_path().await.map_err(|_| refused())?.ok_or_else(refused)?;
+        let mut file = std::fs::OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC).open(&path).map_err(|_| refused())?;
+        let before = file.metadata().map_err(|_| refused())?;
+        if !before.is_file() || before.len() > MAX_ROLLOUT { return Err(refused()); }
+        let mut rollout = Vec::new(); (&mut file).take(MAX_ROLLOUT + 1).read_to_end(&mut rollout).map_err(|_| refused())?;
+        let after = file.metadata().map_err(|_| refused())?;
+        let named = std::fs::symlink_metadata(&path).map_err(|_| refused())?;
+        if !named.is_file() || named.file_type().is_symlink() || before.dev() != after.dev() || before.ino() != after.ino()
+            || before.len() != after.len() || before.mtime() != after.mtime() || before.mtime_nsec() != after.mtime_nsec()
+            || before.ctime() != after.ctime() || before.ctime_nsec() != after.ctime_nsec()
+            || after.dev() != named.dev() || after.ino() != named.ino() || rollout.len() as u64 != after.len() { return Err(refused()); }
+        let marker = reservation.generation.to_string();
+        if !rollout.ends_with(b"\n") { return Err(refused()); }
+        let mut markers = 0; let mut first_thread = None;
+        for line in rollout.split(|byte| *byte == b'\n').filter(|line| !line.is_empty()) {
+            let value = serde_json::from_slice(line).map_err(|_| refused())?;
+            let item = codex_rollout::decode_rollout_line(value).map_err(|_| refused())?.item;
+            if first_thread.is_none() && let codex_history::RolloutItem::SessionMeta(meta) = &item { first_thread = Some(meta.meta.id); }
+            if matches!(item, codex_history::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadSettingsApplied(event)) if event.thread_id == Some(self.thread_id)
+                    && event.continuity_operation_id.as_deref() == Some(marker.as_str())) { markers += 1; }
+        }
+        if first_thread != Some(self.thread_id) || markers != 1 { return Err(refused()); }
+        let final_file = file.metadata().map_err(|_| refused())?;
+        let final_named = std::fs::symlink_metadata(&path).map_err(|_| refused())?;
+        if !final_named.is_file() || final_named.file_type().is_symlink() || final_file.dev() != after.dev()
+            || final_file.ino() != after.ino() || final_file.len() != after.len() || final_file.mtime() != after.mtime()
+            || final_file.mtime_nsec() != after.mtime_nsec() || final_file.ctime() != after.ctime()
+            || final_file.ctime_nsec() != after.ctime_nsec() || final_named.dev() != after.dev() || final_named.ino() != after.ino() { return Err(refused()); }
+        let rollout_hash = format!("{:x}", Sha256::digest(&rollout));
+        let journal_hash = format!("{:x}", Sha256::digest(&journal));
+        let digest = format!("{:x}", Sha256::digest(format!("{}:{}:{}:{}:{}:{}:{}", self.thread_id, grant.id,
+            reservation.generation, reservation.revision, rollout_hash, journal_hash, rollout.len()).as_bytes()));
+        if expected_digest.is_some_and(|expected| expected != digest) { return Err(refused()); }
+        let mut state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        if !self.pending_code_mode_message_recordings().is_empty() { return Err(refused()); }
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        let persisted = read_journal(&journal_path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if held.journal.host_grant.as_ref() != Some(grant) || serde_json::to_vec(&held.journal).map_err(|_| refused())? != journal
+            || serde_json::to_vec(&persisted).map_err(|_| refused())? != journal { return Err(refused()); }
+        if let Some(snapshot) = &held.checkpoint_snapshot {
+            if snapshot.digest != digest || snapshot.rollout != rollout || snapshot.journal != journal { return Err(refused()); }
+        } else {
+            if expected_digest.is_some() || offset != 0 { return Err(refused()); }
+            let permit = CHECKPOINT_SLOTS.get_or_init(|| Arc::new(tokio::sync::Semaphore::new(4)))
+                .clone().try_acquire_owned().map_err(|_| refused())?;
+            let (revoked, _) = tokio::sync::watch::channel(false);
+            let pin = Arc::new(std::sync::Mutex::new(writer));
+            arm_checkpoint_pin(owner.clone(), Arc::clone(&pin), revoked.clone());
+            held.checkpoint_snapshot = Some(RetainedCheckpointSnapshot { digest: digest.clone(), rollout, journal, revoked, pin, _permit: permit });
+        }
+        let snapshot = held.checkpoint_snapshot.as_ref().ok_or_else(refused)?;
+        let bytes = if kind == "rollout" { &snapshot.rollout } else { &snapshot.journal };
+        if offset > bytes.len() { return Err(refused()); }
+        let end = std::cmp::min(offset + CHUNK, bytes.len());
+        Ok(serde_json::json!({"version":1,"threadId":self.thread_id.to_string(),"transitionId":grant.id,
+            "reservation":reservation,"digest":digest,"rolloutSha256":rollout_hash,"journalSha256":journal_hash,
+            "rolloutBytes":snapshot.rollout.len(),"journalBytes":snapshot.journal.len(),"kind":kind,"offset":offset,
+            "data":base64::engine::general_purpose::STANDARD.encode(&bytes[offset..end]),"nextOffset":end,
+            "done":end == bytes.len(),"releaseAllowed":false}))
+    }
+
+    pub(crate) async fn continuity_acquire(
+        &self,
+        owner: ContinuityOwner,
+    ) -> CodexResult<codex_protocol::protocol::ContinuityAcquisition> {
+        if !owner.is_open() {
+            return Err(refused());
+        }
+        use codex_protocol::protocol::ContinuityAcquisition;
+        let Ok(admission) = self.continuity_admission.clone().try_write_owned() else {
+            // An existing owner (including restored quarantine) is not an idle
+            // retry signal, even though this attempt installed nothing.
+            if self.state.lock().await.continuity.held.is_some() {
+                return Err(refused());
+            }
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        // A reservation marker is useful only when a local history can be
+        // checked again during restoration. Refuse before acquiring otherwise.
+        let Ok(Some(marker_rollout)) = self.current_rollout_path().await else {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        let Some(source_mcp_observation) = self.services.mcp_runtime.native_observe() else {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        let Some(source_models_observation) = self.services.models_manager.native_observe() else {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        let Ok(mcp_requests) = source_mcp_observation
+            .runtime()
+            .try_native_request_exclusion()
+        else {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        if !self
+            .services
+            .mcp_runtime
+            .native_is_current(&source_mcp_observation)
+            || !self
+                .services
+                .models_manager
+                .native_is_current(&source_models_observation)
+        {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        }
+        let path = self.continuity_receipt_path().await;
+        let previous = read_journal(&path, &self.thread_id.to_string())?;
+        if previous
+            .as_ref()
+            .is_some_and(|journal| journal.phase != "released")
+        {
+            return Err(refused());
+        }
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let active = self.active_turn.lock().await;
+        if active.is_some()
+            || self.conversation.running_state().await.is_some()
+            || *self.services.elicitations.subscribe().borrow()
+            || !self.list_background_terminals().await.is_empty()
+            || self.input_queue.has_pending_mailbox_items().await
+        {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        }
+        let mut state = self.state.lock().await;
+        if !owner.is_open() {
+            return Err(refused());
+        }
+        if state.shutting_down
+            || state.continuity.held.is_some()
+            || state.continuity.revision == u64::MAX
+        {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        }
+        // The write admission excludes new speculative work. Do not carry a
+        // completed source compaction candidate or its client into a reservation.
+        if !state.async_compaction.retire_for_continuity() {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        }
+        // A completed prewarm retains its returned ModelClientSession inside
+        // the join handle. Retire only a finished task: dropping an unfinished
+        // handle would abort work without waiting for its effects to stop.
+        if let Some(prewarm) = state.startup_prewarm.as_ref() {
+            if !prewarm.is_finished() {
+                return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+            }
+            drop(state.take_session_startup_prewarm());
+        }
+        // This only detects already-live turn clients. It does not fence new
+        // aliases or prove that cached transports or remote work are closed.
+        if source_models_observation.has_live_client_sessions() {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        }
+        let Some(model_sessions) = source_models_observation.try_exclude_client_sessions() else {
+            return Ok(ContinuityAcquisition::RefusedBeforeAcquisition);
+        };
+        let reservation = ContinuityReservation {
+            generation: uuid::Uuid::new_v4(),
+            revision: state.continuity.revision,
+        };
+        let journal = Journal {
+            schema: 1,
+            thread_id: self.thread_id.to_string(),
+            phase: "acquired".into(),
+            reservation: reservation.clone(),
+            source_cwd: state.session_configuration.legacy_fallback_cwd.clone(),
+            transition_id: None,
+            cwd: None,
+            receipt: None,
+            history: previous.map_or_else(Vec::new, |journal| journal.history),
+            host_grant: None,
+            destination_cancellation: None,
+            provider_grant: None,
+            provider_receipt: None,
+            provider_cleanup_id: None,
+            provider_cleanup_receipt: None,
+            mcp_plan: None,
+            mcp_grant: None,
+            mcp_receipt: None,
+            mcp_shutdown_id: None,
+            mcp_shutdown_status: None,
+            mcp_quiescence: None,
+            step: None,
+            publication: None,
+        };
+        state.continuity.abandoned_preparation = None;
+        state.continuity.held = Some(Held {
+            owner: owner.clone(),
+            reservation: reservation.clone(),
+            original: None,
+            invalid: false,
+            journal: journal.clone(),
+            approved: None,
+            #[cfg(all(debug_assertions, unix))]
+            checkpoint_snapshot: None,
+            destination_candidate: None,
+            provider_plan: None,
+            mcp_plan: None,
+            mcp_startup: None,
+            mcp_binding: None,
+            mcp_plugins: None,
+            mcp_skills: None,
+            mcp_quiescence_exclusion: None,
+            provider_resource: None,
+            provider_configuration: None,
+            provider_cleanup_source: None,
+            target_step: None,
+            publication_source_models: None,
+            publication_mcp: None,
+            publication_source_shutdown: None,
+            publication_source_configuration: None,
+            step_preparing: Arc::new(std::sync::atomic::AtomicBool::new(false)),
+            source_mcp_slot: Arc::clone(&self.services.mcp_runtime),
+            source_mcp_observation: Some(source_mcp_observation),
+            source_models_slot: Arc::clone(&self.services.models_manager),
+            source_models_observation: Some(source_models_observation),
+            _admission: admission,
+            _mcp_requests: Some(Arc::new(mcp_requests)),
+            _model_sessions: Some(Arc::new(model_sessions)),
+            publication_source_model_closed: None,
+        });
+        if write_journal(&path, &journal).is_err() || !owner.is_open() {
+            state.continuity.invalidate();
+            return Err(refused());
+        }
+        let snapshot = state.session_configuration.thread_settings_snapshot(&state.session_configuration.environments);
+        drop(state);
+        // Persist the reservation marker before returning the owner to any
+        // caller that can start effects. A missing or uncertain history write
+        // keeps the reservation quarantined; it is never inferred to be safe.
+        let marker = async {
+            let live = self.live_thread().ok_or_else(refused)?;
+            live.append_items(&[codex_history::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                    codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                        continuity_operation_id: Some(reservation.generation.to_string()),
+                        thread_id: Some(self.thread_id),
+                        thread_settings: snapshot,
+                    },
+                ),
+            )]).await.map_err(|_| refused())?;
+            live.flush().await.map_err(|_| refused())?;
+            if self.current_rollout_path().await.map_err(|_| refused())?.as_deref()
+                != Some(marker_rollout.as_path()) {
+                return Err(refused());
+            }
+            let (items, _, errors) = crate::rollout::RolloutRecorder::load_rollout_items(&marker_rollout)
+                .await.map_err(|_| refused())?;
+            let marker_id = reservation.generation.to_string();
+            let matches = items.into_iter().filter(|item| matches!(item,
+                codex_history::RolloutItem::EventMsg(
+                    codex_protocol::protocol::EventMsg::ThreadSettingsApplied(event)
+                ) if event.thread_id == Some(self.thread_id)
+                    && event.continuity_operation_id.as_deref() == Some(marker_id.as_str())
+            )).count();
+            if errors != 0 || matches != 1 {
+                return Err(refused());
+            }
+            Ok::<(), codex_protocol::error::CodexErr>(())
+        }.await;
+        if marker.is_err() || !owner.is_open() {
+            self.state.lock().await.continuity.invalidate();
+            return Err(refused());
+        }
+        Ok(ContinuityAcquisition::Acquired(reservation))
+    }
+
+    /// The host must authenticate fresh broker state on its private control
+    /// channel. This binds that host assertion, not complete execution authority.
+    pub(crate) async fn continuity_bind_host_grant(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        grant: codex_protocol::protocol::ContinuityHostGrant,
+    ) -> CodexResult<()> {
+        let valid_digest = |value: &str| {
+            value.len() == 64
+                && value
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        };
+        if grant.agent_id != format!("codex:{}", self.thread_id)
+            || grant.status != "prepared"
+            || grant.from == grant.to
+            || grant.channel.is_empty()
+            || grant.channel.len() > 64
+            || !grant
+                .channel
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+            || !valid_digest(&grant.configuration_digest)
+            || !valid_digest(&grant.authority_digest)
+            || grant.checkpoint_config_sha256.as_ref().is_some_and(|value| !valid_digest(value))
+        {
+            return Err(refused());
+        }
+        {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            if let Some(held) = state.continuity.held.as_ref()
+                && let Some(previous) = &held.approved
+            {
+                return previous.validate_binding(
+                    &grant,
+                    &held.journal,
+                    &state.session_configuration.legacy_fallback_cwd,
+                );
+            }
+        }
+        let inputs = self
+            .continuity_candidate_inputs(owner, reservation, grant.to.clone())
+            .await?;
+        if inputs.source_configuration.legacy_fallback_cwd != grant.from {
+            return Err(refused());
+        }
+        self.continuity_validate_candidate_inputs(owner, &inputs)
+            .await?;
+        let path = self.continuity_receipt_path().await;
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let mut state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let current_cwd = state.session_configuration.legacy_fallback_cwd.clone();
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        if let Some(previous) = &held.approved {
+            return previous.validate_binding(&grant, &held.journal, &current_cwd);
+        }
+        if held.journal.phase != "acquired"
+            || held.journal.source_cwd != grant.from
+            || current_cwd != grant.from
+            || held.journal.host_grant.is_some()
+            || held.provider_plan.is_some()
+            || held.mcp_plan.is_some()
+            || held.journal.provider_grant.is_some()
+            || held
+                .journal
+                .history
+                .iter()
+                .any(|receipt| receipt.transition_id == grant.id)
+        {
+            return Err(refused());
+        }
+        inputs.source_directory.validate()?;
+        inputs.destination_directory.validate()?;
+        let mut journal = held.journal.clone();
+        journal.phase = "grant_bound".into();
+        journal.transition_id = Some(grant.id);
+        journal.cwd = Some(grant.to.clone());
+        journal.host_grant = Some(grant.clone());
+        if write_journal(&path, &journal).is_err() || !owner.is_open() {
+            held.invalidate();
+            journal.phase = "uncertain".into();
+            held.journal = journal;
+            let _ = write_journal(&path, &held.journal);
+            return Err(refused());
+        }
+        held.journal = journal;
+        held.approved = Some(BoundHostGrant {
+            grant,
+            source: inputs.source_directory,
+            destination: inputs.destination_directory,
+        });
+        Ok(())
+    }
+
+    /// Install retained resources and destination settings under one durable
+    /// intent while keeping the thread quarantined. This is not a destination
+    /// commit: source cleanup, receiver and recovery remain unresolved.
+    /// The private host does not expose this operation until those steps exist.
+    #[allow(dead_code)]
+    pub(crate) async fn continuity_stage_destination_resources(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        retained: &codex_protocol::protocol::ContinuityStepPreparationReceipt,
+        operation_id: uuid::Uuid,
+    ) -> CodexResult<()> {
+        let target = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            held.approved
+                .as_ref()
+                .ok_or_else(refused)?
+                .validate_binding(
+                    grant,
+                    &held.journal,
+                    &state.session_configuration.legacy_fallback_cwd,
+                )?;
+            if held
+                .journal
+                .step
+                .as_ref()
+                .and_then(|step| step.receipt.as_ref())
+                != Some(retained)
+            {
+                return Err(refused());
+            }
+            Arc::clone(held.target_step.as_ref().ok_or_else(refused)?)
+        };
+        self.continuity_validate_target_turn(owner, reservation, &target._target)
+            .await?;
+        if !target.attachment_revisions_current(self)
+            || !native_target_contributors_current(self, &target._target.step_extension_data).await
