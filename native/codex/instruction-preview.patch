+                != serde_json::to_vec(&held.journal).map_err(|_| refused())? { return Err(refused()); }
+            let closed = match (shutdown.status.as_str(), held.publication_source_model_closed) {
+                ("pending" | "uncertain", None) => return Ok(None),
+                ("closed", Some(true)) => true,
