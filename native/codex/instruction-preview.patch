+/// Construct a narrow anonymous candidate without Session creation or prewarm.
+/// `history` must originate from the receipt-bound native byte reader; a
+/// caller-provided digest alone supplies no authority.
+#[cfg(all(debug_assertions, unix))]
+pub(crate) fn native_quarantined_checkpoint_candidate(
+    mut config: Arc<Config>,
+    mut baseline: Arc<Config>,
+    history: InitialHistory,
+    thread_id: ThreadId,
+    owner: codex_protocol::protocol::ContinuityOwner,
+    reservation: codex_protocol::protocol::ContinuityReservation,
+    grant: codex_protocol::protocol::ContinuityHostGrant,
+    model_info: ModelInfo,
+) -> CodexResult<NativeQuarantinedCheckpointCandidate> {
+    let refused = || CodexErr::InvalidRequest("native checkpoint candidate unavailable".into());
+    let InitialHistory::Resumed(resumed) = &history else { return Err(refused()); };
+    let Some(RolloutItem::SessionMeta(line)) = resumed.history.first() else { return Err(refused()); };
+    let meta = &line.meta;
+    let model = config.model.clone().filter(|value| !value.trim().is_empty()).ok_or_else(refused)?;
+    if !owner.is_open() || meta.id != thread_id || model_info.slug != model { return Err(refused()); }
+    resolve_native_startup_token_budget(&mut config, &history, None, &model_info)?;
+    resolve_native_startup_token_budget(&mut baseline, &history, None, &model_info)?;
+    let collaboration_mode = native_resolved_collaboration_mode(&history, &config, &model);
+    let input = ResolvedSessionConfiguration {
+        config: Arc::clone(&config),
+        turn_extension_init: Default::default(),
+        provider: create_model_provider(config.model_provider.clone(), None),
+        collaboration_mode,
+        environments: Vec::new(),
+        base_instructions: config.base_instructions.clone().ok_or_else(refused)?,
+        disabled_plugin_ids: Vec::new(), metrics_service_name: None,
+        trusted_guardian_reviewer: false, session_source: meta.source.clone(), history_mode: meta.history_mode,
+        forked_from_thread_id: None, parent_thread_id: None, thread_source: None,
+        originator: meta.originator.clone(), dynamic_tools: Vec::new(), user_shell_override: None,
+    };
+    let candidate = assemble_native_quarantined_session(input)?;
+    if !candidate.matches_checkpoint_metadata(&history, thread_id, &reservation, &grant, &owner) {
+        return Err(refused());
+    }
+    let retained = NativeQuarantinedCheckpointCandidate { candidate, owner, history, thread_id, reservation, grant, model_info };
+    if !retained.is_current(&retained.model_info, &baseline) { return Err(refused()); }
+    Ok(retained)
+}
