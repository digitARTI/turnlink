+    /// Correlate one local peer while the existing reservation remains held.
+    pub(crate) async fn continuity_verify_source_mcp_peer(
+        &self, owner: &ContinuityOwner, reservation: &ContinuityReservation,
+        name: &str, path: &std::path::Path, nonce: &str,
+    ) -> CodexResult<u32> {
+        if name.is_empty() || name.len() > 128 { return Err(refused()); }
+        let state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let source = held.source_mcp_observation.as_ref().ok_or_else(refused)?;
+        if !held.source_mcp_slot.native_is_current(source) || !owner.is_open() { return Err(refused()); }
+        let process_id = source.runtime().native_verify_stdio_peer(
+            Arc::clone(held._mcp_requests.as_ref().ok_or_else(refused)?), name, path, nonce,
+        ).await.ok_or_else(refused)?;
+        if !held.source_mcp_slot.native_is_current(source) || !owner.is_open() { return Err(refused()); }
+        Ok(process_id)
+    }
