+//! Detached project configuration from actual native loader inputs.
+//! No cloud/thread provider refresh, hook execution, or live cache publication.
+
+use super::*;
+use crate::CloudConfigBundleBindingStatus;
+use crate::fingerprint::version_for_toml;
+use futures::StreamExt;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+#[derive(Clone, Debug)]
+pub(crate) struct NativeProjectDiscoveryInputs {
+    pub(crate) source_cwd: AbsolutePathBuf,
+    pub(crate) merged_config: TomlValue,
+    pub(crate) trusted_broker_config: TomlValue,
+    pub(crate) project_root_markers: Vec<String>,
+    pub(crate) user_config_file: AbsolutePathBuf,
+    pub(crate) strict_config: bool,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct NativeProjectInputs {
+    pub(crate) codex_home: AbsolutePathBuf,
+    pub(crate) discovery: Option<NativeProjectDiscoveryInputs>,
+    pub(crate) signature: Vec<(ConfigLayerSource, String, Option<String>)>,
+    pub(crate) project_signature: ProjectSignature,
+    pub(crate) file_inputs: Option<Arc<super::file_preparation::NativeConfigurationFileInputs>>,
+}
+
+impl NativeProjectInputs {
+    pub(crate) fn disabled(codex_home: AbsolutePathBuf) -> Self {
+        Self {
+            codex_home,
+            discovery: None,
+            signature: Vec::new(),
+            project_signature: Vec::new(),
+            file_inputs: None,
+        }
+    }
+}
+
+// Recompute hashes from actual values, not caller-supplied version labels.
+pub(crate) fn global_signature(
+    stack: &ConfigLayerStack,
+) -> Vec<(ConfigLayerSource, String, Option<String>)> {
+    stack
+        .all_layers_low_to_high()
+        .filter(|layer| !matches!(layer.name, ConfigLayerSource::Project { .. }))
+        .map(|layer| {
+            (
+                layer.name.clone(),
+                version_for_toml(&layer.config),
+                layer.disabled_reason.clone(),
+            )
+        })
+        .collect()
+}
+
+pub(super) type ProjectSignature = Vec<(
+    ConfigLayerSource,
+    String,
+    Option<String>,
+    Option<AbsolutePathBuf>,
+)>;
+
+pub(super) fn project_signature<'a>(
+    layers: impl Iterator<Item = &'a ConfigLayerEntry>,
+) -> ProjectSignature {
+    layers
+        .filter(|layer| matches!(layer.name, ConfigLayerSource::Project { .. }))
+        .map(|layer| {
+            (
+                layer.name.clone(),
+                version_for_toml(&layer.config),
+                layer.disabled_reason.clone(),
+                layer.hooks_config_folder(),
+            )
+        })
+        .collect()
+}
+
+fn unavailable() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::WouldBlock,
+        "native project configuration preparation unavailable or stale",
+    )
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "project configuration preparation is oversized or changed during capture",
+    )
+}
+
+fn check_source(
+    stack: &ConfigLayerStack,
+    home: &AbsolutePathBuf,
+) -> io::Result<NativeProjectInputs> {
+    let inputs = stack.native_project_inputs().ok_or_else(unavailable)?;
+    if &inputs.codex_home != home
+        || inputs.signature != global_signature(stack)
+        || inputs.project_signature != project_signature(stack.all_layers_low_to_high())
+    {
+        return Err(unavailable());
+    }
+    stack.ensure_config_server_applied()?;
+    if stack
+        .cloud_config_binding()
+        .is_some_and(|binding| binding.read().status != CloudConfigBundleBindingStatus::Current)
+    {
+        return Err(unavailable());
+    }
+    Ok(inputs.clone())
+}
+
+#[derive(Default)]
+pub(super) struct ProjectReadPolicy {
+    remaining: Option<usize>,
+    observations: BTreeMap<AbsolutePathBuf, Option<Arc<[u8]>>>,
+}
+
+impl ProjectReadPolicy {
+    pub(super) fn execution() -> Self {
+        Self::default()
+    }
+
+    pub(super) fn preparation() -> Self {
+        Self {
+            remaining: Some(1_048_576),
+            observations: BTreeMap::new(),
+        }
+    }
+
+    pub(super) fn is_preparation(&self) -> bool {
+        self.remaining.is_some()
+    }
+
+    fn record(&mut self, path: &AbsolutePathBuf, value: Option<Arc<[u8]>>) -> io::Result<()> {
+        if self
+            .observations
+            .get(path)
+            .is_some_and(|previous| previous != &value)
+        {
+            return Err(invalid());
+        }
+        self.observations.insert(path.clone(), value);
+        Ok(())
+    }
+
+    pub(super) async fn read_text(
+        &mut self,
+        fs: &dyn ExecutorFileSystem,
+        path: &AbsolutePathBuf,
+    ) -> io::Result<Option<String>> {
+        let uri = PathUri::from_abs_path(path);
+        let Some(remaining) = self.remaining.as_mut() else {
+            return match fs.read_file_text(&uri, Default::default(), None).await {
+                Ok(text) => Ok(Some(text)),
+                Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+                Err(error) => Err(error),
+            };
+        };
+        let metadata = match fs.get_metadata(&uri, Default::default(), None).await {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                self.record(path, None)?;
+                return Ok(None);
+            }
+            Err(error) => return Err(error),
+        };
+        if !metadata.is_file || metadata.size > *remaining as u64 {
+            return Err(invalid());
+        }
+        let mut stream = fs.read_file_stream(&uri, None).await?;
+        let mut bytes = Vec::new();
+        while let Some(chunk) = stream.next().await {
+            let chunk = chunk?;
+            if chunk.len() > *remaining {
+                return Err(invalid());
+            }
+            *remaining -= chunk.len();
+            bytes.extend_from_slice(&chunk);
+        }
+        let text = String::from_utf8(bytes.clone())
+            .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+        self.record(path, Some(bytes.into()))?;
+        Ok(Some(text))
+    }
+}
+
+/// Native project data only; it does not establish full authority or a grant.
+/// Native global configuration files must still match the loader's actual read
+/// inputs. MDM/providers remain applied snapshots. Project files and linked-
+/// checkout hooks are freshly observed without executing them.
+pub struct ProjectConfigurationPreview {
+    source: ConfigLayerStack,
+    codex_home: AbsolutePathBuf,
+    cwd: AbsolutePathBuf,
+    stack: ConfigLayerStack,
+    active_project: ProjectConfig,
+    repo_root: Option<AbsolutePathBuf>,
+    observations: BTreeMap<AbsolutePathBuf, Option<Arc<[u8]>>>,
+}
+
+impl ProjectConfigurationPreview {
+    pub fn stack(&self) -> &ConfigLayerStack {
+        &self.stack
+    }
+    pub fn active_project(&self) -> &ProjectConfig {
+        &self.active_project
+    }
+    pub fn repo_root(&self) -> Option<&AbsolutePathBuf> {
+        self.repo_root.as_ref()
+    }
+
+    pub async fn revalidate(&self, fs: &dyn ExecutorFileSystem) -> io::Result<bool> {
+        let fresh =
+            preview_project_configuration(fs, self.codex_home.as_path(), &self.source, &self.cwd)
+                .await?;
+        Ok(self.stack == fresh.stack
+            && self.active_project == fresh.active_project
+            && self.repo_root == fresh.repo_root
+            && self.observations == fresh.observations)
+    }
+}
+
+pub async fn preview_project_configuration(
+    fs: &dyn ExecutorFileSystem,
+    codex_home: &Path,
+    source: &ConfigLayerStack,
+    cwd: &AbsolutePathBuf,
+) -> io::Result<ProjectConfigurationPreview> {
+    let codex_home = AbsolutePathBuf::from_absolute_path(codex_home)?;
+    let mut inputs = check_source(source, &codex_home)?;
+    let mut policy = ProjectReadPolicy::preparation();
+    super::file_preparation::preview_with_reader(fs, source, &mut policy).await?;
+    let (mut stack, repo_root) = if let Some(discovery) = inputs.discovery.as_mut() {
+        let mut context = super::project_trust_context_with_policy(
+            fs,
+            &discovery.merged_config,
+            &discovery.trusted_broker_config,
+            cwd,
+            &discovery.project_root_markers,
+            codex_home.as_path(),
+            &discovery.user_config_file,
+            &policy,
+        )
+        .await?;
+        super::apply_credential_broker_requirement_values(
+            &mut context,
+            source.requirements_toml().feature_requirements.as_ref(),
+            source
+                .requirements_toml()
+                .network
+                .as_ref()
+                .is_none_or(|network| network.enabled != Some(false)),
+            &discovery.trusted_broker_config,
+        );
+        let loaded = super::load_project_layers_with_policy(
+            fs,
+            cwd,
+            &context.project_root,
+            &context,
+            codex_home.as_path(),
+            discovery.strict_config,
+            &mut policy,
+        )
+        .await?;
+        let projectless = !context.has_project_root_marker
+            && context.checkout_root.is_none()
+            && loaded.layers.is_empty();
+        let mut stack = source
+            .replace_project_layers(loaded.layers)?
+            .with_startup_warnings(loaded.startup_warnings);
+        stack.is_projectless = projectless;
+        discovery.source_cwd = cwd.clone();
+        (stack, context.repo_root)
+    } else {
+        // Disabled means the actual native loader intentionally omitted project
+        // config, unlike an unowned stack that has no preparation provenance.
+        if source
+            .all_layers_low_to_high()
+            .any(|layer| matches!(layer.name, ConfigLayerSource::Project { .. }))
+        {
+            return Err(unavailable());
+        }
+        (
+            source.clone(),
+            codex_git_utils::preview_root_git_project_for_trust(fs, cwd).await?,
+        )
+    };
+    let project_config: super::ProjectTrustConfigToml = stack
+        .effective_config()
+        .try_into()
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+    let config = ConfigToml {
+        projects: project_config.projects,
+        ..Default::default()
+    };
+    let active_project = config
