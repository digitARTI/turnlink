+/// Deferred observations for a destination that has not been published.
+/// These are not delivery receipts and must not be emitted without a later
+/// owner-bound publication protocol.
+#[derive(Clone, Debug, PartialEq)]
+pub enum NativeSkillDiagnostic {
+    Warning(ExtensionWarning),
+    Metric {
+        name: String,
+        value: i64,
+        boundaries: Option<Vec<f64>>,
+        tags: Vec<(String, String)>,
+        counter: bool,
+    },
+}
+
+#[derive(Default)]
+struct NativeSkillDiagnostics {
+    records: std::sync::Mutex<Vec<NativeSkillDiagnostic>>,
+    failed: std::sync::atomic::AtomicBool,
+}
+
+impl NativeSkillDiagnostics {
+    fn record(&self, record: NativeSkillDiagnostic) {
+        use std::sync::atomic::Ordering;
+        let bounded = match &record {
+            NativeSkillDiagnostic::Warning(w) => {
+                w.thread_id.len() <= 1024
+                    && w.turn_id.as_ref().is_none_or(|id| id.len() <= 1024)
+                    && w.message.len() <= 8192
+            }
+            NativeSkillDiagnostic::Metric {
+                name,
+                boundaries,
+                tags,
+                ..
+            } => {
+                name.len() <= 1024
+                    && boundaries.as_ref().is_none_or(|v| v.len() <= 1024)
+                    && tags.len() <= 32
+                    && tags.iter().all(|(k, v)| k.len() <= 1024 && v.len() <= 1024)
+            }
+        };
+        if !bounded {
+            self.failed.store(true, Ordering::SeqCst);
+            return;
+        }
+        let Ok(mut records) = self.records.lock() else {
+            self.failed.store(true, Ordering::SeqCst);
+            return;
+        };
+        if records.len() >= 256 {
+            self.failed.store(true, Ordering::SeqCst);
+            return;
+        }
+        records.push(record);
+    }
+    fn available(&self) -> bool {
+        !self.failed.load(std::sync::atomic::Ordering::SeqCst) && self.records.try_lock().is_ok()
+    }
+}
+
+impl ExtensionEventSink for NativeSkillDiagnostics {
+    fn emit(&self, _: codex_protocol::protocol::Event) {
+        self.failed.store(true, std::sync::atomic::Ordering::SeqCst);
+    }
+    fn emit_warning(&self, warning: ExtensionWarning) {
+        self.record(NativeSkillDiagnostic::Warning(warning));
+    }
+}
+
+impl ExtensionMetrics for NativeSkillDiagnostics {
+    fn counter(&self, name: &str, inc: i64, tags: &[(&str, &str)]) {
+        self.metric(name, inc, None, tags, true);
+    }
+    fn histogram(&self, name: &str, value: i64, tags: &[(&str, &str)]) {
+        self.metric(name, value, None, tags, false);
+    }
+    fn histogram_with_boundaries(
+        &self,
+        name: &str,
+        value: i64,
+        boundaries: &[f64],
+        tags: &[(&str, &str)],
+    ) {
+        self.metric(name, value, Some(boundaries), tags, false);
+    }
+}
+impl NativeSkillDiagnostics {
+    fn metric(
+        &self,
+        name: &str,
+        value: i64,
+        boundaries: Option<&[f64]>,
+        tags: &[(&str, &str)],
+        counter: bool,
+    ) {
+        if name.len() > 1024
+            || boundaries.is_some_and(|v| v.len() > 1024)
+            || tags.len() > 32
+            || tags.iter().any(|(k, v)| k.len() > 1024 || v.len() > 1024)
+        {
+            self.failed.store(true, std::sync::atomic::Ordering::SeqCst);
+            return;
+        }
+        self.record(NativeSkillDiagnostic::Metric {
+            name: name.to_string(),
+            value,
+            boundaries: boundaries.map(<[f64]>::to_vec),
+            tags: tags
+                .iter()
+                .map(|(k, v)| ((*k).to_string(), (*v).to_string()))
+                .collect(),
+            counter,
+        });
+    }
+}
