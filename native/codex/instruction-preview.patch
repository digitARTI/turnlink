+#[cfg(unix)]
+fn journal_metadata_matches(expected: &fs::Metadata, actual: &fs::Metadata) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    actual.is_file()
+        && actual.mode() & 0o077 == 0
+        && actual.uid() == unsafe { libc::geteuid() }
+        && actual.nlink() == 1
+        && actual.dev() == expected.dev()
+        && actual.ino() == expected.ino()
+        && actual.len() == expected.len()
+        && actual.mtime() == expected.mtime()
+        && actual.mtime_nsec() == expected.mtime_nsec()
+        && actual.ctime() == expected.ctime()
+        && actual.ctime_nsec() == expected.ctime_nsec()
+}
