+
+fn native_memory_file_identity(
+    file: &tokio::fs::File,
+    metadata: &std::fs::Metadata,
+) -> std::io::Result<NativeMemoryFileIdentity> {
+    if !metadata.is_file() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "memory summary is not a regular file",
+        ));
+    }
+    #[cfg(unix)]
+    use std::os::unix::fs::MetadataExt;
+    #[cfg(unix)]
+    let _ = file;
+    #[cfg(windows)]
+    let windows = {
+        use std::os::windows::io::AsRawHandle;
+        use windows_sys::Win32::Storage::FileSystem::{
+            BY_HANDLE_FILE_INFORMATION, FILE_ATTRIBUTE_REPARSE_POINT, GetFileInformationByHandle,
+        };
+        let mut info: BY_HANDLE_FILE_INFORMATION = unsafe { std::mem::zeroed() };
+        if unsafe { GetFileInformationByHandle(file.as_raw_handle() as _, &mut info) } == 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "memory summary is a reparse point",
+            ));
+        }
+        (
+            info.dwVolumeSerialNumber,
+            ((info.nFileIndexHigh as u64) << 32) | info.nFileIndexLow as u64,
+            ((info.ftCreationTime.dwHighDateTime as u64) << 32)
+                | info.ftCreationTime.dwLowDateTime as u64,
+        )
+    };
+    Ok(NativeMemoryFileIdentity {
+        len: metadata.len(),
+        modified: metadata.modified()?,
+        #[cfg(unix)]
+        unix: (
+            metadata.dev(),
+            metadata.ino(),
+            metadata.ctime(),
+            metadata.ctime_nsec(),
+        ),
+        #[cfg(windows)]
+        windows,
+    })
+}
