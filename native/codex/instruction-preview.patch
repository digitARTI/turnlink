+    /// Detached preparation uses the caller's controlled local filesystem for
+    /// the same implicit-invocation paths instead of bypassing it via std::fs.
+    pub(crate) async fn with_disabled_paths_on_filesystem(
+        mut self,
+        disabled_paths: HashSet<PathUri>,
+        local: &dyn ExecutorFileSystem,
+    ) -> Self {
+        self.disabled_paths = disabled_paths;
+        let mut by_scripts_dir = HashMap::new();
+        let mut by_doc_path = HashMap::new();
+        for skill in self
+            .skills
+            .iter()
+            .filter(|skill| self.is_skill_enabled(skill))
+        {
+            let Ok(path) = skill.path_to_skills_md.to_abs_path() else {
+                continue;
+            };
+            let path_uri = PathUri::from_abs_path(&path);
+            let skill_doc_path = local
+                .canonicalize(&path_uri, None)
+                .await
+                .unwrap_or(path_uri);
+            by_doc_path.insert(skill_doc_path, skill.clone());
+            if let Some(parent) = path.parent() {
+                let scripts = PathUri::from_abs_path(&parent.join("scripts"));
+                let scripts = local.canonicalize(&scripts, None).await.unwrap_or(scripts);
+                by_scripts_dir.insert(scripts, skill.clone());
+            }
+        }
+        self.implicit_skills_by_scripts_dir = Arc::new(by_scripts_dir);
+        self.implicit_skills_by_doc_path = Arc::new(by_doc_path);
+        self
+    }
