+struct PolicyChangingFilesystem {
+    controller: codex_http_client::NetworkPolicyController,
+    revision: codex_http_client::NetworkPolicyRevision,
+    armed: std::sync::atomic::AtomicBool,
+}
+impl codex_file_system::ExecutorFileSystem for PolicyChangingFilesystem {
+    fn read_file_stream<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, codex_file_system::FileSystemReadStream>
+    {
+        Box::pin(async move {
+            let stream = LOCAL_FS.read_file_stream(path, sandbox).await?;
+            if self.armed.swap(false, std::sync::atomic::Ordering::SeqCst) {
+                use codex_http_client::DestinationPolicy;
+                assert!(self.controller.publish(
+                    self.revision,
+                    DestinationPolicy::Restricted {
+                        allowed_hosts: Default::default()
+                    }
+                ));
+                assert!(
+                    self.controller
+                        .publish(self.revision, DestinationPolicy::Unrestricted)
+                );
+            }
+            Ok(stream)
+        })
+    }
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, PathUri> {
+        LOCAL_FS.canonicalize(path, sandbox)
+    }
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: codex_file_system::ReadFileOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, Vec<u8>> {
+        LOCAL_FS.read_file(path, options, sandbox)
+    }
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: codex_file_system::GetMetadataOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, codex_file_system::FileMetadata> {
+        LOCAL_FS.get_metadata(path, options, sandbox)
+    }
+    fn read_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, Vec<codex_file_system::ReadDirectoryEntry>>
+    {
+        LOCAL_FS.read_directory(path, sandbox)
+    }
+    fn read_directory_bounded<'a>(
+        &'a self,
+        path: &'a PathUri,
+        limits: codex_file_system::DirectoryReadLimits,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, Vec<codex_file_system::ReadDirectoryEntry>>
+    {
+        LOCAL_FS.read_directory_bounded(path, limits, sandbox)
+    }
+    fn write_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        contents: Vec<u8>,
+        options: codex_file_system::WriteFileOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, ()> {
+        LOCAL_FS.write_file(path, contents, options, sandbox)
+    }
+    fn create_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: codex_file_system::CreateDirectoryOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, ()> {
+        LOCAL_FS.create_directory(path, options, sandbox)
+    }
+    fn walk<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: codex_file_system::WalkOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, codex_file_system::WalkOutcome> {
+        LOCAL_FS.walk(path, options, sandbox)
+    }
+    fn remove<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: codex_file_system::RemoveOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, ()> {
+        LOCAL_FS.remove(path, options, sandbox)
+    }
+    fn copy<'a>(
+        &'a self,
+        source: &'a PathUri,
+        destination: &'a PathUri,
+        options: codex_file_system::CopyOptions,
+        sandbox: Option<&'a codex_file_system::FileSystemSandboxContext>,
+    ) -> codex_file_system::ExecutorFileSystemFuture<'a, ()> {
+        LOCAL_FS.copy(source, destination, options, sandbox)
+    }
+}
