+/// Reject a Config loaded from different user-layer bytes, even if the file
+/// has subsequently been replaced with the grant-approved bytes. This checks
+/// the effective parsed layer only; it does not attest the rest of Config.
+#[cfg(all(debug_assertions, unix))]
+pub(crate) fn checkpoint_config_layer_matches(home: &Path, config: &crate::config::Config, grant: &codex_protocol::protocol::ContinuityHostGrant) -> CodexResult<bool> {
+    use sha2::{Digest, Sha256};
+    let bytes = checkpoint_read_private_file(&home.join("config.toml"), 256 * 1024)?;
+    if Some(format!("{:x}", Sha256::digest(&bytes)).as_str()) != grant.checkpoint_config_sha256.as_deref() { return Ok(false); }
+    let text = std::str::from_utf8(&bytes).map_err(|_| refused())?;
+    let expected: toml::Value = toml::from_str(text).map_err(|_| refused())?;
+    let mut user = config.config_layer_stack.layers_low_to_high().filter(|layer|
+        matches!(&layer.name, codex_config::ConfigLayerSource::User { profile: None, .. }));
+    let Some(layer) = user.next() else { return Ok(false); };
+    Ok(layer.config == expected && user.next().is_none())
+}
