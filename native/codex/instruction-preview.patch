new file mode 100644
index 0000000..8704538
--- /dev/null
+++ b/codex-rs/login/src/auth/native_preparation.rs
@@ -0,0 +1,420 @@
+//! Applied native auth-cache observations, without refresh or source callbacks.
+use super::*;
+use std::io;
+use std::sync::Arc;
+
+#[derive(Clone)]
+pub(super) struct NativeAuthCacheState {
+    owner: Arc<()>,
+    revision: Arc<()>,
+    pending_changes: Option<usize>,
+}
+impl NativeAuthCacheState {
+    pub(super) fn new() -> Self {
+        Self {
+            owner: Arc::new(()),
+            revision: Arc::new(()),
+            pending_changes: Some(0),
+        }
+    }
+    pub(super) fn change(&mut self) {
+        self.revision = Arc::new(());
+    }
+}
+
+struct SharedJsonObservation {
+    owner: Arc<Mutex<Option<AuthDotJson>>>,
+    revision: Arc<()>,
+}
+impl PartialEq for SharedJsonObservation {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.owner, &other.owner) && Arc::ptr_eq(&self.revision, &other.revision)
+    }
+}
+
+/// Native owner/change binding for applied cached auth. This does not establish
+/// external callback freshness, managed-policy authority or transport readiness.
+#[doc(hidden)]
+pub struct NativeAuthCacheObservation {
+    owner: Arc<()>,
+    revision: Arc<()>,
+    external: Option<Arc<dyn ExternalAuth>>,
+    shared_json: Option<SharedJsonObservation>,
+    auth: Option<CodexAuth>,
+}
+impl PartialEq for NativeAuthCacheObservation {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.owner, &other.owner)
+            && Arc::ptr_eq(&self.revision, &other.revision)
+            && self.shared_json == other.shared_json
+            && match (&self.external, &other.external) {
+                (Some(left), Some(right)) => Arc::ptr_eq(left, right),
+                (None, None) => true,
+                _ => false,
+            }
+    }
+}
+impl std::fmt::Debug for NativeAuthCacheObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeAuthCacheObservation")
+            .finish_non_exhaustive()
+    }
+}
+impl NativeAuthCacheObservation {
+    /// Frozen native credential value. Reading it grants no authority to use
+    /// credentials; any network use requires a separate effect grant and a
+    /// freshness check before and after the operation.
+    pub fn auth(&self) -> Option<&CodexAuth> {
+        self.auth.as_ref()
+    }
+    pub fn auth_mode(&self) -> Option<AuthMode> {
+        self.auth.as_ref().map(CodexAuth::auth_mode)
+    }
+    pub fn is_current(&self, manager: &AuthManager) -> bool {
+        manager
+            .native_cached_observation()
+            .is_ok_and(|fresh| fresh == *self)
+    }
+}
+fn unavailable() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::WouldBlock,
+        "native cached auth observation unavailable",
+    )
+}
+
+impl AuthManager {
+    /// Samples only applied native state. No storage, keyring, callback, token
+    /// refresh, login, network or provider startup is performed.
+    pub fn native_cached_observation(&self) -> io::Result<NativeAuthCacheObservation> {
+        let cached = self.inner.try_read().map_err(|_| unavailable())?;
+        if cached.native_observation.pending_changes != Some(0)
+            || cached.permanent_refresh_failure.is_some()
+        {
+            return Err(unavailable());
+        }
+        let external = self.external_auth.try_read().map_err(|_| unavailable())?;
+        let mut auth = cached.auth.clone();
+        let shared_json = if let Some(state) = auth.as_mut().and_then(|auth| match auth {
+            CodexAuth::Chatgpt(auth) => Some(&mut auth.state),
+            CodexAuth::ChatgptAuthTokens(auth) => Some(&mut auth.state),
+            _ => None,
+        }) {
+            let (json, revision) = {
+                let json = state.auth_dot_json.try_lock().map_err(|_| unavailable())?;
+                let revision = state
+                    .native_revision
+                    .try_lock()
+                    .map_err(|_| unavailable())?;
+                (json.clone(), Arc::clone(&revision))
+            };
+            let observed = SharedJsonObservation {
+                owner: Arc::clone(&state.auth_dot_json),
+                revision,
+            };
+            // The normal identity helpers may lock the supplied credential. Give
+            // them a detached immutable snapshot, never the live shared mutex.
+            state.auth_dot_json = Arc::new(Mutex::new(json));
+            state.native_revision = Arc::new(Mutex::new(Arc::new(())));
+            Some(observed)
+        } else {
+            None
+        };
+        Ok(NativeAuthCacheObservation {
+            owner: Arc::clone(&cached.native_observation.owner),
+            revision: Arc::clone(&cached.native_observation.revision),
+            external: external.clone(),
+            shared_json,
+            auth,
+        })
+    }
+    /// A reload may leave the applied cache unchanged. Block observations while
+    /// it runs, and invalidate on cancellation or any unsuccessful completion.
+    pub(super) fn begin_native_auth_reload(&self) -> NativeAuthReload<'_> {
+        let mut cached = self
+            .inner
+            .write()
+            .unwrap_or_else(|error| error.into_inner());
+        cached.native_observation.pending_changes = cached
+            .native_observation
+            .pending_changes
+            .and_then(|value| value.checked_add(1));
+        NativeAuthReload {
+            manager: self,
+            completed: false,
+        }
+    }
+    pub(super) fn begin_native_auth_source_change(&self) -> NativeAuthSourceChange<'_> {
+        let mut cached = self
+            .inner
+            .write()
+            .unwrap_or_else(|error| error.into_inner());
+        cached.native_observation.pending_changes = cached
+            .native_observation
+            .pending_changes
+            .and_then(|value| value.checked_add(1));
+        cached.native_observation.change();
+        NativeAuthSourceChange(self)
+    }
+}
+
+// Actual cache changes advance the revision when published. A completed
+// no-op reload therefore preserves observations; cancellation remains invalidating.
+pub(super) struct NativeAuthReload<'a> {
+    manager: &'a AuthManager,
+    completed: bool,
+}
+impl NativeAuthReload<'_> {
+    pub(super) fn complete(&mut self) {
+        self.completed = true;
+    }
+}
+impl Drop for NativeAuthReload<'_> {
+    fn drop(&mut self) {
+        let mut cached = self
+            .manager
+            .inner
+            .write()
+            .unwrap_or_else(|error| error.into_inner());
+        cached.native_observation.pending_changes = cached
+            .native_observation
+            .pending_changes
+            .and_then(|value| value.checked_sub(1));
+        if !self.completed {
+            cached.native_observation.change();
+        }
+    }
+}
+
+// Ordinary auth changes span awaits and several native locks. Refuse
+// preparation until completion/cancellation and retain a changed token afterward.
+pub(super) struct NativeAuthSourceChange<'a>(&'a AuthManager);
+impl Drop for NativeAuthSourceChange<'_> {
+    fn drop(&mut self) {
+        let mut cached = self
+            .0
+            .inner
+            .write()
+            .unwrap_or_else(|error| error.into_inner());
+        cached.native_observation.pending_changes = cached
+            .native_observation
+            .pending_changes
+            .and_then(|value| value.checked_sub(1));
+        cached.native_observation.change();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_auth_observation_binds_owner_and_refuses_credential_aba() {
+        let manager = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("fixture-a"));
+        let observed = manager.native_cached_observation().unwrap();
+        assert!(observed.is_current(&manager));
+        let foreign = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("fixture-a"));
+        assert!(!observed.is_current(&foreign));
+        for key in ["fixture-b", "fixture-a"] {
+            manager.set_cached_auth(Some(CodexAuth::from_api_key(key)));
+        }
+        assert!(!observed.is_current(&manager));
+        assert_eq!(observed.auth().unwrap().api_key(), Some("fixture-a"));
+    }
+    #[test]
+    fn native_auth_observation_preserves_noop_and_absent_cache() {
+        for auth in [None, Some(CodexAuth::from_api_key("fixture-a"))] {
+            let manager = AuthManager::from_optional_auth_for_testing(auth.clone());
+            let observed = manager.native_cached_observation().unwrap();
+            manager.set_cached_auth(auth);
+            assert!(observed.is_current(&manager));
+        }
+    }
+    #[test]
+    fn native_auth_observation_refuses_invalidated_pending_reads() {
+        let manager = AuthManager::from_optional_auth_for_testing(None);
+        let observed = manager.native_cached_observation().unwrap();
+        manager.invalidate_pending_auth_reads();
+        assert!(!observed.is_current(&manager));
+    }
+    #[test]
+    fn native_auth_reload_blocks_pending_and_preserves_only_completed_noop() {
+        let manager = AuthManager::from_optional_auth_for_testing(None);
+        let before = manager.native_cached_observation().unwrap();
+        let mut reload = manager.begin_native_auth_reload();
+        assert!(manager.native_cached_observation().is_err());
+        reload.complete();
+        drop(reload);
+        assert!(before.is_current(&manager));
+        let interrupted = manager.begin_native_auth_reload();
+        assert!(manager.native_cached_observation().is_err());
+        drop(interrupted);
+        assert!(!before.is_current(&manager));
+        let changed = manager.native_cached_observation().unwrap();
+        let mut reload = manager.begin_native_auth_reload();
+        manager.set_cached_auth(Some(CodexAuth::from_api_key("fixture-b")));
+        reload.complete();
+        drop(reload);
+        assert!(!changed.is_current(&manager));
+    }
+    #[test]
+    fn native_auth_observation_refuses_nested_source_changes_and_counter_exhaustion() {
+        let manager = AuthManager::from_optional_auth_for_testing(None);
+        let observed = manager.native_cached_observation().unwrap();
+        let first = manager.begin_native_auth_source_change();
+        let second = manager.begin_native_auth_source_change();
+        assert!(manager.native_cached_observation().is_err());
+        drop(first);
+        assert!(manager.native_cached_observation().is_err());
+        drop(second);
+        assert!(manager.native_cached_observation().is_ok());
+        assert!(!observed.is_current(&manager));
+        manager
+            .inner
+            .write()
+            .unwrap()
+            .native_observation
+            .pending_changes = Some(usize::MAX);
+        drop(manager.begin_native_auth_source_change());
+        manager.set_cached_auth(Some(CodexAuth::from_api_key("fixture-b")));
+        assert_eq!(manager.auth_cached().unwrap().api_key(), Some("fixture-b"));
+        assert!(manager.native_cached_observation().is_err());
+    }
+    #[test]
+    fn native_auth_observation_refuses_busy_native_locks_without_waiting() {
+        let manager =
+            AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+        let cached = manager.inner.write().unwrap();
+        assert!(manager.native_cached_observation().is_err());
+        drop(cached);
+        let external = manager.external_auth.write().unwrap();
+        assert!(manager.native_cached_observation().is_err());
+        drop(external);
+        let auth = manager.auth_cached().unwrap();
+        let CodexAuth::Chatgpt(auth) = auth else {
+            panic!("fixture")
+        };
+        let json = auth.state.auth_dot_json.lock().unwrap();
+        assert!(manager.native_cached_observation().is_err());
+        drop(json);
+        let revision = auth.state.native_revision.lock().unwrap();
+        assert!(manager.native_cached_observation().is_err());
+        drop(revision);
+        assert!(manager.native_cached_observation().is_ok());
+    }
+    #[test]
+    fn native_auth_observation_refuses_poison_without_panicking() {
+        for which in 0..4 {
+            let manager = AuthManager::from_auth_for_testing(
+                CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            );
+            let auth = manager.auth_cached().unwrap();
+            let CodexAuth::Chatgpt(auth) = auth else {
