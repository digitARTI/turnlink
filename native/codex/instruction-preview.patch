+    let source = MockServer::start().await;
+    let target = MockServer::start().await;
+    let enabled = Arc::new(AtomicBool::new(true));
+    let unauthorized = Arc::new(AtomicBool::new(false));
+    Mock::given(method("GET")).and(path("/backend-api/wham/settings/user"))
+        .respond_with({
+            let enabled = enabled.clone();
+            let unauthorized = unauthorized.clone();
+            move |_: &wiremock::Request| {
+                if unauthorized.load(Ordering::SeqCst) { return ResponseTemplate::new(401); }
+                ResponseTemplate::new(200)
+                    .set_body_json(serde_json::json!({"commit_attribution_enabled": enabled.load(Ordering::SeqCst)}))
+            }
+        }).expect(4).mount(&target).await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(500))
+        .expect(0)
+        .mount(&source)
+        .await;
+    let extension = GitAttributionExtension {
+        auth_manager: enterprise_auth_manager(),
+        base_url: format!("{}/backend-api", source.uri()),
+        http_client_factory: http_client_factory(),
+    };
+    let (_home, step) = target_step(format!("{}/backend-api", target.uri())).await;
+    prepare_target(&extension, &step).await;
+    assert!(step.get::<NativeTargetGitAttribution>().unwrap().enabled);
+    let session = ExtensionData::new("session");
+    let thread = ExtensionData::new("thread");
+    let turn = ExtensionData::new("turn");
+    thread.insert(super::policy::GitAttributionPolicy {
+        auth_generation: 0,
+        enabled: false,
+    });
+    let target_context = step.get::<NativeTargetToolContext>().unwrap();
+    let model =
+        codex_core::test_support::construct_model_info_offline("fixture", &target_context.config);
+    let sections = extension
+        .contribute_world_state(WorldStateContributionInput {
+            thread_id: codex_protocol::ThreadId::new(),
+            turn_id: "target",
+            model_info: &model,
+            environments: &[],
+            extension_metrics: None,
+            session_store: &session,
+            thread_store: &thread,
+            turn_store: &turn,
+            step_store: &step,
+            previous_world_state: None,
+        })
+        .await;
+    assert_eq!(sections.len(), 1);
+    assert_eq!(
+        sections[0].render_diff(PreviousWorldStateSection::Absent).0,
+        Some(serde_json::json!(true))
+    );
+    assert_eq!(extension.native_target_step_current(&step), Some(true));
+    assert!(
+        extension
+            .native_target_step_revalidate(&step)
+            .unwrap()
+            .await
+    );
+    enabled.store(false, Ordering::SeqCst);
+    assert!(
+        !extension
+            .native_target_step_revalidate(&step)
+            .unwrap()
+            .await
+    );
+    unauthorized.store(true, Ordering::SeqCst);
+    prepare_target(&extension, &step).await;
+    assert_eq!(extension.native_target_step_current(&step), Some(false));
+    source.verify().await;
+    target.verify().await;
+}
