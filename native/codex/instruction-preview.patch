+/// Recognizes the built-in prompt contributor without invoking it.
+pub fn native_is_prompt_contributor(contributor: &dyn ContextContributor) -> bool {
+    (contributor as &dyn std::any::Any).is::<HistoryNotesExtension>()
+}
+
+/// Observes applied native tool metadata without preparation callbacks or I/O.
+/// Unknown concrete contributors are not invoked. This is not destination freshness.
+pub fn preview_tools(
+    contributor: &dyn codex_extension_api::ToolContributor,
+    session_store: &ExtensionData,
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+) -> codex_extension_api::NativeToolPreparation {
+    let native = (contributor as &dyn std::any::Any).downcast_ref::<HistoryNotesExtension>()?;
+    if thread_store.get::<HistoryNotesAgentIdentity>().is_none() {
+        return Some(Err("native history identity is not initialized"));
+    }
+    if thread_store.get::<HistoryNotesExtensionConfig>().is_none() {
+        return Some(
+            if thread_store.get::<HistoryNotesToolsDisabled>().is_some() {
+                Ok(Vec::new())
+            } else {
+                Err("native history configuration is not initialized")
+            },
+        );
+    }
+    Some(Ok(native
+        .tools_for_step(session_store, thread_store, step_store)
+        .iter()
+        .map(|tool| codex_extension_api::PreparedExtensionTool::capture(tool.as_ref()))
+        .collect()))
+}
