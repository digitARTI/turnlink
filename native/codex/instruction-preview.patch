+#[cfg(all(debug_assertions, unix))]
+fn checkpoint_read_private_file(path: &Path, max: u64) -> CodexResult<Vec<u8>> {
+    use std::os::unix::fs::OpenOptionsExt;
+    let metadata = fs::symlink_metadata(path).map_err(|_| refused())?;
+    if metadata.len() == 0 || metadata.len() > max || !journal_metadata_matches(&metadata, &metadata) { return Err(refused()); }
+    let mut file = fs::OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(path).map_err(|_| refused())?;
+    if !journal_metadata_matches(&metadata, &file.metadata().map_err(|_| refused())?) { return Err(refused()); }
+    let mut bytes = Vec::new();
+    (&mut file).take(max + 1).read_to_end(&mut bytes).map_err(|_| refused())?;
+    if bytes.len() as u64 != metadata.len() || !journal_metadata_matches(&metadata, &file.metadata().map_err(|_| refused())?)
+        || !journal_metadata_matches(&metadata, &fs::symlink_metadata(path).map_err(|_| refused())?) { return Err(refused()); }
+    Ok(bytes)
+}
