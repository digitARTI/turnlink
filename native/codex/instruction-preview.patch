+use super::*;
+use codex_exec_server::LOCAL_FS;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+struct StreamSource {
+    chunks: Vec<Result<bytes::Bytes, io::ErrorKind>>,
+    open_error: Option<io::ErrorKind>,
+    pending: bool,
+    metadata_error: Option<io::ErrorKind>,
+    directory_entries: Option<Vec<ReadDirectoryEntry>>,
+    directory_calls: AtomicUsize,
+    opens: AtomicUsize,
+}
+impl StreamSource {
+    fn bytes(value: impl Into<bytes::Bytes>) -> Self {
+        Self {
+            chunks: value
+                .into()
+                .chunks(FILE_READ_CHUNK_SIZE)
+                .map(|chunk| Ok(bytes::Bytes::copy_from_slice(chunk)))
+                .collect(),
+            open_error: None,
+            pending: false,
+            metadata_error: None,
+            directory_entries: None,
+            directory_calls: AtomicUsize::new(0),
+            opens: AtomicUsize::new(0),
+        }
+    }
+}
+impl ExecutorFileSystem for StreamSource {
+    fn read_directory_bounded<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _limits: DirectoryReadLimits,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        Box::pin(async move {
+            let Some(mut entries) = self.directory_entries.clone() else {
+                return Err(io::ErrorKind::Unsupported.into());
+            };
+            if self.pending {
+                return futures::future::pending().await;
+            }
+            if self.directory_calls.fetch_add(1, Ordering::SeqCst) % 2 == 0 {
+                entries.reverse();
+            }
+            Ok(entries)
+        })
+    }
+    fn read_file_stream<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> {
+        Box::pin(async move {
+            self.opens.fetch_add(1, Ordering::SeqCst);
+            if let Some(kind) = self.open_error {
+                return Err(kind.into());
+            }
+            if self.pending {
+                return Ok(FileSystemReadStream::new(futures::stream::pending()));
+            }
+            Ok(FileSystemReadStream::new(futures::stream::iter(
+                self.chunks
+                    .clone()
+                    .into_iter()
+                    .map(|value| value.map_err(io::Error::from)),
+            )))
+        })
+    }
+    fn read_file<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: ReadFileOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        panic!("preparation must not use the unbounded whole-file transport")
+    }
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        LOCAL_FS.canonicalize(path, sandbox)
+    }
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        Box::pin(async move {
+            if let Some(kind) = self.metadata_error {
+                return Err(kind.into());
+            }
+            LOCAL_FS.get_metadata(path, options, sandbox).await
+        })
+    }
+    fn read_directory<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        panic!("unbounded directory delegation")
+    }
+    fn walk<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: WalkOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, WalkOutcome> {
+        panic!("walk delegation")
+    }
+    fn write_file<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _contents: Vec<u8>,
+        _options: WriteFileOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        panic!("write delegation")
+    }
+    fn create_directory<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: CreateDirectoryOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        panic!("mkdir delegation")
+    }
+    fn remove<'a>(
+        &'a self,
+        _path: &'a PathUri,
+        _options: RemoveOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        panic!("remove delegation")
+    }
+    fn copy<'a>(
+        &'a self,
+        _source: &'a PathUri,
+        _destination: &'a PathUri,
+        _options: CopyOptions,
+        _sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        panic!("copy delegation")
+    }
+}
