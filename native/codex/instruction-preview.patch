+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_config::{ConfigLayerStack, Constrained};
+
+    #[tokio::test]
+    async fn native_config_recipes_distinguish_equal_effective_values() {
+        let home = tempfile::tempdir().unwrap();
+        let config = crate::config::ConfigBuilder::default()
+            .codex_home(home.path().to_path_buf()).build().await.unwrap();
+        let first = NativeConfigConstraintBindings::capture(&config).native_recipes(&config).unwrap();
+        let mut changed = config.clone();
+        let mut requirements = config.config_layer_stack.requirements().clone();
+        requirements.approval_policy.value = Constrained::allow_only(requirements.approval_policy.value.value());
+        assert_eq!(requirements, *config.config_layer_stack.requirements());
+        changed.config_layer_stack = ConfigLayerStack::new(
+            config.config_layer_stack.layers_low_to_high().cloned().collect(),
+            requirements, config.config_layer_stack.requirements_toml().clone(),
+        ).unwrap();
+        let second = NativeConfigConstraintBindings::capture(&changed).native_recipes(&changed).unwrap();
+        assert_ne!(first, second, "equal selected values must not conceal different rules");
+        assert_eq!(first["requirements"]["approval"]["rule"], "allow_any");
+        assert_eq!(second["requirements"]["approval"]["rule"], "allow_only");
+    }
+
+    #[tokio::test]
+    async fn native_constructor_requirement_bindings_reject_equal_value_replacement() {
+        let home = tempfile::tempdir().unwrap();
+        let config = crate::config::ConfigBuilder::default()
+            .codex_home(home.path().to_path_buf())
+            .build()
+            .await
+            .unwrap();
+        let bindings = NativeConfigConstraintBindings::capture(&config);
+        assert!(bindings.matches(&config));
+        for field in 0..6 {
+            let mut changed = config.clone();
+            let mut requirements = config.config_layer_stack.requirements().clone();
+            match field {
+                0 => {
+                    requirements.approval_policy.value =
+                        Constrained::allow_any(requirements.approval_policy.value.value())
+                }
+                1 => {
+                    requirements.approvals_reviewer.value =
+                        Constrained::allow_any(requirements.approvals_reviewer.value.value())
+                }
+                2 => {
+                    requirements.permission_profile.value =
+                        Constrained::allow_any(requirements.permission_profile.value.get().clone())
+                }
+                3 => {
+                    requirements.windows_sandbox_mode.value =
+                        Constrained::allow_any(requirements.windows_sandbox_mode.value.value())
+                }
+                4 => {
+                    requirements.web_search_mode.value =
+                        Constrained::allow_any(requirements.web_search_mode.value.value())
+                }
+                _ => {
+                    requirements.enforce_residency.value =
+                        Constrained::allow_any(requirements.enforce_residency.value.value())
+                }
+            }
+            assert_eq!(requirements, *config.config_layer_stack.requirements());
+            changed.config_layer_stack = ConfigLayerStack::new(
+                config
+                    .config_layer_stack
+                    .layers_low_to_high()
+                    .cloned()
+                    .collect(),
+                requirements,
+                config.config_layer_stack.requirements_toml().clone(),
+            )
+            .unwrap();
+            assert!(
+                !bindings.matches(&changed),
+                "requirement enforcer {field} was replaced"
+            );
+        }
+    }
+}
