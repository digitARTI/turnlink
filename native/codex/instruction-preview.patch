+async fn provider_legacy_commit_refused(
+    tx: &async_channel::Sender<Submission>,
+    owner: &ContinuityOwner,
+    reservation: &ContinuityReservation,
+    cwd: codex_utils_absolute_path::AbsolutePathBuf,
+) -> bool {
+    let (reply, accepted) = oneshot::channel();
+    submit(
+        tx,
+        Op::ContinuityCommit {
+            owner: owner.clone(),
+            reservation: reservation.clone(),
+            transition_id: uuid::Uuid::new_v4(),
+            cwd,
+            reply,
+        },
+    )
+    .await;
+    accepted.await.expect("queued native commit reply").is_err()
+}
