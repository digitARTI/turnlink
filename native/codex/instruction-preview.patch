+    /// The private host freshly authorizes stopping this exact owned runtime.
+    /// The result is tracked quiescence only and cannot release a broker hold.
+    pub(crate) fn continuity_quiesce_mcp<'a>(
+        self: &'a Arc<Self>,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        shutdown_id: uuid::Uuid,
+        resource: codex_protocol::protocol::ContinuityMcpReceipt,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityMcpQuiescence>,
+    > {
+        async move {
+            let path = self.continuity_receipt_path().await;
+            let startup = {
+                let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+                let mut state = self.state.lock().await;
+                state
+                    .continuity
+                    .check_owner_and_source(owner, reservation)?;
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                if !["acquired", "provider_constructed", "mcp_plan_held"]
+                    .contains(&held.journal.phase.as_str())
+                    || !held.step_allows_resource_cleanup()
+                    || held.journal.mcp_receipt.as_ref() != Some(&resource)
+                    || resource.phase != "constructed"
+                    || resource.reservation != *reservation
+                    || held
+                        .journal
+                        .mcp_grant
+                        .as_ref()
+                        .is_none_or(|grant| grant.id != resource.transition_id)
+                {
+                    return Err(refused());
+                }
+                if let Some(previous) = &held.journal.mcp_quiescence {
+                    if previous.shutdown_id != shutdown_id || previous.resource != resource {
+                        return Err(refused());
+                    }
+                    if !held
+                        .mcp_quiescence_exclusion
+                        .as_ref()
+                        .is_some_and(|guard| guard.is_current())
+                    {
+                        held.invalidate();
+                        held.journal.phase = "uncertain".into();
+                        let _ = write_journal(&path, &held.journal);
+                        return Err(refused());
+                    }
+                    return Ok(previous.clone());
+                }
+                if held.journal.mcp_shutdown_id.is_some()
+                    || held.journal.mcp_shutdown_status.is_some()
+                {
+                    return Err(refused());
+                }
+                let startup = held.mcp_startup.clone().ok_or_else(refused)?;
+                if startup.state() != codex_mcp::NativeMcpStartupState::Published {
+                    return Err(refused());
+                }
+                if held
+                    .mcp_binding
+                    .as_ref()
+                    .is_some_and(|binding| Arc::strong_count(binding) != 1)
+                {
+                    return Err(refused());
+                }
+                if held
+                    .mcp_skills
+                    .as_ref()
+                    .is_some_and(|skills| Arc::strong_count(skills) != 1)
+                {
+                    return Err(refused());
+                }
+                if held
+                    .mcp_plugins
+                    .as_ref()
+                    .is_some_and(|plugins| Arc::strong_count(plugins) != 1)
+                {
+                    return Err(refused());
+                }
+                if held.journal.schema < 6 {
+                    held.journal.schema = if held.journal.step.is_some() { 5 } else { 4 };
+                }
+                held.journal.mcp_shutdown_id = Some(shutdown_id);
+                held.journal.mcp_shutdown_status = Some("pending".into());
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                held.mcp_binding = None;
+                held.mcp_plugins = None;
+                held.mcp_skills = None;
+                startup
+            };
+            let session = Arc::clone(self);
+            let owner = owner.clone();
+            let reservation = reservation.clone();
+            tokio::spawn(async move {
+                let successful = startup.runtime().shutdown_with_outcome().await;
+                let _settings = super::thread_settings::acquire_persistence_lock(&session).await;
+                let mut state = session.state.lock().await;
+                let valid = state.continuity.check(&owner, &reservation).is_ok();
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                let target_exclusion = if successful && valid {
+                    held._mcp_requests.as_ref().and_then(|source_exclusion| {
+                        startup
+                            .runtime()
+                            .try_native_runtime_request_exclusion(Arc::clone(source_exclusion))
+                            .ok()
+                    })
+                } else {
+                    None
+                };
+                if !valid
+                    || !successful
+                    || !target_exclusion
+                        .as_ref()
+                        .is_some_and(|guard| guard.is_current())
+                    || held.journal.mcp_shutdown_id != Some(shutdown_id)
+                    || held.journal.mcp_receipt.as_ref() != Some(&resource)
+                    || !held
+                        .mcp_startup
+                        .as_ref()
+                        .is_some_and(|current| Arc::ptr_eq(current, &startup))
+                {
+                    held.invalidate();
+                    held.journal.phase = "uncertain".into();
+                    held.journal.mcp_shutdown_status = Some("uncertain".into());
+                    let _ = write_journal(&path, &held.journal);
+                    return Err(refused());
+                }
+                let receipt = codex_protocol::protocol::ContinuityMcpQuiescence {
+                    shutdown_id,
+                    resource,
+                    status: "quiesced".into(),
+                };
+                held.journal.mcp_shutdown_status = Some("quiesced".into());
+                held.journal.mcp_quiescence = Some(receipt.clone());
+                held.mcp_quiescence_exclusion = target_exclusion;
+                if write_journal(&path, &held.journal).is_err()
+                    || !owner.is_open()
+                    || !held
+                        .mcp_quiescence_exclusion
+                        .as_ref()
+                        .is_some_and(|guard| guard.is_current())
+                {
+                    held.invalidate();
+                    held.journal.phase = "uncertain".into();
+                    let _ = write_journal(&path, &held.journal);
+                    return Err(refused());
+                }
+                Ok(receipt)
+            })
+            .await
+            .map_err(|_| refused())?
+        }
+        .boxed()
+    }
