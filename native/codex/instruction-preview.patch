+#[tokio::test]
+async fn native_preparation_fs_binds_known_absence_and_rejects_uncertainty() -> io::Result<()> {
+    let mut absent = StreamSource::bytes("");
+    absent.open_error = Some(io::ErrorKind::NotFound);
+    let fs = NativePreparationFileSystem::new(&absent);
+    let path = virtual_path();
+    assert_eq!(
+        fs.read_file(&path, Default::default(), None)
+            .await
+            .unwrap_err()
+            .kind(),
+        io::ErrorKind::NotFound
+    );
+    let inputs = fs.finish()?;
+    assert!(inputs.revalidate(&absent).await?);
+    assert!(!inputs.revalidate(&StreamSource::bytes("")).await?);
+    let mut denied = StreamSource::bytes("");
+    denied.open_error = Some(io::ErrorKind::PermissionDenied);
+    assert!(inputs.revalidate(&denied).await.is_err());
+    let fs = NativePreparationFileSystem::new(&denied);
+    // Ordinary callers may swallow this error; final capture still refuses.
+    let _ = fs.read_file(&path, Default::default(), None).await;
+    assert!(fs.finish().is_err());
+    Ok(())
+}
