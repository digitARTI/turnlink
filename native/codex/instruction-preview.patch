+
+fn native_detached_skill_step_ready_with_input(
+    step_store: &ExtensionData,
+    lease: Option<&NativeSkillInputLease>,
+) -> bool {
+    let Some(detached) = step_store.native_try_get::<NativeDetachedSkillStep>() else {
+        return false;
+    };
+    let state = detached
+        .input_gate
+        .load(std::sync::atomic::Ordering::SeqCst);
+    let gate_ready = match lease {
+        Some(lease) => {
+            Arc::ptr_eq(&detached.input_gate, &lease.gate)
+                && !lease.complete
+                && state == INPUT_ACTIVE
+        }
+        None => state == INPUT_IDLE || state == INPUT_COMPLETE,
+    };
+    gate_ready
+        && detached.diagnostics.available()
+        && detached.pending_shadow.try_lock().is_ok()
+        && step_store.native_try_get::<NativeSkillPrepared>().is_some()
+        && step_store.native_try_get::<SkillsStepState>().is_some()
+        && step_store
+            .native_try_get::<NativeSkillThreadPrompt>()
+            .is_some_and(|prompt| {
+                prompt.witness.as_ref().is_none_or(|witness| witness())
+                    && detached
+                        .state
+                        .native_config_witness_current(&prompt.config, &prompt.generation)
+            })
+}
