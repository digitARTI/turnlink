+    /// Correlate the exact persisted publication with its host reservation,
+    /// movement and retained step. This is historical evidence only.
+    pub(crate) async fn continuity_observe_restored_publication_exact(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        operation_id: uuid::Uuid,
+        movement_id: uuid::Uuid,
+        step_id: uuid::Uuid,
+    ) -> CodexResult<(String, bool)> {
+        let observed = self.continuity_observe_restored_publication(owner, operation_id).await?;
+        let path = self.continuity_receipt_path().await;
+        let state = self.state.lock().await;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let journal = &held.journal;
+        let publication = journal.publication.as_ref().ok_or_else(refused)?;
+        let persisted = read_journal(&path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if !owner.is_open() || !held.invalid || held.owner.is_open() || held.original.is_some()
+            || held.reservation != *reservation || journal.reservation != *reservation
+            || publication.operation_id != operation_id || publication.movement_id != movement_id
+            || publication.step_id != step_id
+            || journal.host_grant.as_ref().map(|grant| grant.id) != Some(movement_id)
+            || journal.step.as_ref().and_then(|step| step.receipt.as_ref()).map(|receipt| receipt.step_id) != Some(step_id)
+            || !["pending", "uncertain", "installed"].contains(&publication.status.as_str())
+            || serde_json::to_vec(&persisted).map_err(|_| refused())? != serde_json::to_vec(journal).map_err(|_| refused())?
+            || publication.status == "installed" && !observed
+        { return Err(refused()); }
+        Ok((publication.status.clone(), observed))
+    }
