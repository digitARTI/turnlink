+    fn native_auth_observation_refuses_permanent_failure_and_stale_failure_does_not_retag() {
+        let auth = CodexAuth::from_api_key("fixture-a");
+        let manager = AuthManager::from_auth_for_testing(auth.clone());
+        let observed = manager.native_cached_observation().unwrap();
+        let error = RefreshTokenFailedError::new(RefreshTokenFailedReason::Other, "fixture");
