+                        && prepared
+                            .target
+                            .upgrade()
+                            .is_some_and(|captured| Arc::ptr_eq(&captured, &target))
+                        && step_store
+                            .native_try_get::<codex_core::NativeTargetToolContext>()
+                            .is_some_and(|current| Arc::ptr_eq(&current, &target))
+                }),
+        )
