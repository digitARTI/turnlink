+impl NativeProviderPreparation {
+    /// Explicit construction, deliberately separate from read-only preparation.
+    /// Uses the same native factory and its original account input, never the
+    /// source provider's command-auth wrapper. This does not resolve credentials,
+    /// refresh accounts, fetch models, install settings or publish the provider.
+    pub fn construct_destination(
+        self,
+        source: &SharedModelProvider,
+        destination_definitions: &HashMap<String, ModelProviderInfo>,
+        required_destination_id: Option<&str>,
+    ) -> Result<NativeConstructedProvider, CodexErr> {
+        if !self.revalidate(source, destination_definitions, required_destination_id)? {
+            return Err(unavailable());
+        }
+        let provider = create_model_provider(
+            self.destination_definition.clone(),
+            native_base_auth(source)?,
+        );
+        // The ordinary infallible factory defers gateway setup errors until use.
+        // Do not disguise an already-known construction error as a usable result.
+        let concrete: &dyn Any = provider.as_ref();
+        if concrete
+            .downcast_ref::<ConfiguredModelProvider>()
+            .is_some_and(|native| {
+                native
+                    .gateway_auth_manager
+                    .as_ref()
+                    .is_some_and(Result::is_err)
+            })
+        {
+            return Err(unavailable());
+        }
+        let (_, manager) = native_source(&provider)?;
+        let auth = manager
+            .as_ref()
+            .map(|manager| manager.native_cached_observation())
+            .transpose()?;
+        let constructed = NativeConstructedProvider {
+            preparation: self,
+            provider,
+            auth,
+            exposed: std::sync::atomic::AtomicBool::new(false),
+            handle_exposed: std::sync::atomic::AtomicBool::new(false),
+            completed_catalog_reconcilable: false,
+            model_context: None,
+        };
+        // Native factory setup can touch process-shared state. Recheck source
+        // and newly-owned auth observations after that effect, before returning.
+        if !constructed.revalidate(source, destination_definitions, required_destination_id)? {
+            return Err(unavailable());
+        }
+        Ok(constructed)
+    }
+}
+impl NativeConstructedProvider {
+    fn publication_current(
+        &self,
+        source: &SharedModelProvider,
+        definitions: &HashMap<String, ModelProviderInfo>,
+        required_id: Option<&str>,
+    ) -> bool {
+        let Some(context) = self.model_context.as_ref() else {
+            return false;
+        };
+        !self.handle_exposed.load(std::sync::atomic::Ordering::Acquire)
+            && Arc::strong_count(&self.provider) == 1
+            && Arc::weak_count(&self.provider) == 0
+            // The context and its metadata observation each own one alias.
+            && context.metadata.is_some()
+            && Arc::strong_count(&context.manager) == 2
+            && Arc::weak_count(&context.manager) == 0
+            && self.revalidate(source, definitions, required_id).unwrap_or(false)
+            && (context.catalog.is_none() || self.catalog_context_is_current().unwrap_or(false))
+    }
+
+    /// Builds the target provider's ordinary native manager, including its cache
+    /// configuration and provider-specific catalog normalization. This method
+    /// starts no refresh, credential resolution/helper, disk I/O or network work.
+    /// The private host must have approved this distinct model-context plan.
+    /// Ownership is retained even when metadata observation fails.
+    pub fn construct_model_context(
+        &mut self,
+        codex_home: std::path::PathBuf,
+        config_model_catalog: Option<codex_protocol::openai_models::ModelsResponse>,
+        api_key_discovery: bool,
+        model: &str,
+        config: codex_models_manager::ModelsManagerConfig,
+    ) -> Result<(), CodexErr> {
+        if self.model_context.is_some() || self.exposed.load(std::sync::atomic::Ordering::Acquire) {
+            return Err(unavailable());
+        }
+        // Refuse unknown implementations before calling any trait factory.
+        native_source(&self.provider)?;
+        let manager = self
+            .provider
+            .models_manager(codex_home, config_model_catalog);
+        manager.set_api_key_model_discovery_enabled(api_key_discovery);
+        self.model_context = Some(Box::new(NativeProviderModelContext {
+            manager,
+            metadata: None,
+            config,
+            catalog: None,
+        }));
+        let context = self.model_context.as_mut().ok_or_else(unavailable)?;
+        context.metadata = Some(crate::prepare_model_metadata(
+            &context.manager,
+            model,
+            &context.config,
+        )?);
+        Ok(())
+    }
+
+    /// Explicit catalog/auth/cache effect. The owning host must first authorize
+    /// this separate scope and retain the actual resource through the full future.
+    /// Starting work permanently excludes the factory-only cleanup path; complete
+    /// used-resource reconciliation is a separate protocol, including on errors.
+    pub fn refresh_model_context_catalog(
+        &mut self,
+        http_client_factory: codex_http_client::HttpClientFactory,
+    ) -> crate::ModelProviderFuture<'_, Result<(), CodexErr>> {
+        Box::pin(async move {
+            if self.exposed.load(std::sync::atomic::Ordering::Acquire) {
+                return Err(unavailable());
+            }
+            let cleanup_auth = catalog_cleanup_auth(&self.provider).ok();
+            let context = self.model_context.as_mut().ok_or_else(unavailable)?;
+            let model = context
+                .metadata
+                .as_ref()
+                .ok_or_else(unavailable)?
+                .model_info()
+                .slug
+                .clone();
+            let concrete: &dyn Any = context.manager.as_ref();
+            let manager = concrete
+                .downcast_ref::<codex_models_manager::manager::OpenAiModelsManager>()
+                .ok_or_else(unavailable)?;
+            // Before any async credential/HTTP/cache work, retain the used-state
+            // fact even if the caller's receiver disappears or the future aborts.
+            self.exposed
+                .store(true, std::sync::atomic::Ordering::Release);
+            context.metadata = None;
+            let catalog = manager.refresh_native_catalog(http_client_factory).await?;
+            if catalog.cache_write()
+                != codex_models_manager::manager::NativeCatalogCacheWrite::Succeeded
+                || !manager.native_catalog_refresh_covers_model(&catalog, &model)
+            {
+                return Err(unavailable());
+            }
+            let metadata =
+                crate::prepare_model_metadata(&context.manager, &model, &context.config)?;
+            if metadata.model_info().used_fallback_model_metadata
+                || !manager.native_catalog_refresh_is_current(&catalog)
+            {
+                return Err(unavailable());
+            }
+            context.metadata = Some(metadata);
+            context.catalog = Some(catalog);
+            let (_, auth) = native_source(&self.provider)?;
+            self.auth = auth
+                .as_ref()
+                .map(|manager| manager.native_cached_observation())
+                .transpose()?;
+            self.completed_catalog_reconcilable = cleanup_auth
+                .as_ref()
+                .is_some_and(|observed| catalog_cleanup_auth_current(&self.provider, observed));
+            Ok(())
+        })
+    }
+
+    pub fn catalog_context_is_current(&self) -> Result<bool, CodexErr> {
+        let Some(context) = &self.model_context else {
+            return Ok(false);
+        };
+        let Some(catalog) = &context.catalog else {
+            return Ok(false);
+        };
+        let concrete: &dyn Any = context.manager.as_ref();
+        let Some(manager) =
+            concrete.downcast_ref::<codex_models_manager::manager::OpenAiModelsManager>()
+        else {
+            return Ok(false);
+        };
+        Ok(manager.native_catalog_refresh_is_current(catalog)
+            && context.metadata.as_ref().is_some_and(|metadata| {
+                metadata
+                    .revalidate(&context.manager, &context.config)
+                    .unwrap_or(false)
+            }))
+    }
+
+    /// Observed target data, not catalog freshness or executable readiness.
+    pub fn model_context_info(&self) -> Option<&codex_protocol::openai_models::ModelInfo> {
+        self.model_context
+            .as_ref()?
+            .metadata
+            .as_ref()
+            .map(crate::ModelMetadataPreparation::model_info)
+    }
+
+    /// Observe the retained target model and native provider capabilities after
+    /// checking the original source, target definition and model context. This
+    /// copies data only: it does not expose a provider handle or authorize use.
+    pub fn validated_model_inputs(
+        &self,
+        source: &SharedModelProvider,
+        destination_definitions: &HashMap<String, ModelProviderInfo>,
+        required_destination_id: Option<&str>,
+    ) -> Result<
+        Option<(
+            codex_protocol::openai_models::ModelInfo,
+            ProviderCapabilities,
+        )>,
+        CodexErr,
+    > {
+        if !self.revalidate(source, destination_definitions, required_destination_id)? {
+            return Err(unavailable());
+        }
+        let Some(model) = self.model_context_info() else {
+            return Ok(None);
+        };
+        // `revalidate` has already rejected unknown trait implementations.
+        Ok(Some((model.clone(), self.provider.capabilities())))
+    }
+
+    /// Copy the retained target provider's tool-facing properties and current
+    /// model list without exposing either live owner. Revalidate both before and
+    /// after the nonblocking observation; contention fails closed.
+    pub fn validated_tool_view(
+        &self,
+        source: &SharedModelProvider,
+        destination_definitions: &HashMap<String, ModelProviderInfo>,
+        required_destination_id: Option<&str>,
+    ) -> Result<Option<NativeToolProviderView>, CodexErr> {
+        let Some((_, capabilities)) =
+            self.validated_model_inputs(source, destination_definitions, required_destination_id)
+                .map_err(|error| { tracing::debug!(stage = "model-inputs", "native tool provider view refused"); error })?
+        else {
+            return Ok(None);
+        };
+        let context = self.model_context.as_ref().ok_or_else(unavailable)?;
+        let available_models = context
+            .manager
+            .try_list_models()
+            .map_err(|_| {
+                tracing::debug!(stage = "catalog-busy", "native tool provider view refused");
+                native_tool_catalog_busy()
+            })?;
+        let info = self.provider.info().clone();
+        if !self.revalidate(source, destination_definitions, required_destination_id)
+            .map_err(|error| { tracing::debug!(stage = "revalidate-error", "native tool provider view refused"); error })? {
+            tracing::debug!(stage = "revalidate-changed", "native tool provider view refused");
+            return Err(unavailable());
+        }
+        Ok(Some(NativeToolProviderView {
+            provider: Arc::new(NativeToolProvider { info, capabilities }),
+            available_models,
+        }))
+    }
+
+    pub fn provider(&self) -> &SharedModelProvider {
+        // Once borrowed by a consumer, this object's inner handles may have
+        // escaped even if the provider Arc itself later becomes exclusive.
+        self.exposed
+            .store(true, std::sync::atomic::Ordering::Release);
+        self.handle_exposed
+            .store(true, std::sync::atomic::Ordering::Release);
+        &self.provider
+    }
+
+    /// Release an exact completed catalog owner after its response and cache
+    /// write finished, the cache worker cut is held, and neither live provider
+    /// nor manager has escaped. Other used or uncertain providers stay held.
+    pub fn try_release_owned(mut self) -> std::result::Result<(), Self> {
+        if !self.exposed.load(std::sync::atomic::Ordering::Acquire) {
+            return self.try_release_unpublished();
+        }
+        if !self.completed_catalog_reconcilable
+            || self
+                .handle_exposed
+                .load(std::sync::atomic::Ordering::Acquire)
+            || !self.catalog_context_is_current().unwrap_or(false)
+            || Arc::get_mut(&mut self.provider).is_none()
+        {
+            return Err(self);
+        }
+        let cache_hold = match codex_models_manager::hold_native_file_cache_io() {
+            Ok(hold) => hold,
+            Err(_) => return Err(self),
+        };
+        if !self.catalog_context_is_current().unwrap_or(false) {
+            return Err(self);
+        }
+        let _cache_publication = match cache_hold.lock_for_publication() {
+            Ok(guard) => guard,
+            Err(_) => return Err(self),
+        };
+        let Some(context) = self.model_context.as_mut() else {
+            return Err(self);
+        };
+        // Our metadata observation owns exactly one manager alias. Refuse
+        // before dropping it if another strong or weak handle can still exist.
+        if context.metadata.is_none()
+            || Arc::strong_count(&context.manager) != 2
+            || Arc::weak_count(&context.manager) != 0
+        {
+            return Err(self);
+        }
+        context.metadata = None;
+        if Arc::get_mut(&mut context.manager).is_none() {
+            return Err(self);
+        }
+        drop(self);
+        Ok(())
+    }
+
+    /// Releases only this unpublished factory owner's handles, not account/global
+    /// resources shared with existing providers. No credential/model work has run
+    /// through this owner. Refusal returns ownership intact; no strong-count race
+    /// or process-death assumption can turn a shared/used provider into cleanup.
+    pub fn try_release_unpublished(mut self) -> std::result::Result<(), Self> {
+        if self.exposed.load(std::sync::atomic::Ordering::Acquire)
+            || Arc::get_mut(&mut self.provider).is_none()
+        {
+            return Err(self);
+        }
+        if let Some(context) = self.model_context.as_mut() {
+            // Remove our own observation's manager alias before the actual Arc
+            // exclusivity check. On refusal, retain every resource owner and
+            // leave metadata invalid: this is not a reusable ready context.
+            context.metadata = None;
+            if Arc::get_mut(&mut context.manager).is_none() {
+                return Err(self);
+            }
+        }
+        drop(self);
+        Ok(())
+    }
+    pub fn selected_id(&self) -> &str {
+        self.preparation.selected_id()
+    }
+    pub fn revalidate(
+        &self,
+        source: &SharedModelProvider,
+        destination_definitions: &HashMap<String, ModelProviderInfo>,
+        required_destination_id: Option<&str>,
+    ) -> Result<bool, CodexErr> {
+        if !self
+            .preparation
+            .revalidate(source, destination_definitions, required_destination_id)?
+        {
+            return Ok(false);
+        }
+        if let Some(context) = &self.model_context {
+            if !context
+                .metadata
+                .as_ref()
+                .ok_or_else(unavailable)?
+                .revalidate(&context.manager, &context.config)?
+            {
+                return Ok(false);
+            }
+        }
+        let (info, manager) = native_source(&self.provider)?;
+        if info != self.preparation.destination_definition() {
+            return Ok(false);
+        }
+        Ok(match (&self.auth, manager) {
+            (Some(observed), Some(manager)) => observed.is_current(&manager),
+            (None, None) => true,
+            _ => false,
+        })
+    }
+}
+
+impl NativeProviderPublication {
+    pub fn is_current(
+        &self,
+        source: &SharedModelProvider,
+        definitions: &HashMap<String, ModelProviderInfo>,
+        required_id: Option<&str>,
+    ) -> bool {
+        self.owner
+            .try_lock()
+            .is_ok_and(|guard| guard.publication_current(source, definitions, required_id))
+    }
+
+    /// Retain the same owner already shared by the destination step. Lock
+    /// contention or stale inputs refuse without exposing any live handle.
+    pub fn try_stage(
+        owner: Arc<tokio::sync::Mutex<NativeConstructedProvider>>,
+        source: &SharedModelProvider,
+        definitions: &HashMap<String, ModelProviderInfo>,
+        required_id: Option<&str>,
+    ) -> Result<Self, Arc<tokio::sync::Mutex<NativeConstructedProvider>>> {
+        let ready = owner
+            .try_lock()
+            .is_ok_and(|guard| guard.publication_current(source, definitions, required_id));
+        if !ready {
+            return Err(owner);
+        }
+        Ok(Self { owner })
+    }
+
+    /// Undo staging without exposing handles or discarding cleanup evidence.
+    pub fn cancel(self) -> Arc<tokio::sync::Mutex<NativeConstructedProvider>> {
+        self.owner
+    }
+
+    /// Transfer both exact owners only after the trusted host has persisted its
+    /// publication intent and established the session-level guarantees.
+    /// Revalidation and transfer have no asynchronous gap. Refusal returns
+    /// the staged owner intact for reconciliation.
+    pub fn publish(
+        self,
+        source: &SharedModelProvider,
+        definitions: &HashMap<String, ModelProviderInfo>,
+        required_id: Option<&str>,
+    ) -> Result<NativePublishedProvider, Self> {
+        self.publish_shared(source, definitions, required_id)
+            .map_err(|()| self)
+    }
+
+    /// Publish from a retained step held behind shared session ownership. The
+    /// owner lock makes this one-shot even if more than one stage exists. The
+    /// caller must already hold the full session publication barrier and its
+    /// durable intent; this operation alone does not install the provider.
+    pub fn publish_shared(
+        &self,
+        source: &SharedModelProvider,
+        definitions: &HashMap<String, ModelProviderInfo>,
+        required_id: Option<&str>,
+    ) -> Result<NativePublishedProvider, ()> {
+        let (provider, models_manager) = {
+            let Ok(owner) = self.owner.try_lock() else {
+                return Err(());
+            };
+            if !owner.publication_current(source, definitions, required_id) {
+                return Err(());
+            }
+            owner
+                .exposed
+                .store(true, std::sync::atomic::Ordering::Release);
+            owner
+                .handle_exposed
+                .store(true, std::sync::atomic::Ordering::Release);
+            (
+                Arc::clone(&owner.provider),
+                Arc::clone(
+                    &owner
+                        .model_context
+                        .as_ref()
+                        .expect("publication_current requires a model context")
+                        .manager,
+                ),
+            )
+        };
+        Ok(NativePublishedProvider {
+            provider,
+            models_manager,
+            _owner: Arc::clone(&self.owner),
+        })
+    }
+}
