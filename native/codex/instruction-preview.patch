+#[tokio::test]
+async fn native_preparation_fs_bounds_aggregate_and_repeated_reads() {
+    let source = StreamSource::bytes(vec![b'x'; MAX_BYTES / 2]);
+    let fs = NativePreparationFileSystem::new(&source);
+    let path = virtual_path();
+    assert!(fs.read_file(&path, Default::default(), None).await.is_ok());
+    assert!(fs.read_file(&path, Default::default(), None).await.is_err());
+    assert!(fs.finish().is_err());
+    let source = StreamSource::bytes(vec![b'x'; MAX_BYTES + 1]);
+    let fs = NativePreparationFileSystem::new(&source);
+    assert!(fs.read_file(&path, Default::default(), None).await.is_err());
+    assert!(fs.finish().is_err());
+}
