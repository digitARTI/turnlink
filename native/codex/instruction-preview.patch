+        startup: &codex_mcp::NativeMcpStartup,
+        source: &codex_mcp::NativeMcpRuntimeObservation,
+        source_exclusion: &Arc<codex_mcp::NativeMcpRuntimeExclusion>,
+    ) -> CodexResult<codex_mcp::NativeMcpInstalled> {
+        if !Arc::ptr_eq(startup.runtime(), &self._target.inputs.mcp_runtime) {
+            return Err(refused());
+        }
+        let exclusion = startup
+            .runtime()
+            .try_native_runtime_request_exclusion(Arc::clone(source_exclusion))
+            .map_err(|_| refused())?;
+        session
+            .services
+            .mcp_runtime
+            .native_install(source, startup, exclusion)
+            .map_err(|_| refused())
+    }
+
+    fn attachment_revisions_current(&self, session: &Session) -> bool {
+        session.continuity_attachment_revisions() == Some(self.attachment_revisions)
+            && self._target.native_attachment_revisions() == Some(self.target_attachment_revisions)
+            && self
+                ._target
+                .step_extension_data
+                .native_try_get::<crate::NativeTargetToolContext>()
+                .is_some_and(|current| Arc::ptr_eq(&current, &self.target_tool_context))
+            && self.contributor_freshness.iter().all(|current| current())
+            && session
+                .services
+                .extensions
+                .tool_contributors()
+                .iter()
+                .all(|contributor| {
+                    contributor
+                        .native_target_step_current(&self._target.step_extension_data)
+                        .is_none_or(|current| current)
+                })
+            && match &self.target_skill_policy {
+                Some(policy) => policy.is_current(&self._target.step_extension_data),
+                None => self._target.skill_policy.is_none(),
+            }
+            && match &self.target_skill_shapes {
+                Some(expected) => {
+                    codex_skills_extension::native_detached_skill_shapes(
+                        &self._target.step_extension_data,
+                    )
+                    .as_ref()
+                        == Some(expected)
+                }
+                None => self._target.skill_policy.is_none(),
+            }
+            && session.continuity_attachment_revisions() == Some(self.attachment_revisions)
+            && self._target.native_attachment_revisions() == Some(self.target_attachment_revisions)
+    }
+}
