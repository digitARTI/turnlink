+    )?;
+    let second = home.path().join("second-plugin");
+    std::fs::create_dir_all(second.join("skills/other"))?;
+    std::fs::write(
+        second.join("skills/other/SKILL.md"),
+        "---\nname: other\ndescription: fixture\n---\n\n# Other\n",
+    )?;
+    let plugin_root = AbsolutePathBuf::from_absolute_path(plugin)?;
+    let root = PluginSkillRoot {
+        path: plugin_root.join("skills"),
+        plugin_root,
+        plugin_identity: PluginIdentity {
+            plugin_id: "example@fixture".into(),
+            remote_plugin_id: None,
+        },
+        plugin_namespace: "example".into(),
+        discovery_mode: SkillDiscoveryMode::Recursive,
+    };
+    let second_root = AbsolutePathBuf::from_absolute_path(second)?;
+    let other = PluginSkillRoot {
+        path: second_root.join("skills"),
+        plugin_root: second_root,
+        plugin_identity: PluginIdentity {
+            plugin_id: "other@fixture".into(),
+            remote_plugin_id: None,
+        },
+        plugin_namespace: "other".into(),
+        discovery_mode: SkillDiscoveryMode::Recursive,
+    };
+    let stack = codex_config::ConfigLayerStack::new(
+        vec![codex_config::ConfigLayerEntry::new(
+            codex_config::ConfigLayerSource::SessionFlags,
+            toml::from_str("[skills.bundled]\nenabled = false\n").unwrap(),
+        )],
+        Default::default(),
+        Default::default(),
+    )
+    .map_err(io::Error::other)?;
+    let input = HostSkillsLoadInput::new(
+        AbsolutePathBuf::from_absolute_path(home.path())?,
+        vec![root, other],
+        stack,
+    );
+    let service = HostSkillsService::new(AbsolutePathBuf::from_absolute_path(home.path())?, false);
+    let fs = NativePreparationFileSystem::new_shared(Arc::clone(&LOCAL_FS));
+    let selected: Arc<dyn ExecutorFileSystem> = fs.clone();
+    let snapshot = service
+        .native_prepare_for_config(&input, None, selected, false)
+        .await?;
+    assert_eq!(snapshot.outcome().skills.len(), 2);
+    let captured = snapshot.native_capture_texts().await?;
+    let mut captured_texts = Vec::new();
+    for skill in &snapshot.outcome().skills {
+        captured_texts.push((skill.clone(), captured.read_skill_text(skill).await?));
+    }
+    let observed = fs.seal().await?;
+    assert!(observed.revalidate(LOCAL_FS.as_ref()).await?);
+    assert!(
+        snapshot
+            .read_skill_text(&snapshot.outcome().skills[0])
+            .await
+            .is_err(),
+        "sealed preparation cannot be used as a live filesystem"
+    );
+    std::fs::write(skill_dir.join("SKILL.md"), "changed after capture")?;
+    assert!(!observed.revalidate(LOCAL_FS.as_ref()).await?);
+    for (skill, expected) in &captured_texts {
+        assert_eq!(&captured.read_skill_text(skill).await?, expected);
+    }
+    let mut foreign = captured_texts[0].0.clone();
+    foreign.path_to_skills_md = PathUri::from_host_native_path(&home.path().join("foreign.md"))?;
+    assert!(captured.read_skill_text(&foreign).await.is_err());
+
+    std::fs::write(
+        skill_dir.join("SKILL.md"),
+        "---\nname: example\ndescription: fixture\n---\n\n# Fixture\n",
+    )?;
+    let raced_fs = NativePreparationFileSystem::new_shared(Arc::clone(&LOCAL_FS));
+    let selected: Arc<dyn ExecutorFileSystem> = raced_fs.clone();
+    let raced = service
+        .native_prepare_for_config(&input, None, selected, false)
+        .await?;
+    std::fs::write(skill_dir.join("SKILL.md"), "changed during capture")?;
+    assert!(raced.native_capture_texts().await.is_err());
+    assert!(raced_fs.seal().await.is_err());
+    Ok(())
+}
