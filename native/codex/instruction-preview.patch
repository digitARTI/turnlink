+    let grant = codex_protocol::protocol::ContinuityHostGrant {
+        id: uuid::Uuid::new_v4(), channel: "fixture".into(), task_id: uuid::Uuid::new_v4(),
+        agent_id: format!("codex:{thread_id}"), preview_id: uuid::Uuid::new_v4(), claim_generation: 1,
+        from: source.clone(), to: config.cwd.clone(), configuration_digest: "a".repeat(64), authority_digest: "b".repeat(64),
+        checkpoint_config_sha256: Some({ use sha2::{Digest, Sha256}; format!("{:x}", Sha256::digest(std::fs::read(home.path().join("config.toml")).unwrap())) }),
+        status: "prepared".into(), prepared_at: 1,
