+/// Captured only by the native session startup producer, after activation. This
+/// binds configured preferences separately from the effective runtime activation;
+/// it is data provenance, not model/auth freshness or execution authority.
+#[derive(Clone)]
+pub(super) struct NativeTokenBudgetStartup {
+    configured: TokenBudgetStartupConfig,
+    enabled: bool,
+    token_budget: Option<TokenBudgetConfig>,
+}
+
+impl NativeTokenBudgetStartup {
+    fn capture(config: &Config) -> Option<Self> {
+        Some(Self {
+            configured: config.token_budget_startup_config.clone()?,
+            enabled: config.features.enabled(Feature::TokenBudget),
+            token_budget: config.token_budget.clone(),
+        })
+    }
+
+    fn apply(&self, target: &mut Config, source: &Config) -> std::io::Result<()> {
+        if source.token_budget_startup_config.as_ref() != Some(&self.configured)
+            || source.features.enabled(Feature::TokenBudget) != self.enabled
+            || source.token_budget != self.token_budget
+            || target.features.enabled(Feature::TokenBudget) != self.configured.enabled
+            || target.token_budget != self.configured.token_budget
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::Unsupported,
+                "native token budget startup binding unavailable or changed",
+            ));
+        }
+        // Apply only this native producer's fields. Other feature/config edits
+        // still fail the complete source reconstruction comparison.
+        target
+            .features
+            .set_enabled(Feature::TokenBudget, self.enabled)
+            .map_err(|_| {
+                std::io::Error::new(
+                    std::io::ErrorKind::Unsupported,
+                    "native token budget startup requirement changed",
+                )
+            })?;
+        target.token_budget = self.token_budget.clone();
+        target.token_budget_startup_config = Some(self.configured.clone());
+        target
+            .native_invocation
+            .bind_token_budget_startup(Some(self.clone()));
+        Ok(())
+    }
+}
+
+impl Config {
+    pub(crate) fn bind_native_token_budget_startup(&mut self) {
+        let binding = NativeTokenBudgetStartup::capture(self);
+        self.native_invocation.bind_token_budget_startup(binding);
+    }
+
+    pub(super) fn retain_native_token_budget_startup(
+        &mut self,
+        source: &Config,
+    ) -> std::io::Result<()> {
+        match source.native_invocation.token_budget_startup_binding() {
+            Some(binding) => binding.apply(self, source),
+            None if source.token_budget_startup_config.is_none() => Ok(()),
+            None => Err(std::io::Error::new(
+                std::io::ErrorKind::Unsupported,
+                "native token budget startup producer binding unavailable",
+            )),
+        }
+    }
+}
