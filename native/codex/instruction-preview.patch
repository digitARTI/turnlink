+#[tokio::test]
+async fn native_preparation_fs_uses_stream_for_actual_catalog_and_checks_drift() -> io::Result<()> {
+    let catalog = codex_models_manager::bundled_models_response().unwrap();
+    let source = StreamSource::bytes(serde_json::to_vec(&catalog)?);
+    let fs = NativePreparationFileSystem::new(&source);
+    let path = AbsolutePathBuf::from_absolute_path("/native-preparation-virtual.json")?;
+    assert_eq!(super::super::load_catalog_json(&fs, &path).await?, catalog);
+    let inputs = fs.finish()?;
+    assert!(inputs.revalidate(&source).await?);
+    assert!(!inputs.revalidate(&StreamSource::bytes("different")).await?);
+    assert_eq!(source.opens.load(Ordering::SeqCst), 2);
+    Ok(())
+}
