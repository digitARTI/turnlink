+    session_store: &ExtensionData,
+    thread_store: &ExtensionData,
+    step_store: &ExtensionData,
+) -> codex_extension_api::NativeToolPreparation {
+    let native = (contributor as &dyn std::any::Any).downcast_ref::<MemoriesExtension>()?;
+    if thread_store.get::<MemoriesExtensionConfig>().is_none() {
+        return Some(Err("native memories configuration is not initialized"));
+    }
+    Some(Ok(native
+        .tools_for_step(session_store, thread_store, step_store)
+        .iter()
+        .map(|tool| codex_extension_api::PreparedExtensionTool::capture(tool.as_ref()))
+        .collect()))
