+        config: &Config,
+        environments: &TurnEnvironmentSnapshot,
+    ) -> CodexResult<Option<Arc<LoadedAgentsMd>>> {
+        if environments.environments.is_empty()
+            || environments
+                .environments
+                .iter()
+                .any(|environment| !matches!(environment, TurnEnvironmentState::Ready(_)))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "instruction preparation requires already-ready environments".into(),
+            ));
+        }
+        let host = self.preview_host_instructions().await?;
+        Ok(preview_project_instructions(config, environments)
+            .await?
+            .unwrap_or_default()
+            .with_instructions(host.user, host.thread)
+            .map(Arc::new))
+    }
