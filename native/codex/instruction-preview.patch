+        );
+        assert!(
+            LOCAL_FS
+                .read_directory_bounded(
+                    &PathUri::from_host_native_path(temp.path())?,
+                    limits(),
+                    None
+                )
+                .await?
+                .is_empty()
+        );
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn bounded_directory_never_bypasses_sandbox() -> io::Result<()> {
+        use codex_protocol::models::PermissionProfile;
+        use codex_protocol::permissions::{FileSystemSandboxPolicy, NetworkSandboxPolicy};
+        let temp = tempfile::tempdir()?;
+        let path = PathUri::from_host_native_path(temp.path())?;
+        let sandbox = FileSystemSandboxContext::from_permission_profile(
+            PermissionProfile::from_runtime_permissions(
