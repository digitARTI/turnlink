+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use codex_extension_api::{ExtensionData, ExtensionRegistryBuilder, ThreadStartInput};
+use codex_protocol::error::CodexErr;
+use codex_protocol::protocol::SessionSource;
+
+struct UnusedHost;
+impl codex_message_board::MessageBoardHost for UnusedHost {
+    fn agent_path(
+        &self,
+        _: codex_protocol::ThreadId,
+    ) -> futures::future::BoxFuture<'_, codex_protocol::error::Result<codex_protocol::AgentPath>>
+    {
+        unreachable!()
+    }
+    fn resolve_agent(
+        &self,
+        _: codex_protocol::AgentPath,
+    ) -> futures::future::BoxFuture<'_, codex_protocol::error::Result<codex_protocol::ThreadId>>
+    {
+        unreachable!()
+    }
+    fn current_time(
+        &self,
+        _: codex_protocol::ThreadId,
+    ) -> futures::future::BoxFuture<'_, codex_protocol::error::Result<chrono::DateTime<chrono::Utc>>>
+    {
+        unreachable!()
+    }
+    fn notify(
+        &self,
+        _: codex_protocol::ThreadId,
+        _: codex_message_board::PostPreview,
+    ) -> futures::future::BoxFuture<
+        '_,
+        codex_protocol::error::Result<codex_message_board::NotificationDelivery>,
+    > {
+        unreachable!()
+    }
+}
+
+#[tokio::test]
+async fn board_keeps_startup_namespace_and_binding_during_detached_tool_collection() {
+    let opens = Arc::new(AtomicUsize::new(0));
+    let resolves = Arc::new(AtomicUsize::new(0));
+    let boards = Arc::new(codex_message_board::InMemoryMessageBoards::default());
+    let mut builder = ExtensionRegistryBuilder::<String>::new();
+    codex_agent_message_board_extension::install(
+        &mut builder,
+        "fixture",
+        {
+            let resolves = Arc::clone(&resolves);
+            move |config: &String| {
+                resolves.fetch_add(1, Ordering::SeqCst);
+                Some(config.clone())
+            }
+        },
+        {
+            let opens = Arc::clone(&opens);
+            let boards = Arc::clone(&boards);
+            move |_, tree, _| {
+                opens.fetch_add(1, Ordering::SeqCst);
+                let boards = Arc::clone(&boards);
+                Box::pin(async move {
+                    Ok(Some(
+                        Arc::new(boards.open(tree, Arc::new(UnusedHost)).await)
+                            as Arc<dyn codex_message_board::AgentMessageBoard>,
+                    ))
+                })
+            }
+        },
+    );
+    let registry = builder.build();
+    let session = ExtensionData::new("11111111-1111-4111-8111-111111111111");
+    let thread = ExtensionData::new("22222222-2222-4222-8222-222222222222");
+    let step = ExtensionData::new("detached-step");
+    for lifecycle in registry.thread_lifecycle_contributors() {
+        lifecycle
+            .on_thread_start(ThreadStartInput {
+                config: &"source".to_string(),
+                session_source: &SessionSource::Cli,
+                persistent_thread_state_available: true,
+                environments: &[],
+                mcp_resource_client: None,
+                extension_metrics: None,
+                session_store: &session,
+                thread_store: &thread,
+            })
+            .await;
+    }
+    let contributor = registry.tool_contributors()[0].as_ref();
+    let witness = contributor
+        .native_step_freshness(&session, &thread)
+        .unwrap();
+    assert!(witness());
+    let tools = contributor.tools_for_step(&session, &thread, &step);
+    assert!(!tools.is_empty());
+    assert!(
+        tools
+            .iter()
+            .all(|tool| tool.tool_name().namespace.as_deref() == Some("source"))
+    );
+    assert_eq!(opens.load(Ordering::SeqCst), 1);
+    assert_eq!(resolves.load(Ordering::SeqCst), 1);
+    assert!(witness());
+}
+
+#[tokio::test]
+async fn board_freshness_requires_completed_startup_and_invalidates_reinitialization() {
+    for fails in [false, true] {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let mut builder = ExtensionRegistryBuilder::<()>::new();
+        codex_agent_message_board_extension::install(
+            &mut builder,
+            "fixture",
+            |_| panic!("absent board must not resolve a namespace"),
+            {
+                let calls = Arc::clone(&calls);
+                move |_, _, _| {
+                    calls.fetch_add(1, Ordering::SeqCst);
+                    Box::pin(async move {
+                        if fails {
+                            Err(CodexErr::InvalidRequest("fixture failure".into()))
+                        } else {
+                            Ok(None)
+                        }
+                    })
+                }
+            },
+        );
+        let registry = builder.build();
+        let session = ExtensionData::new("11111111-1111-4111-8111-111111111111");
+        let thread = ExtensionData::new("22222222-2222-4222-8222-222222222222");
+        let contributor = registry.tool_contributors()[0].as_ref();
+        let witness = contributor
+            .native_step_freshness(&session, &thread)
+            .unwrap();
+        assert!(!witness());
+        for lifecycle in registry.thread_lifecycle_contributors() {
+            lifecycle
+                .on_thread_start(ThreadStartInput {
+                    config: &(),
+                    session_source: &SessionSource::Cli,
+                    persistent_thread_state_available: true,
+                    environments: &[],
+                    mcp_resource_client: None,
+                    extension_metrics: None,
+                    session_store: &session,
+                    thread_store: &thread,
+                })
+                .await;
+        }
+        let witness = contributor
+            .native_step_freshness(&session, &thread)
+            .unwrap();
+        assert_eq!(witness(), !fails);
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        for lifecycle in registry.thread_lifecycle_contributors() {
+            lifecycle
+                .on_thread_start(ThreadStartInput {
+                    config: &(),
+                    session_source: &SessionSource::Cli,
+                    persistent_thread_state_available: true,
+                    environments: &[],
+                    mcp_resource_client: None,
+                    extension_metrics: None,
+                    session_store: &session,
+                    thread_store: &thread,
+                })
+                .await;
+        }
+        assert!(
+            !witness(),
+            "a startup replacement must invalidate the old witness"
+        );
+        assert_eq!(calls.load(Ordering::SeqCst), 2);
+    }
+}
