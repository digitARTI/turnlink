+use codex_core::config::Config;
+use codex_extension_api::{
+    ExtensionData, ExtensionRegistryBuilder, NativeToolCollectionError, ToolCall, ToolContributor,
+    ToolExecutor, ToolName,
+};
+use std::sync::Arc;
+
+struct Unknown;
+struct UnknownPrompt;
+struct UnknownTurnInput;
+impl codex_extension_api::TurnInputContributor for UnknownTurnInput {
+    fn contribute<'a>(
+        &'a self,
+        _: codex_extension_api::TurnInputContext<'a>,
+        _: Option<Arc<dyn codex_extension_api::ExtensionMetrics>>,
+        _: &'a ExtensionData,
+        _: &'a ExtensionData,
+        _: &'a ExtensionData,
+    ) -> codex_extension_api::ExtensionFuture<
+        'a,
+        Vec<Box<dyn codex_extension_api::ContextualUserFragment + Send>>,
+    > {
+        panic!("classification must not invoke unknown turn-input callbacks")
+    }
+}
+
+#[test]
+fn turn_input_classifier_requires_known_type_and_exact_preparation_owner() {
+    fn install_skills(builder: &mut ExtensionRegistryBuilder<Config>) {
+        codex_skills_extension::install_with_providers(
+            builder,
+            codex_skills_extension::SkillProviders::new(),
+            |_: &Config| codex_skills_extension::SkillsExtensionConfig {
+                include_instructions: false,
+                max_context_tokens: None,
+                bundled_skills_enabled: false,
+                cloud_skill_enabled: false,
+                shadow_selection_enabled: false,
+            },
+        );
+    }
+    assert!(
+        ExtensionRegistryBuilder::<Config>::new()
+            .build()
+            .native_turn_input_contributors_known()
+    );
+    let mut unsupported = ExtensionRegistryBuilder::<Config>::new();
+    unsupported.turn_input_contributor(Arc::new(UnknownTurnInput));
+    assert!(!unsupported.build().native_turn_input_contributors_known());
+    let mut unknown = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut unknown);
+    unknown.turn_input_contributor(Arc::new(UnknownTurnInput));
+    let unknown = unknown.build();
+    assert!(!unknown.native_turn_input_contributors_known());
+    assert!(
+        !unknown
+            .to_builder()
+            .build()
+            .native_turn_input_contributors_known()
+    );
+
+    let mut first = ExtensionRegistryBuilder::<Config>::new();
+    install_skills(&mut first);
+    super::install(&mut first);
+    let first = first.build();
+    assert!(first.native_turn_input_contributors_known());
+    assert!(
+        first
+            .to_builder()
+            .build()
+            .native_turn_input_contributors_known()
+    );
+    let mut other = ExtensionRegistryBuilder::<Config>::new();
+    install_skills(&mut other);
+    let other = other.build();
+
+    let mut missing = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut missing);
+    missing.turn_input_contributor(first.turn_input_contributors()[0].clone());
+    assert!(!missing.build().native_turn_input_contributors_known());
+    let mut different = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut different);
+    different.turn_input_contributor(first.turn_input_contributors()[0].clone());
+    different.tool_contributor(other.tool_contributors()[0].clone());
+    assert!(!different.build().native_turn_input_contributors_known());
+    let mut paired = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut paired);
+    paired.turn_input_contributor(first.turn_input_contributors()[0].clone());
+    paired.tool_contributor(first.tool_contributors()[0].clone());
+    assert!(paired.build().native_turn_input_contributors_known());
+}
+impl codex_extension_api::ContextContributor for UnknownPrompt {
+    fn contribute_thread_context<'a>(
+        &'a self,
+        _: &'a ExtensionData,
+        _: &'a ExtensionData,
+    ) -> codex_extension_api::ExtensionFuture<'a, Vec<codex_extension_api::PromptFragment>> {
+        panic!("prompt classification must not invoke contributor callbacks")
+    }
+
+    fn contribute_turn_context<'a>(
+        &'a self,
+        _: codex_extension_api::TurnContextContributionInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Vec<codex_extension_api::PromptFragment>> {
+        panic!("prompt classification must not invoke contributor callbacks")
+    }
+
+    fn contribute_world_state<'a>(
+        &'a self,
+        _: codex_extension_api::WorldStateContributionInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<
+        'a,
+        Vec<codex_extension_api::WorldStateSectionContribution>,
+    > {
+        panic!("prompt classification must not invoke contributor callbacks")
+    }
+}
+
+#[test]
+fn prompt_classifier_refuses_unknown_without_calling_it_and_survives_registry_clone() {
+    let builder = ExtensionRegistryBuilder::<Config>::new();
+    assert!(builder.build().native_prompt_contributors_known());
+    let mut builder = ExtensionRegistryBuilder::<Config>::new();
+    builder.prompt_contributor(Arc::new(UnknownPrompt));
+    assert!(!builder.build().native_prompt_contributors_known());
+    let mut builder = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut builder);
+    builder.prompt_contributor(Arc::new(UnknownPrompt));
+    let registry = builder.build();
+    assert!(!registry.native_prompt_contributors_known());
+    assert!(
+        !registry
+            .to_builder()
+            .build()
+            .native_prompt_contributors_known()
+    );
+}
+impl ToolContributor for Unknown {
+    fn prepare_for_step<'a>(
+        &'a self,
+        _: codex_extension_api::StepPreparationInput<'a>,
+    ) -> codex_extension_api::ExtensionFuture<'a, ()> {
+        panic!("classification must not invoke unknown preparation")
+    }
+    fn tools(
+        &self,
+        _: &ExtensionData,
+        _: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        panic!("closed collection must not invoke unknown contributors")
+    }
+}
+
+#[test]
+fn host_recognizes_git_attribution_without_invoking_it_or_exposing_tools() {
+    let mut builder = ExtensionRegistryBuilder::<Config>::new();
+    codex_git_attribution::install(
+        &mut builder,
+        codex_login::AuthManager::from_auth_for_testing(codex_login::CodexAuth::from_api_key(
+            "fixture",
+        )),
+        "http://unused".into(),
+        codex_http_client::HttpClientFactory::new(
+            codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+        ),
+    );
+    super::install(&mut builder);
+    let registry = builder.build();
+    assert!(registry.native_tool_contributors_known());
+    assert!(registry.native_prompt_contributors_known());
+    let prepared = registry
+        .prepare_native_tools(
+            &ExtensionData::new("session"),
+            &ExtensionData::new("thread"),
+            &ExtensionData::new("step"),
+        )
+        .unwrap();
+    assert_eq!(prepared.len(), 1);
+    assert!(prepared[0].tools().is_empty());
+
+    let mut unmatched = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut unmatched);
+    unmatched.prompt_contributor(registry.context_contributors()[0].clone());
+    assert!(!unmatched.build().native_prompt_contributors_known());
+
+    let mut other = ExtensionRegistryBuilder::<Config>::new();
+    codex_git_attribution::install(
+        &mut other,
+        codex_login::AuthManager::from_auth_for_testing(codex_login::CodexAuth::from_api_key(
+            "other",
+        )),
+        "http://unused".into(),
+        codex_http_client::HttpClientFactory::new(
+            codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+        ),
+    );
+    let other = other.build();
+    let mut unmatched = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut unmatched);
+    unmatched.prompt_contributor(registry.context_contributors()[0].clone());
+    unmatched.tool_contributor(other.tool_contributors()[0].clone());
+    assert!(!unmatched.build().native_prompt_contributors_known());
+
+    let mut matched = ExtensionRegistryBuilder::<Config>::new();
+    super::install(&mut matched);
+    matched.prompt_contributor(registry.context_contributors()[0].clone());
+    matched.tool_contributor(registry.tool_contributors()[0].clone());
+    assert!(matched.build().native_prompt_contributors_known());
+}
+
+#[test]
+fn host_tool_preparation_requires_registered_collection_for_nonempty_registries() {
+    let session = ExtensionData::new("session");
+    let thread = ExtensionData::new("thread");
+    let step = ExtensionData::new("step");
+    let mut builder = ExtensionRegistryBuilder::<Config>::new();
+    assert!(builder.build().native_tool_contributors_known());
+    builder = ExtensionRegistryBuilder::<Config>::new();
+    assert!(
+        builder
+            .build()
+            .prepare_native_tools(&session, &thread, &step)
+            .unwrap()
+            .is_empty()
+    );
+    builder = ExtensionRegistryBuilder::<Config>::new();
+    codex_multi_env_copy_file::install(&mut builder);
+    assert!(!builder.build().native_tool_contributors_known());
+    builder = ExtensionRegistryBuilder::<Config>::new();
+    codex_multi_env_copy_file::install(&mut builder);
+    assert!(matches!(
+        builder
+            .build()
+            .prepare_native_tools(&session, &thread, &step),
+        Err(NativeToolCollectionError::UnsupportedHost)
+    ));
+}
+
+#[test]
+fn host_tool_preparation_preserves_registry_identity_order_and_clone_registration() {
+    let mut builder = ExtensionRegistryBuilder::<Config>::new();
+    codex_multi_env_copy_file::install(&mut builder);
+    codex_multi_env_copy_file::install(&mut builder);
+    super::install(&mut builder);
+    let original = builder.build();
+    let registry = original.to_builder().build();
+    assert!(registry.native_tool_contributors_known());
+    assert!(registry.native_prompt_contributors_known());
+    let scopes = [
+        ExtensionData::new("session"),
+        ExtensionData::new("thread"),
+        ExtensionData::new("step"),
+    ];
+    let prepared = registry
+        .prepare_native_tools(&scopes[0], &scopes[1], &scopes[2])
+        .unwrap();
+    assert_eq!(prepared.len(), 2);
+    for (index, observation) in prepared.iter().enumerate() {
+        assert!(observation.matches(&registry.tool_contributors()[index]));
+        assert!(!observation.matches(&registry.tool_contributors()[1 - index]));
+        assert_eq!(observation.tools().len(), 1);
+        assert_eq!(
+            observation.tools()[0].name,
+            ToolName::plain("multi_env_copy_file")
+        );
+    }
+    let mut builder = registry.to_builder();
+    builder.tool_contributor(Arc::new(Unknown));
+    assert!(!builder.build().native_tool_contributors_known());
+    let mut builder = registry.to_builder();
+    builder.tool_contributor(Arc::new(Unknown));
+    assert!(matches!(
+        builder
+            .build()
+            .prepare_native_tools(&scopes[0], &scopes[1], &scopes[2]),
+        Err(NativeToolCollectionError::UnknownContributor { index: 2 })
+    ));
+}
