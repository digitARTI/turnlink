+    let prepare = |contributors: &[PreparedToolContributor]| {
+        super::preview_tool_router_with_contributors(
+            &session,
+            &turn,
+            &step.settings.model_info,
+            &step.environments,
+            &step.mcp,
+            false,
+            None,
+            contributors,
+        )
+    };
+    let declaration = || PreparedExtensionTool::capture(&DeferredExtensionTool);
+    for invalid in [
+        vec![],
+        vec![PreparedToolContributor::new(other, vec![declaration()])],
+        vec![
+            PreparedToolContributor::new(contributor.clone(), vec![declaration()]),
+            PreparedToolContributor::new(contributor.clone(), vec![declaration()]),
+        ],
+    ] {
+        assert!(prepare(&invalid).is_err());
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    let prepared = prepare(&[PreparedToolContributor::new(
+        contributor,
+        vec![declaration()],
+    )])
+    .unwrap();
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    let echo = prepared
+        .tools
+        .iter()
+        .find(|tool| tool.name == ToolName::plain("extension_echo"))
+        .expect("prepared extension declaration remains registered");
+    assert_eq!(echo.exposure, ToolExposure::Deferred);
+    assert!(
+        !prepared
+            .model_visible_specs
+            .iter()
+            .any(|spec| spec.name() == "extension_echo")
+    );
+    let ordinary = super::build_tool_router(
+        &session,
+        &turn,
+        &step.settings.model_info,
+        &step.environments,
+        &step.mcp,
+        false,
+        &turn.extension_data,
+        None,
+    )
+    .unwrap();
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(prepared == ordinary.preparation_snapshot());
+}
