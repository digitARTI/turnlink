+#[tokio::test]
+async fn cached_socket_shutdown_closes_real_source_and_refuses_foreign_owner() {
+    use tokio_tungstenite::tungstenite::Message;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (accepted, ready) = tokio::sync::oneshot::channel();
+    let peer = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut config = tokio_tungstenite::tungstenite::protocol::WebSocketConfig::default();
+        config.extensions.permessage_deflate = Some(
+            tokio_tungstenite::tungstenite::extensions::compression::deflate::DeflateConfig::default(),
+        );
+        let mut socket = tokio_tungstenite::accept_async_with_config(socket, Some(config))
+            .await
+            .unwrap();
+        accepted.send(()).unwrap();
+        tokio::time::timeout(Duration::from_secs(3), socket.next())
+            .await
+            .unwrap()
+    });
+    let source = test_model_client_with_base_url(
+        ThreadId::new(),
+        SessionSource::Cli,
+        &format!("http://{address}/v1"),
+    );
+    let setup = source
+        .current_client_setup(super::ClientRouting::ConfiguredProvider)
+        .await
+        .unwrap();
+    let connection = super::ApiWebSocketResponsesClient::new(setup.api_provider, setup.api_auth)
+        .connect(
+            &source.http_client_factory,
+            Default::default(),
+            Default::default(),
+            None,
+            None,
+        )
+        .await
+        .unwrap();
+    ready.await.unwrap();
+    source.store_cached_websocket_session(super::WebsocketSession {
+        connection: Some(connection),
+        ..Default::default()
+    });
+    let foreign = test_model_client(SessionSource::Cli);
+    let foreign_guard = foreign.try_exclude_sessions().unwrap();
+    assert_eq!(
+        source.native_shutdown_cached_socket(&foreign_guard).await,
+        None
+    );
+    let guard = source.try_exclude_sessions().unwrap();
+    assert_eq!(
+        source.native_shutdown_cached_socket(&guard).await,
+        Some(true)
+    );
+    let event = peer.await.unwrap();
+    assert!(
+        event.is_none()
+            || event
+                .is_some_and(|result| result.is_err() || matches!(result, Ok(Message::Close(_))))
+    );
+    assert_eq!(
+        source.native_shutdown_cached_socket(&guard).await,
+        Some(false)
+    );
+}
