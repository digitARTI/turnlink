+    #[test]
+    fn native_provider_publication_refusal_retains_owner_for_cleanup() {
+        let (source, resource, _home) = publication_fixture();
+        let definitions = destination(resource.preparation.destination_definition.clone());
+        let provider_alias = Arc::clone(&resource.provider);
+        let manager_alias = Arc::downgrade(&resource.model_context.as_ref().unwrap().manager);
+        let resource = Arc::new(tokio::sync::Mutex::new(resource));
+        assert!(
+            NativeProviderPublication::try_stage(
+                Arc::clone(&resource),
+                &source,
+                &definitions,
+                None
+            )
+            .is_err()
+        );
+        drop(provider_alias);
+        assert!(
+            NativeProviderPublication::try_stage(
+                Arc::clone(&resource),
+                &source,
+                &definitions,
+                None
+            )
+            .is_err()
+        );
+        drop(manager_alias);
+        let guard = resource.try_lock().unwrap();
+        assert!(
+            NativeProviderPublication::try_stage(
+                Arc::clone(&resource),
+                &source,
+                &definitions,
+                None
+            )
+            .is_err()
+        );
+        drop(guard);
+        let staged = NativeProviderPublication::try_stage(
+            Arc::clone(&resource),
+            &source,
+            &definitions,
+            None,
+        )
+        .unwrap();
+        let guard = resource.try_lock().unwrap();
+        let staged = match staged.publish(&source, &definitions, None) {
+            Ok(_) => panic!("contended owner must not publish"),
+            Err(staged) => staged,
+        };
+        drop(guard);
+        let mut changed = definitions.clone();
+        changed.get_mut("chosen").unwrap().base_url = Some("https://changed.invalid".into());
+        let staged = match staged.publish(&source, &changed, None) {
+            Ok(_) => panic!("changed target must not publish"),
+            Err(staged) => staged,
+        };
+        drop(resource);
+        Arc::try_unwrap(staged.cancel())
+            .expect("exclusive owner")
+            .into_inner()
+            .try_release_unpublished()
+            .expect("unpublished owner remains releasable");
+    }
