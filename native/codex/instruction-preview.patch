+            .codex_home(config.codex_home.to_path_buf()).fallback_cwd(Some(grant.to.to_path_buf()))
+            .without_project_context().strict_config(true).build().await.map_err(|_| refused())?);
+        if let Ok(history) = &inspected {
+            if crate::session::resolve_native_startup_token_budget(&mut baseline, history, None, &model_info).is_err() {
+                return Err(refused());
+            }
+        }
+        let mut candidates = self.state.checkpoint_candidates.lock().map_err(|_| refused())?;
+        let current = candidates.get(&id).is_some_and(|slot| &slot.owner == owner && owner.is_open()
+            && slot.candidate.is_current(&model_info, &baseline));
+        if !layer_matches || inspected.is_err() || !current || self.state.auth_manager.auth_cached().is_some()
+            || !crate::session::continuity::checkpoint_config_layer_matches(config.codex_home.as_ref(), &config, &grant).unwrap_or(false) {
+            candidates.remove(&id);
+            return Err(refused());
+        }
+        Ok(serde_json::json!({"version": 1, "candidateId": id, "status": "quarantined_unverified", "releaseAllowed": false}))
+    }
