index 0000000..cf48227
--- /dev/null
+++ b/codex-rs/rmcp-client/src/native_activity.rs
@@ -0,0 +1,277 @@
+//! Native request ownership shared by a thread's MCP clients, including old aliases.
+//! This fences native requests, not autonomous server work or physical transport cleanup.
+use std::sync::{Arc, Mutex};
+
+#[derive(Default)]
+struct State {
+    active: u64,
+    excluded: bool,
+    uncertain: bool,
+    retired: bool,
+    closing: bool,
+    revision: Arc<()>,
+}
+
+#[doc(hidden)]
+#[derive(Default)]
+pub struct NativeMcpActivity {
+    state: Mutex<State>,
+}
+
+/// An actual in-flight native operation. Cancellation retains uncertainty;
+/// dropping a future is never treated as evidence that server work has stopped.
+#[doc(hidden)]
+pub struct NativeMcpActivityPermit {
+    owner: Arc<NativeMcpActivity>,
+    complete: bool,
+}
+
+/// Native-only exclusion capability. It is neither serializable nor clonable.
+#[doc(hidden)]
+pub struct NativeMcpRequestExclusion {
+    owner: Arc<NativeMcpActivity>,
+    revision: Arc<()>,
+}
+
+/// Point-in-time witness for a closed runtime whose original exclusion is
+/// still held. Later cleanup changes its revision and invalidates the witness.
+#[doc(hidden)]
+pub struct NativeMcpClosedObservation {
+    owner: Arc<NativeMcpActivity>,
+    revision: Arc<()>,
+}
+
+fn unavailable() -> anyhow::Error {
+    anyhow::anyhow!("native MCP request ownership unavailable")
+}
+
+impl NativeMcpActivity {
+    /// A registry may forget an owner only when no work, uncertainty or
+    /// exclusion remains. Callers must also prove that no other aliases exist.
+    pub fn is_reclaimable(&self) -> bool {
+        self.state.try_lock().is_ok_and(|state| {
+            state.active == 0 && !state.uncertain && !state.excluded && !state.retired
+        })
+    }
+
+    pub fn enter(self: &Arc<Self>) -> anyhow::Result<NativeMcpActivityPermit> {
+        let mut state = self.state.lock().map_err(|_| unavailable())?;
+        if state.excluded || state.retired || state.closing {
+            return Err(unavailable());
+        }
+        let Some(next) = state.active.checked_add(1) else {
+            state.uncertain = true;
+            return Err(unavailable());
+        };
+        state.active = next;
+        Ok(NativeMcpActivityPermit {
+            owner: Arc::clone(self),
+            complete: false,
+        })
+    }
+
+    /// Does not wait, invoke callbacks or infer exclusivity from reference counts.
+    pub fn try_exclude(self: &Arc<Self>) -> anyhow::Result<NativeMcpRequestExclusion> {
+        let mut state = self.state.try_lock().map_err(|_| unavailable())?;
+        if state.active != 0 || state.uncertain || state.excluded || state.retired {
+            return Err(unavailable());
+        }
+        state.excluded = true;
+        Ok(NativeMcpRequestExclusion {
+            owner: Arc::clone(self),
+            revision: Arc::clone(&state.revision),
+        })
+    }
+
+    /// Cleanup must remain possible during interruption and exclusion. Its
+    /// actual worker invalidates any existing request census and owns this permit.
+    #[doc(hidden)]
+    pub fn begin_cleanup(self: &Arc<Self>) -> Option<NativeMcpActivityPermit> {
+        let mut state = self.state.lock().ok()?;
+        state.revision = Arc::new(());
+        let Some(next) = state.active.checked_add(1) else {
+            state.uncertain = true;
+            return None;
+        };
+        state.active = next;
+        Some(NativeMcpActivityPermit {
+            owner: Arc::clone(self),
+            complete: false,
+        })
+    }
+
+    /// Permanently stop new work before registering runtime-wide shutdown.
+    #[doc(hidden)]
+    pub fn begin_shutdown(self: &Arc<Self>) -> Option<NativeMcpActivityPermit> {
+        let mut state = self.state.lock().ok()?;
+        state.closing = true;
+        state.revision = Arc::new(());
+        let Some(next) = state.active.checked_add(1) else {
+            state.uncertain = true;
+            return None;
+        };
+        state.active = next;
+        Some(NativeMcpActivityPermit {
+            owner: Arc::clone(self),
+            complete: false,
+        })
+    }
+
+    /// Shutdown permanently rejects new ordinary requests. This is only a
+    /// point-in-time worker check; it does not prove physical process release.
+    pub fn shutdown_quiescent(&self) -> bool {
+        self.state.try_lock().is_ok_and(|state| {
+            state.closing && state.active == 0 && !state.uncertain && !state.retired
+        })
+    }
+
+    /// Capture shutdown only while its original exclusion remains held.
+    pub fn observe_closed(self: &Arc<Self>) -> Option<NativeMcpClosedObservation> {
+        let state = self.state.try_lock().ok()?;
+        if !state.closing
+            || !state.excluded
+            || state.active != 0
+            || state.uncertain
+            || state.retired
+        {
+            return None;
+        }
+        Some(NativeMcpClosedObservation {
+            owner: Arc::clone(self),
+            revision: Arc::clone(&state.revision),
+        })
+    }
+
+    /// Restart quarantine blocks new native requests without claiming that any
+    /// already-running operation or external server has been disposed.
+    pub fn retire(&self) {
+        if let Ok(mut state) = self.state.lock() {
+            state.retired = true;
+        }
+    }
+}
+
+impl NativeMcpClosedObservation {
+    pub fn is_current_for(&self, owner: &Arc<NativeMcpActivity>) -> bool {
+        Arc::ptr_eq(&self.owner, owner)
+            && owner.state.try_lock().is_ok_and(|state| {
+                state.closing
+                    && state.excluded
+                    && state.active == 0
+                    && !state.uncertain
+                    && !state.retired
+                    && Arc::ptr_eq(&self.revision, &state.revision)
+            })
+    }
+}
+
+impl NativeMcpActivityPermit {
+    pub fn complete(mut self, successful: bool) {
+        if let Ok(mut state) = self.owner.state.lock() {
+            state.uncertain |= !successful;
+        }
+        self.complete = true;
+    }
+}
+
+impl Drop for NativeMcpActivityPermit {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.owner.state.lock() {
+            state.active = state.active.saturating_sub(1);
+            state.uncertain |= !self.complete;
+        }
+    }
+}
+
+impl NativeMcpRequestExclusion {
+    /// Request-fence freshness only; no physical process or transport proof.
+    pub fn is_current(&self) -> bool {
+        let Ok(state) = self.owner.state.try_lock() else {
+            return false;
+        };
+        state.excluded
+            && !state.retired
+            && !state.uncertain
+            && state.active == 0
+            && Arc::ptr_eq(&self.revision, &state.revision)
+    }
+}
+
+impl Drop for NativeMcpRequestExclusion {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.owner.state.lock() {
+            state.excluded = false;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_mcp_request_exclusion_tracks_aliases_and_reopens_only_its_owner() {
+        let owner = Arc::new(NativeMcpActivity::default());
+        let alias = Arc::clone(&owner);
+        let active = alias.enter().unwrap();
+        assert!(owner.try_exclude().is_err());
+        active.complete(true);
+        let held = owner.try_exclude().unwrap();
+        assert!(alias.enter().is_err());
+        assert!(owner.try_exclude().is_err());
+        let foreign = Arc::new(NativeMcpActivity::default());
+        foreign.enter().unwrap().complete(true);
+        drop(held);
+        alias.enter().unwrap().complete(true);
+        assert!(owner.try_exclude().is_ok());
+    }
+
+    #[test]
+    fn native_mcp_request_cancellation_and_errors_cannot_become_quiescence() {
+        for cancelled in [false, true] {
+            let owner = Arc::new(NativeMcpActivity::default());
+            let active = owner.enter().unwrap();
+            if cancelled {
+                drop(active);
+            } else {
+                active.complete(false);
+            }
+            assert!(owner.try_exclude().is_err());
+            // This is a continuity fence, not a blanket disable of ordinary MCP.
+            owner.enter().unwrap().complete(true);
+            assert!(owner.try_exclude().is_err());
+        }
+    }
+
+    #[test]
+    fn native_mcp_request_retirement_survives_exclusion_release() {
+        let owner = Arc::new(NativeMcpActivity::default());
+        let held = owner.try_exclude().unwrap();
+        owner.retire();
+        drop(held);
+        assert!(owner.enter().is_err());
+        assert!(owner.try_exclude().is_err());
+    }
+
+    #[test]
+    fn closed_observation_requires_exclusion_and_invalidates_on_cleanup() {
+        let owner = Arc::new(NativeMcpActivity::default());
+        let foreign = Arc::new(NativeMcpActivity::default());
+        let held = owner.try_exclude().unwrap();
+        let shutdown = owner.begin_shutdown().unwrap();
+        assert!(owner.observe_closed().is_none());
+        shutdown.complete(true);
+        let observation = owner.observe_closed().unwrap();
+        assert!(observation.is_current_for(&owner));
+        assert!(!observation.is_current_for(&foreign));
+        let cleanup = owner.begin_cleanup().unwrap();
+        assert!(!observation.is_current_for(&owner));
+        cleanup.complete(true);
+        assert!(!observation.is_current_for(&owner));
+        let fresh = owner.observe_closed().unwrap();
+        assert!(fresh.is_current_for(&owner));
+        drop(held);
+        assert!(!fresh.is_current_for(&owner));
+        assert!(owner.enter().is_err());
+    }
+}
