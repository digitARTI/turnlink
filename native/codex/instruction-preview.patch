+//! Optional, point-in-time screening of resolved native store locations.
+//!
+//! This is not filesystem exclusion: it does not constrain earlier opens,
+//! direct state-runtime users, later replacement or external writers.
+use std::ffi::OsString;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+const EXPECTED_CODEX_HOME: &str = "TURNLINK_CODEX_EXPECTED_CODEX_HOME";
+const EXPECTED_SQLITE_HOME: &str = "TURNLINK_CODEX_EXPECTED_SQLITE_HOME";
+
+#[derive(Clone)]
+struct Expected {
+    codex: PathBuf,
+    sqlite: PathBuf,
+}
+
+static EXPECTED: OnceLock<Result<Option<Expected>, ()>> = OnceLock::new();
+
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "Turnlink resolved store check unavailable",
+    )
+}
+
+fn existing_directory(path: &Path) -> io::Result<PathBuf> {
+    if !path.is_absolute() {
+        return Err(invalid());
+    }
+    let canonical = std::fs::canonicalize(path).map_err(|_| invalid())?;
+    if !canonical.is_dir() {
+        return Err(invalid());
+    }
+    Ok(canonical)
+}
+
+fn parse_expected(
+    codex: Option<OsString>,
+    sqlite: Option<OsString>,
+) -> io::Result<Option<Expected>> {
+    match (codex, sqlite) {
+        (None, None) => Ok(None),
+        (Some(codex), Some(sqlite)) => Ok(Some(Expected {
+            codex: existing_directory(Path::new(&codex))?,
+            sqlite: existing_directory(Path::new(&sqlite))?,
+        })),
+        _ => Err(invalid()),
+    }
+}
+
+fn compare(
+    expected: &Expected,
+    codex_home: Option<&Path>,
+    sqlite: &crate::SqliteConfig,
+) -> io::Result<()> {
+    let logs = sqlite.logs_db_path();
+    let log_home = logs.parent().ok_or_else(invalid)?;
+    if codex_home
+        .is_some_and(|path| existing_directory(path).ok().as_ref() != Some(&expected.codex))
+        || existing_directory(sqlite.home())? != expected.sqlite
+        || existing_directory(log_home)? != expected.sqlite
+    {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+pub fn validate_turnlink_resolved_stores(
+    codex_home: Option<&Path>,
+    sqlite: &crate::SqliteConfig,
+) -> io::Result<()> {
+    let expected = EXPECTED.get_or_init(|| {
+        parse_expected(
+            std::env::var_os(EXPECTED_CODEX_HOME),
+            std::env::var_os(EXPECTED_SQLITE_HOME),
+        )
+        .map_err(|_| ())
+    });
+    match expected {
+        Ok(Some(expected)) => compare(expected, codex_home, sqlite),
+        Ok(None) => Ok(()),
+        Err(()) => Err(invalid()),
+    }
+}
+
+// This is still a point-in-time check, not a held filesystem capability.
+pub(crate) fn validate_turnlink_sqlite_file(
+    sqlite: &crate::SqliteConfig,
+    path: &Path,
+) -> io::Result<()> {
+    validate_turnlink_resolved_stores(None, sqlite)?;
+    match EXPECTED.get().ok_or_else(invalid)? {
+        Ok(None) => Ok(()),
+        Ok(Some(expected)) => {
+            let parent = path.parent().ok_or_else(invalid)?;
+            if path.file_name().is_none() || existing_directory(parent)? != expected.sqlite {
+                return Err(invalid());
+            }
+            match std::fs::symlink_metadata(path) {
+                Ok(metadata) => {
+                    if !metadata.is_file() || metadata.file_type().is_symlink() {
+                        return Err(invalid());
+                    }
+                    #[cfg(unix)]
+                    {
+                        use std::os::unix::fs::MetadataExt;
+                        if metadata.nlink() != 1 {
+                            return Err(invalid());
+                        }
+                    }
+                }
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(_) => return Err(invalid()),
+            }
+            Ok(())
+        }
+        Err(()) => Err(invalid()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    #[test]
+    fn exact_resolved_state_and_log_homes_are_required() -> io::Result<()> {
+        let temp = crate::runtime::test_support::unique_temp_dir();
+        std::fs::create_dir_all(&temp)?;
+        let _cleanup = scopeguard::guard(temp.clone(), |path| {
+            let _ = std::fs::remove_dir_all(path);
+        });
+        let home = temp.join("home");
+        let sqlite_home = temp.join("sqlite");
+        let other = temp.join("other");
+        std::fs::create_dir(&home)?;
+        std::fs::create_dir(&sqlite_home)?;
+        std::fs::create_dir(&other)?;
+        let expected =
+            parse_expected(Some(home.clone().into()), Some(sqlite_home.clone().into()))?.unwrap();
+        let sqlite = crate::SqliteConfig::from_sqlite_home(AbsolutePathBuf::try_from(sqlite_home)?);
+        assert!(compare(&expected, Some(&home), &sqlite).is_ok());
+        assert!(compare(&expected, Some(&other), &sqlite).is_err());
+        assert!(
+            compare(
+                &expected,
+                Some(&home),
+                &sqlite.clone().with_local_logs_home(other)
+            )
+            .is_err()
+        );
+        assert!(parse_expected(Some(home.into()), None).is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn direct_state_runtime_refuses_unapproved_home_before_creation() -> io::Result<()> {
+        const CASE: &str = "TURNLINK_TEST_DIRECT_STATE_HOME";
+        if let Some(path) = std::env::var_os(CASE) {
+            let path = PathBuf::from(path);
+            let sqlite =
+                crate::SqliteConfig::from_sqlite_home(AbsolutePathBuf::try_from(path.clone())?);
+            let runtime = tokio::runtime::Runtime::new()?;
+            let result = runtime.block_on(crate::StateRuntime::init(sqlite, "fixture".into()));
+            assert!(result.is_err());
+            assert!(
+                !path.exists(),
+                "refused direct runtime must not create its store"
+            );
+            let allowed = PathBuf::from(std::env::var_os(EXPECTED_SQLITE_HOME).unwrap());
+            let sqlite =
+                crate::SqliteConfig::from_sqlite_home(AbsolutePathBuf::try_from(allowed.clone())?);
+            let unapproved_file = path.parent().unwrap().join("outside.sqlite");
+            assert!(
+                runtime
+                    .block_on(sqlite.open_read_write_pool(&unapproved_file))
+                    .is_err()
+            );
+            assert!(
+                !unapproved_file.exists(),
+                "direct pool must not create a DB outside its expected home"
+            );
+            #[cfg(unix)]
+            {
+                let linked = allowed.join("linked.sqlite");
+                std::os::unix::fs::symlink(&unapproved_file, &linked)?;
+                assert!(
+                    runtime
+                        .block_on(sqlite.open_read_write_pool(&linked))
+                        .is_err()
+                );
+                assert!(
+                    !unapproved_file.exists(),
+                    "direct pool must not follow a DB symlink"
+                );
+            }
+            return Ok(());
+        }
+        let temp = crate::runtime::test_support::unique_temp_dir();
+        std::fs::create_dir_all(&temp)?;
+        let _cleanup = scopeguard::guard(temp.clone(), |path| {
+            let _ = std::fs::remove_dir_all(path);
+        });
+        let home = temp.join("home");
+        let expected_sqlite = temp.join("sqlite");
+        std::fs::create_dir(&home)?;
+        std::fs::create_dir(&expected_sqlite)?;
+        let result = std::process::Command::new(std::env::current_exe()?)
+            .arg("--exact").arg("turnlink_store_guard::tests::direct_state_runtime_refuses_unapproved_home_before_creation")
+            .arg("--nocapture")
+            .env(EXPECTED_CODEX_HOME, &home)
+            .env(EXPECTED_SQLITE_HOME, &expected_sqlite)
+            .env(CASE, temp.join("unapproved"))
+            .output()?;
+        assert!(
+            result.status.success(),
+            "{}",
+            String::from_utf8_lossy(&result.stderr)
+        );
+        Ok(())
+    }
+}
