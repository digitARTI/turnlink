+#[tokio::test]
+async fn native_instruction_preparation_refuses_a_different_native_provider_instance() {
+    let execution_home = tempdir().expect("execution home");
+    let foreign_home = tempdir().expect("foreign home");
+    std::fs::write(
+        execution_home.path().join("AGENTS.md"),
+        "execution authority",
+    )
+    .expect("write execution");
+    std::fs::write(foreign_home.path().join("AGENTS.md"), "foreign authority")
+        .expect("write foreign");
+    let execution = Arc::new(codex_home::CodexHomeUserInstructionsProvider::new(
+        execution_home.path().abs(),
+    ));
+    let foreign = Arc::new(codex_home::CodexHomeUserInstructionsProvider::new(
+        foreign_home.path().abs(),
+    ));
+    let inputs = SessionInstructions {
+        user_provider: Some(execution),
+        native_user_provider: Some(foreign),
+        ..Default::default()
+    };
+    let reader = crate::agents_md_manager::AgentsMdManager::new(inputs);
+    assert!(
+        reader.preview_host_instructions().await.is_err(),
+        "a native class name does not bind another instance's authority"
+    );
+}
