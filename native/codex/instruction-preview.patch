+#[tokio::test]
+async fn native_instruction_preparation_refuses_unknown_callbacks_without_invoking_them() {
+    for thread_provider in [false, true] {
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let provider = Arc::new(UnverifiedPreparationProvider(Arc::clone(&calls)));
+        let inputs = if thread_provider {
+            SessionInstructions {
+                thread_provider: Some(provider),
+                ..Default::default()
+            }
+        } else {
+            SessionInstructions {
+                user_provider: Some(provider),
+                ..Default::default()
+            }
+        };
+        let reader = crate::agents_md_manager::AgentsMdManager::new(inputs);
+        assert!(reader.preview_host_instructions().await.is_err());
+        assert_eq!(
+            calls.load(std::sync::atomic::Ordering::SeqCst),
+            0,
+            "unknown callbacks cannot be used as read-only authority evidence"
+        );
+        assert!(reader.get_loaded().await.is_none());
+    }
+}
