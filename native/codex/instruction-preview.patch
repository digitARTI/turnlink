+    assert_eq!(
+        names,
+        vec![
+            ToolName::plain("multi_env_copy_file"),
+            ToolName::namespaced("web", "run"),
+            ToolName::namespaced("image_gen", "imagegen"),
+            ToolName::namespaced("skills", "list"),
+            ToolName::namespaced("skills", "read"),
+            ToolName::namespaced("skills", "installations")
+        ]
+    );
+    assert_eq!(board_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(image_calls.load(Ordering::SeqCst), 1);
+}
