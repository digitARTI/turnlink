+#[cfg(unix)]
+#[tokio::test]
+async fn continuity_model_socket_process_death_preserves_pending_intent() {
+    use std::process::Stdio;
+    for (child_test, point) in [
+        (
+            "session::continuity_tests::continuity_real_socket_interruption_before_effect_is_not_replayed",
+            9,
+        ),
+        (
+            "session::continuity_tests::continuity_real_socket_interruption_after_effect_is_not_replayed",
+            10,
+        ),
+    ] {
+        let root = tempfile::tempdir().unwrap();
+        let marker = root.path().join("paused.json");
+        let log_path = root.path().join("child.log");
+        let log = std::fs::File::create(&log_path).unwrap();
+        let mut child = tokio::process::Command::new(std::env::current_exe().unwrap())
+            .arg("--exact")
+            .arg(child_test)
+            .arg("--nocapture")
+            .env("TMPDIR", root.path())
+            .env("TURNLINK_TEST_MODEL_CRASH_MARKER", &marker)
+            .stdin(Stdio::null())
+            .stdout(Stdio::from(log.try_clone().unwrap()))
+            .stderr(Stdio::from(log))
+            .kill_on_drop(true)
+            .spawn()
+            .unwrap();
+        tokio::time::timeout(std::time::Duration::from_secs(45), async {
+            loop {
+                if marker.exists() {
+                    break;
+                }
+                if let Some(status) = child.try_wait().unwrap() {
+                    panic!(
+                        "child exited before pause: {status}; {}",
+                        std::fs::read_to_string(&log_path).unwrap_or_default()
+                    );
+                }
+                tokio::time::sleep(std::time::Duration::from_millis(25)).await;
+            }
+        })
+        .await
+        .expect("child must reach durable intent boundary");
+        let marker_data: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(&marker).unwrap()).unwrap();
+        assert_eq!(marker_data["point"], point);
+        let journal_path = std::path::PathBuf::from(marker_data["journal"].as_str().unwrap());
+        assert!(
+            journal_path
+                .canonicalize()
+                .unwrap()
+                .starts_with(root.path().canonicalize().unwrap())
+        );
+        child.kill().await.unwrap();
+        assert!(!child.wait().await.unwrap().success());
+        let journal_bytes = std::fs::read(&journal_path).unwrap();
+        let journal: serde_json::Value = serde_json::from_slice(&journal_bytes).unwrap();
+        assert_eq!(journal["schema"], 9);
+        assert_eq!(journal["phase"], "uncertain");
+        assert_eq!(
+            journal["publication"]["source_shutdown"]["status"],
+            "closed"
+        );
+        assert_eq!(
+            journal["publication"]["source_model_shutdown"]["status"],
+            "pending"
+        );
+        assert_eq!(
+            journal["publication"]["source_model_shutdown"]["operation_id"],
+            marker_data["shutdown_id"]
+        );
+        let mut restore = tokio::process::Command::new(std::env::current_exe().unwrap());
+        restore
+            .arg("--exact")
+            .arg("session::continuity_tests::continuity_model_socket_restore_child")
+            .arg("--nocapture")
+            .env("TMPDIR", root.path())
+            .env("TURNLINK_TEST_MODEL_RESTORE_MARKER", &marker)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .kill_on_drop(true);
+        let output = tokio::time::timeout(std::time::Duration::from_secs(30), restore.output())
+            .await
+            .expect("fresh native restore must finish")
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "fresh restore failed: {} {}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert_eq!(std::fs::read(&journal_path).unwrap(), journal_bytes);
+    }
+}
