+        if !owner.is_open() || held.owner != *owner || held.reservation != *reservation
+            || !held.invalid || held.journal.schema < 8 || publication.operation_id != publication_id
+            || shutdown.operation_id != shutdown_id || shutdown.status != "closed"
+            || !held.target_step.as_ref().is_some_and(|current| Arc::ptr_eq(current, &target))
+            || !held.publication_mcp.as_ref().is_some_and(|current| Arc::ptr_eq(current, &installed))
+            || !held.mcp_binding.as_ref().is_some_and(|current| Arc::ptr_eq(current, &target._target.inputs.mcp))
+            || !Arc::ptr_eq(installed.destination(), &target._target.inputs.mcp_runtime)
+            || !Arc::ptr_eq(&self.services.mcp_runtime.load_full(), installed.destination())
+            || !held.publication_source_shutdown.as_ref().is_some_and(|proof| installed.destination_fenced_after_source_shutdown(proof))
+            || !published_model_pair_current(self, held, &state.session_configuration.provider)
+        { return Err(refused()); }
+        let persisted = read_journal(&path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if serde_json::to_vec(&persisted).map_err(|_| refused())?
+            != serde_json::to_vec(&held.journal).map_err(|_| refused())?
