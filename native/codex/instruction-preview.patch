+    /// Projection of rule constructors only. Values, provider, inputs and
+    /// session authority require separate codec coverage; this grants nothing.
+    pub(crate) fn native_recipes(&self, config: &Config) -> Option<serde_json::Value> {
+        if !self.has_closed_callback_state(config) { return None; }
+        let requirements = config.config_layer_stack.requirements();
+        if requirements.managed_hooks.is_some() { return None; }
+        let profile = config.permissions.permission_profile_state().native_constraint_recipe()?;
+        let residency = config.enforce_residency.native_recipe()?;
+        let requirement_residency = requirements.enforce_residency.value.native_recipe()?;
+        if residency.rule != "allow_any" || requirement_residency.rule != "allow_any" { return None; }
+        Some(serde_json::json!({
+            "version": 1,
+            "approval": serde_json::to_value(config.permissions.approval_policy.native_recipe()?).ok()?,
+            "permission": profile,
+            "residency": { "version": 1, "rule": residency.rule },
+            "mcp": serde_json::to_value(config.mcp_servers.native_empty_mcp_recipe()?).ok()?,
+            "web": serde_json::to_value(config.web_search_mode.native_recipe()?).ok()?,
+            "requirements": {
+                "approval": serde_json::to_value(requirements.approval_policy.value.native_recipe()?).ok()?,
+                "reviewer": serde_json::to_value(requirements.approvals_reviewer.value.native_recipe()?).ok()?,
+                "permission": serde_json::to_value(requirements.permission_profile.value.native_recipe()?).ok()?,
+                "windows": serde_json::to_value(requirements.windows_sandbox_mode.value.native_recipe()?).ok()?,
+                "web": serde_json::to_value(requirements.web_search_mode.value.native_recipe()?).ok()?,
+                "residency": { "version": 1, "rule": requirement_residency.rule }
+            }
+        }))
+    }
+    pub(crate) fn capture(config: &Config) -> Self {
+        let requirements = config.config_layer_stack.requirements();
+        Self {
+            approval: config.permissions.approval_policy.native_binding(),
+            permission_profile: config
+                .permissions
+                .permission_profile_state()
+                .native_constraint_binding(),
+            residency: config.enforce_residency.native_binding(),
+            mcp: config.mcp_servers.native_binding(),
+            web: config.web_search_mode.native_binding(),
+            requirement_approval: requirements.approval_policy.value.native_binding(),
+            requirement_reviewer: requirements.approvals_reviewer.value.native_binding(),
+            requirement_permission: requirements.permission_profile.value.native_binding(),
+            requirement_windows: requirements.windows_sandbox_mode.value.native_binding(),
+            requirement_web: requirements.web_search_mode.value.native_binding(),
+            requirement_residency: requirements.enforce_residency.value.native_binding(),
+            requirement_hooks: requirements
+                .managed_hooks
+                .as_ref()
+                .map(|rule| rule.value.native_binding()),
+        }
+    }
+    pub(crate) fn has_closed_callback_state(&self, config: &Config) -> bool {
+        self.matches(config)
+            && self.approval.has_closed_callback_state()
+            && self.permission_profile.has_closed_callback_state()
+            && self.residency.has_closed_callback_state()
+            && self.mcp.has_closed_callback_state()
+            && self.web.has_closed_callback_state()
+            && self.requirement_approval.has_closed_callback_state()
+            && self.requirement_reviewer.has_closed_callback_state()
+            && self.requirement_permission.has_closed_callback_state()
+            && self.requirement_windows.has_closed_callback_state()
+            && self.requirement_web.has_closed_callback_state()
+            && self.requirement_residency.has_closed_callback_state()
+            && self
+                .requirement_hooks
+                .as_ref()
+                .is_none_or(NativeConstraintBinding::has_closed_callback_state)
+    }
+
+    pub(crate) fn matches(&self, config: &Config) -> bool {
+        let requirements = config.config_layer_stack.requirements();
+        self.approval.matches(&config.permissions.approval_policy)
+            && config
+                .permissions
+                .permission_profile_state()
+                .matches_native_constraint_binding(&self.permission_profile)
+            && self.residency.matches(&config.enforce_residency)
+            && self.mcp.matches(&config.mcp_servers)
+            && self.web.matches(&config.web_search_mode)
+            && self
+                .requirement_approval
+                .matches(&requirements.approval_policy.value)
+            && self
+                .requirement_reviewer
+                .matches(&requirements.approvals_reviewer.value)
+            && self
+                .requirement_permission
+                .matches(&requirements.permission_profile.value)
+            && self
+                .requirement_windows
+                .matches(&requirements.windows_sandbox_mode.value)
+            && self
+                .requirement_web
+                .matches(&requirements.web_search_mode.value)
+            && self
+                .requirement_residency
+                .matches(&requirements.enforce_residency.value)
+            && match (&self.requirement_hooks, &requirements.managed_hooks) {
+                (Some(binding), Some(rule)) => binding.matches(&rule.value),
+                (None, None) => true,
+                _ => false,
+            }
+    }
+}
