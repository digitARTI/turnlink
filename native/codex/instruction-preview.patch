+        let (revoked, receiver) = tokio::sync::watch::channel(false);
+        let pin = Arc::new(std::sync::Mutex::new(Some(writer)));
+        arm_checkpoint_pin(owner, Arc::clone(&pin), revoked.clone());
+        held.checkpoint_snapshot = Some(RetainedCheckpointSnapshot {
+            digest: "fixture".into(), rollout: vec![1], journal: vec![2], revoked, pin,
+            _permit: slots.try_acquire_owned().expect("fixture slot"),
+        });
+        receiver
+    }
+    // Call under the state mutex immediately before publishing state
+    // changes. Without a retained snapshot existing behavior is unchanged.
+    pub(super) fn invalidate_checkpoint_before_mutation(&mut self) {
+        #[cfg(all(debug_assertions, unix))]
+        if self.held.as_ref().is_some_and(|held| held.checkpoint_snapshot.is_some()) {
+            self.invalidate();
+        }
+    }
+    #[cfg(test)]
+    pub(super) fn step_preparation_gate_for_test(
+        &self,
+    ) -> Option<Arc<std::sync::atomic::AtomicBool>> {
+        self.held
+            .as_ref()
+            .map(|held| Arc::clone(&held.step_preparing))
+    }
+
+    pub(super) fn is_restored_quarantine(&self) -> bool {
+        self.held.as_ref().is_some_and(|held| {
+            held.invalid
+                && !held.owner.is_open()
+                && held.original.is_none()
+                && held._mcp_requests.is_none()
+                && held.journal.phase != "released"
+        })
+    }
+
+    #[cfg(test)]
+    pub(super) fn provider_resource_for_test(
+        &self,
+    ) -> Option<tokio::sync::MutexGuard<'_, codex_model_provider::NativeConstructedProvider>> {
+        self.held
+            .as_ref()?
+            .provider_resource
+            .as_ref()?
+            .try_lock()
+            .ok()
+    }
+
+    #[cfg(test)]
+    pub(super) fn provider_resource_handle_for_test(
+        &self,
+    ) -> Option<Arc<tokio::sync::Mutex<codex_model_provider::NativeConstructedProvider>>> {
+        self.held.as_ref()?.provider_resource.as_ref().cloned()
+    }
+
+    pub(crate) fn invalidate(&mut self) {
+        if let Some(held) = self.held.as_mut() {
+            held.invalidate();
+        }
+        self.revision = self.revision.saturating_add(1);
+    }
+
+    pub(crate) fn check(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        self.check_owner_and_source(owner, reservation)?;
+        let held = self.held.as_ref().ok_or_else(refused)?;
+        #[cfg(all(debug_assertions, unix))]
+        if held.checkpoint_snapshot.as_ref().is_some_and(|snapshot| *snapshot.revoked.borrow()) { return Err(refused()); }
+        if held.journal.mcp_quiescence.is_some()
+            && !held
+                .mcp_quiescence_exclusion
+                .as_ref()
+                .is_some_and(|guard| guard.is_current())
+        {
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    // Used only by exact MCP observation/retry so they can journal a stale
+    // target exclusion. It retains all owner and source checks.
+    fn check_owner_and_source(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+    ) -> CodexResult<()> {
+        let held = self.held.as_ref().ok_or_else(refused)?;
+        if !owner.is_open()
+            || held.invalid
+            || !held
+                .source_mcp_observation
+                .as_ref()
+                .is_some_and(|observation| held.source_mcp_slot.native_is_current(observation))
+            || !held
+                .source_models_observation
+                .as_ref()
+                .is_some_and(|observation| held.source_models_slot.native_is_current(observation))
+            || !held
+                ._mcp_requests
+                .as_ref()
+                .is_some_and(|exclusion| exclusion.is_current())
+            || held.mcp_startup.as_ref().is_some_and(|startup| {
+                !held.source_mcp_observation.as_ref().is_some_and(|source| {
+                    startup
+                        .runtime()
+                        .shares_native_event_owner(source.runtime())
+                })
+            })
+            || &held.owner != owner
+            || &held.reservation != reservation
+            || self.revision != reservation.revision
+            || self.revision == u64::MAX
+        {
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn published(&mut self, revision: u64) {
+        if let Some(held) = self.held.as_mut() {
+            held.reservation.revision = revision;
+        }
+    }
+}
