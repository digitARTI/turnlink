+    /// Observe the exact operation marker in thread history after restoring a
+    /// publication journal. This is evidence only: the original owners and
+    /// external effects are not reconstructed and the thread remains fenced.
+    #[allow(dead_code)]
+    pub(crate) async fn continuity_observe_restored_publication(
+        &self,
+        owner: &ContinuityOwner,
+        operation_id: uuid::Uuid,
+    ) -> CodexResult<bool> {
+        if !owner.is_open() {
+            return Err(refused());
+        }
+        let path = self.continuity_receipt_path().await;
+        let (journal, target_cwd) = {
+            let state = self.state.lock().await;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            let journal = &held.journal;
+            let publication = journal.publication.as_ref().ok_or_else(refused)?;
+            if !held.invalid
+                || held.owner.is_open()
+                || held.original.is_some()
+                || held.source_mcp_observation.is_some()
+                || held._mcp_requests.is_some()
+                || ![7, 8, 9].contains(&journal.schema)
+                || publication.operation_id != operation_id
+                || journal.reservation != held.reservation
+            {
+                return Err(refused());
+            }
+            let target_cwd = journal.host_grant.as_ref().ok_or_else(refused)?.to.clone();
+            (journal.clone(), target_cwd)
+        };
+        let rollout_path = self
+            .current_rollout_path()
+            .await
+            .map_err(|_| refused())?
+            .ok_or_else(refused)?;
+        let (items, _, errors) = crate::rollout::RolloutRecorder::load_rollout_items(&rollout_path)
+            .await
+            .map_err(|_| refused())?;
+        if errors != 0 {
+            return Err(refused());
+        }
+        let marker = operation_id.to_string();
+        let mut found = false;
+        for item in items {
+            if let codex_history::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadSettingsApplied(event),
+            ) = item
+                && event.continuity_operation_id.as_deref() == Some(marker.as_str())
+            {
+                if found
+                    || event.thread_id != Some(self.thread_id)
+                    || event.thread_settings.cwd != target_cwd
+                {
+                    return Err(refused());
+                }
+                found = true;
+            }
+        }
+        let state = self.state.lock().await;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let persisted = read_journal(&path, &self.thread_id.to_string())?.ok_or_else(refused)?;
+        if !owner.is_open()
+            || !held.invalid
+            || held.owner.is_open()
+            || serde_json::to_vec(&held.journal).map_err(|_| refused())?
+                != serde_json::to_vec(&journal).map_err(|_| refused())?
+            || serde_json::to_vec(&persisted).map_err(|_| refused())?
+                != serde_json::to_vec(&journal).map_err(|_| refused())?
+            || (journal
+                .publication
+                .as_ref()
+                .is_some_and(|p| p.status == "installed")
+                && !found)
+        {
+            return Err(refused());
+        }
+        Ok(found)
+    }
