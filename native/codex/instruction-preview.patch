+// Revalidation may perform bounded reads already disclosed by the retained
+// step grant. Never invoke it while holding session or persistence locks.
+async fn native_target_contributors_current(
+    session: &Session,
+    step_store: &codex_extension_api::ExtensionData,
+) -> bool {
+    for contributor in session.services.extensions.tool_contributors() {
+        if let Some(check) = contributor.native_target_step_revalidate(step_store)
+            && !check.await
+        {
+            return false;
+        }
+    }
+    true
+}
