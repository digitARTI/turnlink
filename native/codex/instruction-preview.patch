+/// Duplicates the caller-owned descriptor and marks the original close-on-exec.
+/// Only a connected local stream is accepted. The original descriptor remains
+/// the caller's responsibility; this does not prove a complete alias census.
+pub(crate) fn inherited_stream(fd: i32) -> io::Result<UnixStream> {
+    if fd < 3 {
+        return Err(io::Error::other("native control descriptor unavailable"));
+    }
+    // SAFETY: fcntl accepts raw descriptor integers and returns errors for invalid
+    // ones. The new descriptor is uniquely owned after successful duplication.
+    let copied = unsafe { libc::fcntl(fd, libc::F_DUPFD_CLOEXEC, 3) };
+    if copied < 0 {
+        return Err(io::Error::other("native control descriptor unavailable"));
+    }
+    // SAFETY: copied was just allocated by fcntl and has no other Rust owner.
+    let owned = unsafe { OwnedFd::from_raw_fd(copied) };
+    let stream = std::os::unix::net::UnixStream::from(owned);
+    stream
+        .peer_addr()
+        .map_err(|_| io::Error::other("native control peer unavailable"))?;
+    let mut kind: libc::c_int = 0;
+    let mut kind_len = std::mem::size_of_val(&kind) as libc::socklen_t;
+    // SAFETY: kind and kind_len are writable storage of the supplied size.
+    if unsafe {
+        libc::getsockopt(
+            copied,
+            libc::SOL_SOCKET,
+            libc::SO_TYPE,
+            (&raw mut kind).cast(),
+            &mut kind_len,
+        )
+    } != 0
+        || kind != libc::SOCK_STREAM
+    {
+        return Err(io::Error::other("native control requires a local stream"));
+    }
+    // A TCP socket can otherwise be wrapped by UnixStream: require AF_UNIX.
+    let mut address: libc::sockaddr_storage = unsafe { std::mem::zeroed() };
+    let mut length = std::mem::size_of_val(&address) as libc::socklen_t;
+    // SAFETY: address and length are valid writable storage of the supplied size.
+    let local = unsafe { libc::getsockname(copied, (&raw mut address).cast(), &mut length) };
+    if local != 0 || address.ss_family as i32 != libc::AF_UNIX {
+        return Err(io::Error::other("native control requires a local stream"));
+    }
+    // SAFETY: descriptor operations return an error if a caller closed fd.
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };
+    if flags < 0 || unsafe { libc::fcntl(fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) } < 0 {
+        return Err(io::Error::other("native control descriptor unavailable"));
+    }
+    stream.set_nonblocking(true)?;
+    UnixStream::from_std(stream)
+}
+
+async fn frame<R: tokio::io::AsyncBufRead + Unpin>(reader: &mut R) -> io::Result<Option<Request>> {
+    let mut bytes = Vec::new();
+    loop {
+        let pending = reader.fill_buf().await?;
+        if pending.is_empty() {
+            return if bytes.is_empty() {
+                Ok(None)
+            } else {
+                Err(io::Error::other("incomplete native control frame"))
+            };
+        }
+        let end = pending.iter().position(|b| *b == b'\n');
+        let take = end.map_or(pending.len(), |index| index + 1);
+        if bytes.len() + take > MAX_FRAME {
+            return Err(io::Error::other("native control frame too large"));
+        }
+        bytes.extend_from_slice(&pending[..take]);
+        reader.consume(take);
+        if end.is_some() {
+            return serde_json::from_slice(&bytes)
+                .map(Some)
+                .map_err(|_| io::Error::other("invalid native control frame"));
+        }
+    }
+}
