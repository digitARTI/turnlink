+/// Retain the actual directory, not just a canonical pathname observation.
+struct DirectoryIdentity {
+    requested: AbsolutePathBuf,
+    canonical: PathBuf,
+    directory: File,
+}
+
+impl DirectoryIdentity {
+    fn capture(requested: &AbsolutePathBuf, require_canonical: bool) -> CodexResult<Self> {
+        let canonical = fs::canonicalize(requested.as_path()).map_err(|_| refused())?;
+        if require_canonical && canonical != requested.as_path() {
+            return Err(refused());
+        }
+        let directory = Self::open(&canonical)?;
+        let identity = Self {
+            requested: requested.clone(),
+            canonical,
+            directory,
+        };
+        identity.validate()?;
+        Ok(identity)
+    }
+
+    #[cfg(unix)]
+    fn open(path: &Path) -> CodexResult<File> {
+        use std::os::unix::fs::OpenOptionsExt;
+        fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_DIRECTORY)
+            .open(path)
+            .map_err(|_| refused())
+    }
+
+    #[cfg(not(unix))]
+    fn open(_path: &Path) -> CodexResult<File> {
+        // Native Windows directory identity/durability is not implemented yet.
+        Err(refused())
+    }
+
+    fn validate(&self) -> CodexResult<()> {
+        if fs::canonicalize(self.requested.as_path()).map_err(|_| refused())? != self.canonical {
+            return Err(refused());
+        }
+        let observed = Self::open(&self.canonical)?
+            .metadata()
+            .map_err(|_| refused())?;
+        let retained = self.directory.metadata().map_err(|_| refused())?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if !observed.is_dir()
+                || !retained.is_dir()
+                || observed.dev() != retained.dev()
+                || observed.ino() != retained.ino()
+            {
+                return Err(refused());
+            }
+            Ok(())
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = (observed, retained);
+            Err(refused())
+        }
+    }
+}
+
+fn same_preparation_bindings(
+    left: &TurnEnvironmentSnapshot,
+    right: &TurnEnvironmentSnapshot,
+) -> bool {
+    left.environments.len() == right.environments.len()
+        && left
+            .environments
+            .iter()
+            .zip(right.environments.iter())
+            .all(|(left, right)| {
+                let (TurnEnvironmentState::Ready(left), TurnEnvironmentState::Ready(right)) =
+                    (left, right)
+                else {
+                    return false;
+                };
+                left.selection == right.selection
+                    && left.config_origin == right.config_origin
+                    && Arc::ptr_eq(&left.environment, &right.environment)
+                    && Arc::ptr_eq(&left.shell_snapshot_cache, &right.shell_snapshot_cache)
+                    && left.executor_platform_os == right.executor_platform_os
+                    && left.user_home_dir == right.user_home_dir
+                    && left.temporary_directories == right.temporary_directories
+            })
+}
