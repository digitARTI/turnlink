+        let mut clone = value.clone();
+        let binding = value.native_binding();
+        clone.set(8).unwrap();
+        assert!(binding.matches(&clone));
+        assert!(value.has_same_enforcers(&clone));
+        assert_ne!(
+            value, clone,
+            "values and enforcement lineage have separate contracts"
+        );
+        drop(value);
+        assert!(binding.clone().matches(&clone));
+    }
+
+    #[test]
+    fn native_authority_binding_rejects_equal_values_and_cross_type_substitution() {
+        let source = Constrained::allow_only(7_i32);
+        let replacement = Constrained::allow_any(7_i32);
+        assert_eq!(source, replacement);
+        assert!(!source.native_binding().matches(&replacement));
+        assert!(!source.has_same_enforcers(&replacement));
+        assert!(
+            !source
+                .native_binding()
+                .matches(&Constrained::allow_any(7_i64))
+        );
+    }
+
+    #[test]
+    fn native_authority_binding_detects_composition_without_sampling_validator() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let count = calls.clone();
+        let mut source = Constrained::new(7, move |_| {
+            count.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        })
+        .unwrap();
+        let binding = source.native_binding();
+        source.add_validator(|_| Ok(())).unwrap();
+        let before = calls.load(Ordering::SeqCst);
+        assert!(!binding.matches(&source));
+        assert_eq!(calls.load(Ordering::SeqCst), before);
+    }
+
+    #[test]
+    fn native_authority_binding_detects_normalizer_only_replacement_without_calling_it() {
+        let source = Constrained::normalized(7, |value| value).unwrap();
+        let mut replacement = source.clone();
+        replacement.normalizer = Some(Arc::new(|_| {
+            panic!("metadata inspection must not normalize")
+        }));
+        assert_eq!(source, replacement);
+        assert!(Arc::ptr_eq(&source.validator, &replacement.validator));
+        assert!(!source.native_binding().matches(&replacement));
+        assert!(!source.has_same_enforcers(&replacement));
+        replacement.normalizer = None;
+        assert!(!source.native_binding().matches(&replacement));
+    }
+
+    #[test]
+    fn native_authority_binding_does_not_claim_mutable_callback_state_freshness() {
+        let enabled = Arc::new(AtomicUsize::new(1));
+        let state = enabled.clone();
+        let source = Constrained::new(7, move |_| {
+            if state.load(Ordering::SeqCst) == 1 {
+                Ok(())
+            } else {
+                Err(ConstraintError::InvalidValue {
+                    field_name: "fixture",
+                    candidate: "7".into(),
+                    allowed: "none".into(),
+                    requirement_source: RequirementSource::Unknown,
+                })
+            }
+        })
+        .unwrap();
+        let binding = source.native_binding();
+        enabled.store(0, Ordering::SeqCst);
+        assert!(
+            binding.matches(&source),
+            "allocation lineage alone is not mutable state freshness"
+        );
+        assert!(source.can_set(&7).is_err());
+    }
+    #[test]
+    fn closed_native_rules_do_not_treat_an_opaque_callback_as_observed_state() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let calls = Arc::new(AtomicUsize::new(0));
+        let seen = calls.clone();
+        let source = Constrained::new(7, move |_| {
+            seen.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        })
+        .unwrap();
+        let before = calls.load(Ordering::SeqCst);
+        let binding = source.native_binding();
+        assert!(binding.matches(&source));
+        assert!(!binding.has_closed_callback_state());
+        assert!(!source.has_closed_callback_state());
+        assert_eq!(calls.load(Ordering::SeqCst), before);
+        assert!(
+            !Constrained::normalized(7, |value| value)
+                .unwrap()
+                .has_closed_callback_state()
+        );
+    }
+
+    #[test]
+    fn closed_native_rules_preserve_identity_and_invalidate_unknown_composition() {
+        let mut source = Constrained::allow_any(7);
+        let bound = source.native_binding();
+        assert!(bound.has_closed_callback_state());
+        source.set(9).unwrap();
+        assert!(bound.matches(&source));
+        source.add_validator(|_| Ok(())).unwrap();
+        assert!(!bound.matches(&source));
+        assert!(!source.has_closed_callback_state());
+        assert!(Constrained::allow_only(7).has_closed_callback_state());
+    }
+
+    #[test]
+    fn closed_native_rules_reject_mutable_values_hidden_behind_equality() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        #[derive(Clone, Debug)]
+        struct Mutable(Arc<AtomicUsize>);
+        impl PartialEq for Mutable {
+            fn eq(&self, other: &Self) -> bool {
+                self.0.load(Ordering::SeqCst) == other.0.load(Ordering::SeqCst)
+            }
+        }
+        let value = Mutable(Arc::new(AtomicUsize::new(1)));
+        let source = Constrained::allow_only(value.clone());
+        value.0.store(2, Ordering::SeqCst);
+        assert!(!source.native_binding().has_closed_callback_state());
+    }
+
+    #[test]
+    fn closed_native_rules_projection_preserves_only_a_known_base_rule() {
+        use codex_protocol::models::{PermissionProfile, PermissionProfileSnapshot};
+        let profile = PermissionProfile::read_only();
+        let projected = Constrained::from_native_permission_profile(
+            Constrained::allow_only(profile.clone()),
+            PermissionProfileSnapshot::legacy(profile.clone()),
+        )
+        .unwrap();
+        assert!(projected.has_closed_callback_state());
+        let opaque = Constrained::new(profile.clone(), |_| Ok(())).unwrap();
+        let projected = Constrained::from_native_permission_profile(
+            opaque,
+            PermissionProfileSnapshot::legacy(profile),
+        )
+        .unwrap();
+        assert!(!projected.has_closed_callback_state());
+    }
+
+    #[test]
+    fn closed_native_rules_preserve_real_requirement_enforcement() {
+        use codex_protocol::models::PermissionProfile;
+        let mut profile = Constrained::allow_any(PermissionProfile::read_only());
+        profile
+            .add_native_deny_read_requirement(RequirementSource::Unknown)
+            .unwrap();
+        assert!(profile.has_closed_callback_state());
+        assert!(profile.set(PermissionProfile::Disabled).is_err());
+        let servers =
+            Constrained::from_native_mcp_requirements(std::collections::HashMap::new(), None)
+                .unwrap();
+        assert!(servers.has_closed_callback_state());
+    }
+}
+
+#[cfg(test)]
+mod native_intersection_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    #[test]
+    fn native_rule_intersection_retains_source_selection_and_both_enforcers() {
+        let source = Constrained::allow_only(7_i32);
+        let destination = Constrained::allow_any(3_i32);
+        let mut combined = source.intersect_native_rules(&destination).unwrap();
+        assert_eq!(combined.value(), 7);
+        assert!(combined.has_closed_callback_state());
+        assert!(!combined.has_same_enforcers(&source));
+        assert!(combined.set(8).is_err());
+        let mut combined = Constrained::allow_any(7_i32)
+            .intersect_native_rules(&Constrained::allow_only(7_i32))
+            .unwrap();
+        assert!(combined.set(8).is_err());
+        assert!(
+            source
+                .intersect_native_rules(&Constrained::allow_only(9_i32))
+                .is_err()
+        );
+        assert_eq!(source.value(), 7);
+        assert_eq!(destination.value(), 3);
+    }
+
+    #[test]
+    fn native_rule_intersection_refuses_opaque_rules_without_invoking_them() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let seen = calls.clone();
+        let opaque = Constrained::new(7_i32, move |_| {
+            seen.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        })
+        .unwrap();
+        let before = calls.load(Ordering::SeqCst);
+        let native = Constrained::allow_any(7_i32);
+        assert!(opaque.intersect_native_rules(&native).is_err());
+        assert!(native.intersect_native_rules(&opaque).is_err());
+        assert_eq!(calls.load(Ordering::SeqCst), before);
+        let normalizer = Constrained::normalized(7_i32, |value| value).unwrap();
+        assert!(native.intersect_native_rules(&normalizer).is_err());
+    }
+
+    #[test]
+    fn native_rule_intersection_refuses_unknown_clone_implementations_before_cloning() {
+        struct Unknown(Arc<AtomicUsize>);
+        impl Clone for Unknown {
+            fn clone(&self) -> Self {
+                self.0.fetch_add(1, Ordering::SeqCst);
+                Self(self.0.clone())
+            }
+        }
+        let calls = Arc::new(AtomicUsize::new(0));
+        let source = Constrained::allow_any(Unknown(calls.clone()));
+        let destination = Constrained::allow_any(Unknown(calls.clone()));
+        assert!(source.intersect_native_rules(&destination).is_err());
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+    }
+}
