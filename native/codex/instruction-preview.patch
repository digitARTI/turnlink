+async fn render_memory_context(config: &MemoriesExtensionConfig) -> Vec<PromptFragment> {
+    if !config.enabled {
+        return Vec::new();
+    }
+    let Some(instructions) =
+        build_memory_tool_developer_instructions(&config.codex_home, config.version).await
