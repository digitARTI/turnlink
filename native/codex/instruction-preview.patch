+#[tokio::test]
+async fn tool_preparation_preserves_live_mcp_definitions_handlers_and_search_cache() {
+    use crate::session::step_context::StepContext;
+    use crate::tools::spec_plan::{
+        build_detached_tool_router, build_tool_router, preview_tool_router,
+    };
+    use core_test_support::apps_test_server::AppsTestServer;
+    use serde_json::json;
+    use std::sync::Mutex;
+    use wiremock::MockServer;
+    let mut fixtures = Vec::new();
+    for name in ["source_tool", "destination_tool"] {
+        let server = MockServer::start().await;
+        AppsTestServer::mount_with_tools(
+            &server,
+            Arc::new(Mutex::new(vec![json!({
+                "name": name, "description": format!("{name} description"),
+                "inputSchema": {"type":"object", "properties": {}}
+            })])),
+        )
+        .await
+        .unwrap();
+        let fixture = crate::session::tests::tool_preparation_mcp_fixture(format!(
+            "{}/api/codex/ps/mcp/",
+            server.uri()
+        ))
+        .await;
+        fixtures.push((server, fixture));
+    }
+    let (server, (_, session, turn, source)) = &fixtures[0];
+    let (destination_server, (_, _, _, destination)) = &fixtures[1];
+    let step = StepContext::for_test(turn.clone());
+    let build = |binding| {
+        build_tool_router(
+            session,
+            turn,
+            &step.settings.model_info,
+            &step.environments,
+            binding,
+            false,
+            &turn.extension_data,
+            None,
+        )
+        .unwrap()
+    };
+    let baseline = build(source);
+    let source_name = source.tools()[0].canonical_tool_name();
+    let source_runtime = baseline
+        .registered_tool(&source_name)
+        .unwrap()
+        .runtime
+        .clone();
+    let search_name = ToolName::plain("tool_search");
+    let search_runtime = baseline
+        .registered_tool(&search_name)
+        .unwrap()
+        .runtime
+        .clone();
+    let definitions = session.services.mcp_manager.shared_definitions();
+    let before_definitions = definitions.definitions.lock().unwrap().len();
+    let before_handlers = session
+        .services
+        .mcp_handler_cache
+        .handlers
+        .lock()
+        .unwrap()
+        .iter()
+        .map(|(name, value)| (name.clone(), Arc::as_ptr(&value.handler) as usize))
+        .collect::<HashMap<_, _>>();
+    let requests = server.received_requests().await.unwrap().len();
+    let destination_requests = destination_server.received_requests().await.unwrap().len();
+    let prepared = preview_tool_router(
+        session,
+        turn,
+        &step.settings.model_info,
+        &step.environments,
+        source,
+        false,
+        None,
+    )
+    .unwrap();
+    assert!(prepared == baseline.preparation_snapshot());
+    let changed = preview_tool_router(
+        session,
+        turn,
+        &step.settings.model_info,
+        &step.environments,
+        destination,
+        false,
+        None,
+    )
+    .unwrap();
+    assert!(
+        changed
+            .tools
+            .iter()
+            .any(|tool| tool.name == destination.tools()[0].canonical_tool_name())
+    );
+    assert!(!changed.tools.iter().any(|tool| tool.name == source_name));
+    let detached = build_detached_tool_router(
+        session,
+        turn,
+        &step.settings.model_info,
+        &step.environments,
+        destination,
+        false,
+        &turn.extension_data,
+        None,
+    )
+    .unwrap();
+    let destination_name = destination.tools()[0].canonical_tool_name();
+    assert!(detached.registered_tool(&destination_name).is_some());
+    assert!(detached.registered_tool(&source_name).is_none());
+    assert!(changed == detached.preparation_snapshot());
+    assert_eq!(
+        definitions.definitions.lock().unwrap().len(),
+        before_definitions
+    );
+    let after_handlers = session
+        .services
+        .mcp_handler_cache
+        .handlers
+        .lock()
+        .unwrap()
+        .iter()
+        .map(|(name, value)| (name.clone(), Arc::as_ptr(&value.handler) as usize))
+        .collect::<HashMap<_, _>>();
+    assert_eq!(after_handlers, before_handlers);
+    let after = build(source);
+    assert!(Arc::ptr_eq(
+        &source_runtime,
+        &after.registered_tool(&source_name).unwrap().runtime
+    ));
+    assert!(Arc::ptr_eq(
+        &search_runtime,
+        &after.registered_tool(&search_name).unwrap().runtime
+    ));
+    assert_eq!(server.received_requests().await.unwrap().len(), requests);
+    assert_eq!(
+        destination_server.received_requests().await.unwrap().len(),
+        destination_requests
+    );
+    for (_, (_, session, _, _)) in &fixtures {
+        session.services.mcp_runtime.load_full().shutdown().await;
+    }
+}
