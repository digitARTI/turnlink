+    /// Private host path. Retains native Config and source handles, never reconstructs
+    /// an executable plan from its JSON disclosure. Repeated preparation is refused.
+    pub(crate) fn continuity_plan_provider<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
