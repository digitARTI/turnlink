+    pub(crate) fn continuity_plan_provider_with_model_context<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+        model_context: bool,
+    ) -> futures::future::BoxFuture<'a, CodexResult<codex_protocol::protocol::ContinuityProviderPlan>>
+    {
+        self.continuity_plan_provider_effects(owner, reservation, cwd, model_context, false)
+    }
+
+    pub(crate) fn continuity_plan_provider_effects<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+        model_context: bool,
+        refresh_catalog: bool,
+    ) -> futures::future::BoxFuture<'a, CodexResult<codex_protocol::protocol::ContinuityProviderPlan>>
+    {
+        async move {
+            use sha2::{Digest, Sha256};
+            if refresh_catalog && !model_context {
+                return Err(refused());
+            }
+            let candidate = {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                state
+                    .continuity
+                    .held
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .destination_candidate
+                    .clone()
+            };
+            if let Some(candidate) = &candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let preparation = self
+                .continuity_prepare_provider(owner, reservation, cwd.clone())
+                .await?;
+            let family = match preparation.provider.resources().family() {
+                codex_model_provider::NativeProviderFamily::Configured => "configured",
+                codex_model_provider::NativeProviderFamily::GoogleCloud => "gcp",
+                codex_model_provider::NativeProviderFamily::AmazonBedrock => "bedrock",
+            };
+            let mut disclosure = codex_protocol::protocol::ContinuityProviderPlan {
+                id: uuid::Uuid::new_v4(),
+                kind: if refresh_catalog {
+                    "provider_catalog"
+                } else if model_context {
+                    "provider_context"
+                } else {
+                    "provider_factory"
+                }
+                .into(),
+                harness: "codex".into(),
+                process_generation: provider_process_generation(),
+                agent_id: format!("codex:{}", self.thread_id),
+                reservation: reservation.clone(),
+                from: preparation
+                    .configuration
+                    .inputs
+                    .source_configuration
+                    .legacy_fallback_cwd
+                    .clone(),
+                to: cwd,
+                provider_id: preparation.provider.selected_id().into(),
+                family: family.into(),
+                model_context: model_context.then(|| {
+                    codex_protocol::protocol::ContinuityProviderModelContext {
+                        model: preparation
+                            .configuration
+                            .runtime_configuration()
+                            .step_settings
+                            .collaboration_mode
+                            .model()
+                            .to_owned(),
+                        catalog_source: if preparation
+                            .configuration
+                            .config()
+                            .model_catalog
+                            .is_some()
+                        {
+                            "configured"
+                        } else {
+                            "provider-default"
+                        }
+                        .into(),
+                        api_key_discovery: preparation
+                            .configuration
+                            .config()
+                            .features
+                            .enabled(codex_features::Feature::ApiKeyModelDiscovery),
+                        cache: "native".into(),
+                    }
+                }),
+                catalog_effects: refresh_catalog.then(|| {
+                    codex_protocol::protocol::ContinuityCatalogEffects {
+                        network: "native-provider-catalog".into(),
+                        credentials: "native-provider-auth".into(),
+                        cache: "native-model-cache".into(),
+                    }
+                }),
+                digest: String::new(),
+            };
+            if refresh_catalog
+                && (preparation.configuration.config().model_catalog.is_some()
+                    || family != "configured")
+            {
+                return Err(refused());
+            }
+            if disclosure
+                .model_context
+                .as_ref()
+                .is_some_and(|context| context.model.is_empty() || context.model.len() > 200)
+                || disclosure.from == disclosure.to
+                || disclosure.provider_id.len() > 200
+                || disclosure.from.as_path().to_string_lossy().len() > 2048
+                || disclosure.to.as_path().to_string_lossy().len() > 2048
+            {
+                return Err(refused());
+            }
+            // Disclosure commitment, not a complete configuration/authority digest.
+            let bytes =
+                serde_json::to_vec(&(&disclosure, preparation.provider.destination_definition()))
+                    .map_err(|_| refused())?;
+            let mut digest = Sha256::new();
+            digest.update(bytes);
+            if model_context {
+                let config = preparation
+                    .configuration
+                    .runtime_configuration()
+                    .model_info_overrides
+                    .models_manager_config(
+                        preparation
+                            .configuration
+                            .runtime_configuration()
+                            .step_settings
+                            .personality,
+                    );
+                digest.update(
+                    serde_json::to_vec(&(
+                        &preparation.configuration.config().model_catalog,
+                        config.model_context_window,
+                        config.model_auto_compact_token_limit,
+                        config.tool_output_token_limit,
+                        &config.base_instructions,
+                        config.personality,
+                    ))
+                    .map_err(|_| refused())?,
+                );
+            }
+            disclosure.digest = format!("{:x}", digest.finalize());
+            if let Some(candidate) = &candidate {
+                if candidate.preparation.configured_config() != preparation.configuration.config() {
+                    return Err(refused());
+                }
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let mut state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.phase != "acquired"
+                || held.approved.is_some()
+                || held.provider_plan.is_some()
+                || !same_destination_candidate(&held.destination_candidate, &candidate)
+                || held
+                    .mcp_plan
+                    .as_ref()
+                    .is_some_and(|plan| !plan.matches_target(&disclosure.to))
+            {
+                return Err(refused());
+            }
+            held.provider_plan = Some(Arc::new(RetainedProviderPlan {
+                disclosure: disclosure.clone(),
+                preparation,
+                destination_candidate: candidate,
+            }));
+            Ok(disclosure)
+        }
+        .boxed()
+    }
+
+    /// Fresh broker verification is the trusted host's responsibility. This path
+    /// accepts only its exact separate scope and consumes the retained native plan.
+    /// Once started, no legacy commit/release can discard resource ownership.
+    pub(crate) fn continuity_construct_provider<'a>(
+        self: &'a Arc<Self>,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        grant: codex_protocol::protocol::ContinuityProviderGrant,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityProviderReceipt>,
+    > {
+        async move {
+            let (plan, mcp_plan) = {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if held.journal.phase != "acquired"
+                    || held.approved.is_some()
+                    || held.journal.provider_grant.is_some()
+                    || held.journal.mcp_shutdown_id.is_some()
+                    || held
+                        .journal
+                        .mcp_receipt
+                        .as_ref()
+                        .is_some_and(|r| r.phase != "constructed")
+                {
+                    return Err(refused());
+                }
+                (
+                    held.provider_plan.clone().ok_or_else(refused)?,
+                    held.mcp_plan.clone(),
+                )
+            };
+            let valid_digest = |v: &str| {
+                v.len() == 64
+                    && v.bytes()
+                        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+            };
+            if grant.provider_plan != plan.disclosure
+                || grant.configuration_digest != plan.disclosure.digest
+                || grant.purpose != "establish-provider"
+                || grant.status != "prepared"
+                || grant.agent_id != plan.disclosure.agent_id
+                || grant.from != plan.disclosure.from
+                || grant.to != plan.disclosure.to
+                || grant.channel.is_empty()
+                || grant.channel.len() > 64
+                || !grant
+                    .channel
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+                || grant.claim_generation == 0
+                || grant.claim_generation > 9_007_199_254_740_991
+                || grant.prepared_at > 9_007_199_254_740_991
+                || !valid_digest(&grant.configuration_digest)
+            {
+                return Err(refused());
+            }
+            self.continuity_validate_provider_preparation(owner, &plan.preparation)
+                .await?;
+            if let Some(candidate) = &plan.destination_candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            if let Some(mcp) = &mcp_plan {
+                if !mcp.matches_target(&grant.to)
+                    || mcp.preparation.config() != plan.preparation.configuration.config()
+                    || !same_destination_candidate(
+                        &mcp.destination_candidate,
+                        &plan.destination_candidate,
+                    )
+                {
+                    return Err(refused());
+                }
+                self.continuity_validate_configuration_preparation(owner, &mcp.preparation)
+                    .boxed()
+                    .await?;
+                self.continuity_validate_provider_preparation(owner, &plan.preparation)
+                    .await?;
+            }
+            if let Some(candidate) = &plan.destination_candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let path = self.continuity_receipt_path().await;
+            let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+            let mut state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.phase != "acquired"
+                || held.approved.is_some()
+                || !same_destination_candidate(
+                    &held.destination_candidate,
+                    &plan.destination_candidate,
+                )
+                || held.journal.mcp_shutdown_id.is_some()
+                || match (&mcp_plan, &held.mcp_plan) {
+                    (Some(expected), Some(current)) => {
+                        !Arc::ptr_eq(expected, current)
+                            || held.journal.mcp_plan.as_ref() != Some(&expected.disclosure)
+                    }
+                    (None, None) => false,
+                    _ => true,
+                }
+                || !held
+                    .provider_plan
+                    .as_ref()
+                    .is_some_and(|current| Arc::ptr_eq(current, &plan))
+                || held
+                    .journal
+                    .history
+                    .iter()
+                    .any(|receipt| receipt.transition_id == grant.id)
+            {
+                return Err(refused());
+            }
+            // No await from durable pending record through factory and ownership
+            // retention: cancellation cannot drop an unregistered successful result.
+            let mut journal = held.journal.clone();
+            journal.phase = "provider_pending".into();
+            journal.transition_id = Some(grant.id);
+            journal.cwd = Some(grant.to.clone());
+            journal.provider_grant = Some(grant.clone());
+            journal.provider_receipt = Some(codex_protocol::protocol::ContinuityProviderReceipt {
+                transition_id: grant.id,
+                plan_id: plan.disclosure.id,
+                reservation: reservation.clone(),
+                resource_id: uuid::Uuid::new_v4(),
+                process_generation: plan.disclosure.process_generation,
+                kind: plan.disclosure.kind.clone(),
+                phase: "pending".into(),
+            });
+            held.journal = journal;
+            if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                held.invalidate();
+                return Err(refused());
+            }
+            // Move the owned native preparation only after the pending record.
+            drop(plan);
+            let retained = held.provider_plan.take().ok_or_else(refused)?;
+            let retained = Arc::try_unwrap(retained).map_err(|_| {
+                held.invalidate();
+                refused()
+            })?;
+            let ContinuityProviderPreparation {
+                configuration,
+                provider,
+            } = *retained.preparation;
+            // Retain Config and directory identities even on a constructor error.
+            let configuration = Box::new(configuration);
+            let result = provider.construct_destination(
+                &configuration.runtime_configuration().provider,
+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            );
+            held.provider_configuration = Some(configuration);
+            let resource = match result {
+                Ok(resource) => resource,
+                Err(_) => {
+                    tracing::debug!(stage = "provider-factory", "native construction refused");
+                    held.invalidate();
+                    return Err(refused());
+                }
+            };
+            held.provider_resource = Some(Arc::new(tokio::sync::Mutex::new(resource)));
+            held.journal.phase = "provider_retained".into();
+            held.journal
+                .provider_receipt
+                .as_mut()
+                .ok_or_else(refused)?
+                .phase = "retained".into();
+            if let Some(context) = &retained.disclosure.model_context {
+                let configuration = held.provider_configuration.as_ref().ok_or_else(refused)?;
+                let runtime = configuration.runtime_configuration();
+                let mut config = runtime
+                    .model_info_overrides
+                    .models_manager_config(runtime.step_settings.personality);
+                config.model_catalog = configuration.config().model_catalog.clone();
+                if held
+                    .provider_resource
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .try_lock()
+                    .map_err(|_| refused())?
+                    .construct_model_context(
+                        configuration.config().codex_home.to_path_buf(),
+                        configuration.config().model_catalog.clone(),
+                        context.api_key_discovery,
+                        &context.model,
+                        config,
+                    )
+                    .is_err()
+                {
+                    tracing::debug!(stage = "provider-model-context", "native construction refused");
+                    held.invalidate();
+                    return Err(refused());
+                }
+                if !held
+                    .provider_resource
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .try_lock()
+                    .map_err(|_| refused())?
+                    .revalidate(
+                        &runtime.provider,
+                        &configuration.config().model_providers,
+                        configuration
+                            .config()
+                            .config_layer_stack
+                            .required_model_provider(),
+                    )
+                    .unwrap_or(false)
+                {
+                    tracing::debug!(stage = "provider-model-revalidate", "native construction refused");
+                    held.invalidate();
+                    return Err(refused());
+                }
+            }
+            if retained.disclosure.catalog_effects.is_some() {
+                // Persist and register the actual resource before spawning. The
+                // worker owns its Arc/Session even if the request receiver drops.
+                held.journal.phase = "provider_catalog_pending".into();
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    // No worker/effect started. Keep exact ownership observable
+                    // and permit the existing unused-owner cleanup protocol.
+                    held.invalidate();
+                    held.journal.phase = "uncertain".into();
+                    return Err(refused());
+                }
+                let resource = held.provider_resource.as_ref().ok_or_else(refused)?.clone();
+                let session = Arc::clone(self);
+                let worker_owner = owner.clone();
+                let worker_reservation = reservation.clone();
+                let transition_id = grant.id;
+                let (reply, receive) = tokio::sync::oneshot::channel();
+                drop(state);
+                drop(_settings);
+                tokio::spawn(async move {
+                    let mut actual = resource.clone().lock_owned().await;
+                    let factory = session.services.auth_manager.http_client_factory();
+                    let result = actual.refresh_model_context_catalog(factory).await;
+                    let succeeded =
+                        result.is_ok() && actual.catalog_context_is_current().unwrap_or(false);
+                    drop(actual);
+                    let _settings =
+                        super::thread_settings::acquire_persistence_lock(&session).await;
+                    let mut state = session.state.lock().await;
+                    let Some(held) = state.continuity.held.as_mut() else {
+                        let _ = reply.send(Err(refused()));
+                        return;
+                    };
+                    if held.owner != worker_owner
+                        || held.reservation != worker_reservation
+                        || held.journal.transition_id != Some(transition_id)
+                        || !held
+                            .provider_resource
+                            .as_ref()
+                            .is_some_and(|current| Arc::ptr_eq(current, &resource))
+                    {
+                        let _ = reply.send(Err(refused()));
+                        return;
+                    }
+                    if !succeeded || !worker_owner.is_open() || held.invalid {
+                        held.invalidate();
+                        held.journal.phase = "uncertain".into();
+                        let _ = write_journal(&path, &held.journal);
+                        let _ = reply.send(Err(refused()));
+                        return;
+                    }
+                    let Some(mut receipt) = held.journal.provider_receipt.clone() else {
+                        let _ = reply.send(Err(refused()));
+                        return;
+                    };
+                    receipt.phase = "constructed".into();
+                    held.journal.phase = "provider_constructed".into();
+                    held.journal.provider_receipt = Some(receipt.clone());
+                    if write_journal(&path, &held.journal).is_err() {
+                        held.invalidate();
+                        let _ = reply.send(Err(refused()));
+                        return;
+                    }
+                    // Do not report completed construction while this worker
+                    // still owns an otherwise unnecessary resource alias.
+                    drop(resource);
+                    let _ = reply.send(Ok(receipt));
+                });
+                return receive.await.unwrap_or_else(|_| Err(refused()));
+            }
+            let mut receipt = held.journal.provider_receipt.clone().ok_or_else(refused)?;
+            receipt.phase = "constructed".into();
+            held.journal.phase = "provider_constructed".into();
+            held.journal.provider_receipt = Some(receipt.clone());
+            if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                held.invalidate();
+                return Err(refused());
+            }
+            Ok(receipt)
+        }
+        .boxed()
+    }
+
+    /// Read-only native custody observation after fresh broker authorization.
+    /// This never starts/replays construction, releases admission or adopts an
+    /// old/closed owner. Restored journals alone cannot manufacture custody.
+    pub(crate) async fn continuity_observe_provider(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        plan: &codex_protocol::protocol::ContinuityProviderPlan,
+        transition_id: uuid::Uuid,
+        cleanup_id: Option<uuid::Uuid>,
+    ) -> CodexResult<codex_protocol::protocol::ContinuityProviderObservation> {
+        if !owner.is_open()
+            || plan.reservation != *reservation
+            || plan.process_generation != provider_process_generation()
+        {
+            return Err(refused());
+        }
+        let state = self.state.lock().await;
+        if let Some(done) = &state.continuity.provider_cleanup_completion {
+            if done.owner == *owner
+                && done.plan == *plan
+                && done.receipt.resource.transition_id == transition_id
+                && cleanup_id == Some(done.receipt.cleanup_id)
+            {
+                return Ok(codex_protocol::protocol::ContinuityProviderObservation {
+                    plan: plan.clone(),
+                    resource: done.receipt.resource.clone(),
+                    status: "released".into(),
+                    cleanup: Some(done.receipt.clone()),
+                });
+            }
+        }
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let grant = held.journal.provider_grant.as_ref().ok_or_else(refused)?;
+        let resource = held.journal.provider_receipt.as_ref().ok_or_else(refused)?;
+        if held.owner != *owner
+            || held.reservation != *reservation
+            || held._mcp_requests.is_none()
+            || grant.id != transition_id
+            || grant.provider_plan != *plan
+            || resource.plan_id != plan.id
+            || resource.transition_id != transition_id
+            || !["constructed", "retained"].contains(&resource.phase.as_str())
+            || cleanup_id.is_some_and(|id| held.journal.provider_cleanup_id != Some(id))
+        {
+            return Err(refused());
+        }
+        let status = if held.provider_resource.is_some() && held.provider_configuration.is_some() {
+            "owned"
+        } else if held.provider_resource.is_none()
+            && held.provider_configuration.is_none()
+            && held.provider_cleanup_source.is_some()
+            && held.journal.provider_cleanup_receipt.is_some()
+        {
+            "cleanup_pending"
+        } else {
+            return Err(refused());
+        };
+        Ok(codex_protocol::protocol::ContinuityProviderObservation {
+            plan: plan.clone(),
+            resource: resource.clone(),
+            status: status.into(),
+            cleanup: None,
+        })
+    }
+
+    /// Trusted host has freshly authorized cleanup of this exact broker resource.
+    /// Unpublished factory owners and a narrowly verified completed catalog
+    /// owner can use this path; other live/used providers remain quarantined.
+    pub(crate) fn continuity_cleanup_provider<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cleanup_id: uuid::Uuid,
+        resource_receipt: codex_protocol::protocol::ContinuityProviderReceipt,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityProviderCleanupReceipt>,
+    > {
+        async move {
+            if !owner.is_open()
+                || resource_receipt.reservation != *reservation
+                || resource_receipt.process_generation != provider_process_generation()
+            {
+                return Err(refused());
+            }
+            let path = self.continuity_receipt_path().await;
+            let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+            let mut state = self.state.lock().await;
+            if let Some(previous) = state.continuity.provider_cleanup_completion.as_ref()
+                && previous.owner == *owner
+                && previous.receipt.cleanup_id == cleanup_id
+                && previous.receipt.resource == resource_receipt
+                && state.continuity.held.as_ref().is_none_or(|held| {
+                    held.owner == *owner
+                        && held.reservation == *reservation
+                        && held.mcp_plan.is_some()
+                })
+            {
+                return Ok(previous.receipt.clone());
+            }
+            if state.continuity.held.is_none() {
+                let previous = state
+                    .continuity
+                    .provider_cleanup_completion
+                    .as_ref()
+                    .ok_or_else(refused)?;
+                return if previous.owner == *owner
+                    && previous.receipt.cleanup_id == cleanup_id
+                    && previous.receipt.resource == resource_receipt
+                {
+                    Ok(previous.receipt.clone())
+                } else {
+                    Err(refused())
+                };
+            }
+            let cwd = state.session_configuration.legacy_fallback_cwd.clone();
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.owner != *owner
+                || held.reservation != *reservation
+                || held._mcp_requests.is_none()
+                || held.journal.source_cwd != cwd
+                || !held.step_allows_resource_cleanup()
+            {
+                return Err(refused());
+            }
+            let mcp_quarantine = held.mcp_custody_uncertain();
+            // A failed durable completion may have already dropped the actual
+            // objects. Retain the source witness and finish this exact receipt;
+            // never execute disposal a second time or mint a new cleanup ID.
+            if ["released", "uncertain"].contains(&held.journal.phase.as_str())
+                && held.journal.provider_cleanup_id == Some(cleanup_id)
+                && held.journal.provider_receipt.as_ref() == Some(&resource_receipt)
+                && held.provider_resource.is_none()
+                && held.provider_configuration.is_none()
+            {
+                held.provider_cleanup_source
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .validate()?;
+                let receipt = held
+                    .journal
+                    .provider_cleanup_receipt
+                    .clone()
+                    .ok_or_else(refused)?;
+                let plan = held
+                    .journal
+                    .provider_grant
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .provider_plan
+                    .clone();
+                let retain_mcp = held.mcp_plan.is_some();
+                held.journal.phase = if retain_mcp && mcp_quarantine {
+                    "uncertain"
+                } else if retain_mcp {
+                    "mcp_plan_held"
+                } else {
+                    "released"
+                }
+                .into();
+                write_journal(&path, &held.journal)?;
+                if !owner.is_open() {
+                    return Err(refused());
+                }
+                state.continuity.provider_cleanup_completion = Some(CompletedProviderCleanup {
+                    owner: owner.clone(),
+                    receipt: receipt.clone(),
+                    plan,
+                });
+                if !retain_mcp {
+                    state.continuity.held = None;
+                }
+                return Ok(receipt);
+            }
+            let phase_ok = ["provider_constructed", "provider_retained", "uncertain"]
+                .contains(&held.journal.phase.as_str())
+                && held
+                    .journal
+                    .provider_cleanup_id
+                    .is_none_or(|id| id == cleanup_id)
+                || held.journal.phase == "provider_cleanup_pending"
+                    && held.journal.provider_cleanup_id == Some(cleanup_id);
+            if !phase_ok
+                || held.journal.provider_receipt.as_ref() != Some(&resource_receipt)
+                || held.journal.source_cwd != cwd
+                || held.approved.is_some()
+                || held.provider_plan.is_some()
+                || held.provider_configuration.is_none()
+                || held.provider_resource.is_none()
+            {
+                return Err(refused());
+            }
+            // A reader of the retained provider must finish before cleanup is
+            // journaled. With the state lock held, an exclusive Arc cannot gain
+            // a new strong owner unless a weak owner already exists.
+            let retained = held.provider_resource.as_ref().ok_or_else(refused)?;
+            if Arc::strong_count(retained) != 1 || Arc::weak_count(retained) != 0 {
+                return Err(refused());
+            }
+            held.provider_configuration
+                .as_ref()
+                .ok_or_else(refused)?
+                .inputs
+                .source_directory
+                .validate()?;
+            held.journal.phase = if mcp_quarantine {
+                "uncertain"
+            } else {
+                "provider_cleanup_pending"
+            }
+            .into();
+            held.journal.provider_cleanup_id = Some(cleanup_id);
+            if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                held.invalidate();
+                return Err(refused());
+            }
+            // No await from pending intent through actual disposal, final journal
+            // and admission release. A cancelled response cannot orphan a result.
+            let cell = held.provider_resource.take().ok_or_else(refused)?;
+            let resource = match Arc::try_unwrap(cell) {
+                Ok(cell) => cell.into_inner(),
+                Err(cell) => {
+                    held.provider_resource = Some(cell);
+                    held.invalidate();
+                    return Err(refused());
+                }
+            };
+            if let Err(resource) = resource.try_release_owned() {
+                held.provider_resource = Some(Arc::new(tokio::sync::Mutex::new(resource)));
+                held.invalidate();
+                return Err(refused());
+            }
+            held.provider_cleanup_source = Some(release_provider_configuration(
+                held.provider_configuration.take().ok_or_else(refused)?,
+            ));
+            if held
+                .provider_cleanup_source
+                .as_ref()
+                .ok_or_else(refused)?
+                .validate()
+                .is_err()
+            {
+                held.invalidate();
+                return Err(refused());
+            }
+            let receipt = codex_protocol::protocol::ContinuityProviderCleanupReceipt {
+                cleanup_id,
+                kind: resource_receipt.kind.clone(),
+                resource: resource_receipt,
+                source_cwd: cwd,
+                phase: "owner_released".into(),
+            };
+            let retain_mcp = held.mcp_plan.is_some();
+            held.journal.phase =
+                if retain_mcp && (mcp_quarantine || held.mcp_custody_uncertain()) {
+                    held.invalidate();
+                    "uncertain"
+                } else if retain_mcp {
+                    "mcp_plan_held"
+                } else {
+                    "released"
+                }
+                .into();
+            held.journal.provider_cleanup_receipt = Some(receipt.clone());
+            if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                held.invalidate();
+                return Err(refused());
+            }
+            let plan = held
+                .journal
+                .provider_grant
+                .as_ref()
+                .ok_or_else(refused)?
+                .provider_plan
+                .clone();
+            state.continuity.provider_cleanup_completion = Some(CompletedProviderCleanup {
+                owner: owner.clone(),
+                receipt: receipt.clone(),
+                plan,
+            });
+            if !retain_mcp {
+                state.continuity.held = None;
+            }
+            Ok(receipt)
+        }
+        .boxed()
+    }
+
+    fn continuity_destination_runtime_inputs(
+        &self,
+        configuration: &ContinuityConfigurationPreparation,
+        provider: &codex_model_provider::NativeProviderPreparation,
+    ) -> CodexResult<(Box<SessionConfiguration>, Box<crate::config::Config>)> {
+        let source = configuration.runtime_configuration();
+        let target = configuration.config();
+        if !configuration
+            .inputs
+            .source_config
+            .native_enforcer_states_are_closed()
+            || !target.native_enforcer_states_are_closed()
+            || !source
+                .step_settings
+                .approval_policy
+                .has_closed_callback_state()
+            || !source
+                .permission_profile_state
+                .native_constraint_binding()
+                .has_closed_callback_state()
+        {
+            return Err(refused());
+        }
+        let mut runtime = source.clone();
+        runtime.original_config_do_not_use = Arc::new(target.clone());
+        let mut settings = (*runtime.step_settings).clone();
+        settings.approval_policy = source
+            .step_settings
+            .approval_policy
+            .intersect_native_rules(&target.permissions.approval_policy)
+            .map_err(|_| refused())?;
+        runtime.step_settings = Arc::new(settings);
+        runtime.permission_profile_state = source
+            .permission_profile_state
+            .intersect_native_rules(target.permissions.permission_profile_state())
+            .map_err(|_| refused())?;
+        if target
+            .config_layer_stack
+            .requirements()
+            .allow_login_shell
+            .as_ref()
+            .is_some_and(|rule| !rule.value && runtime.allow_login_shell)
+        {
+            return Err(refused());
+        }
+        let updates = SessionSettingsUpdate {
+            step_settings: super::step_settings::StepSettingsUpdate {
+                approval_policy: Some(runtime.step_settings.approval_policy.value()),
+                approvals_reviewer: Some(runtime.step_settings.approvals_reviewer),
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        // Use ordinary native settings/environment/guardian validation against
+        // the target's requirements, not a parallel permissive validator.
+        let runtime = runtime
+            .apply(&updates, &runtime.environments)
+            .map_err(|_| refused())?;
+        let mut effective = Box::new((*runtime.original_config_do_not_use).clone());
+        Self::project_runtime_config(
+            &mut effective,
+            &runtime,
+            configuration.inputs.environments().local_selection(),
+        );
+        effective.model = Some(runtime.step_settings.collaboration_mode.model().to_string());
+        effective.model_provider_id = provider.selected_id().to_owned();
+        effective.model_provider = provider.destination_definition().clone();
+        // Provider-dependent web/tool readiness waits for the actual approved
+        // destination provider. Never use source capabilities as target proof.
+        Ok((Box::new(runtime), effective))
+    }
+
+    /// Assemble data against one actual reservation/candidate. Source scopes are
+    /// never relabeled as destination-ready tools, and no resources are started.
+    pub(super) fn continuity_prepare_destination<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> futures::future::BoxFuture<'a, CodexResult<Box<ContinuityDestinationPreparation>>> {
+        // Keep the composed future off native caller stacks, including at its
+        // construction/return boundary; boxing only nested awaits is insufficient.
+        async move {
+            {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let source = &state.session_configuration;
+                if !source
+                    .original_config_do_not_use
+                    .native_enforcer_states_are_closed()
+                    || !source
+                        .step_settings
+                        .approval_policy
+                        .has_closed_callback_state()
+                    || !source
+                        .permission_profile_state
+                        .native_constraint_binding()
+                        .has_closed_callback_state()
+                {
+                    return Err(refused());
+                }
+            }
+            let provider_preparation = self
+                .continuity_prepare_provider(owner, reservation, cwd)
+                .await?;
+            let ContinuityProviderPreparation {
+                configuration,
+                provider,
+            } = *provider_preparation;
+            let (runtime, execution_config) =
+                self.continuity_destination_runtime_inputs(&configuration, &provider)?;
+            let execution_bindings =
+                crate::config::NativeConfigConstraintBindings::capture(&execution_config);
+            let runtime_approval = runtime.step_settings.approval_policy.native_binding();
+            let runtime_permission = runtime.permission_profile_state.native_constraint_binding();
+            let model_config = runtime
+                .model_info_overrides
+                .models_manager_config(runtime.step_settings.personality);
+            let model = codex_model_provider::prepare_model_metadata(
+                &self.services.models_manager.load_full(),
+                runtime.step_settings.collaboration_mode.model(),
+                &model_config,
+            )?;
+            let instructions = self
+                .services
+                .agents_md_manager
+                .prepare_native_instructions(&execution_config, configuration.inputs.environments())
+                .boxed()
+                .await?;
+            // Return an owned pointer as well: large result moves can grow the
+            // caller's poll frame even when the producer future itself is boxed.
+            let prepared = Box::new(ContinuityDestinationPreparation {
+                configuration,
+                model,
+                provider,
+                instructions,
+                runtime,
+                execution_config,
+                execution_bindings,
+                runtime_approval,
+                runtime_permission,
+            });
+            self.continuity_validate_destination_preparation(owner, &prepared)
+                .boxed()
+                .await?;
+            Ok(prepared)
+        }
+        .boxed()
+    }
+
+    /// Retain exactly one data-only candidate under the native owner. Its ID is
+    /// a lookup key, not a movement grant, readiness claim or serialized plan.
+    pub(crate) fn continuity_retain_destination<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> futures::future::BoxFuture<'a, CodexResult<uuid::Uuid>> {
+        async move {
+            {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if held.journal.phase != "acquired"
+                    || held.approved.is_some()
+                    || held.destination_candidate.is_some()
+                    || held.provider_plan.is_some()
+                    || held.mcp_plan.is_some()
+                {
+                    return Err(refused());
+                }
+            }
+            let preparation = self
+                .continuity_prepare_destination(owner, reservation, cwd)
+                .await?;
+            let candidate = Arc::new(RetainedDestinationCandidate {
+                id: uuid::Uuid::new_v4(),
+                preparation,
+            });
+            self.continuity_validate_destination_preparation(owner, &candidate.preparation)
+                .await?;
+            let mut state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.phase != "acquired"
+                || held.approved.is_some()
+                || held.destination_candidate.is_some()
+                || held.provider_plan.is_some()
+                || held.mcp_plan.is_some()
+            {
+                return Err(refused());
+            }
+            let id = candidate.id;
+            held.destination_candidate = Some(candidate);
+            Ok(id)
+        }
+        .boxed()
+    }
+
+    /// Collect only the exact retained target inputs, without constructing a
+    /// turn context, discovering plugins or skills, or exposing resources.
+    #[allow(dead_code)]
+    pub(super) fn continuity_target_tool_inputs<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<'a, CodexResult<ContinuityTargetToolInputs>> {
+        async move {
+            self.continuity_validate_retained_destination(owner, reservation, id)
+                .await?;
+            let inputs = {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                let candidate = held.destination_candidate.as_ref().ok_or_else(refused)?;
+                if candidate.id != id
+                    || held.journal.mcp_shutdown_id.is_some()
+                    || !held.journal.mcp_grant.as_ref().is_some_and(|grant| {
+                        grant.mcp_plan.effects.binding_capture
+                            && grant.mcp_plan.effects.plugin_capture
+                    })
+                    || !held
+                        .journal
+                        .mcp_receipt
+                        .as_ref()
+                        .is_some_and(|receipt| receipt.phase == "constructed")
+                {
+                    return Err(refused());
+                }
+                let (model, capabilities) = held.target_model_inputs()?;
+                let tool_view = held.target_tool_view()?;
+                let mut config = candidate.preparation.execution_config.clone();
+                let mode = crate::config::resolve_web_search_mode_for_turn(
+                    &config.web_search_mode,
+                    &candidate.preparation.runtime.permission_profile(),
+                    capabilities,
+                );
+                config.web_search_mode.set(mode).map_err(|_| refused())?;
+                let provider_configuration =
+                    held.provider_configuration.as_ref().ok_or_else(refused)?;
+                let provider_publication =
+                    codex_model_provider::NativeProviderPublication::try_stage(
+                        Arc::clone(held.provider_resource.as_ref().ok_or_else(refused)?),
+                        &provider_configuration.runtime_configuration().provider,
+                        &provider_configuration.config().model_providers,
+                        provider_configuration
+                            .config()
+                            .config_layer_stack
+                            .required_model_provider(),
+                    )
+                    .map_err(|_| refused())?;
+                ContinuityTargetToolInputs {
+                    candidate: Arc::clone(candidate),
+                    provider: Arc::clone(held.provider_resource.as_ref().ok_or_else(refused)?),
+                    provider_publication,
+                    mcp: Arc::clone(held.mcp_binding.as_ref().ok_or_else(refused)?),
+                    mcp_runtime: Arc::clone(
+                        held.mcp_startup.as_ref().ok_or_else(refused)?.runtime(),
+                    ),
+                    plugins: Arc::clone(held.mcp_plugins.as_ref().ok_or_else(refused)?),
+                    skills: held.mcp_skills.clone(),
+                    model,
+                    capabilities,
+                    tool_provider: tool_view.provider,
+                    available_models: tool_view.available_models,
+                    config,
+                }
+            };
+            self.continuity_validate_target_tool_inputs(owner, reservation, &inputs)
+                .await?;
+            Ok(inputs)
+        }
+        .boxed()
+    }
+
+    #[allow(dead_code)]
+    pub(super) fn continuity_validate_target_tool_inputs<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        inputs: &'a ContinuityTargetToolInputs,
+    ) -> futures::future::BoxFuture<'a, CodexResult<()>> {
+        async move {
+            self.continuity_validate_retained_destination(owner, reservation, inputs.candidate.id)
+                .await
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "retained-destination",
+                        "native target inputs check refused"
+                    );
+                    error
+                })?;
+            let state = self.state.lock().await;
+            state
+                .continuity
+                .check(owner, reservation)
+                .map_err(|error| {
+                    tracing::debug!(stage = "owner", "native target inputs check refused");
+                    error
+                })?;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if !held
+                .destination_candidate
+                .as_ref()
+                .is_some_and(|value| Arc::ptr_eq(value, &inputs.candidate))
+                || !held
+                    .provider_resource
+                    .as_ref()
+                    .is_some_and(|value| Arc::ptr_eq(value, &inputs.provider))
+                || !held
+                    .mcp_binding
+                    .as_ref()
+                    .is_some_and(|value| Arc::ptr_eq(value, &inputs.mcp))
+                || !held
+                    .mcp_startup
+                    .as_ref()
+                    .is_some_and(|startup| Arc::ptr_eq(startup.runtime(), &inputs.mcp_runtime))
+                || !held
+                    .mcp_plugins
+                    .as_ref()
+                    .is_some_and(|value| Arc::ptr_eq(value, &inputs.plugins))
+                || match &inputs.skills {
+                    Some(expected) => !held
+                        .mcp_skills
+                        .as_ref()
+                        .is_some_and(|actual| Arc::ptr_eq(actual, expected)),
+                    None => held.mcp_skills.is_some(),
+                }
+                || held.journal.mcp_shutdown_id.is_some()
+            {
+                tracing::debug!(
+                    stage = "resource-identity",
+                    "native target inputs check refused"
+                );
+                return Err(refused());
+            }
+            let (model, capabilities) = held.target_model_inputs().map_err(|error| {
+                tracing::debug!(stage = "model-inputs", "native target inputs check refused");
+                error
+            })?;
+            let tool_view = held.target_tool_view().map_err(|error| {
+                let busy = matches!(error.details(), codex_protocol::error::CodexErrorDetails::Io(value) if value.kind() == std::io::ErrorKind::WouldBlock);
+                tracing::debug!(
+                    stage = "provider-view",
+                    busy,
+                    "native target inputs check refused"
+                );
+                error
+            })?;
+            let provider_configuration =
+                held.provider_configuration.as_ref().ok_or_else(refused)?;
+            if !inputs.provider_publication.is_current(
+                &provider_configuration.runtime_configuration().provider,
+                &provider_configuration.config().model_providers,
+                provider_configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            ) {
+                tracing::debug!(
+                    stage = "provider-publication",
+                    "native target inputs check refused"
+                );
+                return Err(refused());
+            }
+            let mut config = inputs.candidate.preparation.execution_config.clone();
+            let mode = crate::config::resolve_web_search_mode_for_turn(
+                &config.web_search_mode,
+                &inputs.candidate.preparation.runtime.permission_profile(),
+                capabilities,
+            );
+            config.web_search_mode.set(mode).map_err(|_| refused())?;
+            if model != inputs.model
+                || capabilities != inputs.capabilities
+                || tool_view.provider.info() != inputs.tool_provider.info()
+                || tool_view.provider.capabilities() != inputs.tool_provider.capabilities()
+                || tool_view.available_models != inputs.available_models
+                || config != inputs.config
+            {
+                tracing::debug!(
+                    stage = "configuration",
+                    "native target inputs check refused"
+                );
+                return Err(refused());
+            }
+            Ok(())
+        }
+        .boxed()
+    }
+
+    /// Assemble a detached native turn using the retained target inputs. No
+    /// provider, MCP resource, or turn is published by this operation.
+    #[allow(dead_code)]
+    pub(super) fn continuity_prepare_target_turn<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<'a, CodexResult<ContinuityTargetTurnPreparation>> {
+        async move {
+            let inputs = self
+                .continuity_target_tool_inputs(owner, reservation, id)
+                .await?;
+            let skills = inputs.skills.as_ref().ok_or_else(refused)?;
+            let preparation = &inputs.candidate.preparation;
+            let configuration = preparation.runtime_configuration();
+            let environments = preparation.configuration.inputs.environments().clone();
+            let capability_roots = NativeTargetCapabilityRoots::capture(&environments)?;
+            let primary = environments.primary().ok_or_else(refused)?;
+            let cwd = primary.cwd().to_abs_path().map_err(|_| refused())?;
+            let config = (*inputs.config).clone();
+            let multi_agent_version = config.multi_agent_version_for_model(
+                self.multi_agent_version()
+                    .or(inputs.model.multi_agent_version),
+            );
+            let plugins = inputs
+                .plugins
+                .outcome()
+                .clone()
+                .without_plugins(&configuration.disabled_plugin_ids);
+            let trusted_roots = codex_core_plugins::TrustedPluginRoots::from_plugin_load_outcome(
+                &plugins,
+                config.codex_home.as_path(),
+            );
+            let settings = Arc::new(super::step_settings::ResolvedStepSettings::new(
+                Arc::clone(&configuration.step_settings),
+                Arc::new(inputs.model.clone()),
+                &self.features,
+            ));
+            let (session_grants_revision, session_grants) = self
+                .services
+                .granted_permissions_by_environment_id
+                .try_lock()
+                .map_err(|_| refused())?
+                .observation()
+                .ok_or_else(refused)?;
+            let skill_policy =
+                if self
+                    .services
+                    .extensions
+                    .tool_contributors()
+                    .iter()
+                    .any(|contributor| {
+                        codex_skills_extension::native_is_skill_tool_contributor::<
+                            crate::config::Config,
+                        >(contributor.as_ref())
+                    })
+                {
+                    Some(
+                        codex_skills_extension::native_observe_skill_tool_policy(
+                            &self.services.thread_extension_data,
+                        )
+                        .ok_or_else(refused)?,
+                    )
+                } else {
+                    None
+                };
+            let network_owner = self.services.network_proxy.load_full();
+            let network = network_owner.as_ref().and_then(|started| {
+                Self::managed_network_proxy_active_for_permission_profile(
+                    primary.permission_profile(),
+                )
+                .then(|| started.proxy())
+            });
+            let mut turn = Self::make_turn_context(
+                self.thread_id(),
+                self.session_id(),
+                Arc::new(std::sync::Mutex::new(
+                    crate::state::SessionPermissionGrants::from_snapshot(session_grants.clone()),
+                )),
+                Some(Arc::clone(&self.services.auth_manager)),
+                &self.services.session_telemetry,
+                Arc::clone(&inputs.tool_provider),
+                configuration,
+                multi_agent_version,
+                config,
+                settings,
+                inputs.available_models.clone(),
+                network,
+                environments,
+                cwd,
+                uuid::Uuid::new_v4().to_string(),
+                skills._snapshot.clone(),
+            );
+            turn.code_mode_available = self.services.code_mode_service.is_available();
+            turn.extension_data.insert(trusted_roots);
+            turn.active_host_plugin_identities = Some(
+                plugins
+                    .plugins()
+                    .iter()
+                    .filter(|plugin| plugin.is_active())
+                    .map(|plugin| codex_utils_plugins::PluginIdentity {
+                        plugin_id: plugin.config_name.clone(),
+                        remote_plugin_id: plugin.remote_plugin_id.clone(),
+                    })
+                    .collect(),
+            );
+            turn.realtime_active = self.conversation.running_state().await.is_some();
+            let discovery = NativeTargetDiscovery::capture(
+                self,
+                &turn.config,
+                &turn.initial_environments,
+                &capability_roots,
+            )?;
+            let discovery_v2 = turn
+                .config
+                .features
+                .enabled(codex_features::Feature::ExecutorCapabilityDiscoveryV2);
+            let skill_tool_shapes = skill_policy.as_ref().map(|policy| {
+                codex_skills_extension::native_skill_tool_shapes(
+                    policy.cloud_enabled() || !capability_roots.roots.is_empty() || discovery_v2,
+                    discovery_v2,
+                )
+            });
+            let step_extension_data =
+                Self::step_extension_data_for_model(&turn.sub_id, &inputs.model);
+            step_extension_data.insert(codex_skills_extension::NativeSkillPromptModel {
+                include_usage: inputs.model.include_skills_usage_instructions,
+                context_window: inputs.model.resolved_context_window(),
+            });
+            if skill_policy.is_some()
+                && !codex_skills_extension::native_detach_skill_step(
+                    &self.services.thread_extension_data,
+                    &step_extension_data,
+                    Arc::new(codex_mcp::McpResourceClient::new(Arc::clone(
+                        &inputs.mcp_runtime,
+                    ))),
+                )
+            {
+                return Err(refused());
+            }
+            if skill_policy.is_some()
+                && !codex_skills_extension::native_bind_skill_turn(
+                    &step_extension_data,
+                    &turn.extension_data,
+                )
+            {
+                return Err(refused());
+            }
+            let selected_roots =
+                codex_exec_server::ResolvedSelectedCapabilityRoot::native_resolve_captured_local(
+                    &capability_roots.roots,
+                    &turn.initial_environments.captured_environments(),
+                )
+                .ok_or_else(refused)?;
+            step_extension_data.insert(selected_roots);
+            step_extension_data.insert(inputs.plugins.step_selection.clone());
+            let (discovery_v1, discovery_v2) = match &discovery {
+                NativeTargetDiscovery::Disabled => (None, None),
+                NativeTargetDiscovery::V2Local => (None, Some([].as_slice())),
+                NativeTargetDiscovery::V1 { observation, .. } => {
+                    (Some(observation.snapshot()), None)
+                }
+            };
+            let executor_hook_sources = crate::hook_runtime::prepare_executor_hook_sources(
+                inputs.mcp.binding(),
+                &inputs.plugins.step_selection,
+                discovery_v1,
+                discovery_v2,
+            );
+            let (source_model_client, source_models) = self.services.model_client
+                .native_observe_pair(&self.services.models_manager)
+                .ok_or_else(refused)?;
+            {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                if !state.continuity.held.as_ref()
+                    .and_then(|held| held.source_models_observation.as_ref())
+                    .is_some_and(|observed| observed.same_owner(&source_models))
+                {
+                    return Err(refused());
+                }
+            }
+            let title_request = inputs.config.ephemeral
+                && matches!(
+                    configuration.thread_source.as_ref(),
+                    Some(codex_protocol::protocol::ThreadSource::Feature(feature)) if feature == "thread_title"
+                );
+            let target_model_client = source_model_client.client.native_destination_client(
+                Arc::clone(&inputs.tool_provider),
+                &inputs.config,
+                Self::build_model_client_beta_features_header(&inputs.config),
+                inputs.config.features.enabled(codex_features::Feature::ReasoningEffortOverride)
+                    && !title_request,
+            );
+            let target = ContinuityTargetTurnPreparation {
+                inputs,
+                turn,
+                source_model_client,
+                source_models,
+                _target_model_client: target_model_client,
+                session_grants,
+                session_grants_revision,
+                network_owner: network_owner.as_ref().map(Arc::downgrade),
+                skill_policy,
+                capability_roots,
+                skill_tool_shapes,
+                discovery,
+                step_extension_data,
+                executor_hook_sources,
+            };
+            self.continuity_validate_target_turn(owner, reservation, &target)
+                .await?;
+            Ok(target)
+        }
+        .boxed()
+    }
+
+    /// Recheck the retained owners and live turn-level observations. This does
+    /// not establish step-contributor or tool-router freshness.
+    #[allow(dead_code)]
+    pub(super) fn continuity_validate_target_turn<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        target: &'a ContinuityTargetTurnPreparation,
+    ) -> futures::future::BoxFuture<'a, CodexResult<()>> {
+        async move {
+            self.continuity_validate_target_tool_inputs(owner, reservation, &target.inputs)
+                .await
+                .map_err(|error| {
+                    tracing::debug!(stage = "inputs-before", "native target turn check refused");
+                    error
+                })?;
+            let turn = &target.turn;
+            if turn.model_info().as_ref() != &target.inputs.model
+                || turn.available_models != target.inputs.available_models
+                || turn.provider.info() != target.inputs.tool_provider.info()
+                || turn.provider.capabilities() != target.inputs.capabilities
+                || !self
+                    .continuity_target_turn_volatile_inputs_current(target)
+                    .map_err(|error| {
+                        tracing::debug!(
+                            stage = "volatile-lock-before",
+                            "native target turn check refused"
+                        );
+                        error
+                    })?
+                || turn.code_mode_available != self.services.code_mode_service.is_available()
+                || turn.realtime_active != self.conversation.running_state().await.is_some()
+                || turn.multi_agent_version
+                    != target.inputs.config.multi_agent_version_for_model(
+                        self.multi_agent_version()
+                            .or(target.inputs.model.multi_agent_version),
+                    )
+            {
+                tracing::debug!(stage = "turn-state", "native target turn check refused");
+                return Err(refused());
+            }
+            self.continuity_validate_target_tool_inputs(owner, reservation, &target.inputs)
+                .await
+                .map_err(|error| {
+                    tracing::debug!(stage = "inputs-after", "native target turn check refused");
+                    error
+                })?;
+            if !self
+                .continuity_target_turn_volatile_inputs_current(target)
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "volatile-lock-after",
+                        "native target turn check refused"
+                    );
+                    error
+                })?
+            {
+                tracing::debug!(stage = "volatile-after", "native target turn check refused");
+                return Err(refused());
+            }
+            Ok(())
+        }
+        .boxed()
+    }
+
+    /// Assemble the normal native contributor state and router in detached
+    /// storage. The caller has already persisted the approved effect intent.
+    async fn continuity_assemble_target_step(
+        self: &Arc<Self>,
+        target: ContinuityTargetTurnPreparation,
+    ) -> CodexResult<RetainedTargetStep> {
+        macro_rules! assembly_refusal {
+            ($stage:literal) => {{
+                tracing::debug!(stage = $stage, "native target step assembly check refused");
+                refused()
+            }};
+        }
+        let attachment_revisions = self
+            .continuity_attachment_revisions()
+            .ok_or_else(|| assembly_refusal!("source-attachments"))?;
+        let contributor_freshness: Vec<_> = self
+            .services
+            .extensions
+            .tool_contributors()
+            .iter()
+            .filter_map(|contributor| {
+                contributor.native_step_freshness(
+                    &self.services.session_extension_data,
+                    &self.services.thread_extension_data,
+                )
+            })
+            .collect();
+        if self.continuity_attachment_revisions() != Some(attachment_revisions)
+            || !contributor_freshness.iter().all(|current| current())
+        {
+            return Err(assembly_refusal!("source-freshness"));
+        }
+        target
+            .step_extension_data
+            .insert(crate::NativeTargetToolContext {
+                config: Arc::clone(&target.turn.config),
+                provider: Arc::clone(&target.inputs.tool_provider),
+            });
+        let target_tool_context = target
+            .step_extension_data
+            .native_try_get::<crate::NativeTargetToolContext>()
+            .ok_or_else(|| assembly_refusal!("tool-context"))?;
+        let (target_skill_shapes, target_skill_policy) = if target.skill_policy.is_some() {
+            let mut contributors =
+                self.services
+                    .extensions
+                    .tool_contributors()
+                    .iter()
+                    .filter(|contributor| {
+                        codex_skills_extension::native_is_skill_tool_contributor::<
+                            crate::config::Config,
+                        >(contributor.as_ref())
+                    });
+            let contributor = contributors
+                .next()
+                .ok_or_else(|| assembly_refusal!("skill-contributor-missing"))?;
+            if contributors.next().is_some() {
+                return Err(assembly_refusal!("skill-contributor-duplicate"));
+            }
+            let has_local =
+                target
+                    .turn
+                    .initial_environments
+                    .turn_environments()
+                    .any(|environment| {
+                        environment.selection.environment_id
+                            == codex_exec_server::LOCAL_ENVIRONMENT_ID
+                    });
+            let cloud_enabled = codex_skills_extension::native_project_detached_skill_step(
+                contributor.as_ref(),
+                target.turn.config.as_ref(),
+                has_local,
+                &self.services.thread_extension_data,
+                &target.step_extension_data,
+            )
+            .ok_or_else(|| assembly_refusal!("skill-projection"))?;
+            let discovery_v2 = target
+                .turn
+                .config
+                .features
+                .enabled(codex_features::Feature::ExecutorCapabilityDiscoveryV2);
+            (
+                Some(codex_skills_extension::native_skill_tool_shapes(
+                    cloud_enabled || !target.capability_roots.roots.is_empty() || discovery_v2,
+                    discovery_v2,
+                )),
+                Some(
+                    codex_skills_extension::native_observe_detached_skill_policy(
+                        &target.step_extension_data,
+                    )
+                    .ok_or_else(|| assembly_refusal!("skill-policy"))?,
+                ),
+            )
+        } else {
+            (None, None)
+        };
+        let roots = target
+            .step_extension_data
+            .get::<Vec<codex_exec_server::ResolvedSelectedCapabilityRoot>>()
+            .ok_or_else(|| assembly_refusal!("capability-roots"))?;
+        let ready_roots = Self::ready_selected_capability_roots(&roots);
+        let (discovery_v1, discovery_v2) = match &target.discovery {
+            NativeTargetDiscovery::Disabled => (None, None),
+            NativeTargetDiscovery::V2Local => (None, Some([].as_slice())),
+            NativeTargetDiscovery::V1 { observation, .. } => (Some(observation.snapshot()), None),
+        };
+        let prepare_contributors = async {
+            for contributor in self.services.extensions.tool_contributors() {
+                contributor
+                    .prepare_for_step(codex_extension_api::StepPreparationInput {
+                        turn_id: &target.turn.sub_id,
+                        ready_selected_capability_roots: &ready_roots,
+                        executor_capability_discovery: discovery_v1,
+                        executor_capability_discovery_v2: discovery_v2,
+                        selected_plugins: &target.inputs.plugins.step_selection,
+                        session_store: &self.services.session_extension_data,
+                        thread_store: &self.services.thread_extension_data,
+                        turn_store: target.turn.extension_data.as_ref(),
+                        step_store: &target.step_extension_data,
+                    })
+                    .await;
+            }
+        };
+        let recommendations = super::turn::prepare_tool_recommendations(self, &target.turn);
+        let ((), recommendations) = tokio::join!(prepare_contributors, recommendations);
+        if !native_target_contributors_current(self, &target.step_extension_data).await {
+            return Err(assembly_refusal!("contributors-after-prepare"));
+        }
+        if !self
+            .services
+            .extensions
+            .tool_contributors()
+            .iter()
+            .all(|contributor| {
+                contributor
+                    .native_target_step_current(&target.step_extension_data)
+                    .is_none_or(|current| current)
+            })
+        {
+            return Err(assembly_refusal!("contributors-current-after-prepare"));
+        }
+        if !target
+            .step_extension_data
+            .native_try_get::<crate::NativeTargetToolContext>()
+            .is_some_and(|current| Arc::ptr_eq(&current, &target_tool_context))
+        {
+            return Err(assembly_refusal!("tool-context-after-prepare"));
+        }
+        if target.skill_policy.is_some()
+            && !codex_skills_extension::native_detached_skill_step_ready(
+                &target.step_extension_data,
+            )
+        {
+            return Err(assembly_refusal!("skill-step-ready"));
+        }
+        if target_skill_policy
+            .as_ref()
+            .is_some_and(|policy| !policy.is_current(&target.step_extension_data))
+        {
+            return Err(assembly_refusal!("skill-policy-current"));
+        }
+        if let Some(expected) = &target_skill_shapes
+            && codex_skills_extension::native_detached_skill_shapes(&target.step_extension_data)
+                .as_ref()
+                != Some(expected)
+        {
+            return Err(assembly_refusal!("skill-shapes"));
+        }
+        // Contributor preparation legitimately populates the private scopes.
+        // Capture them only after preparation, before the router reads them.
+        let target_attachment_revisions = target
+            .native_attachment_revisions()
+            .ok_or_else(|| assembly_refusal!("target-attachments"))?;
+        let (router, recommendations) = super::turn::built_tools_with_candidates(
+            self,
+            &target.turn,
+            &target.inputs.model,
+            &target.turn.initial_environments,
+            target.inputs.mcp.binding(),
+            &target.step_extension_data,
+            recommendations,
+            /*detached*/ true,
+        )
+        .await
+        .map_err(|error| {
+            tracing::debug!(
+                stage = "build-router",
+                "native target step assembly check refused"
+            );
+            error
+        })?;
+        #[allow(unused_mut)]
+        let mut observed_router = crate::tools::spec_plan::preview_tool_router_with_native_scopes(
+            self,
+            &target.turn,
+            &target.inputs.model,
+            &target.turn.initial_environments,
+            target.inputs.mcp.binding(),
+            target.turn.apps_enabled(),
+            &target.step_extension_data,
+            recommendations.as_ref(),
+        ).map_err(|_| assembly_refusal!("router-preview"))?;
+        #[cfg(debug_assertions)]
+        if std::env::var_os("TURNLINK_EXPERIMENTAL_STAGING_FIXTURE").as_deref() == Some(std::ffi::OsStr::new("1"))
+            && std::env::var_os("TURNLINK_EXPERIMENTAL_ROUTER_MISMATCH").as_deref() == Some(std::ffi::OsStr::new("1"))
+        {
+            observed_router.can_manage_children = !observed_router.can_manage_children;
+        }
+        if router.preparation_snapshot() != observed_router {
+            return Err(assembly_refusal!("router-preview-mismatch"));
+        }
+        if !native_target_contributors_current(self, &target.step_extension_data).await {
+            return Err(assembly_refusal!("contributors-after-router"));
+        }
+        if self.continuity_attachment_revisions() != Some(attachment_revisions)
+            || target.native_attachment_revisions() != Some(target_attachment_revisions)
+            || !target
+                .step_extension_data
+                .native_try_get::<crate::NativeTargetToolContext>()
+                .is_some_and(|current| Arc::ptr_eq(&current, &target_tool_context))
+            || !contributor_freshness.iter().all(|current| current())
+            || !self
+                .services
+                .extensions
+                .tool_contributors()
+                .iter()
+                .all(|contributor| {
+                    contributor
+                        .native_target_step_current(&target.step_extension_data)
+                        .is_none_or(|current| current)
+                })
+            || target_skill_policy
+                .as_ref()
+                .is_some_and(|policy| !policy.is_current(&target.step_extension_data))
+            || self.continuity_attachment_revisions() != Some(attachment_revisions)
+            || target.native_attachment_revisions() != Some(target_attachment_revisions)
+        {
+            return Err(assembly_refusal!("final-freshness"));
+        }
+        Ok(RetainedTargetStep {
+            _target: target,
+            _router: router,
+            tool_plan: observed_router,
+            tool_recommendations: recommendations,
+            attachment_revisions,
+            target_attachment_revisions,
+            target_skill_shapes,
+            target_skill_policy,
+            target_tool_context,
+            contributor_freshness,
+        })
+    }
+
+    // This witnesses only attachment-map replacement, not changes inside an
+    // attached value or the freshness of the executors' external backends.
+    fn continuity_attachment_revisions(&self) -> Option<(u64, u64)> {
+        Some((
+            self.services
+                .session_extension_data
+                .native_attachment_revision()?,
+            self.services
+                .thread_extension_data
+                .native_attachment_revision()?,
+        ))
+    }
+
+    /// Read-only refusal of a target configuration whose contributor is known
+    /// to require an as-yet unsupported live provider. This observation never
+    /// certifies readiness and creates no step intent or contributor effects.
+    pub(crate) async fn continuity_preflight_target_step(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        candidate_id: uuid::Uuid,
+    ) -> CodexResult<bool> {
+        let inputs = self
+            .continuity_target_tool_inputs(owner, reservation, candidate_id)
+            .await?;
+        if !self.services.extensions.native_tool_contributors_known()
+            || !self.services.extensions.native_prompt_contributors_known()
+            || !self
+                .services
+                .extensions
+                .native_turn_input_contributors_known()
+        {
+            return Ok(false);
+        }
+        let wants_history = inputs.config.model_provider.is_openai()
+            && inputs
+                .config
+                .token_budget
+                .as_ref()
+                .is_some_and(|budget| budget.use_history_notes_extension);
+        let auth = if wants_history {
+            Some(self.services.auth_manager.native_cached_observation()?)
+        } else {
+            None
+        };
+        let unsupported_history = auth.as_ref().is_some_and(|observation| {
+            observation
+                .auth()
+                .is_some_and(|value| value.uses_codex_backend())
+        });
+        self.continuity_validate_target_tool_inputs(owner, reservation, &inputs)
+            .await?;
+        if auth
+            .as_ref()
+            .is_some_and(|observation| !observation.is_current(&self.services.auth_manager))
+        {
+            return Err(refused());
+        }
+        Ok(!unsupported_history)
+    }
+
+    /// Report a no-intent refusal only while this exact live owner still holds
+    /// both resources and no concurrent preparation can have recorded a step.
+    /// The gate is held through the attempt; after an intent is installed the
+    /// durable journal, not this in-memory flag, remains authoritative.
+    pub(crate) async fn continuity_attempt_target_step(
+        self: &Arc<Self>,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        candidate_id: uuid::Uuid,
+        operation_id: uuid::Uuid,
+        mcp_resource: codex_protocol::protocol::ContinuityMcpReceipt,
+        provider_resource: codex_protocol::protocol::ContinuityProviderReceipt,
+    ) -> CodexResult<codex_protocol::protocol::ContinuityStepPreparationAttempt> {
+        use codex_protocol::protocol::{
+            ContinuityStepNotStarted, ContinuityStepPreparationAttempt,
+        };
+        use std::sync::atomic::Ordering;
+        let gate = {
+            let state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if held.journal.phase != "provider_constructed"
+                || held.journal.step.is_some()
+                || held.target_step.is_some()
+                || held.journal.mcp_receipt.as_ref() != Some(&mcp_resource)
+                || held.journal.provider_receipt.as_ref() != Some(&provider_resource)
+                || !held
+                    .destination_candidate
+                    .as_ref()
+                    .is_some_and(|value| value.id == candidate_id)
+            {
+                return Err(refused());
+            }
+            let gate = Arc::clone(&held.step_preparing);
+            gate.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+                .map_err(|_| refused())?;
+            gate
+        };
+        let _attempt = StepPreparationAttemptGuard(Arc::clone(&gate));
+        match self
+            .continuity_prepare_target_step(
+                owner,
+                reservation,
+                candidate_id,
+                operation_id,
+                mcp_resource.clone(),
+                provider_resource.clone(),
+            )
+            .await
+        {
+            Ok(receipt) => Ok(ContinuityStepPreparationAttempt::Retained(receipt)),
+            Err(error) => {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if !Arc::ptr_eq(&held.step_preparing, &gate)
+                    || held.journal.phase != "provider_constructed"
+                    || held.journal.step.is_some()
+                    || held.target_step.is_some()
+                    || held.journal.mcp_receipt.as_ref() != Some(&mcp_resource)
+                    || held.journal.provider_receipt.as_ref() != Some(&provider_resource)
+                    || !held
+                        .destination_candidate
+                        .as_ref()
+                        .is_some_and(|value| value.id == candidate_id)
+                {
+                    return Err(error);
+                }
+                Ok(ContinuityStepPreparationAttempt::NotStarted(
+                    ContinuityStepNotStarted {
+                        operation_id,
+                        candidate_id,
+                        refused_before_intent: true,
+                    },
+                ))
+            }
+        }
+    }
+
+    /// Performs the separately disclosed contributor effect once under the
+    /// retained owner. A dropped response does not cancel or replay the worker.
+    #[allow(dead_code)]
+    pub(super) fn continuity_prepare_target_step<'a>(
+        self: &'a Arc<Self>,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        candidate_id: uuid::Uuid,
+        operation_id: uuid::Uuid,
+        mcp_resource: codex_protocol::protocol::ContinuityMcpReceipt,
+        provider_resource: codex_protocol::protocol::ContinuityProviderReceipt,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityStepPreparationReceipt>,
+    > {
+        async move {
+            if !self.services.extensions.native_tool_contributors_known()
+                || !self.services.extensions.native_prompt_contributors_known()
+                || !self
+                    .services
+                    .extensions
+                    .native_turn_input_contributors_known()
+            {
+                return Err(refused());
+            }
+            let target = self
+                .continuity_prepare_target_turn(owner, reservation, candidate_id)
+                .await?;
+            self.continuity_validate_target_turn(owner, reservation, &target)
+                .await?;
+            #[cfg(test)]
+            if REFUSE_TARGET_STEP_BEFORE_INTENT
+                .get()
+                .is_some_and(|operations| operations.lock().unwrap().remove(&operation_id))
+            {
+                return Err(refused());
+            }
+            let path = self.continuity_receipt_path().await;
+            {
+                let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+                let mut state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                let mcp_grant = held.journal.mcp_grant.as_ref().ok_or_else(refused)?;
+                let provider_grant = held.journal.provider_grant.as_ref().ok_or_else(refused)?;
+                if held.journal.phase != "provider_constructed"
+                    || held.journal.step.is_some()
+                    || held.journal.mcp_shutdown_id.is_some()
+                    || held.target_step.is_some()
+                    || !mcp_grant.mcp_plan.effects.step_preparation
+                    || held.journal.mcp_receipt.as_ref() != Some(&mcp_resource)
+                    || held.journal.provider_receipt.as_ref() != Some(&provider_resource)
+                    || mcp_resource.phase != "constructed"
+                    || provider_resource.phase != "constructed"
+                    || mcp_grant.task_id != provider_grant.task_id
+                    || mcp_grant.channel != provider_grant.channel
+                    || mcp_grant.agent_id != provider_grant.agent_id
+                    || mcp_grant.claim_generation != provider_grant.claim_generation
+                    || mcp_grant.from != provider_grant.from
+                    || mcp_grant.to != provider_grant.to
+                    || !held
+                        .destination_candidate
+                        .as_ref()
+                        .is_some_and(|candidate| {
+                            candidate.id == candidate_id
+                                && Arc::ptr_eq(candidate, &target.inputs.candidate)
+                        })
+                    || !held
+                        .provider_resource
+                        .as_ref()
+                        .is_some_and(|resource| Arc::ptr_eq(resource, &target.inputs.provider))
+                    || !held
+                        .mcp_binding
+                        .as_ref()
+                        .is_some_and(|resource| Arc::ptr_eq(resource, &target.inputs.mcp))
+                {
+                    return Err(refused());
+                }
+                held.journal.schema = 5;
+                held.journal.step = Some(StepJournal {
+                    operation_id,
+                    candidate_id,
+                    mcp_resource_id: mcp_resource.resource_id,
+                    provider_resource_id: provider_resource.resource_id,
+                    status: "pending".into(),
+                    receipt: None,
+                    disposal: None,
+                });
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+            }
+            let session = Arc::clone(self);
+            let owner = owner.clone();
+            let reservation = reservation.clone();
+            tokio::spawn(async move {
+                // Contributor and provider callbacks run after the durable intent.
+                // A panic must become an uncertain operation, not an indefinitely
+                // pending intent that a host can never distinguish from live work.
+                let attempt = std::panic::AssertUnwindSafe(async {
+                    #[cfg(test)]
+                    if PANIC_TARGET_STEP_OPERATIONS
+                        .get()
+                        .is_some_and(|operations| operations.lock().unwrap().remove(&operation_id))
+                    {
+                        panic!("injected target step callback panic");
+                    }
+                    let prepared = session.continuity_assemble_target_step(target).await;
+                    let valid = match &prepared {
+                        Ok(step) => {
+                            let attachments_before = step.attachment_revisions_current(&session);
+                            let contributors_before = attachments_before
+                                && native_target_contributors_current(
+                                    &session,
+                                    &step._target.step_extension_data,
+                                )
+                                .await;
+                            let target_valid = contributors_before
+                                && retry_busy_observation(|| {
+                                    session.continuity_validate_target_turn(
+                                        &owner,
+                                        &reservation,
+                                        &step._target,
+                                    )
+                                })
+                                .await
+                                .is_ok();
+                            let contributors_after = target_valid
+                                && native_target_contributors_current(
+                                    &session,
+                                    &step._target.step_extension_data,
+                                )
+                                .await;
+                            let tool_plan_valid = contributors_after && step.tool_plan_current(&session);
+                            let attachments_after =
+                                tool_plan_valid && step.attachment_revisions_current(&session);
+                            let valid = attachments_before
+                                && contributors_before
+                                && target_valid
+                                && contributors_after
+                                && tool_plan_valid
+                                && attachments_after;
+                            if !valid {
+                                tracing::debug!(
+                                    attachments_before,
+                                    contributors_before,
+                                    target_valid,
+                                    contributors_after,
+                                    tool_plan_valid,
+                                    attachments_after,
+                                    "native target step validation refused"
+                                );
+                            }
+                            valid
+                        }
+                        Err(_) => {
+                            tracing::debug!("native target step assembly refused");
+                            false
+                        }
+                    };
+                    (prepared, valid)
+                })
+                .catch_unwind()
+                .await;
+                let (prepared, valid) = attempt.unwrap_or_else(|_| (Err(refused()), false));
+                let _settings = super::thread_settings::acquire_persistence_lock(&session).await;
+                let mut state = session.state.lock().await;
+                let owner_valid = state.continuity.check(&owner, &reservation).is_ok();
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                let matches = held.journal.step.as_ref().is_some_and(|step| {
+                    step.operation_id == operation_id
+                        && step.candidate_id == candidate_id
+                        && step.status == "pending"
+                }) && held.journal.mcp_receipt.as_ref() == Some(&mcp_resource)
+                    && held.journal.provider_receipt.as_ref() == Some(&provider_resource);
+                if !matches {
+                    return Err(refused());
+                }
+                let retained_inputs =
+                    std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        prepared.as_ref().is_ok_and(|step| {
+                            held.destination_candidate
+                                .as_ref()
+                                .is_some_and(|candidate| {
+                                    Arc::ptr_eq(candidate, &step._target.inputs.candidate)
+                                })
+                                && held.provider_resource.as_ref().is_some_and(|provider| {
+                                    Arc::ptr_eq(provider, &step._target.inputs.provider)
+                                })
+                                && held
+                                    .mcp_binding
+                                    .as_ref()
+                                    .is_some_and(|mcp| Arc::ptr_eq(mcp, &step._target.inputs.mcp))
+                                && held.mcp_startup.as_ref().is_some_and(|startup| {
+                                    Arc::ptr_eq(startup.runtime(), &step._target.inputs.mcp_runtime)
+                                })
+                                && held.mcp_plugins.as_ref().is_some_and(|plugins| {
+                                    Arc::ptr_eq(plugins, &step._target.inputs.plugins)
+                                })
+                                && match (&held.mcp_skills, &step._target.inputs.skills) {
+                                    (Some(actual), Some(expected)) => Arc::ptr_eq(actual, expected),
+                                    (None, None) => true,
+                                    _ => false,
+                                }
+                                && session
+                                    .continuity_target_turn_volatile_inputs_current(&step._target)
+                                    .unwrap_or(false)
+                                && step.attachment_revisions_current(&session)
+                        })
+                    }))
+                    .unwrap_or(false);
+                if !valid || !owner_valid || !retained_inputs {
+                    tracing::debug!(
+                        valid,
+                        owner_valid,
+                        retained_inputs,
+                        "native target step became uncertain"
+                    );
+                    held.invalidate();
+                    if let Some(step) = held.journal.step.as_mut() {
+                        step.status = "uncertain".into();
+                    }
+                    let _ = write_journal(&path, &held.journal);
+                    return Err(refused());
+                }
+                let prepared = prepared.map_err(|_| refused())?;
+                let receipt = codex_protocol::protocol::ContinuityStepPreparationReceipt {
+                    operation_id,
+                    candidate_id,
+                    step_id: uuid::Uuid::new_v4(),
+                    mcp_resource_id: mcp_resource.resource_id,
+                    provider_resource_id: provider_resource.resource_id,
+                    status: "retained".into(),
+                };
+                held.target_step = Some(Arc::new(prepared));
+                let step = held.journal.step.as_mut().ok_or_else(refused)?;
+                step.status = "retained".into();
+                step.receipt = Some(receipt.clone());
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                Ok(receipt)
+            })
+            .await
+            .map_err(|_| refused())?
+        }
+        .boxed()
+    }
+
+    /// Observe only the operation retained by this exact live owner. A
+    /// restored journal or an equal-looking replacement cannot establish custody.
+    #[allow(dead_code)]
+    pub(crate) fn continuity_observe_target_step<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        candidate_id: uuid::Uuid,
+        operation_id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityStepPreparationObservation>,
+    > {
+        async move {
+            let (status, receipt, retained) = {
+                let state = self.state.lock().await;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if !owner.is_open()
+                    || held.owner != *owner
+                    || held.reservation != *reservation
+                    || !held
+                        ._mcp_requests
+                        .as_ref()
+                        .is_some_and(|guard| guard.is_current())
+                {
+                    return Err(refused());
+                }
+                let step = held.journal.step.as_ref().ok_or_else(refused)?;
+                if step.operation_id != operation_id || step.candidate_id != candidate_id {
+                    return Err(refused());
+                }
+                if held.invalid || step.status == "uncertain" {
+                    ("uncertain", None, None)
+                } else if step.status == "pending" {
+                    ("pending", None, None)
+                } else if step.status == "retained" {
+                    ("retained", step.receipt.clone(), held.target_step.clone())
+                } else {
+                    return Err(refused());
+                }
+            };
+            if status == "retained" {
+                let target = retained.as_ref().ok_or_else(refused)?;
+                if !target.attachment_revisions_current(self) {
+                    return Err(refused());
+                }
+                if !native_target_contributors_current(self, &target._target.step_extension_data)
+                    .await
+                {
+                    return Err(refused());
+                }
+                self.continuity_validate_target_turn(owner, reservation, &target._target)
+                    .await?;
+                if !native_target_contributors_current(self, &target._target.step_extension_data)
+                    .await
+                    || !target.tool_plan_current(self)
+                {
+                    return Err(refused());
+                }
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if !held
+                    .target_step
+                    .as_ref()
+                    .is_some_and(|actual| Arc::ptr_eq(actual, target))
+                    || !held.journal.step.as_ref().is_some_and(|step| {
+                        step.operation_id == operation_id
+                            && step.candidate_id == candidate_id
+                            && step.status == "retained"
+                            && step.receipt == receipt
+                    })
+                    || !target.attachment_revisions_current(self)
+                {
+                    return Err(refused());
+                }
+            }
+            Ok(
+                codex_protocol::protocol::ContinuityStepPreparationObservation {
+                    status: status.into(),
+                    receipt,
+                },
+            )
+        }
+        .boxed()
+    }
+
+    /// Drop exactly one retained unpublished step under the same live owner.
+    /// This records only step disposal; MCP and provider release remain held.
+    pub(crate) fn continuity_dispose_target_step<'a>(
+        self: &'a Arc<Self>,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        retained: codex_protocol::protocol::ContinuityStepPreparationReceipt,
+        disposal_id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityStepDisposalReceipt>,
+    > {
+        async move {
+            let path = self.continuity_receipt_path().await;
+            let target = {
+                let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+                let mut state = self.state.lock().await;
+                state
+                    .continuity
+                    .check_owner_and_source(owner, reservation)?;
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                let step = held.journal.step.as_ref().ok_or_else(refused)?;
+                if held.invalid
+                    || held.approved.is_some()
+                    || step.status != "retained"
+                    || step.receipt.as_ref() != Some(&retained)
+                    || step.disposal.is_some()
+                    || !held
+                        .target_step
+                        .as_ref()
+                        .is_some_and(|target| Arc::strong_count(target) == 1)
+                {
+                    return Err(refused());
+                }
+                held.journal.step.as_mut().ok_or_else(refused)?.disposal =
+                    Some(StepDisposalJournal {
+                        disposal_id,
+                        status: "pending".into(),
+                        receipt: None,
+                    });
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                held.target_step.take().ok_or_else(refused)?
+            };
+            let session = Arc::clone(self);
+            let owner = owner.clone();
+            let reservation = reservation.clone();
+            tokio::spawn(async move {
+                drop(target);
+                let _settings = super::thread_settings::acquire_persistence_lock(&session).await;
+                let mut state = session.state.lock().await;
+                let owner_valid = state
+                    .continuity
+                    .check_owner_and_source(&owner, &reservation)
+                    .is_ok();
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                let matches = held.target_step.is_none()
+                    && held.journal.step.as_ref().is_some_and(|step| {
+                        step.receipt.as_ref() == Some(&retained)
+                            && step.disposal.as_ref().is_some_and(|disposal| {
+                                disposal.disposal_id == disposal_id && disposal.status == "pending"
+                            })
+                    });
+                if !matches || !owner_valid {
+                    held.invalidate();
+                    if let Some(disposal) = held
+                        .journal
+                        .step
+                        .as_mut()
+                        .and_then(|step| step.disposal.as_mut())
+                    {
+                        disposal.status = "uncertain".into();
+                    }
+                    let _ = write_journal(&path, &held.journal);
+                    return Err(refused());
+                }
+                let receipt = codex_protocol::protocol::ContinuityStepDisposalReceipt {
+                    disposal_id,
+                    operation_id: retained.operation_id,
+                    candidate_id: retained.candidate_id,
+                    step_id: retained.step_id,
+                    mcp_resource_id: retained.mcp_resource_id,
+                    provider_resource_id: retained.provider_resource_id,
+                    status: "disposed".into(),
+                };
+                let disposal = held
+                    .journal
+                    .step
+                    .as_mut()
+                    .and_then(|step| step.disposal.as_mut())
+                    .ok_or_else(refused)?;
+                disposal.status = "disposed".into();
+                disposal.receipt = Some(receipt.clone());
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                Ok(receipt)
+            })
+            .await
+            .map_err(|_| refused())?
+        }
+        .boxed()
+    }
+
+    /// Read the existing disposal only; never repeat the drop after a lost reply.
+    pub(crate) fn continuity_observe_target_step_disposal<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        retained: &'a codex_protocol::protocol::ContinuityStepPreparationReceipt,
+        disposal_id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<
+        'a,
+        CodexResult<codex_protocol::protocol::ContinuityStepDisposalObservation>,
+    > {
+        async move {
+            let state = self.state.lock().await;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if !owner.is_open()
+                || held.owner != *owner
+                || held.reservation != *reservation
+                || !held
+                    ._mcp_requests
+                    .as_ref()
+                    .is_some_and(|guard| guard.is_current())
+            {
+                return Err(refused());
+            }
+            let step = held.journal.step.as_ref().ok_or_else(refused)?;
+            let disposal = step.disposal.as_ref().ok_or_else(refused)?;
+            if step.receipt.as_ref() != Some(retained) || disposal.disposal_id != disposal_id {
+                return Err(refused());
+            }
+            let (status, receipt) = if held.invalid || disposal.status == "uncertain" {
+                ("uncertain", None)
+            } else if disposal.status == "pending" {
+                ("pending", None)
+            } else if disposal.status == "disposed" && held.target_step.is_none() {
+                ("disposed", disposal.receipt.clone())
+            } else {
+                return Err(refused());
+            };
+            Ok(
+                codex_protocol::protocol::ContinuityStepDisposalObservation {
+                    status: status.into(),
+                    receipt,
+                },
+            )
+        }
+        .boxed()
+    }
+
+    /// Recheck the retained object and its owner after async native reads. A
+    /// lookup key or an equal-looking reconstructed candidate is not authority.
+    pub(crate) fn continuity_validate_retained_destination<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        id: uuid::Uuid,
+    ) -> futures::future::BoxFuture<'a, CodexResult<()>> {
+        async move {
+            let (candidate, mcp, binding, plugins, skills) = {
+                let state = self.state.lock().await;
+                state
+                    .continuity
+                    .check(owner, reservation)
+                    .map_err(|error| {
+                        tracing::debug!(
+                            stage = "initial-owner",
+                            "native retained destination check refused"
+                        );
+                        error
+                    })?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                held.validate_retained_provider().map_err(|error| {
+                    tracing::debug!(
+                        stage = "initial-provider",
+                        "native retained destination check refused"
+                    );
+                    error
+                })?;
+                let candidate = held.destination_candidate.as_ref().ok_or_else(refused)?;
+                if candidate.id != id {
+                    return Err(refused());
+                }
+                let mcp = if held
+                    .journal
+                    .mcp_receipt
+                    .as_ref()
+                    .is_some_and(|r| r.phase == "constructed")
+                {
+                    if held.journal.mcp_shutdown_id.is_some() {
+                        return Err(refused());
+                    }
+                    let startup = held.mcp_startup.as_ref().ok_or_else(refused)?;
+                    if startup.state() != codex_mcp::NativeMcpStartupState::Published {
+                        return Err(refused());
+                    }
+                    Some(Arc::clone(startup))
+                } else {
+                    None
+                };
+                let capture_required = mcp.is_some()
+                    && held
+                        .journal
+                        .mcp_grant
+                        .as_ref()
+                        .ok_or_else(refused)?
+                        .mcp_plan
+                        .effects
+                        .binding_capture;
+                let binding = if capture_required {
+                    Some(Arc::clone(held.mcp_binding.as_ref().ok_or_else(refused)?))
+                } else {
+                    if held.mcp_binding.is_some() {
+                        return Err(refused());
+                    }
+                    None
+                };
+                let plugin_required = mcp.is_some()
+                    && held
+                        .journal
+                        .mcp_grant
+                        .as_ref()
+                        .ok_or_else(refused)?
+                        .mcp_plan
+                        .effects
+                        .plugin_capture;
+                let plugins = if plugin_required {
+                    Some(Arc::clone(held.mcp_plugins.as_ref().ok_or_else(refused)?))
+                } else {
+                    if held.mcp_plugins.is_some() {
+                        return Err(refused());
+                    }
+                    None
+                };
+                let skill_required = mcp.is_some()
+                    && held
+                        .journal
+                        .mcp_grant
+                        .as_ref()
+                        .ok_or_else(refused)?
+                        .mcp_plan
+                        .effects
+                        .skill_capture;
+                let skills = if skill_required {
+                    Some(Arc::clone(held.mcp_skills.as_ref().ok_or_else(refused)?))
+                } else {
+                    if held.mcp_skills.is_some() {
+                        return Err(refused());
+                    }
+                    None
+                };
+                (Arc::clone(candidate), mcp, binding, plugins, skills)
+            };
+            self.continuity_validate_destination_preparation(owner, &candidate.preparation)
+                .await
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "preparation",
+                        "native retained destination check refused"
+                    );
+                    error
+                })?;
+            if let Some(startup) = &mcp
+                && !startup
+                    .runtime()
+                    .native_required_connections_are_live()
+                    .await
+            {
+                tracing::debug!(
+                    stage = "mcp-live",
+                    "native retained destination check refused"
+                );
+                return Err(refused());
+            }
+            if let Some(binding) = &binding
+                && !binding
+                    .is_current(mcp.as_ref().ok_or_else(refused)?.runtime())
+                    .await
+            {
+                tracing::debug!(
+                    stage = "mcp-binding",
+                    "native retained destination check refused"
+                );
+                return Err(refused());
+            }
+            if let Some(plugins) = &plugins
+                && (!plugins.is_current(
+                    &self.services.plugins_manager,
+                    &candidate.preparation.config().plugins_config_input(),
+                ) || !plugins.selection_discovery_current(
+                    self,
+                    &candidate.preparation.execution_config,
+                    candidate.preparation.configuration.inputs.environments(),
+                ))
+            {
+                tracing::debug!(
+                    stage = "plugins",
+                    "native retained destination check refused"
+                );
+                return Err(refused());
+            }
+            if let Some(skills) = &skills
+                && !skills.is_current(&self.services.skills_service).await
+            {
+                tracing::debug!(
+                    stage = "skills",
+                    "native retained destination check refused"
+                );
+                return Err(refused());
+            }
+            let state = self.state.lock().await;
+            state
+                .continuity
+                .check(owner, reservation)
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "final-owner",
+                        "native retained destination check refused"
+                    );
+                    error
+                })?;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            held.validate_retained_provider().map_err(|error| {
+                tracing::debug!(
+                    stage = "final-provider",
+                    "native retained destination check refused"
+                );
+                error
+            })?;
+            if !held
+                .destination_candidate
+                .as_ref()
+                .is_some_and(|current| Arc::ptr_eq(current, &candidate))
+                || match &binding {
+                    Some(expected) => !held
+                        .mcp_binding
+                        .as_ref()
+                        .is_some_and(|actual| Arc::ptr_eq(actual, expected)),
+                    None => held.mcp_binding.is_some(),
+                }
+                || match &plugins {
+                    Some(expected) => !held
+                        .mcp_plugins
+                        .as_ref()
+                        .is_some_and(|actual| Arc::ptr_eq(actual, expected)),
+                    None => held.mcp_plugins.is_some(),
+                }
+                || plugins.as_ref().is_some_and(|plugins| {
+                    !plugins.selection_discovery_current(
+                        self,
+                        &candidate.preparation.execution_config,
+                        candidate.preparation.configuration.inputs.environments(),
+                    )
+                })
+                || match &skills {
+                    Some(expected) => !held
+                        .mcp_skills
+                        .as_ref()
+                        .is_some_and(|actual| Arc::ptr_eq(actual, expected)),
+                    None => held.mcp_skills.is_some(),
+                }
+                || match &mcp {
+                    Some(expected) => {
+                        held.journal.mcp_shutdown_id.is_some()
+                            || !held
+                                .journal
+                                .mcp_receipt
+                                .as_ref()
+                                .is_some_and(|r| r.phase == "constructed")
+                            || !held
+                                .mcp_startup
+                                .as_ref()
+                                .is_some_and(|actual| Arc::ptr_eq(actual, expected))
+                            || expected.state() != codex_mcp::NativeMcpStartupState::Published
+                    }
+                    None => held
+                        .journal
+                        .mcp_receipt
+                        .as_ref()
+                        .is_some_and(|r| r.phase == "constructed"),
+                }
+            {
+                tracing::debug!(
+                    stage = "final-identity",
+                    "native retained destination check refused"
+                );
+                return Err(refused());
+            }
+            Ok(())
+        }
+        .boxed()
+    }
+
+    pub(super) fn continuity_validate_destination_preparation<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        prepared: &'a ContinuityDestinationPreparation,
+    ) -> futures::future::BoxFuture<'a, CodexResult<()>> {
+        async move {
+            self.continuity_validate_configuration_preparation(owner, &prepared.configuration)
+                .boxed()
+                .await
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "configuration-before",
+                        "native destination preparation check refused"
+                    );
+                    error
+                })?;
+            if !prepared.has_closed_native_enforcers() {
+                tracing::debug!(
+                    stage = "enforcers",
+                    "native destination preparation check refused"
+                );
+                return Err(refused());
+            }
+            let (runtime_inputs, effective_inputs) = self.continuity_destination_runtime_inputs(
+                &prepared.configuration,
+                &prepared.provider,
+            )?;
+            if *effective_inputs != *prepared.execution_config
+                || runtime_inputs.step_settings != prepared.runtime.step_settings
+                || runtime_inputs.permission_profile_state
+                    != prepared.runtime.permission_profile_state
+                || !Arc::ptr_eq(&runtime_inputs.provider, &prepared.runtime.provider)
+            {
+                tracing::debug!(
+                    stage = "runtime-inputs",
+                    "native destination preparation check refused"
+                );
+                return Err(refused());
+            }
+            let runtime = prepared.runtime_configuration();
+            let model_config = runtime
+                .model_info_overrides
+                .models_manager_config(runtime.step_settings.personality);
+            let check_model = || {
+                if !prepared.provider.revalidate(
+                    &runtime.provider,
+                    &prepared.config().model_providers,
+                    prepared
+                        .config()
+                        .config_layer_stack
+                        .required_model_provider(),
+                ).map_err(|error| {
+                    tracing::debug!(stage = "provider-error", "native model check refused");
+                    error
+                })? {
+                    tracing::debug!(stage = "provider-changed", "native model check refused");
+                    return Err(refused());
+                }
+                if !prepared
+                    .model
+                    .revalidate(&self.services.models_manager.load_full(), &model_config)
+                    .map_err(|error| {
+                        let busy = matches!(error.details(), codex_protocol::error::CodexErrorDetails::Io(value) if value.kind() == std::io::ErrorKind::WouldBlock);
+                        tracing::debug!(stage = "metadata-error", busy, "native model check refused");
+                        error
+                    })?
+                {
+                    tracing::debug!(stage = "metadata-changed", "native model check refused");
+                    return Err(refused());
+                }
+                Ok(())
+            };
+            retry_busy_observation(|| async { check_model() }).await.map_err(|error| {
+                tracing::debug!(
+                    stage = "model-before",
+                    "native destination preparation check refused"
+                );
+                error
+            })?;
+            self.services
+                .agents_md_manager
+                .revalidate_native_instructions(
+                    prepared.config(),
+                    prepared.configuration.inputs.environments(),
+                    &prepared.instructions,
+                )
+                .boxed()
+                .await
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "instructions",
+                        "native destination preparation check refused"
+                    );
+                    error
+                })?;
+            retry_busy_observation(|| async { check_model() }).await.map_err(|error| {
+                tracing::debug!(
+                    stage = "model-after",
+                    "native destination preparation check refused"
+                );
+                error
+            })?;
+            // Bracket instruction I/O with the configuration/runtime/owner fences;
+            // a separately fresh model or instruction snapshot cannot retag Config.
+            self.continuity_validate_configuration_preparation(owner, &prepared.configuration)
+                .boxed()
+                .await
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "configuration-after",
+                        "native destination preparation check refused"
+                    );
+                    error
+                })?;
+            retry_busy_observation(|| async { check_model() }).await.map_err(|error| {
+                tracing::debug!(
+                    stage = "model-final",
+                    "native destination preparation check refused"
+                );
+                error
+            })?;
+            self.services
+                .agents_md_manager
+                .validate_native_instruction_source(&prepared.instructions)
+                .map_err(|error| {
+                    tracing::debug!(
+                        stage = "instruction-source",
+                        "native destination preparation check refused"
+                    );
+                    error
+                })?;
+            Ok(())
+        }
+        .boxed()
+    }
+
+    pub(super) async fn continuity_prepare_model(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityModelPreparation> {
+        let inputs = self
+            .continuity_candidate_inputs(owner, reservation, cwd)
+            .await?;
+        let configuration = &inputs.configuration;
+        let config = configuration
+            .model_info_overrides
+            .models_manager_config(configuration.step_settings.personality);
+        let metadata = codex_model_provider::prepare_model_metadata(
+            &self.services.models_manager.load_full(),
+            configuration.step_settings.collaboration_mode.model(),
+            &config,
+        )?;
+        let prepared = ContinuityModelPreparation { inputs, metadata };
+        self.continuity_validate_model_preparation(owner, &prepared)
+            .await?;
+        Ok(prepared)
+    }
+
+    pub(super) async fn continuity_validate_model_preparation(
+        &self,
+        owner: &ContinuityOwner,
+        prepared: &ContinuityModelPreparation,
+    ) -> CodexResult<()> {
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await?;
+        let state = self.state.lock().await;
+        let current = &state.session_configuration;
+        let captured = &prepared.inputs.configuration;
+        state
+            .continuity
+            .check(owner, &prepared.inputs.reservation)?;
+        if !Arc::ptr_eq(&current.provider, &captured.provider)
+            || current.step_settings != captured.step_settings
+            || current.model_info_overrides != captured.model_info_overrides
+        {
+            return Err(refused());
+        }
+        let config = current
+            .model_info_overrides
+            .models_manager_config(current.step_settings.personality);
+        if !prepared
+            .metadata
+            .revalidate(&self.services.models_manager.load_full(), &config)?
+        {
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    pub(super) async fn continuity_prepare_instructions(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityInstructionPreparation> {
+        let inputs = self
+            .continuity_candidate_inputs(owner, reservation, cwd.clone())
+            .await?;
+        let environment = inputs
+            .environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        let filesystem = environment.environment.get_filesystem();
+        let project = codex_config::loader::preview_project_configuration(
+            filesystem.as_ref(),
+            inputs.source_config.codex_home.as_path(),
+            &inputs.source_config.config_layer_stack,
+            &cwd,
+        )
+        .await?;
+        self.continuity_validate_candidate_inputs(owner, &inputs)
+            .await?;
+        let config = instruction_config(&inputs, &project)?;
+        let instructions = self
+            .services
+            .agents_md_manager
+            .preview(&config, &inputs.environments)
+            .await?;
+        let prepared = ContinuityInstructionPreparation {
+            inputs,
+            project,
+            instructions,
+        };
+        self.continuity_validate_instruction_preparation(owner, &prepared)
+            .await?;
+        Ok(prepared)
+    }
+
+    /// Observation-time revalidation. Publication must still atomically consume
+    /// complete current authority and perform the native receiver/release flow.
+    pub(super) async fn continuity_validate_instruction_preparation(
+        &self,
+        owner: &ContinuityOwner,
+        prepared: &ContinuityInstructionPreparation,
+    ) -> CodexResult<()> {
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await?;
+        let environment = prepared
+            .inputs
+            .environments
+            .single_local_environment()
+            .ok_or_else(refused)?;
+        let filesystem = environment.environment.get_filesystem();
+        if !prepared.project.revalidate(filesystem.as_ref()).await? {
+            return Err(refused());
+        }
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await?;
+        let config = instruction_config(&prepared.inputs, &prepared.project)?;
+        let fresh = self
+            .services
+            .agents_md_manager
+            .preview(&config, &prepared.inputs.environments)
+            .await?;
+        if fresh != prepared.instructions {
+            return Err(refused());
+        }
+        self.continuity_validate_candidate_inputs(owner, &prepared.inputs)
+            .await
+    }
+
+    pub(crate) async fn continuity_commit(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        transition_id: uuid::Uuid,
+        cwd: AbsolutePathBuf,
+    ) -> CodexResult<ContinuityCommitReceipt> {
+        let path = self.continuity_receipt_path().await;
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let canonical = fs::canonicalize(cwd.as_path()).map_err(|_| refused())?;
+        if canonical != cwd.as_path() || !canonical.is_dir() {
+            return Err(refused());
+        }
+        let (updates, mut journal) = {
+            let mut state = self.state.lock().await;
+            let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+            if !owner.is_open()
+                || &held.owner != owner
+                || held.invalid
+                || held.approved.is_some()
+                || held.destination_candidate.is_some()
+                || held.provider_plan.is_some()
+                || held.mcp_plan.is_some()
+                || held.journal.host_grant.is_some()
+                || held.journal.provider_grant.is_some()
+            {
+                return Err(refused());
+            }
+            if let Some(receipt) = &held.journal.receipt {
+                return if held.original.as_ref() == Some(reservation)
+                    && receipt.transition_id == transition_id
+                    && receipt.cwd == cwd
+                {
+                    Ok(receipt.clone())
+                } else {
+                    Err(refused())
+                };
+            }
+            // A cancelled or still-running commit may already have persisted
+            // its intent. Never replace that identity or replay the effect.
+            if held.journal.phase != "acquired"
+                || held.original.is_some()
+                || held.journal.transition_id.is_some()
+                || held.journal.cwd.is_some()
+            {
+                return Err(refused());
+            }
+            state.continuity.check(owner, reservation)?;
+            if held
+                .journal
+                .history
+                .iter()
+                .any(|receipt| receipt.transition_id == transition_id)
+            {
+                return Err(refused());
+            }
+            let (updates, _) =
+                self.continuity_settings_candidate(&state.session_configuration, &cwd)?;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.history.len() >= MAX_RECEIPTS {
+                return Err(refused());
+            }
+            held.original = Some(reservation.clone());
+            held.journal.phase = "submitting".into();
+            held.journal.transition_id = Some(transition_id);
+            held.journal.cwd = Some(cwd.clone());
+            if write_journal(&path, &held.journal).is_err() {
+                held.invalidate();
+                return Err(refused());
+            }
+            (updates, held.journal.clone())
+        };
+        #[cfg(test)]
+        {
+            let pause = PAUSE_COMMIT_AFTER_INTENT
+                .get_or_init(Default::default)
+                .lock()
+                .unwrap()
+                .remove(&transition_id);
+            if let Some(ready) = pause {
+                ready.notify_one();
+                std::future::pending::<()>().await;
+            }
+        }
+        let effect = async {
+            let commit = self
+                .update_settings_if_authorized(updates, |_, _| true, Some((owner, reservation)))
+                .await
+                .map_err(|_| refused())?
+                .ok_or_else(refused)?;
+            let live = self.live_thread().ok_or_else(refused)?;
+            live.append_items(&[codex_history::RolloutItem::EventMsg(
+                codex_protocol::protocol::EventMsg::ThreadSettingsApplied(
+                    codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                        continuity_operation_id: None,
+                        thread_id: Some(self.thread_id),
+                        thread_settings: commit.snapshot,
+                    },
+                ),
+            )])
+            .await
+            .map_err(|_| refused())?;
+            live.flush().await.map_err(|_| refused())?;
+            let mut state = self.state.lock().await;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.invalid || !owner.is_open() {
+                return Err(refused());
+            }
+            let receipt = ContinuityCommitReceipt {
+                transition_id,
+                reservation: held.reservation.clone(),
+                source_cwd: journal.source_cwd.clone(),
+                cwd,
+            };
+            journal.phase = "committed".into();
+            journal.reservation = receipt.reservation.clone();
+            journal.receipt = Some(receipt.clone());
+            write_journal(&path, &journal)?;
+            held.journal = journal.clone();
+            Ok(receipt)
+        }
+        .await;
+        if effect.is_err() {
+            let mut state = self.state.lock().await;
+            state.continuity.invalidate();
+            if let Some(held) = state.continuity.held.as_mut() {
+                held.journal.phase = "uncertain".into();
+                let _ = write_journal(&path, &held.journal);
+            }
+        }
+        effect
+    }
+
+    pub(crate) async fn continuity_invalidate(&self, owner: Option<&ContinuityOwner>) {
+        let path = self.continuity_receipt_path().await;
+        let mut state = self.state.lock().await;
+        if let Some(held) = state.continuity.held.as_mut()
+            && owner.is_none_or(|owner| owner == &held.owner)
+        {
+            held.invalidate();
+            held.journal.phase = "uncertain".into();
+            let _ = write_journal(&path, &held.journal);
+        }
+    }
+}
