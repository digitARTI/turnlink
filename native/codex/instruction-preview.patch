+    /// Observe the exact still-live binding without repeating its journal write.
+    pub(crate) async fn continuity_observe_destination_grant(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant,
+        retained: &codex_protocol::protocol::ContinuityStepPreparationReceipt,
+    ) -> CodexResult<()> {
+        let state = self.state.lock().await;
+        state
+            .continuity
+            .check_owner_and_source(owner, reservation)?;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        if held.invalid
+            || !held
+                .journal
+                .step
+                .as_ref()
+                .is_some_and(|step| step.receipt.as_ref() == Some(retained))
+        {
+            return Err(refused());
+        }
+        held.approved
+            .as_ref()
+            .ok_or_else(refused)?
+            .validate_binding(
+                grant,
+                &held.journal,
+                &state.session_configuration.legacy_fallback_cwd,
+            )
+    }
