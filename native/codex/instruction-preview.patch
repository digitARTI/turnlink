+pub(crate) async fn run(
+    stream: UnixStream,
+    processor: Arc<MessageProcessor>,
+    connection_id: ConnectionId,
+    session: Arc<ConnectionSessionState>,
+) {
+    let (read, mut write) = stream.into_split();
+    let cancel = CancellationToken::new();
+    let (tx, mut rx) = mpsc::channel(8);
+    let reader = async {
+        let mut reader = BufReader::new(read);
+        let mut last = 0;
+        loop {
+            tokio::select! {
+                _ = cancel.cancelled() => break,
+                request = frame(&mut reader) => match request {
+                    Ok(Some(request)) if request.id > last && request.id <= 9_007_199_254_740_991 => {
+                        last = request.id;
+                        if tx.try_send(request).is_err() { break; }
+                    }
+                    _ => break,
+                }
+            }
+        }
+        session.continuity_owner.close();
+        cancel.cancel();
+    };
+    let worker = async {
+        #[cfg(debug_assertions)]
+        let mut checkpoint_watched = false;
+        loop {
+            let request = tokio::select! { _ = cancel.cancelled() => break, request = rx.recv() => match request { Some(request) => request, None => break } };
+            let id = request.id;
+            #[cfg(debug_assertions)]
+            let result = if let Operation::WatchCheckpointSnapshot { thread_id, reservation, grant, digest } = &request.operation {
+                if checkpoint_watched { Err(()) } else {
+                    let watched = tokio::select! {
+                        _ = cancel.cancelled() => break,
+                        watched = processor.continuity_watch_checkpoint_snapshot(connection_id, &session, thread_id, reservation, grant, digest) => watched,
+                    };
+                    match watched {
+                        Ok(mut watch) if !*watch.borrow() => {
+                            checkpoint_watched = true;
+                            let watch_cancel = cancel.clone();
+                            let owner = session.continuity_owner.clone();
+                            tokio::spawn(async move {
+                                tokio::select! {
+                                    _ = watch_cancel.cancelled() => {},
+                                    changed = watch.changed() => {
+                                        if changed.is_err() || *watch.borrow() { owner.close(); watch_cancel.cancel(); }
+                                    }
+                                }
+                            });
+                            Ok(json!({"status":"watching_unverified","releaseAllowed":false}))
+                        }
+                        _ => Err(()),
+                    }
+                }
+            } else { tokio::select! {
+                _ = cancel.cancelled() => break,
+                result = processor.continuity_host_request(connection_id, &session, request.operation) => result,
+            }};
+            #[cfg(not(debug_assertions))]
+            let result = tokio::select! {
+                _ = cancel.cancelled() => break,
+                result = processor.continuity_host_request(connection_id, &session, request.operation) => result,
+            };
+            if !session.continuity_owner.is_open() {
+                break;
+            }
+            let response = match result {
+                Ok(value) => json!({"id":id,"result":value}),
+                Err(()) => json!({"id":id,"error":"NATIVE_CONTINUITY_UNAVAILABLE"}),
+            };
+            let mut encoded = match serde_json::to_vec(&response) {
+                Ok(encoded) => encoded,
+                Err(_) => break,
+            };
+            encoded.push(b'\n');
+            let written = tokio::select! { _ = cancel.cancelled() => break, written = write.write_all(&encoded) => written };
+            if written.is_err() {
+                break;
+            }
+        }
+        session.continuity_owner.close();
+        cancel.cancel();
+    };
+    tokio::join!(reader, worker);
+    processor
+        .continuity_host_closed(&session.continuity_owner)
+        .await;
+}
+
+pub(crate) fn result(value: impl serde::Serialize) -> Result<Value, ()> {
+    serde_json::to_value(value).map_err(|_| ())
+}
