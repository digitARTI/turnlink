+    use crate::provider::{
+        SkillProvider, SkillProviderFuture, SkillReadRequest, SkillSearchRequest,
+    };
+    use crate::sources::SkillProviderSource;
+    use codex_extension_api::{SelectedPluginSnapshot, StepPreparationInput};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use tokio::sync::Notify;
+
+    struct BlockingProvider {
+        calls: Arc<AtomicUsize>,
+        started: Arc<Notify>,
+    }
+    impl SkillProvider for BlockingProvider {
+        fn list(&self, _: SkillListQuery) -> SkillProviderFuture<'_, SkillCatalog> {
+            let calls = self.calls.clone();
+            let started = self.started.clone();
+            Box::pin(async move {
+                calls.fetch_add(1, Ordering::SeqCst);
+                started.notify_one();
+                std::future::pending::<SkillProviderResult<SkillCatalog>>().await
+            })
+        }
+        fn read<'a>(&'a self, _: SkillReadRequest<'a>) -> SkillProviderFuture<'a, SkillReadResult> {
+            panic!("no read expected")
+        }
+        fn search(&self, _: SkillSearchRequest) -> SkillProviderFuture<'_, SkillSearchResult> {
+            panic!("no search expected")
+        }
+    }
+    let calls = Arc::new(AtomicUsize::new(0));
+    let started = Arc::new(Notify::new());
+    let providers = SkillProviders::new().with_provider(SkillProviderSource::new(
+        SkillSourceKind::custom("blocking"),
+        "blocking",
+        Arc::new(BlockingProvider {
+            calls: calls.clone(),
+            started: started.clone(),
+        }),
+    ));
+    let mut builder = ExtensionRegistryBuilder::<()>::new();
+    install_with_providers_metrics_and_native_witnesses(
+        &mut builder,
+        providers,
+        None,
+        |_: &()| SkillsExtensionConfig {
+            include_instructions: false,
+            max_context_tokens: None,
+            bundled_skills_enabled: false,
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        },
+        || Some(Box::new(|| true)),
+        || Some(Box::new(|| true)),
+    );
+    let registry = builder.build();
+    let session = Arc::new(ExtensionData::new("session"));
+    let thread = Arc::new(ExtensionData::new("thread"));
+    thread.insert(SkillsThreadState::new(
+        SkillsExtensionConfig {
+            include_instructions: false,
+            max_context_tokens: None,
+            bundled_skills_enabled: false,
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        },
+        false,
+        None,
+    ));
+    let mcp = Arc::new(McpResourceClient::new(Arc::new(
+        codex_mcp::McpRuntime::empty(false),
+    )));
+    for (index, duplicate) in [true, false].into_iter().enumerate() {
+        let id = format!("target-{index}");
+        let step = Arc::new(ExtensionData::new(&id));
+        let turn = Arc::new(ExtensionData::new(&id));
+        assert!(native_detach_skill_step(&thread, &step, mcp.clone()));
+        assert_eq!(
+            native_project_detached_skill_step(
+                registry.tool_contributors()[0].as_ref(),
+                &(),
+                false,
+                &thread,
+                &step
+            ),
+            Some(false)
+        );
+        assert!(native_bind_skill_turn(&step, &turn));
+        step.insert(NativeSkillPromptModel {
+            include_usage: false,
+            context_window: None,
+        });
+        registry.tool_contributors()[0]
+            .prepare_for_step(StepPreparationInput {
+                turn_id: &id,
+                ready_selected_capability_roots: &[],
+                executor_capability_discovery: None,
+                executor_capability_discovery_v2: None,
+                selected_plugins: &SelectedPluginSnapshot::default(),
+                session_store: &session,
+                thread_store: &thread,
+                turn_store: &turn,
+                step_store: &step,
+            })
+            .await;
+        assert!(native_detached_skill_step_ready(&step));
+        assert_eq!(
+            registry.tool_contributors()[0].native_target_step_current(&step),
+            Some(true)
+        );
+        let contributor = registry.turn_input_contributors()[0].clone();
+        let running = tokio::spawn({
+            let (session, thread, turn, step, id) = (
+                session.clone(),
+                thread.clone(),
+                turn.clone(),
+                step.clone(),
+                id.clone(),
+            );
+            async move {
+                contributor
+                    .contribute(
+                        TurnInputContext {
+                            step_store: &step,
+                            turn_id: id,
+                            user_input: Vec::new(),
+                            environments: Vec::new(),
+                        },
+                        None,
+                        &session,
+                        &thread,
+                        &turn,
+                    )
+                    .await
+            }
+        });
+        tokio::time::timeout(std::time::Duration::from_secs(5), started.notified())
+            .await
+            .unwrap();
+        assert!(
+            !native_detached_skill_step_ready(&step),
+            "in-flight effects must not look ready"
+        );
+        assert_eq!(
+            registry.tool_contributors()[0].native_target_step_current(&step),
+            Some(false)
+        );
+        if duplicate {
+            let duplicate_result = registry.turn_input_contributors()[0]
+                .contribute(
+                    TurnInputContext {
+                        step_store: &step,
+                        turn_id: id.clone(),
+                        user_input: Vec::new(),
+                        environments: Vec::new(),
+                    },
+                    None,
+                    &session,
+                    &thread,
+                    &turn,
+                )
+                .await;
+            assert!(duplicate_result.is_empty());
+            assert_eq!(
+                calls.load(Ordering::SeqCst),
+                index + 1,
+                "duplicate must not reenter provider"
+            );
+        }
+        running.abort();
+        assert!(matches!(running.await, Err(error) if error.is_cancelled()));
+        assert!(!native_detached_skill_step_ready(&step));
+        assert_eq!(
+            registry.tool_contributors()[0].native_target_step_current(&step),
+            Some(false)
+        );
+        let retry = registry.turn_input_contributors()[0]
+            .contribute(
+                TurnInputContext {
+                    step_store: &step,
+                    turn_id: id,
+                    user_input: Vec::new(),
+                    environments: Vec::new(),
+                },
+                None,
+                &session,
+                &thread,
+                &turn,
+            )
+            .await;
+        assert!(retry.is_empty());
+        assert_eq!(
+            calls.load(Ordering::SeqCst),
+            index + 1,
+            "cancelled work must not replay"
+        );
+    }
+}
