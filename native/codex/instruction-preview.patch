+/// Private preparation state for an unpublished native destination step.
+/// Its presence does not establish freshness or permission to install a step.
+pub struct NativeDetachedSkillStep {
+    pub(crate) state: Arc<SkillsThreadState>,
+    pub(crate) mcp_resources: Arc<McpResourceClient>,
+    projection_witness: Option<NativeSkillProjectionWitness>,
+    diagnostics: Arc<NativeSkillDiagnostics>,
+    pending_shadow:
+        Arc<std::sync::Mutex<Option<crate::shadow_selection_experiment::PendingShadowSelection>>>,
+    input_gate: Arc<std::sync::atomic::AtomicU8>,
+}
+
+const INPUT_IDLE: u8 = 0;
+const INPUT_ACTIVE: u8 = 1;
+const INPUT_COMPLETE: u8 = 2;
+const INPUT_UNCERTAIN: u8 = 3;
+
+/// One in-memory attempt. Cancellation, duplicate entry, or a failed freshness
+/// check poisons the attempt; this is not a durable recovery receipt.
+struct NativeSkillInputLease {
+    gate: Arc<std::sync::atomic::AtomicU8>,
+    diagnostics: Arc<NativeSkillDiagnostics>,
+    complete: bool,
+}
+
+impl NativeSkillInputLease {
+    fn begin(detached: &NativeDetachedSkillStep) -> Option<Self> {
+        use std::sync::atomic::Ordering;
+        if detached
+            .input_gate
+            .compare_exchange(INPUT_IDLE, INPUT_ACTIVE, Ordering::SeqCst, Ordering::SeqCst)
+            .is_err()
+        {
+            detached.input_gate.store(INPUT_UNCERTAIN, Ordering::SeqCst);
+            detached.diagnostics.failed.store(true, Ordering::SeqCst);
+            return None;
+        }
+        Some(Self {
+            gate: Arc::clone(&detached.input_gate),
+            diagnostics: Arc::clone(&detached.diagnostics),
+            complete: false,
+        })
+    }
+
+    fn finish(&mut self) -> bool {
+        use std::sync::atomic::Ordering;
+        if self
+            .gate
+            .compare_exchange(
+                INPUT_ACTIVE,
+                INPUT_COMPLETE,
+                Ordering::SeqCst,
+                Ordering::SeqCst,
+            )
+            .is_err()
+        {
+            return false;
+        }
+        self.complete = true;
+        true
+    }
+}
+
+impl Drop for NativeSkillInputLease {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.gate
+                .store(INPUT_UNCERTAIN, std::sync::atomic::Ordering::SeqCst);
+            self.diagnostics
+                .failed
+                .store(true, std::sync::atomic::Ordering::SeqCst);
+        }
+    }
+}
