+/// Materialize a real loopback MCP binding during test setup, before preparation.
+pub(crate) async fn tool_preparation_mcp_fixture(
+    url: String,
+) -> (
+    tempfile::TempDir,
+    Arc<Session>,
+    Arc<TurnContext>,
+    Arc<codex_mcp::McpBinding>,
+) {
+    let (session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).supports_search_tool = true;
+    });
+    let session = Arc::new(session);
+    let environments = session.services.turn_environments.snapshot().await;
+    let configuration = session.state.lock().await.session_configuration.clone();
+    let mut config = (*mcp_config_for_test(&turn.config)).clone();
+    let home = tempfile::tempdir().unwrap();
+    config.codex_home = home.path().to_path_buf();
+    config.mcp_oauth_credentials_store_mode = codex_config::types::OAuthCredentialsStoreMode::File;
+    let server: McpServerConfig = serde_json::from_value(serde_json::json!({"url": url})).unwrap();
+    let mut catalog = codex_mcp::ResolvedMcpCatalog::builder();
+    catalog.register(codex_mcp::McpServerRegistration::from_config(
+        "preview".into(),
+        server,
+    ));
+    config.mcp_server_catalog = catalog.build();
+    session
+        .install_initial_mcp_runtime(
+            &configuration,
+            None,
+            crate::mcp::McpRuntimeProjection {
+                config,
+                plugins_available: false,
+                selected_plugins: Default::default(),
+                plugin_observation: None,
+            },
+            &environments,
+        )
+        .await
+        .unwrap();
+    let binding = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        session
+            .services
+            .mcp_runtime
+            .load_full()
+            .current_binding_with_requirements(
+                &["preview".into()],
+                &std::collections::HashSet::new(),
+            ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(
+        !binding.tools().is_empty(),
+        "fixture must materialize actual native tool metadata"
+    );
+    (home, session, Arc::new(turn), binding)
+}
