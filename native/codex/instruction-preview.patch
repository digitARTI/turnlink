+/// Capture only already-applied native thread policy. This never discovers
+/// skills or invokes a provider; unavailable or locked state is refused.
+pub fn native_observe_skill_tool_policy(
+    thread_store: &ExtensionData,
+) -> Option<NativeSkillToolPolicyObservation> {
+    let owner = thread_store.native_try_get::<SkillsThreadState>()?;
+    let config = owner.config.try_lock().ok()?;
+    let observation = NativeSkillToolPolicyObservation {
+        owner: Arc::downgrade(&owner),
+        generation: Arc::downgrade(&config.generation),
+        cloud_enabled: owner.cloud_skills_available && config.value.cloud_skill_enabled,
+    };
+    drop(config);
+    observation.is_current(thread_store).then_some(observation)
+}
