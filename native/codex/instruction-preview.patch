+// A published target must still match the external inputs its contributors
+// explicitly captured. Revalidation may perform I/O and is never run under
+// the session or settings persistence locks. A timeout is a refusal, not proof
+// that any contributor or remote resource is current.
+async fn published_target_plan_current(session: &Session, target: &RetainedTargetStep) -> bool {
+    if !target.tool_plan_current(session)
+        || !session.continuity_target_non_model_volatile_inputs_current(&target._target).unwrap_or(false)
+    {
+        return false;
+    }
+    let prepared = &target._target.inputs.candidate.preparation;
+    matches!(
+        tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            async {
+                let inputs = &target._target.inputs;
+                let Some(environment) = prepared.configuration.inputs.environments().single_local_environment() else {
+                    return false;
+                };
+                let filesystem = environment.environment.get_filesystem();
+                prepared.has_closed_native_enforcers()
+                    && prepared.configuration.destination.revalidate(
+                        filesystem.as_ref(),
+                        &prepared.configuration.inputs.source_config,
+                    ).await.unwrap_or(false)
+                    && inputs.plugins.is_current(
+                    &session.services.plugins_manager,
+                    &prepared.config().plugins_config_input(),
+                ) && inputs.plugins.selection_discovery_current(
+                    session,
+                    &prepared.execution_config,
+                    prepared.configuration.inputs.environments(),
+                ) && (match &inputs.skills {
+                    Some(skills) => skills.is_current(&session.services.skills_service).await,
+                    None => true,
+                }) && native_target_contributors_current(session, &target._target.step_extension_data).await
+                    && session.services.agents_md_manager.revalidate_native_instructions(
+                        prepared.config(),
+                        prepared.configuration.inputs.environments(),
+                        &prepared.instructions,
+                    ).await.is_ok()
+            },
+        ).await,
+        Ok(true)
+    ) && target.tool_plan_current(session)
+        && session.continuity_target_non_model_volatile_inputs_current(&target._target).unwrap_or(false)
+}
