+#[tokio::test]
+async fn native_closed_session_comparison_refuses_owner_and_hidden_changes() {
+    let session = make_session_configuration_for_tests().await;
+    let same = session.clone();
+    assert!(session.native_matches_closed_session(&same));
+    let mut changed = same.clone(); changed.originator.push_str("-changed");
+    assert!(!session.native_matches_closed_session(&changed));
+    let mut changed = same.clone(); changed.base_instructions.push_str(" changed");
+    assert!(!session.native_matches_closed_session(&changed));
+    let mut changed = same.clone(); changed.turn_extension_init.insert(1_u32);
+    assert!(!session.native_matches_closed_session(&changed));
+    let mut changed = same.clone(); changed.turn_extension_init = changed.turn_extension_init.native_new_application();
+    assert!(!session.native_matches_closed_session(&changed));
+    let mut changed = same.clone(); changed.original_config_do_not_use = Arc::new((*changed.original_config_do_not_use).clone());
+    assert!(!session.native_matches_closed_session(&changed));
+    let mut changed = same.clone();
+    let settings = Arc::make_mut(&mut changed.step_settings);
+    settings.approval_policy = codex_config::Constrained::allow_any(settings.approval_policy.value());
+    assert_eq!(session.step_settings, changed.step_settings);
+    assert!(!session.native_matches_closed_session(&changed));
+}
