+fn read_journal_with_observers(
+    path: &Path,
+    thread_id: &str,
+    after_metadata: impl FnOnce(),
+    after_read: impl FnOnce(),
+) -> CodexResult<Option<Journal>> {
+    #[cfg(unix)]
+    let (parent, parent_metadata) = {
+        let parent = path.parent().ok_or_else(refused)?;
+        let metadata = match fs::symlink_metadata(parent) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return match fs::symlink_metadata(parent) {
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+                    _ => Err(refused()),
+                };
+            }
+            Err(_) => return Err(refused()),
+        };
+        if !journal_directory_matches(&metadata, &metadata) {
+            return Err(refused());
+        }
+        (parent, metadata)
+    };
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            #[cfg(unix)]
+            if !journal_directory_matches(&parent_metadata, &fs::symlink_metadata(parent).map_err(|_| refused())?) {
+                return Err(refused());
+            }
+            return Ok(None);
+        }
+        Err(_) => return Err(refused()),
+    };
+    if !metadata.is_file() || metadata.len() > MAX_JOURNAL_BYTES {
+        return Err(refused());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.mode() & 0o077 != 0
+            || metadata.nlink() != 1
+            || metadata.uid() != unsafe { libc::geteuid() }
+        {
+            return Err(refused());
+        }
+    }
+    let mut options = fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    after_metadata();
+    let mut file = options.open(path).map_err(|_| refused())?;
+    #[cfg(unix)]
+    if !journal_metadata_matches(&metadata, &file.metadata().map_err(|_| refused())?) {
+        return Err(refused());
+    }
+    let mut bytes = Vec::new();
+    (&mut file)
+        .take(MAX_JOURNAL_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| refused())?;
+    after_read();
+    if bytes.len() as u64 > MAX_JOURNAL_BYTES {
+        return Err(refused());
+    }
+    #[cfg(unix)]
+    if !journal_metadata_matches(&metadata, &file.metadata().map_err(|_| refused())?)
+        || !journal_metadata_matches(&metadata, &fs::symlink_metadata(path).map_err(|_| refused())?)
+        || !journal_directory_matches(&parent_metadata, &fs::symlink_metadata(parent).map_err(|_| refused())?)
+    {
+        return Err(refused());
+    }
+    let journal: Journal = serde_json::from_slice(&bytes).map_err(|_| refused())?;
+    if ![1, 2, 3, 4, 5, 6, 7, 8, 9].contains(&journal.schema)
+        || (journal.schema == 1 && journal.mcp_plan.is_some())
+        || (journal.schema >= 2 && journal.mcp_plan.is_none())
+        || (journal.schema < 3 && (journal.mcp_grant.is_some() || journal.mcp_receipt.is_some()))
+        || (journal.schema >= 3 && (journal.mcp_grant.is_none() || journal.mcp_receipt.is_none()))
+        || (journal.schema < 4
+            && (journal.mcp_shutdown_id.is_some()
+                || journal.mcp_shutdown_status.is_some()
+                || journal.mcp_quiescence.is_some()))
+        || (journal.schema == 4
+            && (journal.mcp_shutdown_id.is_none()
+                || !journal
+                    .mcp_shutdown_status
+                    .as_ref()
+                    .is_some_and(|s| ["pending", "quiesced", "uncertain"].contains(&s.as_str()))))
+        || (journal.mcp_shutdown_id.is_some() != journal.mcp_shutdown_status.is_some())
+        || journal
+            .mcp_shutdown_status
+            .as_ref()
+            .is_some_and(|status| !["pending", "quiesced", "uncertain"].contains(&status.as_str()))
+        || (journal.mcp_shutdown_status.as_deref() == Some("quiesced"))
+            != journal.mcp_quiescence.is_some()
+        || journal.mcp_quiescence.as_ref().is_some_and(|receipt| {
+            Some(receipt.shutdown_id) != journal.mcp_shutdown_id
+                || journal.mcp_receipt.as_ref() != Some(&receipt.resource)
+                || receipt.status != "quiesced"
+        })
+        || (journal.schema < 5 && journal.step.is_some())
+        || (journal.schema >= 5 && journal.step.is_none())
+        || (journal.schema < 6 && journal.destination_cancellation.is_some())
+        || (journal.schema >= 6
+            && match (&journal.host_grant, &journal.destination_cancellation) {
+                (Some(grant), None) => !destination_grant_matches(&journal, grant),
+                (None, Some(cancellation)) => {
+                    !destination_grant_matches(&journal, &cancellation.grant)
+                }
+                _ => true,
+            })
+        || (journal.schema < 7 && journal.publication.is_some())
+        || (journal.schema >= 7 && journal.publication.is_none())
+        || (journal.schema < 8
+            && journal
+                .publication
+                .as_ref()
+                .is_some_and(|p| p.source_shutdown.is_some()))
+        || (journal.schema >= 8
+            && journal
+                .publication
+                .as_ref()
+                .is_none_or(|p| p.source_shutdown.is_none()))
+        || (journal.schema < 9
+            && journal
+                .publication
+                .as_ref()
+                .is_some_and(|p| p.source_model_shutdown.is_some()))
+        || (journal.schema == 9
+            && journal
+                .publication
+                .as_ref()
+                .is_none_or(|p| p.source_model_shutdown.is_none()))
+        || journal.publication.as_ref().is_some_and(|publication| {
+            journal.phase != "uncertain"
+                || !["pending", "installed", "uncertain"].contains(&publication.status.as_str())
+                || journal
+                    .host_grant
+                    .as_ref()
+                    .is_none_or(|grant| grant.id != publication.movement_id)
+                || journal
+                    .step
+                    .as_ref()
+                    .and_then(|step| step.receipt.as_ref())
+                    .is_none_or(|step| step.step_id != publication.step_id)
+                || publication
+                    .source_shutdown
+                    .as_ref()
+                    .is_some_and(|shutdown| {
+                        publication.status != "installed"
+                            || !["pending", "closed", "uncertain"]
+                                .contains(&shutdown.status.as_str())
+                    })
+                || publication
+                    .source_model_shutdown
+                    .as_ref()
+                    .is_some_and(|shutdown| {
+                        publication.status != "installed"
+                            || publication
+                                .source_shutdown
+                                .as_ref()
+                                .is_none_or(|mcp| mcp.status != "closed")
+                            || !["pending", "closed", "absent", "uncertain"]
+                                .contains(&shutdown.status.as_str())
+                    })
+        })
+        || journal.step.as_ref().is_some_and(|step| {
+            let disposed = step.disposal.as_ref().is_some_and(|disposal| {
+                disposal.status == "disposed" && disposal.receipt.is_some()
+            });
+            (!disposed
+                && (journal.mcp_shutdown_id.is_some()
+                    || journal.provider_cleanup_id.is_some()
+                    || journal.provider_cleanup_receipt.is_some()))
+                || !(if disposed {
+                    [
+                        "provider_constructed",
+                        "provider_cleanup_pending",
+                        "mcp_plan_held",
+                        "uncertain",
+                    ]
+                    .contains(&journal.phase.as_str())
+                } else {
+                    ["provider_constructed", "uncertain"].contains(&journal.phase.as_str())
+                })
+                || !journal
+                    .mcp_plan
+                    .as_ref()
+                    .is_some_and(|plan| plan.effects.step_preparation)
+                || !journal.mcp_receipt.as_ref().is_some_and(|receipt| {
+                    receipt.phase == "constructed" && receipt.resource_id == step.mcp_resource_id
+                })
+                || !journal.provider_receipt.as_ref().is_some_and(|receipt| {
+                    receipt.phase == "constructed"
+                        && receipt.resource_id == step.provider_resource_id
+                })
+                || !["pending", "retained", "uncertain"].contains(&step.status.as_str())
+                || (step.status == "retained") != step.receipt.is_some()
+                || step.receipt.as_ref().is_some_and(|receipt| {
+                    receipt.operation_id != step.operation_id
+                        || receipt.candidate_id != step.candidate_id
+                        || receipt.mcp_resource_id != step.mcp_resource_id
+                        || receipt.provider_resource_id != step.provider_resource_id
+                        || receipt.status != "retained"
+                })
+                || step.disposal.as_ref().is_some_and(|disposal| {
+                    step.status != "retained"
+                        || !["pending", "uncertain", "disposed"].contains(&disposal.status.as_str())
+                        || (disposal.status == "disposed") != disposal.receipt.is_some()
+                        || disposal.receipt.as_ref().is_some_and(|receipt| {
+                            let retained = step.receipt.as_ref();
+                            receipt.disposal_id != disposal.disposal_id
+                                || retained.is_none_or(|retained| {
+                                    receipt.operation_id != retained.operation_id
+                                        || receipt.candidate_id != retained.candidate_id
+                                        || receipt.step_id != retained.step_id
+                                        || receipt.mcp_resource_id != retained.mcp_resource_id
+                                        || receipt.provider_resource_id
+                                            != retained.provider_resource_id
+                                })
+                                || receipt.status != "disposed"
+                        })
+                })
+        })
+        || (journal.phase == "released" && journal.mcp_plan.is_some())
+        || journal.mcp_grant.as_ref().is_some_and(|grant| {
+            journal.mcp_plan.as_ref() != Some(&grant.mcp_plan)
+                || grant.purpose != "establish-mcp"
+                || grant.configuration_digest != grant.mcp_plan.digest
+                || grant.from != grant.mcp_plan.from
+                || grant.to != grant.mcp_plan.to
+                || grant.agent_id != grant.mcp_plan.agent_id
+        })
+        || journal.mcp_receipt.as_ref().is_some_and(|receipt| {
+            journal.mcp_grant.as_ref().is_none_or(|grant| {
+                receipt.transition_id != grant.id
+                    || receipt.plan_id != grant.mcp_plan.id
+                    || receipt.reservation != journal.reservation
+                    || receipt.process_generation != grant.mcp_plan.process_generation
+                    || receipt.kind != "mcp_runtime"
+                    || !["pending", "retained", "constructed"].contains(&receipt.phase.as_str())
+            })
+        })
+        || journal.mcp_plan.as_ref().is_some_and(|plan| {
+            plan.kind != "mcp_runtime"
+                || plan.harness != "codex"
+                || plan.agent_id != format!("codex:{thread_id}")
+                || plan.reservation != journal.reservation
+                || plan.from != journal.source_cwd
+                || plan.from == plan.to
+        })
+        || journal.thread_id != thread_id
+        || journal.history.len() > MAX_RECEIPTS
+        || ![
+            "acquired",
+            "grant_bound",
+            "provider_pending",
+            "provider_retained",
+            "provider_catalog_pending",
+            "provider_constructed",
+            "provider_cleanup_pending",
+            "mcp_plan_held",
+            "submitting",
+            "committed",
+            "released",
+            "uncertain",
+        ]
+        .contains(&journal.phase.as_str())
+    {
+        return Err(refused());
+    }
+    Ok(Some(journal))
+}
+
+fn write_journal(path: &Path, journal: &Journal) -> CodexResult<()> {
+    let parent = path.parent().ok_or_else(refused)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{DirBuilderExt, MetadataExt};
+        let mut builder = fs::DirBuilder::new();
+        builder.mode(0o700);
+        match builder.create(parent) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(_) => return Err(refused()),
+        }
+        let metadata = fs::symlink_metadata(parent).map_err(|_| refused())?;
+        if !metadata.is_dir()
+            || metadata.mode() & 0o077 != 0
+            || metadata.uid() != unsafe { libc::geteuid() }
+        {
+            return Err(refused());
+        }
+    }
+    // Native Windows ACL and durable-directory acceptance is a separate stage.
+    #[cfg(not(unix))]
+    {
+        return Err(refused());
+    }
+    let bytes = serde_json::to_vec(journal).map_err(|_| refused())?;
+    if bytes.len() as u64 > MAX_JOURNAL_BYTES || journal.history.len() > MAX_RECEIPTS {
+        return Err(refused());
+    }
+    let mut temporary = tempfile::Builder::new()
+        .prefix(".continuity-")
+        .tempfile_in(parent)
+        .map_err(|_| refused())?;
+    temporary.write_all(&bytes).map_err(|_| refused())?;
+    temporary.as_file().sync_all().map_err(|_| refused())?;
+    temporary.persist(path).map_err(|_| refused())?;
+    File::open(parent)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| refused())?;
+    Ok(())
+}
