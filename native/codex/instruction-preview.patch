+    fn begin_native_instruction_change(&self) -> NativeInstructionChange<'_> {
+        let mut state = self
+            .native_changes
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        state.pending = state.pending.and_then(|value| value.checked_add(1));
+        state.revision = Arc::new(());
+        NativeInstructionChange(self)
+    }
+    fn capture_native_instruction_source(&self) -> CodexResult<NativeInstructionPreparation> {
+        let state = self
+            .native_changes
+            .try_lock()
+            .map_err(|_| native_instruction_unavailable())?;
+        if state.pending != Some(0) {
+            return Err(native_instruction_unavailable());
+        }
+        Ok(NativeInstructionPreparation {
+            source: Arc::clone(&self.native_changes),
+            revision: Arc::clone(&state.revision),
+            loaded: None,
+        })
+    }
