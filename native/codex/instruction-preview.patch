+impl Held {
+    fn invalidate(&mut self) {
+        self.invalid = true;
+        #[cfg(all(debug_assertions, unix))]
+        { self.checkpoint_snapshot = None; }
+    }
+
+    // A disposed step no longer owns the provider or MCP binding. Pending,
+    // uncertain or restored owners remain quarantined.
+    fn step_allows_resource_cleanup(&self) -> bool {
+        self.journal.step.as_ref().is_none_or(|step| {
+            !self.invalid
+                && self.target_step.is_none()
+                && step.disposal.as_ref().is_some_and(|disposal| {
+                    disposal.status == "disposed" && disposal.receipt.is_some()
+                })
+        })
+    }
+
+    fn target_tool_view(&self) -> CodexResult<codex_model_provider::NativeToolProviderView> {
+        if !self.permits_candidate_revalidation() || self.journal.phase != "provider_constructed" {
+            return Err(refused());
+        }
+        let configuration = self.provider_configuration.as_ref().ok_or_else(refused)?;
+        let provider = self.provider_resource.as_ref().ok_or_else(refused)?;
+        let provider = provider
+            .try_lock()
+            .map_err(|_| provider_observation_busy())?;
+        provider
+            .validated_tool_view(
+                &configuration.runtime_configuration().provider,
+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )?
+            .ok_or_else(refused)
+    }
+
+    fn target_model_inputs(
+        &self,
+    ) -> CodexResult<(
+        codex_protocol::openai_models::ModelInfo,
+        codex_model_provider::ProviderCapabilities,
+    )> {
+        if !self.permits_candidate_revalidation() || self.journal.phase != "provider_constructed" {
+            return Err(refused());
+        }
+        let configuration = self.provider_configuration.as_ref().ok_or_else(refused)?;
+        let provider = self.provider_resource.as_ref().ok_or_else(refused)?;
+        let provider = provider
+            .try_lock()
+            .map_err(|_| provider_observation_busy())?;
+        provider
+            .validated_model_inputs(
+                &configuration.runtime_configuration().provider,
+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )?
+            .ok_or_else(refused)
+    }
+    // Validate the actual retained target factory/model context without
+    // waiting for a borrower or invoking a provider callback.
+    fn validate_retained_provider(&self) -> CodexResult<()> {
+        if self.journal.phase != "provider_constructed" {
+            return Ok(());
+        }
+        if !self.permits_candidate_revalidation() {
+            tracing::debug!(stage = "retained-provider-state", "native provider check refused");
+            return Err(refused());
+        }
+        let configuration = self.provider_configuration.as_ref().ok_or_else(|| {
+            tracing::debug!(stage = "retained-provider-configuration", "native provider check refused");
+            refused()
+        })?;
+        let resource = self.provider_resource.as_ref().ok_or_else(|| {
+            tracing::debug!(stage = "retained-provider-resource", "native provider check refused");
+            refused()
+        })?;
+        let resource = resource.try_lock().map_err(|_| {
+            tracing::debug!(stage = "retained-provider-busy", "native provider check refused");
+            provider_observation_busy()
+        })?;
+        let current = resource
+            .revalidate(
+                &configuration.runtime_configuration().provider,
+                &configuration.config().model_providers,
+                configuration
+                    .config()
+                    .config_layer_stack
+                    .required_model_provider(),
+            )
+            .map_err(|error| {
+                tracing::debug!(stage = "retained-provider-revalidate-error", "native provider check refused");
+                error
+            })?;
+        if !current {
+            tracing::debug!(stage = "retained-provider-revalidate-stale", "native provider check refused");
+            return Err(refused());
+        }
+        Ok(())
+    }
+
+    // Read-only candidate revalidation can continue after the exact approved
+    // provider has been constructed and retained. Pending, failed, cleaned-up
+    // and mismatched resource states never become candidate evidence.
+    fn permits_candidate_revalidation(&self) -> bool {
+        if self.journal.phase == "acquired" {
+            return true;
+        }
+        if self.journal.phase != "provider_constructed" || self.invalid {
+            return false;
+        }
+        let (Some(candidate), Some(grant), Some(receipt), Some(configuration), Some(_resource)) = (
+            self.destination_candidate.as_ref(),
+            self.journal.provider_grant.as_ref(),
+            self.journal.provider_receipt.as_ref(),
+            self.provider_configuration.as_ref(),
+            self.provider_resource.as_ref(),
+        ) else {
+            return false;
+        };
+        self.journal.provider_cleanup_id.is_none()
+            && self.journal.provider_cleanup_receipt.is_none()
+            && self.journal.transition_id == Some(grant.id)
+            && grant.status == "prepared"
+            && grant.purpose == "establish-provider"
+            && grant.provider_plan.reservation == self.reservation
+            && grant.from == self.journal.source_cwd
+            && &grant.to == &candidate.preparation.configured_config().cwd
+            && grant.configuration_digest == grant.provider_plan.digest
+            && candidate.preparation.configured_config() == configuration.config()
+            && receipt.phase == "constructed"
+            && receipt.transition_id == grant.id
+            && receipt.plan_id == grant.provider_plan.id
+            && receipt.reservation == self.reservation
+            && receipt.process_generation == grant.provider_plan.process_generation
+            && receipt.kind == grant.provider_plan.kind
+    }
+
+    // Provider disposal is independent of the retained MCP owner. Never let
+    // its journal transitions erase an existing or newly detected MCP quarantine.
+    fn mcp_custody_uncertain(&self) -> bool {
+        self.mcp_plan.is_some()
+            && (self.invalid
+                || self.journal.phase == "uncertain"
+                || !self
+                    ._mcp_requests
+                    .as_ref()
+                    .is_some_and(|guard| guard.is_current())
+                || !self
+                    .source_mcp_observation
+                    .as_ref()
+                    .is_some_and(|observation| {
+                        self.source_mcp_slot.native_is_current(observation)
+                            && self.mcp_startup.as_ref().is_none_or(|startup| {
+                                startup
+                                    .runtime()
+                                    .shares_native_event_owner(observation.runtime())
+                            })
+                    })
+                || !self
+                    .source_models_observation
+                    .as_ref()
+                    .is_some_and(|observation| {
+                        self.source_models_slot.native_is_current(observation)
+                    })
+                || self.journal.mcp_quiescence.is_some()
+                    && !self
+                        .mcp_quiescence_exclusion
+                        .as_ref()
+                        .is_some_and(|guard| guard.is_current()))
+    }
+}
+
