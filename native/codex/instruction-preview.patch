+struct NativeRefreshPermit<'a> {
+    state: &'a std::sync::Mutex<NativeRefreshState>,
+    revision: PreparationRevision,
+    completed: bool,
+}
+impl NativeRefreshPermit<'_> {
+    fn complete(mut self) {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        state.active -= 1;
+        self.completed = true;
+    }
+}
+impl Drop for NativeRefreshPermit<'_> {
+    fn drop(&mut self) {
+        if !self.completed {
+            let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+            state.active -= 1;
+            state.uncertain = true;
+        }
+    }
+}
