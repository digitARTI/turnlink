+/// Read-only observation of the exact native skill thread and its applied
+/// configuration. It does not capture catalogs or executor capabilities.
+pub struct NativeSkillToolPolicyObservation {
+    owner: std::sync::Weak<SkillsThreadState>,
+    generation: std::sync::Weak<()>,
+    cloud_enabled: bool,
+}
+
+impl NativeSkillToolPolicyObservation {
+    pub fn cloud_enabled(&self) -> bool {
+        self.cloud_enabled
+    }
+
+    pub fn is_current(&self, thread_store: &ExtensionData) -> bool {
+        let Some(current) = thread_store.native_try_get::<SkillsThreadState>() else {
+            return false;
+        };
+        let Some(owner) = self.owner.upgrade() else {
+            return false;
+        };
+        if !Arc::ptr_eq(&owner, &current) {
+            return false;
+        }
+        let Ok(config) = current.config.try_lock() else {
+            return false;
+        };
+        let matches = self
+            .generation
+            .upgrade()
+            .is_some_and(|generation| Arc::ptr_eq(&generation, &config.generation))
+            && self.cloud_enabled
+                == (current.cloud_skills_available && config.value.cloud_skill_enabled);
+        drop(config);
+        matches
+            && thread_store
+                .native_try_get::<SkillsThreadState>()
+                .is_some_and(|latest| Arc::ptr_eq(&latest, &current))
+    }
+}
