+/// Inspect the exact imported bytes against verifier-supplied digests. Digests
+/// do not authenticate a caller: the caller must establish verifier provenance
+/// and retain independent guest/owner authority before using this observation.
+#[cfg(all(debug_assertions, unix))]
+pub(crate) async fn inspect_checkpoint_history(
+    home: &Path,
+    thread_id: codex_protocol::ThreadId,
+    owner: &ContinuityOwner,
+    reservation: &ContinuityReservation,
+    grant: &codex_protocol::protocol::ContinuityHostGrant,
+    expected_digest: &str,
+    rollout_sha256: &str,
+    journal_sha256: &str,
+) -> CodexResult<codex_history::InitialHistory> {
+    use sha2::{Digest, Sha256};
+    let valid_digest = |value: &str| value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+    if !owner.is_open() || !valid_digest(expected_digest) || !valid_digest(rollout_sha256)
+        || !valid_digest(journal_sha256) || grant.agent_id != format!("codex:{thread_id}")
+        || grant.status != "prepared" || grant.checkpoint_config_sha256.is_none() {
+        return Err(refused());
+    }
+    let journal_path = home.join("native-continuity").join(format!("{thread_id}.json"));
+    let journal = read_journal(&journal_path, &thread_id.to_string())?.ok_or_else(refused)?;
+    if journal.phase != "grant_bound" || journal.reservation != *reservation
+        || journal.host_grant.as_ref() != Some(grant) { return Err(refused()); }
+    let journal_bytes = checkpoint_read_private_file(&journal_path, MAX_JOURNAL_BYTES)?;
+    let config_path = home.join("config.toml");
+    let config_bytes = checkpoint_read_private_file(&config_path, 256 * 1024)?;
+    if Some(format!("{:x}", Sha256::digest(&config_bytes)).as_str()) != grant.checkpoint_config_sha256.as_deref() {
+        return Err(refused());
+    }
+    let captured: Journal = serde_json::from_slice(&journal_bytes).map_err(|_| refused())?;
+    if serde_json::to_value(&captured).map_err(|_| refused())? != serde_json::to_value(&journal).map_err(|_| refused())?
+        || format!("{:x}", Sha256::digest(&journal_bytes)) != journal_sha256 { return Err(refused()); }
+    let rollout_path = checkpoint_single_rollout(home, thread_id)?;
+    let rollout = checkpoint_read_private_file(&rollout_path, 4 * 1024 * 1024)?;
+    if format!("{:x}", Sha256::digest(&rollout)) != rollout_sha256 { return Err(refused()); }
+    let composite = format!("{:x}", Sha256::digest(format!("{}:{}:{}:{}:{}:{}:{}",
+        thread_id, grant.id, reservation.generation, reservation.revision, rollout_sha256, journal_sha256, rollout.len()).as_bytes()));
+    if composite != expected_digest || !owner.is_open() { return Err(refused()); }
+    let history = checkpoint_decode_history(&rollout, thread_id, rollout_path.clone())?;
+    if checkpoint_single_rollout(home, thread_id)? != rollout_path
+        || checkpoint_read_private_file(&rollout_path, 4 * 1024 * 1024)? != rollout { return Err(refused()); }
+    // Repeat durable journal validation after parsing; any loss of ownership or
+    // changed journal invalidates this observation, never creates a lease.
+    let after = read_journal(&journal_path, &thread_id.to_string())?.ok_or_else(refused)?;
+    if !owner.is_open() || checkpoint_read_private_file(&config_path, 256 * 1024)? != config_bytes
+        || serde_json::to_value(after).map_err(|_| refused())? != serde_json::to_value(journal).map_err(|_| refused())? {
+        return Err(refused());
+    }
+    Ok(history)
+}
