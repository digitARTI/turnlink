+    /// Experimental bounded export from the live native reservation. This is
+    /// only checkpoint data: it does not authorize release, attest external
+    /// resources, or exclude a same-UID filesystem writer.
+    #[cfg(all(debug_assertions, unix))]
+    pub(crate) async fn continuity_watch_checkpoint_snapshot(
+        &self, owner: &ContinuityOwner, reservation: &ContinuityReservation,
+        grant: &codex_protocol::protocol::ContinuityHostGrant, digest: &str,
+    ) -> CodexResult<tokio::sync::watch::Receiver<bool>> {
+        let state = self.state.lock().await;
+        state.continuity.check(owner, reservation)?;
+        let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+        let snapshot = held.checkpoint_snapshot.as_ref().ok_or_else(refused)?;
+        if held.journal.host_grant.as_ref() != Some(grant) || snapshot.digest != digest || *snapshot.revoked.borrow() { return Err(refused()); }
+        Ok(snapshot.revoked.subscribe())
+    }
