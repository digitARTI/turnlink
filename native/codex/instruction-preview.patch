+/// Inputs already resolved by the owning native startup path. Assembling this
+/// value performs no model lookup, provider construction, hooks or session start.
+/// An inspection caller must independently establish every input's provenance.
+struct ResolvedSessionConfiguration {
+    config: Arc<Config>,
+    turn_extension_init: ExtensionDataInit,
+    provider: codex_model_provider::SharedModelProvider,
+    collaboration_mode: CollaborationMode,
+    environments: Vec<TurnEnvironmentSelection>,
+    base_instructions: String,
+    disabled_plugin_ids: Vec<String>,
+    metrics_service_name: Option<String>,
+    trusted_guardian_reviewer: bool,
+    session_source: SessionSource,
+    history_mode: ThreadHistoryMode,
+    forked_from_thread_id: Option<ThreadId>,
+    parent_thread_id: Option<ThreadId>,
+    thread_source: Option<ThreadSource>,
+    originator: String,
+    dynamic_tools: Vec<DynamicToolSpec>,
+    user_shell_override: Option<shell::Shell>,
+}
+
+fn assemble_session_configuration(input: ResolvedSessionConfiguration) -> CodexResult<SessionConfiguration> {
+    let ResolvedSessionConfiguration { config, turn_extension_init, provider, collaboration_mode, environments,
+        base_instructions, disabled_plugin_ids, metrics_service_name, trusted_guardian_reviewer, session_source,
+        history_mode, forked_from_thread_id, parent_thread_id, thread_source, originator, dynamic_tools,
+        user_shell_override } = input;
+    let session_configuration = SessionConfiguration {
+        turn_extension_init, provider,
+        step_settings: Arc::new(StepSettings {
+            collaboration_mode,
+            reasoning_summary: config.model_reasoning_summary,
+            service_tier: config.service_tier.clone(),
+            personality: config.personality,
+            approval_policy: config.permissions.approval_policy.clone(),
+            approvals_reviewer: config.approvals_reviewer,
+        }),
+        environments,
+        model_info_overrides: config.to_models_manager_config().into(),
+        developer_instructions: config.developer_instructions.clone(),
+        base_instructions,
+        permission_profile_state: session_permission_profile_state_from_config(&config)?,
+        allow_login_shell: config.permissions.allow_login_shell,
+        shell_environment_policy: config.permissions.shell_environment_policy.clone(),
+        windows_sandbox_level: WindowsSandboxLevel::from_config(&config),
+        windows_sandbox_type: config.effective_local_windows_sandbox_type(),
+        use_legacy_landlock: config.features.use_legacy_landlock(),
+        legacy_fallback_cwd: config.cwd.clone(),
+        runtime_workspace_roots: config.workspace_roots.clone(),
+        codex_home: config.codex_home.clone(),
+        thread_name: None,
+        disabled_plugin_ids,
+        original_config_do_not_use: Arc::clone(&config),
+        metrics_service_name,
+        app_server_client_name: None,
+        app_server_client_version: None,
+        trusted_guardian_reviewer,
+        session_source,
+        history_mode,
+        forked_from_thread_id,
+        parent_thread_id,
+        thread_source,
+        originator,
+        dynamic_tools: Arc::from(dynamic_tools),
+        user_shell_override,
+    };
+    session_configuration.validate(&session_configuration.environments)
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    Ok(session_configuration)
+}
