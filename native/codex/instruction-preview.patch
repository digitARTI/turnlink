+    fn continuity_target_turn_volatile_inputs_current(
+        &self,
+        target: &ContinuityTargetTurnPreparation,
+    ) -> CodexResult<bool> {
+        Ok(self.services.model_client.native_is_current(&target.source_model_client)
+            && self.continuity_target_non_model_volatile_inputs_current(target)?
+            && self.services.model_client.native_is_current(&target.source_model_client))
+    }
+
+    // The target's source model owner is intentionally replaced at staged
+    // publication; its new exact pair is checked separately. These other
+    // volatile witnesses must remain current on both sides of publication.
+    fn continuity_target_non_model_volatile_inputs_current(
+        &self,
+        target: &ContinuityTargetTurnPreparation,
+    ) -> CodexResult<bool> {
+        let current_grants = self
+            .services
+            .granted_permissions_by_environment_id
+            .try_lock()
+            .map_err(|_| refused())?;
+        let current_network = self.services.network_proxy.load_full();
+        let same_network = match (&target.network_owner, &current_network) {
+            (None, None) => true,
+            (Some(expected), Some(actual)) => expected
+                .upgrade()
+                .is_some_and(|owner| Arc::ptr_eq(&owner, actual)),
+            _ => false,
+        };
+        let Some((revision, values)) = current_grants.observation() else {
+            return Ok(false);
+        };
+        let needs_skill_policy = self.services.extensions.tool_contributors().iter().any(
+            |contributor| {
+                codex_skills_extension::native_is_skill_tool_contributor::<crate::config::Config>(
+                    contributor.as_ref(),
+                )
+            },
+        );
+        let skill_policy_current = match (&target.skill_policy, needs_skill_policy) {
+            (Some(policy), true) => policy.is_current(&self.services.thread_extension_data),
+            (None, false) => true,
+            _ => false,
+        };
+        let roots_current = target
+            .capability_roots
+            .is_current(&target.turn.initial_environments);
+        let discovery_current = target.discovery.is_current(
+            self,
+            &target.turn.config,
+            &target.turn.initial_environments,
+        );
+        let discovery_v2 = target
+            .turn
+            .config
+            .features
+            .enabled(codex_features::Feature::ExecutorCapabilityDiscoveryV2);
+        let shapes_current = match (&target.skill_policy, &target.skill_tool_shapes) {
+            (Some(policy), Some(shapes)) => {
+                *shapes
+                    == codex_skills_extension::native_skill_tool_shapes(
+                        policy.cloud_enabled()
+                            || !target.capability_roots.roots.is_empty()
+                            || discovery_v2,
+                        discovery_v2,
+                    )
+            }
+            (None, None) => true,
+            _ => false,
+        };
+        Ok(revision == target.session_grants_revision
+            && values == target.session_grants
+            && same_network
+            && skill_policy_current
+            && roots_current
+            && discovery_current
+            && shapes_current)
+    }
+}
