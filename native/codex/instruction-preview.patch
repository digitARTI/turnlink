+    let journal_path = root.path().join("native-continuity").join(format!("{id}.json"));
+    write_journal(&journal_path, &journal).unwrap();
+    let day = root.path().join("sessions/2026/01/02"); fs::create_dir_all(&day).unwrap();
+    for dir in [root.path().join("sessions"), root.path().join("sessions/2026"), root.path().join("sessions/2026/01"), day.clone()] {
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o700)).unwrap();
+    }
+    let path = day.join(format!("rollout-2026-01-02T00-00-00-{id}.jsonl"));
+    let line = codex_history::RolloutLine { timestamp: "2026-01-01T00:00:00Z".into(), ordinal: None,
+        item: codex_history::RolloutItem::SessionMeta(Box::new(SessionMetaLine { meta: SessionMeta { id, session_id: id.into(), ..Default::default() }, git: None })) };
+    let mut bytes = serde_json::to_vec(&line).unwrap(); bytes.push(b'\n'); fs::write(&path, &bytes).unwrap();
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+    let rollout_hash = format!("{:x}", Sha256::digest(&bytes));
+    let journal_hash = format!("{:x}", Sha256::digest(fs::read(&journal_path).unwrap()));
+    let composite = format!("{:x}", Sha256::digest(format!("{}:{}:{}:{}:{}:{}:{}", id, grant.id,
+        reservation.generation, reservation.revision, rollout_hash, journal_hash, bytes.len()).as_bytes()));
+    let owner = ContinuityOwner::new();
