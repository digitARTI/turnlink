+struct UnverifiedPreparationProvider(Arc<std::sync::atomic::AtomicUsize>);
+
+impl codex_extension_api::UserInstructionsProvider for UnverifiedPreparationProvider {
+    fn load_user_instructions(&self) -> codex_extension_api::LoadInstructionsFuture<'_> {
+        self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        Box::pin(async { codex_extension_api::LoadedUserInstructions::default() })
+    }
+}
+
+impl codex_extension_api::ThreadInstructionsProvider for UnverifiedPreparationProvider {
+    fn load_thread_instructions(&self) -> codex_extension_api::LoadInstructionsFuture<'_> {
+        codex_extension_api::UserInstructionsProvider::load_user_instructions(self)
+    }
+}
