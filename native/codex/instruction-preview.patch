diff --git a/codex-rs/ext/goal/src/native_visibility.rs b/codex-rs/ext/goal/src/native_visibility.rs
new file mode 100644
index 0000000..4586f73
--- /dev/null
+++ b/codex-rs/ext/goal/src/native_visibility.rs
@@ -0,0 +1,88 @@
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+// The low bit preserves ordinary visibility; the remaining bits never wrap.
+// Saturation keeps visibility functional while refusing freshness witnesses.
+pub(crate) struct NativeVisibility(AtomicU64);
+
+impl NativeVisibility {
+    pub(crate) fn new(enabled: bool) -> Self {
+        Self(AtomicU64::new(u64::from(enabled)))
+    }
+
+    pub(crate) fn set(&self, enabled: bool) {
+        let _ = self
+            .0
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                let generation = (value >> 1).saturating_add(1).min(u64::MAX >> 1);
+                Some((generation << 1) | u64::from(enabled))
+            });
+    }
+
+    pub(crate) fn enabled(&self) -> bool {
+        self.0.load(Ordering::Relaxed) & 1 != 0
+    }
+
+    pub(crate) fn token(&self) -> Option<u64> {
+        let value = self.0.load(Ordering::Relaxed);
+        (value >> 1 != u64::MAX >> 1).then_some(value)
+    }
+
+    pub(crate) fn current(&self, token: u64) -> bool {
+        self.token() == Some(token)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::NativeVisibility;
+    use std::sync::Arc;
+    use std::sync::atomic::Ordering;
+
+    #[test]
+    fn changes_and_restoration_invalidate_visibility_token() {
+        let state = NativeVisibility::new(true);
+        let original = state.token().unwrap();
+        assert!(state.enabled());
+        state.set(false);
+        assert!(!state.enabled());
+        state.set(true);
+        assert!(state.enabled());
+        assert!(!state.current(original));
+        let next = state.token().unwrap();
+        state.set(true);
+        assert!(!state.current(next));
+    }
+
+    #[test]
+    fn saturation_refuses_witness_but_preserves_visibility() {
+        let state = NativeVisibility::new(false);
+        state.0.store((u64::MAX >> 1) - 1 << 1, Ordering::Relaxed);
+        let token = state.token().unwrap();
+        state.set(true);
+        assert!(state.enabled());
+        assert_eq!(state.token(), None);
+        assert!(!state.current(token));
+        state.set(false);
+        assert!(!state.enabled());
+        assert_eq!(state.token(), None);
+    }
+
+    #[test]
+    fn concurrent_visibility_updates_do_not_lose_revisions() {
+        let state = Arc::new(NativeVisibility::new(false));
+        let before = state.token().unwrap();
+        std::thread::scope(|scope| {
+            for index in 0..8 {
+                let state = Arc::clone(&state);
+                scope.spawn(move || {
+                    for _ in 0..1000 {
+                        state.set(index % 2 == 0);
+                    }
+                });
+            }
+        });
+        assert!(!state.current(before));
+        assert_eq!(state.token().unwrap() >> 1, 8000);
+    }
+}
