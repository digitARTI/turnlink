+    struct SessionPublished;
+    struct ThreadPublished;
+    fn collect(
+        registry: &ExtensionRegistry<crate::config::Config>,
+        session: &ExtensionData,
+        thread: &ExtensionData,
+        step: &ExtensionData,
+    ) -> NativeToolCollectionResult {
+        if session.get::<SessionPublished>().is_none()
+            || thread.get::<ThreadPublished>().is_none()
+            || step.get::<Published>().is_none()
+        {
+            return Err(NativeToolCollectionError::IncompleteContributor {
