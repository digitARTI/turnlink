+
+// Retry only a specifically reported, read-only lock contention. Each call
+// repeats the complete supplied observation; enclosing owner and input fences
+// still apply. Changed state, other errors and effect dispatches fail normally.
+pub(super) async fn retry_busy_observation<T, F, Fut>(mut observe: F) -> CodexResult<T>
+where
+    F: FnMut() -> Fut,
+    Fut: std::future::Future<Output = CodexResult<T>>,
+{
+    for attempt in 0..3 {
+        match observe().await {
+            Err(error)
+                if attempt < 2
+                    && matches!(error.details(), codex_protocol::error::CodexErrorDetails::Io(value)
+                        if value.kind() == std::io::ErrorKind::WouldBlock) =>
+            {
+                tokio::time::sleep(std::time::Duration::from_millis(10 * (attempt + 1))).await;
+            }
+            result => return result,
+        }
+    }
+    unreachable!("the final observation always returns")
+}
