+++ b/codex-rs/ext/extension-api/src/tool_preparation.rs
@@ -0,0 +1,100 @@
+//! Native host observations of known tool implementations. These values are
+//! neither execution capabilities nor proof of destination state freshness.
+
+use crate::ToolCall;
+use crate::ToolContributor;
+use crate::ToolExecutor;
+use codex_tools::ToolExposure;
+use codex_tools::ToolName;
+use codex_tools::ToolSearchInfo;
+use codex_tools::ToolSpec;
+use std::sync::Arc;
+
+/// Effective metadata only; no executor, backend or transport is retained.
+#[derive(Clone, PartialEq)]
+pub struct PreparedExtensionTool {
+    pub name: ToolName,
+    pub spec: ToolSpec,
+    pub exposure: ToolExposure,
+    pub search_info: Option<ToolSearchInfo>,
+    pub supports_parallel: bool,
+}
+
+impl PreparedExtensionTool {
+    /// Call only after the native owning crate has identified a concrete tool
+    /// whose metadata methods are known to be read-only. This invokes metadata
+    /// methods, so it is deliberately not a generic contributor preview API.
+    pub fn capture(tool: &dyn for<'call> ToolExecutor<ToolCall<'call>>) -> Self {
+        Self {
+            name: tool.tool_name(),
+            spec: tool.spec(),
+            exposure: tool.exposure(),
+            search_info: tool.search_info(),
+            supports_parallel: tool.supports_parallel_tool_calls(),
+        }
+    }
+}
+
+/// A trusted native host's observation bound to its actual contributor instance.
+/// No serialization or external request conversion is provided. Registry binding
+/// prevents reuse for another contributor; freshness of the captured extension
+/// scopes remains a separate obligation of the native preparation owner.
+pub struct PreparedToolContributor {
+    contributor: Arc<dyn ToolContributor>,
+    tools: Vec<PreparedExtensionTool>,
+}
+
+impl PreparedToolContributor {
+    pub fn new(contributor: Arc<dyn ToolContributor>, tools: Vec<PreparedExtensionTool>) -> Self {
+        Self { contributor, tools }
+    }
+
+    pub fn matches(&self, contributor: &Arc<dyn ToolContributor>) -> bool {
+        Arc::ptr_eq(&self.contributor, contributor)
+    }
+
+    pub fn tools(&self) -> &[PreparedExtensionTool] {
+        &self.tools
+    }
+}
+
+/// None denotes an unknown concrete contributor; Err denotes unavailable native
+/// state. Only known, completed native state may produce an empty observation.
+pub type NativeToolPreparation = Option<Result<Vec<PreparedExtensionTool>, &'static str>>;
+
+/// Native registration is host configuration, never model or plugin JSON. A
+/// registered function must collect only known native metadata, without running
+/// contributor callbacks. It receives the actual immutable registry, including
+/// any later builder additions. Registration does not prove destination freshness.
+pub type NativeToolPreparationCollector<C> = fn(
+    &crate::ExtensionRegistry<C>,
+    &crate::ExtensionData,
+    &crate::ExtensionData,
+    &crate::ExtensionData,
+) -> NativeToolCollectionResult;
+
+pub type NativeToolCollectionResult =
+    Result<Vec<PreparedToolContributor>, NativeToolCollectionError>;
+
+#[derive(Debug, Eq, PartialEq)]
+pub enum NativeToolCollectionError {
+    UnsupportedHost,
+    UnknownContributor { index: usize },
+    IncompleteContributor { index: usize, reason: &'static str },
+}
+
+impl std::fmt::Display for NativeToolCollectionError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::UnsupportedHost => f.write_str("native host tool collection is not registered"),
+            Self::UnknownContributor { index } => {
+                write!(f, "unknown native tool contributor at index {index}")
+            }
+            Self::IncompleteContributor { index, reason } => write!(
+                f,
+                "native tool contributor at index {index} is not ready: {reason}"
+            ),
+        }
+    }
+}
+impl std::error::Error for NativeToolCollectionError {}
