 #[derive(Clone)]
 pub struct Constrained<T> {
     value: T,
     validator: Arc<ConstraintValidator<T>>,
     normalizer: Option<Arc<ConstraintNormalizer<T>>>,
+    validator_closed: bool,
+    normalizer_closed: bool,
+    native_recipe: NativeConstraintRecipeState<T>,
+}
+
+// This is independent of `PartialEq`, which intentionally compares only the
+// selected value. Unknown or composed callbacks have no portable recipe.
+#[derive(Clone)]
+enum NativeConstraintRecipeState<T> {
+    Any,
+    Only(Arc<T>),
+    PermissionProfile(Arc<serde_json::Value>),
+    Intersection(Arc<NativeConstraintRecipeState<T>>, Arc<NativeConstraintRecipeState<T>>),
+    Unsupported,
+}
+
+#[doc(hidden)]
+#[derive(Debug, PartialEq, serde::Serialize)]
+pub struct NativeConstraintRecipe<'a, T> {
+    pub version: u8,
+    pub rule: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub only: Option<&'a T>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub base: Option<&'a serde_json::Value>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub parts: Option<Vec<NativeConstraintRecipe<'a, T>>>,
+}
+
+fn project_native_recipe<T>(state: &NativeConstraintRecipeState<T>, depth: usize) -> Option<NativeConstraintRecipe<'_, T>> {
+    if depth > 16 { return None; }
+    let (rule, only, base, parts) = match state {
+        NativeConstraintRecipeState::Any => ("allow_any", None, None, None),
+        NativeConstraintRecipeState::Only(value) => ("allow_only", Some(value.as_ref()), None, None),
+        NativeConstraintRecipeState::PermissionProfile(base) => ("permission_profile", None, Some(base.as_ref()), None),
+        NativeConstraintRecipeState::Intersection(left, right) => ("intersection", None, None,
+            Some(vec![project_native_recipe(left, depth + 1)?, project_native_recipe(right, depth + 1)?])),
+        NativeConstraintRecipeState::Unsupported => return None,
+    };
+    Some(NativeConstraintRecipe { version: 1, rule, only, base, parts })
+}
+
+// Exact native data types with immutable, native equality implementations.
+// Unknown T is deliberately opaque, even when its current value compares equal.
+fn native_immutable_value<T: 'static>() -> bool {
+    use std::any::TypeId;
+    let value = TypeId::of::<T>();
+    value == TypeId::of::<bool>()
+        || value == TypeId::of::<String>()
+        || value == TypeId::of::<i32>()
+        || value == TypeId::of::<u64>()
+        || value == TypeId::of::<codex_protocol::protocol::AskForApproval>()
+        || value == TypeId::of::<codex_protocol::models::PermissionProfile>()
+        || value == TypeId::of::<codex_protocol::models::PermissionProfileSnapshot>()
+}
