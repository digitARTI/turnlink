+// The fixture importer publishes exactly one year/month/day and rollout file.
+// Reject any unexpected sibling, symbolic link, or alternate layout.
+#[cfg(all(debug_assertions, unix))]
+fn checkpoint_single_rollout(home: &Path, thread_id: codex_protocol::ThreadId) -> CodexResult<PathBuf> {
+    let home_meta = fs::symlink_metadata(home).map_err(|_| refused())?;
+    if !journal_directory_matches(&home_meta, &home_meta) { return Err(refused()); }
+    let mut dir = home.join("sessions");
+    for depth in 0..4 {
+        let meta = fs::symlink_metadata(&dir).map_err(|_| refused())?;
+        if !journal_directory_matches(&meta, &meta) { return Err(refused()); }
+        let mut entries = fs::read_dir(&dir).map_err(|_| refused())?;
+        let entry = entries.next().ok_or_else(refused)?.map_err(|_| refused())?;
+        if entries.next().is_some() { return Err(refused()); }
+        let entry_name = entry.file_name();
+        let entry_name = entry_name.to_str().ok_or_else(refused)?;
+        if !journal_directory_matches(&meta, &fs::symlink_metadata(&dir).map_err(|_| refused())?) { return Err(refused()); }
+        if depth == 3 {
+            if !entry_name.starts_with("rollout-") || !entry_name.ends_with(&format!("-{thread_id}.jsonl")) { return Err(refused()); }
+            if !journal_directory_matches(&home_meta, &fs::symlink_metadata(home).map_err(|_| refused())?) { return Err(refused()); }
+            return Ok(entry.path());
+        }
+        let expected_len = if depth == 0 { 4 } else { 2 };
+        if entry_name.len() != expected_len || !entry_name.bytes().all(|b| b.is_ascii_digit()) { return Err(refused()); }
+        dir = entry.path();
+    }
+    Err(refused())
+}
