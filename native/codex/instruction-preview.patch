+use super::*;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+
+struct ConfigurationFilesFixture {
+    _root: tempfile::TempDir,
+    home: AbsolutePathBuf,
+    options: LoaderOverrides,
+    files: Vec<AbsolutePathBuf>,
+}
+
+impl ConfigurationFilesFixture {
+    fn new() -> Self {
+        let root = tempdir().unwrap();
+        let base = AbsolutePathBuf::from_absolute_path(root.path()).unwrap();
+        let home = base.join("home");
+        std::fs::create_dir(home.as_path()).unwrap();
+        let files = vec![
+            base.join("defaults.toml"),
+            base.join("system.toml"),
+            base.join("requirements.toml"),
+            base.join("managed.toml"),
+            home.join("config.toml"),
+            home.join("work.config.toml"),
+        ];
+        for (file, text) in files.iter().zip([
+            "project_doc_max_bytes=10",
+            "project_doc_max_bytes=20",
+            "allowed_approval_policies=['on-request']",
+            "approval_policy='on-request'",
+            "project_doc_max_bytes=30",
+            "project_doc_max_bytes=40",
+        ]) {
+            std::fs::write(file.as_path(), text).unwrap();
+        }
+        let mut options = LoaderOverrides::without_managed_config_for_tests();
+        options.packaged_defaults_path = Some(files[0].clone());
+        options.system_config_path = Some(files[1].to_path_buf());
+        options.system_requirements_path = Some(files[2].to_path_buf());
+        options.managed_config_path = Some(files[3].to_path_buf());
+        options.user_config_path = Some(files[5].clone());
+        options.user_config_profile = Some("work".parse().unwrap());
+        Self {
+            _root: root,
+            home,
+            options,
+            files,
+        }
+    }
+    async fn source(&self, fs: &dyn ExecutorFileSystem) -> ConfigLayerStack {
+        load_config_layers_state(
+            fs,
+            self.home.as_path(),
+            None,
+            &[],
+            self.options.clone(),
+            &crate::NoopThreadConfigLoader,
+        )
+        .await
+        .unwrap()
+    }
+}
+
+#[tokio::test]
+async fn configuration_file_preparation_binds_every_loaded_global_file_without_publication() {
+    let fixture = ConfigurationFilesFixture::new();
+    let source = fixture.source(&TestFileSystem).await;
+    let original = source.clone();
+    let prepared = preview_configuration_files(&TestFileSystem, &source)
+        .await
+        .unwrap();
+    assert!(prepared.revalidate(&TestFileSystem, &source).await.unwrap());
+    for file in &fixture.files {
+        let text = std::fs::read_to_string(file.as_path()).unwrap();
+        std::fs::write(file.as_path(), format!("{text}\n# changed raw input\n")).unwrap();
+        assert!(
+            !prepared.revalidate(&TestFileSystem, &source).await.unwrap(),
+            "{}",
+            file.display()
+        );
+        assert!(
+            preview_configuration_files(&TestFileSystem, &source)
+                .await
+                .is_err()
+        );
+        std::fs::write(file.as_path(), text).unwrap();
+        assert!(prepared.revalidate(&TestFileSystem, &source).await.unwrap());
+    }
+    assert_eq!(source, original);
+}
+
+#[tokio::test]
+async fn configuration_file_preparation_distinguishes_absence_from_ignored_user_inputs() {
+    let mut fixture = ConfigurationFilesFixture::new();
+    std::fs::remove_file(fixture.files[1].as_path()).unwrap();
+    let source = fixture.source(&TestFileSystem).await;
+    let prepared = preview_configuration_files(&TestFileSystem, &source)
+        .await
+        .unwrap();
+    std::fs::write(
+        fixture.files[1].as_path(),
+        "# newly present, same empty table",
+    )
+    .unwrap();
+    assert!(!prepared.revalidate(&TestFileSystem, &source).await.unwrap());
+    std::fs::remove_file(fixture.files[1].as_path()).unwrap();
+    assert!(prepared.revalidate(&TestFileSystem, &source).await.unwrap());
+    fixture.options.ignore_user_config = true;
+    let ignored = fixture.source(&TestFileSystem).await;
+    let prepared = preview_configuration_files(&TestFileSystem, &ignored)
+        .await
+        .unwrap();
+    for file in &fixture.files[4..] {
+        std::fs::write(file.as_path(), "invalid = [").unwrap();
+    }
+    assert!(
+        prepared
+            .revalidate(&TestFileSystem, &ignored)
+            .await
+            .unwrap()
+    );
+}
+
+#[tokio::test]
+async fn configuration_file_preparation_refuses_unowned_or_retagged_stacks_and_raw_aggregate_overflow()
+ {
+    let fixture = ConfigurationFilesFixture::new();
+    let source = fixture.source(&TestFileSystem).await;
+    let prepared = preview_configuration_files(&TestFileSystem, &source)
+        .await
+        .unwrap();
+    let reloaded = fixture.source(&TestFileSystem).await;
+    assert!(
+        !prepared
+            .revalidate(&TestFileSystem, &reloaded)
+            .await
+            .unwrap()
+    );
+    let unowned = ConfigLayerStack::new(
+        source.all_layers_low_to_high().cloned().collect(),
+        source.requirements().clone(),
+        source.requirements_toml().clone(),
+    )
+    .unwrap();
+    assert!(
+        preview_configuration_files(&TestFileSystem, &unowned)
+            .await
+            .is_err()
+    );
+    let changed = source
+        .with_user_config(
+            &fixture.files[4],
+            toml::from_str("project_doc_max_bytes=999").unwrap(),
+        )
+        .unwrap();
+    assert!(
+        preview_configuration_files(&TestFileSystem, &changed)
+            .await
+            .is_err()
+    );
+    for file in &fixture.files[4..] {
+        let mut bytes = b"project_doc_max_bytes=40\n#".to_vec();
+        bytes.resize(600_000, b'x');
+        std::fs::write(file.as_path(), bytes).unwrap();
+    }
+    let oversized = fixture.source(&TestFileSystem).await;
+    assert!(
+        preview_configuration_files(&TestFileSystem, &oversized)
+            .await
+            .is_err()
+    );
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum ConfigurationReadFault {
+    LateStream,
+    GrowingStream,
+    Disappear,
+    Denied,
+    ChangeDuringLoad,
+}
+struct ConfigurationFaultFileSystem {
+    target: PathUri,
+    fault: ConfigurationReadFault,
+}
+impl ExecutorFileSystem for ConfigurationFaultFileSystem {
+    fn canonicalize<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, PathUri> {
+        TestFileSystem.canonicalize(path, sandbox)
+    }
+    fn read_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<u8>> {
+        TestFileSystem.read_file(path, options, sandbox)
+    }
+    fn read_file_text<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: ReadFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, String> {
+        Box::pin(async move {
+            let text = TestFileSystem
+                .read_file_text(path, options, sandbox)
+                .await?;
+            if path == &self.target && self.fault == ConfigurationReadFault::ChangeDuringLoad {
+                std::fs::write(path.to_path_buf(), "project_doc_max_bytes=777")?;
+            }
+            Ok(text)
+        })
+    }
+    fn read_file_stream<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileSystemReadStream> {
+        Box::pin(async move {
+            if path != &self.target {
+                return TestFileSystem.read_file_stream(path, sandbox).await;
+            }
+            match self.fault {
+                ConfigurationReadFault::Disappear => Err(io::Error::new(
+                    io::ErrorKind::NotFound,
+                    "disappeared after metadata",
+                )),
+                ConfigurationReadFault::LateStream => {
+                    let contents = std::fs::read(path.to_path_buf())?;
+                    Ok(FileSystemReadStream::new(futures::stream::iter(vec![
+                        Ok(contents.into()),
+                        Err(io::Error::new(
+                            io::ErrorKind::PermissionDenied,
+                            "late failure",
+                        )),
+                    ])))
+                }
+                ConfigurationReadFault::GrowingStream => {
+                    let contents = std::fs::read(path.to_path_buf())?;
+                    let tail = futures::stream::iter((0..257).map(|_| Ok(vec![b'x'; 4096].into())));
+                    Ok(FileSystemReadStream::new(
+                        futures::stream::iter(vec![Ok(contents.into())]).chain(tail),
+                    ))
+                }
+                _ => TestFileSystem.read_file_stream(path, sandbox).await,
+            }
+        })
+    }
+    fn get_metadata<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: GetMetadataOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, FileMetadata> {
+        if path == &self.target && self.fault == ConfigurationReadFault::Denied {
+            return Box::pin(async {
+                Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "unreadable",
+                ))
+            });
+        }
+        TestFileSystem.get_metadata(path, options, sandbox)
+    }
+    fn write_file<'a>(
+        &'a self,
+        path: &'a PathUri,
+        contents: Vec<u8>,
+        options: WriteFileOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        TestFileSystem.write_file(path, contents, options, sandbox)
+    }
+    fn create_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: CreateDirectoryOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        TestFileSystem.create_directory(path, options, sandbox)
+    }
+    fn read_directory<'a>(
+        &'a self,
+        path: &'a PathUri,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, Vec<ReadDirectoryEntry>> {
+        TestFileSystem.read_directory(path, sandbox)
+    }
+    fn walk<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: WalkOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, WalkOutcome> {
+        TestFileSystem.walk(path, options, sandbox)
+    }
+    fn remove<'a>(
+        &'a self,
+        path: &'a PathUri,
+        options: RemoveOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        TestFileSystem.remove(path, options, sandbox)
+    }
+    fn copy<'a>(
+        &'a self,
+        source: &'a PathUri,
+        dest: &'a PathUri,
+        options: CopyOptions,
+        sandbox: Option<&'a FileSystemSandboxContext>,
+    ) -> ExecutorFileSystemFuture<'a, ()> {
+        TestFileSystem.copy(source, dest, options, sandbox)
+    }
+}
+
+#[tokio::test]
+async fn configuration_file_preparation_requires_complete_streams_and_refuses_uncertain_reads() {
+    let fixture = ConfigurationFilesFixture::new();
+    let source = fixture.source(&TestFileSystem).await;
+    for (fault, expected) in [
+        (
+            ConfigurationReadFault::LateStream,
+            io::ErrorKind::PermissionDenied,
+        ),
+        (
+            ConfigurationReadFault::GrowingStream,
+            io::ErrorKind::InvalidData,
+        ),
+        (ConfigurationReadFault::Disappear, io::ErrorKind::NotFound),
+        (
+            ConfigurationReadFault::Denied,
+            io::ErrorKind::PermissionDenied,
+        ),
+    ] {
+        let fs = ConfigurationFaultFileSystem {
+            target: PathUri::from_abs_path(&fixture.files[4]),
+            fault,
+        };
+        let error = preview_configuration_files(&fs, &source)
+            .await
+            .err()
+            .expect("read refusal");
+        assert_eq!(error.kind(), expected);
+    }
+}
+
+#[tokio::test]
+async fn configuration_file_preparation_binds_actual_read_bytes_and_refuses_mixed_loads() {
+    for duplicate in [false, true] {
+        let mut fixture = ConfigurationFilesFixture::new();
+        if duplicate {
+            fixture.options.packaged_defaults_path = Some(fixture.files[4].clone());
+        }
+        let fs = ConfigurationFaultFileSystem {
+            target: PathUri::from_abs_path(&fixture.files[4]),
+            fault: ConfigurationReadFault::ChangeDuringLoad,
+        };
+        let source = fixture.source(&fs).await;
+        assert!(
+            preview_configuration_files(&TestFileSystem, &source)
+                .await
+                .is_err()
+        );
+    }
+}
