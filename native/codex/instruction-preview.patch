+    }
+
+    /// Prepare a target MCP effect ceiling without invoking contributors,
+    /// starting servers, accessing credentials, or publishing a runtime.
+    pub(crate) fn continuity_plan_mcp<'a>(
+        &'a self,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        cwd: AbsolutePathBuf,
+        binding_capture: bool,
+        plugin_capture: bool,
+        skill_capture: bool,
+        step_preparation: bool,
+    ) -> futures::future::BoxFuture<'a, CodexResult<codex_protocol::protocol::ContinuityMcpPlan>>
+    {
+        async move {
+            use sha2::{Digest, Sha256};
+            let candidate = {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                state
+                    .continuity
+                    .held
+                    .as_ref()
+                    .ok_or_else(refused)?
+                    .destination_candidate
+                    .clone()
+            };
+            if (binding_capture || plugin_capture || skill_capture || step_preparation)
+                && candidate.is_none()
+                || skill_capture && (!binding_capture || !plugin_capture)
+                || step_preparation && !skill_capture
+            {
+                return Err(refused());
+            }
+            if let Some(candidate) = &candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let preparation = Box::new(
+                self.continuity_prepare_configuration(owner, reservation, cwd.clone())
+                    .boxed()
+                    .await?,
+            );
+            let from = preparation
+                .inputs
+                .source_configuration
+                .legacy_fallback_cwd
+                .clone();
+            if from == cwd
+                || from.as_path().to_string_lossy().len() > 2048
+                || cwd.as_path().to_string_lossy().len() > 2048
+            {
+                return Err(refused());
+            }
+            let mut disclosure = codex_protocol::protocol::ContinuityMcpPlan {
+                id: uuid::Uuid::new_v4(),
+                kind: "mcp_runtime".into(),
+                harness: "codex".into(),
+                process_generation: provider_process_generation(),
+                agent_id: format!("codex:{}", self.thread_id),
+                reservation: reservation.clone(),
+                from,
+                to: cwd,
+                digest: String::new(),
+                // All categories are included until a closed native contributor
+                // census can safely narrow the target's potential effects.
+                effects: codex_protocol::protocol::ContinuityMcpEffects {
+                    processes: true,
+                    network: true,
+                    credentials: true,
+                    filesystem: true,
+                    plugins: true,
+                    binding_capture,
+                    plugin_capture,
+                    skill_capture,
+                    step_preparation,
+                },
+            };
+            let mut digest = Sha256::new();
+            digest.update(b"turnlink-native-mcp-plan-v1\0");
+            digest.update(serde_json::to_vec(&disclosure).map_err(|_| refused())?);
+            disclosure.digest = format!("{:x}", digest.finalize());
+            self.continuity_validate_configuration_preparation(owner, &preparation)
+                .boxed()
+                .await?;
+            if let Some(candidate) = &candidate {
+                if candidate.preparation.configured_config() != preparation.config() {
+                    return Err(refused());
+                }
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let path = self.continuity_receipt_path().await;
+            let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+            let mut state = self.state.lock().await;
+            state.continuity.check(owner, reservation)?;
+            let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+            if held.journal.phase != "acquired"
+                || held.approved.is_some()
+                || held.mcp_plan.is_some()
+                || !same_destination_candidate(&held.destination_candidate, &candidate)
+                || held
+                    .provider_plan
+                    .as_ref()
+                    .is_some_and(|plan| plan.disclosure.to != disclosure.to)
+            {
+                return Err(refused());
+            }
+            held.mcp_plan = Some(Arc::new(RetainedMcpPlan {
+                disclosure: disclosure.clone(),
+                preparation,
+                destination_candidate: candidate,
+            }));
+            held.journal.schema = 2;
+            held.journal.mcp_plan = Some(disclosure.clone());
+            if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                held.invalidate();
+                return Err(refused());
+            }
+            Ok(disclosure)
+        }
+        .boxed()
+    }
+
+    /// A fresh broker check is performed by the trusted private host. The
+    /// runtime and pending receipt are retained before any target effect.
+    pub(crate) fn continuity_construct_mcp<'a>(
+        self: &'a Arc<Self>,
+        owner: &'a ContinuityOwner,
+        reservation: &'a ContinuityReservation,
+        grant: codex_protocol::protocol::ContinuityMcpGrant,
+    ) -> futures::future::BoxFuture<'a, CodexResult<codex_protocol::protocol::ContinuityMcpReceipt>>
+    {
+        async move {
+            let (plan, provider) = {
+                let state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_ref().ok_or_else(refused)?;
+                if held.journal.phase != "acquired"
+                    || held.approved.is_some()
+                    || held.journal.mcp_grant.is_some()
+                    || held.mcp_startup.is_some()
+                {
+                    return Err(refused());
+                }
+                (
+                    held.mcp_plan.clone().ok_or_else(refused)?,
+                    held.provider_plan.clone().ok_or_else(refused)?,
+                )
+            };
+            if grant.mcp_plan != plan.disclosure
+                || grant.configuration_digest != plan.disclosure.digest
+                || grant.purpose != "establish-mcp"
+                || grant.status != "prepared"
+                || grant.agent_id != plan.disclosure.agent_id
+                || grant.from != plan.disclosure.from
+                || grant.to != plan.disclosure.to
+                || grant.channel.is_empty()
+                || grant.channel.len() > 64
+                || !grant
+                    .channel
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+                || grant.claim_generation == 0
+                || grant.claim_generation > 9_007_199_254_740_991
+                || grant.prepared_at > 9_007_199_254_740_991
+                || !grant
+                    .configuration_digest
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                || grant.configuration_digest.len() != 64
+            {
+                return Err(refused());
+            }
+            self.continuity_validate_configuration_preparation(owner, &plan.preparation)
+                .boxed()
+                .await?;
+            if provider.disclosure.to != plan.disclosure.to
+                || provider.preparation.configuration.config() != plan.preparation.config()
+                || !same_destination_candidate(
+                    &plan.destination_candidate,
+                    &provider.destination_candidate,
+                )
+            {
+                return Err(refused());
+            }
+            if let Some(candidate) = &plan.destination_candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            self.continuity_validate_provider_preparation(owner, &provider.preparation)
+                .await?;
+            let (runtime, effective_config) = self.continuity_destination_runtime_inputs(
+                &plan.preparation,
+                &provider.preparation.provider,
+            )?;
+            self.continuity_validate_configuration_preparation(owner, &plan.preparation)
+                .boxed()
+                .await?;
+            if let Some(candidate) = &plan.destination_candidate {
+                self.continuity_validate_retained_destination(owner, reservation, candidate.id)
+                    .await?;
+            }
+            let path = self.continuity_receipt_path().await;
+            let startup = {
+                let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+                let mut state = self.state.lock().await;
+                state.continuity.check(owner, reservation)?;
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                if held.journal.phase != "acquired"
+                    || held.approved.is_some()
+                    || held.journal.mcp_grant.is_some()
+                    || held.mcp_startup.is_some()
+                    || !same_destination_candidate(
+                        &held.destination_candidate,
+                        &plan.destination_candidate,
+                    )
+                    || !held
+                        .mcp_plan
+                        .as_ref()
+                        .is_some_and(|current| Arc::ptr_eq(current, &plan))
+                    || held.journal.mcp_plan.as_ref() != Some(&plan.disclosure)
+                    || !held
+                        .provider_plan
+                        .as_ref()
+                        .is_some_and(|current| Arc::ptr_eq(current, &provider))
+                {
+                    return Err(refused());
+                }
+                let source = held.source_mcp_observation.as_ref().ok_or_else(refused)?;
+                let startup = Arc::new(codex_mcp::NativeMcpStartup::empty_sharing_events(
+                    plan.preparation.config().prefix_mcp_tool_names(),
+                    source.runtime(),
+                ));
+                held.mcp_startup = Some(Arc::clone(&startup));
+                held.journal.schema = 3;
+                held.journal.mcp_grant = Some(grant.clone());
+                held.journal.mcp_receipt = Some(codex_protocol::protocol::ContinuityMcpReceipt {
+                    transition_id: grant.id,
+                    plan_id: plan.disclosure.id,
+                    reservation: reservation.clone(),
+                    resource_id: uuid::Uuid::new_v4(),
+                    process_generation: plan.disclosure.process_generation,
+                    kind: "mcp_runtime".into(),
+                    phase: "pending".into(),
+                });
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                startup
+            };
+            let session = Arc::clone(self);
+            let owner = owner.clone();
+            let reservation = reservation.clone();
+            tokio::spawn(async move {
+                let outcome = if owner.is_open() {
+                    session
+                        .continuity_start_mcp(
+                            &owner,
+                            &plan,
+                            &provider,
+                            &startup,
+                            runtime,
+                            effective_config,
+                        )
+                        .await
+                } else {
+                    Err(refused())
+                };
+                let _settings = super::thread_settings::acquire_persistence_lock(&session).await;
+                let mut state = session.state.lock().await;
+                let valid = state.continuity.check(&owner, &reservation).is_ok();
+                let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+                if !valid
+                    || outcome.is_err()
+                    || !held
+                        .mcp_startup
+                        .as_ref()
+                        .is_some_and(|current| Arc::ptr_eq(current, &startup))
+                {
+                    tracing::debug!(owner_valid = valid, startup_failed = outcome.is_err(),
+                        stage = "mcp-construction-finish", "native construction refused");
+                    held.invalidate();
+                    held.journal.phase = "uncertain".into();
+                    let _ = write_journal(&path, &held.journal);
+                    return Err(refused());
+                }
+                let outcome = outcome?;
+                held.mcp_binding = outcome.binding;
+                held.mcp_plugins = outcome.plugins;
+                held.mcp_skills = outcome.skills;
+                let receipt = held.journal.mcp_receipt.as_mut().ok_or_else(refused)?;
+                receipt.phase = "constructed".into();
+                let receipt = receipt.clone();
+                if write_journal(&path, &held.journal).is_err() || !owner.is_open() {
+                    held.invalidate();
+                    return Err(refused());
+                }
+                Ok(receipt)
+            })
+            .await
+            .map_err(|_| refused())?
+        }
+        .boxed()
+    }
+
+    async fn continuity_start_mcp(
+        self: &Arc<Self>,
+        owner: &ContinuityOwner,
+        plan: &RetainedMcpPlan,
+        provider: &RetainedProviderPlan,
+        startup: &codex_mcp::NativeMcpStartup,
+        configuration: Box<SessionConfiguration>,
+        effective_config: Box<crate::config::Config>,
+    ) -> CodexResult<RetainedMcpInputs> {
+        use super::mcp_runtime::McpDesiredState;
+        use crate::mcp::{McpEnvironmentScope, McpThreadIdentity};
+        let prepared = &plan.preparation;
+        #[cfg(test)]
+        eprintln!("MCP start: entering target projection");
+        let config = Arc::new(*effective_config);
+        let bindings = crate::config::NativeConfigConstraintBindings::capture(&config);
+        let approval = configuration.step_settings.approval_policy.native_binding();
+        let permission = configuration
+            .permission_profile_state
+            .native_constraint_binding();
+        let environments = prepared.inputs.environments.clone();
+        let auth = self.services.auth_manager.auth().await;
+        let desired = McpDesiredState {
+            local_process_cwd: config.cwd.to_path_buf(),
+            config: Arc::clone(&config),
+            auth,
+            submit_id: self.next_internal_sub_id(),
+            originator: configuration.originator.clone(),
+            session_source: configuration.session_source.clone(),
+            environments,
+            disabled_plugin_ids: configuration.disabled_plugin_ids.clone(),
+        };
+        let selections = desired.environments.all_selections();
+        let selected = self
+            .resolve_selected_capability_roots_for_step(&desired.environments)
+            .await;
+        let ready = Self::ready_selected_capability_roots(&selected);
+        let (v2, _) = self
+            .executor_capability_discovery_for_step_v2(&desired.config, &desired.environments)
+            .await;
+        let (discovery, _) = self
+            .executor_capability_discovery_for_step(
+                &desired.config,
+                &selected,
+                &desired.environments,
+            )
+            .await;
+        let projection = self
+            .services
+            .mcp_manager
+            .runtime_config_for_step_with_plugin_observation(
+                &desired.config,
+                &self.services.mcp_thread_init,
+                &self.services.thread_extension_data,
+                McpThreadIdentity {
+                    auth_changed: false,
+                    session_source: &desired.session_source,
+                    originator: &desired.originator,
+                    disabled_plugin_ids: &desired.disabled_plugin_ids,
+                    environments: McpEnvironmentScope::Selected(&selections),
+                },
+                &ready,
+                discovery.as_deref(),
+                v2.as_deref(),
+                plan.disclosure.effects.plugin_capture,
+            )
+            .await;
+        let projection = self
+            .project_selected_environment_mcp_servers(
+                &desired.config,
+                &desired.environments,
+                projection,
+            )
+            .await;
+        tracing::debug!(stage = "mcp-projection", "native construction progress");
+        let plugins = if plan.disclosure.effects.plugin_capture {
+            let observation =
+                Arc::clone(projection.plugin_observation.as_ref().ok_or_else(refused)?);
+            let selection_roots = NativeTargetCapabilityRoots::capture(&desired.environments)?;
+            if selection_roots.roots != ready {
+                return Err(refused());
+            }
+            let selection_discovery = NativeTargetDiscovery::capture(
+                self,
+                &desired.config,
+                &desired.environments,
+                &selection_roots,
+            )?;
+            if !selection_discovery.matches_applied_discovery(discovery.as_deref(), v2.as_deref()) {
+                return Err(refused());
+            }
+            let context = codex_extension_api::McpServerContributionContext::for_step(
+                desired.config.as_ref(),
+                &self.services.mcp_thread_init,
+                &self.services.thread_extension_data,
+                &desired.originator,
+                &ready,
+                discovery.as_deref(),
+                v2.as_deref(),
+            )
+            .with_session_source(&desired.session_source)
+            .with_selected_environments(&selections);
+            let step_selection = self
+                .services
+                .mcp_manager
+                .selected_plugins_for_step(
+                    context,
+                    &projection.config.plugins,
+                    &desired.disabled_plugin_ids,
+                )
+                .await;
+            let captured = RetainedMcpPlugins {
+                observation,
+                step_selection,
+                selection_roots,
+                selection_discovery,
+            };
+            if !captured.selection_discovery_current(self, &desired.config, &desired.environments) {
+                return Err(refused());
+            }
+            Some(Arc::new(captured))
+        } else {
+            if projection.plugin_observation.is_some() {
+                return Err(refused());
+            }
+            None
+        };
+        tracing::debug!(stage = "mcp-plugins", "native construction progress");
+        let skills = if plan.disclosure.effects.skill_capture {
+            let plugins = plugins.as_ref().ok_or_else(refused)?;
+            let service = &self.services.skills_service;
+            let roots = service.native_observe_roots();
+            let skip = crate::guardian::is_basic_session_source(&configuration.session_source)
+                || (config
+                    .features
+                    .enabled(codex_features::Feature::SkipHostSkillDiscovery)
+                    && !self.services.extensions.requires_host_skill_discovery());
+            let (snapshot, local, repository) = if skip {
+                (
+                    codex_skills_extension::HostSkillsSnapshot::new(Arc::new(Default::default()))
+                        .native_capture_texts()
+                        .await
+                        .map_err(|_| refused())?,
+                    None,
+                    None,
+                )
+            } else {
+                let outcome = plugins
+                    .outcome()
+                    .clone()
+                    .without_plugins(&configuration.disabled_plugin_ids);
+                let (input, repository_source) = crate::skills::skills_load_input_for_environments(
+                    &config,
+                    &self.services.plugins_manager,
+                    outcome.effective_plugin_skill_roots(),
+                    &desired.environments,
+                );
+                let local_source = Arc::clone(&codex_exec_server::LOCAL_FS);
+                let local_capture =
+                    crate::config::native_preparation_fs::NativePreparationFileSystem::new_shared(
+                        Arc::clone(&local_source),
+                    );
+                let local_fs: Arc<dyn codex_exec_server::ExecutorFileSystem> =
+                    local_capture.clone();
+                let repository_capture = repository_source.as_ref().map(|source| {
+                    crate::config::native_preparation_fs::NativePreparationFileSystem::new_shared(
+                        Arc::clone(source),
+                    )
+                });
+                let repository_fs = repository_capture.as_ref().map(|capture| {
+                    Arc::clone(capture) as Arc<dyn codex_exec_server::ExecutorFileSystem>
+                });
+                let snapshot = service
+                    .native_prepare_for_config(&input, repository_fs, local_fs, true)
+                    .await
+                    .map_err(|_| refused())?;
+                let snapshot = snapshot
+                    .native_capture_texts()
+                    .await
+                    .map_err(|_| refused())?;
+                let local_inputs = local_capture.seal().await.map_err(|_| refused())?;
+                let repository = match (repository_source, repository_capture) {
+                    (Some(source), Some(capture)) => {
+                        Some((source, capture.seal().await.map_err(|_| refused())?))
+                    }
+                    (None, None) => None,
+                    _ => return Err(refused()),
+                };
+                (snapshot, Some((local_source, local_inputs)), repository)
+            };
+            let retained = Arc::new(RetainedSkillPreparation {
+                _snapshot: snapshot,
+                roots,
+                local,
+                repository,
+            });
+            if !retained.is_current(service).await {
+                return Err(refused());
+            }
+            Some(retained)
+        } else {
+            None
+        };
+        #[cfg(test)]
+        eprintln!("MCP start: target projection finished");
+        tracing::debug!(stage = "mcp-skills", "native construction progress");
+        self.continuity_validate_configuration_preparation(owner, prepared)
+            .boxed()
+            .await?;
+        #[cfg(test)]
+        eprintln!("MCP start: configuration revalidated");
+        self.continuity_validate_provider_preparation(owner, &provider.preparation)
+            .await?;
+        if let Some(candidate) = &plan.destination_candidate {
+            self.continuity_validate_retained_destination(
+                owner,
+                &plan.disclosure.reservation,
+                candidate.id,
+            )
+            .await?;
+        }
+        #[cfg(test)]
+        eprintln!("MCP start: provider revalidated");
+        tracing::debug!(stage = "mcp-pre-start-validation", "native construction progress");
+        let (current_runtime, current_config) =
+            self.continuity_destination_runtime_inputs(prepared, &provider.preparation.provider)?;
+        if *current_config != *config
+            || !bindings.has_closed_callback_state(&config)
+            || !approval.matches(&configuration.step_settings.approval_policy)
+            || !approval.has_closed_callback_state()
+            || !configuration
+                .permission_profile_state
+                .matches_native_constraint_binding(&permission)
+            || !permission.has_closed_callback_state()
+            || current_runtime.step_settings != configuration.step_settings
+            || current_runtime.permission_profile_state != configuration.permission_profile_state
+        {
+            #[cfg(test)]
+            eprintln!("MCP start: effective constraint comparison refused");
+            return Err(refused());
+        }
+        #[cfg(test)]
+        eprintln!("MCP start: starting retained runtime");
+        let mut input = self.build_mcp_runtime_input(&desired, projection, &ready, None);
+        // A detached target must not publish events or elicitations into the source conversation.
+        input.tx_event = None;
+        input.elicitation_lifecycle = None;
+        tracing::debug!(stage = "mcp-runtime-start", "native construction progress");
+        startup.start(input).map_err(|_| refused())?;
+        if startup.wait().await != codex_mcp::NativeMcpStartupState::Published {
+            #[cfg(test)]
+            eprintln!("MCP start: runtime publication failed");
+            return Err(refused());
+        }
+        // Publication only retains the connection set; required servers may
+        // still be starting or may have failed. Preserve the ordinary native
+        // required-server semantics before reporting construction complete.
+        tracing::debug!(stage = "mcp-runtime-published", "native construction progress");
+        startup
+            .runtime()
+            .validate_required_servers()
+            .await
+            .map_err(|_| refused())?;
+        // Binding capture may reconnect a failed server or refresh a catalog.
+        // It is only permitted when that effect was in the approved plan.
+        tracing::debug!(stage = "mcp-required-servers", "native construction progress");
+        let observed_binding = if plan.disclosure.effects.binding_capture {
+            #[cfg(debug_assertions)]
+            let fixture_unstable = std::env::var_os("TURNLINK_EXPERIMENTAL_STAGING_FIXTURE").as_deref()
+                == Some(std::ffi::OsStr::new("1"))
+                && std::env::var_os("TURNLINK_EXPERIMENTAL_MCP_CATALOG_UNSTABLE").as_deref()
+                    == Some(std::ffi::OsStr::new("1"));
+            #[cfg(not(debug_assertions))]
+            let fixture_unstable = false;
+            let stable_before = !fixture_unstable && startup.runtime().native_catalogs_are_stable().await;
+            let mut binding = startup
+                .runtime()
+                .current_binding()
+                .await
+                .ok_or_else(refused)?;
+            let mut observed = if fixture_unstable { None } else {
+                startup.runtime().native_observe_cached_binding().await
+            };
+            // Native binding assembly may itself finish an optional startup.
+            // The first capture then lacks a before/after catalog witness. Once
+            // startup is stable, perform at most one fresh approved capture;
+            // this remains inside the same journaled worker, never a replay.
+            // Optional server startup may still be finishing after binding
+            // assembly. Wait only for read-only catalog readiness; a second
+            // binding capture remains bounded to one and is revalidated below.
+            let mut stable_after = false;
+            if observed.is_none() && !stable_before {
+                for _ in 0..100 {
+                    if !owner.is_open() {
+                        return Err(refused());
+                    }
+                    if !fixture_unstable && startup.runtime().native_catalogs_are_stable().await {
+                        stable_after = true;
+                        break;
+                    }
+                    tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+                }
+            }
+            if observed.is_none() && !stable_before && stable_after {
+                self.continuity_validate_configuration_preparation(owner, prepared)
+                    .boxed()
+                    .await?;
+                self.continuity_validate_provider_preparation(owner, &provider.preparation)
+                    .await?;
+                if let Some(candidate) = &plan.destination_candidate {
+                    self.continuity_validate_retained_destination(
+                        owner,
+                        &plan.disclosure.reservation,
+                        candidate.id,
+                    )
+                    .await?;
+                }
+                binding = startup
+                    .runtime()
+                    .current_binding()
+                    .await
+                    .ok_or_else(refused)?;
+                observed = startup.runtime().native_observe_cached_binding().await;
+            }
+        tracing::debug!(stage = "mcp-binding-observed", "native construction progress");
+            tracing::debug!(stable_before, stable_after, observed = observed.is_some(),
+                stage = "mcp-binding-result", "native construction binding status");
+            let observed = observed.ok_or_else(refused)?;
+            if !Arc::ptr_eq(observed.binding(), &binding) {
+                return Err(refused());
+            }
+            Some(Arc::new(observed))
+        } else {
+            None
+        };
+        self.continuity_validate_configuration_preparation(owner, prepared)
+            .boxed()
+            .await?;
+        self.continuity_validate_provider_preparation(owner, &provider.preparation)
+            .await?;
+        if let Some(candidate) = &plan.destination_candidate {
+            self.continuity_validate_retained_destination(
+                owner,
+                &plan.disclosure.reservation,
+                candidate.id,
+            )
+            .await?;
+        }
+        tracing::debug!(stage = "mcp-post-start-validation", "native construction progress");
+        if let Some(binding) = &observed_binding
+            && !binding.is_current(startup.runtime()).await
+        {
+            return Err(refused());
+        }
+        if let Some(plugins) = &plugins
+            && !plugins.is_current(
+                &self.services.plugins_manager,
+                &config.plugins_config_input(),
+            )
+        {
+            return Err(refused());
+        }
+        if let Some(skills) = &skills
+            && !skills.is_current(&self.services.skills_service).await
+        {
+            return Err(refused());
+        }
+        tracing::debug!(stage = "mcp-complete", "native construction progress");
+        Ok(RetainedMcpInputs {
+            binding: observed_binding,
+            plugins,
+            skills,
+        })
+    }
+
+    pub(crate) async fn continuity_observe_mcp(
+        &self,
+        owner: &ContinuityOwner,
+        reservation: &ContinuityReservation,
+        plan: &codex_protocol::protocol::ContinuityMcpPlan,
+        transition_id: uuid::Uuid,
+    ) -> CodexResult<codex_protocol::protocol::ContinuityMcpObservation> {
+        let path = self.continuity_receipt_path().await;
+        let _settings = super::thread_settings::acquire_persistence_lock(self).await;
+        let mut state = self.state.lock().await;
+        state
+            .continuity
+            .check_owner_and_source(owner, reservation)?;
+        let held = state.continuity.held.as_mut().ok_or_else(refused)?;
+        let grant = held.journal.mcp_grant.as_ref().ok_or_else(refused)?;
+        let resource = held.journal.mcp_receipt.as_ref().ok_or_else(refused)?;
+        if &grant.mcp_plan != plan
+            || grant.id != transition_id
+            || resource.transition_id != transition_id
+            || resource.phase != "constructed"
+            || !held.mcp_startup.as_ref().is_some_and(|startup| {
+                startup.state() == codex_mcp::NativeMcpStartupState::Published
+            })
+        {
+            return Err(refused());
+        }
+        if held.journal.mcp_quiescence.is_some()
+            && !held
+                .mcp_quiescence_exclusion
+                .as_ref()
+                .is_some_and(|guard| guard.is_current())
+        {
+            // The receipt is historical, but custody is no longer established.
+            // Persist uncertainty before refusing observation; never let a later
+            // retry be required to record that the fence was invalidated.
+            held.invalidate();
+            held.journal.phase = "uncertain".into();
+            let _ = write_journal(&path, &held.journal);
+            return Err(refused());
+        }
+        Ok(codex_protocol::protocol::ContinuityMcpObservation {
+            plan: plan.clone(),
+            resource: resource.clone(),
+            status: "owned".into(),
+            quiescence: held.journal.mcp_quiescence.clone(),
+        })
+    }
+
+    #[cfg(test)]
+    pub(super) async fn continuity_mcp_events_shared_for_test(&self) -> bool {
+        let state = self.state.lock().await;
+        let Some(held) = state.continuity.held.as_ref() else {
+            return false;
+        };
+        held.mcp_startup
+            .as_ref()
+            .zip(held.source_mcp_observation.as_ref())
+            .is_some_and(|(startup, source)| {
+                startup
+                    .runtime()
+                    .shares_native_event_owner(source.runtime())
+                    && startup.runtime().begin_native_event_request().is_err()
+            })
+    }
