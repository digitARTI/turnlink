+async fn verify_native_authority_same_value_runtime_enforcer_drift(profile: bool) {
+    use crate::config::{Constrained, PermissionProfileState};
+    let (tx, runner, session) = queue().await;
+    session.services.turn_environments.snapshot().await;
+    let destination = tempfile::tempdir().unwrap();
+    let cwd = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        destination.path().canonicalize().unwrap(),
+    )
+    .unwrap();
+    let owner = ContinuityOwner::new();
+    let held = acquire(&tx, &owner).await.unwrap();
+    let prepared = session
+        .continuity_prepare_configuration(&owner, &held, cwd)
+        .await
+        .unwrap();
+    session
+        .continuity_validate_configuration_preparation(&owner, &prepared)
+        .await
+        .unwrap();
+    {
+        let mut state = session.state.lock().await;
+        if profile {
+            let before = state.session_configuration.permission_profile_state.clone();
+            state.session_configuration.permission_profile_state =
+                PermissionProfileState::from_constrained_snapshot(
+                    Constrained::allow_only(before.permission_profile().clone()),
+                    before.snapshot(),
+                )
+                .unwrap();
+            assert_eq!(state.session_configuration.permission_profile_state, before);
+        } else {
+            let before = state.session_configuration.step_settings.clone();
+            let settings = Arc::make_mut(&mut state.session_configuration.step_settings);
+            settings.approval_policy = Constrained::allow_only(settings.approval_policy.value());
+            assert_eq!(&state.session_configuration.step_settings, &before);
+        }
+    }
+    assert!(
+        session
+            .continuity_validate_configuration_preparation(&owner, &prepared)
+            .await
+            .is_err(),
+        "same-value runtime enforcer replacement must revoke preparation"
+    );
+    runner.abort();
+}
