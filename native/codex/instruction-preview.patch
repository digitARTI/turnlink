+// The movement grant is separate from both establishment grants. Matching
+// these values binds the host assertion to the already-retained native owners;
+// it does not itself establish destination execution readiness.
+fn destination_grant_matches(
+    journal: &Journal,
+    grant: &codex_protocol::protocol::ContinuityHostGrant,
+) -> bool {
+    let (Some(mcp), Some(provider), Some(step)) =
+        (&journal.mcp_grant, &journal.provider_grant, &journal.step)
+    else {
+        return false;
+    };
+    let Some(receipt) = &step.receipt else {
+        return false;
+    };
+    let cancelled = journal.host_grant.is_none()
+        && journal
+            .destination_cancellation
+            .as_ref()
+            .is_some_and(|cancellation| {
+                &cancellation.grant == grant && cancellation.step_id == receipt.step_id
+            });
+    (journal.host_grant.as_ref() == Some(grant) && journal.destination_cancellation.is_none()
+        || cancelled)
+        && journal.cwd.as_ref() == Some(&grant.to)
+        && journal.source_cwd == grant.from
+        && journal.transition_id == Some(provider.id)
+        && grant.id != provider.id
+        && grant.id != mcp.id
+        && mcp.id != provider.id
+        && grant.preview_id != mcp.preview_id
+        && grant.preview_id != provider.preview_id
+        && grant.status == "prepared"
+        && grant.agent_id == mcp.agent_id
+        && grant.agent_id == provider.agent_id
+        && grant.channel == mcp.channel
+        && grant.channel == provider.channel
+        && grant.task_id == mcp.task_id
+        && grant.task_id == provider.task_id
+        && grant.prepared_at >= mcp.prepared_at
+        && grant.prepared_at >= provider.prepared_at
+        && grant.claim_generation == mcp.claim_generation
+        && grant.claim_generation == provider.claim_generation
+        && grant.from == mcp.from
+        && grant.from == provider.from
+        && grant.to == mcp.to
+        && grant.to == provider.to
+        && mcp.mcp_plan.reservation == journal.reservation
+        && provider.provider_plan.reservation == journal.reservation
+        && mcp.mcp_plan.process_generation == provider.provider_plan.process_generation
+        && mcp.mcp_plan.effects.step_preparation
+        && journal.mcp_receipt.as_ref().is_some_and(|owner| {
+            owner.phase == "constructed" && owner.resource_id == receipt.mcp_resource_id
+        })
+        && journal.provider_receipt.as_ref().is_some_and(|owner| {
+            owner.phase == "constructed" && owner.resource_id == receipt.provider_resource_id
+        })
+        && step.status == "retained"
+        && (cancelled || step.disposal.is_none())
+        && receipt.operation_id == step.operation_id
+        && receipt.candidate_id == step.candidate_id
+        && receipt.status == "retained"
+        && (cancelled || journal.mcp_shutdown_id.is_none())
+        && (cancelled || journal.provider_cleanup_id.is_none())
+}
