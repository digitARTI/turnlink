+            });
+        }
+        registry
+            .tool_contributors()
+            .iter()
+            .enumerate()
+            .map(|(index, contributor)| {
+                if !(contributor.as_ref() as &dyn std::any::Any).is::<Known>() {
+                    return Err(NativeToolCollectionError::UnknownContributor { index });
+                }
+                Ok(PreparedToolContributor::new(
+                    contributor.clone(),
+                    vec![PreparedExtensionTool::capture(&DeferredExtensionTool)],
+                ))
+            })
