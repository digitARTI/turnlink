+async fn instruction_preparation_fixture_with_fixtures(
+    trusted: bool,
+    source_model: &str,
+    skill_policy: Option<Arc<std::sync::atomic::AtomicBool>>,
+    hosted_plugin: bool,
+    unknown_turn_input: bool,
+) -> (
+    tempfile::TempDir,
+    async_channel::Sender<Submission>,
+    tokio::task::JoinHandle<()>,
+    Arc<super::session::Session>,
+    codex_utils_absolute_path::AbsolutePathBuf,
+) {
+    let (tx, runner, session) =
+        queue_with_fixtures(skill_policy, hosted_plugin, unknown_turn_input).await;
+    session.services.turn_environments.snapshot().await;
+    let root = tempfile::tempdir().unwrap();
+    let home = root.path().join("home");
+    let destination = root.path().join("destination");
+    std::fs::create_dir_all(&home).unwrap();
+    std::fs::create_dir_all(destination.join(".codex")).unwrap();
+    let cwd = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        std::fs::canonicalize(&destination).unwrap(),
+    )
+    .unwrap();
+    let key = toml::Value::String(cwd.as_path().to_string_lossy().into_owned()).to_string();
+    let trust = if trusted { "trusted" } else { "untrusted" };
+    std::fs::write(
+        home.join("config.toml"),
+        format!("project_doc_max_bytes=111\n[projects.{key}]\ntrust_level='{trust}'\n"),
+    )
+    .unwrap();
+    std::fs::write(
+        destination.join(".codex/config.toml"),
+        "project_doc_max_bytes=4\nproject_doc_fallback_filenames=[' GUIDE.md ']\n",
+    )
+    .unwrap();
+    std::fs::write(destination.join("GUIDE.md"), "abcdefgh").unwrap();
+    let source_cwd = session.thread_settings_snapshot().await.cwd;
+    let config = crate::config::ConfigBuilder::without_managed_config_for_tests()
+        .codex_home(home)
+        .harness_overrides(crate::config::ConfigOverrides {
+            cwd: Some(source_cwd.to_path_buf()),
+            model: Some(source_model.into()),
+            ..Default::default()
+        })
+        .build()
+        .boxed()
+        .await
+        .unwrap();
+    session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .original_config_do_not_use = Arc::new(config);
+    (root, tx, runner, session, cwd)
+}
