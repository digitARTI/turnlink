+//! Loader-owned filesystem input provenance. This covers native configuration
+//! file reads, not MDM/provider/environment freshness or complete policy authority.
+
+use super::*;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+const MAX_CONFIGURATION_BYTES: usize = 1_048_576;
+
+#[derive(Clone, Debug, PartialEq)]
+struct FileDigest {
+    size: usize,
+    sha256: [u8; 32],
+}
+impl FileDigest {
+    fn of(bytes: &[u8]) -> Self {
+        Self {
+            size: bytes.len(),
+            sha256: Sha256::digest(bytes).into(),
+        }
+    }
+}
+
+/// Private inputs recorded by actual native readers, never from path/version labels.
+#[derive(Clone, Debug)]
+pub(crate) struct NativeConfigurationFileInputs {
+    files: Option<BTreeMap<AbsolutePathBuf, Option<FileDigest>>>,
+    requirements: crate::ConfigRequirementsToml,
+    ignore_rules: bool,
+}
+
+pub(super) struct FileInputCapture {
+    files: BTreeMap<AbsolutePathBuf, Option<FileDigest>>,
+    remaining: usize,
+    valid: bool,
+}
+impl Default for FileInputCapture {
+    fn default() -> Self {
+        Self {
+            files: BTreeMap::new(),
+            remaining: MAX_CONFIGURATION_BYTES,
+            valid: true,
+        }
+    }
+}
+impl FileInputCapture {
+    fn invalidate(&mut self) {
+        self.valid = false;
+        self.files.clear();
+    }
+    fn record(&mut self, path: &AbsolutePathBuf, bytes: Option<&[u8]>) {
+        if !self.valid {
+            return;
+        }
+        if !self.files.contains_key(path) && bytes.is_some_and(|value| value.len() > self.remaining)
+        {
+            self.invalidate();
+            return;
+        }
+        if bytes.is_some_and(|value| value.len() > MAX_CONFIGURATION_BYTES) {
+            self.invalidate();
+            return;
+        }
+        let observed = bytes.map(FileDigest::of);
+        if let Some(previous) = self.files.get(path) {
+            if previous != &observed {
+                self.invalidate();
+            }
+            return;
+        }
+        self.remaining -= bytes.map_or(0, <[u8]>::len);
+        self.files.insert(path.clone(), observed);
+    }
+    pub(super) fn finish(self, stack: &ConfigLayerStack) -> NativeConfigurationFileInputs {
+        NativeConfigurationFileInputs {
+            files: self.valid.then_some(self.files),
+            requirements: stack.requirements_toml().clone(),
+            ignore_rules: stack.ignore_user_and_project_exec_policy_rules(),
+        }
+    }
+}
+
+/// Preserve ordinary reader behavior, including errors and large valid inputs.
+/// Preparation provenance becomes unavailable if native reads cannot be bounded
+/// or disagree; ordinary loading neither truncates nor gains a new refusal.
+pub(super) async fn read_configuration_text(
+    fs: &dyn ExecutorFileSystem,
+    path: &AbsolutePathBuf,
+    capture: Option<&mut FileInputCapture>,
+) -> io::Result<String> {
+    let value = fs
+        .read_file_text(&PathUri::from_abs_path(path), Default::default(), None)
+        .await;
+    if let Some(capture) = capture {
+        match &value {
+            Ok(text) => capture.record(path, Some(text.as_bytes())),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => capture.record(path, None),
+            Err(_) => capture.invalidate(),
+        }
+    }
+    value
+}
+
+fn unavailable() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::WouldBlock,
+        "native configuration file inputs are unavailable or stale",
+    )
+}
+fn changed() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "native configuration file inputs changed",
+    )
+}
+fn source_inputs(stack: &ConfigLayerStack) -> io::Result<&Arc<NativeConfigurationFileInputs>> {
+    let native = stack.native_project_inputs().ok_or_else(unavailable)?;
+    let files = native.file_inputs.as_ref().ok_or_else(unavailable)?;
+    if native.signature != super::project_preparation::global_signature(stack)
+        || files.requirements != *stack.requirements_toml()
+        || files.ignore_rules != stack.ignore_user_and_project_exec_policy_rules()
+        || files.files.is_none()
+    {
+        return Err(unavailable());
+    }
+    stack.ensure_config_server_applied()?;
+    if stack.cloud_config_binding().is_some_and(|binding| {
+        binding.read().status != crate::CloudConfigBundleBindingStatus::Current
+    }) {
+        return Err(unavailable());
+    }
+    Ok(files)
+}
+
+async fn matches_files(
+    fs: &dyn ExecutorFileSystem,
+    inputs: &NativeConfigurationFileInputs,
+    reader: &mut super::project_preparation::ProjectReadPolicy,
+) -> io::Result<bool> {
+    for (path, expected) in inputs.files.as_ref().ok_or_else(unavailable)? {
+        let text = reader.read_text(fs, path).await?;
+        let observed = text.as_ref().map(|value| FileDigest::of(value.as_bytes()));
+        if &observed != expected {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+/// A read-only observation of the actual native loader's file inputs. It is not
+/// full global/provider freshness or destination authority. No raw file data or
+/// public construction/serialization is exposed through this type.
+pub struct ConfigurationFilePreview {
+    inputs: Arc<NativeConfigurationFileInputs>,
+}
+impl ConfigurationFilePreview {
+    pub async fn revalidate(
+        &self,
+        fs: &dyn ExecutorFileSystem,
+        current: &ConfigLayerStack,
+    ) -> io::Result<bool> {
+        let inputs = source_inputs(current)?;
+        if !Arc::ptr_eq(inputs, &self.inputs) {
+            return Ok(false);
+        }
+        let mut reader = super::project_preparation::ProjectReadPolicy::preparation();
+        matches_files(fs, inputs, &mut reader).await
+    }
+}
+
+pub async fn preview_configuration_files(
+    fs: &dyn ExecutorFileSystem,
+    source: &ConfigLayerStack,
+) -> io::Result<ConfigurationFilePreview> {
+    let mut reader = super::project_preparation::ProjectReadPolicy::preparation();
+    preview_with_reader(fs, source, &mut reader).await
+}
+
+pub(super) async fn preview_with_reader(
+    fs: &dyn ExecutorFileSystem,
+    source: &ConfigLayerStack,
+    reader: &mut super::project_preparation::ProjectReadPolicy,
+) -> io::Result<ConfigurationFilePreview> {
+    let inputs = source_inputs(source)?.clone();
+    if !matches_files(fs, &inputs, reader).await? {
+        return Err(changed());
+    }
+    // Recheck native live binding state after filesystem I/O without refreshing providers.
+    if !Arc::ptr_eq(&inputs, source_inputs(source)?) {
+        return Err(unavailable());
+    }
+    Ok(ConfigurationFilePreview { inputs })
+}
