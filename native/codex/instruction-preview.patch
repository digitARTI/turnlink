@@ -0,0 +1,162 @@
+//! Tracks the actual SDK transport close, whose errors the SDK otherwise logs.
+use std::future::Future;
+use std::sync::Arc;
+
+use rmcp::service::{RoleClient, RxJsonRpcMessage, TxJsonRpcMessage};
+use rmcp::transport::Transport;
+
+use crate::NativeMcpActivity;
+
+pub(crate) fn track_native_transport<T: Transport<RoleClient>>(
+    inner: T,
+    owner: Option<Arc<NativeMcpActivity>>,
+) -> impl Transport<RoleClient, Error = T::Error> {
+    NativeTransport {
+        inner,
+        owner,
+        closed: false,
+    }
+}
+
+struct NativeTransport<T> {
+    inner: T,
+    owner: Option<Arc<NativeMcpActivity>>,
+    closed: bool,
+}
+
+impl<T: Transport<RoleClient>> Transport<RoleClient> for NativeTransport<T> {
+    type Error = T::Error;
+
+    fn send(
+        &mut self,
+        item: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = Result<(), Self::Error>> + Send + 'static {
+        self.inner.send(item)
+    }
+
+    fn receive(&mut self) -> impl Future<Output = Option<RxJsonRpcMessage<RoleClient>>> + Send {
+        self.inner.receive()
+    }
+
+    fn close(&mut self) -> impl Future<Output = Result<(), Self::Error>> + Send {
+        let activity = self.owner.as_ref().and_then(|owner| owner.begin_cleanup());
+        async move {
+            let result = self.inner.close().await;
+            self.closed = result.is_ok();
+            if let Some(activity) = activity {
+                activity.complete(result.is_ok());
+            }
+            result
+        }
+    }
+}
+
+impl<T> Drop for NativeTransport<T> {
+    fn drop(&mut self) {
+        if !self.closed
+            && let Some(activity) = self.owner.as_ref().and_then(|owner| owner.begin_cleanup())
+        {
+            activity.complete(false);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io;
+    use tokio::sync::Notify;
+
+    struct FakeTransport {
+        started: Arc<Notify>,
+        release: Arc<Notify>,
+        fail: bool,
+    }
+
+    impl Transport<RoleClient> for FakeTransport {
+        type Error = io::Error;
+        fn send(
+            &mut self,
+            _: TxJsonRpcMessage<RoleClient>,
+        ) -> impl Future<Output = io::Result<()>> + Send + 'static {
+            std::future::ready(Ok(()))
+        }
+        async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+            None
+        }
+        async fn close(&mut self) -> io::Result<()> {
+            self.started.notify_one();
+            self.release.notified().await;
+            if self.fail {
+                Err(io::Error::other("close failed"))
+            } else {
+                Ok(())
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn native_transport_close_keeps_owner_until_actual_result() {
+        for fail in [false, true] {
+            let owner = Arc::new(NativeMcpActivity::default());
+            let started = Arc::new(Notify::new());
+            let release = Arc::new(Notify::new());
+            let mut transport = track_native_transport(
+                FakeTransport {
+                    started: started.clone(),
+                    release: release.clone(),
+                    fail,
+                },
+                Some(owner.clone()),
+            );
+            let held = owner.try_exclude().unwrap();
+            let close = transport.close();
+            assert!(!held.is_current());
+            drop(held);
+            assert!(owner.try_exclude().is_err());
+            let (result, ()) = tokio::join!(close, async {
+                started.notified().await;
+                release.notify_one();
+            });
+            assert_eq!(result.is_err(), fail);
+            drop(transport);
+            assert_eq!(owner.try_exclude().is_err(), fail);
+        }
+    }
+
+    #[test]
+    fn native_transport_unclosed_drop_is_uncertain() {
+        let owner = Arc::new(NativeMcpActivity::default());
+        let transport = track_native_transport(
+            FakeTransport {
+                started: Arc::new(Notify::new()),
+                release: Arc::new(Notify::new()),
+                fail: false,
+            },
+            Some(owner.clone()),
+        );
+        let held = owner.try_exclude().unwrap();
+        drop(transport);
+        assert!(!held.is_current());
+        drop(held);
+        assert!(owner.try_exclude().is_err());
+    }
+
+    #[test]
+    fn native_transport_cancelled_close_is_uncertain() {
+        let owner = Arc::new(NativeMcpActivity::default());
+        let mut transport = track_native_transport(
+            FakeTransport {
+                started: Arc::new(Notify::new()),
+                release: Arc::new(Notify::new()),
+                fail: false,
+            },
+            Some(owner.clone()),
+        );
+        let close = transport.close();
+        drop(close);
+        assert!(owner.try_exclude().is_err());
+        drop(transport);
+        assert!(owner.try_exclude().is_err());
+    }
+}
