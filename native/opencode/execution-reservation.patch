+import { Cause, Effect, Exit, Stream } from "effect"
+import { eq, sql } from "drizzle-orm"
+import { Headers } from "effect/http"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Database } from "@opencode/core/database/database"
+import { Location } from "@opencode/core/location"
+import { LocationServiceMap } from "@opencode/core/location-service-map"
+import { KVTable } from "@opencode/core/kv/sql"
+import { Project } from "@opencode/core/project"
+import { ProjectTable } from "@opencode/core/project/sql"
+import { AbsolutePath } from "@opencode/core/schema"
+import { Session } from "@opencode/core/session"
+import { SessionMovement } from "@opencode/core/session/movement"
+import { MovementFence } from "@opencode/core/session/movement-fence"
+import { SessionModelTransportJournal } from "@opencode/core/session/model-transport-journal"
+import { SessionModelTransport } from "@opencode/core/session/model-transport"
+import { SessionStore } from "@opencode/core/session/store"
+import { SessionTable } from "@opencode/core/session/sql"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { offlineModels } from "./models"
+
+const root = process.argv[2]!
+const mode = process.argv[3]!
+const source = Location.Ref.make({ directory: AbsolutePath.make("/project") })
+const destination = AbsolutePath.make("/project-worktree")
+const sessionID = Session.ID.make("ses_movement")
+const transitionID = "99999999-9999-4999-8999-999999999999"
+const graph = AppNodeBuilder.build(LayerNode.group([
+  SessionMovement.node, SessionModelTransport.node, Session.node, SessionStore.node, LocationServiceMap.node, Database.node,
+]), [offlineModels, Database.node.replace(Database.configured({ path: `${root}/movement.sqlite`, nativeMovement: true }))])
+
+await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+  const database = yield* Database.Service
+  const movements = yield* SessionMovement.Service
+  if (mode === "crash" || mode === "crash-absent" || mode === "crash-legacy") {
+    yield* database.db.insert(ProjectTable).values({ id: Project.ID.global, worktree: source.directory, sandboxes: [] }).run().pipe(Effect.orDie)
+    yield* database.db.insert(SessionTable).values({
+      id: sessionID, project_id: Project.ID.global, directory: source.directory,
+      slug: "movement", title: "Movement", version: "test",
+    }).run().pipe(Effect.orDie)
+    const child = Session.ID.make("ses_movement_child")
+    const unrelated = Session.ID.make("ses_movement_unrelated")
+    yield* database.db.insert(SessionTable).values([
+      { id: child, parent_id: sessionID, project_id: Project.ID.global, directory: source.directory, slug: "child", title: "Child", version: "test" },
+      { id: unrelated, project_id: Project.ID.global, directory: source.directory, slug: "unrelated", title: "Unrelated", version: "test" },
+    ]).run().pipe(Effect.orDie)
+    if (mode === "crash" || mode === "crash-legacy") yield* database.db.insert(KVTable).values({ key: "plugin:007400750072006e006c0069006e006b:memberships/ses_movement",
+      value: { sessionID, directory: source.directory, channel: "dev", forms: [] } }).run().pipe(Effect.orDie)
+    const sessions = yield* Session.Service
+    yield* sessions.synthetic({ sessionID, text: "Preserved prior input", resume: false })
+    yield* database.db.run(sql`INSERT OR IGNORE INTO event_sequence (aggregate_id, seq) VALUES ('ses_movement_child', 0)`).pipe(Effect.orDie)
+    yield* database.db.run(sql`INSERT INTO event (id, aggregate_id, seq, created, type, data)
+      VALUES ('evt_movement_child', 'ses_movement_child', 1, 1, 'fixture', '{}')`).pipe(Effect.orDie)
+    const owner = yield* movements.forActivation({ pluginID: "turnlink", location: source, authorized: true })
+    if (!database.movement) return yield* Effect.die("Missing compatible movement connection")
+    yield* SessionModelTransportJournal.make(database.db, database.movement).begin(child)
+    yield* SessionModelTransportJournal.make(database.db, database.movement).begin(unrelated)
+    const socketURL = process.env.TEST_MOVEMENT_MODEL_SOCKET
+    if (socketURL) {
+      const transport = yield* SessionModelTransport.Service
+      const run = yield* transport.bind(sessionID).execute({
+        id: "recovery-socket", connect: { url: socketURL, headers: Headers.empty },
+        fallback: () => Stream.die("unexpected fallback"),
+        driver: {
+          create: () => Effect.succeed({ message: "request", mode: "full" }),
+          observe: (_create, frame) => Effect.succeed({ type: "completed", frame }),
+        },
+      })
+      yield* Stream.runCollect(run.frames).pipe(Effect.scoped)
+    } else yield* SessionModelTransportJournal.make(database.db, database.movement).begin(sessionID)
+    const intent = yield* owner.prepare({ sessionID, transitionID, directory: destination })
+    if (mode === "crash-legacy") {
+      const { membershipFence: _marker, ...legacy } = intent
+      yield* database.db.update(KVTable).set({ value: legacy }).where(eq(KVTable.key, "session-movement-intent:v1:" + sessionID)).run().pipe(Effect.orDie)
+    }
+    yield* Effect.promise(() => Bun.write(`${root}/intent.json`, JSON.stringify(intent)))
+    process.exit(73)
+  }
+  if (!["recover", "recover-seal", "recover-refuse"].includes(mode)) return yield* Effect.die("Unexpected recovery mode")
+  const foreign = yield* movements.forActivation({ pluginID: "foreign", location: source, authorized: true })
+  const wrongPlugin = yield* foreign.recoverQuarantine({ sessionID, transitionID }).pipe(Effect.flip)
+  const owner = yield* movements.forActivation({ pluginID: "turnlink", location: source, authorized: true })
+  const wrong = yield* owner.recoverQuarantine({ sessionID, transitionID: "wrong" }).pipe(Effect.flip)
+  const before = yield* owner.inspectRecovery({ sessionID, transitionID }).pipe(Effect.flip)
+  const observed = yield* owner.observeRecoveryRecord({ sessionID, transitionID })
+  let refusedDirect: string | undefined, refusedLease: string | undefined, refusedClaim: string | undefined
+  let recovery: MovementFence.Recovery
+  if (observed.recovery) {
+    refusedDirect = (yield* owner.recoverQuarantine({ sessionID, transitionID }).pipe(Effect.flip)).message
+    refusedLease = (yield* owner.takeoverRecovery({ sessionID, transitionID, expected: observed.recovery,
+      targetLease: observed.recovery.leaseIncarnation }).pipe(Effect.flip)).message
+    refusedClaim = (yield* owner.takeoverRecovery({ sessionID, transitionID,
+      expected: { ...observed.recovery, activation: "changed" }, targetLease: observed.currentLease }).pipe(Effect.flip)).message
+    recovery = yield* owner.takeoverRecovery({ sessionID, transitionID, expected: observed.recovery, targetLease: observed.currentLease })
+  } else recovery = yield* owner.recoverQuarantine({ sessionID, transitionID })
+  let membershipSeal: unknown, recreateRefused: boolean | undefined, recreateCause: string | undefined, sealRemovalCause: string | undefined
+  if (mode === "recover-seal") {
+    membershipSeal = yield* owner.sealMembership({ sessionID, transitionID })
+    const attempt = yield* database.db.insert(KVTable).values({ key: "plugin:007400750072006e006c0069006e006b:memberships/ses_movement",
+      value: { sessionID, directory: source.directory } }).run().pipe(Effect.exit)
+    recreateRefused = Exit.isFailure(attempt)
+    if (Exit.isFailure(attempt)) recreateCause = Cause.pretty(attempt.cause)
+    const removal = yield* database.db.delete(KVTable).where(eq(KVTable.key, "native-membership-seal:v1:" + sessionID)).run().pipe(Effect.exit)
+    if (Exit.isFailure(removal)) sealRemovalCause = Cause.pretty(removal.cause)
+  }
+  let sealRefusal: string | undefined
+  if (mode === "recover-refuse") sealRefusal = (yield* owner.sealMembership({ sessionID, transitionID }).pipe(Effect.flip)).message
+  const repeated = yield* owner.recoverQuarantine({ sessionID, transitionID })
+  const inspection = yield* owner.inspectRecovery({ sessionID, transitionID })
+  const intent = yield* MovementFence.find(database.db, sessionID)
+  const persisted = yield* MovementFence.findRecovery(database.db, sessionID)
+  let reservationSucceeded = false
+  const reservation = yield* owner.withReservation({ sessionID, transitionID }, Effect.sync(() => { reservationSucceeded = true })).pipe(Effect.exit)
+  const reservationRefusal = Exit.isFailure(reservation) ? Cause.pretty(reservation.cause) : undefined
+  const store = yield* SessionStore.Service
+  const session = yield* store.get(sessionID)
+  const successor = yield* movements.forActivation({ pluginID: "turnlink", location: source, authorized: true })
+  const stale = yield* owner.inspectRecovery({ sessionID, transitionID }).pipe(Effect.flip)
+  const unclaimed = yield* successor.inspectRecovery({ sessionID, transitionID }).pipe(Effect.flip)
+  yield* Effect.promise(() => Bun.write(`${root}/recovery.json`, JSON.stringify({
+    wrong: wrong.message, wrongPlugin: wrongPlugin.message, before: before.message, inspection, recovery, repeated, intent, persisted,
+    reservationSucceeded, reservationRefusal, location: session?.location, stale: stale.message, unclaimed: unclaimed.message,
+    refusedDirect, refusedLease, refusedClaim, membershipSeal, recreateRefused, recreateCause, sealRemovalCause, sealRefusal,
+  })))
+}).pipe(Effect.provide(graph))))
