index 0000000..8c041fd
--- /dev/null
+++ b/packages/core/test/git-native-read-authority.test.ts
@@ -0,0 +1,148 @@
+import { expect } from "bun:test"
+import fs from "node:fs/promises"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+// POSIX FIFO/EOF behavior is unavailable on Windows. Native Windows read and
+// descriptor cleanup acceptance remains separate rather than being simulated.
+const fifoTest = process.platform === "win32" ? it.live.skip : it.live
+
+fifoTest("Git config read retains cancellation through actual FIFO EOF and owner closure", () =>
+  Effect.gen(function* () {
+    const filesystem = yield* FSUtil.Service
+    const tmp = yield* tmpdirScoped()
+    const project = AbsolutePath.make(path.join(tmp.path, "project"))
+    const store = AbsolutePath.make(path.join(tmp.path, "store"))
+    const config = path.join(store, "opencode.gitconfig")
+    const payload = "[core]\n\tignorecase = false\n#" + "x".repeat(4 * 1024 * 1024) + "\n"
+    yield* Effect.promise(async () => {
+      await Bun.write(path.join(project, "tracked.txt"), "content\n")
+      await initRepo(project)
+    })
+    const state = { armed: false, reads: 0, writes: 0, returned: false, matches: false, released: false }
+    const nativeReads: Promise<string>[] = []
+    const owner = yield* Scope.make()
+    yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+    const context = yield* Layer.build(
+      Layer.fresh(
+        LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+          replacements: [
+            FSUtil.node.replace(
+              Layer.succeed(FSUtil.Service, {
+                ...filesystem,
+                readFileString: (file, options) => {
+                  if (!state.armed || file !== config) return filesystem.readFileString(file, options)
+                  state.reads++
+                  // Keep a fixture-owned native promise so even the cancellation-negative
+                  // probe can await physical read completion before deleting its FIFO.
+                  const reading = fs.readFile(file, "utf8")
+                  nativeReads.push(reading)
+                  return Effect.tryPromise({
+                    try: () => reading,
+                    catch: (cause) =>
+                      systemError({
+                        _tag: "Unknown",
+                        module: "FileSystem",
+                        method: "readFileString",
+                        pathOrDescriptor: file,
+                        cause,
+                      }),
+                  }).pipe(
+                    Effect.tap((value) =>
+                      Effect.sync(() => {
+                        state.returned = true
+                        state.matches = value === payload
+                      }),
+                    ),
+                  )
+                },
+                writeFileString: (file, value, options) => {
+                  if (state.armed) state.writes++
+                  return filesystem.writeFileString(file, value, options)
+                },
+              }),
+            ),
+          ],
+        }),
+      ),
+    ).pipe(Scope.provide(owner))
+    const git = Context.get(context, Git.Service)
+    const authority = Context.get(context, ReservationAuthority.Service)
+    const source = yield* git.repo.discover(project)
+    if (!source) return yield* Effect.die("fixture project is not a repository")
+    const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+    yield* filesystem.remove(config)
+    yield* Effect.acquireUseRelease(
+      Effect.sync(() => Bun.spawn(["mkfifo", config], { stdout: "ignore", stderr: "pipe" })),
+      (child) =>
+        Effect.promise(async () => {
+          const [code, errors] = await Promise.all([child.exited, new Response(child.stderr).text()])
+          expect(errors).toBe("")
+          expect(code).toBe(0)
+        }),
+      (child) =>
+        Effect.promise(async () => {
+          if (child.exitCode !== null) return
+          child.kill()
+          await child.exited
+        }),
+    )
+    const opening = fs.open(config, "w")
+    state.armed = true
+    const reader = yield* git.tree
+      .capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      .pipe(Effect.exit, Effect.forkScoped)
+    const writer = yield* Effect.promise(() => opening)
+    yield* Effect.gen(function* () {
+      // The paired descriptor is open and a pipe-buffer-exceeding payload is read
+      // by native readFile, but the writer deliberately withholds EOF.
+      yield* Effect.promise(() => writer.writeFile(payload))
+      expect(state.reads).toBe(1)
+      expect(state.returned).toBe(false)
+      expect(reader.pollUnsafe()).toBeUndefined()
+      const accepted = yield* Deferred.make<void>()
+      const cancelling = yield* Deferred.succeed(accepted, undefined).pipe(
+        Effect.andThen(Fiber.interrupt(reader)),
+        Effect.forkScoped,
+      )
+      yield* Deferred.await(accepted)
+      for (const _ of Array.from({ length: 10 })) yield* Effect.yieldNow
+      expect(cancelling.pollUnsafe()).toBeUndefined()
+      expect(state.returned).toBe(false)
+      expect(state.writes).toBe(0)
+      yield* Scope.close(owner, Exit.void)
+      expect(cancelling.pollUnsafe()).toBeUndefined()
+      const pending = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+      expect(Exit.isFailure(pending) && Cause.hasInterruptsOnly(pending.cause)).toBe(true)
+      yield* Effect.promise(async () => {
+        await writer.close()
+        state.released = true
+      })
+      yield* Fiber.join(cancelling)
+      expect(state.returned).toBe(true)
+      expect(state.matches).toBe(true)
+      expect(state.writes).toBe(0)
+      const result = yield* Fiber.await(reader)
+      expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(true)
+      const retained = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+      expect(Exit.isFailure(retained) && Cause.hasInterruptsOnly(retained.cause)).toBe(true)
+    }).pipe(
+      Effect.ensuring(
+        Effect.promise(async () => {
+          if (!state.released) await writer.close()
+          await Promise.all(nativeReads)
+        }),
+      ),
+    )
+  }),
+)
