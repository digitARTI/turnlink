@@ -0,0 +1,93 @@
+import { expect } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { Bus } from "@opencode/core/bus"
+import { Form } from "@opencode/core/form"
+import { Location } from "@opencode/core/location"
+import { LocationLifecycle } from "@opencode/core/location-lifecycle"
+import { Permission } from "@opencode/core/permission"
+import { Project } from "@opencode/core/project"
+import { Rpc } from "@opencode/core/rpc"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { AbsolutePath } from "@opencode/core/schema"
+import { LocationEvent } from "@opencode/schema/location-event"
+import { location } from "./fixture/location"
+import { it } from "./lib/effect"
+
+const ref = { directory: AbsolutePath.make("/lifecycle-reservation") }
+function layer(close: Effect.Effect<void>, after: (service: string) => void) {
+  return AppNodeBuilder.build(LayerNode.group([LocationLifecycle.node, ReservationAuthority.node, Bus.node]), [
+    Location.node.replace(Layer.succeed(Location.Service, location(ref))),
+    Project.node.replace(Layer.mock(Project.Service, { activate: () => Effect.void })),
+    Permission.node.replace(Layer.mock(Permission.Service, { close })),
+    Form.node.replace(Layer.mock(Form.Service, { close: Effect.sync(() => after("forms")) })),
+    Rpc.node.replace(Layer.mock(Rpc.Service, {
+      close: Effect.sync(() => after("rpc")),
+      client: () => { throw new Error("unused Rpc.client") },
+    })),
+  ])
+}
+
+it.effect("direct Location shutdown fences closure and publishes only after its services close", () =>
+  Effect.gen(function* () {
+    const closing = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const calls: string[] = []
+    yield* Effect.gen(function* () {
+      const authority = yield* ReservationAuthority.Service
+      const lifecycle = yield* LocationLifecycle.Service
+      const bus = yield* Bus.Service
+      const unsubscribe = yield* bus.listen((event) => Effect.sync(() => {
+        if (event.type === LocationEvent.Shutdown.type) calls.push("published")
+      }))
+      yield* Effect.addFinalizer(() => unsubscribe)
+      const entered = yield* Deferred.make<void>()
+      const reserved = yield* authority.withStable(Deferred.succeed(entered, undefined)
+        .pipe(Effect.andThen(Effect.never))).pipe(Effect.exit, Effect.forkScoped)
+      yield* Deferred.await(entered)
+      const shutdown = yield* lifecycle.shutdown.pipe(Effect.forkScoped)
+      yield* Effect.gen(function* () {
+        yield* Deferred.await(closing)
+        expect(lifecycle.isClosed()).toBe(true)
+        const duplicate = yield* lifecycle.shutdown.pipe(Effect.forkScoped)
+        expect(duplicate.pollUnsafe()).toBeUndefined()
+        expect(calls).toEqual([])
+        const exit = yield* Fiber.join(reserved)
+        expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        const blocked = yield* authority.withStable(Effect.die("shutdown has not closed its services")).pipe(Effect.exit)
+        expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+        yield* Deferred.succeed(release, undefined)
+        yield* Fiber.join(shutdown)
+        yield* Fiber.join(duplicate)
+        expect(calls).toEqual(["forms", "rpc", "published"])
+        const revision = yield* authority.revision
+        yield* lifecycle.shutdown
+        expect(yield* authority.revision).toBe(revision)
+        yield* authority.withStable(Effect.void)
+      }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+    }).pipe(Effect.provide(layer(Deferred.succeed(closing, undefined)
+      .pipe(Effect.andThen(Deferred.await(release))), (service) => calls.push(service))))
+  }),
+)
+
+it.effect("failed direct Location shutdown stays fenced until its owning layer is disposed", () =>
+  Effect.gen(function* () {
+    const scope = yield* Effect.acquireRelease(Scope.make(), (scope) => Scope.close(scope, Exit.void))
+    const calls: string[] = []
+    const context = yield* Layer.buildWithScope(layer(Effect.die("fixture close failure"),
+      (service) => calls.push(service)), scope)
+    const owned = yield* Effect.provide(ReservationAuthority.Service, context)
+    const lifecycle = yield* Effect.provide(LocationLifecycle.Service, context)
+    const exit = yield* lifecycle.shutdown.pipe(Effect.exit)
+    expect(Exit.isFailure(exit)).toBe(true)
+    expect(calls).toEqual([])
+    const blocked = yield* owned.withStable(Effect.die("failed closure remains uncertain")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    yield* lifecycle.shutdown
+    const stillBlocked = yield* owned.withStable(Effect.die("a duplicate shutdown is not recovery")).pipe(Effect.exit)
+    expect(Exit.isFailure(stillBlocked) && Cause.hasInterruptsOnly(stillBlocked.cause)).toBe(true)
+    yield* Scope.close(scope, Exit.void)
+    yield* owned.withStable(Effect.void)
+  }),
+)
