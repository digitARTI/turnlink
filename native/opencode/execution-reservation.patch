+import { OpencodePlugin } from "@opencode/core/plugin/provider/opencode"
+import { advanceEffect, drain } from "../lib/clock"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const it = testEffect(PluginTestLayer)
+const cases = [
+  ["openai", OpenAIPlugin], ["openai", ChatGPTPlugin], ["github-copilot", GithubCopilotPlugin],
+  ["gitlab", GitLabPlugin], ["digitalocean", DigitalOceanPlugin], ["modal", ModalPlugin],
+  ["snowflake-cortex", SnowflakeCortexPlugin], ["opencode", OpencodePlugin],
+] as const
+
+for (const [id, plugin] of cases) {
+  it.effect(`${plugin.id} credential handoff fences connection discovery before catalog reload`, () =>
+    Effect.gen(function* () {
+      const bus = yield* Bus.Service
+      const authority = yield* ReservationAuthority.Service
+      const integrations = yield* Integration.Service
+      const registry = yield* Plugin.Service
+      const host = yield* PluginHost.make(registry)
+      const reading = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const source = { block: false }
+      const active = (integrationID: string) => Effect.gen(function* () {
+        if (source.block && integrationID === id) {
+          yield* Deferred.succeed(reading, undefined)
+          yield* Deferred.await(release)
+        }
+        // No real credentials or remote account: this test stops at discovery.
+        return undefined
+      })
+      const setup: Effect.Effect<void, never, Effect.Services<ReturnType<(typeof cases)[number][1]["effect"]>>> =
+        plugin.effect({ ...host, integration: { ...host.integration,
+        connection: { ...host.integration.connection, active },
+      } })
+      yield* setup.pipe(Effect.provideService(Integration.Service, {
+        ...integrations, connection: { ...integrations.connection, active },
+      }))
+      yield* drain
+      yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+      source.block = true
+      yield* bus.publish(Credential.Event.Switched, {
+        integrationID: Integration.ID.make("unrelated-fixture"), credentialID: Credential.ID.create(),
+      }, { global: true })
+      yield* drain
+      expect(yield* Deferred.isDone(reading)).toBe(false)
+      yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+      const entered = yield* Deferred.make<void>()
+      const reserved = yield* authority.withStable(Deferred.succeed(entered, undefined)
+        .pipe(Effect.andThen(Effect.never))).pipe(Effect.exit, Effect.forkScoped)
+      yield* Effect.gen(function* () {
+        yield* Deferred.await(entered)
+        yield* bus.publish(Credential.Event.Switched, {
+          integrationID: Integration.ID.make(id), credentialID: Credential.ID.create(),
+        }, { global: true })
+        yield* Deferred.await(reading)
+        yield* drain
+        const blocked = yield* authority.withStable(Effect.die("provider connection discovery is pending")).pipe(Effect.exit)
+        expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+        const exit = yield* Fiber.join(reserved)
+        expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        source.block = false
+        yield* Deferred.succeed(release, undefined)
+        yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+      }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+    }),
+  )
+}
