+import { LayerNode } from "@opencode/util/effect/layer-node"
+
+const [root, mode, url] = process.argv.slice(2)
+const sessionID = Session.ID.make(mode === "other" ? "ses_other_model" : "ses_crashed_model")
+const graph = AppNodeBuilder.build(LayerNode.group([SessionModelTransport.node, Database.node]), [
+  Database.node.replace(Database.configured({ path: `${root}/movement.sqlite`, nativeMovement: mode !== "legacy" })),
+])
+const result = await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+  const database = yield* Database.Service
+  const transport = yield* SessionModelTransport.Service
+  if (!database.movement || !transport.releaseForMovement) return yield* Effect.die("Missing native movement services")
+  const journal = SessionModelTransportJournal.make(database.db, database.movement)
+  if (mode === "crash" || mode === "close" || mode === "reopen" || mode === "other" || mode === "normal") {
+    const run = yield* transport.bind(sessionID).execute({
+      id: "crash-test",
+      connect: { url: url!, headers: Headers.empty },
+      fallback: () => Stream.die("unexpected fallback"),
+      driver: {
+        create: () => Effect.succeed({ message: "request", mode: "full" }),
+        observe: (_create, frame) => Effect.succeed({ type: "completed", frame }),
+      },
+    })
+    if (mode === "reopen") {
+      const error = yield* Stream.runCollect(run.frames).pipe(Effect.scoped, Effect.flip)
+      if (error.reason._tag !== "Transport" || error.reason.code !== "journal-unavailable" || error.reason.delivery !== "not-sent")
+        return yield* Effect.die("Prior acquisition did not block the new request")
+      if ((yield* journal.list(sessionID)).length !== 1) return yield* Effect.die("Prior acquisition changed")
+      return
+    }
+    yield* Stream.runCollect(run.frames).pipe(Effect.scoped)
+    if ((yield* journal.list(sessionID)).length !== 1) return yield* Effect.die("Missing acquisition")
+    if (mode === "close" || mode === "other" || mode === "normal") {
+      yield* transport.releaseForMovement(sessionID)
+      if ((yield* journal.list(sessionID)).length !== 0) return yield* Effect.die("Acquisition not settled")
+    }
+    process.exit(73)
+  }
+  if (mode === "recover") {
+    const records = yield* journal.list(sessionID)
+    if (records.length !== 1) return yield* Effect.die("Missing previous acquisition")
+    const settle = yield* journal.settle(records[0]!).pipe(Effect.exit)
+    if (!Exit.isFailure(settle)) return yield* Effect.die("New owner settled previous acquisition")
+    const release = yield* transport.releaseForMovement(sessionID).pipe(Effect.flip)
+    if (release.reason._tag !== "Transport" || release.reason.code !== "prior-acquisition-unverified")
+      return yield* Effect.die("Unverified acquisition did not block release")
+    if ((yield* journal.list(sessionID)).length !== 1) return yield* Effect.die("Prior acquisition disappeared")
+    return
+  }
+  return yield* Effect.die("Unexpected mode")
+}).pipe(Effect.provide(graph), Effect.exit)))
