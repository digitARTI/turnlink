+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { AppProcess } from "@opencode/util/process"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([FSUtil.node, AppProcess.node])))
+
+it.live("all retained Git public entries refuse closed owners before filesystem/backend access", () =>
+  Effect.gen(function* () {
+    const fs = yield* FSUtil.Service
+    const backend = yield* AppProcess.Service
+    const tmp = yield* tmpdirScoped()
+    const project = AbsolutePath.make(path.join(tmp.path, "project"))
+    const store = AbsolutePath.make(path.join(tmp.path, "store"))
+    yield* Effect.promise(async () => {
+      await Bun.write(path.join(project, "tracked.txt"), "content\n")
+      await initRepo(project)
+    })
+    const gate = { closed: false }
+    const calls: string[] = []
+    const watch =
+      <Args extends unknown[], A, E, R>(name: string, call: (...args: Args) => Effect.Effect<A, E, R>) =>
+      (...args: Args) =>
+        Effect.suspend(() => {
+          if (!gate.closed) return call(...args)
+          calls.push(name)
+          // Regression safety: never actually fetch, reset or destroy fixture data.
+          return Effect.interrupt
+        })
+    const owner = yield* Scope.make()
+    yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+    const context = yield* Layer.build(
+      Layer.fresh(
+        LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+          replacements: [
+            AppProcess.node.replace(Layer.succeed(AppProcess.Service, { ...backend, run: watch("run", backend.run) })),
+            FSUtil.node.replace(
+              Layer.succeed(FSUtil.Service, {
+                ...fs,
+                up: watch("up", fs.up),
+                exists: watch("exists", fs.exists),
+                existsSafe: watch("existsSafe", fs.existsSafe),
+                stat: watch("stat", fs.stat),
+                ensureDir: watch("ensureDir", fs.ensureDir),
+                readDirectory: watch("readDirectory", fs.readDirectory),
+                readFile: watch("readFile", fs.readFile),
+                readFileString: watch("readFileString", fs.readFileString),
+                writeFileString: watch("writeFileString", fs.writeFileString),
+                copyFile: watch("copyFile", fs.copyFile),
+                rename: watch("rename", fs.rename),
+                remove: watch("remove", fs.remove),
+                link: watch("link", fs.link),
+                utimes: watch("utimes", fs.utimes),
+              }),
+            ),
+          ],
+        }),
+      ),
+    ).pipe(Scope.provide(owner))
+    const git = Context.get(context, Git.Service)
+    const source = yield* git.repo.discover(project)
+    if (!source) return yield* Effect.die("fixture project is not a repository")
+    const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+    const tree = yield* git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+    expect(yield* git.history.head(source)).toBeDefined()
+    const commands: readonly { name: string; make: () => Effect.Effect<unknown, unknown> }[] = [
+      { name: "repo.discover", make: () => git.repo.discover(project) },
+      {
+        name: "repo.clone",
+        make: () => git.repo.clone({ remote: project, directory: AbsolutePath.make(path.join(tmp.path, "clone")) }),
+      },
+      { name: "repo.create", make: () => git.repo.create({ worktree: project, gitDirectory: store, seed: source }) },
+      { name: "remote.get", make: () => git.remote.get(source) },
+      { name: "history.head", make: () => git.history.head(source) },
+      { name: "history.branch", make: () => git.history.branch(source) },
+      { name: "history.defaultRemoteBranch", make: () => git.history.defaultRemoteBranch(source) },
+      { name: "history.rootCommits", make: () => git.history.rootCommits(source) },
+      { name: "sync.fetchRemotes", make: () => git.sync.fetchRemotes(source) },
+      { name: "sync.fetchBranch", make: () => git.sync.fetchBranch(source, { branch: "fixture" }) },
+      { name: "sync.checkoutRemoteBranch", make: () => git.sync.checkoutRemoteBranch(source, { branch: "fixture" }) },
+      { name: "sync.resetHard", make: () => git.sync.resetHard(source, "HEAD") },
+      {
+        name: "worktree.create",
+        make: () =>
+          git.worktree.create({ repository: source, directory: AbsolutePath.make(path.join(tmp.path, "linked")) }),
+      },
+      {
+        name: "worktree.remove",
+        make: () =>
+          git.worktree.remove({
+            repository: source,
+            directory: AbsolutePath.make(path.join(tmp.path, "linked")),
+            force: false,
+          }),
+      },
+      { name: "worktree.list", make: () => git.worktree.list(source) },
+      { name: "index.refresh", make: () => git.index.refresh({ repository, scope: RelativePath.make(".") }) },
+      { name: "index.ignored", make: () => git.index.ignored({ repository, paths: [] }) },
+      {
+        name: "tree.capture",
+        make: () => git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source }),
+      },
+      { name: "tree.write", make: () => git.tree.write(repository) },
+      { name: "tree.files", make: () => git.tree.files({ repository, from: tree, to: tree }) },
+      { name: "tree.diff", make: () => git.tree.diff({ repository, from: tree, to: tree, paths: [] }) },
+      { name: "tree.restore", make: () => git.tree.restore({ repository, files: new Map() }) },
+      { name: "objects.pack", make: () => git.objects.pack(repository) },
+    ]
+    expect(commands).toHaveLength(23)
+    const retained = commands.map((command) => command.make())
+    yield* Scope.close(owner, Exit.void)
+    gate.closed = true
+    for (const [index, command] of commands.entries()) {
+      for (const effect of [retained[index]!, command.make()]) {
+        const exit = yield* effect.pipe(Effect.exit)
+        expect({ name: command.name, refused: Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause) }).toEqual({
+          name: command.name,
+          refused: true,
+        })
+        expect(calls).toEqual([])
+      }
+    }
+  }),
+)
+
+it.live("a queued capture rechecks its owner after mutex acquisition while active cleanup remains allowed", () =>
+  Effect.gen(function* () {
+    const fs = yield* FSUtil.Service
+    const backend = yield* AppProcess.Service
+    const tmp = yield* tmpdirScoped()
+    const project = AbsolutePath.make(path.join(tmp.path, "project"))
+    const store = AbsolutePath.make(path.join(tmp.path, "store"))
+    yield* Effect.promise(async () => {
+      await Bun.write(path.join(project, "tracked.txt"), "content\n")
+      await initRepo(project)
+    })
+    const entered = yield* Deferred.make<void>()
+    const queued = yield* Deferred.make<void>()
+    const resume = yield* Deferred.make<void>()
+    const gate = { armed: false, copies: 0, calls: 0 }
+    const temporaries: string[] = []
+    const owner = yield* Scope.make()
+    yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+    const context = yield* Layer.build(
+      Layer.fresh(
+        LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+          replacements: [
+            AppProcess.node.replace(
+              Layer.succeed(AppProcess.Service, {
+                ...backend,
+                run: (command, options) => {
+                  if (gate.armed) gate.calls++
+                  return backend.run(command, options)
+                },
+              }),
+            ),
+            FSUtil.node.replace(
+              Layer.succeed(FSUtil.Service, {
+                ...fs,
+                copyFile: (from, to) => {
+                  if (!gate.armed || from !== path.join(store, "index")) return fs.copyFile(from, to)
+                  gate.copies++
+                  temporaries.push(to)
+                  return fs
+                    .copyFile(from, to)
+                    .pipe(Effect.andThen(Deferred.succeed(entered, undefined)), Effect.andThen(Deferred.await(resume)))
+                },
+              }),
+            ),
+          ],
+        }),
+      ),
+    ).pipe(Scope.provide(owner))
+    const git = Context.get(context, Git.Service)
+    const authority = Context.get(context, ReservationAuthority.Service)
+    const source = yield* git.repo.discover(project)
+    if (!source) return yield* Effect.die("fixture project is not a repository")
+    const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+    const capture = git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+    yield* capture
+    yield* Effect.gen(function* () {
+      gate.armed = true
+      const first = yield* capture.pipe(Effect.exit, Effect.forkScoped)
+      yield* Deferred.await(entered)
+      const second = yield* Deferred.succeed(queued, undefined).pipe(
+        Effect.andThen(capture),
+        Effect.exit,
+        Effect.forkScoped,
+      )
+      yield* Deferred.await(queued)
+      yield* Effect.yieldNow
+      expect(second.pollUnsafe()).toBeUndefined()
+      yield* Scope.close(owner, Exit.void)
+      yield* Deferred.succeed(resume, undefined)
+      for (const fiber of [first, second]) {
+        const exit = yield* Fiber.join(fiber)
+        expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+      }
+      expect(gate.copies).toBe(1)
+      expect(gate.calls).toBe(0)
+      yield* Effect.forEach(temporaries, (file) =>
+        Effect.gen(function* () {
+          expect(yield* fs.exists(file)).toBe(false)
+        }),
+      )
+      const refused = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+      expect(Exit.isFailure(refused) && Cause.hasInterruptsOnly(refused.cause)).toBe(true)
+    }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+  }),
+)
diff --git a/packages/core/test/git-owner-continuation.test.ts b/packages/core/test/git-owner-continuation.test.ts
new file mode 100644
index 0000000..0b34d3b
--- /dev/null
+++ b/packages/core/test/git-owner-continuation.test.ts
@@ -0,0 +1,158 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { AppProcess } from "@opencode/util/process"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([FSUtil.node, AppProcess.node])))
+
+for (const phase of [
+  "index-stat",
+  "index-copy",
+  "index-fingerprint",
+  "config-read",
+  "config-write",
+  "store-directory",
+  "store-config-write",
+] as const) {
+  it.live(`Git owner closure after ${phase} refuses subsequent delegation but permits temporary cleanup`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const backend = yield* AppProcess.Service
+      const tmp = yield* tmpdirScoped()
+      const project = AbsolutePath.make(path.join(tmp.path, "project"))
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const current = path.join(store, "index")
+      const config = path.join(store, "opencode.gitconfig")
+      const stale = "[core]\n\tignorecase = false\n"
+      yield* Effect.promise(async () => {
+        await Bun.write(path.join(project, "tracked.txt"), "content\n")
+        await initRepo(project)
+      })
+      const entered = yield* Deferred.make<void>()
+      const resume = yield* Deferred.make<void>()
+      const gate = { armed: false, closed: false, paused: false, fingerprints: 0 }
+      const after: string[] = []
+      const cleanup: string[] = []
+      const created: string[] = []
+      const record = <A, E, R>(method: string, file: string, effect: Effect.Effect<A, E, R>) =>
+        Effect.gen(function* () {
+          if (gate.closed) {
+            if (
+              method === "remove" &&
+              (file.startsWith(`${store}.init-`) ||
+                file.startsWith(config + ".") ||
+                (path.dirname(file) === store && path.basename(file).startsWith("index.opencode-")))
+            )
+              cleanup.push(file)
+            else after.push(method)
+          }
+          const value = yield* effect
+          if (!gate.armed || gate.paused) return value
+          const indexTemporary = path.dirname(file) === store && path.basename(file).startsWith("index.opencode-")
+          if (method === "stat" && indexTemporary) gate.fingerprints++
+          if (
+            (method === "copyFile" && indexTemporary) ||
+            (method === "writeFileString" && file.startsWith(config + ".")) ||
+            (method === "ensureDir" && file.startsWith(`${store}.init-`) && path.dirname(file) === tmp.path)
+          )
+            created.push(file)
+          const pause =
+            (phase === "index-stat" && method === "stat" && file === current) ||
+            (phase === "index-copy" && method === "copyFile" && indexTemporary) ||
+            (phase === "index-fingerprint" && method === "stat" && indexTemporary && gate.fingerprints === 2) ||
+            (phase === "config-read" && method === "readFileString" && file === config) ||
+            (phase === "config-write" && method === "writeFileString" && file.startsWith(config + ".")) ||
+            (phase === "store-directory" && method === "ensureDir" && file.startsWith(`${store}.init-`)) ||
+            (phase === "store-config-write" &&
+              method === "writeFileString" &&
+              file.startsWith(`${store}.init-`) &&
+              path.basename(file) === "opencode.gitconfig")
+          if (pause) {
+            gate.paused = true
+            yield* Deferred.succeed(entered, undefined)
+            yield* Deferred.await(resume)
+          }
+          return value
+        })
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              AppProcess.node.replace(
+                Layer.succeed(AppProcess.Service, {
+                  ...backend,
+                  run: (command, options) => {
+                    if (gate.closed) after.push("run")
+                    return backend.run(command, options)
+                  },
+                }),
+              ),
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  exists: (file) => record("exists", file, fs.exists(file)),
+                  stat: (file) => record("stat", file, fs.stat(file)),
+                  ensureDir: (file) => record("ensureDir", file, fs.ensureDir(file)),
+                  readDirectory: (file, options) => record("readDirectory", file, fs.readDirectory(file, options)),
+                  readFile: (file) => record("readFile", file, fs.readFile(file)),
+                  readFileString: (file, options) => record("readFileString", file, fs.readFileString(file, options)),
+                  writeFileString: (file, value, options) =>
+                    record("writeFileString", file, fs.writeFileString(file, value, options)),
+                  copyFile: (from, to) => record("copyFile", to, fs.copyFile(from, to)),
+                  utimes: (file, atime, mtime) => record("utimes", file, fs.utimes(file, atime, mtime)),
+                  rename: (from, to) => record("rename", to, fs.rename(from, to)),
+                  remove: (file, options) => record("remove", file, fs.remove(file, options)),
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const source = yield* git.repo.discover(project)
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const create = git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+      const storePhase = phase.startsWith("store-")
+      const repository = storePhase ? undefined : yield* create
+      const capture = repository
+        ? git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+        : undefined
+      if (phase.startsWith("index-") && capture) yield* capture
+      if (phase.startsWith("config-")) yield* fs.writeFileString(config, stale)
+      const original = phase.startsWith("index-") ? yield* fs.readFile(current) : undefined
+      const task: Effect.Effect<unknown, Git.OperationError> = storePhase
+        ? create
+        : (capture ?? Effect.die("fixture capture missing"))
+      yield* Effect.gen(function* () {
+        gate.armed = true
+        const running = yield* task.pipe(Effect.exit, Effect.forkScoped)
+        yield* Deferred.await(entered)
+        expect(gate.paused).toBe(true)
+        yield* Scope.close(owner, Exit.void)
+        gate.closed = true
+        yield* Deferred.succeed(resume, undefined)
+        const exit = yield* Fiber.join(running)
+        expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        expect(after).toEqual([])
+        expect(cleanup).toHaveLength(1)
+        for (const file of [...created, ...cleanup]) expect(yield* fs.exists(file)).toBe(false)
+        if (original) expect(yield* fs.readFile(current)).toEqual(original)
+        if (phase.startsWith("config-")) expect(yield* fs.readFileString(config)).toBe(stale)
+        if (storePhase) expect(yield* fs.exists(store)).toBe(false)
+        const refused = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+        expect(Exit.isFailure(refused) && Cause.hasInterruptsOnly(refused.cause)).toBe(true)
+      }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+    }),
+  )
+}
diff --git a/packages/core/test/git-pack-authority.test.ts b/packages/core/test/git-pack-authority.test.ts
