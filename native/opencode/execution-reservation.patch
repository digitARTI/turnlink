+    if (!stale || !active) return yield* Effect.die("open observer must admit holds")
+    yield* Scope.close(scope, Exit.void)
+    expect(first.holdUnsafe()).toBeUndefined()
+    yield* stale
+    const blocked = yield* authority.withStable(Effect.die("another queue owns a token")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    yield* active
+    yield* authority.withStable(Effect.void)
+  }),
+)
+
+for (const mutation of ["policy", "grant", "revoke"] as const) {
+  it.live(`${mutation} invalidates native reservations without waiting for their cleanup`, () =>
+    Effect.gen(function* () {
