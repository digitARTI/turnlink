@@ -0,0 +1,355 @@
+import path from "path"
+import { unlink } from "node:fs/promises"
+import { Cause, Deferred, Effect, Exit, Layer, Option, Schema } from "effect"
+import { TestClock } from "effect/testing"
+import { eq, like, or, sql } from "drizzle-orm"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Database } from "@opencode/core/database/database"
+import { KVTable } from "@opencode/core/kv/sql"
+import { Workspace } from "@opencode/core/workspace"
+import { WorkspaceTable } from "@opencode/core/workspace/sql"
+import { WorkspaceDriver } from "@opencode/core/workspace/driver"
+import { makeFiles, makeMemoryDriver } from "@opencode/core/environment/index"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { WorkspaceJournalAck } from "./workspace-journal-report"
+
+const root = process.argv[2]!
+const mode = process.argv[3]!
+const id = Schema.decodeUnknownSync(Workspace.ID)(process.argv[4])
+const resource = path.join(root, "resource")
+const idleCrash = mode === "idle-crash" || mode === "idle-provider-crash"
+const connectCrash = mode === "connect-crash"
+const operations = { connects: 0, idles: 0, destroys: 0 }
+const reassign = Promise.withResolvers<Effect.Effect<void>>()
+const idleEntered = Deferred.makeUnsafe<void>()
+async function pauseProvider() {
+  if (!process.send) throw new Error("fixture IPC is required")
+  process.send({ type: "provider-paused", id, mode })
+  await Bun.stdin.text()
+}
+const driver = WorkspaceDriver.make({
+  create: () =>
+    Effect.promise(async () => {
+      if (
+        mode !== "crash" &&
+        mode !== "destroy-crash" &&
+        !idleCrash &&
+        !connectCrash &&
+        mode !== "connect-metadata-fail" &&
+        mode !== "prepare" &&
+        mode !== "stale-create" &&
+        mode !== "live-create" &&
+        mode !== "stale-connect" &&
+        mode !== "stale-idle"
+      )
+        throw new Error("unexpected create replay")
+      if (mode === "live-create") await pauseProvider()
+      await Bun.write(resource, id)
+      if (mode === "stale-create") await pauseProvider()
+      // Deliberately bypass Effect finalizers after the provider effect, before
+      // core receives a binding. This is a process exit, not a power-loss test.
+      if (mode === "crash") process.exit(73)
+      return { binding: { fixtureReceipt: true } }
+    }),
+  connect: ({ saveBinding }) =>
+    Effect.gen(function* () {
+      operations.connects++
+      if (mode === "stale-connect") {
+        yield* saveBinding({ fixtureReceipt: true, connected: true })
+        yield* Effect.promise(pauseProvider)
+        return makeMemoryDriver()
+      }
+      if (connectCrash) {
+        yield* saveBinding({ fixtureReceipt: true, connected: true })
+        yield* Effect.promise(() => Bun.write(resource, `${id}:connected`))
+        process.exit(76)
+      }
+      if (!idleCrash && mode !== "connect-metadata-fail" && mode !== "stale-idle")
+        return yield* Effect.die("unexpected fixture connection replay")
+      return makeMemoryDriver()
+    }),
+  suspendForIdle: ({ saveBinding }) =>
+    Effect.gen(function* () {
+      operations.idles++
+      if (mode === "stale-idle") {
+        yield* saveBinding({ fixtureReceipt: true, suspended: true })
+        yield* Deferred.succeed(idleEntered, undefined)
+        yield* Effect.promise(pauseProvider)
+        return
+      }
+      if (mode === "connect-metadata-fail") return
+      if (!idleCrash) return yield* Effect.die("unexpected idle transition replay")
+      yield* saveBinding({ fixtureReceipt: true, suspended: true })
+      if (mode === "idle-provider-crash") {
+        yield* yield* Effect.promise(() => reassign.promise)
+      }
+      yield* Effect.promise(() => Bun.write(resource, `${id}:suspended`))
+      process.exit(75)
+    }),
+  destroy: () =>
+    Effect.promise(async () => {
+      operations.destroys++
+      if (await Bun.file(resource).exists()) await unlink(resource)
+      if (mode === "stale-destroy") await pauseProvider()
+      if (mode === "destroy-crash") process.exit(74)
+    }),
+})
+
+await Effect.gen(function* () {
+  const workspace = yield* Workspace.Service
+  const authority = yield* ReservationAuthority.Service
+  const database = yield* Database.Service
+  reassign.resolve(
+    database.db
+      .update(WorkspaceTable)
+      .set({ provider: "other" })
+      .where(eq(WorkspaceTable.id, id))
+      .run()
+      .pipe(Effect.asVoid, Effect.orDie),
+  )
+  // Let the initial empty idle-poll worker complete before probing journal
+  // refusal; its transient startup count is not durable-intent evidence.
+  yield* Effect.yieldNow
+  if (mode === "live-destroy") yield* Effect.promise(pauseProvider)
+  if (mode === "delete-row")
+    yield* database.db.delete(WorkspaceTable).where(eq(WorkspaceTable.id, id)).run().pipe(Effect.orDie)
+  if (mode === "reassign-row")
+    yield* database.db
+      .update(WorkspaceTable)
+      .set({ provider: "other" })
+      .where(eq(WorkspaceTable.id, id))
+      .run()
+      .pipe(Effect.orDie)
+  const state = { provisionRefused: false, readmissionRefused: false, operationFailed: false, replayRefused: false }
+  if (mode === "replace-intent" || mode === "legacy-owner" || mode === "foreign-host") {
+    const observed = yield* database.db
+      .select()
+      .from(KVTable)
+      .where(like(KVTable.key, "workspace-create-intent:v1:%"))
+      .all()
+      .pipe(Effect.orDie)
+    for (const row of observed) {
+      const intent = yield* Schema.decodeUnknownEffect(
+        Schema.Struct({
+          workspaceID: Workspace.ID,
+          provider: Schema.String,
+          owner: Schema.Struct({
+            id: Schema.String,
+            pid: Schema.optional(Schema.Int),
+            host: Schema.optional(Schema.String),
+          }),
+        }),
+      )(row.value).pipe(Effect.orDie)
+      const value =
+        mode === "legacy-owner"
+          ? { workspaceID: intent.workspaceID, provider: intent.provider }
+          : mode === "foreign-host"
+            ? { ...intent, owner: { ...intent.owner, host: `${intent.owner.host}:other` } }
+            : { ...intent, revision: "replacement" }
+      yield* database.db.update(KVTable).set({ value }).where(eq(KVTable.key, row.key)).run().pipe(Effect.orDie)
+    }
+  }
+  if (
+    mode === "crash" ||
+    mode === "destroy-crash" ||
+    idleCrash ||
+    connectCrash ||
+    mode === "connect-metadata-fail" ||
+    mode === "prepare" ||
+    mode === "stale-create" ||
+    mode === "live-create" ||
+    mode === "stale-connect" ||
+    mode === "stale-idle"
+  ) {
+    yield* workspace.create({ id, provider: "fixture" })
+    if (mode !== "stale-create" && mode !== "live-create") yield* workspace.provision(id)
+    if (mode === "stale-create" || mode === "live-create") {
+      state.operationFailed = Exit.isFailure(yield* workspace.provision(id).pipe(Effect.exit))
+      yield* Effect.yieldNow
+    }
+    if (mode === "destroy-crash") yield* workspace.destroy(id)
+    if (mode === "stale-connect" || mode === "stale-idle") {
+      const files = makeFiles(yield* workspace.connect(id))
+      if (mode === "stale-idle") {
+        yield* files.mkdir("/before-idle")
+        yield* TestClock.adjust("2 minutes")
+        yield* Deferred.await(idleEntered)
+      }
+      state.operationFailed = Exit.isFailure(yield* files.mkdir("/identity-race").pipe(Effect.exit))
+      state.readmissionRefused = Exit.isFailure(yield* files.mkdir("/identity-retry").pipe(Effect.exit))
+    }
+    if (connectCrash || mode === "connect-metadata-fail") {
+      const environment = yield* workspace.connect(id)
+      const files = makeFiles(environment)
+      if (mode === "connect-metadata-fail")
+        yield* database.db
+          .run(
+            sql`CREATE TEMP TRIGGER fixture_fail_connect_activity
+        BEFORE UPDATE OF last_used_at ON workspace BEGIN SELECT RAISE(ABORT, 'fixture connect metadata failed'); END`,
+          )
+          .pipe(Effect.orDie)
+      const opened = yield* files.mkdir("/connect").pipe(Effect.exit)
+      if (Exit.isSuccess(opened)) return yield* Effect.die("fixture acquisition failure did not occur")
+      if (mode === "connect-metadata-fail") {
+        yield* database.db.run(sql`DROP TRIGGER fixture_fail_connect_activity`).pipe(Effect.orDie)
+        yield* TestClock.adjust("2 minutes")
+        yield* Effect.yieldNow
+        state.readmissionRefused = Exit.isFailure(yield* files.mkdir("/retry").pipe(Effect.exit))
+      }
+    }
+    if (idleCrash) {
+      const environment = yield* workspace.connect(id)
+      yield* makeFiles(environment).write("/fixture", new Uint8Array([1]))
+      yield* TestClock.adjust("2 minutes")
+      // The real idle worker now owns the fixture transition. It exits the
+      // process after its saved binding/effect; no fixed wall-clock sleep.
+      return yield* Effect.never
+    }
+    if (
+      mode !== "connect-metadata-fail" &&
+      mode !== "prepare" &&
+      mode !== "stale-create" &&
+      mode !== "live-create" &&
+      mode !== "stale-connect" &&
+      mode !== "stale-idle"
+    )
+      return yield* Effect.die("fixture crash did not occur")
+  }
+  if (mode === "cached") {
+    yield* database.db
+      .update(WorkspaceTable)
+      .set({ binding: { fixtureReceipt: true } })
+      .where(eq(WorkspaceTable.id, id))
+      .run()
+      .pipe(Effect.orDie)
+    const provision = yield* workspace.provision(id).pipe(Effect.exit)
+    state.provisionRefused = Exit.isFailure(provision)
+  }
+  if (mode === "orphan")
+    yield* database.db.delete(WorkspaceTable).where(eq(WorkspaceTable.id, id)).run().pipe(Effect.orDie)
+  if (mode === "changed")
+    yield* database.db
+      .update(WorkspaceTable)
+      .set({ provider: "other" })
+      .where(eq(WorkspaceTable.id, id))
+      .run()
+      .pipe(Effect.orDie)
+  const before = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+  const blockedBefore = Exit.isFailure(before) && Cause.hasInterruptsOnly(before.cause)
+  if (mode === "commit-fail")
+    yield* database.db
+      .run(
+        sql`CREATE TEMP TRIGGER fixture_fail_intent_delete
+    BEFORE DELETE ON kv WHEN OLD.key LIKE 'workspace-destroy-intent:v1:%'
+    BEGIN SELECT RAISE(ABORT, 'fixture terminal commit failed'); END`,
+      )
+      .pipe(Effect.orDie)
+  const destroyed =
+    mode === "recover" ||
+    mode === "missing" ||
+    mode === "orphan" ||
+    mode === "changed" ||
+    mode === "commit-fail" ||
+    mode === "stale-destroy" ||
+    mode === "live-destroy" ||
+    mode === "owner-recover"
+      ? yield* workspace.destroy(id).pipe(Effect.exit)
+      : undefined
+  if (mode === "stale-create" || mode === "stale-destroy")
+    state.replayRefused = Exit.isFailure(yield* workspace.destroy(id).pipe(Effect.exit))
+  const after = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+  const rows = yield* database.db
+    .select()
+    .from(WorkspaceTable)
+    .where(eq(WorkspaceTable.id, id))
+    .all()
+    .pipe(Effect.orDie)
+  const intents = yield* database.db
+    .select()
