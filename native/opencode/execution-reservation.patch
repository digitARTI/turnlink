+/** Same clock discipline for conditions owned by Effect services, such as reload fences. */
+export const advanceEffect = <E, R>(condition: Effect.Effect<boolean, E, R>) => Effect.gen(function* () {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    if (yield* condition) return
+    yield* tick
+  }
+  return yield* Effect.die(new Error("effect condition never became true after 100 advances"))
+})
