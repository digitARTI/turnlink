+++ b/packages/core/src/session/movement-fence.ts
@@ -0,0 +1,205 @@
+export * as MovementFence from "./movement-fence.js"
+
+import { eq, isNotNull, like, sql } from "drizzle-orm"
+import { Effect, Schema } from "effect"
+import type { Database } from "../database/database.js"
+import type { Job } from "../job.js"
+import { NativeMovementProtection } from "../database/movement-protection.js"
+import { KVTable } from "../kv/sql.js"
+import { EventSequenceTable, EventTable } from "../event/sql.js"
+import { Location } from "../location.js"
+import { AbsolutePath } from "../schema.js"
+import { SessionSchema } from "./schema.js"
+import { SessionInboxTable, SessionMessageTable, SessionPendingTable, SessionTable } from "./sql.js"
+
+type DB = Database.Interface["db"]
+const prefix = "session-movement-intent:v1:"
+
+export const Intent = Schema.Struct({
+  version: Schema.Literal(1),
+  phase: Schema.Literal("quarantined"),
+  sessionID: SessionSchema.ID,
+  transitionID: Schema.String,
+  pluginID: Schema.String,
+  incarnation: Schema.String,
+  leaseIncarnation: Schema.optional(Schema.String),
+  membershipFence: Schema.optional(Schema.Literal(1)),
+  activation: Schema.String,
+  generation: Schema.Int.check(Schema.isGreaterThan(0)),
+  source: Location.Ref,
+  directory: AbsolutePath,
+})
+export type Intent = typeof Intent.Type
+
+// Recovery only claims the durable quarantine. It is not a resource-release,
+// placement-commit or receiver-continuity receipt.
+export const Recovery = Schema.Struct({
+  version: Schema.Literal(1),
+  sessionID: SessionSchema.ID,
+  transitionID: Schema.String,
+  previousLeaseIncarnation: Schema.String,
+  leaseIncarnation: Schema.String,
+  incarnation: Schema.String,
+  activation: Schema.String,
+  generation: Schema.Int.check(Schema.isGreaterThan(0)),
+})
+export type Recovery = typeof Recovery.Type
+const recoveryPrefix = "session-movement-recovery:v1:"
+const transportReleasePrefix = "session-movement-transport-release:v1:"
+
+export const TransportRelease = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, transitionID: Schema.String,
+  leaseIncarnation: Schema.String, incarnation: Schema.String, activation: Schema.String,
+  generation: Schema.Int.check(Schema.isGreaterThan(0)), family: Schema.Literal("session-model-websocket"),
+  released: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
+})
+export type TransportRelease = typeof TransportRelease.Type
+
+export const findTransportRelease = Effect.fn("MovementFence.findTransportRelease")(function* (db: DB, sessionID: SessionSchema.ID) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, transportReleasePrefix + sessionID)).get().pipe(Effect.orDie)
+  return row === undefined ? undefined : yield* Schema.decodeUnknownEffect(TransportRelease)(row.value).pipe(Effect.orDie)
+})
+
+export const recordTransportRelease = Effect.fn("MovementFence.recordTransportRelease")(function* (
+  db: DB, intent: Intent, released: number,
+) {
+  const value = TransportRelease.make({ version: 1, sessionID: intent.sessionID, transitionID: intent.transitionID,
+    leaseIncarnation: intent.leaseIncarnation!, incarnation: intent.incarnation, activation: intent.activation,
+    generation: intent.generation, family: "session-model-websocket", released })
+  const inserted = yield* db.insert(KVTable).values({ key: transportReleasePrefix + intent.sessionID,
+    value: Schema.encodeSync(TransportRelease)(value) }).onConflictDoNothing().returning({ key: KVTable.key }).get().pipe(Effect.orDie)
+  if (!inserted) {
+    const current = yield* findTransportRelease(db, intent.sessionID)
+    if (!current || JSON.stringify(Schema.encodeSync(TransportRelease)(current)) !== JSON.stringify(Schema.encodeSync(TransportRelease)(value)))
+      return yield* Effect.die("Native transport release record changed")
+  }
+  return value
+})
+
+export const findRecovery = Effect.fn("MovementFence.findRecovery")(function* (db: DB, sessionID: SessionSchema.ID) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, recoveryPrefix + sessionID)).get().pipe(Effect.orDie)
+  return row === undefined ? undefined : yield* Schema.decodeUnknownEffect(Recovery)(row.value).pipe(Effect.orDie)
+})
+
+export const recordRecovery = Effect.fn("MovementFence.recordRecovery")(function* (db: DB, recovery: Recovery) {
+  yield* db.insert(KVTable).values({ key: recoveryPrefix + recovery.sessionID, value: Schema.encodeSync(Recovery)(recovery) })
+    .onConflictDoUpdate({ target: KVTable.key, set: { value: Schema.encodeSync(Recovery)(recovery) } })
+    .run().pipe(Effect.orDie)
+})
+
+export class Quarantined extends Schema.TaggedError<Quarantined>()("SessionMovement.Quarantined", {
+  sessionID: SessionSchema.ID,
+}) {}
+
+export class InvalidOwner extends Schema.TaggedError<InvalidOwner>()("SessionMovement.InvalidOwner", {}) {}
+
+const ownerBrand = Symbol("native movement owner")
+export interface Owner { readonly [ownerBrand]: true }
+const owners = new WeakMap<Owner, { readonly db: DB; readonly intent: Intent; readonly assert: Effect.Effect<void> }>()
+
+/** Internal native factory. Neither its result nor the assertion is an RPC value. */
+export function makeOwner(db: DB, intent: Intent, assert: Effect.Effect<void>): Owner {
+  const owner = Object.freeze({ [ownerBrand]: true as const })
+  owners.set(owner, { db, intent, assert })
+  return owner
+}
+
+export const ownerSession = Effect.fn("MovementFence.ownerSession")(function* (db: DB, owner: Owner) {
+  const native = owners.get(owner)
+  if (!native || native.db !== db) return yield* Effect.die(new InvalidOwner({}))
+  return native.intent.sessionID
+})
+
+export const assertOwner = Effect.fn("MovementFence.assertOwner")(function* (db: DB, owner: Owner) {
+  const native = owners.get(owner)
+  if (!native || native.db !== db) return yield* Effect.die(new InvalidOwner({}))
+  yield* native.assert
+  const current = yield* find(db, native.intent.sessionID)
+  if (!current || JSON.stringify(Schema.encodeSync(Intent)(current)) !== JSON.stringify(Schema.encodeSync(Intent)(native.intent)))
+    return yield* Effect.die(new InvalidOwner({}))
+  yield* native.assert
+})
+
+export const find = Effect.fn("MovementFence.find")(function* (db: DB, sessionID: SessionSchema.ID) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  return row === undefined ? undefined : yield* Schema.decodeUnknownEffect(Intent)(row.value).pipe(Effect.orDie)
+})
+
+/** A quarantined ancestor also holds registered work in its existing descendants. */
+export const blocked = Effect.fn("MovementFence.blocked")(function* (db: DB, sessionID: SessionSchema.ID) {
+  let current: SessionSchema.ID | null | undefined = sessionID
+  const seen = new Set<SessionSchema.ID>()
+  while (current) {
+    if (seen.has(current) || seen.size >= 256) return yield* Effect.die("Invalid or oversized native Session ancestry")
+    seen.add(current)
+    if (yield* find(db, current)) return true
+    const row: { readonly parent: SessionSchema.ID | null } | undefined = yield* db.select({ parent: SessionTable.parent_id }).from(SessionTable)
+      .where(eq(SessionTable.id, current)).get().pipe(Effect.orDie)
+    current = row?.parent
+  }
+  return false
+})
+
+/** Every consumer reads durable state; a new process cannot forget a prior quarantine. */
+export const assertOpen = Effect.fn("MovementFence.assertOpen")(function* (db: DB, sessionID: SessionSchema.ID) {
+  if (yield* blocked(db, sessionID)) return yield* Effect.die(new Quarantined({ sessionID }))
+  yield* NativeMovementProtection.assertAuthorized(db, sessionID)
+})
+
+export const sessions = Effect.fn("MovementFence.sessions")(function* (db: DB) {
+  const rows = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(like(KVTable.key, prefix + "%")).all().pipe(Effect.orDie)
+  return yield* Effect.forEach(rows, (row) => Schema.decodeUnknownEffect(Intent)(row.value).pipe(
+    Effect.orDie, Effect.map((intent) => intent.sessionID),
+  ))
+})
+
+/** Retain descendants and pending child links during native restart accounting. */
+export const expandDescendants = Effect.fn("MovementFence.expandDescendants")(function* (db: DB,
+  roots: Set<SessionSchema.ID>, pending: ReadonlyArray<Job.Background>) {
+  if (roots.size === 0) return roots
+  const rows = yield* db.select({ id: SessionTable.id, parent: SessionTable.parent_id }).from(SessionTable)
+    .where(isNotNull(SessionTable.parent_id)).all().pipe(Effect.orDie)
+  let before: number
+  do {
+    before = roots.size
+    for (const row of rows) if (row.parent && roots.has(row.parent)) roots.add(row.id)
+    for (const job of pending) if (job.recovery.kind === "subagent" && roots.has(job.recovery.parentSessionID))
+      roots.add(job.recovery.childSessionID)
+  } while (roots.size !== before)
+  return roots
+})
+
+/** Insert-only: neither activation disposal nor a failed preparation clears uncertainty. */
+export const insert = Effect.fn("MovementFence.insert")(function* (db: DB, intent: Intent) {
+  // These persistent SQLite triggers also refuse mutation by a runtime that
+  // predates this extension. They do not establish absence of its native I/O.
+  for (const target of [
+    { table: SessionTable, column: "id", name: "session" },
+    { table: SessionInboxTable, column: "session_id", name: "inbox" },
+    { table: SessionPendingTable, column: "session_id", name: "pending" },
+    { table: SessionMessageTable, column: "session_id", name: "message" },
+    { table: EventTable, column: "aggregate_id", name: "event" },
+    { table: EventSequenceTable, column: "aggregate_id", name: "sequence" },
+  ]) {
+    for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+      const references = operation === "INSERT" ? ["NEW"] : operation === "DELETE" ? ["OLD"] : ["OLD", "NEW"]
+      const condition = sql.join(references.map((reference) => sql`
+        EXISTS (SELECT 1 FROM ${KVTable} WHERE ${KVTable.key} = ${prefix} || ${sql.identifier(reference)}.${sql.identifier(target.column)})
+      `.inlineParams()), sql` OR `)
+      yield* db.run(sql`
+        CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_session_movement_v1_${target.name}_${operation.toLowerCase()}`)}
+        BEFORE ${sql.raw(operation)} ON ${target.table}
+        WHEN ${condition}
+        BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_QUARANTINED'); END
+      `).pipe(Effect.orDie)
+    }
+  }
+  return yield* db.insert(KVTable).values({
+    key: prefix + intent.sessionID,
+    value: Schema.encodeSync(Intent)(intent),
+  }).onConflictDoNothing().returning({ key: KVTable.key }).get().pipe(Effect.orDie)
+})
