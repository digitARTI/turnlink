diff --git a/packages/core/src/config/freshness.ts b/packages/core/src/config/freshness.ts
new file mode 100644
index 0000000..fc486a0
--- /dev/null
+++ b/packages/core/src/config/freshness.ts
@@ -0,0 +1,61 @@
+export * as ConfigFreshness from "./freshness.js"
+
+import { createHmac, randomBytes } from "node:crypto"
+import { Effect } from "effect"
+import type { FSUtil } from "@opencode/util/fs-util"
+
+const key = randomBytes(32)
+const maxEntries = 4096
+const maxBytes = 8 * 1024 * 1024
+const seal = (value: string | undefined) => createHmac("sha256", key)
+  .update(value === undefined ? "absent\0" : "present\0" + value).digest("hex")
+
+/** Process-local comparison token; never include it in an external receipt. */
+export const fingerprint = (value: string | undefined) => value !== undefined && Buffer.byteLength(value) > maxBytes ? undefined : seal(value)
+
+/** Records consumed local values without retaining their plaintext or publishing hashes. */
+export function capture() {
+  const files = new Map<string, string>()
+  const environment = new Map<string, string>()
+  const external: Array<() => Effect.Effect<boolean>> = []
+  let valid = true
+  const record = (map: Map<string, string>, name: string, value: string | undefined) => {
+    if (name.length > 4096 || (value !== undefined && Buffer.byteLength(value) > maxBytes) ||
+      (!map.has(name) && files.size + environment.size + external.length >= maxEntries)) { valid = false; return }
+    const observed = seal(value), prior = map.get(name)
+    if (prior !== undefined && prior !== observed) valid = false
+    map.set(name, observed)
+  }
+  return {
+    unavailable: () => { valid = false },
+    file: (path: string, value: string | undefined) => record(files, path, value),
+    env: (name: string, value: string, external: boolean) => {
+      // Values injected by a remote credential provider have no local re-reader.
+      if (external) valid = false
+      else record(environment, name, value)
+    },
+    external: (verify: () => Effect.Effect<boolean>) => {
+      if (files.size + environment.size + external.length >= maxEntries) valid = false
+      else external.push(verify)
+    },
+    verify: (fs: FSUtil.Interface) => Effect.gen(function* () {
+      const envCurrent = () => [...environment].every(([name, value]) => seal(process.env[name] || "") === value)
+      if (!valid || !envCurrent()) { valid = false; return false }
+      for (const check of external) if (!(yield* check())) { valid = false; return false }
+      for (const [path, expected] of files) {
+        const info = yield* fs.stat(path).pipe(Effect.catch(() => Effect.succeed(undefined)))
+        if (info && (info.type !== "File" || Number(info.size) > maxBytes)) { valid = false; return false }
+        const value = yield* fs.readFileStringSafe(path).pipe(
+          Effect.map((text) => ({ ok: true as const, text })),
+          Effect.catch(() => Effect.succeed({ ok: false as const, text: undefined })),
+        )
+        if (!value.ok || (value.text !== undefined && Buffer.byteLength(value.text) > maxBytes) || seal(value.text) !== expected) {
+          valid = false; return false
+        }
+      }
+      if (!envCurrent()) { valid = false; return false }
+      for (const check of external) if (!(yield* check())) { valid = false; return false }
+      return valid
+    }),
+  }
+}
