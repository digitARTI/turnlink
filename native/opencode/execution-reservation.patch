@@ -0,0 +1,50 @@
+export * as AuthorityCopy from "./authority-copy.js"
+
+import { isDeepStrictEqual } from "node:util"
+
+/** Copy authority-bearing data without retaining mutable aliases or silently
+ * changing descriptors. Unsupported values fail before an effect is admitted. */
+export function copy<T>(input: T): T {
+  const seen = new WeakSet<object>()
+  const visit = (value: unknown): void => {
+    if (typeof value !== "object" || value === null || seen.has(value)) return
+    seen.add(value)
+    if (typeof SharedArrayBuffer !== "undefined" &&
+      (value instanceof SharedArrayBuffer || (ArrayBuffer.isView(value) && value.buffer instanceof SharedArrayBuffer)))
+      throw new Error("Authority data cannot share memory")
+    if (!Object.isExtensible(value)) throw new Error("Authority data cannot be copied without loss")
+    if (ArrayBuffer.isView(value) || value instanceof ArrayBuffer) {
+      // Inspect every own key, including symbols and non-enumerable properties.
+      // eslint-disable-next-line no-restricted-globals
+      for (const key of Reflect.ownKeys(value)) {
+        if (value instanceof ArrayBuffer || value instanceof DataView || typeof key !== "string" || !/^(0|[1-9][0-9]*)$/.test(key))
+          throw new Error("Authority data cannot be copied without loss")
+      }
+      return
+    }
+    if (value instanceof Map) {
+      for (const [key, item] of value) { visit(key); visit(item) }
+    }
+    if (value instanceof Set) {
+      for (const item of value) visit(item)
+    }
+    // Inspect every own key so cloning cannot silently discard authority data.
+    // eslint-disable-next-line no-restricted-globals
+    for (const key of Reflect.ownKeys(value)) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, key)
+      if (!descriptor) continue
+      const arrayLength = Array.isArray(value) && key === "length"
+      if (typeof key === "symbol" || !("value" in descriptor) ||
+        (!descriptor.enumerable && !arrayLength) || !descriptor.writable || (!arrayLength && !descriptor.configurable))
+        throw new Error("Authority data cannot be copied without loss")
+      visit(descriptor.value)
+    }
+  }
+  // Inspect the source too: some runtimes omit non-enumerable Error causes
+  // during cloning, even when they contain shared memory.
+  visit(input)
+  const result = structuredClone(input)
+  visit(result)
+  if (!isDeepStrictEqual(input, result)) throw new Error("Authority data cannot be copied without loss")
+  return result
+}
