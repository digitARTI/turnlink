+++ b/packages/core/test/git-rebuild-authority.test.ts
@@ -0,0 +1,237 @@
+import { expect } from "bun:test"
+import { $ } from "bun"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+const denied = (method: string, file: string) =>
+  Effect.fail(
+    systemError({
+      _tag: "PermissionDenied",
+      module: "FileSystem",
+      method,
+      pathOrDescriptor: file,
+      description: "controlled index-rebuild fault",
+    }),
+  )
+
+for (const outcome of [
+  "absent fingerprint",
+  "scan fingerprint failure",
+  "publication fingerprint failure",
+  "rebuild success",
+  "rebuild seed absent",
+  "rebuild observation failure",
+  "rebuild copy failure",
+  "rebuild lost copy receipt",
+  "rebuild publication failure",
+  "rebuild lost publication receipt",
+  "rebuild interruption",
+  "probe observation failure",
+] as const) {
+  it.live(`Git ${outcome} never settles prior uncertainty with fallback success`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const current = path.join(store, "index")
+      const seed = path.join(project, ".git", "index")
+      const corrupt = "controlled corrupt index\n"
+      yield* Effect.promise(async () => {
+        await initRepo(project)
+        await Bun.write(path.join(project, "tracked.txt"), "content\n")
+        await $`git add tracked.txt`.cwd(project).quiet()
+      })
+      const entered = yield* Deferred.make<void>()
+      const resume = yield* Deferred.make<void>()
+      const gate = {
+        armed: false,
+        fingerprints: 0,
+        observations: 0,
+        seeds: 0,
+        copies: 0,
+        publications: 0,
+        deletions: 0,
+      }
+      const prepared: string[] = []
+      const rebuilt: string[] = []
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  stat: (file) => {
+                    if (
+                      gate.armed &&
+                      path.dirname(file) === store &&
+                      path.basename(file).startsWith("index.opencode-")
+                    ) {
+                      gate.fingerprints++
+                      if (
+                        (outcome === "scan fingerprint failure" && gate.fingerprints === 1) ||
+                        (outcome === "publication fingerprint failure" && gate.fingerprints === 2)
+                      )
+                        return denied("stat", file)
+                    }
+                    return fs.stat(file)
+                  },
+                  exists: (file) => {
+                    if (
+                      gate.armed &&
+                      file === current &&
+                      ++gate.observations === 2 &&
+                      outcome === "probe observation failure"
+                    )
+                      return denied("exists", file)
+                    if (gate.armed && file === seed) {
+                      gate.seeds++
+                      if (outcome === "rebuild observation failure") return denied("exists", file)
+                    }
+                    return fs.exists(file)
+                  },
+                  copyFile: (from, to) => {
+                    if (!gate.armed || path.dirname(to) !== store || !path.basename(to).startsWith("index.opencode-"))
+                      return fs.copyFile(from, to)
+                    prepared.push(to)
+                    if (from !== seed) return fs.copyFile(from, to)
+                    gate.copies++
+                    rebuilt.push(to)
+                    return Effect.gen(function* () {
+                      if (outcome === "rebuild copy failure") return yield* denied("copyFile", from)
+                      yield* fs.copyFile(from, to)
+                      if (outcome === "rebuild lost copy receipt") return yield* denied("copyFile", from)
+                      if (outcome === "rebuild interruption") {
+                        yield* Deferred.succeed(entered, undefined)
+                        yield* Deferred.await(resume)
+                      }
+                    })
+                  },
+                  rename: (from, to) => {
+                    if (!gate.armed || to !== current || !rebuilt.includes(from)) return fs.rename(from, to)
+                    gate.publications++
+                    return Effect.gen(function* () {
+                      if (outcome === "rebuild publication failure") return yield* denied("rename", from)
+                      yield* fs.rename(from, to)
+                      if (outcome === "rebuild lost publication receipt") return yield* denied("rename", from)
+                    })
+                  },
+                  remove: (file, options) => {
+                    if (gate.armed && file === current) gate.deletions++
+                    return fs.remove(file, options)
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      const capture = git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      yield* capture
+      const original = yield* fs.readFile(current)
+      const seedBytes = yield* fs.readFile(seed)
+      const rebuilding = outcome.startsWith("rebuild") || outcome === "probe observation failure"
+      if (rebuilding) yield* fs.writeFileString(current, corrupt)
+      if (outcome === "rebuild seed absent") yield* fs.remove(seed)
+      if (outcome === "absent fingerprint") yield* fs.remove(current)
+      expect(yield* refused).toBe(false)
+      yield* Effect.gen(function* () {
+        gate.armed = true
+        const running = yield* capture.pipe(Effect.exit, Effect.forkScoped)
+        const failures = [
+          "rebuild observation failure",
+          "rebuild copy failure",
+          "rebuild lost copy receipt",
+          "rebuild publication failure",
+          "probe observation failure",
+        ]
+        if (outcome === "rebuild interruption") {
+          yield* Deferred.await(entered)
+          expect(yield* refused).toBe(true)
+          const cancelling = yield* Fiber.interrupt(running).pipe(Effect.forkScoped)
+          yield* Effect.yieldNow
+          expect(cancelling.pollUnsafe()).toBeUndefined()
+          yield* Deferred.succeed(resume, undefined)
+          yield* Fiber.join(cancelling)
+          const exit = yield* Fiber.await(running)
+          expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        }
+        if (outcome !== "rebuild interruption") {
+          const result = yield* Fiber.join(running)
+          expect(Exit.isFailure(result)).toBe(failures.includes(outcome))
+          if (Exit.isSuccess(result))
+            expect(
+              yield* Effect.promise(() => $`git --git-dir ${store} show ${`${result.value}:tracked.txt`}`.text()),
+            ).toBe("content\n")
+          if (
+            Exit.isFailure(result) &&
+            [
+              "rebuild observation failure",
+              "rebuild copy failure",
+              "rebuild lost copy receipt",
+              "probe observation failure",
+            ].includes(outcome)
+          ) {
+            expect(Cause.squash(result.cause)).toMatchObject({
+              message:
+                outcome === "probe observation failure"
+                  ? "Failed to observe unreadable index"
+                  : "Failed to prepare rebuilt index",
+            })
+          }
+        }
+        expect(gate.deletions).toBe(outcome === "rebuild seed absent" ? 1 : 0)
+        expect(gate.seeds).toBe(rebuilding && outcome !== "probe observation failure" ? 1 : 0)
+        expect(gate.copies).toBe(
+          rebuilding &&
+            !["probe observation failure", "rebuild seed absent", "rebuild observation failure"].includes(outcome)
+            ? 1
+            : 0,
+        )
+        expect(gate.publications).toBe(
+          ["rebuild success", "rebuild publication failure", "rebuild lost publication receipt"].includes(outcome)
+            ? 1
+            : 0,
+        )
+        if (failures.includes(outcome) || outcome === "rebuild interruption")
+          expect(yield* fs.readFileString(current)).toBe(corrupt)
+        yield* Effect.forEach(prepared, (file) =>
+          Effect.gen(function* () {
+            expect(yield* fs.exists(file)).toBe(false)
+          }),
+        )
+        if (outcome !== "rebuild seed absent") expect(yield* fs.readFile(seed)).toEqual(seedBytes)
+        const uncertain = outcome !== "absent fingerprint"
+        expect(yield* refused).toBe(uncertain)
+        gate.armed = false
+        yield* fs.writeFile(current, original)
+        expect(yield* capture).toBeDefined()
+        expect(yield* refused).toBe(uncertain)
+        yield* Scope.close(owner, Exit.void)
+        expect(yield* refused).toBe(uncertain)
+      }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+    }),
+  )
+}
