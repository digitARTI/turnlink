new file mode 100644
index 0000000..2112361
--- /dev/null
+++ b/packages/core/test/ripgrep-binary-authority.test.ts
@@ -0,0 +1,95 @@
+import { expect } from "bun:test"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { FSUtil } from "@opencode/util/fs-util"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { RipgrepBinary } from "@opencode/core/ripgrep/binary"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(AppNodeBuilder.build(FSUtil.node))
+
+for (const outcome of ["success", "failure", "owner close"] as const) {
+  it.effect(`ripgrep binary shared acquisition retains its own worker through ${outcome}`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const owner = yield* Scope.make()
+      let reads = 0
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const layer = AppNodeBuilder.build(LayerNode.group([RipgrepBinary.node, ReservationAuthority.node]), [
+        FSUtil.node.replace(
+          Layer.succeed(FSUtil.Service, {
+            ...fs,
+            // Controlled source metadata avoids any download, install or network
+            // claim. It models native I/O that cannot finish on caller cancellation.
+            isFile: () =>
+              Effect.gen(function* () {
+                reads++
+                yield* Deferred.succeed(entered, undefined)
+                yield* Deferred.await(release)
+                if (outcome === "failure") return yield* Effect.die("fixture binary discovery failed")
+                return true
+              }).pipe(Effect.uninterruptible),
+          }),
+        ),
+      ])
+      const context = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(owner))
+      const binary = Context.get(context, RipgrepBinary.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      yield* Effect.gen(function* () {
+        expect(yield* refused).toBe(false)
+        const ready = yield* Deferred.make<void>()
+        const held = yield* authority
+          .withStable(Deferred.succeed(ready, undefined).pipe(Effect.andThen(Effect.never)))
+          .pipe(Effect.exit, Effect.forkScoped)
+        yield* Deferred.await(ready)
+        const first = yield* binary.filepath.pipe(Effect.exit, Effect.forkScoped)
+        yield* Deferred.await(entered)
+        expect(yield* refused).toBe(true)
+        const invalidated = yield* Fiber.join(held)
+        expect(Exit.isFailure(invalidated) && Cause.hasInterruptsOnly(invalidated.cause)).toBe(true)
+        const cancelling = yield* Fiber.interrupt(first).pipe(Effect.forkScoped)
+        for (const _ of Array.from({ length: 10 })) yield* Effect.yieldNow
+        const second = yield* binary.filepath.pipe(Effect.exit, Effect.forkScoped)
+        for (const _ of Array.from({ length: 10 })) yield* Effect.yieldNow
+        expect(reads).toBe(1)
+        expect(cancelling.pollUnsafe()).toBeDefined()
+        expect(second.pollUnsafe()).toBeUndefined()
+        expect(yield* refused).toBe(true)
+        const closing =
+          outcome === "owner close" ? yield* Scope.close(owner, Exit.void).pipe(Effect.forkScoped) : undefined
+        yield* Effect.yieldNow
+        if (closing) expect(closing.pollUnsafe()).toBeUndefined()
+        yield* Deferred.succeed(release, undefined)
+        expect(Exit.isSuccess(yield* Fiber.join(second))).toBe(outcome === "success")
+        yield* Fiber.join(cancelling)
+        if (closing) yield* Fiber.join(closing)
+        expect(yield* refused).toBe(outcome !== "success")
+        const cached = yield* binary.filepath.pipe(Effect.exit)
+        expect(Exit.isSuccess(cached)).toBe(outcome === "success")
+        expect(reads).toBe(1)
+        expect(yield* refused).toBe(outcome !== "success")
+        if (outcome === "success") {
+          const cachedReady = yield* Deferred.make<void>()
+          const guard = yield* authority
+            .withStable(Deferred.succeed(cachedReady, undefined).pipe(Effect.andThen(Effect.never)))
+            .pipe(Effect.exit, Effect.forkScoped)
+          yield* Deferred.await(cachedReady)
+          expect(yield* binary.filepath).toBe(Exit.isSuccess(cached) ? cached.value : "unreachable")
+          expect(guard.pollUnsafe()).toBeUndefined()
+          yield* Fiber.interrupt(guard)
+        }
+        yield* Scope.close(owner, Exit.void)
+        const stale = yield* binary.filepath.pipe(Effect.exit)
+        expect(Exit.isFailure(stale) && Cause.hasInterruptsOnly(stale.cause)).toBe(true)
+        expect(yield* refused).toBe(outcome !== "success")
+      }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+    }),
+  )
+}
