+import { expect, test } from "bun:test"
+import { Workspace } from "@opencode/core/workspace"
+import { makeWorkspaceJournalIPC } from "./fixture/workspace-journal-report"
+
+const id = Workspace.ID.create()
+const mode = "fixture"
+const report = {
+  blockedBefore: true,
+  blockedAfter: true,
+  hasRow: true,
+  hasBinding: false,
+  suspendedBinding: false,
+  connectedBinding: false,
+  intents: 1,
+  resource: true,
+  failed: false,
+  provisionRefused: false,
+}
+const message = { type: "workspace-journal-report", id, mode, report }
+
+test("typed Workspace fixture report is bound to one invocation and acknowledged once", () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode })
+  expect(ipc.receive(message)).toEqual({ type: "workspace-journal-ack", id, mode })
+  expect(ipc.report()).toEqual(report)
+  expect(ipc.failed).toBe(false)
+})
+
+test("absent IPC evidence cannot become a healthy default", () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode })
+  expect(() => ipc.report()).toThrow("missing report")
+})
+
+for (const [label, invalid] of [
+  ["malformed", {}],
+  ["wrong identity", { ...message, id: Workspace.ID.create() }],
+  ["wrong mode", { ...message, mode: "other" }],
+  ["extra report data", { ...message, report: { ...report, unexpected: "fixture" } }],
+  ["wrong phase", { type: "workspace-journal-ack", id, mode }],
+  ["missing report fields", { ...message, report: { blockedAfter: false } }],
+] as const) {
+  test(`Workspace fixture rejects ${label} without acknowledging or adopting it`, () => {
+    const ipc = makeWorkspaceJournalIPC({ id, mode })
+    expect(ipc.receive(invalid)).toBeUndefined()
+    expect(ipc.failed).toBe(true)
+    expect(() => ipc.report()).toThrow("fixture IPC")
+    expect(ipc.receive(message)).toBeUndefined()
+    expect(() => ipc.report()).toThrow("fixture IPC")
+  })
+}
+
+test("duplicate report quarantines even previously accepted fixture evidence", () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode })
+  expect(ipc.receive(message)).toBeDefined()
+  expect(ipc.receive({ ...message, report: { ...report, blockedAfter: false } })).toBeUndefined()
+  expect(() => ipc.report()).toThrow("unexpected report")
+})
+
+test("paused fixture requires exactly one bound pause before reporting", async () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode, paused: true })
+  expect(ipc.receive({ type: "provider-paused", id, mode })).toBeUndefined()
+  await ipc.ready
+  expect(ipc.receive(message)).toBeDefined()
+  expect(ipc.report()).toEqual(report)
+  expect(ipc.receive({ type: "provider-paused", id, mode })).toBeUndefined()
+  expect(() => ipc.report()).toThrow("unexpected pause")
+})
+
+test("report before provider pause fails the waiting fixture instead of hanging", async () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode, paused: true })
+  const waiting = ipc.ready.catch((error: unknown) => error)
+  expect(ipc.receive(message)).toBeUndefined()
+  expect(await waiting).toBeInstanceOf(Error)
+  expect(() => ipc.report()).toThrow("unexpected report")
+})
+
+test("unexpected pause in a nonpaused fixture is not evidence", () => {
+  const ipc = makeWorkspaceJournalIPC({ id, mode })
+  expect(ipc.receive({ type: "provider-paused", id, mode })).toBeUndefined()
+  expect(() => ipc.report()).toThrow("unexpected pause")
+})
