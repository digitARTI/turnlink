+export * as SessionMembershipArchive from "./membership-archive.js"
+
+import { createHash } from "node:crypto"
+import { eq } from "drizzle-orm"
+import { Effect, Schema } from "effect"
+import type { Database } from "../database/database.js"
+import { KVTable } from "../kv/sql.js"
+import { Location } from "@opencode/schema/location"
+import { AbsolutePath } from "../schema.js"
+import { SessionSchema } from "./schema.js"
+import { pluginStorageNamespace } from "../plugin/storage-namespace.js"
+
+export const prefix = "native-membership-archive:v1:"
+export const scopedPrefix = "native-membership-archive:v2:"
+const keyPart = (value: string) => {
+  const bytes = Buffer.from(value, "utf8")
+  if (bytes.toString("utf8") !== value) throw new Error("Invalid native membership archive identity")
+  return bytes.toString("hex")
+}
+const canScope = (sessionID: SessionSchema.ID, transitionID: string) =>
+  Buffer.from(sessionID, "utf8").toString("utf8") === sessionID && Buffer.from(transitionID, "utf8").toString("utf8") === transitionID
+export const scopedKey = (sessionID: SessionSchema.ID, transitionID: string) =>
+  scopedPrefix + keyPart(sessionID) + ":" + keyPart(transitionID)
+export const Record = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, transitionID: Schema.String, pluginID: Schema.String,
+  namespace: Schema.String, source: Location.Ref, destination: AbsolutePath, leaseIncarnation: Schema.String,
+  nonce: Schema.String, valueDigest: Schema.String, value: Schema.Json, binding: Schema.String,
+})
+export type Record = typeof Record.Type
+export const digest = (value: Schema.Json) => createHash("sha256").update(JSON.stringify(value)).digest("hex")
+export const binding = (value: Omit<Record, "binding" | "value">) => JSON.stringify(value)
+
+// Destination preparation is inert: the ordinary plugin membership key stays
+// absent until an eventual placement commit consumes this exact staged value.
+export const destinationPrefix = "native-membership-destination:v1:"
+export const scopedDestinationPrefix = "native-membership-destination:v2:"
+export const scopedDestinationKey = (sessionID: SessionSchema.ID, transitionID: string) =>
+  scopedDestinationPrefix + keyPart(sessionID) + ":" + keyPart(transitionID)
+export const Destination = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, transitionID: Schema.String, pluginID: Schema.String,
+  namespace: Schema.String, source: Location.Ref, destination: AbsolutePath, leaseIncarnation: Schema.String,
+  archiveNonce: Schema.String, archiveDigest: Schema.String, receiverHash: Schema.String, nonce: Schema.String,
+  valueDigest: Schema.String, value: Schema.Json, binding: Schema.String,
+})
+export type Destination = typeof Destination.Type
+export const destinationBinding = (value: Omit<Destination, "binding" | "value">) => JSON.stringify(value)
+
+export const findDestination = Effect.fn("SessionMembershipArchive.findDestination")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string) {
+  const scoped = canScope(sessionID, transitionID) ? yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, scopedDestinationKey(sessionID, transitionID))).get().pipe(Effect.orDie) : undefined
+  const legacy = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, destinationPrefix + sessionID)).get().pipe(Effect.orDie)
+  const row = scoped ?? legacy
+  if (!row) return
+  const record = yield* Schema.decodeUnknownEffect(Destination)(row.value).pipe(Effect.orDie)
+  const { binding: observed, value, ...input } = record
+  if (record.sessionID !== sessionID || record.namespace !== pluginStorageNamespace(record.pluginID) ||
+    record.valueDigest !== digest(value) || !/^[a-f0-9]{64}$/.test(record.receiverHash) || observed !== destinationBinding(input))
+    return yield* Effect.die("Invalid native destination membership")
+  if (record.transitionID !== transitionID) {
+    if (scoped) return yield* Effect.die("Invalid scoped destination identity")
+    return
+  }
+  if (scoped && legacy && (yield* Schema.decodeUnknownEffect(Destination)(legacy.value).pipe(Effect.orDie)).transitionID === transitionID)
+    return yield* Effect.die("Duplicate native destination membership")
+  return record
+})
+
+export const find = Effect.fn("SessionMembershipArchive.find")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string) {
+  const scoped = canScope(sessionID, transitionID) ? yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, scopedKey(sessionID, transitionID))).get().pipe(Effect.orDie) : undefined
+  const legacy = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  const row = scoped ?? legacy
+  if (!row) return
+  const record = yield* Schema.decodeUnknownEffect(Record)(row.value).pipe(Effect.orDie)
+  const { binding: observed, value, ...input } = record
+  if (record.sessionID !== sessionID || record.namespace !== pluginStorageNamespace(record.pluginID) ||
+    record.valueDigest !== digest(value) || observed !== binding(input)) return yield* Effect.die("Invalid native membership archive")
+  if (record.transitionID !== transitionID) {
+    if (scoped) return yield* Effect.die("Invalid scoped archive identity")
+    return
+  }
+  if (scoped && legacy && (yield* Schema.decodeUnknownEffect(Record)(legacy.value).pipe(Effect.orDie)).transitionID === transitionID)
+    return yield* Effect.die("Duplicate native membership archive")
+  return record
+})
+
+// Keep the first legacy key stable; later transitions get independent records.
+export const archiveInsertKey = Effect.fn("SessionMembershipArchive.archiveInsertKey")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string) {
+  const legacy = yield* db.select({ key: KVTable.key }).from(KVTable).where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  return legacy ? scopedKey(sessionID, transitionID) : prefix + sessionID
+})
+export const destinationInsertKey = Effect.fn("SessionMembershipArchive.destinationInsertKey")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string) {
+  const legacy = yield* db.select({ key: KVTable.key }).from(KVTable).where(eq(KVTable.key, destinationPrefix + sessionID)).get().pipe(Effect.orDie)
+  return legacy ? scopedDestinationKey(sessionID, transitionID) : destinationPrefix + sessionID
+})
