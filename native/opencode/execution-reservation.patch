+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      expect(yield* refused).toBe(false)
+      if (outcome === "receipt commit failure")
+        yield* database.db
+          .run(
+            sql`CREATE TEMP TRIGGER fixture_receipt_failure
+        BEFORE INSERT ON kv WHEN NEW.key LIKE 'ripgrep-install-receipt:v1:%'
+        BEGIN SELECT RAISE(ABORT, 'fixture completion receipt failed'); END`,
+          )
+          .pipe(Effect.orDie)
+      const peers: Array<{
+        binary: typeof binary
+        authority: typeof authority
+        database: typeof database
+        scope: Scope.Closeable
+      }> = []
+      const peerGraph = Effect.gen(function* () {
+        const scope = yield* Scope.make()
+        yield* Effect.addFinalizer(() => Scope.close(scope, Exit.void))
+        const peer = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(scope))
+        return {
+          binary: Context.get(peer, RipgrepBinary.Service),
+          authority: Context.get(peer, ReservationAuthority.Service),
+          database: Context.get(peer, Database.Service),
+          scope,
+        }
+      })
+      if (outcome === "competing owner") peers.push(yield* peerGraph)
+      const running = yield* binary.filepath.pipe(Effect.exit, Effect.forkScoped)
+      if (
+        outcome === "competing owner" ||
+        outcome === "receipt replacement" ||
+        outcome === "completion witness replacement"
+      ) {
+        yield* Deferred.await(entered)
+        if (outcome !== "competing owner") peers.push(yield* peerGraph)
+        const peer = peers[0]!
+        if (outcome === "competing owner") {
+          // This peer booted before the intent existed. Successful-looking
+          // target bytes must not bypass its fresh durable-intent check.
+          yield* fs.writeWithDirs(target, payload)
+        }
+        expect(Exit.isFailure(yield* peer.binary.filepath.pipe(Effect.exit))).toBe(true)
+        const admission = yield* peer.authority.withStable(Effect.void).pipe(Effect.exit)
+        expect(Exit.isFailure(admission) && Cause.hasInterruptsOnly(admission.cause)).toBe(true)
+        expect(downloads).toHaveLength(1)
+        expect(extractions).toHaveLength(0)
+        if (outcome === "receipt replacement" || outcome === "completion witness replacement") {
+          const rows = yield* peer.database.db
+            .select()
+            .from(KVTable)
+            .where(like(KVTable.key, "ripgrep-install-intent:v1:%"))
+            .all()
+            .pipe(Effect.orDie)
+          expect(rows).toHaveLength(1)
+          const receipt = yield* Schema.decodeUnknownEffect(Schema.Record(Schema.String, Schema.Json))(
+            rows[0]!.value,
+          ).pipe(Effect.orDie)
+          const value = { ...receipt, revision: "replacement" }
+          if (outcome === "receipt replacement") {
+            replacements.push(JSON.stringify(value))
+            yield* peer.database.db
+              .update(KVTable)
+              .set({ value })
+              .where(eq(KVTable.key, rows[0]!.key))
+              .run()
+              .pipe(Effect.orDie)
+          }
+          if (outcome === "completion witness replacement") {
+            witnessReplacements.push(JSON.stringify(value))
+            yield* peer.database.db
+              .insert(KVTable)
+              .values({ key: rows[0]!.key.replace("ripgrep-install-intent:v1:", "ripgrep-install-receipt:v1:"), value })
+              .run()
+              .pipe(Effect.orDie)
+          }
+        }
+        yield* Deferred.succeed(resume, undefined)
+      }
+      const result = yield* Fiber.join(running)
+      const installed = clean || outcome === "archive cleanup failure"
+      const targetPresent =
+        installed ||
+        outcome === "copy receipt failure" ||
+        outcome === "chmod failure" ||
+        outcome === "receipt replacement" ||
+        outcome === "receipt commit failure" ||
+        outcome === "completion witness replacement"
+      expect(Exit.isSuccess(result)).toBe(installed)
+      if (outcome === "receipt replacement" || outcome === "completion witness replacement")
+        expect(Exit.isFailure(result) && Cause.hasFails(result.cause)).toBe(true)
+      expect(yield* fs.isFile(target)).toBe(targetPresent)
+      if (targetPresent) expect(yield* fs.readFileString(target)).toBe(payload)
+      expect(yield* refused).toBe(!clean)
+      expect(downloads).toHaveLength(1)
+      expect(responses).toEqual([outcome])
+      const intents = yield* database.db
+        .select()
+        .from(KVTable)
+        .where(like(KVTable.key, "ripgrep-install-intent:v1:%"))
+        .all()
+        .pipe(Effect.orDie)
+      expect(intents).toHaveLength(clean ? 0 : 1)
+      const receipts = yield* database.db
+        .select()
+        .from(KVTable)
+        .where(like(KVTable.key, "ripgrep-install-receipt:v1:%"))
+        .all()
+        .pipe(Effect.orDie)
+      expect(receipts).toHaveLength(clean || outcome === "completion witness replacement" ? 1 : 0)
+      if (outcome === "receipt replacement") expect(JSON.stringify(intents[0]!.value)).toBe(replacements[0])
+      if (outcome === "completion witness replacement")
+        expect(JSON.stringify(receipts[0]!.value)).toBe(witnessReplacements[0])
+      for (const peer of peers) {
+        expect(Exit.isFailure(yield* peer.binary.filepath.pipe(Effect.exit))).toBe(true)
+        const admission = yield* peer.authority.withStable(Effect.void).pipe(Effect.exit)
+        expect(Exit.isFailure(admission) && Cause.hasInterruptsOnly(admission.cause)).toBe(true)
+        yield* Scope.close(peer.scope, Exit.void)
+      }
+      expect(archives).toHaveLength(1)
+      const expectedExtractions = outcome === "empty download" || outcome === "archive write failure" ? 0 : 1
+      expect(extractions).toHaveLength(expectedExtractions)
+      expect(
+        (yield* fs.readDirectory(bin)).filter((name) => name.startsWith("ripgrep-") && !name.endsWith(".tar.gz")),
+      ).toEqual([])
+      expect(yield* fs.isFile(archives[0]!)).toBe(
+        [
+          "extraction failure",
+          "copy failure",
+          "copy receipt failure",
+          "chmod failure",
+          "archive cleanup failure",
+        ].includes(outcome),
+      )
+      if (outcome === "archive cleanup failure") {
+        // Artifact absence from an unrelated cleanup is not this owner's receipt.
+        yield* fs.remove(archives[0]!)
+        expect(yield* refused).toBe(true)
+      }
+      if (!targetPresent) {
+        // A later writer can make target metadata/bytes look successful. That
+        // does not reconcile this owner's failed attempt or justify replay.
+        yield* fs.writeWithDirs(target, payload)
+        expect(yield* fs.isFile(target)).toBe(true)
+        expect(yield* refused).toBe(true)
+      }
+      const cached = yield* binary.filepath.pipe(Effect.exit)
+      expect(Exit.isSuccess(cached)).toBe(installed)
+      expect(downloads).toHaveLength(1)
+      expect(extractions).toHaveLength(expectedExtractions)
+      expect(yield* refused).toBe(!clean)
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(!clean)
+      const stale = yield* binary.filepath.pipe(Effect.exit)
+      expect(Exit.isFailure(stale) && Cause.hasInterruptsOnly(stale.cause)).toBe(true)
+      const reopenedOwner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(reopenedOwner, Exit.void))
+      const reopened = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(reopenedOwner))
+      const restored = Context.get(reopened, RipgrepBinary.Service)
+      const restoredAuthority = Context.get(reopened, ReservationAuthority.Service)
+      const restoredDatabase = Context.get(reopened, Database.Service)
+      expect(restoredDatabase).not.toBe(database)
+      const restoredRefusal = restoredAuthority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      // Refusal must be reconstructed before filepath admission, even though
+      // every target now has successful-looking metadata and fixture bytes.
+      expect(yield* restoredRefusal).toBe(!clean)
+      expect(Exit.isSuccess(yield* restored.filepath.pipe(Effect.exit))).toBe(clean)
+      expect(yield* restoredRefusal).toBe(!clean)
+      expect(
+        yield* restoredDatabase.db
+          .select()
+          .from(KVTable)
+          .where(like(KVTable.key, "ripgrep-install-intent:v1:%"))
+          .all()
+          .pipe(Effect.orDie),
+      ).toHaveLength(clean ? 0 : 1)
+      expect(downloads).toHaveLength(1)
+      expect(extractions).toHaveLength(expectedExtractions)
+      expect(yield* refused).toBe(!clean)
+    }),
+  )
+}
diff --git a/packages/core/test/ripgrep-install-journal.test.ts b/packages/core/test/ripgrep-install-journal.test.ts
new file mode 100644
index 0000000..602a51a
--- /dev/null
+++ b/packages/core/test/ripgrep-install-journal.test.ts
@@ -0,0 +1,156 @@
+import { expect } from "bun:test"
+import { Effect, Schema } from "effect"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { it } from "./lib/effect"
+
+const fixture = `${import.meta.dir}/fixture/ripgrep-install-journal.ts`
+const child = (root: string, mode: string) =>
+  Effect.acquireUseRelease(
+    Effect.sync(() => Bun.spawn([process.execPath, "run", fixture, root, mode], { stdout: "pipe", stderr: "pipe" })),
+    (process) =>
+      Effect.promise(async () => {
+        const [code, stdout, stderr] = await Promise.all([
+          process.exited,
+          new Response(process.stdout).text(),
+          new Response(process.stderr).text(),
+        ])
+        return { code, stdout, stderr }
+      }),
+    (process) =>
+      Effect.promise(async () => {
+        if (process.exitCode !== null) return
+        process.kill()
+        await process.exited
+      }),
+  )
+const paused = Effect.fnUntraced(function* (root: string) {
+  const readyMessage = Schema.is(Schema.Struct({ type: Schema.Literals(["target-absent"]) }))
+  const worker = yield* Effect.acquireRelease(
+    Effect.sync(() => {
+      const ready = Promise.withResolvers<void>()
+      const subprocess = Bun.spawn([process.execPath, "run", fixture, root, "race"], {
+        stdin: "pipe",
+        stdout: "pipe",
+        stderr: "pipe",
+        ipc: (message) => (readyMessage(message) ? ready.resolve() : ready.reject(new Error("invalid fixture IPC"))),
+      })
+      void subprocess.exited.then((code) => ready.reject(new Error(`fixture exited before source pause: ${code}`)))
+      const output = Promise.all([
+        subprocess.exited,
+        new Response(subprocess.stdout).text(),
+        new Response(subprocess.stderr).text(),
+      ])
+      return { subprocess, ready: ready.promise, output }
+    }),
+    (worker) =>
+      Effect.promise(async () => {
+        if (worker.subprocess.exitCode !== null) return
+        worker.subprocess.kill()
+        await worker.subprocess.exited
+      }),
+  )
+  yield* Effect.promise(() => worker.ready)
+  return worker
+})
+const decode = Schema.decodeUnknownSync(
+  Schema.fromJsonString(
+    Schema.Struct({
+      blockedBefore: Schema.Boolean,
+      blockedAfter: Schema.Boolean,
+      failed: Schema.Boolean,
+      typedFailure: Schema.Boolean,
+      downloads: Schema.Number,
+      extractions: Schema.Number,
+      intents: Schema.Number,
+      receipts: Schema.Number,
+      target: Schema.Boolean,
+      archive: Schema.Boolean,
+      temporary: Schema.Number,
+    }),
+  ),
+)
+const report = (stdout: string) => {
+  const lines = stdout.split("\n").filter((line) => line.startsWith('{"blockedBefore":'))
+  expect(lines).toHaveLength(1)
+  return decode(lines[0]!)
+}
+// This fixture uses real local tar.gz extraction. Windows zip/bsdtar remains a
+// separate native acceptance gate, not simulated by the POSIX archive fixture.
+const nativeTest =
+  ["darwin", "linux"].includes(process.platform) && ["arm64", "x64"].includes(process.arch) ? it.live : it.live.skip
+for (const [mode, code] of [
+  ["archive-crash", 81],
+  ["copy-crash", 82],
+  ["chmod-crash", 83],
+  ["cleanup-crash", 84],
+] as const) {
+  nativeTest(`${mode} preserves installer refusal after abrupt native process exit`, () =>
+    Effect.gen(function* () {
+      const tmp = yield* tmpdirScoped()
+      const crashed = yield* child(tmp.path, mode)
+      expect(crashed.stderr).toBe("")
+      expect(crashed.code).toBe(code)
+      for (const _ of [0, 1]) {
+        const inspected = yield* child(tmp.path, "inspect")
+        expect(inspected.stderr).toBe("")
+        expect(inspected.code).toBe(0)
+        expect(report(inspected.stdout)).toMatchObject({
+          blockedBefore: true,
+          blockedAfter: true,
+          failed: true,
+          downloads: 0,
+          extractions: 0,
+          intents: 1,
+          receipts: 0,
+          target: mode !== "archive-crash",
+          archive: mode !== "cleanup-crash",
+          temporary: mode === "copy-crash" || mode === "chmod-crash" ? 1 : 0,
+        })
+      }
+    }),
+  )
+}
+for (const order of ["simultaneous", "winner finishes first"] as const) {
+  nativeTest(`installer claim excludes ${order} stale absent-target plans across processes`, () =>
+    Effect.gen(function* () {
+      const tmp = yield* tmpdirScoped()
+      const initialized = yield* child(tmp.path, "prepare")
+      expect(initialized.stderr).toBe("")
+      expect(initialized.code).toBe(0)
+      const first = yield* paused(tmp.path)
+      const second = yield* paused(tmp.path)
+      yield* Effect.promise(async () => {
+        await first.subprocess.stdin.end()
+      })
+      if (order === "winner finishes first") yield* Effect.promise(() => first.output)
+      yield* Effect.promise(async () => {
+        await second.subprocess.stdin.end()
+      })
+      const [a, b] = yield* Effect.promise(() => Promise.all([first.output, second.output]))
+      expect(a[2]).toBe("")
+      expect(b[2]).toBe("")
+      expect(a[0]).toBe(0)
+      expect(b[0]).toBe(0)
+      const results = [report(a[1]), report(b[1])]
+      expect(results.reduce((sum, result) => sum + result.downloads, 0)).toBe(1)
+      expect(results.reduce((sum, result) => sum + result.extractions, 0)).toBe(1)
+      expect(results.filter((result) => !result.failed)).toHaveLength(1)
+      if (order === "winner finishes first") expect(results.find((result) => result.failed)?.typedFailure).toBe(true)
+      const inspected = yield* child(tmp.path, "inspect")
+      expect(inspected.stderr).toBe("")
+      expect(inspected.code).toBe(0)
+      expect(report(inspected.stdout)).toMatchObject({
+        blockedBefore: false,
+        blockedAfter: false,
+        failed: false,
+        downloads: 0,
+        extractions: 0,
+        intents: 0,
+        receipts: 1,
+        target: true,
+        archive: false,
+        temporary: 0,
+      })
+    }),
+  )
+}
diff --git a/packages/core/test/session-authority-events.test.ts b/packages/core/test/session-authority-events.test.ts
new file mode 100644
index 0000000..183771d
--- /dev/null
+++ b/packages/core/test/session-authority-events.test.ts
@@ -0,0 +1,181 @@
+import { expect } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Scope } from "effect"
+import { TestClock } from "effect/testing"
+import { Bus } from "@opencode/core/bus"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { AbsolutePath } from "@opencode/core/schema"
+import { AuthorityEvents } from "@opencode/core/session/authority-events"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { Event } from "@opencode/schema/config"
+import { Workspace } from "@opencode/schema/workspace"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { testEffect } from "./lib/effect"
+import { advanceEffect } from "./lib/clock"
+
+const it = testEffect(AppNodeBuilder.build(LayerNode.group([Bus.node, ReservationAuthority.node])))
+const location = { directory: AbsolutePath.make("/authority-event-fixture") }
+
+it.effect("debounced authority consumers fence publication immediately, before reload dispatch", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const counts = { reloads: 0 }
+    const notify = yield* AuthorityEvents.observe([Event.Updated.type],
+      Effect.sync(() => { counts.reloads++ }), location, 100)
+    yield* bus.publish(Event.Updated, {}, { location })
+    expect(counts.reloads).toBe(0)
+    const blocked = yield* authority.withStable(Effect.die("debounce is pending")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    yield* notify
+    expect(counts.reloads).toBe(0)
+    yield* TestClock.adjust("100 millis")
+    yield* advanceEffect(Effect.sync(() => counts.reloads === 1))
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+  }),
+)
+
+it.effect("authority event publication fences consumers without waiting for reload or reservation cleanup", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const reloading = yield* Deferred.make<void>()
+    const releaseReload = yield* Deferred.make<void>()
+    const cleaning = yield* Deferred.make<void>()
+    const releaseCleanup = yield* Deferred.make<void>()
+    yield* Effect.addFinalizer(() => Deferred.succeed(releaseReload, undefined)
+      .pipe(Effect.andThen(Deferred.succeed(releaseCleanup, undefined))))
+    yield* AuthorityEvents.observe([Event.Updated.type], Deferred.succeed(reloading, undefined)
+      .pipe(Effect.andThen(Deferred.await(releaseReload))), location)
+    const entered = yield* Deferred.make<void>()
+    const reserved = yield* authority.withStable(Deferred.succeed(entered, undefined).pipe(
+      Effect.andThen(Effect.never),
+      Effect.onInterrupt(() => Deferred.succeed(cleaning, undefined)
+        .pipe(Effect.andThen(Deferred.await(releaseCleanup)))),
+    )).pipe(Effect.exit, Effect.forkScoped)
+    yield* Deferred.await(entered)
+    yield* bus.publish(Event.Updated, {}, { location })
+    // Publication returned while neither consumer I/O nor old-owner cleanup can finish.
+    const blocked = yield* authority.withStable(Effect.die("consumer is pending")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    yield* Deferred.await(reloading)
+    yield* Deferred.await(cleaning)
+    expect(reserved.pollUnsafe()).toBeUndefined()
+    yield* Deferred.succeed(releaseReload, undefined)
+    yield* Deferred.succeed(releaseCleanup, undefined)
+    const exit = yield* Fiber.join(reserved)
+    expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+  }),
+)
+
+it.effect("authority consumers match exact Location and workspace, plus global publication", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const counts = { reloads: 0 }
+    const scoped = { ...location, workspaceID: Workspace.ID.make("wrk_authority_events") }
+    yield* AuthorityEvents.observe([Event.Updated.type], Effect.sync(() => { counts.reloads++ }), scoped)
+    const revision = yield* authority.revision
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* bus.publish(Event.Updated, {}, { location: { ...scoped, directory: AbsolutePath.make("/other") } })
+    yield* bus.publish(Event.Updated, {}, { location: { ...scoped, workspaceID: Workspace.ID.make("wrk_other") } })
+    expect(yield* authority.revision).toBe(revision)
+    expect(counts.reloads).toBe(0)
+    yield* bus.publish(Event.Updated, {}, { location: scoped })
+    yield* advanceEffect(Effect.sync(() => counts.reloads === 1))
+    yield* bus.publish(Event.Updated, {}, { global: true })
+    yield* advanceEffect(Effect.sync(() => counts.reloads === 2))
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+  }),
+)
+
+it.effect("failed authority consumers keep their handoff fenced until a later successful reload", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const counts = { failed: false, succeed: false, done: false }
+    yield* AuthorityEvents.observe([Event.Updated.type], Effect.suspend(() => {
+      if (!counts.succeed) {
+        counts.failed = true
+        return Effect.die("fixture consumer failure")
+      }
+      counts.done = true
+      return Effect.void
+    }), location)
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* advanceEffect(Effect.sync(() => counts.failed))
+    const blocked = yield* authority.withStable(Effect.die("failed consumer stays pending")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    counts.succeed = true
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* advanceEffect(Effect.sync(() => counts.done))
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+  }),
+)
+
+it.effect("an older consumer completion cannot clear a newer coalesced handoff", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const done = yield* Deferred.make<void>()
+    const releaseLatest = yield* Deferred.make<void>()
+    yield* Effect.addFinalizer(() => Deferred.succeed(release, undefined)
+      .pipe(Effect.andThen(Deferred.succeed(releaseLatest, undefined))))
+    const source = { value: 1 }
+    const observed: number[] = []
+    yield* AuthorityEvents.observe([Event.Updated.type], Effect.gen(function* () {
+      observed.push(source.value)
+      if (observed.length === 1) {
+        yield* Deferred.succeed(entered, undefined)
+        yield* Deferred.await(release)
+        return
+      }
+      yield* Deferred.succeed(done, undefined)
+      yield* Deferred.await(releaseLatest)
+    }), location)
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* Deferred.await(entered)
+    source.value = 2
+    yield* bus.publish(Event.Updated, {}, { location })
+    source.value = 3
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* Deferred.succeed(release, undefined)
+    yield* Deferred.await(done)
+    const blocked = yield* authority.withStable(Effect.die("latest handoff has not settled")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    expect(observed).toEqual([1, 3])
+    yield* Deferred.succeed(releaseLatest, undefined)
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+  }),
+)
+
+it.effect("consumer disposal removes admission first and keeps its fence through worker cleanup", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const scope = yield* Scope.make()
+    const entered = yield* Deferred.make<void>()
+    const cleaning = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    yield* Effect.addFinalizer(() => Deferred.succeed(release, undefined))
+    yield* AuthorityEvents.observe([Event.Updated.type], Deferred.succeed(entered, undefined).pipe(
+      Effect.andThen(Effect.never),
+      Effect.onInterrupt(() => Deferred.succeed(cleaning, undefined).pipe(Effect.andThen(Deferred.await(release)))),
+    ), location).pipe(Scope.provide(scope))
+    yield* bus.publish(Event.Updated, {}, { location })
+    yield* Deferred.await(entered)
+    const closing = yield* Scope.close(scope, Exit.void).pipe(Effect.forkScoped)
+    yield* Deferred.await(cleaning)
+    expect(closing.pollUnsafe()).toBeUndefined()
+    const blocked = yield* authority.withStable(Effect.die("consumer cleanup is active")).pipe(Effect.exit)
