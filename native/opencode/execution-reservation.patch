+  streams.read.on("error", close)
+  streams.write.on("error", close)
+  streams.read.on("end", close)
+  streams.read.on("close", close)
+  yield* Effect.addFinalizer(() => Effect.sync(close).pipe(Effect.andThen(Scope.close(scope, Exit.void))))
+  const handle = Effect.fnUntraced(function* (bytes: Buffer) {
+    const decoded = yield* Effect.try({
+      try: () => {
+        const value: unknown = JSON.parse(bytes.toString("utf8"))
+        if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("Invalid request")
+        const keys = Object.keys(value)
+        if (keys.some((key) => !["id", "method", "sessionID", "transitionID", "expected", "targetLease", "directory", "channel", "receiverHash", "promotionID", "holdID"].includes(key))) throw new Error("Invalid request")
+        const request = Schema.decodeUnknownSync(Request)(value)
+        if (request.id <= lastID || request.sessionID !== input.sessionID ||
+          (!["inspect", "inspectLive", "observeIdle", "holdIdle", "checkIdle", "observeHeldAuthority", "releaseIdle"].includes(request.method) && !request.transitionID) ||
+          (["inspect", "inspectLive", "observeIdle", "holdIdle", "checkIdle", "observeHeldAuthority", "releaseIdle"].includes(request.method) && request.transitionID !== undefined) ||
+          ((["checkIdle", "observeHeldAuthority", "releaseIdle", "prepareHeld"].includes(request.method)) !== (request.holdID !== undefined)) ||
+          (request.holdID !== undefined && !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(request.holdID)) ||
+          ((["prepare", "prepareHeld"].includes(request.method)) !== (request.directory !== undefined)) ||
+          ((["detachMembership", "detachLiveMembership", "stageDestinationMembership", "stageRecoveredDestinationMembership"].includes(request.method)) !== (request.channel !== undefined)) ||
+          (request.channel !== undefined && (!request.channel || request.channel.length > 256)) ||
+          ((["stageDestinationMembership", "stageRecoveredDestinationMembership", "commitPreparedPlacement", "promoteLive"].includes(request.method)) !== (request.receiverHash !== undefined)) ||
+          (request.receiverHash !== undefined && !/^[a-f0-9]{64}$/.test(request.receiverHash)) ||
+          ((request.method === "promoteLive") !== (request.promotionID !== undefined)) ||
+          (request.promotionID !== undefined && !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(request.promotionID)) ||
+          (input.mode === "live" ? !["inspect", "observeIdle", "holdIdle", "checkIdle", "observeHeldAuthority", "releaseIdle", "prepareHeld", "observePlacement", "observeCompletion", "prepare", "releaseTransport", "detachLiveMembership", "stageDestinationMembership"].includes(request.method) :
+            (["inspectLive", "observeIdle", "holdIdle", "checkIdle", "observeHeldAuthority", "releaseIdle", "prepareHeld", "prepare", "releaseTransport", "detachLiveMembership", "stageDestinationMembership"].includes(request.method) && !promoted)) ||
+          (request.method === "takeoverRecovery" ? !request.expected || !request.targetLease :
+            request.expected !== undefined || request.targetLease !== undefined)) throw new Error("Invalid request")
+        lastID = request.id
+        return request
+      },
+      catch: () => new Error("Invalid private native request"),
+    })
+    const operation: Effect.Effect<unknown, unknown> = decoded.method === "inspect"
+      ? owner.inspect({ sessionID: decoded.sessionID }).pipe(Effect.map((intent) => intent ?? null))
+      : decoded.method === "holdIdle"
+        ? Effect.gen(function* () {
+          if (idleHold || livePhase !== "empty" || !input.execution?.withIdleMovementTree) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          const ready = yield* Deferred.make<boolean>()
+          const action = yield* Deferred.make<IdleAction>()
+          const result = yield* Deferred.make<Exit.Exit<MovementFence.Intent | null, unknown>>()
+          const hold: IdleHold = { id: randomUUID(), active: false, actionIssued: false, action, result }
+          idleHold = hold
+          const reserve = input.execution.withIdleMovementTree(decoded.sessionID, Effect.gen(function* () {
+            const intent = yield* (promoted ?? owner).inspect({ sessionID: decoded.sessionID })
+            if (intent || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+            hold.active = true
+            yield* Deferred.succeed(ready, true)
+            const next = yield* Deferred.await(action)
+            if (next.type === "release") return null
+            if (!hold.active || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+            return yield* (promoted ?? owner).prepare({ sessionID: decoded.sessionID, transitionID: next.transitionID, directory: next.directory })
+          })).pipe(
+            Effect.exit,
+            Effect.tap((exit) => Deferred.succeed(result, exit)),
+            Effect.tap(() => Deferred.succeed(ready, false)),
+            Effect.asVoid,
+            Effect.ensuring(Effect.sync(() => {
+              const revoked = hold.active && !hold.actionIssued && !closed
+              hold.active = false
+              if (revoked) streams.write.write(Buffer.from(JSON.stringify({ event: "idle_revoked", sessionID: decoded.sessionID, holdID: hold.id }) + "\n"))
+            })),
+          )
+          hold.fiber = yield* reserve.pipe(Effect.forkIn(scope, { startImmediately: true }))
+          if (!(yield* Deferred.await(ready)) || !hold.active || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          return { sessionID: decoded.sessionID, holdID: hold.id, held: true as const }
+        })
+      : decoded.method === "checkIdle"
+        ? Effect.gen(function* () {
+          const hold = idleHold
+          if (!hold?.active || hold.actionIssued || hold.id !== decoded.holdID || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          const intent = yield* (promoted ?? owner).inspect({ sessionID: decoded.sessionID })
+          if (intent || !hold.active || idleHold !== hold || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          return { sessionID: decoded.sessionID, holdID: hold.id, held: true as const }
+        })
+      : decoded.method === "observeHeldAuthority"
+        ? Effect.gen(function* () {
+          const hold = idleHold, activation = promoted ?? owner
+          if (!hold?.active || hold.actionIssued || hold.id !== decoded.holdID || closed || !activation.observePreGrantAuthority)
+            return yield* Effect.fail(new Error("Native held authority unavailable"))
+          const observation = yield* activation.observePreGrantAuthority({ sessionID: decoded.sessionID })
+          if (!hold.active || hold.actionIssued || idleHold !== hold || closed)
+            return yield* Effect.fail(new Error("Native held authority unavailable"))
+          return { ...observation, holdID: hold.id }
+        })
+      : decoded.method === "releaseIdle"
+        ? Effect.gen(function* () {
+          const hold = idleHold
+          if (!hold?.active || hold.actionIssued || hold.id !== decoded.holdID || !hold.fiber || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          hold.actionIssued = true
+          yield* Deferred.succeed(hold.action, { type: "release" })
+          yield* Fiber.await(hold.fiber)
+          if (idleHold !== hold || closed) return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          idleHold = undefined
+          return { sessionID: decoded.sessionID, holdID: hold.id, released: true as const }
+        })
+      : decoded.method === "prepareHeld"
+        ? Effect.gen(function* () {
+          const hold = idleHold
+          if (!hold?.active || hold.actionIssued || hold.id !== decoded.holdID || !hold.fiber || closed || livePhase !== "empty")
+            return yield* Effect.fail(new Error("Native idle hold unavailable"))
+          hold.actionIssued = true; livePhase = "preparing"
+          yield* Deferred.succeed(hold.action, { type: "prepare", transitionID: decoded.transitionID!, directory: decoded.directory! })
+          const outcome = yield* Deferred.await(hold.result)
+          yield* Fiber.await(hold.fiber)
+          if (idleHold !== hold || closed || Exit.isFailure(outcome) || outcome.value === null)
+            return yield* Effect.fail(new Error("Native held preparation unavailable"))
+          idleHold = undefined; liveTransition = decoded.transitionID; livePhase = "prepared"
+          return outcome.value
+        })
+      : decoded.method === "observeIdle"
+        ? Effect.suspend(() => {
+          if (idleHold || livePhase !== "empty" || !input.execution?.withIdleMovementTree) return Effect.fail(new Error("Native idle observation unavailable"))
+          return input.execution.withIdleMovementTree(decoded.sessionID, Effect.gen(function* () {
+            const intent = yield* (promoted ?? owner).inspect({ sessionID: decoded.sessionID })
+            if (intent) return yield* Effect.fail(new Error("Native idle observation unavailable"))
+            return { sessionID: decoded.sessionID, idle: true as const }
+          }))
+        })
+      : decoded.method === "inspectLive"
+        ? promoted!.inspect({ sessionID: decoded.sessionID }).pipe(Effect.map((intent) => intent ?? null))
+      : decoded.method === "promoteLive"
+        ? Effect.suspend(() => {
+          if (promotionPhase !== "empty") return Effect.fail(new Error("Native live promotion unavailable"))
+          promotionPhase = "dispatching"
+          return owner.promoteLive({ sessionID: decoded.sessionID, transitionID: decoded.transitionID!,
+            promotionID: decoded.promotionID!, receiverHash: decoded.receiverHash! }).pipe(Effect.map((result) => {
+              promoted = result.activation; promotionPhase = "active"; return result.receipt
+            }))
+        })
+      : decoded.method === "prepare"
+        ? Effect.suspend(() => {
+          if (idleHold || livePhase !== "empty") return Effect.fail(new Error("Native live operation unavailable"))
