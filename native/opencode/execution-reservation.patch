+    }
+    // Simulate a committed result lost before any acknowledgement reaches the host.
+    process.exit(73)
+  }
+  if (mode === "observe-completion") {
+    const activation = yield* movement.forActivation({ pluginID: "turnlink", location: source, authorized: true })
