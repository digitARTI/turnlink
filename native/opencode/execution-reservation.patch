+++ b/packages/core/test/git-helper-boundary.test.ts
@@ -0,0 +1,209 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, FileSystem, Layer, Scope } from "effect"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { filesystem } from "@opencode/util/effect/app-node-platform"
+import { FileSystemBoundary } from "@opencode/util/filesystem-boundary"
+import { FSUtil } from "@opencode/util/fs-util"
+import { AppProcess } from "@opencode/util/process"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([filesystem, AppProcess.node])))
+
+for (const type of [undefined, "file", "directory"] as const) {
+  for (const guarded of [false, true]) {
+    it.live(
+      `FSUtil.up ${type ?? "exists"} ${guarded ? "refuses revoked internal lookups" : "preserves its unobserved behavior"}`,
+      () =>
+        Effect.gen(function* () {
+          const native = yield* FileSystem.FileSystem
+          const tmp = yield* tmpdirScoped()
+          const start = path.join(tmp.path, "one", "two")
+          const target = path.join(tmp.path, "needle")
+          yield* native.makeDirectory(start, { recursive: true })
+          if (type === "directory") yield* native.makeDirectory(target)
+          if (type !== "directory") yield* native.writeFileString(target, "fixture\n")
+          const entered = yield* Deferred.make<void>()
+          const resume = yield* Deferred.make<void>()
+          const state = { allowed: true }
+          const calls: string[] = []
+          const observe = <A, E, R>(file: string, effect: Effect.Effect<A, E, R>) =>
+            Effect.gen(function* () {
+              calls.push(file)
+              const result = yield* effect.pipe(Effect.exit)
+              if (calls.length === 1) {
+                yield* Deferred.succeed(entered, undefined)
+                yield* Deferred.await(resume)
+              }
+              return yield* Exit.isSuccess(result) ? Effect.succeed(result.value) : Effect.failCause(result.cause)
+            })
+          const context = yield* Layer.build(
+            Layer.fresh(
+              LayerNode.compile(FSUtil.node, {
+                replacements: [
+                  filesystem.replace(
+                    Layer.succeed(FileSystem.FileSystem, {
+                      ...native,
+                      exists: (file) => observe(file, native.exists(file)),
+                      stat: (file) => observe(file, native.stat(file)),
+                    }),
+                  ),
+                ],
+              }),
+            ),
+          )
+          const fs = Context.get(context, FSUtil.Service)
+          const first = path.join(start, guarded ? "missing" : "needle")
+          const search = fs.up({
+            start,
+            stop: tmp.path,
+            targets: guarded ? ["missing", "needle"] : ["needle"],
+            mode: "first",
+            type,
+          })
+          const operation = guarded
+            ? search.pipe(
+                Effect.provideService(FileSystemBoundary, {
+                  check: Effect.suspend(() => (state.allowed ? Effect.void : Effect.interrupt)),
+                }),
+              )
+            : search
+          yield* Effect.gen(function* () {
+            const running = yield* operation.pipe(Effect.exit, Effect.forkScoped)
+            yield* Deferred.await(entered)
+            expect(calls).toEqual([first])
+            state.allowed = false
+            yield* Deferred.succeed(resume, undefined)
+            const result = yield* Fiber.join(running)
+            if (guarded) {
+              expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(true)
+              expect(calls).toEqual([first])
+            }
+            if (!guarded) {
+              expect(Exit.isSuccess(result) && result.value).toEqual([target])
+              expect(calls).toHaveLength(3)
+            }
+          }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+        }),
+    )
+  }
+}
+
+it.live("FSUtil.up checks refusal before the first lookup for every target kind", () =>
+  Effect.gen(function* () {
+    const native = yield* FileSystem.FileSystem
+    const tmp = yield* tmpdirScoped()
+    const calls = { count: 0 }
+    const denied = Effect.sync(() => {
+      calls.count++
+    }).pipe(Effect.andThen(Effect.interrupt))
+    const context = yield* Layer.build(
+      Layer.fresh(
+        LayerNode.compile(FSUtil.node, {
+          replacements: [
+            filesystem.replace(
+              Layer.succeed(FileSystem.FileSystem, { ...native, exists: () => denied, stat: () => denied }),
+            ),
+          ],
+        }),
+      ),
+    )
+    const fs = Context.get(context, FSUtil.Service)
+    for (const type of [undefined, "file", "directory"] as const) {
+      const result = yield* fs
+        .up({ start: tmp.path, stop: tmp.path, targets: ["needle"], type })
+        .pipe(Effect.provideService(FileSystemBoundary, { check: Effect.interrupt }), Effect.exit)
+      expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(true)
+      expect(calls.count).toBe(0)
+    }
+  }),
+)
+
+for (const close of [false, true]) {
+  it.live(
+    `Git nested discovery ${close ? "stops internal ascent after owner closure" : "keeps live-owner discovery working"}`,
+    () =>
+      Effect.gen(function* () {
+        const native = yield* FileSystem.FileSystem
+        const backend = yield* AppProcess.Service
+        const tmp = yield* tmpdirScoped()
+        const project = AbsolutePath.make(path.join(tmp.path, "project"))
+        const start = AbsolutePath.make(path.join(project, "one", "two"))
+        yield* Effect.promise(() => initRepo(project))
+        yield* native.makeDirectory(start, { recursive: true })
+        const entered = yield* Deferred.make<void>()
+        const resume = yield* Deferred.make<void>()
+        const state = { armed: false, commands: 0 }
+        const calls: string[] = []
+        const owner = yield* Scope.make()
+        yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+        const context = yield* Layer.build(
+          Layer.fresh(
+            LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+              replacements: [
+                filesystem.replace(
+                  Layer.succeed(FileSystem.FileSystem, {
+                    ...native,
+                    exists: (file) => {
+                      if (!state.armed) return native.exists(file)
+                      return Effect.gen(function* () {
+                        calls.push(file)
+                        const value = yield* native.exists(file)
+                        if (calls.length === 1) {
+                          yield* Deferred.succeed(entered, undefined)
+                          yield* Deferred.await(resume)
+                        }
+                        return value
+                      })
+                    },
+                  }),
+                ),
+                AppProcess.node.replace(
+                  Layer.succeed(AppProcess.Service, {
+                    ...backend,
+                    run: (command, options) => {
+                      if (state.armed) state.commands++
+                      return backend.run(command, options)
+                    },
+                  }),
+                ),
+              ],
+            }),
+          ),
+        ).pipe(Scope.provide(owner))
+        const git = Context.get(context, Git.Service)
+        const authority = Context.get(context, ReservationAuthority.Service)
+        const baseline = yield* git.repo.discover(project)
+        if (!baseline) return yield* Effect.die("fixture project is not a repository")
+        yield* Effect.gen(function* () {
+          state.armed = true
+          const running = yield* git.repo.discover(start).pipe(Effect.exit, Effect.forkScoped)
+          yield* Deferred.await(entered)
+          expect(calls).toEqual([path.join(start, ".git")])
+          if (close) yield* Scope.close(owner, Exit.void)
+          yield* Deferred.succeed(resume, undefined)
+          const result = yield* Fiber.join(running)
+          if (close) {
+            expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(true)
+            expect(calls).toHaveLength(1)
+            expect(state.commands).toBe(0)
+          }
+          if (!close) {
+            expect(Exit.isSuccess(result) && result.value).toMatchObject({
+              worktree: baseline.worktree,
+              gitDirectory: baseline.gitDirectory,
+            })
+            expect(calls).toHaveLength(3)
+            expect(state.commands).toBe(1)
+          }
+          const stable = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+          expect(Exit.isFailure(stable) && Cause.hasInterruptsOnly(stable.cause)).toBe(close)
+        }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+      }),
+  )
+}
