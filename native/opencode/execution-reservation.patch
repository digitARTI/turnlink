diff --git a/packages/core/test/environment-local-authority.test.ts b/packages/core/test/environment-local-authority.test.ts
new file mode 100644
index 0000000..907efdf
--- /dev/null
+++ b/packages/core/test/environment-local-authority.test.ts
@@ -0,0 +1,98 @@
+import { expect } from "bun:test"
+import fs from "node:fs/promises"
+import path from "node:path"
+import { Cause, Deferred, Effect, Exit, Fiber } from "effect"
+import { makeFiles, makeMemoryDriver } from "@opencode/core/environment/index"
+import { makeLocalDriver } from "@opencode/core/environment/local"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { Workspace } from "@opencode/core/workspace"
+import { WorkspaceDriver } from "@opencode/core/workspace/driver"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(
+  AppNodeBuilder.build(LayerNode.group([ReservationAuthority.node, Workspace.node]), [
+    WorkspaceDriver.node.replace(
+      WorkspaceDriver.registryNode({
+        local: WorkspaceDriver.make({
+          create: () => Effect.succeed({ binding: { local: true } }),
+          connect: () => Effect.succeed(makeLocalDriver(makeMemoryDriver().spawner)),
+          suspendForIdle: () => Effect.void,
+          destroy: () => Effect.void,
+        }),
+      }),
+    ),
+  ]),
+)
+// Windows has no POSIX FIFO. This case exercises real kernel I/O, not a timer
+// or a mocked fs implementation; Windows native-I/O acceptance remains separate.
+const fifoTest = process.platform === "win32" ? it.live.skip : it.live
+
+for (const owner of ["mutation", "workspace borrow"] as const) {
+  fifoTest(`local write cancellation retains its ${owner} fence until native I/O settles`, () =>
+    Effect.gen(function* () {
+      const authority = yield* ReservationAuthority.Service
+      const tmp = yield* tmpdirScoped()
+      const fifo = path.join(tmp.path, "pending-write")
+      yield* Effect.acquireUseRelease(
+        Effect.sync(() => Bun.spawn(["mkfifo", fifo], { stdout: "ignore", stderr: "pipe" })),
+        (child) =>
+          Effect.promise(async () => {
+            const [code, errors] = await Promise.all([child.exited, new Response(child.stderr).text()])
+            expect(errors).toBe("")
+            expect(code).toBe(0)
+          }),
+        (child) =>
+          Effect.promise(async () => {
+            if (child.exitCode !== null) return
+            child.kill()
+            await child.exited
+          }),
+      )
+      const workspace = yield* Workspace.Service
+      const files =
+        owner === "mutation"
+          ? makeFiles(makeLocalDriver(makeMemoryDriver().spawner))
+          : makeFiles(yield* workspace.connect(yield* workspace.create({ provider: "local" })))
+      const bytes = new Uint8Array(4 * 1024 * 1024).fill(7)
+      // Opening both ends pairs the FIFO. The payload exceeds the POSIX hosts'
+      // pipe buffers; reading one byte proves writeFile reached actual kernel I/O.
+      const opening = fs.open(fifo, "r")
+      const write = files.write(fifo, bytes)
+      const writer = yield* (owner === "mutation" ? authority.withMutation(write) : write).pipe(
+        Effect.exit,
+        Effect.forkScoped,
+      )
+      const reader = yield* Effect.promise(() => opening)
+      yield* Effect.gen(function* () {
+        expect((yield* Effect.promise(() => reader.read(new Uint8Array(1), 0, 1, null))).bytesRead).toBe(1)
+        const accepted = yield* Deferred.make<void>()
+        const interrupting = yield* Deferred.succeed(accepted, undefined).pipe(
+          Effect.andThen(Fiber.interrupt(writer)),
+          Effect.forkScoped,
+        )
+        yield* Deferred.await(accepted)
+        for (const _ of Array.from({ length: 10 })) yield* Effect.yieldNow
+        const pending = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+        expect(Exit.isFailure(pending) && Cause.hasInterruptsOnly(pending.cause)).toBe(true)
+        expect(interrupting.pollUnsafe()).toBeUndefined()
+        const drained = yield* Effect.promise(() => reader.readFile())
+        expect(drained.byteLength).toBe(bytes.byteLength - 1)
+        expect(drained.every((byte) => byte === 7)).toBe(true)
+        yield* Fiber.join(interrupting)
+        expect(Exit.isSuccess(yield* authority.withStable(Effect.void).pipe(Effect.exit))).toBe(true)
+      }).pipe(
+        Effect.ensuring(
+          Effect.promise(async () => {
+            // Also drain on assertion failure so a still-running native write is not
+            // abandoned while the test closes its file descriptor or temp directory.
+            await reader.readFile()
+            await reader.close()
+          }),
+        ),
+      )
+    }),
+  )
+}
