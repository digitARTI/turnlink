+it.live("native movement refuses a real helper model request even when its Session runner is idle", () =>
+  Effect.gen(function* () {
+    const tmp = yield* tmpdirScoped()
+    const received = yield* Deferred.make<{ sessionID: string | null; body: string }>()
+    const release = Promise.withResolvers<void>()
+    let requests = 0
+    const callback = Effect.runPromiseWith(yield* Effect.context())
+    const server = yield* Effect.acquireRelease(
+      Effect.sync(() =>
+        Bun.serve({
+          hostname: "127.0.0.1",
+          port: 0,
+          fetch: async (request) => {
+            requests++
+            await callback(
+              Deferred.succeed(received, {
+                sessionID: request.headers.get("x-opencode-session-id"),
+                body: await request.text(),
+              }),
+            )
+            await release.promise
+            const chunk = {
+              id: "movement-model-work",
+              object: "chat.completion.chunk",
+              created: 1,
+              model: "native-continuity",
+              choices: [
+                { index: 0, delta: { role: "assistant", content: "RESOURCE_NATIVE_REPLY" }, finish_reason: null },
+              ],
+            }
+            const finished = {
+              ...chunk,
+              choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+              usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },
+            }
+            return new Response(
+              `data: ${JSON.stringify(chunk)}\n\ndata: ${JSON.stringify(finished)}\n\ndata: [DONE]\n\n`,
+              { headers: { "content-type": "text/event-stream" } },
+            )
+          },
+        }),
+      ),
+      (server) =>
+        Effect.sync(() => {
+          release.resolve()
+          server.stop(true)
+        }),
+    )
+    yield* Effect.promise(async () => {
+      await Promise.all([mkdir(`${tmp.path}/source`), mkdir(`${tmp.path}/destination`)])
+      await writeFile(`${tmp.path}/source/AGENTS.md`, "FULL_NATIVE_RESOURCE_POLICY")
+      await writeFile(
+        `${tmp.path}/source/opencode.json`,
+        JSON.stringify({
+          providers: {
+            movement: {
+              package: "@opencode/ai/providers/openai-compatible",
+              settings: { baseURL: `http://127.0.0.1:${server.port}/v1`, apiKey: "native-resource-test-key" },
+              models: {
+                continuity: {
+                  modelID: "native-continuity",
+                  limit: { context: 4096, output: 256 },
+                  capabilities: { tools: true, input: ["text"], output: ["text"] },
+                },
+              },
+            },
+          },
+        }),
+      )
+    })
+    const source = Location.Ref.make({ directory: AbsolutePath.make(`${tmp.path}/source`) })
+    const destination = AbsolutePath.make(`${tmp.path}/destination`)
+    const sessions = yield* Session.Service
+    const locations = yield* LocationServiceMap.Service
+    const execution = yield* SessionExecution.Service
+    const session = yield* sessions.create({
+      location: source,
+      model: Model.Ref.make({ providerID: Provider.ID.make("movement"), id: Model.ID.make("continuity") }),
+    })
+    const helper = yield* SessionGenerate.generate({ session, prompt: "Return the native resource response." }).pipe(
+      Effect.provide(locations.get(source)),
+      Effect.exit,
+      Effect.forkScoped,
+    )
+    const request = yield* Deferred.await(received).pipe(
+      Effect.raceFirst(
+        Fiber.join(helper).pipe(
+          Effect.flatMap((result) =>
+            Exit.isFailure(result)
+              ? Effect.failCause(result.cause)
+              : Effect.die(new Error("Native helper completed before local request")),
+          ),
+        ),
+      ),
+    )
+    expect(request.sessionID).toBe(session.id)
+    expect(request.body).toContain("FULL_NATIVE_RESOURCE_POLICY")
+    expect(yield* execution.isActive(session.id)).toBe(false)
+    const authority = yield* ReservationAuthority.Service
+    yield* authority.withStable(Effect.void).pipe(
+      Effect.exit,
+      Effect.flatMap((exit) => (Exit.isSuccess(exit) ? Effect.void : Effect.fail("native source is unsettled"))),
+      Effect.retry(Schedule.spaced("10 millis")),
+      Effect.timeout("5 seconds"),
+    )
+    const movement = yield* SessionMovement.Service
+    const owner = yield* movement.forActivation({
+      pluginID: "turnlink",
+      location: source,
+      authorized: true,
+    })
+    const transitionID = "88888888-8888-4888-8888-888888888888"
+    const blocked = yield* owner
+      .prepare({ sessionID: session.id, transitionID, directory: destination })
+      .pipe(Effect.exit)
+    expect(Exit.isFailure(blocked)).toBe(true)
+    expect(yield* owner.inspect({ sessionID: session.id })).toBeUndefined()
+    release.resolve()
+    const result = yield* Fiber.join(helper)
+    expect(Exit.isSuccess(result) && result.value).toBe("RESOURCE_NATIVE_REPLY")
+    const intent = yield* owner.prepare({ sessionID: session.id, transitionID, directory: destination })
+    expect(intent.sessionID).toBe(session.id)
+    expect(yield* sessions.get(session.id)).toEqual(session)
+    const rejected = yield* SessionGenerate.generate({ session, prompt: "This held Session must not send." }).pipe(
+      Effect.provide(locations.get(source)),
+      Effect.exit,
+    )
+    expect(Exit.isFailure(rejected)).toBe(true)
+    expect(requests).toBe(1)
+  }),
+)
