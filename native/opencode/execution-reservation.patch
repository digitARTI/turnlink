+export * as CredentialObserver from "./credential-observer.js"
+
+import { Effect } from "effect"
+import { Credential } from "@opencode/schema/credential"
+import type { Integration } from "@opencode/schema/integration"
+import type { Location } from "@opencode/schema/location"
+import { AuthorityEvents } from "../../session/authority-events.js"
+
+/** Native awaited refreshes only. A worker queued by refresh must retain its
+ * own authority hold; returning from dispatch is not worker settlement. */
+export const observe = <E, R>(
+  integrationID: Integration.ID,
+  refresh: () => Effect.Effect<void, E, R>,
+  location: Location.Ref,
+) => AuthorityEvents.observeEvent(Credential.Event.Switched, (event) =>
+  event.data.integrationID === integrationID
+    ? Effect.suspend(refresh).pipe(Effect.as(true))
+    : Effect.succeed(false), location)
