index 0000000..9bf5573
--- /dev/null
+++ b/packages/core/src/session/authority-events.ts
@@ -0,0 +1,108 @@
+export * as AuthorityEvents from "./authority-events.js"
+
+import { Cause, Effect, Exit, PubSub, Schema, Stream } from "effect"
+import type { Event } from "@opencode/schema/event"
+import { Bus } from "../bus.js"
+import type { Location } from "@opencode/schema/location"
+import { ReservationAuthority } from "./reservation-authority.js"
+
+/** Native, coalescing reloads only: never use this to replay session/task effects. */
+export const observe = Effect.fn("AuthorityEvents.observe")(function* <E, R>(
+  types: readonly string[],
+  reload: Effect.Effect<void, E, R>,
+  location: Location.Ref | undefined,
+  debounce = 0,
+) {
+  const bus = yield* Bus.Service
+  const authority = yield* ReservationAuthority.Service
+  const changes = yield* authority.trackChanges
+  const pending = yield* PubSub.sliding<number>(1)
+  const subscription = yield* PubSub.subscribe(pending)
+  const updates = Stream.fromSubscription(subscription)
+  yield* (debounce ? updates.pipe(Stream.debounce(debounce)) : updates).pipe(
+    Stream.runForEach((revision) => reload.pipe(
+      authority.withMutation,
+      Effect.andThen(changes.settle(revision)),
+      Effect.catchCauseIf(
+        (cause) => !Cause.hasInterrupts(cause),
+        (cause) => Effect.logError("native authority consumer failed", { types, cause }),
+      ),
+    )),
+    Effect.forkScoped({ startImmediately: true }),
+  )
+  // Fence before publication, but dispatch from the volatile feed so derived
+  // events cannot overtake their source in a subscriber's ordered event log.
+  // Identity keys also keep an older delivery from settling a newer handoff;
+  // an interrupted publication stays fenced without retaining its event.
+  const revisions = new WeakMap<object, number>()
+  yield* bus.subscribe().pipe(
+    Stream.runForEach((event) => {
+      const revision = revisions.get(event)
+      if (revision === undefined) return Effect.void
+      revisions.delete(event)
+      return PubSub.publish(pending, revision).pipe(Effect.asVoid)
+    }),
+    Effect.forkScoped({ startImmediately: true }),
+  )
+  // Bus listeners run before volatile publication. Do no reload I/O here:
+  // producers (including revocations) wait only for marking.
+  // This listener intentionally replaces an ordinary stream subscription for
+  // these native consumers; the plugin EventDomain has no pre-publication hook.
+  const notify = Effect.suspend(() => PubSub.publish(pending, changes.markUnsafe()).pipe(Effect.asVoid))
+  yield* Effect.acquireRelease(
+    bus.listen((event) => {
+      if (!types.includes(event.type)) return Effect.void
+      if (event.location && location && (event.location.directory !== location.directory ||
+        event.location.workspaceID !== location.workspaceID)) return Effect.void
+      return Effect.sync(() => { revisions.set(event, changes.markUnsafe()) })
+    }),
+    (unsubscribe) => unsubscribe,
+  )
+  return notify
+})
+
+/** Typed native observations only; true means a complete reconciliation, false
+ * means irrelevant. A skipped event must never clear an earlier failed reload. */
+export const observeEvent = <D extends Event.Definition, E, R>(
+  definition: D,
+  consume: (event: D["Type"]) => Effect.Effect<boolean, E, R>,
+  location: Location.Ref,
+) => Effect.gen(function* () {
+  const bus = yield* Bus.Service
+  const authority = yield* ReservationAuthority.Service
+  const changes = yield* authority.trackChanges
+  const isEvent = Schema.is(definition)
+  const pending = new WeakMap<object, { value: D["Type"]; release: Effect.Effect<void> }>()
+  yield* bus.subscribe(definition).pipe(
+    Stream.runForEach((event) => {
+      const entry = pending.get(event)
+      if (!entry) return Effect.void
+      pending.delete(event)
+      return Effect.gen(function* () {
+        const revision = yield* changes.revision
+        if (yield* consume(entry.value)) yield* changes.settle(revision)
+      }).pipe(
+        authority.withMutation,
+        Effect.onExit((exit) => Exit.isFailure(exit) ? changes.mark : Effect.void),
+        Effect.catchCauseIf(
+          (cause) => !Cause.hasInterrupts(cause),
+          (cause) => Effect.logError("native authority event consumer failed", { type: definition.type, cause }),
+        ),
+        Effect.ensuring(entry.release),
+      )
+    }),
+    Effect.forkScoped({ startImmediately: true }),
+  )
+  yield* Effect.acquireRelease(
+    bus.listen((event) => {
+      if (!isEvent(event)) return Effect.void
+      if (event.location && (event.location.directory !== location.directory ||
+        event.location.workspaceID !== location.workspaceID)) return Effect.void
+      return Effect.sync(() => {
+        const release = changes.holdUnsafe()
+        if (release) pending.set(event, { value: event, release })
+      })
+    }),
+    (unsubscribe) => unsubscribe,
+  )
+})
