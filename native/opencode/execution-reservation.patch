+    yield* Effect.promise(() => Bun.write(`${root}/completion-recovery.json`, JSON.stringify(completion)))
+    return
+  }
+  if (mode === "second-stage-crash" || mode === "second-recover") {
+    const activation = yield* movement.forActivation({ pluginID: "turnlink", location: destination, authorized: true })
+    if (mode === "second-stage-crash") {
+      yield* activation.prepare({ sessionID, transitionID: secondID, directory: secondDestination.directory })
