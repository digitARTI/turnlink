+import { expect } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Layer, LayerMap } from "effect"
+import type { Instance } from "@opencode/core/instance"
+import { Location } from "@opencode/core/location"
+import { LocationServiceMap } from "@opencode/core/location-service-map"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { testEffect } from "./lib/effect"
+import { location } from "./fixture/location"
+import { drain } from "./lib/clock"
+
+const it = testEffect(ReservationAuthority.layer)
+const ref = Location.Ref.make({ directory: AbsolutePath.make("/reload-reservation") })
+
+it.effect("interrupting a Location reload retains authority through map-owned replacement acquisition", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const building = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const source = { replacing: false, completed: false }
+    const map = yield* LayerMap.make((key: Location.Ref) => Layer.effect(Location.Service, Effect.gen(function* () {
+      if (source.replacing) {
+        yield* Deferred.succeed(building, undefined)
+        yield* Deferred.await(release)
+        source.completed = true
+      }
+      return location({ directory: key.directory })
+    })), { idleTimeToLive: Infinity })
+    yield* Effect.scoped(map.contextEffect(ref))
+    source.replacing = true
+    const reloading = yield* LocationServiceMap.reload().pipe(
+      Effect.provideService(LocationServiceMap.Service,
+        map as unknown as LayerMap.LayerMap<Location.Ref, Instance.Services, Instance.Error>),
+      Effect.exit,
+      Effect.forkScoped,
+    )
+    yield* Effect.gen(function* () {
+      yield* Deferred.await(building)
+      const interrupting = yield* Fiber.interrupt(reloading).pipe(Effect.forkScoped)
+      yield* drain
+      const blocked = yield* authority.withStable(Effect.die("map-owned replacement is pending")).pipe(Effect.exit)
+      expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+      expect(reloading.pollUnsafe()).toBeUndefined()
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(interrupting)
+      const exit = yield* Fiber.await(reloading)
+      expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+      expect(source.completed).toBe(true)
+      yield* authority.withStable(Effect.void)
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }),
+)
+
+it.effect("Location reload fences invalidation teardown without waiting for old reservation cleanup", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const closing = yield* Deferred.make<void>()
+    const releaseClose = yield* Deferred.make<void>()
+    const cleaning = yield* Deferred.make<void>()
+    const releaseCleanup = yield* Deferred.make<void>()
+    yield* Effect.addFinalizer(() => Deferred.succeed(releaseClose, undefined)
+      .pipe(Effect.andThen(Deferred.succeed(releaseCleanup, undefined))))
+    const source = { builds: 0 }
+    const map = yield* LayerMap.make((key: Location.Ref) => Layer.effect(Location.Service, Effect.gen(function* () {
+      source.builds++
+      if (source.builds === 1) {
+        yield* Effect.addFinalizer(() => Deferred.succeed(closing, undefined)
+          .pipe(Effect.andThen(Deferred.await(releaseClose))))
+      }
+      return location({ directory: key.directory })
+    })), { idleTimeToLive: Infinity })
+    yield* Effect.scoped(map.contextEffect(ref))
+    const entered = yield* Deferred.make<void>()
