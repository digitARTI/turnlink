+import { expect } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Layer, LayerMap } from "effect"
+import type { Instance } from "@opencode/core/instance"
+import { Location } from "@opencode/core/location"
+import { LocationServiceMap } from "@opencode/core/location-service-map"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { AbsolutePath } from "@opencode/core/schema"
+import { location } from "../../core/test/fixture/location"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+it.live("Location reload HTTP handler uses the host authority through replacement settlement", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const building = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const source = { builds: 0 }
+    const ref = Location.Ref.make({ directory: AbsolutePath.make("/http-reload-reservation") })
+    const map = yield* LayerMap.make((key: Location.Ref) => Layer.effect(Location.Service, Effect.gen(function* () {
+      if (++source.builds > 1) {
+        yield* Deferred.succeed(building, undefined)
+        yield* Deferred.await(release)
+      }
+      return location({ directory: key.directory })
+    })), { idleTimeToLive: Infinity })
+    yield* Effect.scoped(map.contextEffect(ref))
+    const handler = yield* ServerFetch.make({
+      database: { path: ":memory:" }, fs: { filewatcher: false }, models: { fetch: false },
+    }, {
+      overrides: [
+        ReservationAuthority.node.replace(Layer.succeed(ReservationAuthority.Service, authority)),
+        // Only reload runs here; its real LayerMap acquisition is held, and no
+        // endpoint tries to read a full Instance context from this fixture.
+        LocationServiceMap.node.replace(Layer.succeed(LocationServiceMap.Service,
+          map as unknown as LayerMap.LayerMap<Location.Ref, Instance.Services, Instance.Error>)),
+      ],
+    })
+    const entered = yield* Deferred.make<void>()
+    const reserved = yield* authority.withStable(Deferred.succeed(entered, undefined)
+      .pipe(Effect.andThen(Effect.never))).pipe(Effect.exit, Effect.forkScoped)
+    yield* Deferred.await(entered)
+    const request = yield* Effect.promise(() => handler(new Request(
+      "http://opencode.local/api/location/reload", { method: "POST" },
+    ))).pipe(Effect.forkScoped)
+    yield* Effect.gen(function* () {
+      yield* Deferred.await(building)
+      expect(request.pollUnsafe()).toBeUndefined()
+      const exit = yield* Fiber.join(reserved)
+      expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+      const blocked = yield* authority.withStable(Effect.die("HTTP replacement is pending")).pipe(Effect.exit)
+      expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+      yield* Deferred.succeed(release, undefined)
+      expect((yield* Fiber.join(request)).status).toBe(204)
+      yield* authority.withStable(Effect.void)
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }).pipe(Effect.provide(ReservationAuthority.layer)),
+)
