+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const values: string[] = []
+    yield* AuthorityEvents.observeEvent(Credential.Event.Switched, (event) => Effect.suspend(() => {
+      values.push(event.data.integrationID)
+      if (event.data.integrationID === "fail") return Effect.die("fixture reconciliation failure")
+      return Effect.succeed(event.data.integrationID !== "skip")
+    }), location)
+    yield* bus.publish(Credential.Event.Switched, data("fail"), { location })
+    yield* advanceEffect(Effect.sync(() => values.length === 1))
+    yield* drain
+    const failed = yield* authority.withStable(Effect.die("failed work is still uncertain")).pipe(Effect.exit)
+    expect(Exit.isFailure(failed) && Cause.hasInterruptsOnly(failed.cause)).toBe(true)
+    yield* bus.publish(Credential.Event.Switched, data("skip"), { location })
+    yield* advanceEffect(Effect.sync(() => values.length === 2))
+    yield* drain
+    const skipped = yield* authority.withStable(Effect.die("an irrelevant event is not reconciliation")).pipe(Effect.exit)
+    expect(Exit.isFailure(skipped) && Cause.hasInterruptsOnly(skipped.cause)).toBe(true)
+    yield* bus.publish(Credential.Event.Switched, data("recover"), { location })
+    yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
