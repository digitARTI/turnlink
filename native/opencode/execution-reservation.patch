+    return
+  }
+  if (mode !== "recover-crash" && mode !== "recover" && mode !== "recover-place" && mode !== "recover-prepared-place" &&
+    mode !== "recover-complete-crash" && mode !== "reject-prepared-unclaimed" && mode !== "reject-prepared-stale-claim" &&
+    mode !== "reject-prepared-wrong-transition") return yield* Effect.die("Unexpected fixture mode")
+  const activation = yield* movement.forActivation({ pluginID: "turnlink", location: source, authorized: true })
+  const intent = yield* activation.inspect({ sessionID })
+  if (!intent) return yield* Effect.die("Quarantine disappeared")
+  if (mode === "reject-prepared-unclaimed" || mode === "reject-prepared-stale-claim" || mode === "reject-prepared-wrong-transition") {
+    const result = yield* activation.prepareAuthority({ sessionID,
+      transitionID: mode === "reject-prepared-wrong-transition" ? secondID : transitionID }).pipe(Effect.exit)
+    if (Exit.isSuccess(result)) return yield* Effect.die("Unclaimed or mismatched activation prepared destination authority")
+    yield* Effect.promise(() => Bun.write(`${root}/${mode}.json`, JSON.stringify({ rejected: true, cause: Cause.pretty(result.cause) })))
+    return
+  }
+  const observed = yield* activation.observeRecoveryRecord({ sessionID, transitionID })
+  const claim = observed.recovery
+    ? yield* activation.takeoverRecovery({ sessionID, transitionID, expected: observed.recovery, targetLease: observed.currentLease })
+    : yield* activation.recoverQuarantine({ sessionID, transitionID })
+  if (mode === "recover-crash") process.exit(74)
+  if (mode === "recover-place" || mode === "recover-prepared-place") {
+    const owner = yield* SessionMovement.placementOwner(activation, { sessionID, transitionID })
+    const bus = yield* Bus.Service
+    const execution = yield* SessionExecution.Service
+    if (mode === "recover-prepared-place") {
+      const prepared = yield* (yield* activation.prepareAuthority({ sessionID, transitionID }).pipe(Effect.exit,
+        Effect.repeat({ until: (result) => Exit.isSuccess(result) || !Cause.hasInterruptsOnly(result.cause),
+          schedule: Schedule.spaced("25 millis") }), Effect.timeout("10 seconds")))
+      yield* Effect.promise(() => Bun.write(`${root}/prepared-placement.json`, JSON.stringify({
+        sessionID: prepared.destination.selection.session.id, directory: prepared.destination.selection.session.location.directory,
+        executionEligible: prepared.destination.executionEligible, unresolved: prepared.destination.unresolved,
+        ...(process.env.TEST_PREPARED_DETAILS === "1" ? { permissionComparison: prepared.permissionComparison,
+          sourceHooks: prepared.source.hooks, destinationHooks: prepared.destination.hooks,
+          sourceTools: prepared.source.selection.tools.authority, destinationTools: prepared.destination.selection.tools.authority,
+          sourceModel: prepared.source.modelAuthority, destinationModel: prepared.destination.modelAuthority } : {}),
+      })))
+      yield* SessionPlacementTransaction.commitPrepared({ database, bus, execution, owner, destination, receiverHash,
+        projectID: prepared.destination.selection.session.projectID, subpath: prepared.destination.selection.session.subpath, prepared })
+    } else yield* SessionPlacementTransaction.commit({ database, bus, execution, owner, destination, projectID: Project.ID.global, receiverHash })
+  }
+  const receipt = yield* activation.observePlacement({ sessionID, transitionID })
+  if (mode === "recover-complete-crash") {
+    if (!receipt) return yield* Effect.die("Placement is absent")
+    const owner = yield* SessionMovement.placementOwner(activation, { sessionID, transitionID })
+    yield* SessionPlacementCompletion.complete({ database, execution: yield* SessionExecution.Service, owner, placement: receipt })
+    process.exit(78)
+  }
+  const quarantine = yield* MovementFence.find(db, sessionID)
+  yield* Effect.promise(() => Bun.write(`${root}/placement-recovery.json`, JSON.stringify({ intent, claim, receipt, quarantine })))
+}).pipe(Effect.provide(graph))))
