+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+// POSIX FIFO semantics are unavailable on Windows; Windows native callback and
+// cleanup acceptance remains a separate gate, not simulated by this case.
+const fifoTest = process.platform === "win32" ? it.live.skip : it.live
+
+for (const outcome of ["success", "failure", "lost receipt"] as const) {
+  it.live(`direct Git restore deletion ${outcome} owns an independent native mutation hold`, () =>
+    Effect.gen(function* () {
+      const filesystem = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = AbsolutePath.make(path.join(tmp.path, "project"))
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const target = path.join(project, "remove-me.txt")
+      yield* Effect.promise(async () => {
+        await Bun.write(target, "fixture data\n")
+        await initRepo(project)
+      })
+      const gate = { armed: false, calls: 0 }
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...filesystem,
+                  remove: (file, options) => {
+                    if (!gate.armed || file !== target) return filesystem.remove(file, options)
+                    return Effect.gen(function* () {
+                      gate.calls++
+                      if (outcome !== "failure") yield* filesystem.remove(file, options)
+                      if (outcome !== "success")
+                        return yield* Effect.fail(
+                          systemError({
+                            _tag: "PermissionDenied",
+                            module: "FileSystem",
+                            method: "remove",
+                            pathOrDescriptor: file,
+                            description: "controlled restore deletion fault",
+                          }),
+                        )
+                    })
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      const source = yield* git.repo.discover(project)
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+      // The empty fixture commit/index contains no remove-me entry.
+      const tree = yield* git.tree.write(repository)
+      const restore = git.tree.restore({ repository, files: new Map([[RelativePath.make("remove-me.txt"), tree]]) })
+      expect(yield* refused).toBe(false)
+      gate.armed = true
+      const result = yield* restore.pipe(Effect.exit)
+      expect(Exit.isFailure(result)).toBe(outcome !== "success")
+      expect(gate.calls).toBe(1)
+      expect(yield* filesystem.exists(target)).toBe(outcome === "failure")
+      expect(yield* refused).toBe(outcome !== "success")
+      gate.armed = false
+      yield* restore
+      expect(yield* refused).toBe(outcome !== "success")
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(outcome !== "success")
+    }),
+  )
+}
+
+fifoTest("Git config-write cancellation waits for real kernel I/O before temporary cleanup", () =>
+  Effect.gen(function* () {
+    const filesystem = yield* FSUtil.Service
+    const tmp = yield* tmpdirScoped()
+    const project = AbsolutePath.make(path.join(tmp.path, "project"))
+    const store = AbsolutePath.make(path.join(tmp.path, "store"))
+    const config = path.join(store, "opencode.gitconfig")
+    const stale = "[core]\n\tignorecase = false\n"
+    yield* Effect.promise(async () => {
+      await Bun.write(path.join(project, "tracked.txt"), "content\n")
+      await initRepo(project)
+    })
+    const opened = Promise.withResolvers<Awaited<ReturnType<typeof fs.open>>>()
+    const state = { armed: false, target: "", payload: "", cleanups: 0, renames: 0 }
+    const owner = yield* Scope.make()
+    yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+    const context = yield* Layer.build(
+      Layer.fresh(
+        LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+          replacements: [
+            FSUtil.node.replace(
+              Layer.succeed(FSUtil.Service, {
+                ...filesystem,
+                writeFileString: (file, value, options) => {
+                  if (!state.armed || !file.startsWith(config + "."))
+                    return filesystem.writeFileString(file, value, options)
+                  return Effect.gen(function* () {
+                    state.target = file
+                    // Valid fixture-only config padding exceeds native pipe buffers.
+                    state.payload = value + "\n#" + "x".repeat(4 * 1024 * 1024) + "\n"
+                    yield* Effect.acquireUseRelease(
+                      Effect.sync(() => Bun.spawn(["mkfifo", file], { stdout: "ignore", stderr: "pipe" })),
+                      (child) =>
+                        Effect.promise(async () => {
+                          const [code, errors] = await Promise.all([child.exited, new Response(child.stderr).text()])
+                          expect(errors).toBe("")
+                          expect(code).toBe(0)
+                        }),
+                      (child) =>
+                        Effect.promise(async () => {
+                          if (child.exitCode !== null) return
+                          child.kill()
+                          await child.exited
+                        }),
+                    )
+                    opened.resolve(fs.open(file, "r"))
+                    return yield* filesystem.writeFileString(file, state.payload, options)
+                  })
+                },
+                rename: (from, to) => {
+                  if (state.armed && to === config) state.renames++
+                  return filesystem.rename(from, to)
+                },
+                remove: (file, options) => {
+                  return Effect.sync(() => {
+                    if (state.armed && file === state.target) state.cleanups++
+                  }).pipe(Effect.andThen(filesystem.remove(file, options)))
+                },
+              }),
+            ),
+          ],
+        }),
+      ),
+    ).pipe(Scope.provide(owner))
+    const git = Context.get(context, Git.Service)
+    const authority = Context.get(context, ReservationAuthority.Service)
+    const source = yield* git.repo.discover(project)
+    if (!source) return yield* Effect.die("fixture project is not a repository")
+    const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+    yield* filesystem.writeFileString(config, stale)
+    state.armed = true
+    const writer = yield* git.tree
+      .capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      .pipe(Effect.exit, Effect.forkScoped)
+    const reader = yield* Effect.promise(() => opened.promise)
+    yield* Effect.gen(function* () {
+      const first = new Uint8Array(1)
+      expect((yield* Effect.promise(() => reader.read(first, 0, 1, null))).bytesRead).toBe(1)
+      const accepted = yield* Deferred.make<void>()
+      const cancelling = yield* Deferred.succeed(accepted, undefined).pipe(
+        Effect.andThen(Fiber.interrupt(writer)),
+        Effect.forkScoped,
+      )
+      yield* Deferred.await(accepted)
+      for (const _ of Array.from({ length: 10 })) yield* Effect.yieldNow
+      expect(cancelling.pollUnsafe()).toBeUndefined()
+      expect(state.cleanups).toBe(0)
+      expect(state.renames).toBe(0)
+      expect(yield* filesystem.exists(state.target)).toBe(true)
+      const pending = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+      expect(Exit.isFailure(pending) && Cause.hasInterruptsOnly(pending.cause)).toBe(true)
+      const rest = yield* Effect.promise(() => reader.readFile())
+      expect(rest.byteLength).toBe(Buffer.byteLength(state.payload) - 1)
+      expect(Buffer.concat([first, rest]).equals(Buffer.from(state.payload))).toBe(true)
+      yield* Fiber.join(cancelling)
+      const result = yield* Fiber.await(writer)
+      expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(true)
+      expect(state.cleanups).toBe(1)
+      expect(state.renames).toBe(0)
+      expect(yield* filesystem.exists(state.target)).toBe(false)
+      expect(yield* filesystem.readFileString(config)).toBe(stale)
+      const unresolved = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+      expect(Exit.isFailure(unresolved) && Cause.hasInterruptsOnly(unresolved.cause)).toBe(true)
+    }).pipe(
+      Effect.ensuring(
+        Effect.promise(async () => {
+          // Even on a failed assertion, finish native I/O before descriptor/temp teardown.
+          await reader.readFile()
+          await reader.close()
+        }),
+      ),
+    )
+  }),
+)
