+]), [offlineModels, Database.node.replace(Database.configured({ path: `${root}/movement.sqlite`, nativeMovement: true }))])
+
+await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+  const database = yield* Database.Service
+  if (mode === "crash" || mode === "crash-child" || mode === "crash-child-no-job") {
+    yield* Effect.promise(() => mkdir(directory, { recursive: true }))
+    yield* database.db.insert(ProjectTable).values({ id: Project.ID.global, worktree: directory, sandboxes: [] }).run().pipe(Effect.orDie)
+    yield* database.db.insert(SessionTable).values([
+      { id: parent, project_id: Project.ID.global, directory, slug: "parent", title: "Parent", version: "test", time_suspended: 1 },
+      { id: child, parent_id: parent, project_id: Project.ID.global, directory, slug: "child", title: "Child", version: "test", time_suspended: 1 },
+    ]).run().pipe(Effect.orDie)
+    const jobs = yield* Job.Service
+    yield* jobs.start({ id: "prior-shell", type: "shell",
+      recovery: { kind: "shell", sessionID: parent, shellID: "shell-prior", command: "fixture" }, run: Effect.never })
+    yield* jobs.background("prior-shell")
+    if (mode !== "crash-child-no-job") {
+      yield* jobs.start({ id: "prior-child", type: "subagent",
+        recovery: { kind: "subagent", parentSessionID: parent, childSessionID: child, agent: "fixture", description: "fixture" },
+        run: Effect.never })
+      yield* jobs.background("prior-child")
+    }
+    const transport = yield* SessionModelTransport.Service
+    for (const sessionID of mode !== "crash" ? [child] : [parent, child]) {
+      const run = yield* transport.bind(sessionID).execute({
+        id: `crash-${sessionID}`, connect: { url: url!, headers: Headers.empty },
+        fallback: () => Stream.die("unexpected fallback"),
+        driver: { create: () => Effect.succeed({ message: "request", mode: "full" }),
+          observe: (_create, frame) => Effect.succeed({ type: "completed", frame }) },
+      })
+      yield* Stream.runCollect(run.frames).pipe(Effect.scoped)
+    }
+    process.exit(73)
+  }
+  if (mode !== "recover" && mode !== "recover-child" && mode !== "recover-no-job") return yield* Effect.die("Unexpected mode")
+  const restart = yield* SessionRestart.Service
+  const execution = yield* SessionExecution.Service
+  const store = yield* SessionStore.Service
+  const jobs = yield* Job.Service
+  yield* restart.resumeSuspendedSessions
+  const resume = yield* execution.resume(parent).pipe(Effect.exit)
+  yield* execution.wake(parent)
+  yield* execution.awaitIdle(parent)
+  const session = yield* store.get(parent)
+  if (!session) return yield* Effect.die("Missing suspended Session")
+  let instanceActivated = false, modelCalled = false
+  const mocks = Layer.mergeAll(
+    Layer.mock(Instance.Service, {
+      provide: () => (operation) => { instanceActivated = true; return operation as never },
+    }),
+    Layer.mock(LLMClient.Service, {
+      generate: () => Effect.sync(() => { modelCalled = true }).pipe(Effect.andThen(Effect.die("unexpected model call"))),
+    }),
+  )
+  const generation = yield* SessionGenerate.generate({ session, prompt: "must not run" }).pipe(Effect.provide(mocks), Effect.exit)
+  const rows = yield* database.db.select().from(SessionTable).all().pipe(Effect.orDie)
+  const context = yield* store.context(parent)
+  const inbox = yield* SessionInbox.list(database.db, parent)
+  const pendingJobs = (yield* jobs.pendingBackground).map((job) => ({ id: job.id, status: job.status }))
+  yield* Effect.promise(() => Bun.write(`${root}/resume.json`, JSON.stringify({
+    rows: rows.map((row) => ({ id: row.id, suspended: row.time_suspended, attempts: row.resume_attempts })),
+    contextCount: context.length, inboxCount: inbox.length,
+    resumeRefused: Exit.isFailure(resume) && Cause.squash(resume.cause) instanceof SessionModelTransportJournal.PriorAcquisitionUnresolved,
+    generationRefused: Exit.isFailure(generation) && Cause.squash(generation.cause) instanceof SessionModelTransportJournal.PriorAcquisitionUnresolved,
+    instanceActivated, modelCalled,
+    pendingJobs,
+  })))
+}).pipe(Effect.provide(graph))))
diff --git a/packages/core/test/fixture/ripgrep-install-journal.ts b/packages/core/test/fixture/ripgrep-install-journal.ts
new file mode 100644
index 0000000..f3857a2
--- /dev/null
+++ b/packages/core/test/fixture/ripgrep-install-journal.ts
@@ -0,0 +1,162 @@
+import path from "path"
+import { Cause, Context, Effect, Exit, Layer, Scope, Stream } from "effect"
+import { HttpClient, HttpClientResponse } from "effect/http"
+import { ChildProcess } from "effect/process"
+import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
+import { like } from "drizzle-orm"
+import { CrossSpawnSpawner } from "@opencode/util/cross-spawn-spawner"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Global } from "@opencode/util/global"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { LayerNodePlatform } from "@opencode/util/effect/app-node-platform"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Database } from "@opencode/core/database/database"
+import { KVTable } from "@opencode/core/kv/sql"
+import { RipgrepBinary } from "@opencode/core/ripgrep/binary"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+
+const root = process.argv[2]!
+const mode = process.argv[3]!
+
+await Effect.gen(function* () {
+  const fs = yield* FSUtil.Service
+  const global = yield* Global.Service
+  const spawner = yield* ChildProcessSpawner
+  const bin = path.join(root, "bin")
+  const target = path.join(bin, "rg")
+  const effects = { downloads: 0, extractions: 0, observed: false }
+  yield* fs.ensureDir(bin)
+  const http = HttpClient.make((request) =>
+    Effect.gen(function* () {
+      effects.downloads++
+      if (mode === "inspect" || mode === "prepare") return yield* Effect.die("unexpected installation replay")
+      const filename = new URL(request.url).pathname.split("/").at(-1)!
+      const archiveRoot = filename.slice(0, -".tar.gz".length)
+      const staging = path.join(root, "staging")
+      const archive = path.join(root, "fixture.tar.gz")
+      yield* fs.writeWithDirs(path.join(staging, archiveRoot, "rg"), "offline process fixture, never executed\n")
+      yield* Effect.scoped(
+        Effect.gen(function* () {
+          const handle = yield* spawner.spawn(
+            ChildProcess.make("tar", ["-czf", archive, "-C", staging, archiveRoot], {
+              stdin: "ignore",
+              stdout: "ignore",
+            }),
+          )
+          const [code, errors] = yield* Effect.all(
+            [handle.exitCode, Stream.mkString(Stream.decodeText(handle.stderr))],
+            { concurrency: "unbounded" },
+          )
+          if (code !== 0) return yield* Effect.die(new Error(errors))
+        }),
+      )
+      return HttpClientResponse.fromWeb(request, new Response(Uint8Array.from(yield* fs.readFile(archive))))
+    }).pipe(Effect.orDie),
+  )
+  const layer = AppNodeBuilder.build(LayerNode.group([RipgrepBinary.node, ReservationAuthority.node, Database.node]), [
+    Global.node.replace(Layer.succeed(Global.Service, { ...global, bin })),
+    Database.node.replace(Database.configured({ path: path.join(root, "installer.sqlite") })),
+    LayerNodePlatform.httpClient.replace(Layer.succeed(HttpClient.HttpClient, http)),
+    CrossSpawnSpawner.node.replace(
+      Layer.succeed(ChildProcessSpawner, {
+        ...spawner,
+        spawn: (command) =>
+          Effect.sync(() => {
+            effects.extractions++
+          }).pipe(Effect.andThen(spawner.spawn(command))),
+      }),
+    ),
+    FSUtil.node.replace(
+      Layer.succeed(FSUtil.Service, {
+        ...fs,
+        isFile: (value) =>
+          Effect.gen(function* () {
+            if (!value.startsWith(bin + path.sep)) return false
+            if (mode === "race" && value === target && !effects.observed) {
+              effects.observed = true
+              if (!process.send) return yield* Effect.die("fixture IPC required")
+              process.send({ type: "target-absent" })
+              yield* Effect.promise(() => Bun.stdin.text())
+              return false
+            }
+            return yield* fs.isFile(value)
+          }),
+        writeWithDirs: (value, bytes, permissions) =>
+          fs.writeWithDirs(value, bytes, permissions).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                if (mode === "archive-crash" && value.endsWith(".tar.gz")) process.exit(81)
+              }),
+            ),
+          ),
+        copyFile: (from, to) =>
+          fs.copyFile(from, to).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                if (mode === "copy-crash" && to === target) process.exit(82)
+              }),
+            ),
+          ),
+        chmod: (value, permissions) =>
+          fs.chmod(value, permissions).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                if (mode === "chmod-crash" && value === target) process.exit(83)
+              }),
+            ),
+          ),
+        remove: (value, options) =>
+          fs.remove(value, options).pipe(
+            Effect.tap(() =>
+              Effect.sync(() => {
+                if (mode === "cleanup-crash" && value.endsWith(".tar.gz")) process.exit(84)
+              }),
+            ),
+          ),
+      }),
+    ),
+  ])
+  const owner = yield* Scope.Scope
+  const context = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(owner))
+  const binary = Context.get(context, RipgrepBinary.Service)
+  const authority = Context.get(context, ReservationAuthority.Service)
+  const database = Context.get(context, Database.Service)
+  const refused = authority.withStable(Effect.void).pipe(
+    Effect.exit,
+    Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+  )
+  const blockedBefore = yield* refused
+  const result = mode === "prepare" ? Exit.succeed("") : yield* binary.filepath.pipe(Effect.exit)
+  const intents = yield* database.db
+    .select()
+    .from(KVTable)
+    .where(like(KVTable.key, "ripgrep-install-intent:v1:%"))
+    .all()
+    .pipe(Effect.orDie)
+  const receipts = yield* database.db
+    .select()
+    .from(KVTable)
+    .where(like(KVTable.key, "ripgrep-install-receipt:v1:%"))
+    .all()
+    .pipe(Effect.orDie)
+  const entries = yield* fs.readDirectory(bin)
+  console.log(
+    JSON.stringify({
+      blockedBefore,
+      blockedAfter: yield* refused,
+      failed: Exit.isFailure(result),
+      typedFailure: Exit.isFailure(result) && Cause.hasFails(result.cause),
+      downloads: effects.downloads,
+      extractions: effects.extractions,
+      intents: intents.length,
+      receipts: receipts.length,
+      target: yield* fs.isFile(target),
+      archive: entries.some((entry) => entry.endsWith(".tar.gz")),
+      temporary: entries.filter((entry) => entry.startsWith("ripgrep-") && !entry.endsWith(".tar.gz")).length,
+    }),
+  )
+}).pipe(
+  Effect.scoped,
+  Effect.provide(AppNodeBuilder.build(LayerNode.group([FSUtil.node, Global.node, CrossSpawnSpawner.node]))),
+  Effect.runPromise,
+)
