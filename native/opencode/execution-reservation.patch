index 0000000..a1aaab6
--- /dev/null
+++ b/packages/core/test/ripgrep-authority.test.ts
@@ -0,0 +1,82 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Location } from "@opencode/core/location"
+import { Ripgrep } from "@opencode/core/ripgrep"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { tempLocationLayer } from "./fixture/location"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { it } from "./lib/effect"
+
+for (const outcome of ["success", "callback defect", "abort", "invalid pattern"] as const) {
+  it.live(`direct native ripgrep ${outcome} preserves per-invocation admission ownership`, () =>
+    Effect.gen(function* () {
+      const tmp = yield* tmpdirScoped()
+      yield* Effect.promise(() => Bun.write(path.join(tmp.path, "entry.ts"), "needle\n"))
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          AppNodeBuilder.build(LayerNode.group([Ripgrep.node, ReservationAuthority.node]), [
+            Location.node.replace(tempLocationLayer),
+          ]),
+        ),
+      ).pipe(Scope.provide(owner))
+      const ripgrep = Context.get(context, Ripgrep.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      // Environment's Workspace dependency starts an empty initial poll. Let
+      // that owned startup worker finish before testing direct-ripgrep holds.
+      yield* Effect.yieldNow
+      expect(yield* refused).toBe(false)
+      if (outcome === "invalid pattern") {
+        const invalid = yield* ripgrep.grep({ cwd: tmp.path, pattern: "[", limit: 10 }).pipe(Effect.flip)
+        expect(invalid._tag).toBe("Ripgrep.InvalidPatternError")
+      }
+      if (outcome !== "invalid pattern") {
+        const ready = yield* Deferred.make<void>()
+        const held = yield* authority
+          .withStable(Deferred.succeed(ready, undefined).pipe(Effect.andThen(Effect.never)))
+          .pipe(Effect.exit, Effect.forkScoped)
+        yield* Deferred.await(ready)
+        const entered = yield* Deferred.make<void>()
+        const release = yield* Deferred.make<void>()
+        const controller = new AbortController()
+        const scanning = yield* ripgrep
+          .find({
+            cwd: tmp.path,
+            pattern: "*",
+            limit: 10,
+            signal: controller.signal,
+            onEntry: () =>
+              Deferred.succeed(entered, undefined).pipe(
+                Effect.andThen(Deferred.await(release)),
+                Effect.andThen(outcome === "callback defect" ? Effect.die("fixture onEntry failed") : Effect.void),
+              ),
+          })
+          .pipe(Effect.exit, Effect.forkScoped)
+        yield* Effect.gen(function* () {
+          yield* Deferred.await(entered)
+          expect(yield* refused).toBe(true)
+          const invalidated = yield* Fiber.join(held)
+          expect(Exit.isFailure(invalidated) && Cause.hasInterruptsOnly(invalidated.cause)).toBe(true)
+          if (outcome === "abort") controller.abort()
+          if (outcome !== "abort") yield* Deferred.succeed(release, undefined)
+          expect(Exit.isSuccess(yield* Fiber.join(scanning))).toBe(outcome === "success")
+        }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+      }
+      expect(yield* refused).toBe(outcome !== "success")
+      expect(yield* ripgrep.glob({ cwd: tmp.path, pattern: "*.ts", limit: 10 })).toHaveLength(1)
+      expect(yield* refused).toBe(outcome !== "success")
+      yield* Scope.close(owner, Exit.void)
+      const stale = yield* ripgrep.glob({ cwd: tmp.path, pattern: "*.ts", limit: 10 }).pipe(Effect.exit)
+      expect(Exit.isFailure(stale) && Cause.hasInterruptsOnly(stale.cause)).toBe(true)
+      expect(yield* refused).toBe(outcome !== "success")
+    }),
+  )
+}
