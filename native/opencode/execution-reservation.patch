+  Effect.gen(function* () {
+    const policy = yield* ManagedPolicy.Service
+    const authority = yield* ReservationAuthority.Service
+    const rule: { action: "tool.use"; resource: string; effect: "allow" | "deny" } =
+      { action: "tool.use", resource: "shell:*", effect: "deny" }
+    const input = { organization: "fixture", statements: [rule] }
+    const dispatched = policy.set(input)
+    rule.effect = "allow"
+    input.statements.push({ action: "tool.use", resource: "read:*", effect: "allow" })
+    yield* dispatched
+    expect(policy.current()).toEqual({ organization: "fixture", statements: [{ action: "tool.use", resource: "shell:*", effect: "deny" }] })
+    const revision = yield* authority.revision
+    const current = policy.current()
+    const observed = current.statements[0]
+    if (!observed) return yield* Effect.die("Missing managed policy rule")
+    // Reflect.set reports failed writes to frozen values without throwing.
+    // eslint-disable-next-line no-restricted-globals
+    expect(Reflect.set(observed, "effect", "allow")).toBe(false)
+    // eslint-disable-next-line no-restricted-globals
+    expect(Reflect.set(current.statements, "0", { action: "tool.use", resource: "shell:*", effect: "allow" })).toBe(false)
+    // eslint-disable-next-line no-restricted-globals
+    expect(Reflect.set(current, "organization", "changed")).toBe(false)
+    rule.resource = "*"
