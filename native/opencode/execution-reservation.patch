+    endpoint: resolved.model.route.endpoint, transport: resolved.model.route.transport,
+    body: resolved.model.route.body, auth: resolved.model.route.auth, methods: routeMethods(resolved.model.route),
+    observation: Object.freeze({
+      phase: "native-model-resolution",
+      package: runtime?.package,
+      ref: Object.freeze({ ...resolved.ref }),
+      route: Object.freeze({
+        id: resolved.model.route.id,
+        protocol: resolved.model.route.protocol,
+        endpoint: nativeEndpoint,
+      }),
+      configuration,
+      connection: input.connection,
+      credential,
+      unresolved: Object.freeze(unresolved),
+    }),
+  })
