+                  yield* NativeMovementProtection.protectPluginMembership(db, input.pluginID)
+                  const intent = MovementFence.Intent.make({
+                    version: 1,
+                    phase: "quarantined",
+                    sessionID: request.sessionID,
+                    transitionID: request.transitionID,
+                    directory: request.directory,
+                    pluginID: input.pluginID,
+                    ...principal,
+                    leaseIncarnation,
+                    membershipFence: 1,
+                    source: input.location,
+                  })
+                  if (!(yield* MovementFence.insert(db, intent)))
+                    return yield* new OwnerRefused({ message: "Concurrent movement owns the Session" })
+                  yield* execution.assertNoMovementBackground!(request.sessionID)
+                  // Revalidate after asynchronous native storage, before committing its intent.
+                  yield* owned(request.sessionID)
+                  return intent
+                }),
+              )
+              .pipe(Effect.catchTag("SqlError", Effect.die)),
+          )
+        }),
+      }
+      placementOwners.set(result, makePlacementOwner)
+      return result
+    })
+  return Service.of({ forActivation })
+})
+
+export const layer = Layer.effect(Service, make())
+export const node = makeGlobalNode({
+  service: Service,
+  layer,
+  deps: [
+    Database.node,
+    Job.node,
+    SessionExecution.node,
+    SessionStore.node,
+    LocationServiceMap.node,
+    ReservationAuthority.node,
+    SessionModelTransport.node,
