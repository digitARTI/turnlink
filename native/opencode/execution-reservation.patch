+// Explicit isolated stdio host. The inherited descriptor is a native owner
+// capability; broker authorization remains the caller's responsibility.
+import { ensurePluginRuntime } from "@opencode/plugin/runtime"
+import { NodeRuntime } from "@effect/platform-node"
+import { Schema } from "effect"
+import { ServerProcess } from "./server-process"
+import { turnlinkHostedShim } from "@opencode/server/turnlink-hosted-shim"
+
+const Config = Schema.Struct({
+  fd: Schema.Int.check(Schema.isGreaterThanOrEqualTo(3)),
+  pluginID: Schema.String,
+  sessionID: Schema.String,
+  directory: Schema.String,
+  workspaceID: Schema.optional(Schema.String),
+  hostedFd: Schema.optional(Schema.Literal(5)),
+})
+
+ensurePluginRuntime()
+const input = Schema.decodeUnknownSync(Schema.fromJsonString(Config))(process.argv[2])
+if (input.hostedFd !== undefined && (input.pluginID !== "turnlink" || input.workspaceID !== undefined)) throw new Error("Hosted plugin unavailable")
+const { hostedFd, ...native } = input
+ServerProcess.run({ mode: "stdio", hostname: "127.0.0.1", port: 0, readyFd: 4, nativeMovementControl: { ...native, mode: "live" },
+  ...(hostedFd === undefined ? {} : { hostedPlugin: turnlinkHostedShim({ fd: hostedFd, sessionID: input.sessionID, directory: input.directory }) }) })
+  .pipe(NodeRuntime.runMain({ disableErrorReporting: true }))
