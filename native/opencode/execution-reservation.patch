diff --git a/packages/core/src/plugin/provider/refresh-authority.ts b/packages/core/src/plugin/provider/refresh-authority.ts
new file mode 100644
index 0000000..93ad0e7
--- /dev/null
+++ b/packages/core/src/plugin/provider/refresh-authority.ts
@@ -0,0 +1,48 @@
+export * as RefreshAuthority from "./refresh-authority.js"
+
+import { Effect, Exit, Schedule, type Duration } from "effect"
+import { ReservationAuthority } from "../../session/reservation-authority.js"
+
+/** Scoped native snapshot work, never task/model execution or replay. */
+export const make = Effect.gen(function* () {
+  const authority = yield* ReservationAuthority.Service
+  const changes = yield* authority.trackChanges
+  const observe = <E, R>(refresh: () => Effect.Effect<boolean, E, R>) => Effect.acquireUseRelease(
+    Effect.sync(changes.holdUnsafe),
+    (release) => release ? Effect.gen(function* () {
+      const revision = yield* changes.revision
+      if (yield* Effect.suspend(refresh)) yield* changes.settle(revision)
+    }).pipe(
+      Effect.onExit((exit) => Exit.isFailure(exit) ? changes.mark : Effect.void),
+      authority.withMutation,
+    ) : Effect.interrupt,
+    (release) => release ?? Effect.void,
+  )
+  const run = <E, R>(refresh: () => Effect.Effect<void, E, R>) =>
+    observe(() => Effect.suspend(refresh).pipe(Effect.as(true)))
+  const forkObservation = <E, R>(
+    refresh: () => Effect.Effect<boolean, E, R>,
+    interval?: Duration.Input,
+    options: { ignoreErrors?: boolean } = {},
+  ) => Effect.acquireUseRelease(
+    Effect.sync(() => ({ release: changes.holdUnsafe(), transferred: false })),
+    (entry) => {
+      const release = entry.release
+      if (!release) return Effect.interrupt
+      // The counted hold covers initial dispatch only. Later iterations acquire
+      // their own run guard after waking; no authority is held during sleep.
+      const first = observe(refresh).pipe(Effect.ensuring(release))
+      const pass = options.ignoreErrors ? first.pipe(Effect.ignore) : first
+      const worker = interval === undefined ? pass : pass.pipe(Effect.repeat(Schedule.spaced(interval)), Effect.asVoid)
+      return Effect.uninterruptible(Effect.gen(function* () {
+        const fiber = yield* worker.pipe(Effect.forkScoped)
+        entry.transferred = true
+        return fiber
+      }))
+    },
+    (entry) => entry.transferred ? Effect.void : entry.release ?? Effect.void,
+  )
+  const fork = <E, R>(refresh: () => Effect.Effect<void, E, R>, interval?: Duration.Input) =>
+    forkObservation(() => Effect.suspend(refresh).pipe(Effect.as(true)), interval)
+  return { run, fork, observe, forkObservation, uncertain: changes.mark }
+})
