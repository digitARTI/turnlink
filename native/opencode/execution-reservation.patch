+    console.log(JSON.stringify({ ...report, blockedAfter: false, intents: 0 }) + "\nfixture log after report")
+}).pipe(
+  Effect.scoped,
+  Effect.provide(
+    Layer.provideMerge(
+      AppNodeBuilder.build(
+        LayerNode.group([
+          Workspace.configured({ idleThreshold: "1 minute", pollInterval: "1 minute" }),
+          Database.node,
+          ReservationAuthority.node,
+        ]),
+        [
+          Database.node.replace(Database.configured({ path: path.join(root, "workspace.sqlite") })),
+          WorkspaceDriver.node.replace(
+            WorkspaceDriver.registryNode(
+              mode === "missing"
+                ? {}
+                : {
+                    fixture: driver,
+                    other: WorkspaceDriver.make({ ...driver, destroy: () => Effect.void }),
+                  },
+            ),
+          ),
+        ],
+      ),
+      TestClock.layer(),
+    ),
+  ),
+  Effect.runPromise,
+)
