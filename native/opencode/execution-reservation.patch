+  Effect.fail(
+    systemError({
+      _tag: "PermissionDenied",
+      module: "FileSystem",
+      method,
+      pathOrDescriptor: file,
+      description: "controlled Git seed/observation fault",
+    }),
+  )
+
+for (const outcome of [
+  "absent seed",
+  "successful copy",
+  "seed observation failure",
+  "copy failure",
+  "lost copy receipt",
+  "seed disappeared",
+  "initial HEAD observation failure",
+  "existing HEAD observation failure",
+  "fallback HEAD observation failure",
+] as const) {
+  it.live(`Git creation ${outcome} separates optional absence from failed observations and receipts`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const seed = path.join(project, ".git", "index")
+      yield* Effect.promise(async () => {
+        await initRepo(project)
+        if (outcome === "absent seed") return
+        await Bun.write(path.join(project, "tracked.txt"), "seed content\n")
+        await $`git add tracked.txt`.cwd(project).quiet()
+      })
+      if (outcome === "absent seed") yield* fs.remove(seed, { force: true })
+      const original = outcome === "absent seed" ? undefined : yield* fs.readFile(seed)
+      const gate = { armed: false, heads: 0, seeds: 0, copies: 0, writes: 0, refused: Effect.succeed(false) }
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  exists: (file) => {
+                    if (!gate.armed || (file !== path.join(store, "HEAD") && file !== seed)) return fs.exists(file)
+                    return Effect.gen(function* () {
+                      expect(yield* gate.refused).toBe(true)
+                      if (file === seed) {
+                        gate.seeds++
+                        if (outcome === "seed observation failure") return yield* denied("exists", file)
+                      }
+                      if (file === path.join(store, "HEAD")) {
+                        gate.heads++
+                        if (
+                          outcome === "initial HEAD observation failure" ||
+                          outcome === "existing HEAD observation failure" ||
+                          (outcome === "fallback HEAD observation failure" && gate.heads === 2)
+                        )
+                          return yield* denied("exists", file)
+                      }
+                      return yield* fs.exists(file)
+                    })
+                  },
+                  copyFile: (from, to) => {
+                    if (!gate.armed || from !== seed) return fs.copyFile(from, to)
+                    return Effect.gen(function* () {
+                      gate.copies++
+                      expect(yield* gate.refused).toBe(true)
+                      if (outcome === "copy failure") return yield* denied("copyFile", from)
+                      if (outcome === "seed disappeared") yield* fs.remove(from)
+                      yield* fs.copyFile(from, to)
+                      if (outcome === "lost copy receipt") return yield* denied("copyFile", from)
+                    })
+                  },
+                  writeFileString: (file, value, options) => {
+                    if (gate.armed && path.basename(file) === "opencode.gitconfig") gate.writes++
+                    return fs.writeFileString(file, value, options)
+                  },
+                  rename: (from, to) =>
