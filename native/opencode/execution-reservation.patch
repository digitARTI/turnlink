--- /dev/null
+++ b/packages/core/src/session/placement-completion.ts
@@ -0,0 +1,97 @@
+export * as SessionPlacementCompletion from "./placement-completion.js"
+
+import { randomUUID } from "node:crypto"
+import { isDeepStrictEqual } from "node:util"
+import { eq, sql } from "drizzle-orm"
+import { Effect, Schema } from "effect"
+import { Database } from "../database/database.js"
+import { NativeMovementConnection } from "../database/movement-connection.js"
+import { KVTable } from "../kv/sql.js"
+import { SessionExecution } from "./execution.js"
+import { MovementFence } from "./movement-fence.js"
+import { SessionMembershipSeal } from "./membership-seal.js"
+import { SessionPlacementReceipt } from "./placement-receipt.js"
+import { SessionSchema } from "./schema.js"
+
+const prefix = "native-session-placement-completion:v1:"
+const key = (sessionID: SessionSchema.ID, transitionID: string) => prefix + sessionID + ":" + transitionID
+const Record = Schema.Struct({ version: Schema.Literal(1), placement: SessionPlacementReceipt.Record,
+  leaseIncarnation: Schema.String, token: Schema.String })
+type Record = typeof Record.Type
+
+/** Historical evidence only: subsequent legitimate Session and membership writes may change current state. */
+export const find = Effect.fn("SessionPlacementCompletion.find")(function* (
+  db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string,
+) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, key(sessionID, transitionID))).get().pipe(Effect.orDie)
+  if (!row) return
+  const record = yield* Schema.decodeUnknownEffect(Record)(row.value).pipe(Effect.orDie)
+  const receipt = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, SessionPlacementReceipt.prefix + sessionID + ":" + transitionID)).get().pipe(Effect.orDie)
+  if (record.placement.sessionID !== sessionID || record.placement.transitionID !== transitionID || !receipt ||
+    !isDeepStrictEqual(receipt.value, Schema.encodeSync(SessionPlacementReceipt.Record)(record.placement)))
+    return yield* Effect.die("Native completion does not match the durable placement")
+  return record
+})
+
+/** Internal transaction engine. The caller must establish destination authority,
+ * resource readiness and a held broker receiver before invoking it. */
+export const complete = (input: { readonly database: Database.Interface; readonly execution: SessionExecution.Interface;
+  readonly owner: MovementFence.Owner; readonly placement: SessionPlacementReceipt.Record }) => {
+  const db = input.database.db, movement = input.database.movement, execution = input.execution, owner = input.owner
+  if (!SessionExecution.ownsNativeReservation(execution, db) || !execution.withMovementCompletion ||
+    !execution.assertMovementModelTransportClear || !execution.assertNoMovementBackground)
+    return Effect.die("Native completion requires the execution reservation")
+  const placement = Schema.decodeUnknownSync(SessionPlacementReceipt.Record)(Schema.encodeSync(SessionPlacementReceipt.Record)(input.placement))
+  const operation = Effect.gen(function* () {
+    if (!movement) return yield* Effect.die("Native completion requires compatible storage")
+    const sessionID = yield* MovementFence.ownerSession(db, owner)
+    if (sessionID !== placement.sessionID) return yield* Effect.die("Native completion owner mismatch")
+    const lease = yield* movement.claim.pipe(Effect.orDie)
+    const token = randomUUID()
+    const capability = `native-placement-completion:${sessionID}`
+    return yield* db.transaction(() => Effect.gen(function* () {
+      yield* MovementFence.assertOwner(db, owner)
+      if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native completion lease changed")
+      yield* execution.assertMovementModelTransportClear!(owner)
+      yield* execution.assertNoMovementBackground!(sessionID).pipe(Effect.orDie)
+      const current = yield* SessionPlacementReceipt.find(db, sessionID, placement.transitionID)
+      const seal = yield* SessionMembershipSeal.find(db, sessionID)
+      if (!current || !seal || !isDeepStrictEqual(current, placement)) return yield* Effect.die("Native completion placement changed")
+      const fn = sql.raw(NativeMovementConnection.functionName)
+      for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+        const condition = operation === "INSERT" ? sql`
+          NEW.key LIKE ${prefix + "%"} AND (NEW.key IS NOT (${prefix} || json_extract(NEW.value, '$.placement.sessionID') || ':' || json_extract(NEW.value, '$.placement.transitionID'))
+            OR EXISTS (SELECT 1 FROM ${KVTable} AS existing WHERE existing.key = NEW.key)
+            OR NOT ${fn}('native-placement-completion:' || json_extract(NEW.value, '$.placement.sessionID'), json_extract(NEW.value, '$.token')))
+        ` : operation === "UPDATE" ? sql`OLD.key LIKE ${prefix + "%"} OR NEW.key LIKE ${prefix + "%"}` : sql`OLD.key LIKE ${prefix + "%"}`
+        yield* db.run(sql`CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_placement_completion_v1_${operation.toLowerCase()}`)}
+          BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+          BEGIN SELECT RAISE(ABORT, 'NATIVE_PLACEMENT_COMPLETION_REFUSED'); END`.inlineParams()).pipe(Effect.orDie)
+      }
+      const record = Record.make({ version: 1, placement, leaseIncarnation: lease, token })
+      yield* movement.authorize(capability, token).pipe(Effect.orDie)
+      yield* db.insert(KVTable).values({ key: key(sessionID, placement.transitionID), value: Schema.encodeSync(Record)(record) }).run().pipe(
+        Effect.orDie, Effect.ensuring(movement.revoke(capability, token)),
+      )
+      yield* MovementFence.assertOwner(db, owner)
+      if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native completion lease changed")
+      yield* execution.assertNoMovementBackground!(sessionID).pipe(Effect.orDie)
+      const sealCapability = `membership-seal:${sessionID}`
+      yield* movement.authorize(sealCapability, seal.binding).pipe(Effect.orDie)
+      yield* db.delete(KVTable).where(eq(KVTable.key, SessionMembershipSeal.prefix + sessionID)).run().pipe(
+        Effect.orDie, Effect.ensuring(movement.revoke(sealCapability, seal.binding)),
+      )
+      yield* db.delete(KVTable).where(eq(KVTable.key, `session-movement-recovery:v1:${sessionID}`)).run().pipe(Effect.orDie)
+      yield* db.delete(KVTable).where(eq(KVTable.key, `session-movement-transport-release:v1:${sessionID}`)).run().pipe(Effect.orDie)
+      yield* db.delete(KVTable).where(eq(KVTable.key, `session-movement-intent:v1:${sessionID}`)).run().pipe(Effect.orDie)
+      yield* execution.assertNoMovementBackground!(sessionID).pipe(Effect.orDie)
+      return record
+    })).pipe(Effect.catchTag("SqlError", Effect.die))
+  })
+  return execution.withMovementCompletion(owner, Effect.uninterruptible(operation), (record) => Effect.gen(function* () {
+    const observed = yield* find(db, record.placement.sessionID, record.placement.transitionID)
+    if (!observed || !isDeepStrictEqual(observed, record) || (yield* MovementFence.find(db, record.placement.sessionID)))
+      return yield* Effect.die("Native completion could not be observed")
+  }))
+}
