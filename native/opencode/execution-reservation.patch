+              Effect.gen(function* () {
+                creations++
+                yield* Effect.addFinalizer(() =>
+                  Deferred.succeed(cleaning, undefined).pipe(
+                    Effect.andThen(Deferred.await(cleanup)),
+                    Effect.andThen(
+                      outcome === "cleanup failure" ? Effect.die("fixture repository cleanup failed") : Effect.void,
+                    ),
+                  ),
