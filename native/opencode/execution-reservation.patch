+++ b/packages/core/test/filesystem/fff-authority.test.ts
@@ -0,0 +1,58 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { Fff } from "#fff"
+import { FileSystemSearch } from "@opencode/core/filesystem/search"
+import { Location } from "@opencode/core/location"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { location } from "../fixture/location"
+import { tmpdirScoped } from "../fixture/tmpdir"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(ReservationAuthority.layer)
+// Real fff native availability is a platform capability; no synthetic backend
+// or module mock substitutes for its initialization/destruction contract here.
+const nativeTest = Fff.available() ? it.live : it.live.skip
+
+for (const outcome of ["healthy", "initialization failure"] as const) {
+  nativeTest(`native fff ${outcome} retains ownership until applicable cleanup`, () =>
+    Effect.gen(function* () {
+      const authority = yield* ReservationAuthority.Service
+      const tmp = yield* tmpdirScoped()
+      const directory = outcome === "healthy" ? tmp.path : path.join(tmp.path, "absent")
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      expect(yield* refused).toBe(false)
+      const ready = yield* Deferred.make<void>()
+      const held = yield* authority
+        .withStable(Deferred.succeed(ready, undefined).pipe(Effect.andThen(Effect.never)))
+        .pipe(Effect.exit, Effect.forkScoped)
+      yield* Deferred.await(ready)
+      const layer = FileSystemSearch.fffLayer.pipe(
+        Layer.provide(
+          Layer.merge(
+            Layer.succeed(Location.Service, location({ directory: AbsolutePath.make(directory) })),
+            Layer.succeed(ReservationAuthority.Service, authority),
+          ),
+        ),
+      )
+      const context = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(owner))
+      const search = Context.get(context, FileSystemSearch.Service)
+      expect(yield* search.find({ query: "absent" })).toEqual([])
+      expect(yield* refused).toBe(true)
+      const invalidated = yield* Fiber.join(held)
+      expect(Exit.isFailure(invalidated) && Cause.hasInterruptsOnly(invalidated.cause)).toBe(true)
+      yield* Scope.close(owner, Exit.void)
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(outcome !== "healthy")
+      const stale = yield* search.find({ query: "absent" }).pipe(Effect.exit)
+      expect(Exit.isFailure(stale) && Cause.hasInterruptsOnly(stale.cause)).toBe(true)
+      expect(yield* refused).toBe(outcome !== "healthy")
+    }),
+  )
+}
