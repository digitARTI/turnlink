@@ -0,0 +1,80 @@
+import { Option, Schema } from "effect"
+import { Workspace } from "@opencode/core/workspace"
+
+export const WorkspaceJournalReport = Schema.Struct({
+  blockedBefore: Schema.Boolean,
+  blockedAfter: Schema.Boolean,
+  hasRow: Schema.Boolean,
+  hasBinding: Schema.Boolean,
+  suspendedBinding: Schema.Boolean,
+  connectedBinding: Schema.Boolean,
+  intents: Schema.Number,
+  resource: Schema.Boolean,
+  failed: Schema.Boolean,
+  provisionRefused: Schema.Boolean,
+  connectCalls: Schema.optional(Schema.Number),
+  idleCalls: Schema.optional(Schema.Number),
+  readmissionRefused: Schema.optional(Schema.Boolean),
+  destroyCalls: Schema.optional(Schema.Number),
+  replayRefused: Schema.optional(Schema.Boolean),
+})
+const binding = { id: Workspace.ID, mode: Schema.String }
+const message = Schema.Union([
+  Schema.Struct({ type: Schema.Literal("provider-paused"), ...binding }),
+  Schema.Struct({ type: Schema.Literal("workspace-journal-report"), ...binding, report: WorkspaceJournalReport }),
+])
+export const WorkspaceJournalAck = Schema.Struct({ type: Schema.Literal("workspace-journal-ack"), ...binding })
+const decode = Schema.decodeUnknownOption(message, { onExcessProperty: "error" })
+
+// Fixture transport only. No stdout parsing, native-owner authentication or
+// production cleanup/admission authority is conferred by this acknowledgement.
+export function makeWorkspaceJournalIPC(input: { id: Workspace.ID; mode: string; paused?: boolean }) {
+  const ready = Promise.withResolvers<void>()
+  const state: { paused: boolean; value?: typeof WorkspaceJournalReport.Type; error?: Error } = { paused: false }
+  const fail = (detail: string) => {
+    state.error ??= new Error(`workspace fixture IPC: ${detail}`)
+    if (input.paused) ready.reject(state.error)
+  }
+  return {
+    ready: ready.promise,
+    get failed() {
+      return !!state.error
+    },
+    receive(value: unknown): typeof WorkspaceJournalAck.Type | undefined {
+      if (state.error) return
+      const parsed = decode(value)
+      if (Option.isNone(parsed)) {
+        fail("invalid message")
+        return
+      }
+      const event = parsed.value
+      if (event.id !== input.id || event.mode !== input.mode) {
+        fail("invocation mismatch")
+        return
+      }
+      if (event.type === "provider-paused") {
+        if (!input.paused || state.paused || state.value) {
+          fail("unexpected pause")
+          return
+        }
+        state.paused = true
+        ready.resolve()
+        return
+      }
+      if (state.value || (input.paused && !state.paused)) {
+        fail("unexpected report")
+        return
+      }
+      state.value = event.report
+      return { type: "workspace-journal-ack", id: input.id, mode: input.mode }
+    },
+    exited(code: number) {
+      if (input.paused && !state.paused) fail(`exited before provider pause: ${code}`)
+    },
+    report() {
+      if (state.error) throw state.error
+      if (!state.value) throw new Error("workspace fixture IPC: missing report")
+      return state.value
+    },
+  }
+}
