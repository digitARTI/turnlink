+++ b/packages/core/test/git-orphan-artifact-authority.test.ts
@@ -0,0 +1,96 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Effect, Exit, Layer, Scope } from "effect"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+
+for (const extension of [".idx", ".rev", ".bitmap", ".mtimes"] as const) {
+  for (const missing of extension === ".idx" ? [".pack"] : [".pack", ".idx", "both partners"]) {
+    for (const old of [false, true]) {
+      it.live(`Git preserves ${old ? "old" : "recent"} ${extension} evidence missing ${missing}`, () =>
+        Effect.gen(function* () {
+          const fs = yield* FSUtil.Service
+          const tmp = yield* tmpdirScoped()
+          const project = path.join(tmp.path, "project")
+          const store = AbsolutePath.make(path.join(tmp.path, "store"))
+          const directory = path.join(store, "objects", "pack")
+          yield* Effect.promise(async () => {
+            await Bun.write(path.join(project, "tracked.txt"), "content\n")
+            await initRepo(project)
+          })
+          const dispatched = { locks: 0 }
+          const owner = yield* Scope.make()
+          yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+          const context = yield* Layer.build(
+            Layer.fresh(
+              LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+                replacements: [
+                  FSUtil.node.replace(
+                    Layer.succeed(FSUtil.Service, {
+                      ...fs,
+                      writeFileString: (file, value, options) => {
+                        if (file === path.join(store, "opencode-pack.lock")) dispatched.locks++
+                        return fs.writeFileString(file, value, options)
+                      },
+                    }),
+                  ),
+                ],
+              }),
+            ),
+          ).pipe(Scope.provide(owner))
+          const git = Context.get(context, Git.Service)
+          const authority = Context.get(context, ReservationAuthority.Service)
+          const refused = authority.withStable(Effect.void).pipe(
+            Effect.exit,
+            Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+          )
+          const source = yield* git.repo.discover(AbsolutePath.make(project))
+          if (!source) return yield* Effect.die("fixture project is not a repository")
+          const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+          const capture = git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+          const tree = yield* capture
+          expect(yield* refused).toBe(false)
+          // Opaque evidence fixtures exercise filename classification, not native pack validity.
+          const artifacts = [
+            extension,
+            ...[".pack", ".idx"].filter(
+              (partner) => missing !== "both partners" && partner !== missing && partner !== extension,
+            ),
+          ]
+          yield* Effect.forEach(artifacts, (suffix) =>
+            Effect.gen(function* () {
+              const file = path.join(directory, `pack-unowned${suffix}`)
+              yield* fs.writeFileString(file, `opaque:${suffix}\n`)
+              if (old) yield* fs.utimes(file, new Date(0), new Date(0))
+            }),
+          )
+          yield* git.objects.pack(repository)
+          expect(yield* refused).toBe(true)
+          expect(dispatched.locks).toBe(0)
+          expect((yield* fs.readDirectory(directory)).toSorted()).toEqual(
+            artifacts.map((suffix) => `pack-unowned${suffix}`).toSorted(),
+          )
+          yield* Effect.forEach(artifacts, (suffix) =>
+            Effect.gen(function* () {
+              expect(yield* fs.readFileString(path.join(directory, `pack-unowned${suffix}`))).toBe(`opaque:${suffix}\n`)
+            }),
+          )
+          yield* Effect.forEach(artifacts, (suffix) => fs.remove(path.join(directory, `pack-unowned${suffix}`)))
+          yield* git.objects.pack(repository)
+          expect(yield* capture).toBe(tree)
+          expect(yield* refused).toBe(true)
+          yield* Scope.close(owner, Exit.void)
+          expect(yield* refused).toBe(true)
+        }),
+      )
+    }
+  }
+}
