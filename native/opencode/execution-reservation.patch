diff --git a/packages/core/src/database/movement-connection.ts b/packages/core/src/database/movement-connection.ts
new file mode 100644
index 0000000..801cb18
--- /dev/null
+++ b/packages/core/src/database/movement-connection.ts
@@ -0,0 +1,138 @@
+export * as NativeMovementConnection from "./movement-connection.js"
+
+import { randomUUID } from "node:crypto"
+import { closeSync, lstatSync, openSync, realpathSync, statSync } from "node:fs"
+import { Context, Effect, Schema } from "effect"
+
+export const functionName = "opencode_movement_connection_v1"
+export const lockPath = (filename: string) => filename + ".native-movement-owner.sqlite"
+
+export class OwnerRefused extends Schema.TaggedError<OwnerRefused>()("NativeMovementConnection.OwnerRefused", {
+  message: Schema.String,
+}) {}
+
+export interface Interface {
+  readonly claim: Effect.Effect<string, OwnerRefused>
+  readonly authorize: (sessionID: string, binding: string) => Effect.Effect<void, OwnerRefused>
+  readonly revoke: (sessionID: string, binding: string) => Effect.Effect<void>
+  readonly owns: (sessionID: string, binding: string) => boolean
+  readonly retainUntilExit: Effect.Effect<void, OwnerRefused>
+  readonly startRuntime: Effect.Effect<string, OwnerRefused>
+}
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/NativeMovementConnection") {}
+
+interface Lease {
+  readonly incarnation: string
+  readonly release: () => void
+  references: number
+  retained: boolean
+  compromised: boolean
+  runtimeOwner?: object
+  runtimeClosed: boolean
+  readonly valid: () => boolean
+}
+
+// Connection scopes in one process share the kernel lease, never a stale-time takeover.
+const leases = new Map<string, Lease>()
+
+export const make = Effect.fn("NativeMovementConnection.make")(function* (input: {
+  readonly filename: string
+  readonly acquire: (filename: string) => () => void
+}) {
+  const memory = input.filename === ":memory:"
+  const pathname = memory ? randomUUID() : realpathSync(input.filename)
+  const initial = memory ? undefined : statSync(pathname)
+  if (!memory && lstatSync(input.filename).isSymbolicLink())
+    return yield* new OwnerRefused({ message: "Native ownership refuses a database symlink" })
+  const valid = () => {
+    if (memory) return true
+    try {
+      const current = lstatSync(pathname)
+      return realpathSync(input.filename) === pathname && current.isFile() && current.nlink === 1 &&
+        current.dev === initial?.dev && current.ino === initial.ino
+    } catch { return false }
+  }
+  if (!valid()) return yield* new OwnerRefused({ message: "Native ownership requires a stable database identity" })
+  const key = JSON.stringify([pathname, initial?.dev, initial?.ino])
+  let lease: Lease | undefined
+  let closed = false
+  const runtimeOwner = {}
+  const bindings = new Map<string, string>()
+  yield* Effect.addFinalizer(() => Effect.sync(() => {
+    // Revoke this connection before releasing its last kernel reference.
+    closed = true
+    bindings.clear()
+    if (lease?.runtimeOwner === runtimeOwner) lease.runtimeClosed = true
+    if (!lease || --lease.references !== 0) return
+    if (lease.retained) return
+    lease.compromised = true
+    lease.release()
+    leases.delete(key)
+  }))
+  const claim = Effect.try({
+    try: () => {
+      if (closed || !valid()) throw new Error("Native connection is closed or its database identity changed")
+      if (lease) {
+        if (lease.runtimeClosed) throw new Error("Native runtime owner closed without resource settlement")
+        if (lease.compromised || !lease.valid()) throw new Error("Native ownership lock is uncertain or its identity changed")
+        return lease.incarnation
+      }
+      const existing = leases.get(key)
+      if (existing) {
+        if (existing.runtimeClosed) throw new Error("Native runtime owner closed without resource settlement")
+        if (existing.compromised || !existing.valid()) throw new Error("Native ownership lock is uncertain or its identity changed")
+        existing.references++
+        lease = existing
+        return existing.incarnation
+      }
+      const file = lockPath(pathname)
+      if (!memory) {
+        try { closeSync(openSync(file, "wx", 0o600)) }
+        catch (error) {
+          if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw error
+        }
+        const info = lstatSync(file)
+        if (!info.isFile() || info.isSymbolicLink() || info.nlink !== 1 ||
+          (process.platform !== "win32" && (info.mode & 0o077) !== 0))
+          throw new Error("Native ownership lock must be a private regular file")
+      }
+      const release = memory ? () => {} : input.acquire(file)
+      const locked = memory ? undefined : lstatSync(file)
+      const lockValid = () => {
+        if (memory) return true
+        try {
+          const current = lstatSync(file)
+          return current.isFile() && current.nlink === 1 && current.dev === locked?.dev && current.ino === locked.ino &&
+            (process.platform === "win32" || (current.mode & 0o077) === 0)
+        } catch { return false }
+      }
+      const created: Lease = { incarnation: randomUUID(), release, references: 1, retained: false,
+        compromised: false, runtimeClosed: false, valid: lockValid }
+      leases.set(key, created)
+      lease = created
+      return created.incarnation
+    },
+    catch: (cause) => new OwnerRefused({ message: cause instanceof Error ? cause.message : String(cause) }),
+  })
+  return Service.of({
+    claim,
+    startRuntime: claim.pipe(Effect.flatMap((incarnation) => Effect.try({
+      try: () => {
+        if (!lease || (lease.runtimeOwner !== undefined && lease.runtimeOwner !== runtimeOwner))
+          throw new Error("Another native runtime owner is already active")
+        lease.runtimeOwner = runtimeOwner
+        lease.retained = true
+        return incarnation
+      },
+      catch: (cause) => new OwnerRefused({ message: cause instanceof Error ? cause.message : String(cause) }),
+    }))),
+    retainUntilExit: claim.pipe(Effect.andThen(Effect.sync(() => {
+      if (lease) lease.retained = true
+    }))),
+    authorize: (sessionID, binding) => claim.pipe(Effect.andThen(Effect.sync(() => { bindings.set(sessionID, binding) }))),
+    revoke: (sessionID, binding) => Effect.sync(() => { if (bindings.get(sessionID) === binding) bindings.delete(sessionID) }),
+    owns: (sessionID, binding) => !closed && lease !== undefined && !lease.runtimeClosed && !lease.compromised &&
+      valid() && lease.valid() && bindings.get(sessionID) === binding,
+  })
+})
