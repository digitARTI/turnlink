@@ -0,0 +1,190 @@
+export * as NativeModelAuthority from "./model-authority.js"
+
+import { createHmac, randomBytes, randomUUID } from "node:crypto"
+import type { LanguageModel, ProviderPackageDefinition } from "@opencode/ai"
+import { Scope } from "effect"
+import type { ModelResolver } from "./model-resolver.js"
+import type { Credential } from "./credential.js"
+
+export interface Package {
+  readonly specifier: string
+  readonly builtin: boolean
+  readonly implementation: string
+}
+
+export interface Observation {
+  readonly phase: "native-model-resolution"
+  readonly current: boolean
+  readonly package?: Package
+  readonly ref: ModelResolver.Resolved["ref"]
+  readonly route: { readonly id: string; readonly protocol: string; readonly endpoint?: string }
+  readonly configuration?: string
+  readonly connection?: string
+  readonly credential: "key" | "oauth" | "external" | "configured" | "none" | "unresolved"
+  readonly unresolved: readonly string[]
+}
+
+interface Runtime {
+  readonly package?: Package
+  readonly settings?: string
+  readonly configuredAuth: boolean
+}
+
+const key = randomBytes(32)
+const packages = new WeakMap<ProviderPackageDefinition, Package>()
+const implementations = new WeakMap<ProviderPackageDefinition["model"], string>()
+const runtimes = new WeakMap<LanguageModel, Runtime>()
+const resolutions = new WeakMap<
+  object,
+  { readonly observation: Omit<Observation, "current">; readonly scope: Scope.Scope;
+    readonly fingerprint: string | undefined; readonly model: LanguageModel; readonly route: LanguageModel["route"];
+    readonly endpoint: LanguageModel["route"]["endpoint"]; readonly transport: LanguageModel["route"]["transport"];
+    readonly body: LanguageModel["route"]["body"]; readonly auth: LanguageModel["route"]["auth"];
+    readonly methods: readonly unknown[] }
+>()
+
+const canonical = (value: unknown): string => {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return JSON.stringify(value)
+  if (typeof value === "number" && Number.isFinite(value)) return JSON.stringify(value)
+  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]"
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null)
+  )
+    throw new Error("Native model authority contains non-data configuration")
+  return (
+    "{" +
+    Object.entries(value)
+      .filter(([, item]) => item !== undefined)
+      .sort(([a], [b]) => a.localeCompare(b))
+      .map(([name, item]) => JSON.stringify(name) + ":" + canonical(item))
+      .join(",") +
+    "}"
+  )
+}
+
+const seal = (value: unknown): string | undefined => {
+  try {
+    return createHmac("sha256", key).update(canonical(value)).digest("hex")
+  } catch {
+    return undefined
+  }
+}
+
+// Compare the selected native data again without constructing another provider.
+// Executable closure state and external services still require separate proof.
+const resolutionFingerprint = (resolved: ModelResolver.Resolved) => seal({
+  ref: resolved.ref, capabilities: resolved.capabilities, cost: resolved.cost, limit: resolved.limit,
+  compaction: resolved.compaction, transport: resolved.transport, chunkTimeout: resolved.chunkTimeout,
+  model: { id: resolved.model.id, provider: resolved.model.provider, route: {
+    id: resolved.model.route.id, provider: resolved.model.route.provider, protocol: resolved.model.route.protocol,
+    endpoint: { baseURL: resolved.model.route.endpoint.baseURL, path: resolved.model.route.endpoint.path,
+      query: resolved.model.route.endpoint.query },
+  } },
+})
+const routeMethods = (route: LanguageModel["route"]) =>
+  [route.headers, route.with, route.model, route.prepareTransport, route.streamPrepared, route.supportsEffortUpdates] as const
+
+/** Called by the actual native package importer, after validating the loaded exports. */
+export const recordPackage = (module: ProviderPackageDefinition, specifier: string, builtin: boolean) => {
+  const implementation = implementations.get(module.model) ?? randomUUID()
+  implementations.set(module.model, implementation)
+  packages.set(module, Object.freeze({ specifier, builtin, implementation }))
+}
