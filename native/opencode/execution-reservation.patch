+import { expect } from "bun:test"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope, Sink, Stream } from "effect"
+import { ChildProcess, ChildProcessSpawner } from "effect/process"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { makeFiles, makeMemoryDriver } from "@opencode/core/environment/index"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { Workspace } from "@opencode/core/workspace"
+import { WorkspaceDriver } from "@opencode/core/workspace/driver"
+import { advanceEffect } from "./lib/clock"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(ReservationAuthority.layer)
+const memory = makeMemoryDriver()
+const blocked = (authority: ReservationAuthority.Interface) => authority.withStable(Effect.void).pipe(
+  Effect.exit, Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+)
+const fixture = (connect: WorkspaceDriver.Interface["connect"]) => Effect.gen(function* () {
+  const authority = yield* ReservationAuthority.Service
+  const parent = yield* Effect.scope
+  const owner = yield* Scope.fork(parent)
+  const context = yield* Layer.build(AppNodeBuilder.build(Workspace.configured({ pollInterval: "1 hour", idleThreshold: "2 hours" }), [
+    ReservationAuthority.node.replace(Layer.succeed(ReservationAuthority.Service, authority)),
+    WorkspaceDriver.node.replace(WorkspaceDriver.registryNode({ fixture: {
+      create: ({ workspaceID }) => Effect.succeed({ binding: { workspaceID } }),
+      connect, suspendForIdle: () => Effect.void, destroy: () => Effect.void,
+    } })),
+  ])).pipe(Scope.provide(owner))
+  const workspace = Context.get(context, Workspace.Service)
+  const id = yield* workspace.create({ provider: "fixture" })
+  return { owner, workspace, id, environment: yield* workspace.connect(id) }
+})
+
+function spawner(cleanup: Effect.Effect<void>, fail = false) {
+  return ChildProcessSpawner.make(() => Effect.gen(function* () {
+    yield* Effect.addFinalizer(() => cleanup)
+    if (fail) return yield* Effect.die("fixture spawn failed after registering cleanup")
+    return ChildProcessSpawner.makeHandle({
+      pid: ChildProcessSpawner.ProcessId(1), exitCode: Effect.succeed(ChildProcessSpawner.ExitCode(0)),
+      isRunning: Effect.succeed(false), kill: () => Effect.void, stdin: Sink.drain,
+      stdout: Stream.empty, stderr: Stream.empty, all: Stream.empty,
+      getInputFd: () => Sink.drain, getOutputFd: () => Stream.empty, unref: Effect.succeed(Effect.void),
+    })
+  }))
+}
+
+it.effect("a running file borrow survives owner disposal while retained facades refuse new work", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const writes: string[] = []
+    const source = yield* fixture(() => Effect.succeed({ ...memory, overrides: { ...memory.overrides,
+      write: (path) => Effect.gen(function* () {
+        if (path === "/accepted") {
+          yield* Deferred.succeed(entered, undefined)
+          yield* Deferred.await(release)
+        }
+        writes.push(path)
+      }),
+    } }))
+    const files = makeFiles(source.environment)
+    yield* Effect.gen(function* () {
+      const writing = yield* files.write("/accepted", new Uint8Array([1])).pipe(Effect.forkScoped)
+      yield* Deferred.await(entered)
+      expect(yield* blocked(authority)).toBe(true)
+      yield* Scope.close(source.owner, Exit.void)
+      expect(yield* blocked(authority)).toBe(true)
+      expect(Exit.isFailure(yield* files.write("/late", new Uint8Array([2])).pipe(Effect.exit))).toBe(true)
+      expect(Exit.isFailure(yield* source.workspace.connect(source.id).pipe(Effect.exit))).toBe(true)
+      expect(writes).toEqual([])
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(writing)
+      expect(writes).toEqual(["/accepted"])
+      yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }),
+)
+
+it.effect("process borrows retain authority through caller lifetime and cleanup after workspace owner disposal", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const cleaning = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const source = yield* fixture(() => Effect.succeed({ ...memory,
+      spawner: spawner(Deferred.succeed(cleaning, undefined).pipe(Effect.andThen(Deferred.await(release)))),
+    }))
+    const parent = yield* Effect.scope
+    const caller = yield* Scope.fork(parent)
+    yield* Effect.gen(function* () {
+      yield* source.environment.spawner.spawn(ChildProcess.make("fixture")).pipe(Scope.provide(caller))
+      expect(yield* blocked(authority)).toBe(true)
+      yield* Scope.close(source.owner, Exit.void)
+      expect(yield* blocked(authority)).toBe(true)
+      const closing = yield* Scope.close(caller, Exit.void).pipe(Effect.forkScoped)
+      yield* Deferred.await(cleaning)
+      expect(closing.pollUnsafe()).toBeUndefined()
+      expect(yield* blocked(authority)).toBe(true)
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(closing)
+      yield* authority.withStable(Effect.void)
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }),
+)
+
+it.effect("failed borrow cleanup is retained across repeated caller close and workspace disposal", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const calls = { cleanup: 0 }
+    const source = yield* fixture(() => Effect.succeed({ ...memory, spawner: spawner(Effect.sync(() => { calls.cleanup++ })
+      .pipe(Effect.andThen(Effect.die("fixture cleanup is uncertain"))), true) }))
+    const caller = yield* Scope.make()
+    const result = yield* source.environment.spawner.spawn(ChildProcess.make("fixture")).pipe(Scope.provide(caller), Effect.exit)
+    expect(Exit.isFailure(result)).toBe(true)
+    expect(calls.cleanup).toBe(1)
+    expect(yield* blocked(authority)).toBe(true)
+    yield* Scope.close(caller, Exit.void).pipe(Effect.exit)
+    yield* Scope.close(caller, Exit.void).pipe(Effect.exit)
+    yield* Scope.close(source.owner, Exit.void)
+    expect(calls.cleanup).toBe(1)
+    expect(yield* blocked(authority)).toBe(true)
+  }),
+)
+
+it.effect("cancelled file borrows retain their worker through cleanup after owner disposal", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const entered = yield* Deferred.make<void>()
+    const cleaning = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const source = yield* fixture(() => Effect.succeed({ ...memory, overrides: { ...memory.overrides,
+      write: () => Effect.acquireUseRelease(Deferred.succeed(entered, undefined), () => Effect.never,
+        () => Deferred.succeed(cleaning, undefined).pipe(Effect.andThen(Deferred.await(release)))),
+    } }))
+    yield* Effect.gen(function* () {
+      const writing = yield* makeFiles(source.environment).write("/cancelled", new Uint8Array()).pipe(Effect.forkScoped)
+      yield* Deferred.await(entered)
+      const stopping = yield* Fiber.interrupt(writing).pipe(Effect.forkScoped)
+      yield* Deferred.await(cleaning)
+      yield* Scope.close(source.owner, Exit.void)
+      expect(stopping.pollUnsafe()).toBeUndefined()
+      expect(yield* blocked(authority)).toBe(true)
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(stopping)
+      yield* authority.withStable(Effect.void)
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }),
+)
