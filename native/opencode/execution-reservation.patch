+it.effect("typed authority events retain each queued observation until its own settlement", () =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const authority = yield* ReservationAuthority.Service
+    const entered = [yield* Deferred.make<void>(), yield* Deferred.make<void>()]
+    const release = [yield* Deferred.make<void>(), yield* Deferred.make<void>()]
+    const values: string[] = []
+    yield* AuthorityEvents.observeEvent(Credential.Event.Switched, (event) => Effect.gen(function* () {
+      const index = values.length
+      values.push(event.data.integrationID)
+      yield* Deferred.succeed(entered[index]!, undefined)
+      yield* Deferred.await(release[index]!)
+      return true
+    }), location)
+    yield* Effect.gen(function* () {
+      const revision = yield* authority.revision
+      yield* bus.publish(Credential.Event.Switched, data("wrong-location"), {
+        location: { directory: AbsolutePath.make("/other") },
+      })
+      expect(yield* authority.revision).toBe(revision)
+      yield* bus.publish(Credential.Event.Switched, data("first"), { location })
+      yield* Deferred.await(entered[0]!)
+      yield* bus.publish(Credential.Event.Switched, data("second"), { global: true })
+      yield* Deferred.succeed(release[0]!, undefined)
+      yield* Deferred.await(entered[1]!)
