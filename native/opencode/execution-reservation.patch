+export * as MovementInstructionFiles from "./movement-instruction-files.js"
+
+import path from "node:path"
+import { Effect } from "effect"
+import type { FSUtil } from "@opencode/util/fs-util"
+import type { InstructionDiscovery } from "../instruction-discovery.js"
+
+/** Copy native-discovered local files; URLs and discovery completeness require separate evidence. */
+export const capture = (files: ReadonlyArray<InstructionDiscovery.File>) =>
+  files.filter((file) => path.isAbsolute(file.path)).map((file) => Object.freeze({ path: file.path, content: file.content }))
+
+/** Observe the captured paths again without changing discovery or causing a reload. */
+export const current = (files: ReadonlyArray<{ readonly path: string; readonly content: string }>, fs: FSUtil.Interface) =>
+  Effect.gen(function* () {
+    for (const file of files)
+      if ((yield* fs.readFileStringSafe(file.path).pipe(Effect.orElseSucceed(() => undefined))) !== file.content) return false
+    return true
+  })
