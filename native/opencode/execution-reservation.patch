+export * as NativePluginActivation from "./activation-origin.js"
+
+import { randomUUID } from "node:crypto"
+import { Context, Effect, Option, Scope } from "effect"
+import type { Generation } from "./service.js"
+
+export interface Descriptor {
+  readonly pluginID: string
+  readonly revision: string
+  readonly source: Generation["source"]
+  readonly definition: string
+  readonly domain: string
+  readonly name: string
+  readonly ordinal: number
+  readonly hostedBundleDigest?: string
+}
+
+export interface Origin {
+  readonly descriptor: Descriptor
+  readonly activationID: string
+}
+
+interface Principal {
+  readonly plugin: Generation
+  readonly definition: string
+  readonly activationID: string
+  readonly scope: Scope.Scope
+  readonly counts: Map<string, number>
+}
+
+/** Private native Context value. JSON, plugin names and declared hashes cannot create a principal. */
+export class Current extends Context.Service<Current, unknown>()("@opencode/NativePluginActivation") {}
+
+const principals = new WeakMap<object, Principal>()
+const definitions = new WeakMap<Generation["effect"], string>()
+const implementations = new WeakMap<Generation["effect"], (...args: never[]) => unknown>()
+const implementationIDs = new WeakMap<(...args: never[]) => unknown, string>()
+const origins = new WeakMap<object, Scope.Scope>()
+const hostedBundles = new WeakMap<Generation["effect"], string>()
+
+// Observational marker for the host-injected shim. This alone is not an
+// execution seal: the supervisor must independently inspect the runtime.
+export const bindHostedBundle = (effect: Generation["effect"], digest: string) => {
+  if (!/^[a-f0-9]{64}$/.test(digest)) throw new Error("Invalid hosted bundle digest")
+  hostedBundles.set(effect, digest)
+}
+
+export const make = (plugin: Generation, scope: Scope.Scope): object => {
+  const implementation = implementations.get(plugin.effect) ?? plugin.effect
+  const definition = implementationIDs.get(implementation) ?? definitions.get(plugin.effect) ?? randomUUID()
+  implementationIDs.set(implementation, definition)
+  definitions.set(plugin.effect, definition)
+  const principal = Object.freeze({})
+  principals.set(principal, { plugin, definition, scope, activationID: randomUUID(), counts: new Map() })
+  return principal
+}
+
+/** Native loader/factory binding before the activation wrapper captures its Location services. */
+export const bind = (
+  effect: Generation["effect"],
+  implementation: (...args: never[]) => unknown,
+): Generation["effect"] => {
+  implementations.set(effect, implementation)
+  return effect
+}
+
+export const capture = Effect.fn("NativePluginActivation.capture")(function* (domain: string, name: string) {
+  const value = Option.getOrUndefined(yield* Effect.serviceOption(Current))
+  if (typeof value !== "object" || value === null) return
+  const principal = principals.get(value)
+  if (!principal || principal.scope.state._tag === "Closed") return
+  const key = JSON.stringify([domain, name])
+  const ordinal = (principal.counts.get(key) ?? 0) + 1
+  principal.counts.set(key, ordinal)
+  const origin: Origin = Object.freeze({
+    activationID: principal.activationID,
+    descriptor: Object.freeze({
+      pluginID: principal.plugin.id,
+      revision: principal.plugin.revision,
+      source: principal.plugin.source ? Object.freeze({ ...principal.plugin.source }) : undefined,
+      definition: principal.definition,
+      domain,
+      name,
+      ordinal,
+      ...(hostedBundles.get(principal.plugin.effect) ? { hostedBundleDigest: hostedBundles.get(principal.plugin.effect)! } : {}),
+    }),
+  })
+  origins.set(origin, principal.scope)
+  return origin
+})
+
+export const isCurrent = (origin: unknown): boolean => {
+  if (typeof origin !== "object" || origin === null) return false
+  const scope = origins.get(origin)
+  return scope !== undefined && scope.state._tag !== "Closed"
+}
