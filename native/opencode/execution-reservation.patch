+    }),
+  )
+}
+
+it.effect("overlapping authority mutations keep guards excluded until both settle", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const firstEntered = yield* Deferred.make<void>()
+    const secondEntered = yield* Deferred.make<void>()
+    const firstRelease = yield* Deferred.make<void>()
+    const secondRelease = yield* Deferred.make<void>()
+    const first = yield* authority.withMutation(Deferred.succeed(firstEntered, undefined)
+      .pipe(Effect.andThen(Deferred.await(firstRelease)))).pipe(Effect.forkScoped)
+    const second = yield* authority.withMutation(Deferred.succeed(secondEntered, undefined)
