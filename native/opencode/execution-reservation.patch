+++ b/packages/core/test/git-pack-authority.test.ts
@@ -0,0 +1,266 @@
+import { expect } from "bun:test"
+import { $ } from "bun"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+const denied = (method: string, value: string) =>
+  Effect.fail(
+    systemError({
+      _tag: "PermissionDenied",
+      module: "FileSystem",
+      method,
+      pathOrDescriptor: value,
+      description: "controlled pack I/O fault",
+    }),
+  )
+
+for (const outcome of [
+  "success",
+  "old lock",
+  "recent lock",
+  "lost lock receipt",
+  "unowned packs",
+  "enumeration failure",
+  "lock cleanup failure",
+  "loose cleanup failure",
+  "caller interruption",
+  "acquisition interruption",
+  "objects listing failure",
+  "fanout listing failure",
+  "pack inventory failure",
+  "small objects listing failure",
+  "small fanout listing failure",
+  "small pack inventory failure",
+  "small success",
+  "small unowned packs",
+  "small enumeration failure",
+  "late unowned packs",
+  "under-lock enumeration failure",
+] as const) {
+  it.live(`raw Git packing ${outcome} preserves independent refusal and unowned evidence`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const lockFile = path.join(store, "opencode-pack.lock")
+      const packDirectory = path.join(store, "objects", "pack")
+      yield* Effect.promise(async () => {
+        await Bun.write(path.join(project, "seed.txt"), "seed\n")
+        await initRepo(project)
+        // Large cases still cross the production threshold after losing one fanout.
+        await Promise.all(
+          Array.from({ length: outcome.startsWith("small ") ? 2 : 2100 }, (_, index) =>
+            Bun.write(path.join(project, "gen", `f${index}.txt`), `${index}\n`),
+          ),
+        )
+      })
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const gate = {
+        armed: false,
+        first: true,
+        enumerations: 0,
+        attempts: 0,
+        faults: 0,
+        refused: Effect.succeed(false),
+      }
+      const cleanupFiles: string[] = []
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const layer = LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+        replacements: [
+          FSUtil.node.replace(
+            Layer.succeed(FSUtil.Service, {
+              ...fs,
+              writeFileString: (file, value, options) => {
+                if (!gate.armed || file !== lockFile) return fs.writeFileString(file, value, options)
+                gate.attempts++
+                return Effect.gen(function* () {
+                  expect(yield* gate.refused).toBe(true)
+                  if (outcome === "acquisition interruption") {
+                    yield* Deferred.succeed(entered, undefined)
+                    yield* Deferred.await(release)
+                  }
+                  if (outcome === "late unowned packs") {
+                    yield* Effect.forEach(foreign, (name) =>
+                      fs.writeFileString(path.join(packDirectory, name), `evidence:${name}\n`),
+                    )
+                  }
+                  yield* fs.writeFileString(file, value, options)
+                  if (outcome === "lost lock receipt") return yield* denied("writeFileString", file)
+                })
+              },
+              readDirectory: (file, options) => {
+                if (
+                  gate.armed &&
+                  file === packDirectory &&
+                  ++gate.enumerations === (outcome === "under-lock enumeration failure" ? 3 : 2) &&
+                  outcome.endsWith("enumeration failure")
+                )
+                  return denied("readDirectory", file)
+                if (!gate.armed) return fs.readDirectory(file, options)
+                return Effect.gen(function* () {
+                  expect(yield* gate.refused).toBe(true)
+                  if (
+                    gate.first &&
+                    ((outcome.endsWith("objects listing failure") && file === path.join(store, "objects")) ||
+                      (outcome.endsWith("fanout listing failure") &&
+                        path.dirname(file) === path.join(store, "objects") &&
+                        /^[0-9a-f]{2}$/.test(path.basename(file))) ||
+                      (outcome.endsWith("pack inventory failure") && file === packDirectory))
+                  ) {
+                    gate.first = false
+                    gate.faults++
+                    return yield* denied("readDirectory", file)
+                  }
+                  return yield* fs.readDirectory(file, options)
+                })
+              },
+              remove: (file, options) => {
+                if (!gate.armed) return fs.remove(file, options)
+                if (
+                  outcome === "loose cleanup failure" &&
+                  gate.first &&
+                  /^[0-9a-f]{2}$/.test(path.basename(path.dirname(file)))
+                ) {
+                  gate.first = false
+                  cleanupFiles.push(file)
+                  return denied("remove", file)
+                }
+                if (file !== lockFile || !["success", "lock cleanup failure", "caller interruption"].includes(outcome))
+                  return fs.remove(file, options)
+                return Effect.gen(function* () {
+                  yield* Deferred.succeed(entered, undefined)
+                  yield* Deferred.await(release)
+                  if (outcome === "lock cleanup failure") return yield* denied("remove", file)
+                  return yield* fs.remove(file, options)
+                })
+              },
+            }),
+          ),
+        ],
+      })
+      const context = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      gate.refused = refused
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      const tree = yield* git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      const foreign = ["tmp_old", "tmp_recent", "pack-unindexed-old.pack", "pack-unindexed-recent.pack"]
+      if (outcome === "old lock" || outcome === "recent lock") {
+        yield* fs.writeFileString(lockFile, `live-owner:${process.pid}\n`)
+        if (outcome === "old lock") yield* fs.utimes(lockFile, new Date(0), new Date(0))
+      }
+      if (outcome.endsWith("unowned packs") && outcome !== "late unowned packs") {
+        yield* Effect.forEach(foreign, (name) =>
+          fs.writeFileString(path.join(packDirectory, name), `evidence:${name}\n`),
+        )
+        yield* Effect.forEach(
+          foreign.filter((name) => name.includes("old")),
+          (name) => fs.utimes(path.join(packDirectory, name), new Date(0), new Date(0)),
+        )
+      }
+      yield* Effect.gen(function* () {
+        expect(yield* refused).toBe(false)
+        gate.armed = true
+        const running = yield* git.objects.pack(repository).pipe(Effect.exit, Effect.forkScoped)
+        if (["success", "lock cleanup failure", "caller interruption", "acquisition interruption"].includes(outcome)) {
+          yield* Deferred.await(entered)
+          expect(yield* fs.isFile(lockFile)).toBe(outcome !== "acquisition interruption")
+          expect(yield* refused).toBe(true)
+          const cancelling =
+            outcome === "caller interruption" || outcome === "acquisition interruption"
+              ? yield* Fiber.interrupt(running).pipe(Effect.forkScoped)
+              : undefined
+          yield* Effect.yieldNow
+          if (cancelling) expect(cancelling.pollUnsafe()).toBeUndefined()
+          yield* Deferred.succeed(release, undefined)
+          if (cancelling) {
+            yield* Fiber.join(cancelling)
+            const exit = yield* Fiber.await(running)
+            expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+          }
+        }
+        if (outcome !== "caller interruption" && outcome !== "acquisition interruption")
+          expect(Exit.isSuccess(yield* Fiber.join(running))).toBe(true)
+        const uncertain =
+          outcome !== "success" &&
+          outcome !== "small success" &&
+          outcome !== "caller interruption" &&
+          outcome !== "acquisition interruption"
+        expect(yield* refused).toBe(uncertain)
+        const listingFailure = outcome.endsWith("listing failure") || outcome.endsWith("inventory failure")
+        expect(gate.attempts).toBe(
+          listingFailure ||
+            outcome.startsWith("small ") ||
+            outcome === "unowned packs" ||
+            outcome === "enumeration failure"
+            ? 0
+            : 1,
+        )
+        expect(gate.faults).toBe(listingFailure ? 1 : 0)
+        if (outcome === "old lock" || outcome === "recent lock")
+          expect(yield* fs.readFileString(lockFile)).toBe(`live-owner:${process.pid}\n`)
+        expect(yield* fs.isFile(lockFile)).toBe(
+          ["old lock", "recent lock", "lost lock receipt", "lock cleanup failure"].includes(outcome),
+        )
+        if (outcome.endsWith("unowned packs")) {
+          yield* Effect.forEach(foreign, (name) =>
+            Effect.gen(function* () {
+              expect(yield* fs.readFileString(path.join(packDirectory, name))).toBe(`evidence:${name}\n`)
+            }),
+          )
+        }
+        if (outcome === "loose cleanup failure") {
+          expect(cleanupFiles).toHaveLength(1)
+          expect(yield* fs.isFile(cleanupFiles[0]!)).toBe(true)
+        }
+        const packed = (yield* fs.readDirectory(packDirectory)).filter((name) => /^pack-[0-9a-f]+\.pack$/.test(name))
+        expect(packed.length).toBe(
+          listingFailure ||
+            outcome.startsWith("small ") ||
+            outcome.endsWith("unowned packs") ||
+            outcome.endsWith("enumeration failure") ||
+            [
+              "old lock",
+              "recent lock",
+              "lost lock receipt",
+              "unowned packs",
+              "enumeration failure",
+              "acquisition interruption",
+            ].includes(outcome)
+            ? 0
+            : 1,
+        )
+        gate.armed = false
+        // External deletion and a successful retry are not this attempt's cleanup receipt.
+        yield* fs.remove(lockFile, { force: true })
+        if (outcome.endsWith("unowned packs"))
+          yield* Effect.forEach(foreign, (name) => fs.remove(path.join(packDirectory, name)))
+        yield* Effect.forEach(cleanupFiles, (file) => fs.remove(file, { force: true }))
+        yield* git.objects.pack(repository)
+        expect(yield* refused).toBe(uncertain)
+        expect(yield* Effect.promise(() => $`git --git-dir ${store} show ${`${tree}:gen/f1.txt`}`.text())).toBe("1\n")
+        yield* Scope.close(owner, Exit.void)
+        expect(yield* refused).toBe(uncertain)
+      }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+    }),
+  )
+}
