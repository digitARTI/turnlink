+                      )
+                      yield* Deferred.succeed(started, undefined)
+                      yield* Deferred.await(release)
+                      if (outcome === "failure") return yield* new Ripgrep.Error({ message: "fixture scan failed" })
+                    }
+                    const entry = FileSystem.Entry.make({
+                      path: RelativePath.make(scans === 1 ? "old.ts" : "new.ts"),
