new file mode 100644
index 0000000..70f3bf9
--- /dev/null
+++ b/packages/server/test/session-instruction-reservation.test.ts
@@ -0,0 +1,108 @@
+import { expect } from "bun:test"
+import { Session } from "@opencode/core/session"
+import { SessionExecution } from "@opencode/core/session/execution"
+import { SessionRunCoordinator } from "@opencode/core/session/run-coordinator"
+import { makeGlobalNode } from "@opencode/util/effect/app-node"
+import { Deferred, Effect, Fiber, Layer, Queue, Schema } from "effect"
+import { tmpdir } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+for (const method of ["PUT", "DELETE"] as const) {
+  it.live(`instruction ${method} waits behind the native reservation before changing durable guidance`, () =>
+    Effect.gen(function* () {
+      const tmp = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-instruction-reservation-")))
+      const ready = yield* Deferred.make<SessionExecution.Interface>()
+      const entering = yield* Queue.unbounded<Session.ID>()
+      const execution = Layer.effect(
+        SessionExecution.Service,
+        Effect.gen(function* () {
+          const coordinator = yield* SessionRunCoordinator.make<Session.ID, never>({
+            drain: () => Effect.die("instruction mutation must not wake a model"),
+          })
+          const service = SessionExecution.Service.of({
+            active: coordinator.active,
+            isActive: coordinator.isActive,
+            resume: coordinator.run,
+            wake: coordinator.wake,
+            interrupt: (id) => coordinator.interrupt(id),
+            awaitIdle: coordinator.awaitIdle,
+            withIdleExecution: coordinator.withIdle,
+            withActivity: (id, operation) =>
+              Queue.offer(entering, id).pipe(Effect.andThen(coordinator.withActivity(id, operation))),
+          })
+          yield* Deferred.succeed(ready, service)
+          return service
+        }),
+      )
+      const handler = yield* ServerFetch.make(
+        {
+          database: { path: ":memory:" },
+          fs: { filewatcher: false },
+          models: { fetch: false },
+        },
+        {
+          overrides: [
+            SessionExecution.node.replace(
+              makeGlobalNode({
+                service: SessionExecution.Service,
+                layer: execution,
+                deps: [],
+              }),
+            ),
+          ],
+        },
+      )
+      const native = yield* Deferred.await(ready)
+      const request = (route: string, method = "GET", body?: Schema.Json) =>
+        Effect.promise(() =>
+          handler(
+            new Request(`http://opencode.local${route}`, {
+              method,
+              headers: body === undefined ? undefined : { "content-type": "application/json" },
+              body: body === undefined ? undefined : JSON.stringify(body),
+            }),
+          ),
+        )
+      const createdResponse = yield* request("/api/session", "POST", { location: { directory: tmp.path } })
+      expect(createdResponse.status).toBe(200)
+      const created = Schema.decodeUnknownSync(Schema.Struct({ data: Schema.Struct({ id: Session.ID }) }))(
+        yield* Effect.promise(() => createdResponse.json()),
+      )
+      const sessionID = created.data.id
+      const route = `/api/experimental/session/${sessionID}/instructions/entries`
+      expect((yield* request(`${route}/guidance`, "PUT", { value: "original guidance" })).status).toBe(204)
+      expect(yield* Queue.take(entering)).toBe(sessionID)
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const reserved = yield* native
+        .withIdleExecution(
+          sessionID,
+          Deferred.succeed(entered, undefined).pipe(Effect.andThen(Deferred.await(release))),
+        )
+        .pipe(Effect.forkScoped)
+      yield* Deferred.await(entered)
+      const mutating = yield* request(
+        `${route}/guidance`,
+        method,
+        method === "PUT" ? { value: "replacement guidance" } : undefined,
+      ).pipe(Effect.forkScoped)
+      // Observe the real handler entering its native boundary, not a sleep or
+      // an assertion made before the HTTP request reaches the server.
+      expect(yield* Queue.take(entering).pipe(Effect.timeout("5 seconds"))).toBe(sessionID)
+      const before = yield* request(route)
+      expect(yield* Effect.promise(() => before.json())).toEqual({
+        data: [{ key: "guidance", value: "original guidance" }],
+      })
+      expect(mutating.pollUnsafe()).toBeUndefined()
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(reserved)
+      expect((yield* Fiber.join(mutating)).status).toBe(204)
+      const after = yield* request(route)
+      expect(yield* Effect.promise(() => after.json())).toEqual({
+        data: method === "PUT" ? [{ key: "guidance", value: "replacement guidance" }] : [],
+      })
+      expect(yield* native.active).toEqual(new Set())
+    }).pipe(Effect.timeout("15 seconds")),
+  )
+}
