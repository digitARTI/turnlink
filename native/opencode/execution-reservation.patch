+      slug: "placement", title: "before", version: "test" }).run().pipe(Effect.orDie)
+    yield* db.insert(KVTable).values({ key: "plugin:007400750072006e006c0069006e006b:memberships/" + sessionID,
+      value: { sessionID, directory: source.directory, channel: "dev", forms: [] } }).run().pipe(Effect.orDie)
+    const activation = yield* movement.forActivation({ pluginID: "turnlink", location: source, authorized: true })
+    yield* activation.prepare({ sessionID, transitionID, directory: destination.directory })
+    yield* activation.detachLiveMembership({ sessionID, transitionID, channel: "dev" })
