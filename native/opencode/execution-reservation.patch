+export const observe = (value: unknown): Observation | undefined => {
+  if (typeof value !== "object" || value === null) return
+  const native = resolutions.get(value)
+  if (!native) return
+  const resolved = value as ModelResolver.Resolved
+  let current = false
+  try {
+    current = native.scope.state._tag !== "Closed" && native.fingerprint !== undefined &&
+      resolutionFingerprint(resolved) === native.fingerprint && resolved.model === native.model &&
+      resolved.model.route === native.route && native.route.endpoint === native.endpoint &&
+      native.route.transport === native.transport && native.route.body === native.body && native.route.auth === native.auth &&
+      routeMethods(native.route).every((method, index) => method === native.methods[index])
+  } catch { /* Malformed or replaced native data cannot attest current authority. */ }
+  return Object.freeze({ ...native.observation, current })
+}
