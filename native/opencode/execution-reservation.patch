+import { expect } from "bun:test"
+import { createServer, Socket } from "node:net"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Option, Scope } from "effect"
+import { ChildProcess } from "effect/process"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { AppProcess, AppProcessError } from "@opencode/util/process"
+import { ProcessObservation } from "@opencode/util/process-observation"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(AppProcess.node))
+
+for (const outcome of ["success", "observed uncertainty", "backend failure", "interruption"] as const) {
+  it.live(`raw Git process ${outcome} keeps invocation and backend observations separate`, () =>
+    Effect.gen(function* () {
+      const backend = yield* AppProcess.Service
+      const tmp = yield* tmpdirScoped()
+      yield* Effect.promise(() => initRepo(tmp.path))
+      const entered = yield* Deferred.make<void>()
+      const resume = yield* Deferred.make<void>()
+      const gate = { armed: false, calls: 0, refused: Effect.succeed(false) }
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              AppProcess.node.replace(
+                Layer.succeed(AppProcess.Service, {
+                  ...backend,
+                  run: (command, options) => {
+                    if (!gate.armed) return backend.run(command, options)
+                    return Effect.gen(function* () {
+                      gate.calls++
+                      expect(yield* gate.refused).toBe(true)
+                      const observation = yield* Effect.serviceOption(ProcessObservation)
+                      expect(Option.isSome(observation)).toBe(true)
+                      if (outcome === "observed uncertainty" && Option.isSome(observation))
+                        yield* observation.value.unresolved
+                      if (outcome === "backend failure")
+                        return yield* new AppProcessError({
+                          command: "fixture",
+                          cause: new Error("lost native receipt"),
+                        })
+                      if (outcome === "interruption") {
+                        yield* Deferred.succeed(entered, undefined)
+                        yield* Deferred.await(resume)
+                      }
+                      return yield* backend.run(command, options)
+                    })
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      gate.refused = refused
+      const repository = yield* git.repo.discover(AbsolutePath.make(tmp.path))
+      if (!repository) return yield* Effect.die("fixture project is not a repository")
+      expect(yield* refused).toBe(false)
+      yield* Effect.gen(function* () {
+        gate.armed = true
+        const running = yield* git.history.head(repository).pipe(Effect.exit, Effect.forkScoped)
+        if (outcome === "interruption") {
+          yield* Deferred.await(entered)
+          yield* Fiber.interrupt(running)
+          const exit = yield* Fiber.await(running)
+          expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        }
+        if (outcome !== "interruption") {
+          const exit = yield* Fiber.join(running)
+          expect(Exit.isSuccess(exit)).toBe(true)
+          if (Exit.isSuccess(exit)) expect(exit.value === undefined).toBe(outcome === "backend failure")
+        }
+        expect(gate.calls).toBe(1)
+        const uncertain = outcome !== "success"
+        expect(yield* refused).toBe(uncertain)
+        gate.armed = false
+        expect(yield* git.history.head(repository)).toBeDefined()
+        expect(yield* refused).toBe(uncertain)
+        yield* Scope.close(owner, Exit.void)
+        expect(yield* refused).toBe(uncertain)
+      }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+    }),
+  )
+}
+
+it.live("real inherited-pipe deadline reports uncertainty before successful process return", () =>
+  Effect.gen(function* () {
+    const backend = yield* AppProcess.Service
+    const fixture = yield* Effect.acquireRelease(
+      Effect.promise(async () => {
+        const connected = Promise.withResolvers<Socket>()
+        const sockets = new Set<Socket>()
+        const server = createServer((socket) => {
+          sockets.add(socket)
+          socket.on("error", () => {})
+          socket.on("close", () => sockets.delete(socket))
+          connected.resolve(socket)
+        })
+        await new Promise<void>((resolve, reject) => {
+          server.once("error", reject)
+          server.listen(0, "127.0.0.1", resolve)
+        })
+        const address = server.address()
+        if (!address || typeof address === "string") throw new Error("fixture requires a TCP address")
+        return { server, sockets, connected: connected.promise, port: address.port }
+      }),
+      (fixture) =>
+        Effect.promise(async () => {
+          // The descendant exits on socket EOF/error; no PID-based kill or cleanup grant.
+          for (const socket of fixture.sockets) socket.end()
+          await new Promise<void>((resolve) => fixture.server.close(() => resolve()))
+        }),
+    )
+    const child = `const net = require("node:net"); const socket = net.connect(${fixture.port}, "127.0.0.1"); socket.resume(); socket.on("end", () => process.exit(0)); socket.on("error", () => process.exit(0));`
+    const parent = `const { spawn } = require("node:child_process"); const child = spawn(process.execPath, ["-e", ${JSON.stringify(child)}], { detached: true, stdio: ["ignore", "inherit", "inherit"] }); child.unref();`
+    const observations = { unresolved: 0 }
+    const running = yield* backend.run(ChildProcess.make(process.execPath, ["-e", parent])).pipe(
+      Effect.provideService(ProcessObservation, {
+        unresolved: Effect.sync(() => {
+          observations.unresolved++
+        }),
+      }),
+      Effect.forkScoped,
+    )
+    const peer = yield* Effect.promise(() => fixture.connected)
+    const result = yield* Fiber.join(running)
+    expect(result.exitCode).toBe(0)
+    expect(observations.unresolved).toBeGreaterThanOrEqual(1)
+    expect(peer.destroyed).toBe(false)
+  }),
+)
