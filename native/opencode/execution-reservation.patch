+      }
+      if (mutation === "revoke") {
+        const grants = yield* saved.list()
+        yield* saved.remove(grants[0]!.id)
+        expect(yield* saved.list()).toEqual([])
+      }
+      expect(yield* authority.revision).toBeGreaterThan(before)
+      yield* Deferred.await(cleaning)
+      expect(reserved.pollUnsafe()).toBeUndefined()
+      expect(yield* execution.isActive(sessionID)).toBe(true)
+      expect(yield* execution.withIdleExecution(sessionID, Effect.die("cleanup must exclude a new reservation"))
+        .pipe(Effect.flip)).toMatchObject({ _tag: "SessionRunCoordinator.ReservationBusyError" })
+      yield* Deferred.succeed(release, undefined)
+      const exit = yield* Fiber.join(reserved)
+      expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+      expect(yield* execution.isActive(sessionID)).toBe(false)
+      yield* execution.withIdleExecution(sessionID, Effect.void)
+    }),
+  )
+}
+
+it.live("unchanged managed policy does not invalidate a held reservation", () =>
+  Effect.gen(function* () {
+    const execution = yield* SessionExecution.Service
+    const policy = yield* ManagedPolicy.Service
+    const authority = yield* ReservationAuthority.Service
