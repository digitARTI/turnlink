+            }),
+          ),
+        observePreGrantAuthority,
+        prepareAuthority,
+        prepareDestination: (request) => prepareAuthority(request).pipe(Effect.map((prepared) => prepared.destination)),
+        prepare: Effect.fn("SessionMovement.prepare")(function* (request) {
