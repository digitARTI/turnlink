+              database: input.database, execution: input.execution, owner: placementOwner, placement,
+            })
+            if (live) livePhase = "completed"
+            // The storage authorization token is private to the transaction.
+            // Return the same public receipt shape as observeCompletion.
+            return { version: completion.version, placement: completion.placement, leaseIncarnation: completion.leaseIncarnation }
+          })
+        : decoded.method === "observePlacement"
+          ? (promoted && decoded.transitionID === liveTransition ? promoted : owner).observePlacement({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+        : decoded.method === "observeCompletion"
+          ? (promoted && decoded.transitionID === liveTransition ? promoted : owner).observeCompletion({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+        : decoded.method === "takeoverRecovery"
+          ? owner.takeoverRecovery({ sessionID: decoded.sessionID, transitionID: decoded.transitionID!, expected: decoded.expected!, targetLease: decoded.targetLease! })
+        : decoded.method === "observeRecoveryTransport"
+          ? owner.observeRecoveryTransport({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+        : decoded.method === "observeRecoveryRecord"
