+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      gate.refused = refused
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const create = git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      if (outcome === "existing HEAD observation failure") yield* create
+      expect(yield* refused).toBe(false)
+      gate.armed = true
+      const result = yield* create.pipe(Effect.exit)
+      const failedObservation = outcome.endsWith("observation failure")
+      expect(Exit.isFailure(result)).toBe(failedObservation)
+      if (Exit.isFailure(result)) {
+        expect(Cause.squash(result.cause)).toBeInstanceOf(Git.OperationError)
+        expect(Cause.squash(result.cause)).toMatchObject({
+          message:
+            outcome === "seed observation failure" ? "Failed to observe seed index" : "Failed to observe Git storage",
+        })
+      }
+      const early = outcome === "initial HEAD observation failure" || outcome === "existing HEAD observation failure"
+      expect(gate.writes).toBe(early ? 0 : 1)
+      expect(gate.heads).toBe(outcome === "fallback HEAD observation failure" ? 2 : 1)
+      expect(gate.seeds).toBe(early ? 0 : 1)
+      expect(gate.copies).toBe(early || outcome === "seed observation failure" || outcome === "absent seed" ? 0 : 1)
+      expect(yield* fs.isFile(path.join(store, "HEAD"))).toBe(
+        outcome !== "initial HEAD observation failure" && outcome !== "seed observation failure",
+      )
+      const copied =
+        outcome === "successful copy" ||
+        outcome === "lost copy receipt" ||
+        outcome === "fallback HEAD observation failure" ||
+        outcome === "existing HEAD observation failure"
+      expect(yield* fs.isFile(path.join(store, "index"))).toBe(copied)
+      if (copied) {
+        if (!original) return yield* Effect.die("copied-index case requires original fixture bytes")
+        expect(yield* fs.readFile(path.join(store, "index"))).toEqual(original)
+      }
+      const uncertain = outcome !== "absent seed" && outcome !== "successful copy"
+      expect(yield* refused).toBe(uncertain)
+      gate.armed = false
+      yield* create
+      expect(yield* refused).toBe(uncertain)
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(uncertain)
+    }),
+  )
+}
