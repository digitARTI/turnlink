+            ? owner.stageRecoveredDestinationMembership({ sessionID: decoded.sessionID, transitionID: decoded.transitionID!, channel: decoded.channel!, receiverHash: decoded.receiverHash! })
+          : decoded.method === "observeDestinationMembership"
+            ? owner.observeDestinationMembership({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+          : decoded.method === "observeDetachedMembership"
+            ? owner.observeDetachedMembership({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+          : decoded.method === "sealMembership"
+            ? owner.sealMembership({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+          : owner.inspectRecovery({ sessionID: decoded.sessionID, transitionID: decoded.transitionID! })
+    const result = yield* operation.pipe(
+      Effect.map((value) => ({ id: decoded.id, result: value })),
+      Effect.catch((error) => Effect.succeed({ id: decoded.id,
+        error: error instanceof NativePrepareBusy ? "NATIVE_PREPARE_BUSY" : "NATIVE_RECOVERY_UNAVAILABLE" })),
+    )
+    if (closed) return
+    const frame = Buffer.from(JSON.stringify(result) + "\n")
