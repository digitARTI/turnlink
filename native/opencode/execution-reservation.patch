+import { expect } from "bun:test"
+import { $ } from "bun"
+import path from "path"
+import { Cause, Context, Effect, Exit, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { AppProcess } from "@opencode/util/process"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([FSUtil.node, AppProcess.node])))
+
+for (const outcome of ["failed read", "lost read receipt"] as const) {
+  it.live(`Git combined-pack ${outcome} retains its read hold without deleting original artifacts`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const backend = yield* AppProcess.Service
+      const tmp = yield* tmpdirScoped()
+      const project = AbsolutePath.make(path.join(tmp.path, "project"))
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const directory = path.join(store, "objects", "pack")
+      yield* Effect.promise(() => initRepo(project))
+      const gate = { armed: false, reads: 0, commands: 0 }
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              AppProcess.node.replace(
+                Layer.succeed(AppProcess.Service, {
+                  ...backend,
+                  run: (command, options) => {
+                    if (gate.armed) gate.commands++
+                    return backend.run(command, options)
+                  },
+                }),
+              ),
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  readFile: (file) => {
+                    if (!gate.armed || path.dirname(file) !== directory || !file.endsWith(".idx"))
+                      return fs.readFile(file)
+                    return Effect.gen(function* () {
+                      gate.reads++
+                      if (outcome === "lost read receipt") yield* fs.readFile(file)
+                      return yield* Effect.fail(
+                        systemError({
+                          _tag: "PermissionDenied",
+                          module: "FileSystem",
+                          method: "readFile",
+                          pathOrDescriptor: file,
+                          description: "controlled native pack-index read fault",
+                        }),
+                      )
+                    })
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      const source = yield* git.repo.discover(project)
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: project, gitDirectory: store, seed: source })
+      yield* Effect.promise(async () => {
+        for (const index of Array.from({ length: 16 }, (_, index) => index)) {
+          const oid = (
+            await $`git --git-dir ${store} hash-object -w --stdin < ${Buffer.from(`read-fixture-${index}\n`)}`.text()
+          ).trim()
+          await $`git --git-dir ${store} pack-objects -q ${path.join(directory, "pack")} < ${Buffer.from(oid + "\n")}`.quiet()
+        }
+      })
+      const names = (yield* fs.readDirectory(directory)).toSorted()
+      expect(names.filter((file) => file.endsWith(".pack"))).toHaveLength(16)
+      const before = new Map(
+        yield* Effect.forEach(names, (file) =>
+          fs.readFile(path.join(directory, file)).pipe(Effect.map((bytes) => [file, bytes] as const)),
+        ),
+      )
+      expect(yield* refused).toBe(false)
+      gate.armed = true
+      const result = yield* git.objects.pack(repository).pipe(Effect.exit)
+      expect(Exit.isFailure(result)).toBe(true)
+      if (Exit.isFailure(result)) expect(Cause.squash(result.cause)).toMatchObject({ operation: "pack" })
+      expect(gate.reads).toBe(1)
+      expect(gate.commands).toBe(0)
+      expect((yield* fs.readDirectory(directory)).toSorted()).toEqual(names)
+      for (const [file, bytes] of before) expect(yield* fs.readFile(path.join(directory, file))).toEqual(bytes)
+      expect(yield* fs.exists(path.join(store, "opencode-pack.lock"))).toBe(false)
+      expect(yield* refused).toBe(true)
+      gate.armed = false
+      yield* git.objects.pack(repository)
+      expect(yield* refused).toBe(true)
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(true)
+    }),
+  )
+}
