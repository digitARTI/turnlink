+
+const root = process.argv[2]!
+const source = Location.Ref.make({ directory: AbsolutePath.make(`${root}/source`) })
+const sessionID = Session.ID.make("ses_movement")
+const graph = AppNodeBuilder.build(LayerNode.group([
+  SessionMovement.node, SessionModelTransport.node, Session.node, LocationServiceMap.node, Database.node,
+]), [offlineModels, Database.node.replace(Database.configured({ path: `${root}/movement.sqlite`, nativeMovement: true }))])
+
+await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+  const database = yield* Database.Service
+  yield* database.db.insert(ProjectTable).values({ id: Project.ID.global, worktree: source.directory, sandboxes: [] }).run().pipe(Effect.orDie)
+  yield* database.db.insert(SessionTable).values({ id: sessionID, project_id: Project.ID.global, directory: source.directory,
+    slug: "movement", title: "Movement", version: "test",
+    ...(process.argv[3] === "seed-model" ? { model: { providerID: "openai", id: "continuity" } } : {}) }).run().pipe(Effect.orDie)
+  if (["seed", "seed-model"].includes(process.argv[3] ?? "")) return
+  const transport = yield* SessionModelTransport.Service
+  const execution = yield* transport.bind(sessionID).execute({
+    id: "live-movement", connect: { url: process.env.TEST_MOVEMENT_MODEL_SOCKET!, headers: Headers.empty },
+    fallback: () => Stream.die("unexpected fallback"),
+    driver: { create: () => Effect.succeed({ message: "source", mode: "full" }),
+      observe: (_create, frame) => Effect.succeed({ type: "completed", frame }) },
+  })
+  yield* Stream.runCollect(execution.frames.pipe(Stream.onEnd(execution.complete))).pipe(Effect.scoped)
+  const movement = yield* SessionMovement.Service
+  yield* NativeMovementControl.start({ fd: 3, pluginID: "turnlink", sessionID, location: source, movement, mode: "live" })
+  yield* Effect.never
+}).pipe(Effect.provide(graph))))
