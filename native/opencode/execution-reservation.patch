+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { AbsolutePath } from "@opencode/core/schema"
+import { Global } from "@opencode/util/global"
+import { tempGlobalLayer } from "./fixture/global"
+import { offlineModels } from "./fixture/models"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { advanceEffect, drain } from "./lib/clock"
+import { it } from "./lib/effect"
+
+for (const failure of [false, true]) {
+  for (const cleanupFailure of [false, true]) {
+    it.effect(
+      `Instance graph retains host authority through ${failure ? "failed boot cleanup" : "resource scope disposal"}${cleanupFailure ? " with failed cleanup" : ""}`,
+      () =>
+        Effect.gen(function* () {
+          const tmp = yield* tmpdirScoped()
+          const ref = Location.Ref.make({ directory: AbsolutePath.make(tmp.path) })
+          const closing = yield* Deferred.make<void>()
+          const release = yield* Deferred.make<void>()
+          const heldCleanup = Effect.addFinalizer(() =>
+            Deferred.succeed(closing, undefined).pipe(
+              Effect.andThen(Deferred.await(release)),
+              Effect.andThen(cleanupFailure ? Effect.die("fixture Instance resource cleanup failed") : Effect.void),
+            ),
+          )
+          const snapshot = Snapshot.node.mapLayer((layer) =>
+            layer.pipe(
+              Layer.tap(() => heldCleanup),
+              Layer.tap(() => (failure ? Effect.die("fixture Instance boot failure") : Effect.void)),
+            ),
+          )
+          yield* Effect.gen(function* () {
+            const authority = yield* ReservationAuthority.Service
+            const map = yield* LocationServiceMap.Service
+            if (!failure) {
+              yield* Effect.scoped(
+                Effect.gen(function* () {
+                  const context = yield* map.contextEffect(ref)
+                  const plugins = yield* Effect.provide(Plugin.Service, context)
+                  const models = yield* Effect.provide(Model.Service, context)
+                  yield* plugins.awaitActivation
+                  yield* models.available()
+                }),
+              )
+              yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+            }
+            const entered = yield* Deferred.make<void>()
+            const reserved = yield* authority
+              .withStable(Deferred.succeed(entered, undefined).pipe(Effect.andThen(Effect.never)))
+              .pipe(Effect.exit, Effect.forkScoped)
+            yield* Deferred.await(entered)
+            const operation = failure ? Effect.scoped(map.contextEffect(ref)).pipe(Effect.asVoid) : map.invalidate(ref)
+            const disposing = yield* operation.pipe(Effect.exit, Effect.forkScoped)
+            yield* Effect.gen(function* () {
+              yield* Deferred.await(closing)
+              // Let unrelated registry notifications settle while this non-registry
+              // dependency finalizer remains blocked. No model or native task runs.
+              yield* drain
+              expect(disposing.pollUnsafe()).toBeUndefined()
+              const blocked = yield* authority
+                .withStable(Effect.die("Instance resource scope is still closing"))
+                .pipe(Effect.exit)
+              expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+              const exit = yield* Fiber.join(reserved)
+              expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+              yield* Deferred.succeed(release, undefined)
+              expect(Exit.isFailure(yield* Fiber.join(disposing))).toBe(failure || cleanupFailure)
+              if (!failure && !cleanupFailure) {
+                yield* advanceEffect(authority.withStable(Effect.void).pipe(Effect.exit, Effect.map(Exit.isSuccess)))
+                return
+              }
+              yield* drain
+              const unsettled = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+              expect(Exit.isFailure(unsettled) && Cause.hasInterruptsOnly(unsettled.cause)).toBe(true)
+              yield* map.invalidate(ref).pipe(Effect.exit)
+              yield* authority.withMutation(Effect.void)
+              yield* drain
+              const repeated = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+              expect(Exit.isFailure(repeated) && Cause.hasInterruptsOnly(repeated.cause)).toBe(true)
+            }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+          }).pipe(
+            Effect.provide(
+              AppNodeBuilder.build(LayerNode.group([LocationServiceMap.node, ReservationAuthority.node]), [
+                Global.node.replace(tempGlobalLayer),
+                Config.node.replace(Config.configured({ project: false, global: false })),
+                InstructionDiscovery.node.replace(InstructionDiscovery.configured({ project: false, global: false })),
+                failure
+                  ? Snapshot.node.replace(snapshot)
+                  : Environment.node.replace(
+                      Environment.node.mapLayer((layer) => layer.pipe(Layer.tap(() => heldCleanup))),
+                    ),
+                offlineModels,
+              ]),
+            ),
+          )
+        }),
+    )
+  }
+}
