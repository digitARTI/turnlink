@@ -0,0 +1,126 @@
+export * as SessionPlacementGuard from "./placement-guard.js"
+
+import { getTableColumns, sql } from "drizzle-orm"
+import { Effect, Option } from "effect"
+import type { Database } from "../database/database.js"
+import { NativeMovementConnection } from "../database/movement-connection.js"
+import { KVTable } from "../kv/sql.js"
+import { EventSequenceTable, EventTable } from "../event/sql.js"
+import { SessionEvent } from "./event.js"
+import { MovementFence } from "./movement-fence.js"
+import { SessionMessageTable, SessionTable } from "./sql.js"
+
+type DB = Database.Interface["db"]
+const intentPrefix = "session-movement-intent:v1:"
+const ticketPrefix = "native-session-placement-ticket:v1:"
+const fn = sql.raw(NativeMovementConnection.functionName)
+
+export interface Ticket {
+  readonly token: string
+  readonly sessionID: string
+  readonly eventID: string
+  readonly seq: number
+  readonly created: number
+  readonly sourceDirectory: string
+  readonly sourceWorkspace: string | null
+  readonly destinationDirectory: string
+  readonly destinationWorkspace: string | null
+  readonly projectID: string
+  readonly subpath: string | null
+  readonly messageID: string
+  readonly messageData: string
+  readonly eventData: string
+}
+
+/** Upgrade only the writes needed by one placement; quarantine remains present. */
+export const install = Effect.fn("SessionPlacementGuard.install")(function* (db: DB, owner: MovementFence.Owner) {
+  if (Option.isNone(yield* Effect.serviceOption(db.$client.transactionService)))
+    return yield* Effect.die("Placement guard requires an active transaction")
+  yield* MovementFence.assertOwner(db, owner)
+  const unchanged = Object.values(getTableColumns(SessionTable))
+    .map((column) => column.name)
+    .filter((column) => !["directory", "workspace_id", "project_id", "path", "time_updated"].includes(column))
+    .map((column) => sql`OLD.${sql.identifier(column)} IS NEW.${sql.identifier(column)}`)
+  const ticket = (session: ReturnType<typeof sql.raw>, predicate: ReturnType<typeof sql.raw> | ReturnType<typeof sql>) => sql`
+    EXISTS (SELECT 1 FROM ${KVTable} AS ticket
+      WHERE ticket.key = ${ticketPrefix} || ${session}
+        AND ${fn}('native-placement-write:' || ${session}, json_extract(ticket.value, '$.token'))
+        AND ${predicate})
+  `.inlineParams()
+  const checks = [
+    { name: "session_update", table: SessionTable, operation: "UPDATE", session: sql`OLD.id`, allow: ticket(sql`OLD.id`, sql`
+      NEW.id IS OLD.id AND OLD.directory IS json_extract(ticket.value, '$.sourceDirectory')
+      AND OLD.workspace_id IS json_extract(ticket.value, '$.sourceWorkspace')
+      AND NEW.directory IS json_extract(ticket.value, '$.destinationDirectory')
+      AND NEW.workspace_id IS json_extract(ticket.value, '$.destinationWorkspace')
+      AND NEW.project_id IS json_extract(ticket.value, '$.projectID') AND NEW.path IS json_extract(ticket.value, '$.subpath')
+      AND NEW.time_updated IS json_extract(ticket.value, '$.created') AND ${sql.join(unchanged, sql` AND `)}
+    `) },
+    { name: "message_insert", table: SessionMessageTable, operation: "INSERT", session: sql`NEW.session_id`, allow: ticket(sql`NEW.session_id`, sql`
+      NEW.id IS json_extract(ticket.value, '$.messageID') AND NEW.type IS 'location-switched'
+      AND NEW.seq IS json_extract(ticket.value, '$.seq') AND NEW.time_created IS json_extract(ticket.value, '$.created')
+      AND NEW.data IS json_extract(ticket.value, '$.messageData')
+    `) },
+    { name: "sequence_insert", table: EventSequenceTable, operation: "INSERT", session: sql`NEW.aggregate_id`, allow: ticket(sql`NEW.aggregate_id`, sql`
+      NEW.seq IS json_extract(ticket.value, '$.seq') AND NEW.owner_id IS NULL
+    `) },
+    { name: "sequence_update", table: EventSequenceTable, operation: "UPDATE", session: sql`OLD.aggregate_id`, allow: ticket(sql`OLD.aggregate_id`, sql`
+      NEW.aggregate_id IS OLD.aggregate_id AND OLD.seq IS (json_extract(ticket.value, '$.seq') - 1)
+      AND NEW.seq IS json_extract(ticket.value, '$.seq') AND NEW.owner_id IS OLD.owner_id
+    `) },
+    { name: "event_insert", table: EventTable, operation: "INSERT", session: sql`NEW.aggregate_id`, allow: ticket(sql`NEW.aggregate_id`, sql`
+      NEW.id IS json_extract(ticket.value, '$.eventID') AND NEW.seq IS json_extract(ticket.value, '$.seq')
+      AND NEW.created IS json_extract(ticket.value, '$.created')
+      AND NEW.type IS ${`${SessionEvent.Moved.type}.${SessionEvent.Moved.durable.version}`}
+      AND NEW.data IS json_extract(ticket.value, '$.eventData')
+    `) },
+  ] as const
+  for (const check of checks) {
+    const name = `_session_movement_v1_${check.name}`
+    const newSession = check.name === "session_update" ? sql`NEW.id` :
+      check.name === "sequence_update" ? sql`NEW.aggregate_id` : undefined
+    const quarantined = sql`EXISTS (SELECT 1 FROM ${KVTable} WHERE ${KVTable.key} = ${intentPrefix} || ${check.session})`
+    const condition = newSession ? sql`${quarantined} OR EXISTS (SELECT 1 FROM ${KVTable}
+      WHERE ${KVTable.key} = ${intentPrefix} || ${newSession})` : quarantined
+    yield* db.run(sql`DROP TRIGGER IF EXISTS ${sql.identifier(name)}`).pipe(Effect.orDie)
+    yield* db.run(sql`
+      CREATE TRIGGER ${sql.identifier(name)} BEFORE ${sql.raw(check.operation)} ON ${check.table}
+      WHEN (${condition}) AND NOT ${check.allow}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_QUARANTINED'); END
+    `.inlineParams()).pipe(Effect.orDie)
+  }
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const condition = operation === "INSERT" ? sql`
+      NEW.key LIKE ${ticketPrefix + "%"} AND (NEW.key IS NOT (${ticketPrefix} || json_extract(NEW.value, '$.sessionID'))
+        OR EXISTS (SELECT 1 FROM ${KVTable} AS existing WHERE existing.key = NEW.key)
+        OR NOT ${fn}('native-placement-ticket-add:' || json_extract(NEW.value, '$.sessionID'), json_extract(NEW.value, '$.token')))
+    ` : operation === "UPDATE" ? sql`OLD.key LIKE ${ticketPrefix + "%"} OR NEW.key LIKE ${ticketPrefix + "%"}` : sql`
+      OLD.key LIKE ${ticketPrefix + "%"} AND NOT ${fn}('native-placement-ticket-remove:' || json_extract(OLD.value, '$.sessionID'), json_extract(OLD.value, '$.token'))
+    `
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_placement_ticket_v1_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_PLACEMENT_TICKET_REFUSED'); END
+    `.inlineParams()).pipe(Effect.orDie)
+  }
+})
+
+export const addTicket = Effect.fn("SessionPlacementGuard.addTicket")(function* (
+  db: DB, movement: NativeMovementConnection.Interface, ticket: Ticket,
+) {
+  const capability = `native-placement-ticket-add:${ticket.sessionID}`
+  yield* movement.authorize(capability, ticket.token).pipe(Effect.orDie)
+  yield* db.insert(KVTable).values({ key: ticketPrefix + ticket.sessionID, value: { ...ticket } }).run().pipe(
+    Effect.orDie, Effect.ensuring(movement.revoke(capability, ticket.token)),
+  )
+})
+
+export const removeTicket = Effect.fn("SessionPlacementGuard.removeTicket")(function* (
+  db: DB, movement: NativeMovementConnection.Interface, ticket: Ticket,
+) {
+  const capability = `native-placement-ticket-remove:${ticket.sessionID}`
+  yield* movement.authorize(capability, ticket.token).pipe(Effect.orDie)
+  yield* db.run(sql`DELETE FROM ${KVTable} WHERE ${KVTable.key} = ${ticketPrefix + ticket.sessionID}`).pipe(
+    Effect.orDie, Effect.ensuring(movement.revoke(capability, ticket.token)),
+  )
+})
diff --git a/packages/core/src/session/placement-receipt.ts b/packages/core/src/session/placement-receipt.ts
new file mode 100644
index 0000000..6d11e57
--- /dev/null
+++ b/packages/core/src/session/placement-receipt.ts
@@ -0,0 +1,117 @@
+export * as SessionPlacementReceipt from "./placement-receipt.js"
+
+import { eq } from "drizzle-orm"
+import { Effect, Option, Schema } from "effect"
+import { Event } from "@opencode/schema/event"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { isDeepStrictEqual } from "node:util"
+import { Bus } from "../bus.js"
+import { Database } from "../database/database.js"
+import { NativeMovementConnection } from "../database/movement-connection.js"
+import { NativeMovementProtection } from "../database/movement-protection.js"
+import { EventSequenceTable, EventTable } from "../event/sql.js"
+import { KVTable } from "../kv/sql.js"
+import { RelativePath } from "../schema.js"
+import { SessionEvent } from "./event.js"
+import { SessionMembershipArchive } from "./membership-archive.js"
+import { SessionMembershipSeal } from "./membership-seal.js"
+import { SessionMessage } from "./message.js"
+import { MovementFence } from "./movement-fence.js"
+import { SessionSchema } from "./schema.js"
+import { SessionMessageTable, SessionTable } from "./sql.js"
+
+export const prefix = "native-session-placement:v1:"
+export const Record = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, transitionID: Schema.String,
+  source: Location.Ref, destination: Location.Ref, projectID: Project.ID,
+  subpath: Schema.optional(RelativePath), eventID: Event.ID, eventSeq: Event.Seq,
+  archiveNonce: Schema.String, stageNonce: Schema.String, receiverHash: Schema.String,
+  leaseIncarnation: Schema.String,
+})
+export type Record = typeof Record.Type
+const key = (sessionID: SessionSchema.ID, transitionID: string) => prefix + sessionID + ":" + transitionID
+const sameLocation = (left: Location.Ref, right: Location.Ref) =>
+  left.directory === right.directory && left.workspaceID === right.workspaceID
+
+/** Validate actual durable state, never merely the presence of a receipt. */
+export const validate = Effect.fn("SessionPlacementReceipt.validate")(function* (db: Database.Interface["db"], receipt: Record) {
+  const intent = yield* MovementFence.find(db, receipt.sessionID)
+  const archive = yield* SessionMembershipArchive.find(db, receipt.sessionID, receipt.transitionID)
+  const stage = yield* SessionMembershipArchive.findDestination(db, receipt.sessionID, receipt.transitionID)
+  const seal = yield* SessionMembershipSeal.find(db, receipt.sessionID)
+  if (!intent || !archive || !stage || !seal || intent.transitionID !== receipt.transitionID ||
+    !sameLocation(intent.source, receipt.source) || intent.directory !== receipt.destination.directory ||
+    archive.transitionID !== receipt.transitionID || stage.transitionID !== receipt.transitionID ||
+    seal.transitionID !== receipt.transitionID || archive.pluginID !== intent.pluginID ||
+    stage.pluginID !== intent.pluginID || seal.pluginID !== intent.pluginID ||
+    !sameLocation(archive.source, receipt.source) || !sameLocation(stage.source, receipt.source) ||
+    !sameLocation(seal.source, receipt.source) || archive.destination !== receipt.destination.directory ||
+    stage.destination !== receipt.destination.directory || seal.destination !== receipt.destination.directory ||
+    archive.nonce !== receipt.archiveNonce || seal.nonce !== archive.nonce || stage.archiveNonce !== archive.nonce ||
+    stage.archiveDigest !== archive.valueDigest || stage.nonce !== receipt.stageNonce ||
+    stage.receiverHash !== receipt.receiverHash || !archive.leaseIncarnation || stage.leaseIncarnation !== archive.leaseIncarnation ||
+    seal.leaseIncarnation !== archive.leaseIncarnation || intent.membershipFence !== 1 || !receipt.leaseIncarnation ||
+    !archive.value || typeof archive.value !== "object" || Array.isArray(archive.value) ||
+    !isDeepStrictEqual(stage.value, { ...archive.value, directory: receipt.destination.directory,
+      receiverHandoff: { transitionID: receipt.transitionID, receiverHash: receipt.receiverHash } }))
+    return yield* Effect.die("Placement receipt does not match native quarantine and membership evidence")
+  const membership = yield* db.select({ value: KVTable.value }).from(KVTable)
+    .where(eq(KVTable.key, `${stage.namespace}memberships/${receipt.sessionID}`)).get().pipe(Effect.orDie)
+  const session = yield* db.select().from(SessionTable).where(eq(SessionTable.id, receipt.sessionID)).get().pipe(Effect.orDie)
+  const event = yield* db.select().from(EventTable).where(eq(EventTable.id, receipt.eventID)).get().pipe(Effect.orDie)
+  const sequence = yield* db.select().from(EventSequenceTable)
+    .where(eq(EventSequenceTable.aggregate_id, receipt.sessionID)).get().pipe(Effect.orDie)
+  const message = yield* db.select().from(SessionMessageTable)
+    .where(eq(SessionMessageTable.id, SessionMessage.ID.fromEvent(receipt.eventID))).get().pipe(Effect.orDie)
+  const payload = event && Schema.decodeUnknownOption(SessionEvent.Moved.data)(event.data)
+  const decoded = payload && Option.isSome(payload) ? payload.value : undefined
+  const messageValue = message && Schema.decodeUnknownOption(SessionMessage.LocationSwitched)({ ...message.data, id: message.id, type: message.type })
+  const switched = messageValue && Option.isSome(messageValue) ? messageValue.value : undefined
+  if (!membership || !isDeepStrictEqual(membership.value, stage.value) ||
+    !session || session.directory !== receipt.destination.directory || (session.workspace_id ?? undefined) !== receipt.destination.workspaceID ||
+    session.project_id !== receipt.projectID || (session.path ?? undefined) !== receipt.subpath ||
+    !event || event.aggregate_id !== receipt.sessionID || event.seq !== receipt.eventSeq ||
+    event.type !== Event.versionedType(SessionEvent.Moved.type, SessionEvent.Moved.durable.version) ||
+    !decoded || decoded.sessionID !== receipt.sessionID || !sameLocation(decoded.location, receipt.destination) ||
+    decoded.projectID !== receipt.projectID || decoded.subpath !== receipt.subpath ||
+    !sequence || sequence.seq < receipt.eventSeq || !message || message.session_id !== receipt.sessionID ||
+    message.seq !== receipt.eventSeq || !switched || !sameLocation(switched.location, receipt.destination) ||
+    switched.projectID !== receipt.projectID || switched.subpath !== receipt.subpath ||
+    !switched.previous || !sameLocation(switched.previous.location, receipt.source))
+    return yield* Effect.die("Placement receipt does not match committed Session, event and membership")
+  yield* NativeMovementProtection.assertProtectedPlacement(db, receipt.sessionID, receipt.destination)
+})
+
+/** Record only within the same transaction as the already-projected move. */
+export const insert = Effect.fn("SessionPlacementReceipt.insert")(function* (
+  db: Database.Interface["db"], movement: NativeMovementConnection.Interface, receipt: Record,
+) {
+  if (Option.isNone(yield* Effect.serviceOption(db.$client.transactionService)))
+    return yield* Effect.die("Placement receipt requires an active transaction")
+  yield* Bus.assertPersistedBoundary(db, receipt.eventID, receipt.sessionID, receipt.eventSeq)
+  if ((yield* movement.claim.pipe(Effect.orDie)) !== receipt.leaseIncarnation)
+    return yield* Effect.die("Placement receipt lease changed")
+  const intent = yield* MovementFence.find(db, receipt.sessionID)
+  const recovery = yield* MovementFence.findRecovery(db, receipt.sessionID)
+  if (!intent || (recovery
+    ? recovery.transitionID !== receipt.transitionID || recovery.previousLeaseIncarnation !== intent.leaseIncarnation ||
+      recovery.leaseIncarnation !== receipt.leaseIncarnation
+    : intent.leaseIncarnation !== receipt.leaseIncarnation))
+    return yield* Effect.die("Placement receipt does not belong to the current quarantine owner")
+  yield* validate(db, receipt)
+  yield* NativeMovementProtection.protectPlacementReceipt(db)
+  yield* db.insert(KVTable).values({ key: key(receipt.sessionID, receipt.transitionID), value: Schema.encodeSync(Record)(receipt) })
+    .run().pipe(Effect.orDie)
+})
+
+/** Recovery rechecks all evidence under the current native connection. */
+export const find = Effect.fn("SessionPlacementReceipt.find")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID, transitionID: string) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, key(sessionID, transitionID))).get().pipe(Effect.orDie)
+  if (!row) return
+  const receipt = yield* Schema.decodeUnknownEffect(Record)(row.value).pipe(Effect.orDie)
+  if (receipt.sessionID !== sessionID || receipt.transitionID !== transitionID)
+    return yield* Effect.die("Placement receipt identity mismatch")
+  yield* validate(db, receipt)
+  return receipt
+})
diff --git a/packages/core/src/session/placement-transaction.ts b/packages/core/src/session/placement-transaction.ts
new file mode 100644
index 0000000..ccbeda6
--- /dev/null
+++ b/packages/core/src/session/placement-transaction.ts
@@ -0,0 +1,163 @@
+export * as SessionPlacementTransaction from "./placement-transaction.js"
+
+import { randomUUID } from "node:crypto"
+import { isDeepStrictEqual } from "node:util"
+import { eq } from "drizzle-orm"
+import { DateTime, Effect, Schema } from "effect"
+import { Event } from "@opencode/schema/event"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { Bus } from "../bus.js"
+import { Database } from "../database/database.js"
+import { NativeMovementProtection } from "../database/movement-protection.js"
+import { KVTable } from "../kv/sql.js"
+import { RelativePath } from "../schema.js"
+import { SessionEvent } from "./event.js"
+import { SessionExecution } from "./execution.js"
+import { SessionMembershipArchive } from "./membership-archive.js"
+import { SessionMembershipSeal } from "./membership-seal.js"
+import { SessionMessage } from "./message.js"
+import { MovementFence } from "./movement-fence.js"
+import { SessionPlacementGuard } from "./placement-guard.js"
+import { SessionPlacementReceipt } from "./placement-receipt.js"
+import { SessionTable } from "./sql.js"
+import { SessionMovement } from "./movement.js"
+
+export interface Input {
+  readonly database: Database.Interface
+  readonly bus: Bus.Interface
+  readonly execution: SessionExecution.Interface
+  readonly owner: MovementFence.Owner
+  readonly destination: Location.Ref
+  readonly projectID: Project.ID
+  readonly subpath?: RelativePath
+  readonly receiverHash: string
+}
+
+/** Internal engine. Callers must establish destination authority and receiver
+ * continuity; this operation acquires the actual native execution reservation. */
+export const commit = (input: Input) => {
+  return commitWithChecks(input)
+}
+
+/** Staged native path: revalidate the actual prepared observation inside the move transaction.
+ * Other destination authority, resource and receiver proofs are still required by the caller. */
+export const commitPrepared = (input: Input & { readonly prepared: SessionMovement.PreparedAuthority }) => {
+  const captured = Object.freeze({ ...input, database: Object.freeze({ db: input.database.db, movement: input.database.movement }),
+    destination: Object.freeze(Location.Ref.make({
+    directory: input.destination.directory, workspaceID: input.destination.workspaceID,
+  })) })
+  return Effect.gen(function* () {
+    const checks = yield* SessionMovement.preparedPlacementChecks(captured.prepared, captured.database.db, captured.owner, captured)
+    return yield* commitWithChecks(captured, checks)
+  })
+}
+
+const commitWithChecks = (input: Input, checks?: { readonly before: Effect.Effect<void>; readonly after: Effect.Effect<void> }) => {
+  const database = Object.freeze({ db: input.database.db, movement: input.database.movement })
+  if (!SessionExecution.ownsNativeReservation(input.execution, database.db) || !input.execution.withMovementTreeReservation ||
+    !input.execution.assertMovementModelTransportClear || !input.execution.assertNoMovementBackground)
+    return Effect.die("Native placement requires the execution reservation")
+  if (!Bus.persistsFor(input.bus, database.db)) return Effect.die("Native placement requires the durable event bus")
+  const destination = Object.freeze(Location.Ref.make({
+    directory: input.destination.directory, workspaceID: input.destination.workspaceID,
+  }))
+  const captured = Object.freeze({ ...input, database, destination })
+  return input.execution.withMovementTreeReservation(input.owner, commitReserved(captured, checks))
+}
+
+const commitReserved = Effect.fn("SessionPlacementTransaction.commitReserved")(function* (input: Input,
+  checks?: { readonly before: Effect.Effect<void>; readonly after: Effect.Effect<void> }) {
+  const { database, bus, owner } = input
+  const db = database.db
+  const movement = database.movement
+  if (!movement) return yield* Effect.die("Native placement requires a compatible connection")
+  const sessionID = yield* MovementFence.ownerSession(db, owner)
+  yield* MovementFence.assertOwner(db, owner)
+  const intent = yield* MovementFence.find(db, sessionID)
+  if (!intent || intent.directory !== input.destination.directory || intent.source.workspaceID !== input.destination.workspaceID ||
+    !/^[a-f0-9]{64}$/.test(input.receiverHash))
+    return yield* Effect.die("Native placement does not match its quarantined destination")
+  const lease = yield* movement.claim.pipe(Effect.orDie)
+  const eventID = Event.ID.create()
+  const token = randomUUID()
+  let needsRefresh = false
+  let ticket: SessionPlacementGuard.Ticket | undefined
+  const writeCapability = `native-placement-write:${sessionID}`
+  const effect = bus.publish(SessionEvent.Moved, {
+    sessionID, location: input.destination, projectID: input.projectID, subpath: input.subpath,
+  }, {
+    id: eventID,
+    beforeProject: (seq, event) => Effect.gen(function* () {
+      yield* MovementFence.assertOwner(db, owner)
+      if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native placement lease changed")
+      yield* input.execution.assertMovementModelTransportClear!(owner)
+      yield* input.execution.assertNoMovementBackground!(sessionID).pipe(Effect.orDie)
+      if (checks) yield* checks.before
+      yield* MovementFence.assertOwner(db, owner)
+      const archive = yield* SessionMembershipArchive.find(db, sessionID, intent.transitionID)
+      const stage = yield* SessionMembershipArchive.findDestination(db, sessionID, intent.transitionID)
+      const seal = yield* SessionMembershipSeal.find(db, sessionID)
+      const session = yield* db.select().from(SessionTable).where(eq(SessionTable.id, sessionID)).get().pipe(Effect.orDie)
+      const membershipKey = `${stage?.namespace ?? ""}memberships/${sessionID}`
+      const membership = yield* db.select({ key: KVTable.key }).from(KVTable).where(eq(KVTable.key, membershipKey)).get().pipe(Effect.orDie)
+      if (!archive || !stage || !seal || !session || membership || intent.membershipFence !== 1 ||
+        intent.pluginID !== archive.pluginID || intent.pluginID !== stage.pluginID || intent.pluginID !== seal.pluginID ||
+        archive.transitionID !== intent.transitionID || stage.transitionID !== intent.transitionID || seal.transitionID !== intent.transitionID ||
+        archive.nonce !== seal.nonce || archive.nonce !== stage.archiveNonce || archive.valueDigest !== stage.archiveDigest ||
+        seal.leaseIncarnation !== archive.leaseIncarnation || stage.leaseIncarnation !== archive.leaseIncarnation ||
+        stage.receiverHash !== input.receiverHash || archive.destination !== intent.directory || stage.destination !== intent.directory ||
+        seal.destination !== intent.directory || !archive.value || typeof archive.value !== "object" || Array.isArray(archive.value) ||
+        !isDeepStrictEqual(stage.value, { ...archive.value, directory: intent.directory,
+          receiverHandoff: { transitionID: intent.transitionID, receiverHash: input.receiverHash } }) ||
+        session.directory !== intent.source.directory || (session.workspace_id ?? undefined) !== intent.source.workspaceID)
+        return yield* Effect.die("Native placement membership, seal or source does not match the quarantine")
+      yield* SessionPlacementGuard.install(db, owner)
+      const sealCapability = `membership-seal:${sessionID}`
+      yield* movement.authorize(sealCapability, seal.binding).pipe(Effect.orDie)
+      yield* db.delete(KVTable).where(eq(KVTable.key, SessionMembershipSeal.prefix + sessionID)).run().pipe(
+        Effect.orDie, Effect.ensuring(movement.revoke(sealCapability, seal.binding)),
+      )
+      yield* db.insert(KVTable).values({ key: membershipKey, value: stage.value }).run().pipe(Effect.orDie)
+      yield* db.insert(KVTable).values({ key: SessionMembershipSeal.prefix + sessionID,
+        value: Schema.encodeSync(SessionMembershipSeal.Record)(seal) }).run().pipe(Effect.orDie)
+      const message = SessionMessage.LocationSwitched.make({ id: SessionMessage.ID.fromEvent(eventID), type: "location-switched",
+        location: input.destination, projectID: input.projectID, subpath: input.subpath,
+        previous: { location: intent.source, projectID: session.project_id,
+          subpath: session.path === null ? undefined : RelativePath.make(session.path) },
+        time: { created: DateTime.makeUnsafe(event.created) } })
+      const { id: messageID, type: _type, ...messageData } = Schema.encodeSync(SessionMessage.LocationSwitched)(message)
+      ticket = { token, sessionID, eventID, seq, created: event.created, sourceDirectory: intent.source.directory,
+        sourceWorkspace: intent.source.workspaceID ?? null, destinationDirectory: input.destination.directory,
+        destinationWorkspace: input.destination.workspaceID ?? null, projectID: input.projectID, subpath: input.subpath ?? null,
+        messageID, messageData: JSON.stringify(messageData),
+        eventData: JSON.stringify(Schema.encodeUnknownSync(SessionEvent.Moved.data)(event.data)) }
+      yield* SessionPlacementGuard.addTicket(db, movement, ticket)
+      needsRefresh = true
+      yield* NativeMovementProtection.rebindPlacement(db, movement, sessionID, intent.source, input.destination).pipe(Effect.orDie)
+      yield* movement.authorize(writeCapability, token).pipe(Effect.orDie)
+    }),
+    afterPersist: (seq) => Effect.gen(function* () {
+      if (!ticket || ticket.seq !== seq || (yield* movement.claim.pipe(Effect.orDie)) !== lease)
+        return yield* Effect.die("Native placement transaction lost its ticket or lease")
+      const stage = yield* SessionMembershipArchive.findDestination(db, sessionID, intent.transitionID)
+      if (!stage) return yield* Effect.die("Native destination stage disappeared")
+      const receipt = SessionPlacementReceipt.Record.make({ version: 1, sessionID, transitionID: intent.transitionID,
+        source: intent.source, destination: input.destination, projectID: input.projectID, subpath: input.subpath,
+        eventID, eventSeq: Event.Seq.make(seq), archiveNonce: stage.archiveNonce, stageNonce: stage.nonce,
+        receiverHash: input.receiverHash, leaseIncarnation: lease })
+      yield* SessionPlacementReceipt.insert(db, movement, receipt)
+      yield* SessionPlacementGuard.removeTicket(db, movement, ticket)
+      if (checks) yield* checks.after
+      yield* input.execution.assertNoMovementBackground!(sessionID).pipe(Effect.orDie)
+      yield* MovementFence.assertOwner(db, owner)
+    }),
+  })
+  yield* Effect.uninterruptible(effect.pipe(Effect.ensuring(Effect.gen(function* () {
+    yield* movement.revoke(writeCapability, token)
+    if (needsRefresh) yield* NativeMovementProtection.refreshPlacement(db, movement, sessionID).pipe(Effect.orDie)
+  }))))
+  const receipt = yield* SessionPlacementReceipt.find(db, sessionID, intent.transitionID)
+  if (!receipt) return yield* Effect.die("Committed native placement receipt is absent")
+  return receipt
+})
diff --git a/packages/core/src/session/reservation-authority.ts b/packages/core/src/session/reservation-authority.ts
new file mode 100644
index 0000000..58ef2fc
--- /dev/null
+++ b/packages/core/src/session/reservation-authority.ts
@@ -0,0 +1,150 @@
+export * as ReservationAuthority from "./reservation-authority.js"
+
+import { Context, Deferred, Effect, Exit, Layer, Option, Scope } from "effect"
+import { makeGlobalNode } from "@opencode/util/effect/app-node"
+import { NativeMovementCommitFence } from "../database/movement-commit-fence.js"
+
+export interface Changes {
+  readonly mark: Effect.Effect<void>
+  /** Synchronous native callbacks must fence changes before queueing their worker. */
+  readonly markUnsafe: () => number
+  /** Counts queued native mutations independently; undefined refuses a closed owner. */
+  readonly holdUnsafe: () => Effect.Effect<void> | undefined
+  readonly revision: Effect.Effect<number>
+  /** Only settles the observed batch; newer changes remain fenced. */
+  readonly settle: (revision: number) => Effect.Effect<void>
+}
+
+export interface Interface {
+  /** Process-local native lease. Only explicit successful cleanup releases it;
+   * disposing a borrower/producer scope is not itself settlement evidence. */
+  readonly retainUnsafe: () => Effect.Effect<void>
+  /** Process-local revision, not a persistent grant or destination proof. */
+  readonly revision: Effect.Effect<number>
+  /** Invalidates held guards without waiting for their cleanup or delaying revocations. */
+  readonly invalidate: Effect.Effect<void>
