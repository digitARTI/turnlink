+        expect(policy.current().statements).toEqual([{ action: "tool.use", resource: "shell:*", effect: "deny" }])
+      }
+      if (mutation === "grant") {
+        yield* saved.add({ projectID: Project.ID.global, action: "shell", resources: ["*"] })
