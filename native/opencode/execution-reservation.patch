+        ? Effect.suspend(() => {
+          if (livePhase !== "released" || liveTransition !== decoded.transitionID) return Effect.fail(new Error("Native live operation unavailable"))
+          livePhase = "detaching"
+          return (promoted ?? owner).detachLiveMembership({ sessionID: decoded.sessionID, transitionID: decoded.transitionID!, channel: decoded.channel! }).pipe(
