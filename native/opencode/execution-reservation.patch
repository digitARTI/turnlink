+      const release = yield* Deferred.make<void>()
+      const cleaning = yield* Deferred.make<void>()
+      const cleanup = yield* Deferred.make<void>()
+      let creations = 0
+      const host = yield* fixture((git) => ({
+        ...git,
+        objects: { ...git.objects, pack: () => Effect.void },
+        repo: {
+          ...git.repo,
+          create: (input) =>
