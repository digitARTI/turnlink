@@ -0,0 +1,367 @@
+export * as NativeMovementControl from "./native-movement-control"
+
+import { SessionMovement } from "@opencode/core/session/movement"
+import { SessionPlacementTransaction } from "@opencode/core/session/placement-transaction"
+import { SessionPlacementCompletion } from "@opencode/core/session/placement-completion"
+import { SessionExecution } from "@opencode/core/session/execution"
+import { Database } from "@opencode/core/database/database"
+import { Bus } from "@opencode/core/bus"
+import { MovementFence } from "@opencode/core/session/movement-fence"
+import { SessionSchema } from "@opencode/core/session/schema"
+import { Location } from "@opencode/core/location"
+import { AbsolutePath } from "@opencode/core/schema"
+import { Cause, Deferred, Effect, Exit, Fiber, Queue, Schedule, Schema, Scope } from "effect"
+import { randomUUID } from "node:crypto"
+import { createReadStream, createWriteStream, fstatSync } from "node:fs"
+
+const frameLimit = 16 * 1024
+const capacity = 8
+class NativePrepareBusy extends Error {}
+const Request = Schema.Struct({
+  id: Schema.Int.check(Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(Number.MAX_SAFE_INTEGER)),
+  method: Schema.Literals(["inspect", "inspectLive", "observeIdle", "holdIdle", "checkIdle", "observeHeldAuthority", "releaseIdle", "prepareHeld", "promoteLive", "claimRecovery", "inspectRecovery", "observeRecoveryTransport", "observeRecoveryRecord", "observePlacement", "observeCompletion", "commitPreparedPlacement", "completePlacement", "takeoverRecovery", "sealMembership", "detachMembership", "detachLiveMembership", "observeDetachedMembership", "stageDestinationMembership", "stageRecoveredDestinationMembership", "observeDestinationMembership", "prepare", "releaseTransport"]),
+  sessionID: SessionSchema.ID,
+  transitionID: Schema.optional(Schema.String),
+  expected: Schema.optional(MovementFence.Recovery),
+  targetLease: Schema.optional(Schema.String),
+  directory: Schema.optional(AbsolutePath),
+  channel: Schema.optional(Schema.String),
+  receiverHash: Schema.optional(Schema.String),
+  promotionID: Schema.optional(Schema.String),
+  holdID: Schema.optional(Schema.String),
+})
+
+/** Private inherited socket only; live mode must be explicitly supplied by the native host. */
+export const start = Effect.fn("NativeMovementControl.start")((input: {
+  readonly fd: number
+  readonly pluginID: string
+  readonly location: Location.Ref
+  readonly sessionID: SessionSchema.ID
+  readonly movement: SessionMovement.Interface
+  readonly database?: Database.Interface
+  readonly bus?: Bus.Interface
+  readonly execution?: SessionExecution.Interface
+  readonly mode?: "recovery" | "live"
+}) => Effect.uninterruptibleMask((restore) => Effect.gen(function* () {
+  if (!Number.isSafeInteger(input.fd) || input.fd < 3)
+    return yield* Effect.fail(new Error("Private native movement descriptor is invalid"))
+  const scope = yield* Scope.make()
+  const streams = yield* Effect.try({
+    try: () => {
+      if (!fstatSync(input.fd).isSocket()) throw new Error("Expected an inherited socket")
+      const read = createReadStream("", { fd: input.fd, autoClose: true })
+      const write = createWriteStream("", { fd: input.fd, autoClose: false })
+      // Attach handlers before any asynchronous activation can yield.
+      read.on("error", () => {})
+      write.on("error", () => {})
+      return { read, write }
+    },
+    catch: () => new Error("Private native movement socket unavailable"),
+  }).pipe(Effect.onError(() => Scope.close(scope, Exit.void)))
+  const dispose = () => {
+    streams.write.destroy()
+    streams.read.destroy()
+  }
+  yield* Effect.addFinalizer(() => Effect.sync(dispose).pipe(Effect.andThen(Scope.close(scope, Exit.void))))
+  const owner = yield* restore(input.movement.forActivation({ pluginID: input.pluginID, location: input.location, authorized: true })
+    .pipe(Scope.provide(scope))).pipe(Effect.onError(() => Effect.sync(dispose).pipe(Effect.andThen(Scope.close(scope, Exit.void)))))
+  const queue = yield* Queue.bounded<Buffer | undefined>(capacity)
+  let buffered = Buffer.alloc(0)
+  let closed = false
+  let lastID = 0
+  let livePhase: "empty" | "preparing" | "prepared" | "releasing" | "released" | "detaching" | "detached" | "staging" | "staged" |
+    "committing" | "committed" | "completing" | "completed" = "empty"
+  let liveTransition: string | undefined
+  let promoted: SessionMovement.Activation | undefined
+  let promotionPhase: "empty" | "dispatching" | "active" = "empty"
+  type IdleAction = { type: "release" } | { type: "prepare"; transitionID: string; directory: typeof AbsolutePath.Type }
+  type IdleHold = { id: string; active: boolean; actionIssued: boolean; action: Deferred.Deferred<IdleAction>;
+    result: Deferred.Deferred<Exit.Exit<MovementFence.Intent | null, unknown>>; fiber?: Fiber.Fiber<void> }
+  let idleHold: IdleHold | undefined
+  const close = () => {
+    if (closed) return
+    closed = true
+    dispose()
+    Queue.offerUnsafe(queue, undefined)
+  }
+  const receive = (chunk: Buffer) => {
+    if (closed || chunk.length > frameLimit * capacity) return close()
+    const data = Buffer.concat([buffered, chunk])
+    let start = 0
+    for (let index = 0; index < data.length; index++) {
+      if (index - start >= frameLimit) return close()
+      if (data[index] !== 10) continue
+      if (!Queue.offerUnsafe(queue, data.subarray(start, index))) return close()
+      start = index + 1
+    }
+    buffered = Buffer.from(data.subarray(start))
+  }
