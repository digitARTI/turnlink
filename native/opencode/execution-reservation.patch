diff --git a/packages/core/test/process/stop-observation.test.ts b/packages/core/test/process/stop-observation.test.ts
new file mode 100644
index 0000000..173ce6e
--- /dev/null
+++ b/packages/core/test/process/stop-observation.test.ts
@@ -0,0 +1,172 @@
+import { expect } from "bun:test"
+import { Effect, Exit, PlatformError, Scope, Stream } from "effect"
+import { ChildProcess } from "effect/process"
+import { ExitCode } from "effect/process/ChildProcessSpawner"
+import { AppProcess } from "@opencode/util/process"
+import { ProcessObservation } from "@opencode/util/process-observation"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(LayerNode.compile(AppProcess.node))
+
+for (const code of [0, 1]) {
+  for (const forced of [false, true]) {
+    it.live(`completed exit ${code}, forced cleanup ${forced} does not invent an active-stop failure`, () =>
+      Effect.gen(function* () {
+        const svc = yield* AppProcess.Service
+        const observed = { count: 0 }
+        const result = yield* svc
+          .run(
+            ChildProcess.make(
+              process.execPath,
+              ["-e", `process.exit(${code})`],
+              forced ? { forceKillAfter: "1 second" } : {},
+            ),
+          )
+          .pipe(
+            Effect.provideService(ProcessObservation, {
+              unresolved: Effect.sync(() => {
+                observed.count++
+              }),
+            }),
+          )
+        expect(result.exitCode).toBe(code)
+        expect(observed.count).toBe(0)
+      }),
+    )
+  }
+}
+
+it.live("failed explicit stop reports before the failed receipt, using its captured invocation sink", () =>
+  Effect.gen(function* () {
+    const svc = yield* AppProcess.Service
+    const observed = { captured: 0, caller: 0 }
+    const handle = yield* svc.spawn(ChildProcess.make(process.execPath, ["-e", "process.exit(0)"])).pipe(
+      Effect.provideService(ProcessObservation, {
+        unresolved: Effect.sync(() => {
+          observed.captured++
+        }),
+      }),
+    )
+    expect(yield* handle.exitCode).toBe(ExitCode(0))
+    // Both native kill paths now fail for this exited child. The failed receipt
+    // must not be mistaken for a successful stop, even though exit was observed.
+    const result = yield* handle.kill().pipe(
+      Effect.provideService(ProcessObservation, {
+        unresolved: Effect.sync(() => {
+          observed.caller++
+        }),
+      }),
+      Effect.exit,
+    )
+    expect(Exit.isFailure(result)).toBe(true)
+    expect(observed.captured).toBe(1)
+    expect(observed.caller).toBe(0)
+  }),
+)
+
+it.live("successful active stop does not report uncertainty", () =>
+  Effect.gen(function* () {
+    const svc = yield* AppProcess.Service
+    const observed = { count: 0 }
+    const handle = yield* svc
+      .spawn(ChildProcess.make(process.execPath, ["-e", "process.stdout.write('ready\\n');setInterval(()=>{},60000)"]))
+      .pipe(
+        Effect.provideService(ProcessObservation, {
+          unresolved: Effect.sync(() => {
+            observed.count++
+          }),
+        }),
+      )
+    expect(yield* Stream.runHead(handle.stdout.pipe(Stream.decodeText))).toMatchObject({ value: "ready\n" })
+    yield* handle.kill({ killSignal: "SIGKILL" })
+    expect(observed.count).toBe(0)
+  }),
+)
+
+it.live("failed stop without an observer retains its native failure", () =>
+  Effect.gen(function* () {
+    const svc = yield* AppProcess.Service
+    const handle = yield* svc.spawn(ChildProcess.make(process.execPath, ["-e", "process.exit(0)"]))
+    expect(yield* handle.exitCode).toBe(ExitCode(0))
+    expect(Exit.isFailure(yield* handle.kill().pipe(Effect.exit))).toBe(true)
+  }),
+)
+
+// The invalid signal deliberately exercises a real native stop throw without
+// replacing process.kill. The test retains its handle for explicit valid cleanup.
+// Windows taskkill does not accept this signal argument, so this fault is POSIX-only.
+if (process.platform !== "win32") {
+  it.live("explicit native stop throw is a typed failure at its captured sink, not a defect", () =>
+    Effect.gen(function* () {
+      const svc = yield* AppProcess.Service
+      const observed = { captured: 0, caller: 0 }
+      const handle = yield* svc
+        .spawn(ChildProcess.make(process.execPath, ["-e", "process.stdout.write('ready\\n');setInterval(()=>{},60000)"]))
+        .pipe(
+          Effect.provideService(ProcessObservation, {
+            unresolved: Effect.sync(() => {
+              observed.captured++
+            }),
+          }),
+        )
+      yield* Effect.gen(function* () {
+        expect(yield* Stream.runHead(handle.stdout.pipe(Stream.decodeText))).toMatchObject({ value: "ready\n" })
+        const result = yield* handle.kill({ killSignal: "OPENCODE_INVALID_SIGNAL" as NodeJS.Signals }).pipe(
+          Effect.provideService(ProcessObservation, {
+            unresolved: Effect.sync(() => {
+              observed.caller++
+            }),
+          }),
+          Effect.exit,
+        )
+        expect(Exit.isFailure(result)).toBe(true)
+        if (!Exit.isFailure(result)) return
+        expect(result.cause.reasons).toHaveLength(1)
+        const reason = result.cause.reasons[0]
+        expect(reason?._tag).toBe("Fail")
+        if (!reason || reason._tag !== "Fail") return
+        expect(reason.error).toBeInstanceOf(PlatformError.PlatformError)
+        expect(reason.error.reason.module).toBe("ChildProcess")
+        expect(reason.error.reason.method).toBe("kill")
+        expect(reason.error.reason.cause).toBeInstanceOf(Error)
+        expect(observed).toEqual({ captured: 1, caller: 0 })
+      }).pipe(Effect.ensuring(handle.kill({ killSignal: "SIGKILL" }).pipe(Effect.ignore)))
+      expect(observed).toEqual({ captured: 1, caller: 0 })
+    }),
+  )
+
+  it.live("active finalizer typed stop failure retains uncertainty before scope closure returns", () =>
+    Effect.gen(function* () {
+      const svc = yield* AppProcess.Service
+      const owner = yield* Scope.make()
+      const observed = { count: 0 }
+      const handle = yield* svc
+        .spawn(
+          ChildProcess.make(process.execPath, ["-e", "process.stdout.write('ready\\n');setInterval(()=>{},60000)"], {
+            // SAFETY: deliberately invalid input; the fixture retains valid-signal cleanup.
+            killSignal: "OPENCODE_INVALID_SIGNAL" as NodeJS.Signals,
+          }),
+        )
+        .pipe(
+          Effect.provideService(ProcessObservation, {
+            unresolved: Effect.sync(() => {
+              observed.count++
+            }),
+          }),
+          Scope.provide(owner),
+        )
+      yield* Effect.gen(function* () {
+        expect(yield* Stream.runHead(handle.stdout.pipe(Stream.decodeText))).toMatchObject({ value: "ready\n" })
+        const result = yield* Scope.close(owner, Exit.void).pipe(Effect.exit)
+        // Best-effort finalizers ignore typed stop errors; successful scope closure
+        // is not a native cleanup receipt. The captured refusal must survive it.
+        expect(Exit.isSuccess(result)).toBe(true)
+        expect(observed.count).toBe(1)
+        // A later valid signal does not retract the failed stop observation.
+        yield* handle.kill({ killSignal: "SIGKILL" })
+        expect(observed.count).toBe(1)
+      }).pipe(Effect.onError(() => handle.kill({ killSignal: "SIGKILL" }).pipe(Effect.ignore)))
+    }),
+  )
+}
