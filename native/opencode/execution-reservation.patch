+export * as SessionMembershipSeal from "./membership-seal.js"
+
+import { eq } from "drizzle-orm"
+import { Effect, Schema } from "effect"
+import type { Database } from "../database/database.js"
+import { KVTable } from "../kv/sql.js"
+import * as Location from "@opencode/schema/location"
+import { AbsolutePath } from "../schema.js"
+import { SessionSchema } from "./schema.js"
+import { pluginStorageNamespace } from "../plugin/storage-namespace.js"
+
+export const prefix = "native-membership-seal:v1:"
+export const Record = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, transitionID: Schema.String, pluginID: Schema.String, namespace: Schema.String,
+  source: Location.Ref, destination: AbsolutePath, leaseIncarnation: Schema.String, nonce: Schema.String, binding: Schema.String,
+})
+export type Record = typeof Record.Type
+export const binding = (value: Omit<Record, "binding">) => JSON.stringify(value)
+
+export const find = Effect.fn("SessionMembershipSeal.find")(function* (db: Database.Interface["db"], sessionID: SessionSchema.ID) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID))
+    .get().pipe(Effect.orDie)
+  if (!row) return
+  const record = yield* Schema.decodeUnknownEffect(Record)(row.value).pipe(Effect.orDie)
+  const { binding: observed, ...input } = record
+  if (record.sessionID !== sessionID || record.namespace !== pluginStorageNamespace(record.pluginID) || observed !== binding(input))
+    return yield* Effect.die("Invalid native membership seal")
+  return record
+})
