+    expect(yield* authority.revision).toBe(revision)
+    yield* policy.set({ organization: "fixture", statements: [{ action: "tool.use", resource: "shell:*", effect: "allow" }] })
+    expect(yield* authority.revision).toBeGreaterThan(revision)
+    const updated = yield* authority.revision
+    yield* policy.set({ organization: "fixture", statements: [{ action: "tool.use", resource: "shell:*", effect: "allow" }] })
+    expect(yield* authority.revision).toBe(updated)
+  }),
+)
+
+it.effect("retained native leases survive scope disposal and release only their own count", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const first = yield* Effect.scoped(Effect.sync(() => authority.retainUnsafe()))
+    const second = authority.retainUnsafe()
+    const scope = yield* Scope.make()
+    const changes = yield* authority.trackChanges.pipe(Scope.provide(scope))
+    yield* changes.mark
+    yield* Scope.close(scope, Exit.void)
+    yield* first
+    yield* first
+    const pending = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+    expect(Exit.isFailure(pending) && Cause.hasInterruptsOnly(pending.cause)).toBe(true)
+    yield* second
+    yield* second
+    yield* authority.withStable(Effect.void)
+  }),
+)
+
+it.effect("queued mutation holds count independently from dirty batches and release idempotently", () =>
+  Effect.gen(function* () {
+    const authority = yield* ReservationAuthority.Service
+    const changes = yield* authority.trackChanges
+    const first = changes.holdUnsafe()
+    const second = changes.holdUnsafe()
+    if (!first || !second) return yield* Effect.die("open observer must admit holds")
+    yield* changes.mark
+    yield* changes.settle(yield* changes.revision)
+    yield* second
+    yield* second
+    const blocked = yield* authority.withStable(Effect.die("older queued work is still pending")).pipe(Effect.exit)
+    expect(Exit.isFailure(blocked) && Cause.hasInterruptsOnly(blocked.cause)).toBe(true)
+    yield* first
+    yield* authority.withStable(Effect.void)
+  }),
+)
+
+it.effect("disposing a queue observer releases only its own tokens and refuses late holds", () =>
