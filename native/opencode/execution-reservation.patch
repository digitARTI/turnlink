--- /dev/null
+++ b/packages/core/src/session/movement-directories.ts
@@ -0,0 +1,63 @@
+export * as MovementDirectories from "./movement-directories.js"
+
+import { closeSync, fstatSync, openSync, realpathSync, statSync } from "node:fs"
+
+type Entry = { path: string; real: string; fd: number; dev: bigint; ino: bigint }
+export interface Guard { readonly current: () => boolean; readonly close: () => void }
+const captures = new WeakMap<Guard, readonly Entry[]>()
+const graphs = new WeakMap<object, Guard>()
+
+// Keep the original directory descriptors open to prevent inode reuse from
+// making a replacement appear identical. This proves directory identity only;
+// it does not attest child files, cached Location graphs, or remote resources.
+export function capture(paths: readonly string[]) {
+  const opened: Entry[] = []
+  let closed = false
+  const close = () => {
+    if (closed) return
+    closed = true
+    for (const item of opened) closeSync(item.fd)
+  }
+  try {
+    for (const path of paths) {
+      const fd = openSync(path, "r")
+      // Register before further reads so every error closes the descriptor.
+      const item = { path, real: "", fd, dev: 0n, ino: 0n }
+      opened.push(item)
+      const stat = fstatSync(fd, { bigint: true })
+      if (!stat.isDirectory() || stat.ino === 0n) throw new Error("Directory identity unavailable")
+      item.real = realpathSync.native(path)
+      item.dev = stat.dev
+      item.ino = stat.ino
+    }
+    const current = () => {
+      if (closed) return false
+      try {
+        const valid = opened.every(item => {
+          const handle = fstatSync(item.fd, { bigint: true }), pathname = statSync(item.path, { bigint: true })
+          return handle.isDirectory() && pathname.isDirectory() && handle.dev === item.dev && handle.ino === item.ino &&
+            pathname.dev === item.dev && pathname.ino === item.ino && realpathSync.native(item.path) === item.real
+        })
+        if (!valid) close()
+        return valid
+      } catch { close(); return false }
+    }
+    if (!current()) throw new Error("Directory identity changed during capture")
+    const guard = Object.freeze({ current, close })
+    captures.set(guard, opened)
+    return guard
+  } catch (error) { close(); throw error }
+}
+
+/** Only an actual graph build can register its scope-owned observation. */
+export function bindGraph(context: object, guard: Guard) {
+  if (guard.current()) graphs.set(context, guard)
+}
+
+export function matchesGraph(context: object, guard: Guard, path: string) {
+  const graph = graphs.get(context)
+  if (!graph || !graph.current() || !guard.current()) return false
+  const original = captures.get(graph)?.find(item => item.path === path)
+  const prepared = captures.get(guard)?.find(item => item.path === path)
+  return !!original && !!prepared && original.real === prepared.real && original.dev === prepared.dev && original.ino === prepared.ino
+}
