diff --git a/packages/core/test/git-cleanup-authority.test.ts b/packages/core/test/git-cleanup-authority.test.ts
new file mode 100644
index 0000000..2fc794e
--- /dev/null
+++ b/packages/core/test/git-cleanup-authority.test.ts
@@ -0,0 +1,165 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Global } from "@opencode/util/global"
+import { Git } from "@opencode/core/git"
+import { Snapshot } from "@opencode/core/snapshot"
+import { Location } from "@opencode/core/location"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { location } from "./fixture/location"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+const denied = (method: string, value: string) =>
+  Effect.fail(
+    systemError({
+      _tag: "PermissionDenied",
+      module: "FileSystem",
+      method,
+      pathOrDescriptor: value,
+      description: "fixture cleanup failure",
+    }),
+  )
+
+for (const outcome of [
+  "success",
+  "cleanup failure",
+  "snapshot cleanup failure",
+  "caller interruption",
+  "enumeration failure",
+] as const) {
+  it.live(`raw Git temporary-index ${outcome} preserves independent cleanup evidence`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      yield* Effect.promise(async () => {
+        await Bun.write(path.join(project, "tracked.txt"), "one\n")
+        await initRepo(project)
+      })
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const gate = { armed: false, first: true, enumerations: 0 }
+      const cleanupFiles: string[] = []
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const layer = LayerNode.compile(LayerNode.group([Git.node, Snapshot.node, ReservationAuthority.node]), {
+        replacements: [
+          Global.node.replace(Global.layerWith({ data: tmp.path, config: path.join(tmp.path, "config") })),
+          Location.node.replace(
+            Layer.succeed(
+              Location.Service,
+              location(
+                { directory: AbsolutePath.make(project) },
+                {
+                  vcs: { type: "git", store: AbsolutePath.make(path.join(project, ".git")) },
+                },
+              ),
+            ),
+          ),
+          FSUtil.node.replace(
+            Layer.succeed(FSUtil.Service, {
+              ...fs,
+              rename: (from, to) =>
+                gate.armed &&
+                outcome !== "enumeration failure" &&
+                path.basename(from).startsWith("index.opencode-") &&
+                path.basename(to) === "index"
+                  ? // Leave a real temporary artifact after successful publication so
+                    // cleanup settlement is tested independently of a failed rename.
+                    fs.rename(from, to).pipe(Effect.andThen(fs.copyFile(to, from)))
+                  : fs.rename(from, to),
+              readDirectory: (value, options) => {
+                if (gate.armed && outcome === "enumeration failure" && value === store) {
+                  gate.enumerations++
+                  return denied("readDirectory", value)
+                }
+                return fs.readDirectory(value, options)
+              },
+              remove: (value, options) => {
+                if (
+                  !gate.armed ||
+                  !gate.first ||
+                  outcome === "enumeration failure" ||
+                  !path.basename(value).startsWith("index.opencode-")
+                )
+                  return fs.remove(value, options)
+                gate.first = false
+                return Effect.gen(function* () {
+                  cleanupFiles.push(value)
+                  yield* Deferred.succeed(entered, undefined)
+                  yield* Deferred.await(release)
+                  if (outcome === "cleanup failure" || outcome === "snapshot cleanup failure")
+                    return yield* denied("remove", value)
+                  return yield* fs.remove(value, options)
+                })
+              },
+            }),
+          ),
+        ],
+      })
+      const context = yield* Layer.build(Layer.fresh(layer)).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      const capture: Effect.Effect<string | undefined, Git.OperationError> =
+        outcome === "snapshot cleanup failure"
+          ? Context.get(context, Snapshot.Service).capture()
+          : git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      const cleanupFailed = outcome === "cleanup failure" || outcome === "snapshot cleanup failure"
+      yield* Effect.gen(function* () {
+        expect(yield* refused).toBe(false)
+        gate.armed = true
+        if (outcome === "enumeration failure") {
+          expect(yield* capture).toBeDefined()
+          expect(gate.enumerations).toBe(1)
+        }
+        if (outcome !== "enumeration failure") {
+          const running = yield* capture.pipe(Effect.exit, Effect.forkScoped)
+          yield* Deferred.await(entered)
+          expect(cleanupFiles).toHaveLength(1)
+          expect(yield* fs.isFile(cleanupFiles[0]!)).toBe(true)
+          expect(yield* refused).toBe(true)
+          const cancelling =
+            outcome === "caller interruption" ? yield* Fiber.interrupt(running).pipe(Effect.forkScoped) : undefined
+          yield* Effect.yieldNow
+          if (cancelling) expect(cancelling.pollUnsafe()).toBeUndefined()
+          yield* Deferred.succeed(release, undefined)
+          if (cancelling) {
+            yield* Fiber.join(cancelling)
+            const exit = yield* Fiber.await(running)
+            expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+          }
+          if (!cancelling) {
+            const result = yield* Fiber.join(running)
+            expect(Exit.isSuccess(result) && result.value !== undefined).toBe(true)
+          }
+          expect(yield* fs.isFile(cleanupFiles[0]!)).toBe(cleanupFailed)
+          expect(yield* refused).toBe(cleanupFailed)
+          if (cleanupFailed) yield* fs.remove(cleanupFiles[0]!)
+        }
+        const uncertain = cleanupFailed || outcome === "enumeration failure"
+        expect(yield* refused).toBe(uncertain)
+        gate.armed = false
+        expect(yield* capture).toBeDefined()
+        expect(yield* refused).toBe(uncertain)
+        if (outcome === "enumeration failure") expect(gate.enumerations).toBe(1)
+        yield* Scope.close(owner, Exit.void)
+        expect(yield* refused).toBe(uncertain)
+      }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+    }),
+  )
+}
diff --git a/packages/core/test/git-combined-cleanup-authority.test.ts b/packages/core/test/git-combined-cleanup-authority.test.ts
new file mode 100644
index 0000000..7962e23
--- /dev/null
+++ b/packages/core/test/git-combined-cleanup-authority.test.ts
@@ -0,0 +1,148 @@
+import { expect } from "bun:test"
+import { $ } from "bun"
+import path from "path"
+import { Cause, Context, Effect, Exit, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+
+for (const extension of [undefined, ".idx", ".pack", ".rev", ".bitmap", ".mtimes"] as const) {
+  it.live(`combined Git pack ${extension ?? "successful"} cleanup settles only its own native receipt`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const directory = path.join(store, "objects", "pack")
+      yield* Effect.promise(async () => {
+        await Bun.write(path.join(project, "tracked.txt"), "retained content\n")
+        await initRepo(project)
+      })
+      const gate = { armed: false, first: true }
+      const failed: { file: string; bytes: Uint8Array }[] = []
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  remove: (file, options) => {
+                    if (
+                      !gate.armed ||
+                      !gate.first ||
+                      !extension ||
+                      path.dirname(file) !== directory ||
+                      !file.endsWith(extension)
+                    )
+                      return fs.remove(file, options)
+                    gate.first = false
+                    return Effect.gen(function* () {
+                      // Bitmap/mtime bytes are opaque boundary fixtures, not authentic Git sidecars.
+                      // Install them only after packing, so Git never interprets synthetic bytes.
+                      if (extension === ".bitmap" || extension === ".mtimes")
+                        yield* fs.writeFileString(file, `controlled ${extension} cleanup evidence\n`)
+                      // Index, pack and reverse-index artifacts are generated by actual Git.
+                      failed.push({ file, bytes: yield* fs.readFile(file) })
+                      return yield* Effect.fail(
+                        systemError({
+                          _tag: "PermissionDenied",
+                          module: "FileSystem",
+                          method: "remove",
+                          pathOrDescriptor: file,
+                          description: "controlled combined-pack cleanup fault",
+                        }),
+                      )
+                    })
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      const tree = yield* git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      const ids = yield* Effect.promise(async () => {
+        const ids: string[] = []
+        // Sixteen actual independent packs cross the unchanged pack-count threshold.
+        for (const index of Array.from({ length: 16 }, (_, index) => index)) {
+          const oid = (
+            await $`git --git-dir ${store} hash-object -w --stdin < ${Buffer.from(`blob-${index}\n`)}`.text()
+          ).trim()
+          ids.push(oid)
+          const hash = (
+            await $`git --git-dir ${store} pack-objects -q ${path.join(directory, "pack")} < ${Buffer.from(oid + "\n")}`.text()
+          ).trim()
+          await $`git --git-dir ${store} index-pack --rev-index ${path.join(directory, `pack-${hash}.pack`)}`.quiet()
+        }
+        return ids
+      })
+      expect((yield* fs.readDirectory(directory)).filter((file) => file.endsWith(".pack"))).toHaveLength(16)
+      expect((yield* fs.readDirectory(directory)).filter((file) => file.endsWith(".rev"))).toHaveLength(16)
+      expect(yield* refused).toBe(false)
+      gate.armed = true
+      // The public result remains successful even when its best-effort cleanup failed.
+      yield* git.objects.pack(repository)
+      expect(yield* refused).toBe(extension !== undefined)
+      expect(failed).toHaveLength(extension ? 1 : 0)
+      if (extension) {
+        expect(yield* fs.readFile(failed[0]!.file)).toEqual(failed[0]!.bytes)
+        const files = yield* fs.readDirectory(directory)
+        if (extension !== ".rev")
+          expect(files.filter((file) => file.endsWith(extension))).toHaveLength(
+            extension === ".idx" || extension === ".pack" ? 2 : 1,
+          )
+        if (extension === ".rev") {
+          // Git versions differ on generating a reverse index for the replacement pack.
+          // Every reverse index other than the failed artifact must be paired.
+          expect(
+            files
+              .filter((file) => file.endsWith(".rev") && file !== path.basename(failed[0]!.file))
+              .every(
+                (file) => files.includes(file.slice(0, -4) + ".pack") && files.includes(file.slice(0, -4) + ".idx"),
+              ),
+          ).toBe(true)
+        }
+        expect(files.filter((file) => file.endsWith(extension === ".idx" ? ".pack" : ".idx"))).toHaveLength(1)
+      }
+      // Verify every original packed blob through real Git, not just the tree result.
+      const output = yield* Effect.promise(() =>
+        $`git --git-dir ${store} cat-file --batch-check < ${Buffer.from(ids.join("\n") + "\n")}`.text(),
+      )
+      expect(
+        output
+          .trim()
+          .split("\n")
+          .map((line) => line.split(" ").slice(0, 2).join(" ")),
+      ).toEqual(ids.map((oid) => `${oid} blob`))
+      expect(yield* Effect.promise(() => $`git --git-dir ${store} show ${`${tree}:tracked.txt`}`.text())).toBe(
+        "retained content\n",
+      )
+      gate.armed = false
+      yield* Effect.forEach(failed, (item) => fs.remove(item.file))
+      yield* git.objects.pack(repository)
+      expect(yield* refused).toBe(extension !== undefined)
+      yield* Scope.close(owner, Exit.void)
+      expect(yield* refused).toBe(extension !== undefined)
+    }),
+  )
+}
