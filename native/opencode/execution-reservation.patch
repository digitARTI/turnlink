@@ -0,0 +1,66 @@
+export * as NativeMovementFamilyProtection from "./movement-family-protection.js"
+
+import { getTableName, sql } from "drizzle-orm"
+import { Effect } from "effect"
+import type { Database } from "./database.js"
+import { KVTable } from "../kv/sql.js"
+import { EventSequenceTable, EventTable } from "../event/sql.js"
+import { InstructionEntryTable, InstructionStateTable, SessionInboxTable, SessionMessageTable, SessionPendingTable, SessionTable } from "../session/sql.js"
+
+const intentPrefix = "session-movement-intent:v1:"
+
+/** Persist SQL-only guards so unaware connections also respect descendant quarantine. */
+export const install = Effect.fn("NativeMovementFamilyProtection.install")(function* (db: Database.Interface["db"],
+  options?: { readonly allowMissingTables?: boolean }) {
+  yield* db.transaction(() => Effect.gen(function* () {
+    const tables = new Set((yield* db.all<{ name: string }>(sql`SELECT name FROM sqlite_master WHERE type = 'table'`).pipe(Effect.orDie))
+      .map((row) => row.name))
+    const installed = new Set((yield* db.all<{ name: string }>(sql`SELECT name FROM sqlite_master WHERE type = 'trigger' AND name LIKE '_native_movement_family_v2_%'`).pipe(Effect.orDie))
+      .map((row) => row.name))
+    for (const target of [
+      { table: SessionTable, column: "parent_id", name: "session", mode: "parent" },
+      { table: SessionInboxTable, column: "session_id", name: "inbox", mode: "ancestor" },
+      { table: SessionPendingTable, column: "session_id", name: "pending", mode: "ancestor" },
+      { table: SessionMessageTable, column: "session_id", name: "message", mode: "ancestor" },
+      { table: EventTable, column: "aggregate_id", name: "event", mode: "ancestor" },
+      { table: EventSequenceTable, column: "aggregate_id", name: "sequence", mode: "ancestor" },
+      { table: InstructionEntryTable, column: "session_id", name: "instruction_entry", mode: "self" },
+      { table: InstructionStateTable, column: "session_id", name: "instruction_state", mode: "self" },
+    ]) {
+      if (!tables.has(getTableName(target.table))) {
+        if (options?.allowMissingTables) continue
+        return yield* Effect.die("Native movement family protection table is absent")
+      }
+      for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+        const name = `_native_movement_family_v2_${target.name}_${operation.toLowerCase()}`
+        if (installed.has(name)) continue
+        const references = operation === "INSERT" ? ["NEW"] : operation === "DELETE" ? ["OLD"] : ["OLD", "NEW"]
+        const ancestry = (start: ReturnType<typeof sql>) => sql`EXISTS (
+            WITH RECURSIVE ancestors(id) AS (
+              SELECT ${start}
+              UNION SELECT family.parent_id FROM ${SessionTable} AS family JOIN ancestors ON family.id = ancestors.id
+                WHERE family.parent_id IS NOT NULL
+            )
+            SELECT 1 FROM ancestors JOIN ${KVTable} AS intent ON intent.key = ${intentPrefix} || ancestors.id
+          )`
+        const checks = references.map((reference) => {
+          const value = sql`${sql.identifier(reference)}.${sql.identifier(target.column)}`
+          const start = target.mode === "ancestor" ? sql`(SELECT parent_id FROM ${SessionTable} WHERE id = ${value})` : value
+          return ancestry(start)
+        })
+        // REPLACE can delete a conflicting row without running its DELETE trigger.
+        // Inspect the current owner as well as the proposed row, including the root.
+        const conflict = (check: ReturnType<typeof sql>) => operation === "UPDATE" ? sql`(NEW.id IS NOT OLD.id AND ${check})` : check
+        if (operation !== "DELETE" && target.mode === "parent") checks.push(conflict(ancestry(sql`NEW.id`)))
+        if (operation !== "DELETE" && target.mode === "ancestor" && target.name !== "sequence") {
+          checks.push(conflict(ancestry(sql`(SELECT ${sql.identifier(target.column)} FROM ${target.table} WHERE id = NEW.id)`)))
+        }
+        yield* db.run(sql`
+          CREATE TRIGGER IF NOT EXISTS ${sql.identifier(name)}
+          BEFORE ${sql.raw(operation)} ON ${target.table} WHEN ${sql.join(checks, sql` OR `)}
+          BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_ANCESTOR_QUARANTINED'); END
+        `.inlineParams()).pipe(Effect.orDie)
+      }
+    }
+  })).pipe(Effect.orDie)
+})
diff --git a/packages/core/src/database/movement-permission-revision.ts b/packages/core/src/database/movement-permission-revision.ts
new file mode 100644
index 0000000..c4b78e6
--- /dev/null
+++ b/packages/core/src/database/movement-permission-revision.ts
@@ -0,0 +1,42 @@
+export * as NativeMovementPermissionRevision from "./movement-permission-revision.js"
+
+import { sql } from "drizzle-orm"
+import { Effect } from "effect"
+import type { Database } from "./database.js"
+
+/** A durable, append-only observation of saved-rule writes by any SQLite connection. */
+export const install = Effect.fn("NativeMovementPermissionRevision.install")(function* (
+  db: Database.Interface["db"], options?: { readonly allowMissingTable?: boolean },
+) {
+  yield* db.transaction(() => Effect.gen(function* () {
+    yield* db.run(sql`CREATE TABLE IF NOT EXISTS _native_permission_revision (id INTEGER PRIMARY KEY AUTOINCREMENT)`).pipe(Effect.orDie)
+    for (const operation of ["UPDATE", "DELETE"] as const) yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_permission_revision_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON _native_permission_revision
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_PERMISSION_REVISION_IMMUTABLE'); END
+    `.inlineParams()).pipe(Effect.orDie)
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS _native_permission_revision_insert
+      BEFORE INSERT ON _native_permission_revision
+      WHEN EXISTS (SELECT 1 FROM _native_permission_revision WHERE id = NEW.id)
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_PERMISSION_REVISION_IMMUTABLE'); END
+    `).pipe(Effect.orDie)
+    const table = yield* db.all<{ name: string }>(sql`SELECT name FROM sqlite_master WHERE type='table' AND name='permission'`).pipe(Effect.orDie)
+    if (!table.length) {
+      if (options?.allowMissingTable) return
+      return yield* Effect.die("Saved permission table is absent")
+    }
+    for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_permission_observe_${operation.toLowerCase()}`)}
+      AFTER ${sql.raw(operation)} ON permission
+      BEGIN INSERT INTO _native_permission_revision (id) VALUES (NULL); END
+    `.inlineParams()).pipe(Effect.orDie)
+  })).pipe(Effect.orDie)
+})
+
+/** Decimal text preserves all SQLite integer values without JavaScript precision loss. */
+export const current = Effect.fn("NativeMovementPermissionRevision.current")(function* (db: Database.Interface["db"]) {
+  const rows = yield* db.all<{ value: string }>(sql`SELECT CAST(COALESCE(MAX(id), 0) AS TEXT) AS value FROM _native_permission_revision`).pipe(Effect.orDie)
+  if (!rows[0] || !/^(0|[1-9][0-9]*)$/.test(rows[0].value)) return yield* Effect.die("Saved permission revision is invalid")
+  return rows[0].value
+})
diff --git a/packages/core/src/database/movement-protection.ts b/packages/core/src/database/movement-protection.ts
new file mode 100644
index 0000000..01c9023
--- /dev/null
+++ b/packages/core/src/database/movement-protection.ts
@@ -0,0 +1,421 @@
+export * as NativeMovementProtection from "./movement-protection.js"
+
+import { eq, like, sql } from "drizzle-orm"
+import { createHash, randomUUID } from "node:crypto"
+import { Effect, Option, Schema } from "effect"
+import type { Database } from "./database.js"
+import { NativeMovementConnection } from "./movement-connection.js"
+import { NativeMovementFamilyProtection } from "./movement-family-protection.js"
+import { NativeMovementPermissionRevision } from "./movement-permission-revision.js"
+import { KVTable } from "../kv/sql.js"
+import * as Location from "@opencode/schema/location"
+import { AbsolutePath } from "../schema.js"
+import { EventSequenceTable, EventTable } from "../event/sql.js"
+import { SessionSchema } from "../session/schema.js"
+import { SessionInboxTable, SessionMessageTable, SessionPendingTable, SessionTable } from "../session/sql.js"
+import { pluginStorageNamespace } from "../plugin/storage-namespace.js"
+import { SessionMembershipSeal } from "../session/membership-seal.js"
+import { SessionMembershipArchive } from "../session/membership-archive.js"
+
+type DB = Database.Interface["db"]
+const protocolKey = "native-movement-storage-protocol"
+const prefix = "native-movement-protection:v1:"
+export const modelWebSocketPrefix = "native-model-websocket-acquisition:v1:"
+const Protocol = Schema.Struct({ version: Schema.Literals([1, 2, 3, 4, 5, 6]) })
+const Protection = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, binding: Schema.String, location: Location.Ref,
+  generation: Schema.Int.check(Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(Number.MAX_SAFE_INTEGER)),
+  nonce: Schema.String,
+})
+const binding = (input: Pick<typeof Protection.Type, "location" | "generation" | "nonce">) => JSON.stringify({
+  location: Schema.encodeSync(Location.Ref)(input.location), generation: input.generation, nonce: input.nonce,
+})
+
+/** Version 6 requires the protected native transport-release record. Upgrades are atomic. */
+export const ensureFamilyProtocol = Effect.fn("NativeMovementProtection.ensureFamilyProtocol")(function* (db: DB,
+  options?: { readonly allowMissingTables?: boolean }) {
+  yield* db.transaction(() => Effect.gen(function* () {
+    yield* NativeMovementFamilyProtection.install(db, options)
+    yield* NativeMovementPermissionRevision.install(db, { allowMissingTable: options?.allowMissingTables })
+    const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, protocolKey)).get().pipe(Effect.orDie)
+    if (!row) {
+      yield* db.insert(KVTable).values({ key: protocolKey, value: { version: 6 } }).run().pipe(Effect.orDie)
+    } else {
+      if (!Schema.is(Protocol)(row.value)) return yield* Effect.die("Invalid native movement storage protocol")
+      if (row.value.version < 6) {
+        yield* db.run(sql`DROP TRIGGER IF EXISTS _native_movement_protocol_v2_update`).pipe(Effect.orDie)
+        yield* db.run(sql`DROP TRIGGER IF EXISTS _native_movement_protocol_v3_update`).pipe(Effect.orDie)
+        yield* db.run(sql`DROP TRIGGER IF EXISTS _native_movement_protocol_v4_update`).pipe(Effect.orDie)
+        yield* db.run(sql`DROP TRIGGER IF EXISTS _native_movement_protocol_v5_update`).pipe(Effect.orDie)
+        yield* db.update(KVTable).set({ value: { version: 6 } }).where(eq(KVTable.key, protocolKey)).run().pipe(Effect.orDie)
+      }
+    }
+    for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+      const condition = operation === "INSERT" ? sql`NEW.key = ${protocolKey} AND EXISTS (SELECT 1 FROM ${KVTable} WHERE key = ${protocolKey})` :
+        operation === "UPDATE" ? sql`OLD.key = ${protocolKey} OR NEW.key = ${protocolKey}` : sql`OLD.key = ${protocolKey}`
+      yield* db.run(sql`
+        CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_movement_protocol_v6_${operation.toLowerCase()}`)}
+        BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+        BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_PROTOCOL_REFUSED'); END
+      `.inlineParams()).pipe(Effect.orDie)
+    }
+    // SQLite REPLACE can remove an existing row without firing its DELETE
+    // trigger. Protect the binding itself, including a rename onto its key.
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS _native_connection_v2_protection_insert
+      BEFORE INSERT ON ${KVTable} WHEN NEW.key LIKE ${prefix + "%"}
+        AND EXISTS (SELECT 1 FROM ${KVTable} AS existing WHERE existing.key = NEW.key)
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `.inlineParams()).pipe(Effect.orDie)
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS _native_connection_v2_protection_update
+      BEFORE UPDATE ON ${KVTable} WHEN NEW.key LIKE ${prefix + "%"} AND NEW.key IS NOT OLD.key
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `.inlineParams()).pipe(Effect.orDie)
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS _native_connection_v3_protection_insert
+      BEFORE INSERT ON ${KVTable} WHEN NEW.key LIKE ${prefix + "%"} AND (
+        NEW.key IS NOT (${prefix} || json_extract(NEW.value, '$.sessionID')) OR
+        NOT COALESCE(${sql.raw(NativeMovementConnection.functionName)}(
+          json_extract(NEW.value, '$.sessionID'), json_extract(NEW.value, '$.binding')), 0))
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `.inlineParams()).pipe(Effect.orDie)
+  })).pipe(Effect.orDie)
+})
+
+/** Rebind the protected placement only inside the durable movement transaction. */
+export const rebindPlacement = Effect.fn("NativeMovementProtection.rebindPlacement")(function* (
+  db: DB, movement: NativeMovementConnection.Interface, sessionID: SessionSchema.ID, source: Location.Ref, destination: Location.Ref,
+) {
+  if (Option.isNone(yield* Effect.serviceOption(db.$client.transactionService)))
+    return yield* new NativeMovementConnection.OwnerRefused({ message: "Native placement requires an active database transaction" })
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  if (!row) return yield* new NativeMovementConnection.OwnerRefused({ message: "Native placement protection is absent" })
+  const previous = yield* Schema.decodeUnknownEffect(Protection)(row.value).pipe(Effect.orDie)
+  if (previous.sessionID !== sessionID || previous.binding !== binding(previous) ||
+    previous.location.directory !== source.directory || previous.location.workspaceID !== source.workspaceID ||
+    previous.generation >= Number.MAX_SAFE_INTEGER || !movement.owns(sessionID, previous.binding))
+    return yield* new NativeMovementConnection.OwnerRefused({ message: "Native placement protection changed" })
+  const fields = { location: destination, generation: previous.generation + 1, nonce: randomUUID() }
+  const next = Protection.make({ version: 1, sessionID, ...fields, binding: binding(fields) })
+  yield* db.update(KVTable).set({ value: Schema.encodeSync(Protection)(next) }).where(eq(KVTable.key, prefix + sessionID)).run().pipe(Effect.orDie)
+  yield* movement.authorize(sessionID, next.binding)
+  return { previous, next }
+})
+
+/** Restore the connection binding from the committed row after success or rollback. */
+export const refreshPlacement = Effect.fn("NativeMovementProtection.refreshPlacement")(function* (
+  db: DB, movement: NativeMovementConnection.Interface, sessionID: SessionSchema.ID,
+) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  if (!row) return yield* new NativeMovementConnection.OwnerRefused({ message: "Native placement protection is absent" })
+  const current = yield* Schema.decodeUnknownEffect(Protection)(row.value).pipe(Effect.orDie)
+  const session = yield* db.select().from(SessionTable).where(eq(SessionTable.id, sessionID)).get().pipe(Effect.orDie)
+  if (!session || current.sessionID !== sessionID || current.binding !== binding(current) ||
+    current.location.directory !== session.directory || current.location.workspaceID !== (session.workspace_id ?? undefined))
+    return yield* new NativeMovementConnection.OwnerRefused({ message: "Native placement protection does not match the Session" })
+  yield* movement.authorize(sessionID, current.binding)
+})
+
+/** Receipt observation requires an existing, canonical protection for this exact location. */
+export const assertProtectedPlacement = Effect.fn("NativeMovementProtection.assertProtectedPlacement")(function* (
+  db: DB, sessionID: SessionSchema.ID, location: Location.Ref,
+) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID)).get().pipe(Effect.orDie)
+  if (!row) return yield* Effect.die("Native placement protection is absent")
+  const current = yield* Schema.decodeUnknownEffect(Protection)(row.value).pipe(Effect.orDie)
+  if (current.sessionID !== sessionID || current.binding !== binding(current) ||
+    current.location.directory !== location.directory || current.location.workspaceID !== location.workspaceID)
+    return yield* Effect.die("Native placement protection does not match the destination")
+  yield* assertAuthorized(db, sessionID)
+})
+
+/** Admission/execution must retain native connection ownership even after quarantine is cleared. */
+export const assertAuthorized = Effect.fn("NativeMovementProtection.assertAuthorized")(function* (
+  db: DB, sessionID: SessionSchema.ID,
+) {
+  const row = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, prefix + sessionID))
+    .get().pipe(Effect.orDie)
+  if (!row) return
+  const protection = yield* Schema.decodeUnknownEffect(Protection)(row.value).pipe(Effect.orDie)
+  const observed = yield* db.all<{ authorized: number }>(sql`
+    SELECT ${sql.raw(NativeMovementConnection.functionName)}(${sessionID}, ${protection.binding}) AS authorized
+  `).pipe(Effect.orDie)
+  if (observed[0]?.authorized !== 1)
+    return yield* Effect.die(new NativeMovementConnection.OwnerRefused({ message: "Native execution connection ownership is absent" }))
+})
+
+/** Run before migrations or admission; an unsupported storage protocol never opens as ordinary storage. */
+export const bootstrap = Effect.fn("NativeMovementProtection.bootstrap")(function* (
+  db: DB, movement: NativeMovementConnection.Interface | undefined,
+) {
+  const tables = yield* db.all<{ name: string }>(sql`SELECT name FROM sqlite_master WHERE type='table' AND name='kv'`)
+  if (tables.length === 0) return
+  const protocol = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, protocolKey)).get()
+  const rows = yield* db.select({ value: KVTable.value }).from(KVTable).where(like(KVTable.key, prefix + "%")).all()
+  const sockets = yield* db.select({ key: KVTable.key }).from(KVTable).where(like(KVTable.key, modelWebSocketPrefix + "%")).all()
+  if (!protocol && rows.length === 0 && sockets.length === 0) return
+  if (!protocol || !Schema.is(Protocol)(protocol.value) || !movement)
+    return yield* new NativeMovementConnection.OwnerRefused({ message: "Native movement storage requires its compatible owner runtime" })
+  yield* ensureFamilyProtocol(db, { allowMissingTables: true })
+  yield* movement.retainUntilExit
+  if (protocol.value.version >= 2) {
+    yield* protectMembershipSealReplacement(db)
+    yield* protectMembershipArchive(db)
+  }
+  for (const row of rows) {
+    const protection = yield* Schema.decodeUnknownEffect(Protection)(row.value).pipe(Effect.orDie)
+    const session = yield* db.select().from(SessionTable).where(eq(SessionTable.id, protection.sessionID)).get()
+    if (!session || session.directory !== protection.location.directory ||
+      (session.workspace_id ?? undefined) !== protection.location.workspaceID || protection.binding !== binding(protection))
+      return yield* new NativeMovementConnection.OwnerRefused({ message: "Protected Session placement cannot be rebound" })
+    yield* movement.authorize(protection.sessionID, protection.binding)
+  }
+})
+
+/** Establish the compatible storage marker and guard native WebSocket records. */
+export const enableModelWebSocketJournal = Effect.fn("NativeMovementProtection.enableModelWebSocketJournal")(function* (db: DB) {
+  yield* ensureFamilyProtocol(db)
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const references = operation === "INSERT" ? ["NEW"] : operation === "DELETE" ? ["OLD"] : ["OLD", "NEW"]
+    const condition = sql.join(references.map((reference) => sql`
+      (${sql.identifier(reference)}.key LIKE ${modelWebSocketPrefix + "%"} AND (
+        ${sql.identifier(reference)}.key != ${modelWebSocketPrefix} || json_extract(${sql.identifier(reference)}.value, '$.sessionID') || ':' || json_extract(${sql.identifier(reference)}.value, '$.id')
+        OR NOT ${sql.raw(NativeMovementConnection.functionName)}(
+          'model-websocket:' || json_extract(${sql.identifier(reference)}.value, '$.sessionID'),
+          json_extract(${sql.identifier(reference)}.value, '$.binding'))))
+    `.inlineParams()), sql` OR `)
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_model_websocket_v1_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `).pipe(Effect.orDie)
+  }
+})
+
+/** Guard the actual plugin membership key on every compatible SQLite connection. */
+export const protectPluginMembership = Effect.fn("NativeMovementProtection.protectPluginMembership")(function* (
+  db: DB, pluginID: string,
+) {
+  const protocol = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, protocolKey))
+    .get().pipe(Effect.orDie)
+  if (!protocol || !Schema.is(Protocol)(protocol.value)) return yield* Effect.die("Invalid native movement storage protocol")
+  yield* ensureFamilyProtocol(db)
+  const membershipPrefix = `${pluginStorageNamespace(pluginID)}memberships/`
+  const identity = createHash("sha256").update(pluginStorageNamespace(pluginID)).digest("hex")
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const references = operation === "INSERT" ? ["NEW"] : operation === "DELETE" ? ["OLD"] : ["OLD", "NEW"]
+    const condition = sql.join(references.map((reference) => sql`
+      (substr(${sql.identifier(reference)}.key, 1, ${membershipPrefix.length}) = ${membershipPrefix} AND (
+        EXISTS (SELECT 1 FROM ${KVTable} AS sealed
+          WHERE sealed.key = ${SessionMembershipSeal.prefix} || substr(${sql.identifier(reference)}.key, ${membershipPrefix.length + 1})
+          AND json_extract(sealed.value, '$.namespace') = ${pluginStorageNamespace(pluginID)}) OR
+        EXISTS (SELECT 1 FROM ${KVTable} AS protected
+          WHERE protected.key = ${prefix} || substr(${sql.identifier(reference)}.key, ${membershipPrefix.length + 1})
+          AND NOT ${sql.raw(NativeMovementConnection.functionName)}(
+            substr(${sql.identifier(reference)}.key, ${membershipPrefix.length + 1}), json_extract(protected.value, '$.binding')))))
+    `.inlineParams()), sql` OR `)
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_membership_v1_${identity}_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `).pipe(Effect.orDie)
+  }
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const condition = operation === "INSERT" ? sql`
+      NEW.key LIKE ${SessionMembershipSeal.prefix + "%"} AND (NEW.key IS NOT (${SessionMembershipSeal.prefix} || json_extract(NEW.value, '$.sessionID')) OR NOT EXISTS (
+        SELECT 1 FROM ${KVTable} AS protected WHERE protected.key = ${prefix} || substr(NEW.key, ${SessionMembershipSeal.prefix.length + 1})
+          AND ${sql.raw(NativeMovementConnection.functionName)}(
+            substr(NEW.key, ${SessionMembershipSeal.prefix.length + 1}), json_extract(protected.value, '$.binding'))))
+    `.inlineParams() : operation === "UPDATE" ? sql`
+      (OLD.key LIKE ${SessionMembershipSeal.prefix + "%"} AND NOT ${sql.raw(NativeMovementConnection.functionName)}(
+        'membership-seal:' || json_extract(OLD.value, '$.sessionID'), json_extract(OLD.value, '$.binding'))) OR
+      (NEW.key LIKE ${SessionMembershipSeal.prefix + "%"} AND NEW.key != OLD.key)
+    `.inlineParams() : sql`
+      OLD.key LIKE ${SessionMembershipSeal.prefix + "%"} AND NOT ${sql.raw(NativeMovementConnection.functionName)}(
+        'membership-seal:' || json_extract(OLD.value, '$.sessionID'), json_extract(OLD.value, '$.binding'))
+    `.inlineParams()
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_membership_seal_v1_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+    `).pipe(Effect.orDie)
+  }
+  yield* protectMembershipSealReplacement(db)
+})
+
+// SQLite REPLACE can bypass DELETE triggers when recursive triggers are off.
+const protectMembershipSealReplacement = Effect.fn("NativeMovementProtection.protectMembershipSealReplacement")(function* (db: DB) {
+  yield* db.run(sql`
+    CREATE TRIGGER IF NOT EXISTS _native_membership_seal_v2_insert
+    BEFORE INSERT ON ${KVTable} WHEN NEW.key LIKE ${SessionMembershipSeal.prefix + "%"}
+      AND EXISTS (SELECT 1 FROM ${KVTable} AS existing WHERE existing.key = NEW.key)
+    BEGIN SELECT RAISE(ABORT, 'NATIVE_MOVEMENT_CONNECTION_REFUSED'); END
+  `.inlineParams()).pipe(Effect.orDie)
+})
+
+/** Insert-only archive: the guarded native connection may preserve a source
+ * membership, but ordinary compatible writers cannot rewrite or erase it. */
+export const protectMembershipArchive = Effect.fn("NativeMovementProtection.protectMembershipArchive")(function* (db: DB) {
+  for (const [name, recordPrefix] of [
+    ["archive", SessionMembershipArchive.scopedPrefix], ["destination", SessionMembershipArchive.scopedDestinationPrefix],
+  ] as const) {
+    for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+      const condition = operation === "INSERT" ? sql`
+        NEW.key LIKE ${recordPrefix + "%"} AND (NEW.key IS NOT (${recordPrefix} || lower(hex(json_extract(NEW.value, '$.sessionID'))) || ':' ||
+          lower(hex(json_extract(NEW.value, '$.transitionID')))) OR EXISTS (SELECT 1 FROM ${KVTable} AS existing WHERE existing.key = NEW.key)
+          OR NOT EXISTS (SELECT 1 FROM ${KVTable} AS protected WHERE protected.key = ${prefix} || json_extract(NEW.value, '$.sessionID')
+            AND ${sql.raw(NativeMovementConnection.functionName)}(json_extract(NEW.value, '$.sessionID'), json_extract(protected.value, '$.binding')))
+          OR NOT EXISTS (SELECT 1 FROM ${KVTable} AS intent WHERE intent.key = 'session-movement-intent:v1:' || json_extract(NEW.value, '$.sessionID')
+            AND json_extract(intent.value, '$.transitionID') = json_extract(NEW.value, '$.transitionID')))
+      ` : operation === "UPDATE" ? sql`OLD.key LIKE ${recordPrefix + "%"} OR NEW.key LIKE ${recordPrefix + "%"}` : sql`OLD.key LIKE ${recordPrefix + "%"}`
+      yield* db.run(sql`
+        CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_membership_${name}_scoped_v1_${operation.toLowerCase()}`)}
+        BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+        BEGIN SELECT RAISE(ABORT, 'NATIVE_MEMBERSHIP_ARCHIVE_REFUSED'); END
+      `.inlineParams()).pipe(Effect.orDie)
+    }
+  }
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const condition = operation === "INSERT" ? sql`
+      NEW.key LIKE ${SessionMembershipArchive.prefix + "%"} AND (NEW.key IS NOT (${SessionMembershipArchive.prefix} || json_extract(NEW.value, '$.sessionID')) OR NOT EXISTS (
+        SELECT 1 FROM ${KVTable} AS protected WHERE protected.key = ${prefix} || substr(NEW.key, ${SessionMembershipArchive.prefix.length + 1})
+          AND ${sql.raw(NativeMovementConnection.functionName)}(
+            substr(NEW.key, ${SessionMembershipArchive.prefix.length + 1}), json_extract(protected.value, '$.binding'))))
+    `.inlineParams() : operation === "UPDATE" ? sql`
+      OLD.key LIKE ${SessionMembershipArchive.prefix + "%"} OR NEW.key LIKE ${SessionMembershipArchive.prefix + "%"}
+    `.inlineParams() : sql`OLD.key LIKE ${SessionMembershipArchive.prefix + "%"}`.inlineParams()
+    yield* db.run(sql`
+      CREATE TRIGGER IF NOT EXISTS ${sql.identifier(`_native_membership_archive_v1_${operation.toLowerCase()}`)}
+      BEFORE ${sql.raw(operation)} ON ${KVTable} WHEN ${condition}
+      BEGIN SELECT RAISE(ABORT, 'NATIVE_MEMBERSHIP_ARCHIVE_REFUSED'); END
+    `).pipe(Effect.orDie)
+  }
+  for (const operation of ["INSERT", "UPDATE", "DELETE"] as const) {
+    const condition = operation === "INSERT" ? sql`
+      NEW.key LIKE ${SessionMembershipArchive.destinationPrefix + "%"} AND (NEW.key IS NOT (${SessionMembershipArchive.destinationPrefix} || json_extract(NEW.value, '$.sessionID')) OR NOT EXISTS (
