+++ b/packages/core/test/git-directory-boundary.test.ts
@@ -0,0 +1,173 @@
+import { expect } from "bun:test"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, FileSystem, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { filesystem } from "@opencode/util/effect/app-node-platform"
+import { FSUtil } from "@opencode/util/fs-util"
+import { FileSystemBoundary } from "@opencode/util/filesystem-boundary"
+import { AppProcess } from "@opencode/util/process"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([filesystem, AppProcess.node])))
+const alreadyExists = (file: string) =>
+  Effect.fail(
+    systemError({
+      _tag: "AlreadyExists",
+      module: "FileSystem",
+      method: "makeDirectory",
+      pathOrDescriptor: file,
+      description: "controlled recursive-mkdir EEXIST callback",
+    }),
+  )
+
+for (const mode of ["unobserved", "live", "revoked", "initial refusal"] as const) {
+  it.live(`ensureDir ${mode} preserves the EEXIST workaround without late fallback stat`, () =>
+    Effect.gen(function* () {
+      const native = yield* FileSystem.FileSystem
+      const tmp = yield* tmpdirScoped()
+      const target = path.join(tmp.path, "directory")
+      const entered = yield* Deferred.make<void>()
+      const resume = yield* Deferred.make<void>()
+      const state = { allowed: mode !== "initial refusal", mkdir: 0, stat: 0 }
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(FSUtil.node, {
+            replacements: [
+              filesystem.replace(
+                Layer.succeed(FileSystem.FileSystem, {
+                  ...native,
+                  makeDirectory: (file, options) =>
+                    Effect.gen(function* () {
+                      state.mkdir++
+                      if (mode === "initial refusal") return yield* Effect.interrupt
+                      yield* native.makeDirectory(file, options)
+                      yield* Deferred.succeed(entered, undefined)
+                      yield* Deferred.await(resume)
+                      return yield* alreadyExists(file)
+                    }),
+                  stat: (file) => {
+                    state.stat++
+                    return native.stat(file)
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      )
+      const fs = Context.get(context, FSUtil.Service)
+      const operation = fs.ensureDir(target)
+      const guarded =
+        mode === "unobserved"
+          ? operation
+          : operation.pipe(
+              Effect.provideService(FileSystemBoundary, {
+                check: Effect.suspend(() => (state.allowed ? Effect.void : Effect.interrupt)),
+              }),
+            )
+      yield* Effect.gen(function* () {
+        const running = yield* guarded.pipe(Effect.exit, Effect.forkScoped)
+        if (mode !== "initial refusal") {
+          yield* Deferred.await(entered)
+          expect(state.mkdir).toBe(1)
+          expect(state.stat).toBe(0)
+          state.allowed = mode === "live"
+          yield* Deferred.succeed(resume, undefined)
+        }
+        const result = yield* Fiber.join(running)
+        const refused = mode === "revoked" || mode === "initial refusal"
+        expect(Exit.isSuccess(result)).toBe(!refused)
+        expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(refused)
+        expect(state.mkdir).toBe(mode === "initial refusal" ? 0 : 1)
+        expect(state.stat).toBe(refused ? 0 : 1)
+        expect(yield* native.exists(target)).toBe(mode !== "initial refusal")
+      }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+    }),
+  )
+}
+
+for (const close of [false, true]) {
+  it.live(
+    `Git mkdir fallback ${close ? "refuses owner-closed metadata and still cleans its temporary directory" : "allows the live-owner workaround"}`,
+    () =>
+      Effect.gen(function* () {
+        const native = yield* FileSystem.FileSystem
+        const backend = yield* AppProcess.Service
+        const tmp = yield* tmpdirScoped()
+        const project = AbsolutePath.make(path.join(tmp.path, "project"))
+        const store = AbsolutePath.make(path.join(tmp.path, "store"))
+        yield* Effect.promise(() => initRepo(project))
+        const entered = yield* Deferred.make<void>()
+        const resume = yield* Deferred.make<void>()
+        const state = { armed: false, temporary: "", stats: 0, commands: 0 }
+        const owner = yield* Scope.make()
+        yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+        const context = yield* Layer.build(
+          Layer.fresh(
+            LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+              replacements: [
+                filesystem.replace(
+                  Layer.succeed(FileSystem.FileSystem, {
+                    ...native,
+                    makeDirectory: (file, options) => {
+                      if (!state.armed || state.temporary || !file.startsWith(`${store}.init-`))
+                        return native.makeDirectory(file, options)
+                      return Effect.gen(function* () {
+                        state.temporary = file
+                        yield* native.makeDirectory(file, options)
+                        yield* Deferred.succeed(entered, undefined)
+                        yield* Deferred.await(resume)
+                        return yield* alreadyExists(file)
+                      })
+                    },
+                    stat: (file) => {
+                      if (state.armed && file === state.temporary) state.stats++
+                      return native.stat(file)
+                    },
+                  }),
+                ),
+                AppProcess.node.replace(
+                  Layer.succeed(AppProcess.Service, {
+                    ...backend,
+                    run: (command, options) => {
+                      if (state.armed) state.commands++
+                      return backend.run(command, options)
+                    },
+                  }),
+                ),
+              ],
+            }),
+          ),
+        ).pipe(Scope.provide(owner))
+        const git = Context.get(context, Git.Service)
+        const authority = Context.get(context, ReservationAuthority.Service)
+        const source = yield* git.repo.discover(project)
+        if (!source) return yield* Effect.die("fixture project is not a repository")
+        yield* Effect.gen(function* () {
+          state.armed = true
+          const running = yield* git.repo
+            .create({ worktree: project, gitDirectory: store, seed: source })
+            .pipe(Effect.exit, Effect.forkScoped)
+          yield* Deferred.await(entered)
+          expect(yield* native.exists(state.temporary)).toBe(true)
+          if (close) yield* Scope.close(owner, Exit.void)
+          yield* Deferred.succeed(resume, undefined)
+          const result = yield* Fiber.join(running)
+          expect(Exit.isSuccess(result)).toBe(!close)
+          expect(Exit.isFailure(result) && Cause.hasInterruptsOnly(result.cause)).toBe(close)
+          expect(state.stats).toBe(close ? 0 : 1)
+          expect(state.commands).toBe(close ? 0 : 1)
+          expect(yield* native.exists(state.temporary)).toBe(false)
+          expect(yield* native.exists(path.join(store, "HEAD"))).toBe(!close)
+          const stable = yield* authority.withStable(Effect.void).pipe(Effect.exit)
+          expect(Exit.isFailure(stable) && Cause.hasInterruptsOnly(stable.cause)).toBe(close)
+        }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+      }),
+  )
+}
