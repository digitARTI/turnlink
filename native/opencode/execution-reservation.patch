+import { ensurePluginRuntime } from "@opencode/plugin/runtime"
+import { NodeRuntime } from "@effect/platform-node"
+import { Schema } from "effect"
+import { ServerProcess } from "./server-process"
+
+const Config = Schema.Struct({
+  fd: Schema.Int.check(Schema.isGreaterThanOrEqualTo(3)),
+  pluginID: Schema.String,
+  sessionID: Schema.String,
+  directory: Schema.String,
+  workspaceID: Schema.optional(Schema.String),
+})
+
+ensurePluginRuntime()
+const input = Schema.decodeUnknownSync(Schema.fromJsonString(Config))(process.argv[2])
+ServerProcess.run({ mode: "stdio", hostname: "127.0.0.1", port: 0, nativeMovementControl: input })
+  .pipe(NodeRuntime.runMain({ disableErrorReporting: true }))
