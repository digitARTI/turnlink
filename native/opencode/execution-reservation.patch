+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { Workspace } from "@opencode/core/workspace"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { it } from "./lib/effect"
+import { makeWorkspaceJournalIPC, WorkspaceJournalReport } from "./fixture/workspace-journal-report"
+
+const child = (root: string, mode: string, id: Workspace.ID) =>
+  Effect.acquireUseRelease(
+    Effect.sync(() => {
+      const transport = makeWorkspaceJournalIPC({ id, mode })
+      const subprocess = Bun.spawn(
+        [process.execPath, "run", `${import.meta.dir}/fixture/workspace-journal.ts`, root, mode, id],
+        {
+          stdout: "pipe",
+          stderr: "pipe",
+          ipc: (message, subprocess) => {
+            const ack = transport.receive(message)
+            if (ack) subprocess.send(ack)
+            if (transport.failed) subprocess.kill()
+          },
+        },
+      )
+      return { subprocess, transport }
+    }),
+    (worker) =>
+      Effect.promise(async () => {
+        const [code, stdout, stderr] = await Promise.all([
+          worker.subprocess.exited,
+          new Response(worker.subprocess.stdout).text(),
+          new Response(worker.subprocess.stderr).text(),
+        ])
+        worker.transport.exited(code)
+        return { code, stdout, stderr, report: worker.transport.report }
+      }),
+    (worker) =>
+      Effect.promise(async () => {
+        if (worker.subprocess.exitCode !== null) return
+        worker.subprocess.kill()
+        await worker.subprocess.exited
+      }),
+  )
+const paused = Effect.fnUntraced(function* (root: string, mode: string, id: Workspace.ID) {
+  const worker = yield* Effect.acquireRelease(
+    Effect.sync(() => {
+      const transport = makeWorkspaceJournalIPC({ id, mode, paused: true })
+      const subprocess = Bun.spawn(
+        [process.execPath, "run", `${import.meta.dir}/fixture/workspace-journal.ts`, root, mode, id],
+        {
+          stdin: "pipe",
+          stdout: "pipe",
+          stderr: "pipe",
+          ipc: (message, subprocess) => {
+            const ack = transport.receive(message)
+            if (ack) subprocess.send(ack)
+            if (transport.failed) subprocess.kill()
+          },
+        },
+      )
+      void subprocess.exited.then((code) => transport.exited(code))
+      const output = Promise.all([
+        subprocess.exited,
+        new Response(subprocess.stdout).text(),
+        new Response(subprocess.stderr).text(),
+      ]).then(([code, stdout, stderr]) => [code, { stdout, report: transport.report }, stderr] as const)
+      return { subprocess, ready: transport.ready, output }
+    }),
+    (worker) =>
+      Effect.promise(async () => {
+        if (worker.subprocess.exitCode !== null) return
+        worker.subprocess.kill()
+        await worker.subprocess.exited
+      }),
+  )
+  yield* Effect.promise(() => worker.ready)
+  return worker
+})
+
+const report = (output: { report: () => typeof WorkspaceJournalReport.Type }) => output.report()
+
+const crashes = {
+  create: { mode: "crash", code: 73 },
+  destroy: { mode: "destroy-crash", code: 74 },
+  idle: { mode: "idle-crash", code: 75 },
+  connect: { mode: "connect-crash", code: 76 },
+}
+it.live("Workspace journal evidence uses acknowledged IPC despite noisy or healthy-looking stdout", () =>
+  Effect.gen(function* () {
+    const tmp = yield* tmpdirScoped()
+    const id = Workspace.ID.create()
+    const crashed = yield* child(tmp.path, "crash", id)
+    expect(crashed.stderr).toBe("")
+    expect(crashed.code).toBe(73)
+    const observed = yield* child(tmp.path, "noisy-inspect", id)
+    expect(observed.stderr).toBe("")
+    expect(observed.code).toBe(0)
+    expect(observed.stdout).toContain("fixture log before report")
+    expect(observed.stdout).toContain("fixture log after report")
+    expect(observed.stdout).toContain('"blockedAfter":false')
+    expect(report(observed)).toMatchObject({ blockedBefore: true, blockedAfter: true, intents: 1, resource: true })
+  }),
+)
+for (const phase of ["stale-connect", "stale-idle"] as const) {
+  for (const mutation of ["delete-row", "reassign-row"] as const) {
+    it.live(`${phase} preserves intent and refuses cached reuse after ${mutation}`, () =>
+      Effect.gen(function* () {
+        const tmp = yield* tmpdirScoped()
+        const id = Workspace.ID.create()
+        const initialized = yield* child(tmp.path, "inspect", id)
+        expect(initialized.stderr).toBe("")
+        expect(initialized.code).toBe(0)
+        const worker = yield* paused(tmp.path, phase, id)
+        const changed = yield* child(tmp.path, mutation, id)
+        expect(changed.stderr).toBe("")
+        expect(changed.code).toBe(0)
+        yield* Effect.promise(async () => {
+          await worker.subprocess.stdin.end()
+        })
+        const [code, output, errors] = yield* Effect.promise(() => worker.output)
+        expect(errors).toBe("")
+        expect(code).toBe(0)
+        expect(report(output)).toMatchObject({
+          failed: true,
+          blockedAfter: true,
+          intents: 1,
+          readmissionRefused: true,
+          hasRow: mutation !== "delete-row",
+          resource: true,
+          connectCalls: 1,
+          idleCalls: phase === "stale-idle" ? 1 : 0,
+        })
+        const observed = yield* child(tmp.path, "inspect", id)
+        expect(observed.stderr).toBe("")
+        expect(observed.code).toBe(0)
+        expect(report(observed)).toMatchObject({
+          blockedAfter: true,
+          intents: 1,
+          hasRow: mutation !== "delete-row",
+        })
+      }),
+    )
+  }
+}
+for (const phase of ["stale-create", "stale-destroy"] as const) {
+  for (const mutation of ["delete-row", "reassign-row"] as const) {
+    it.live(`${phase} preserves intent when ${mutation} overtakes its callback`, () =>
+      Effect.gen(function* () {
+        const tmp = yield* tmpdirScoped()
+        const id = Workspace.ID.create()
+        const initialized = yield* child(tmp.path, "inspect", id)
+        expect(initialized.stderr).toBe("")
+        expect(initialized.code).toBe(0)
+        if (phase === "stale-destroy") {
+          const prepared = yield* child(tmp.path, "prepare", id)
+          expect(prepared.stderr).toBe("")
+          expect(prepared.code).toBe(0)
+        }
+        const worker = yield* paused(tmp.path, phase, id)
+        const changed = yield* child(tmp.path, mutation, id)
+        expect(changed.stderr).toBe("")
+        expect(changed.code).toBe(0)
+        yield* Effect.promise(async () => {
+          await worker.subprocess.stdin.end()
+        })
+        const [code, output, errors] = yield* Effect.promise(() => worker.output)
+        expect(errors).toBe("")
+        expect(code).toBe(0)
+        expect(report(output)).toMatchObject({
+          failed: true,
+          blockedAfter: true,
+          intents: 1,
+          replayRefused: true,
+          hasRow: mutation !== "delete-row",
