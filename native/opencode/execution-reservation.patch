+                Effect.gen(function* () {
+                  yield* owned(request.sessionID)
+                  yield* execution.assertNoMovementBackground!(request.sessionID)
+                  yield* NativeMovementProtection.protect(db, connection, request.sessionID).pipe(
+                    Effect.mapError((error) => new OwnerRefused({ message: error.message })),
