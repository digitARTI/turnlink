+++ b/packages/core/test/git-index-authority.test.ts
@@ -0,0 +1,194 @@
+import { expect } from "bun:test"
+import { stat } from "node:fs/promises"
+import path from "path"
+import { Cause, Context, Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { systemError } from "effect/PlatformError"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Git } from "@opencode/core/git"
+import { AbsolutePath, RelativePath } from "@opencode/core/schema"
+import { ReservationAuthority } from "@opencode/core/session/reservation-authority"
+import { initRepo } from "./fixture/git"
+import { tmpdirScoped } from "./fixture/tmpdir"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(LayerNode.compile(FSUtil.node))
+const denied = (method: string, file: string) =>
+  Effect.fail(
+    systemError({
+      _tag: "PermissionDenied",
+      module: "FileSystem",
+      method,
+      pathOrDescriptor: file,
+      description: "controlled temporary-index fault",
+    }),
+  )
+
+for (const outcome of [
+  "success",
+  "absent index",
+  "existence failure",
+  "copy failure",
+  "lost copy receipt",
+  "timestamp failure",
+  "publication failure",
+  "lost publication receipt",
+  "copy interruption",
+  "publication interruption",
+] as const) {
+  it.live(`Git temporary index ${outcome} retains exact native-attempt evidence`, () =>
+    Effect.gen(function* () {
+      const fs = yield* FSUtil.Service
+      const tmp = yield* tmpdirScoped()
+      const project = path.join(tmp.path, "project")
+      const store = AbsolutePath.make(path.join(tmp.path, "store"))
+      const current = path.join(store, "index")
+      yield* Effect.promise(async () => {
+        await Bun.write(path.join(project, "tracked.txt"), "before\n")
+        await initRepo(project)
+      })
+      const entered = yield* Deferred.make<void>()
+      const resume = yield* Deferred.make<void>()
+      const gate = { armed: false, links: 0, copies: 0, renames: 0, cleanups: 0, refused: Effect.succeed(false) }
+      const temporaries: string[] = []
+      const owner = yield* Scope.make()
+      yield* Effect.addFinalizer(() => Scope.close(owner, Exit.void))
+      const context = yield* Layer.build(
+        Layer.fresh(
+          LayerNode.compile(LayerNode.group([Git.node, ReservationAuthority.node]), {
+            replacements: [
+              FSUtil.node.replace(
+                Layer.succeed(FSUtil.Service, {
+                  ...fs,
+                  exists: (file) => {
+                    if (!gate.armed || file !== current) return fs.exists(file)
+                    return Effect.gen(function* () {
+                      expect(yield* gate.refused).toBe(true)
+                      if (outcome === "existence failure") return yield* denied("exists", file)
+                      return yield* fs.exists(file)
+                    })
+                  },
+                  link: (from, to) => {
+                    if (gate.armed && from === current) gate.links++
+                    return fs.link(from, to)
+                  },
+                  copyFile: (from, to) => {
+                    if (!gate.armed || from !== current) return fs.copyFile(from, to)
+                    return Effect.gen(function* () {
+                      gate.copies++
+                      temporaries.push(to)
+                      expect(yield* gate.refused).toBe(true)
+                      if (outcome === "copy failure") return yield* denied("copyFile", from)
+                      yield* fs.copyFile(from, to)
+                      const identities = yield* Effect.promise(() => Promise.all([stat(from), stat(to)]))
+                      expect([identities[0]!.dev, identities[0]!.ino]).not.toEqual([
+                        identities[1]!.dev,
+                        identities[1]!.ino,
+                      ])
+                      expect(yield* fs.readFile(from)).toEqual(original)
+                      if (outcome === "lost copy receipt") return yield* denied("copyFile", from)
+                      if (outcome === "copy interruption") {
+                        yield* Deferred.succeed(entered, undefined)
+                        yield* Deferred.await(resume)
+                      }
+                    })
+                  },
+                  utimes: (file, atime, mtime) =>
+                    gate.armed && outcome === "timestamp failure" && path.basename(file).startsWith("index.opencode-")
+                      ? denied("utimes", file)
+                      : fs.utimes(file, atime, mtime),
+                  rename: (from, to) => {
+                    if (!gate.armed || to !== current || !path.basename(from).startsWith("index.opencode-"))
+                      return fs.rename(from, to)
+                    return Effect.gen(function* () {
+                      gate.renames++
+                      expect(yield* gate.refused).toBe(true)
+                      if (outcome === "publication failure") return yield* denied("rename", from)
+                      if (outcome === "publication interruption") {
+                        yield* Deferred.succeed(entered, undefined)
+                        yield* Deferred.await(resume)
+                      }
+                      yield* fs.rename(from, to)
+                      if (outcome === "lost publication receipt") return yield* denied("rename", from)
+                    })
+                  },
+                  remove: (file, options) => {
+                    if (gate.armed && path.basename(file).startsWith("index.opencode-")) gate.cleanups++
+                    return fs.remove(file, options)
+                  },
+                }),
+              ),
+            ],
+          }),
+        ),
+      ).pipe(Scope.provide(owner))
+      const git = Context.get(context, Git.Service)
+      const authority = Context.get(context, ReservationAuthority.Service)
+      const refused = authority.withStable(Effect.void).pipe(
+        Effect.exit,
+        Effect.map((exit) => Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)),
+      )
+      gate.refused = refused
+      const source = yield* git.repo.discover(AbsolutePath.make(project))
+      if (!source) return yield* Effect.die("fixture project is not a repository")
+      const repository = yield* git.repo.create({ worktree: source.worktree, gitDirectory: store, seed: source })
+      const capture = git.tree.capture({ repository, scopes: [RelativePath.make(".")], ignores: source })
+      yield* capture
+      const original = yield* fs.readFile(current)
+      if (outcome === "absent index") yield* fs.remove(current)
+      yield* Effect.promise(() => Bun.write(path.join(project, "tracked.txt"), "after\n"))
+      expect(yield* refused).toBe(false)
+      yield* Effect.gen(function* () {
+        gate.armed = true
+        const running = yield* capture.pipe(Effect.exit, Effect.forkScoped)
+        const interrupted = outcome.endsWith("interruption")
+        if (interrupted) {
+          yield* Deferred.await(entered)
+          expect(yield* refused).toBe(true)
+          expect(yield* fs.readFile(current)).toEqual(original)
+          const cancelling = yield* Fiber.interrupt(running).pipe(Effect.forkScoped)
+          yield* Effect.yieldNow
+          expect(cancelling.pollUnsafe()).toBeUndefined()
+          yield* Deferred.succeed(resume, undefined)
+          yield* Fiber.join(cancelling)
+          const exit = yield* Fiber.await(running)
+          expect(Exit.isFailure(exit) && Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+        }
+        if (!interrupted) {
+          const result = yield* Fiber.join(running)
+          expect(Exit.isFailure(result)).toBe(
+            ["existence failure", "copy failure", "lost copy receipt"].includes(outcome),
+          )
+        }
+        expect(gate.links).toBe(0)
+        expect(gate.copies).toBe(outcome === "existence failure" || outcome === "absent index" ? 0 : 1)
+        expect(gate.renames).toBe(
+          ["existence failure", "copy failure", "lost copy receipt", "copy interruption"].includes(outcome) ? 0 : 1,
+        )
+        expect(gate.cleanups).toBe(1)
+        yield* Effect.forEach(temporaries, (file) =>
+          Effect.gen(function* () {
+            expect(yield* fs.exists(file)).toBe(false)
+          }),
+        )
+        if (
+          [
+            "existence failure",
+            "copy failure",
+            "lost copy receipt",
+            "copy interruption",
+            "publication failure",
+          ].includes(outcome)
+        )
+          expect(yield* fs.readFile(current)).toEqual(original)
+        const uncertain = outcome !== "success" && outcome !== "absent index"
+        expect(yield* refused).toBe(uncertain)
+        gate.armed = false
+        expect(yield* capture).toBeDefined()
+        expect(yield* refused).toBe(uncertain)
+        yield* Scope.close(owner, Exit.void)
+        expect(yield* refused).toBe(uncertain)
+      }).pipe(Effect.ensuring(Deferred.succeed(resume, undefined)))
+    }),
+  )
+}
diff --git a/packages/core/test/git-native-read-authority.test.ts b/packages/core/test/git-native-read-authority.test.ts
