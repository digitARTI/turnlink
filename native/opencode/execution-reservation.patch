+
+export class OwnerRefused extends Schema.TaggedError<OwnerRefused>()("SessionMovement.OwnerRefused", {
+  message: Schema.String,
+}) {}
+
+type PlacementOwnerRequest = { readonly sessionID: SessionSchema.ID; readonly transitionID: string }
+const placementOwners = new WeakMap<Activation, (request: PlacementOwnerRequest) => Effect.Effect<MovementFence.Owner, OwnerRefused>>()
+const preparedPlacements = new WeakMap<PreparedAuthority, {
+  readonly db: Database.Interface["db"]
+  readonly sessionID: SessionSchema.ID
+  readonly transitionID: string
+  readonly destination: Location.Ref
+  readonly projectID: SessionSchema.Info["projectID"]
+  readonly subpath: SessionSchema.Info["subpath"]
+  readonly before: Effect.Effect<void>
+  readonly after: Effect.Effect<void>
+}>()
+
+/** Bind a native prepared observation to the exact owner and destination; this is not a movement grant. */
+export const preparedPlacementChecks = (prepared: PreparedAuthority, db: Database.Interface["db"], owner: MovementFence.Owner,
+  placement: { readonly destination: Location.Ref; readonly projectID: SessionSchema.Info["projectID"];
+    readonly subpath?: SessionSchema.Info["subpath"] }) => Effect.gen(function* () {
+  const record = preparedPlacements.get(prepared)
+  const sessionID = yield* MovementFence.ownerSession(db, owner)
+  const intent = yield* MovementFence.find(db, sessionID)
+  if (!record || record.db !== db || record.sessionID !== sessionID || !intent || intent.transitionID !== record.transitionID ||
+    record.destination.directory !== placement.destination.directory || record.destination.workspaceID !== placement.destination.workspaceID ||
+    record.projectID !== placement.projectID || record.subpath !== placement.subpath)
+    return yield* Effect.die("Native prepared placement does not match the owner or destination")
+  yield* MovementFence.assertOwner(db, owner)
+  return { before: record.before, after: record.after }
+})
+
+/** Native-only capability; it is never serialized or exposed through plugin RPC. */
+export const placementOwner = (activation: Activation, request: PlacementOwnerRequest) => {
+  const acquire = placementOwners.get(activation)
+  return acquire ? acquire({ sessionID: request.sessionID, transitionID: request.transitionID }) :
+    Effect.fail(new OwnerRefused({ message: "Native placement activation is unavailable" }))
+}
+
+export interface Activation {
+  /** A private host must journal dispatch before calling; this is not a broker grant. */
+  readonly promoteLive: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly promotionID: string
+    readonly receiverHash: string
+  }) => Effect.Effect<{
+    readonly activation: Activation
+    readonly receipt: { readonly version: 1; readonly sessionID: SessionSchema.ID; readonly transitionID: string;
+      readonly promotionID: string; readonly destination: Location.Ref; readonly completionLeaseIncarnation: string; readonly nativeLeaseIncarnation: string }
+  }, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  readonly releaseModelTransport: (request: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<
+    SessionModelTransport.ReleaseReceipt,
+    OwnerRefused | AIError | SessionRunCoordinator.ReservationBusyError
+  >
+  /** Native preparation only. This reserves execution, never grants filesystem/model authority. */
+  readonly withReservation: <A, E, R>(
+    request: { readonly sessionID: SessionSchema.ID; readonly transitionID: string },
+    operation: Effect.Effect<A, E, R>,
+  ) => Effect.Effect<A, E | OwnerRefused | SessionRunCoordinator.ReservationBusyError, R>
+  readonly prepare: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly directory: AbsolutePath
+  }) => Effect.Effect<MovementFence.Intent, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Read the durable recovery record; absence does not prove that no effect occurred. */
+  readonly observeRecoveryRecord: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<RecoveryRecordObservation, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Read a fully validated placement receipt under the exact live or recovery owner. */
+  readonly observePlacement: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<SessionPlacementReceipt.Record | null, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Observe completed placement without reclaiming its removed quarantine. */
+  readonly observeCompletion: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<{ readonly version: 1; readonly placement: SessionPlacementReceipt.Record; readonly leaseIncarnation: string } | null,
+    OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Local evidence only: this does not establish process death or remote cancellation. */
+  readonly observeRecoveryTransport: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<{ readonly intent: MovementFence.Intent; readonly recovery: MovementFence.Recovery;
+    readonly release: MovementFence.TransportRelease } | null, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Observe retained Session state under the exact recovery owner and native exclusion. */
+  readonly inspectRecovery: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<RecoveryInspection, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Freeze an already absent source membership under the exact recovery owner. */
+  readonly sealMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<SessionMembershipSeal.Record, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Preserve and detach an exact quiet source membership under a recovery claim. */
+  readonly detachMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly channel: string
+  }) => Effect.Effect<SessionMembershipSeal.Record, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Preserve and detach while the original native activation still owns the quarantine. */
+  readonly detachLiveMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly channel: string
+  }) => Effect.Effect<SessionMembershipSeal.Record, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Stage an inert destination value from the protected source archive. */
+  readonly stageDestinationMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly channel: string
+    readonly receiverHash: string
+  }) => Effect.Effect<Omit<SessionMembershipArchive.Destination, "value">, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Stage the archived membership under the exact successor recovery owner. */
+  readonly stageRecoveredDestinationMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly channel: string
+    readonly receiverHash: string
+  }) => Effect.Effect<Omit<SessionMembershipArchive.Destination, "value">, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Observe a previous live owner's destination stage without exposing its value. */
+  readonly observeDestinationMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<Omit<SessionMembershipArchive.Destination, "value"> | null, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Observe the preserved membership and its matching seal without returning membership data. */
+  readonly observeDetachedMembership: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<SessionMembershipSeal.Record | null, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  /** Claim a prior-process quarantine for reconciliation; never releases or moves it. */
+  readonly recoverQuarantine: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<MovementFence.Recovery, OwnerRefused>
+  /** Compare-and-swap an observed prior recovery claim under the new native lease. */
+  readonly takeoverRecovery: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+    readonly expected: MovementFence.Recovery
+    readonly targetLease: string
+  }) => Effect.Effect<MovementFence.Recovery, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+  readonly inspect: (input: {
+    readonly sessionID: SessionSchema.ID
+  }) => Effect.Effect<MovementFence.Intent | undefined, OwnerRefused>
+  /** Observational source graph only; this never authorizes movement. */
+  readonly observePreGrantAuthority?: (input: { readonly sessionID: SessionSchema.ID }) => Effect.Effect<{
+    readonly version: 1; readonly sessionID: SessionSchema.ID; readonly sourceAuthorityDigest: string;
+    readonly componentDigests: Readonly<Record<"agent" | "model" | "permissions" | "permissionRules" | "hooks" | "tools" | "toolDefinitions" | "instructions", string>>;
+    readonly modelResolution: "current" | "unavailable";
+    readonly projectInstructionFilesDigest?: string;
+    readonly hostedActivations: ReadonlyArray<{ readonly definition: string; readonly bundleDigest: string }>;
+    readonly hostedHookActivations: ReadonlyArray<{ readonly definition: string; readonly bundleDigest: string }>;
+    readonly revision: number; readonly executionEligible: false; readonly unresolved: ReadonlyArray<string>
+  }, OwnerRefused | AgentNotFoundError | FileSystem.DirectoryNotFoundError>
+  readonly prepareAuthority: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<
+    PreparedAuthority,
+    OwnerRefused | AgentNotFoundError | FileSystem.DirectoryNotFoundError | SessionRunCoordinator.ReservationBusyError
+  >
+  readonly prepareDestination: (input: {
+    readonly sessionID: SessionSchema.ID
+    readonly transitionID: string
+  }) => Effect.Effect<
+    Destination,
+    OwnerRefused | AgentNotFoundError | FileSystem.DirectoryNotFoundError | SessionRunCoordinator.ReservationBusyError
+  >
+}
+
+export interface RecoveryRecordObservation {
+  readonly currentLease: string
+  readonly recovery: MovementFence.Recovery | null
+}
+
+export interface RecoveryInspection {
+  readonly recovery: MovementFence.Recovery
+  readonly session: Pick<SessionSchema.Info, "id" | "location" | "agent" | "model">
+  readonly inboxCount: number
+  readonly pendingCount: number
+  readonly messageCount: number
+  /** Recorded acquisitions only; zero is not proof that untracked sockets are absent. */
+  readonly webSocketAcquisitions: { readonly priorLease: number; readonly currentLease: number }
+  /** Distinct dependent Sessions with prior records, not proof of physical resource state. */
+  readonly dependentPriorWebSocketSessions: number
+  /** Durable local absence only; it is not a resource or receiver receipt. */
+  readonly membershipSeal: SessionMembershipSeal.Record | null
+  readonly membershipPresent: boolean
+  readonly unresolved: readonly string[]
+}
+
+export interface PreparedAuthority {
+  readonly source: Destination
+  readonly destination: Destination
+  /** Captured while both native observations and owner revalidation are held. */
+  readonly revision: number
+  /** Ordered native rule comparison; it is not a complete permission grant. */
+  readonly permissionComparison: Permission.AuthorityComparison
+  /** Native-only directory identity check; not a placement or authority grant. */
+  readonly revalidateDirectories: Effect.Effect<void, OwnerRefused | SessionRunCoordinator.ReservationBusyError>
+}
+
+export interface Destination {
+  readonly selection: SessionContext.Selection
+  readonly instructions: Instructions.ReadResult
+  readonly model: Exit.Exit<SessionRunnerModel.Resolved, SessionRunnerModel.Error>
+  readonly hooks: ReadonlyArray<PluginHooks.AuthorityEntry>
+  readonly permissions: Permission.Authority
+  readonly modelAuthority: NativeModelAuthority.Observation | undefined
+  readonly revision: number
+  readonly executionEligible: boolean
+  readonly unresolved: readonly string[]
+}
+
+export interface Interface {
+  /** Native host only. Authorization and identity come from the activation, never an RPC payload. */
+  readonly forActivation: (input: {
+    readonly pluginID: string
+    readonly location: Location.Ref
+    readonly authorized: boolean
+  }) => Effect.Effect<Activation, OwnerRefused, Scope.Scope>
+}
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/SessionMovement") {}
+
+const NativeOwner = Schema.Struct({
+  incarnation: Schema.String,
+  activation: Schema.String,
+  generation: Schema.Int.check(Schema.isGreaterThan(0)),
+})
+
+export const make = Effect.fn("SessionMovement.make")(function* () {
+  const database = yield* Database.Service
+  const fs = yield* FSUtil.Service
+  const jobs = yield* Job.Service
+  const db = database.db
+  const execution = yield* SessionExecution.Service
+  const store = yield* SessionStore.Service
+  const locations = yield* LocationServiceMap.Service
+  const authority = yield* ReservationAuthority.Service
+  const transport = yield* SessionModelTransport.Service
+  const incarnation = randomUUID()
+  const forActivation: Interface["forActivation"] = Effect.fn("SessionMovement.forActivation")(function* (input) {
+      if (!input.authorized) return yield* new OwnerRefused({ message: "Native movement extension is not authorized" })
+      const lifetime = yield* Scope.Scope
+      const activation = randomUUID()
+      let directories: ReturnType<typeof MovementDirectories.capture> | undefined
+      let preparing = false
+      yield* Effect.addFinalizer(() => Effect.sync(() => { directories?.close(); directories = undefined }))
+      const closed = () => lifetime.state._tag === "Closed"
+      const key =
+        "session-movement-activation:v1:" +
+        JSON.stringify([input.pluginID, input.location.directory, input.location.workspaceID ?? null])
+      const principal = yield* db
+        .transaction(() =>
+          Effect.gen(function* () {
+            const previous = yield* db
+              .select({ value: KVTable.value })
+              .from(KVTable)
+              .where(eq(KVTable.key, key))
+              .get()
+              .pipe(Effect.orDie)
+            const observed = previous ? Schema.decodeUnknownSync(NativeOwner)(previous.value).generation : 0
+            if (observed >= Number.MAX_SAFE_INTEGER)
+              return yield* new OwnerRefused({ message: "Activation generation is exhausted" })
+            const generation = observed + 1
+            const value = NativeOwner.make({ incarnation, activation, generation })
+            yield* db
+              .insert(KVTable)
+              .values({ key, value })
+              .onConflictDoUpdate({ target: KVTable.key, set: { value } })
+              .run()
+              .pipe(Effect.orDie)
+            return value
+          }),
+        )
+        .pipe(Effect.catchTag("SqlError", Effect.die))
+      const owned = Effect.fnUntraced(function* (sessionID: SessionSchema.ID, allowPlaced = false) {
+        if (closed()) return yield* new OwnerRefused({ message: "Activation is closed" })
+        const current = yield* db
+          .select({ value: KVTable.value })
+          .from(KVTable)
+          .where(eq(KVTable.key, key))
+          .get()
+          .pipe(Effect.orDie)
+        if (!current || JSON.stringify(current.value) !== JSON.stringify(principal))
+          return yield* new OwnerRefused({ message: "Activation generation was superseded" })
+        const session = yield* store.get(sessionID)
+        if (closed()) return yield* new OwnerRefused({ message: "Activation closed during Session revalidation" })
+        if (!session) return yield* new OwnerRefused({ message: "Session belongs to another activation location" })
+        if (session.location.directory !== input.location.directory || session.location.workspaceID !== input.location.workspaceID) {
+          if (!allowPlaced) return yield* new OwnerRefused({ message: "Session belongs to another activation location" })
+          const intent = yield* MovementFence.find(db, sessionID)
+          if (!intent || intent.pluginID !== input.pluginID || intent.source.directory !== input.location.directory ||
+            intent.source.workspaceID !== input.location.workspaceID)
+            return yield* new OwnerRefused({ message: "Placed Session does not belong to this quarantine" })
+          const receipt = yield* SessionPlacementReceipt.find(db, sessionID, intent.transitionID)
+          if (!receipt || receipt.destination.directory !== session.location.directory ||
+            receipt.destination.workspaceID !== session.location.workspaceID)
+            return yield* new OwnerRefused({ message: "Placed Session has no matching native receipt" })
+        }
+        return session
+      })
+      const inspect = Effect.fn("SessionMovement.inspect")(function* (request: Parameters<Activation["inspect"]>[0]) {
+        yield* owned(request.sessionID, true)
+        return yield* MovementFence.find(db, request.sessionID)
+      })
+      const observePreGrantAuthority = Effect.fn("SessionMovement.observePreGrantAuthority")(function* (request: { readonly sessionID: SessionSchema.ID }) {
+        yield* owned(request.sessionID)
+        if (yield* inspect(request)) return yield* new OwnerRefused({ message: "Source observation requires no movement intent" })
+        const graph = yield* locations.contextEffect(input.location).pipe(Scope.provide(lifetime))
+        yield* Plugin.awaitActivation.pipe(Effect.provide(graph), Scope.provide(lifetime))
+        return yield* authority.withStable(Effect.gen(function* () {
+          const revision = yield* authority.revision
+          const permissionRevision = yield* NativeMovementPermissionRevision.current(db)
+          const config = Context.get(graph, Config.Service)
+          const discovery = Context.get(graph, InstructionDiscovery.Service)
+          const instructionPaths = yield* discovery.list()
+          if (!Array.isArray(instructionPaths) || !config.freshLocalInputs || !config.freshRemoteInputs)
+            return yield* new OwnerRefused({ message: "Native source inputs unavailable" })
+          const instructionFiles = MovementInstructionFiles.capture(instructionPaths)
+          const inputsCurrent = Effect.gen(function* () {
+            return (yield* config.freshLocalInputs!()) && (yield* config.freshRemoteInputs!()) &&
+              (yield* ConfigInstructionPlugin.freshLocalInputs(discovery)) && (yield* MovementInstructionFiles.current(instructionFiles, fs))
+          })
+          if (!(yield* inputsCurrent)) return yield* new OwnerRefused({ message: "Native source inputs changed" })
+          const observe = Effect.fnUntraced(function* () {
+            const context = yield* SessionContext.Service
+            const selection = yield* context.select(request.sessionID)
+            const hooks = yield* PluginHooks.Service
+            const permissions = yield* Permission.Service
+            if (!hooks.authority || !permissions.authority) return yield* new OwnerRefused({ message: "Native source authority unavailable" })
+            const hookEntries = yield* hooks.authority
+            const permission = yield* permissions.authority({ session: selection.session, agent: selection.agent.id })
+            const instructions = yield* Instructions.read(selection.instructions)
+            const model = yield* context.resolveModel(selection.session).pipe(Effect.exit)
+            const modelAuthority = Exit.isSuccess(model) ? NativeModelAuthority.observe(model.value) : undefined
+            return {
+              agent: selection.agent.id, model: selection.session.model,
+              permission: { configured: permission.configured, saved: permission.saved, pending: permission.pending,
+                hooks: permission.hooks && PluginHooks.authorityIdentity(permission.hooks) },
+              hooks: PluginHooks.authorityIdentity(hookEntries), hookCurrent: hookEntries.map((entry) => entry.current),
+              tools: selection.tools.authority?.map((entry) => ({ current: entry.current,
+                descriptor: PluginHooks.descriptorIdentity(entry.origin?.descriptor), nativeOrigin: entry.nativeOrigin &&
+                  { kind: entry.nativeOrigin.kind, definition: entry.nativeOrigin.definition } })),
+              toolDefinitions: selection.tools.definitions,
+              instructions, instructionFiles, modelAvailable: Exit.isSuccess(model), modelCurrent: modelAuthority?.current === true,
+              modelDescriptor: modelAuthority && { ref: modelAuthority.ref, package: modelAuthority.package &&
+                { specifier: modelAuthority.package.specifier, builtin: modelAuthority.package.builtin },
+                route: { id: modelAuthority.route.id, protocol: modelAuthority.route.protocol }, credential: modelAuthority.credential },
+              modelUnresolved: modelAuthority?.unresolved ?? ["NATIVE_MODEL_UNATTRIBUTED"],
+            }
