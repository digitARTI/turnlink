@@ -0,0 +1,172 @@
+export * as SessionModelTransportJournal from "./model-transport-journal.js"
+
+import { randomUUID } from "node:crypto"
+import { eq, isNotNull, sql } from "drizzle-orm"
+import { Effect, Schema } from "effect"
+import type { Database } from "../database/database.js"
+import type { Job } from "../job.js"
+import { NativeMovementProtection } from "../database/movement-protection.js"
+import { NativeMovementConnection } from "../database/movement-connection.js"
+import { KVTable } from "../kv/sql.js"
+import { SessionSchema } from "./schema.js"
+import { SessionTable } from "./sql.js"
+
+const prefix = NativeMovementProtection.modelWebSocketPrefix
+const owner = (sessionID: SessionSchema.ID) => `model-websocket:${sessionID}`
+const binding = (sessionID: SessionSchema.ID, lease: string) => JSON.stringify({ sessionID, lease, family: "model-websocket:v1" })
+const Acquisition = Schema.Struct({
+  version: Schema.Literal(1), sessionID: SessionSchema.ID, id: Schema.String,
+  lease: Schema.String, binding: Schema.String,
+})
+export type Acquisition = typeof Acquisition.Type
+
+type DB = Database.Interface["db"]
+export interface Interface {
+  readonly begin: (sessionID: SessionSchema.ID) => Effect.Effect<Acquisition>
+  readonly settle: (acquisition: Acquisition) => Effect.Effect<void>
+  readonly list: (sessionID: SessionSchema.ID) => Effect.Effect<ReadonlyArray<Acquisition>>
+}
+
+/** Prior-lease records never authorize a new request or claim release. */
+export const priorUnresolved = (database: Database.Interface, sessionID: SessionSchema.ID) => {
+  if (!database.movement) return Effect.succeed(false)
+  const movement = database.movement
+  return Effect.gen(function* () {
+    const lease = yield* movement.claim.pipe(Effect.orDie)
+    const records = yield* make(database.db, movement).list(sessionID)
+    if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native WebSocket lease changed")
+    return records.some((record) => record.lease !== lease)
+  })
+}
+
+export class PriorAcquisitionUnresolved extends Schema.TaggedError<PriorAcquisitionUnresolved>()(
+  "SessionModelTransportJournal.PriorAcquisitionUnresolved", { sessionID: SessionSchema.ID },
+) {}
+export class MovementAcquisitionUnresolved extends Schema.TaggedError<MovementAcquisitionUnresolved>()(
+  "SessionModelTransportJournal.MovementAcquisitionUnresolved", { sessionID: SessionSchema.ID },
+) {}
+
+const journalSessions = (database: Database.Interface, includeCurrent: boolean) => {
+  if (!database.movement) return Effect.succeed(new Set<SessionSchema.ID>())
+  const movement = database.movement
+  return Effect.gen(function* () {
+    const lease = yield* movement.claim.pipe(Effect.orDie)
+    const rows = yield* database.db.select({ key: KVTable.key, value: KVTable.value }).from(KVTable)
+      .where(sql`substr(${KVTable.key}, 1, ${prefix.length}) = ${prefix}`).all().pipe(Effect.orDie)
+    const sessions = new Set<SessionSchema.ID>()
+    for (const row of rows) {
+      const value = yield* Schema.decodeUnknownEffect(Acquisition)(row.value).pipe(Effect.orDie)
+      if (row.key !== `${prefix}${value.sessionID}:${value.id}` || value.binding !== binding(value.sessionID, value.lease))
+        return yield* Effect.die("Invalid native WebSocket acquisition record")
+      if (includeCurrent || value.lease !== lease) sessions.add(value.sessionID)
+    }
+    if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native WebSocket lease changed")
+    return sessions
+  })
+}
+
+/** Includes child Sessions so restart cannot erase their suspended claims. */
+export const priorSessions = (database: Database.Interface) => journalSessions(database, false)
+
+/** Every durable acquisition, including the current native owner's idle pools. */
+export const unresolvedSessions = (database: Database.Interface) => journalSessions(database, true)
+
+/** A pending child with unresolved prior work also holds its ancestors. */
+export function includePendingParents(blocked: Set<SessionSchema.ID>, pending: ReadonlyArray<Job.Background>) {
+  let changed = true
+  while (changed) {
+    changed = false
+    for (const job of pending) {
+      const recovery = job.recovery
+      if (recovery.kind !== "subagent" || !blocked.has(recovery.childSessionID) || blocked.has(recovery.parentSessionID)) continue
+      blocked.add(recovery.parentSessionID)
+      changed = true
+    }
+  }
+  return blocked
+}
+
+/** Count prior-lease Sessions whose persisted dependency path reaches this root. */
+export function dependentPriorSessions(root: SessionSchema.ID, prior: ReadonlySet<SessionSchema.ID>,
+  rows: ReadonlyArray<{ readonly id: SessionSchema.ID; readonly parent: SessionSchema.ID | null }>,
+  pending: ReadonlyArray<Job.Background>) {
+  const descendants = new Set([root])
+  let before: number
+  do {
+    before = descendants.size
+    for (const row of rows) if (row.parent && descendants.has(row.parent)) descendants.add(row.id)
+    for (const job of pending) if (job.recovery.kind === "subagent" && descendants.has(job.recovery.parentSessionID))
+      descendants.add(job.recovery.childSessionID)
+  } while (descendants.size !== before)
+  let count = 0
+  for (const id of prior) if (id !== root && descendants.has(id)) count++
+  return count
+}
+
+/** Session ancestry exists before a child background job is necessarily recorded. */
+export const expandBlockedParents = (database: Database.Interface, blocked: Set<SessionSchema.ID>, pending: ReadonlyArray<Job.Background>) =>
+  Effect.gen(function* () {
+    if (blocked.size === 0) return blocked
+    const movement = database.movement
+    const lease = movement ? yield* movement.claim.pipe(Effect.orDie) : undefined
+    const rows = yield* database.db.select({ id: SessionTable.id, parent: SessionTable.parent_id }).from(SessionTable)
+      .where(isNotNull(SessionTable.parent_id)).all().pipe(Effect.orDie)
+    let before: number
+    do {
+      before = blocked.size
+      for (const row of rows) if (row.parent && blocked.has(row.id)) blocked.add(row.parent)
+      includePendingParents(blocked, pending)
+    } while (blocked.size !== before)
+    if (movement && (yield* movement.claim.pipe(Effect.orDie)) !== lease)
+      return yield* Effect.die("Native WebSocket lease changed")
+    return blocked
+  })
+
+/** Only the process whose native connection recorded an acquisition may clear it. */
+export function make(db: DB, movement: NativeMovementConnection.Interface): Interface {
+  const list = Effect.fn("SessionModelTransportJournal.list")(function* (sessionID: SessionSchema.ID) {
+    const keyPrefix = `${prefix}${sessionID}:`
+    const rows = yield* db.select({ key: KVTable.key, value: KVTable.value }).from(KVTable)
+      .where(sql`substr(${KVTable.key}, 1, ${keyPrefix.length}) = ${keyPrefix}`).all().pipe(Effect.orDie)
+    return yield* Effect.forEach(rows, (row) => Effect.gen(function* () {
+      const value = yield* Schema.decodeUnknownEffect(Acquisition)(row.value).pipe(Effect.orDie)
+      if (value.sessionID !== sessionID || row.key !== `${keyPrefix}${value.id}` || value.binding !== binding(sessionID, value.lease))
+        return yield* Effect.die("Invalid native WebSocket acquisition record")
+      return value
+    }))
+  })
+  return {
+    list,
+    begin: Effect.fn("SessionModelTransportJournal.begin")(function* (sessionID) {
+      const lease = yield* movement.claim.pipe(Effect.orDie)
+      const value = Acquisition.make({ version: 1, sessionID, id: randomUUID(), lease, binding: binding(sessionID, lease) })
+      yield* movement.authorize(owner(sessionID), value.binding).pipe(Effect.orDie)
+      return yield* db.transaction(() => Effect.gen(function* () {
+        yield* NativeMovementProtection.enableModelWebSocketJournal(db)
+        const existing = yield* list(sessionID)
+        // A prior process may still have delivered or own a remote request.
+        // A new lease must reconcile it before starting another acquisition.
+        if (existing.some((item) => item.lease !== lease))
+          return yield* Effect.die("Prior native WebSocket acquisition remains unresolved")
+        if (existing.length >= 64) return yield* Effect.die("Native WebSocket acquisition journal is full")
+        yield* db.insert(KVTable).values({ key: `${prefix}${sessionID}:${value.id}`, value: Schema.encodeSync(Acquisition)(value) })
+          .run().pipe(Effect.orDie)
+        if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native WebSocket lease changed")
+        return value
+      })).pipe(Effect.catchTag("SqlError", Effect.die))
+    }),
+    settle: Effect.fn("SessionModelTransportJournal.settle")(function* (value) {
+      const lease = yield* movement.claim.pipe(Effect.orDie)
+      if (lease !== value.lease || value.binding !== binding(value.sessionID, lease))
+        return yield* Effect.die("Native WebSocket acquisition belongs to another lease")
+      yield* db.transaction(() => Effect.gen(function* () {
+        const key = `${prefix}${value.sessionID}:${value.id}`
+        const current = yield* db.select({ value: KVTable.value }).from(KVTable).where(eq(KVTable.key, key)).get().pipe(Effect.orDie)
+        if (!current || JSON.stringify(current.value) !== JSON.stringify(Schema.encodeSync(Acquisition)(value)))
+          return yield* Effect.die("Native WebSocket acquisition record changed")
+        yield* db.delete(KVTable).where(eq(KVTable.key, key)).run().pipe(Effect.orDie)
+        if ((yield* movement.claim.pipe(Effect.orDie)) !== lease) return yield* Effect.die("Native WebSocket lease changed")
+      })).pipe(Effect.catchTag("SqlError", Effect.die))
+    }),
+  }
+}
