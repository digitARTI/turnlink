+    ...(!configuration ? ["MODEL_CONFIGURATION_UNVERIFIED"] : []),
+    ...(!nativeEndpoint ? ["MODEL_ENDPOINT_BUILDER_UNVERIFIED"] : []),
+    ...(credential === "external" || credential === "unresolved" ? ["MODEL_CREDENTIAL_SOURCE_UNVERIFIED"] : []),
